// Страницы раздела «Расчёт смет». Файл создаётся скриптом tools/estimates/build.py, правьте текст там.

pattern EstHubTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=10\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет</div><h1>Расчёты, калькулятор и справочники в одном месте</h1><p class=\"e-lead\">Оцените стоимость работ, пересчитайте объёмы и подберите материалы: от отделки до инженерных сетей.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\" class=\"on\" aria-current=\"page\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\">{{ t.est_tab_elec }}</a></nav><section class=\"e-sec\"><h2>Выберите вид расчёта</h2><p class=\"e-lead2\">Каждый расчёт даёт работы, материалы и итог. Точную смету составим после осмотра объекта.</p><div class=\"e-cards\"><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Отделка помещений</h3><p>Стены, потолки, полы, откосы: площади, работы и материалы по каждому помещению.</p></div><a class=\"e-card hot\" href=\"{{ p }}/raschet-smet/elektrika\"><span class=\"e-tag ok\">Калькуляторы готовы</span><h3>Электрика</h3><p>Проводка, щиты, освещение, розетки: точки, длины кабеля, автоматы.</p></a><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Водоснабжение и канализация</h3><p>Трубы, фитинги, приборы, разводка по санузлам и стоякам.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Отопление</h3><p>Радиаторы, трубы, тёплые полы, узлы подключения.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Вентиляция и кондиционирование</h3><p>Воздуховоды, решётки, установки, трассы и подвесы.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Слаботочные сети</h3><p>Кабельные сети, видеонаблюдение, охранная и пожарная сигнализация.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Демонтаж и черновые работы</h3><p>Перегородки, стяжка, штукатурка, выравнивание.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Общая смета по объекту</h3><p>Собирает выбранные расчёты в одну смету с итогами по помещениям и разделам.</p></div></div></section><section class=\"e-sec\"><h2>Что ещё в разделе</h2><div class=\"e-mores\"><a class=\"e-more\" href=\"{{ p }}/raschet-smet/obyemy\"><small>01</small><h3>Объёмы работ</h3><p>По каким правилам считаются площади: что вычитается, что добавляется, какие коэффициенты.</p><span class=\"e-cta\">Читать справочник →</span></a><a class=\"e-more\" href=\"{{ p }}/raschet-smet/kachestvo\"><small>02</small><h3>Качество работ</h3><p>Как определяется класс отделки: простая, улучшенная или высококачественная, и что в него входит.</p><span class=\"e-cta\">Читать →</span></a><a class=\"e-more\" href=\"{{ p }}/raschet-smet/elektrika\"><small>03</small><h3>Электрика</h3><p>Подбор сечения кабеля с учётом прочности, нагрева и потери напряжения, ток короткого замыкания, заземление, освещение помещений.</p><span class=\"e-cta\">Открыть калькуляторы →</span></a></div></section>"
}

pattern EstVolTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=10\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет · Справочник</div><h1>Как определяются объёмы работ</h1><p class=\"e-lead\">Правила обмера для отделочных работ и полов: что вычитается, что добавляется и какие коэффициенты применяются. Правила изложены по сборникам норм НРР-2022 своими словами, все числа сохранены.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/obyemy\" class=\"on\" aria-current=\"page\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\">{{ t.est_tab_elec }}</a></nav><div class=\"e-ref\"><div class=\"sub\">Общие правила</div>
<details open><summary>Общие правила измерения</summary><div class=\"ans\"><p><span class=\"k\">Высота стены:</span> от чистого пола до потолка. У перегородки — до потолка или до верха самой перегородки.</p><p><span class=\"k\">Размер окна и двери:</span> «по наружному обводу коробки» значит: размер проёма вместе с коробкой, а не размер стекла или полотна. Если в проёме две коробки, берётся наружная.</p><p><span class=\"k\">Размеры помещения:</span> берутся между внутренними гранями стен или перегородок.</p><p><span class=\"k\">Деление по помещениям:</span> объём считается отдельно для каждого помещения в зависимости от вида отделки (простая, улучшенная, высококачественная). Если во всех помещениях квартиры, этажа или секции отделка одинаковая, можно считать их целиком.</p><p><span class=\"k\">Высота помещения:</span> нормы по облицовке, штукатурке, окраске и обоям рассчитаны на работу с инвентарных столиков, стремянок и приставных лестниц в помещениях высотой до 4 м. При окраске помещений выше 4 м к расходам применяются повышающие коэффициенты из раздела 3 технической части. Установка лепных изделий и остекление рассчитаны на высоту до 8 м.</p><p><span class=\"k\">Малые помещения:</span> штукатурные нормы рассчитаны на помещения с площадью пола более 5 м². В стекольных, обойных и облицовочных работах при площади пола менее 5 м² затраты труда по таблице 63-13 умножаются на 1,15.</p><div class=\"src\">Источник: Сборник 15, п. 1.2, 2.10, 2.25; Сборник 61, п. 1.4, 2.2; Сборник 63, п. 1.6; Сборник 55, п. 2.1; Сборник 56, п. 2.1</div></div></details>
<div class=\"sub\">Штукатурные работы</div>
<details><summary>Штукатурка внутренних стен</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> периметр помещения × высота стены.</p><p><span class=\"k\">Вычитаем:</span> окна и двери (по наружному обводу коробок) и площадь, занятую тянутыми наличниками.</p><p><span class=\"k\">Добавляем:</span> боковые стороны пилястр.</p><p><span class=\"k\">Откосы:</span> считаются отдельно, см. следующую карточку.</p><p><span class=\"k\">Ремонт штукатурки:</span> считается по площади фактически отремонтированных поверхностей. Для стен криволинейного очертания к затратам труда и работе машин применяется коэффициент 1,1.</p><div class=\"src\">Источник: Сборник 15, п. 2.11; Сборник 61, п. 2.1, 2.2, 2.10</div></div></details>
<details><summary>Откосы окон и дверей внутри здания</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> отдельно, по площади самих откосов. Площадь откосов не входит в площадь стен, её нужно добавить дополнительной строкой.</p><p><span class=\"k\">Уже учтено в норме:</span> боковые и верхние оконные заглушины и откосы ниш отопления входят в нормативы, отдельно их считать не нужно.</p><p><span class=\"k\">Считается отдельно:</span> нижние оконные заглушины, по их площади.</p><div class=\"src\">Источник: Сборник 15, п. 2.13, 2.14</div></div></details>
<details><summary>Штукатурка потолков</summary><div class=\"ans\"><p><span class=\"k\">Обычный потолок:</span> площадь между внутренними гранями стен или перегородок. Кессонный потолок с площадью по плану (горизонтальной проекции) до 12 м² считается так же.</p><p><span class=\"k\">Ребристые перекрытия и кессонные потолки больше 12 м²:</span> считаются по развёрнутой поверхности (по всем плоскостям рёбер и кессонов).</p><p><span class=\"k\">Как получить развёрнутую поверхность при ремонте:</span> площадь по плану умножается на коэффициент: 1,6 для ребристых перекрытий, 1,75 для кессонных потолков.</p><div class=\"src\">Источник: Сборник 15, п. 2.12; Сборник 61, п. 2.3</div></div></details>
<details><summary>Колонны, пилястры, лепные детали, мрамор</summary><div class=\"ans\"><p><span class=\"k\">Колонны и пилястры:</span> площадь развёрнутой поверхности, то есть всех видимых сторон. Это относится и к колоннам, примыкающим к стене, и к отдельно стоящим.</p><p><span class=\"k\">Лепные детали на оштукатуренной поверхности:</span> площадь под ними из площади штукатурки не вычитается.</p><p><span class=\"k\">Основание под искусственный мрамор:</span> в штукатурные работы не входит, оно считается как облицовка.</p><div class=\"src\">Источник: Сборник 15, п. 2.7, 2.9, 2.18; Сборник 61, п. 2.4, 2.5</div></div></details>
<details><summary>Карнизы, тяги, наличники, лестницы</summary><div class=\"ans\"><p><span class=\"k\">Штукатурка карнизов и тяг:</span> длина тяги × (вынос + высота). Внутри здания считается отдельно.</p><p><span class=\"k\">Внутренние тянутые наличники:</span> площадь, которую они занимают на стене (по проекции на стену).</p><p><span class=\"k\">Лестничные марши и площадки:</span> по площади горизонтальной проекции, отдельно для каждого этажа.</p><div class=\"src\">Источник: Сборник 15, п. 2.15–2.17; Сборник 61, п. 2.6, 2.7</div></div></details>
<details><summary>Штукатурка фасадов</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь стен за вычетом проёмов по наружному обводу коробок.</p><p><span class=\"k\">Улучшенная и высококачественная штукатурка:</span> карнизы, пояски, наличники, другие тянутые детали, а также примыкающие к зданию колонны и пилястры в площадь стен не входят и считаются отдельно. Тянутые детали считаются по площади, которую они занимают на фасаде (по проекции на стену). Если карниз имеет вынос больше своей высоты, он считается по площади горизонтальной проекции.</p><p><span class=\"k\">Откосы, отливы и боковые поверхности выступающих или заглублённых деталей:</span> считаются отдельно в двух группах: шириной до 200 мм и шириной более 200 мм.</p><div class=\"src\">Источник: Сборник 15, п. 2.5, 2.6, 2.8; Сборник 61, п. 2.8, 2.9</div></div></details>
<div class=\"sub\">Облицовочные работы</div>
<details><summary>Облицовка природным камнем</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> по площади облицованной поверхности. Размеры стен и колонн берутся с учётом изломов в плане по наружному обводу, то есть по сечению вместе с плитами.</p><p><span class=\"k\">Профилированные камни и детали:</span> площадь без учёта рельефа, по проекции большей стороны.</p><p><span class=\"k\">Выносная тяга (карниз, наличник):</span> если вынос больше высоты, берётся размер тяги по большей стороне.</p><p><span class=\"k\">Ступени и подоконные доски:</span> длина считается вместе с концами плит, заделанными в кладку или штукатурку. Для подоконных досок учитывается заделка в стену и в четверть коробки.</p><div class=\"src\">Источник: Сборник 15, п. 2.1, 2.2; Сборник 56, п. 2.2; Сборник 63, п. 2.4</div></div></details>
<details><summary>Облицовка плитами, мрамором и керамической плиткой</summary><div class=\"ans\"><p><span class=\"k\">Искусственные плиты:</span> по площади облицовки, без учёта рельефа.</p><p><span class=\"k\">Искусственный мрамор:</span> по развёрнутой поверхности облицовки.</p><p><span class=\"k\">Глазурованная керамическая плитка (ремонт):</span> по площади вертикальной проекции облицовываемой поверхности. Дверцы при облицовке ванн кирпичом из площади не вычитаются.</p><p><span class=\"k\">Облицовка откосов проёмов (деревянные стены):</span> по площади тех откосов, которые облицовываются.</p><div class=\"src\">Источник: Сборник 15, п. 2.3, 2.4; Сборник 63, п. 2.5, 2.6; Сборник 53, п. 2.9</div></div></details>
<div class=\"sub\">Малярные работы</div>
<details><summary>Окраска внутренних стен водными составами</summary><div class=\"ans\"><p>К водным составам этого правила относятся клеевые, казеиновые, известковые и силикатные краски. Водоэмульсионные, ПВА и акриловые краски считаются по правилу следующей карточки.</p><p><span class=\"k\">Как считаем:</span> площадь стен целиком, без вычета окон и дверей.</p><p><span class=\"k\">Не добавляем:</span> откосы окон и дверей и боковые поверхности ниш.</p><p><span class=\"k\">Добавляем:</span> площадь столбов и боковых сторон пилястр.</p><p><span class=\"k\">Исключение:</span> если проёмы занимают более 50 % площади отдельной стены, эта стена считается по фактически окрашиваемой поверхности: проёмы вычитаются, откосы окон и дверей и боковые поверхности ниш добавляются.</p><div class=\"src\">Источник: Сборник 15, п. 2.23 и таблица 4; Сборник 62, п. 2.3</div></div></details>
<details><summary>Окраска внутренних стен масляными, ПВА, акриловыми и водоэмульсионными составами</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> периметр × высота стены.</p><p><span class=\"k\">Вычитаем:</span> окна и двери (по наружному обводу коробок).</p><p><span class=\"k\">Добавляем:</span> столбы, пилястры, ниши, откосы окон и дверей.</p><div class=\"src\">Источник: Сборник 15, п. 2.24, 2.25; Сборник 62, п. 2.4</div></div></details>
<details><summary>Окраска потолков</summary><div class=\"ans\"><p><span class=\"k\">Обычный потолок:</span> площадь между внутренними гранями стен.</p><p><span class=\"k\">Ребристые перекрытия:</span> площадь по плану × 1,6.</p><p><span class=\"k\">Кессонные потолки:</span> площадь по плану × 1,75.</p><p><span class=\"k\">Потолки с лепниной:</span> площадь потолка × коэффициент по доле лепки. Доля лепки — это площадь изделий по плану в процентах от площади потолка:</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Доля лепки от площади потолка</th><th>до 2 %</th><th>2,1–10 %</th><th>10,1–40 %</th><th>40,1–70 %</th><th>более 70 %</th></tr></thead><tbody><tr><td>Коэффициент</td><td class=\"m\">1,0</td><td class=\"m\">1,1</td><td class=\"m\">1,5</td><td class=\"m\">2,1</td><td class=\"m\">2,8</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 15, п. 2.26, 2.27; Сборник 62, п. 2.5</div></div></details>
<details><summary>Окраска лепных изделий на стенах и фасадах</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь основания изделия × коэффициент по высоте рельефа и густоте рисунка.</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Высота рельефа</th><th>Редкий рисунок</th><th>Густой рисунок</th></tr></thead><tbody><tr><td>до 30 мм</td><td class=\"m\">1,5</td><td class=\"m\">3,0</td></tr><tr><td>более 30 мм</td><td class=\"m\">3,0</td><td class=\"m\">5,0</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 62, п. 2.11</div></div></details>
<details><summary>Окраска окон и дверей (заполнения проёмов)</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь проёма по наружному обводу коробки × коэффициент из таблицы. Коэффициент зависит от типа заполнения, материала стены и числа переплётов.</p><p>Колонки: «1» и «2» — число переплётов; «проолифленные» — часть площади, у которой детали поступили проолифленными.</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Заполнение</th><th>Стены</th><th>Состав</th><th>1 перепл.</th><th>2 перепл.</th><th>Пролиф. 1</th><th>Пролиф. 2</th></tr></thead><tbody><tr><td>Окно, раздельные переплёты, с подоконной доской</td><td>каменные</td><td>коробка, переплёт, подоконная доска</td><td class=\"m\">1,5</td><td class=\"m\">2,8</td><td class=\"m\">0,3</td><td class=\"m\">0,3</td></tr><tr><td>То же</td><td>деревянные</td><td>коробка, переплёт с наличниками с двух сторон, подоконная доска</td><td class=\"m\">2,2</td><td class=\"m\">3,5</td><td class=\"m\">0,6</td><td class=\"m\">0,6</td></tr><tr><td>Окно, раздельные, без подоконной доски</td><td>каменные</td><td>коробка, переплёт</td><td class=\"m\">1,2</td><td class=\"m\">2,5</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Окно, спаренные, с подоконной доской</td><td>каменные</td><td>коробка, переплёт, подоконная доска</td><td class=\"m\">-</td><td class=\"m\">2,5</td><td class=\"m\">-</td><td class=\"m\">0,3</td></tr><tr><td>Окно, спаренные, без подоконной доски</td><td>каменные</td><td>коробка, переплёт</td><td class=\"m\">-</td><td class=\"m\">2,2</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Фрамуги</td><td>перегородки</td><td>переплёт, наличники с двух сторон</td><td class=\"m\">1,6</td><td class=\"m\">-</td><td class=\"m\">0,7</td><td class=\"m\">-</td></tr><tr><td>Витрина деревянная</td><td>каменные</td><td>коробка, переплёт</td><td class=\"m\">1,75</td><td class=\"m\">3,5</td><td class=\"m\">0,45</td><td class=\"m\">0,9</td></tr><tr><td>Окно промзданий до 4 м², раздельные</td><td>каменные</td><td>коробка, переплёт, раскладки, монтажные подоконные доски</td><td class=\"m\">2,1</td><td class=\"m\">3,2</td><td class=\"m\">0,3</td><td class=\"m\">0,3</td></tr><tr><td>То же, более 4 м²</td><td>каменные</td><td>то же</td><td class=\"m\">1,7</td><td class=\"m\">2,6</td><td class=\"m\">0,2</td><td class=\"m\">0,2</td></tr><tr><td>Балконная дверь, раздельные полотна</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">2,1</td><td class=\"m\">3,5</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Балконная дверь, спаренные полотна</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">-</td><td class=\"m\">2,6</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Дверь глухая</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">2,4</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Дверь глухая</td><td>деревянные</td><td>коробка, полотна, наличники с двух сторон</td><td class=\"m\">2,7</td><td class=\"m\">-</td><td class=\"m\">0,3</td><td class=\"m\">-</td></tr><tr><td>Дверь глухая</td><td>перегородки</td><td>коробка, полотна, наличники с двух сторон</td><td class=\"m\">2,7</td><td class=\"m\">-</td><td class=\"m\">0,3</td><td class=\"m\">-</td></tr><tr><td>Дверь остеклённая</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">1,8</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Дверь остеклённая</td><td>перегородки</td><td>коробка, полотна, наличники с двух сторон</td><td class=\"m\">2,1</td><td class=\"m\">-</td><td class=\"m\">0,3</td><td class=\"m\">-</td></tr><tr><td>Шкафная дверь</td><td>перегородки</td><td>коробка, полотна, наличники с одной стороны</td><td class=\"m\">2,7</td><td class=\"m\">-</td><td class=\"m\">0,2</td><td class=\"m\">-</td></tr><tr><td>Открытый проём</td><td>перегородки</td><td>коробка, наличники с двух сторон</td><td class=\"m\">0,9</td><td class=\"m\">-</td><td class=\"m\">0,4</td><td class=\"m\">-</td></tr></tbody></table></div><ul><li>Фрамуги в наружных стенах считаются как окна соответствующего типа.</li><li>Для дверей в каменных стенах (глухих и остеклённых) коэффициенты даны без наличников. Если наличники есть с одной стороны проёма, коэффициент увеличивается на 0,2.</li><li>Для дверей в перегородках толщиной 140–160 мм с коробками на всю ширину перегородки коэффициент увеличивается на 0,2.</li><li>Окна и балконные двери с тройным остеклением: берутся данные для спаренных переплётов, результат умножается на 1,5.</li><li>В Сборнике 62 (ремонт) таблица почти такая же, но отличается в трёх местах. Деревянные окна с подоконной доской: проолифленные детали при двух переплётах 0,6 и 0,5. Дверь глухая в перегородке: наличники не указаны. Открытый проём: наличники с одной стороны.</li><li>Только рельефные наличники (Сборник 62): площадь по проекции × 1,15.</li><li>Окна со стороны фасада (Сборник 62): раздельные переплёты — коэффициент 0,35 к данным окна «без подоконной доски», спаренные — 0,2 к данным фрамуги. К данным дверей (балконных, а также глухих и остеклённых в каменных стенах) со стороны фасада применяется множитель 0,4.</li></ul><div class=\"src\">Источник: Сборник 15, п. 2.29, таблица 3</div></div></details>
<details><summary>Окраска отдельных элементов окон и дверей (нетиповые заполнения)</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь проёма (м²) × коэффициент элемента. Коэффициент зависит от размера проёма.</p><p class=\"k\">Окна (деревянные)</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Элемент</th><th>до 1,0 м²</th><th>до 2,25 м²</th><th>более 2,25 м²</th></tr></thead><tbody><tr><td>Одинарная коробка</td><td class=\"m\">0,6</td><td class=\"m\">0,45</td><td class=\"m\">0,3</td></tr><tr><td>Двухсторонняя коробка</td><td class=\"m\">1,4</td><td class=\"m\">1,0</td><td class=\"m\">0,8</td></tr><tr><td>Подоконная доска</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td><td class=\"m\">0,2</td></tr><tr><td>Переплёт в 1–2 стекла</td><td class=\"m\">1,0</td><td class=\"m\">0,8</td><td class=\"m\">0,6</td></tr><tr><td>Переплёт в 3–5 стёкол</td><td class=\"m\">1,5</td><td class=\"m\">1,1</td><td class=\"m\">0,8</td></tr><tr><td>Переплёт в 6–11 стёкол</td><td class=\"m\">1,6</td><td class=\"m\">1,2</td><td class=\"m\">0,8</td></tr><tr><td>Переплёт в 12 и более стёкол</td><td class=\"m\">1,8</td><td class=\"m\">1,3</td><td class=\"m\">0,9</td></tr></tbody></table></div><p class=\"k\">Двери (деревянные), площадь проёма</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Элемент</th><th>Однопольная до 1</th><th>до 1,5</th><th>более 1,5</th><th>Двупольная до 2,5</th><th>до 3,5</th><th>более 3,5</th></tr></thead><tbody><tr><td>Коробка шириной 160–200 мм</td><td class=\"m\">0,8</td><td class=\"m\">0,7</td><td class=\"m\">0,6</td><td class=\"m\">0,4</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td></tr><tr><td>Наличники к коробке с двух сторон</td><td class=\"m\">1,0</td><td class=\"m\">0,9</td><td class=\"m\">0,8</td><td class=\"m\">0,6</td><td class=\"m\">0,5</td><td class=\"m\">0,4</td></tr><tr><td>Полотно полусветлое, остекление до 0,5 м²</td><td class=\"m\">-</td><td class=\"m\">2,1</td><td class=\"m\">1,9</td><td class=\"m\">-</td><td class=\"m\">2,1</td><td class=\"m\">1,9</td></tr><tr><td>Полотно полусветлое, остекление до 1,0 м²</td><td class=\"m\">-</td><td class=\"m\">1,3</td><td class=\"m\">1,5</td><td class=\"m\">-</td><td class=\"m\">1,3</td><td class=\"m\">1,5</td></tr><tr><td>Полотно полусветлое, остекление более 1,0 м²</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">1,2</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">1,2</td></tr><tr><td>Полотно филенчатое</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,1</td></tr><tr><td>Полотно гладкое</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td></tr></tbody></table></div><p class=\"k\">Витрины (деревянные)</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Элемент</th><th>до 4 м²</th><th>до 10 м²</th><th>более 10 м²</th></tr></thead><tbody><tr><td>Коробка</td><td class=\"m\">0,4</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td></tr><tr><td>Переплёт в 1 стекло</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td><td class=\"m\">0,3</td></tr><tr><td>Два переплёта в 1 стекло и 2 коробки</td><td class=\"m\">1,6</td><td class=\"m\">1,4</td><td class=\"m\">1,2</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 62, п. 2.6, таблицы 2-6.1, 2-6.2, 2-6.3</div></div></details>
<details><summary>Окраска полов и плинтусов</summary><div class=\"ans\"><p><span class=\"k\">Пол:</span> площадь пола без мест, занятых колоннами, печами, фундаментами и другими конструкциями, выступающими над полом.</p><p><span class=\"k\">Плинтус дощатого пола:</span> отдельно не считается, он уже входит в окраску пола.</p><p><span class=\"k\">Плинтус паркетного пола и пола из линолеума:</span> принимается как 10 % от площади пола. Расход определяется по нормам на улучшенную окраску дощатых полов.</p><div class=\"src\">Источник: Сборник 15, п. 1.20, 2.28; Сборник 62, п. 2.7</div></div></details>
<details><summary>Окраска фасадов</summary><div class=\"ans\"><p><span class=\"k\">Известковые, силикатные составы (в ремонте также цементные и казеиновые):</span> площадь стен с учётом изломов в плане, без вычета проёмов. Площади откосов, карнизов, тяг и других архитектурных деталей не учитываются.</p><p><span class=\"k\">Перхлорвиниловые, кремнийорганические, поливинилацетатные составы (в Сборнике 15 также акриловые):</span> площадь фактически окрашиваемой поверхности.</p><p><span class=\"k\">Фасадные работы по таблице 15-260:</span> площадь проёмов принята равной 30 % от площади фасада.</p><p><span class=\"k\">Водосточные трубы, пояски, сандрики, наружные подоконники:</span> по Сборнику 15: по площади фасада без вычета проёмов. По Сборнику 62 (ремонт): по площади фактически окрашиваемой поверхности.</p><p><span class=\"k\">Водосточные трубы диаметром 100–220 мм:</span> поверхность 100 м труб, включая ухваты, стыки и фальцы, принимается равной 3,5 м² на каждые 10 мм диаметра трубы. Воронка (с обеих сторон) считается как 1 м трубы того же диаметра.</p><div class=\"src\">Источник: Сборник 15, п. 2.21, 2.22, 2.32, 2.37; Сборник 62, п. 2.1, 2.2, 2.13</div></div></details>
<details><summary>Окраска древесины, вагонки, волнистых и рельефных поверхностей</summary><div class=\"ans\"><p><span class=\"k\">Вагонка:</span> площадь измеряется без огибания калёвок и отборок. Для учёта рельефа: по Сборнику 15 результат умножается на 1,1, по Сборнику 62 (ремонт) увеличивается на 20 %.</p><p><span class=\"k\">Бревенчатые стены:</span> обмер без огибания брёвен, результат увеличивается на 5 %, окна и двери вычитаются. Если есть обделки (карнизы, пилястры, откосы, наличники), проёмы не вычитаются и площадь обделок не прибавляется.</p><p><span class=\"k\">Волнистые асбоцементные листы и сталь:</span> площадь без учёта волны, результат × 1,2.</p><p><span class=\"k\">Рельефные стены (шагрень, шуба, линкруст и подобные):</span> объём работ увеличивается на 5 %.</p><p><span class=\"k\">Своды полуциркульные и эллиптические:</span> по развёрнутой поверхности.</p><p><span class=\"k\">Деревянные фермы:</span> площадь вертикальной проекции (с одной стороны), промежутки между элементами не вычитаются.</p><p><span class=\"k\">Металлическая кровля:</span> площадь кровли, без отдельного учёта фальцев, желобов, зонтов на дымовых трубах и покрытий слуховых окон.</p><div class=\"src\">Источник: Сборник 15, п. 2.30, 2.31, 2.33, 2.34; Сборник 62, п. 2.8–2.10, 2.12, 2.16</div></div></details>
<details><summary>Окраска решёток, сеток, мебели, труб и приборов</summary><div class=\"ans\"><p><span class=\"k\">Стальные решётки:</span> площадь вертикальной проекции с одной стороны, промежутки не вычитаются, затем коэффициент: простые решётки без рельефа с заполнением до 20 % (парапетные, пожарные лестницы, сетки с рамкой) — 0,5; средней сложности с заполнением до 30 % (лестничные, балконные) — 1; сложные с рельефом и заполнением более 30 % (жалюзийные, радиаторные, художественные) — 2,5.</p><p><span class=\"k\">Проволочная сетка:</span> площадь по контуру с обвязкой × 0,4. Обрамление из уголка считается отдельно.</p><p><span class=\"k\">Мебель:</span> шкафы, буфеты, гардеробы — по фактическому замеру. Табурет: площадь сиденья × 3,5. Скамья: × 2,75. Стул: × 4. Стол: площадь крышки × 2,5.</p><p><span class=\"k\">Раковины, мойки:</span> удвоенная площадь горизонтальной проекции.</p><p><span class=\"k\">Ванны:</span> утроенная площадь горизонтальной проекции.</p><p><span class=\"k\">Смывной бачок:</span> 0,7 м² (с учётом кронштейнов).</p><p><span class=\"k\">Радиаторы отопления:</span> площадь поверхности нагрева, со всех сторон. На один элемент (секцию): М-14А 0,254; М-14ОАО 0,299; М-90 0,2; МС-140 0,238; РД-90С 0,203; Стандарт-90 0,2 м². Панельный радиатор типа РСГ-1-1-3 — 0,73 м².</p><p><span class=\"k\">Большие металлические поверхности:</span> считаются площади более 5 м² в одном месте.</p><p>Окраска 1 погонного метра труб, м²:</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Диаметр, мм</th><th>15</th><th>20</th><th>25</th><th>32</th><th>40</th><th>50</th><th>63</th><th>75</th><th>100</th><th>125</th><th>150</th></tr></thead><tbody><tr><td>Стальные</td><td class=\"m\">0,11</td><td class=\"m\">0,13</td><td class=\"m\">0,16</td><td class=\"m\">0,18</td><td class=\"m\">0,21</td><td class=\"m\">0,26</td><td class=\"m\">0,31</td><td class=\"m\">0,36</td><td class=\"m\">0,46</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Чугунные</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">0,28</td><td class=\"m\">-</td><td class=\"m\">0,37</td><td class=\"m\">0,48</td><td class=\"m\">0,59</td><td class=\"m\">0,72</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 15, п. 2.35, 2.36; Сборник 62, п. 2.14, 2.15, 2.17–2.19</div></div></details>
<div class=\"sub\">Обойные и стекольные работы</div>
<details><summary>Оклейка обоями, обивка дверей, снятие старых обоев</summary><div class=\"ans\"><p><span class=\"k\">Оклейка стен:</span> площадь оклеиваемой поверхности. Окна и двери вычитаются, их площадь берётся по наружному обводу коробок.</p><p><span class=\"k\">Обивка дверей:</span> площадь фактически обиваемой поверхности.</p><p><span class=\"k\">Снятие старых обоев и линкруста:</span> площадь очищенной от обоев поверхности.</p><div class=\"src\">Источник: Сборник 15, п. 2.46, 2.47; Сборник 63, п. 2.2, 2.3</div></div></details>
<details><summary>Остекление</summary><div class=\"ans\"><p><span class=\"k\">Деревянные переплёты и балконные двери (жилые и общественные здания):</span> площадь проёма по наружному обводу коробок.</p><p><span class=\"k\">Двери (кроме балконных) и витрины:</span> по размеру стёкол.</p><p><span class=\"k\">Деревянная перегородка:</span> по наружному обводу её обвязки.</p><p><span class=\"k\">Стеновые и фонарные переплёты промзданий:</span> стальные: по наружному обводу обвязки. Деревянные в коробке: по наружному обводу коробки. Деревянные без коробки: по наружному обводу обвязки.</p><p><span class=\"k\">Стеновые панели из профильного стекла:</span> по наружному обводу стальных рам (проёмов в панелях нет).</p><p><span class=\"k\">Окно из профильного стекла:</span> по наружному обводу металлического обрамления или деревянной обвязки.</p><p><span class=\"k\">Зенитный фонарь из профильного стекла:</span> по внутреннему обводу низа его стакана (по световому проёму).</p><p><span class=\"k\">Перегородки из профильного стекла или стеклянных блоков:</span> по наружному обводу коробок за вычетом площади проёмов.</p><p><span class=\"k\">Остекление при ремонте:</span> по площади остекления, то есть по размеру стёкол.</p><div class=\"src\">Источник: Сборник 15, п. 2.38–2.45; Сборник 63, п. 2.1</div></div></details>
<div class=\"sub\">Полы</div>
<details><summary>Покрытие пола и подготовка под него</summary><div class=\"ans\"><p><span class=\"k\">Покрытие:</span> площадь между внутренними гранями стен или перегородок с учётом толщины отделки.</p><p><span class=\"k\">Добавляем:</span> покрытие в подоконных нишах и дверных проёмах.</p><p><span class=\"k\">Вычитаем:</span> перегородки, колонны, печи, выступающие фундаменты и другие подобные конструкции. При ремонте чистые перегородки не вычитаются.</p><p><span class=\"k\">Подстилающий слой (подготовка):</span> объём считается без мест, занятых печами, колоннами, выступающими фундаментами и подобными конструкциями.</p><p><span class=\"k\">Плитки ПВХ типа Colorex:</span> из площади покрытия вычитается площадь горизонтальной проекции устанавливаемого плинтуса.</p><p><span class=\"k\">Лаги:</span> разборка и смена — по площади пола.</p><div class=\"src\">Источник: Сборник 11, п. 2.1, 2.2, 2.4; Сборник 57, п. 2.1–2.3</div></div></details>
<div class=\"sub\">Перегородки, потолки, стены (ремонт)</div>
<details><summary>Перегородки</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь ремонтируемых перегородок за вычетом проёмов (по наружному обводу коробок). Высота — от чистого пола до потолка или до верха перегородки.</p><p><span class=\"k\">Смена отдельных участков:</span> по площади сменяемых участков.</p><p><span class=\"k\">Заделка проёмов:</span> по площади проёма.</p><div class=\"src\">Источник: Сборник 55, п. 2.1–2.3</div></div></details>
<details><summary>Перекрытия и подшивка потолков</summary><div class=\"ans\"><p><span class=\"k\">Ремонтируемые перекрытия:</span> площадь в пределах капитальных стен, без вычета мест, занятых печами и трубами.</p><p><span class=\"k\">Частичная смена перекрытий:</span> площадь между осями балок и капитальными стенами.</p><p><span class=\"k\">Подшивка потолков (разборка, устройство):</span> по площади подшивки.</p><p><span class=\"k\">Смена подборов перекрытий:</span> расстояние между осями балок × длина сменяемого участка.</p><div class=\"src\">Источник: Сборник 54, п. 2.1–2.3</div></div></details>
<details><summary>Стены (кирпичная кладка и деревянные)</summary><div class=\"ans\"><p><span class=\"k\">Кирпичная кладка:</span> объём за вычетом проёмов (по наружному обводу коробок). Архитектурные детали (пилястры, полуколонны, карнизы, парапеты, эркеры, лоджии) включаются в объём. Мелкие детали высотой до 25 см (сандрики, пояски) уже учтены и отдельно не добавляются.</p><p><span class=\"k\">Ниши и борозды:</span> гнёзда и борозды для балок и плит, а также ниши для отопительных приборов, вентиляционных и дымовых каналов из объёма не вычитаются. Ниши для встроенного оборудования в объём не включаются.</p><p><span class=\"k\">Периметр деревянных стен:</span> наружных — по наружным размерам здания, внутренних — по размерам между внутренними гранями стен.</p><p><span class=\"k\">Высота деревянных стен:</span> рубленых и каркасных — от нижней грани нижнего венца (обвязки) до верхней грани верхнего венца (обвязки). Из готовых щитов — от нижней грани цокольной обвязки до верха чердачной балки.</p><p><span class=\"k\">Площадь стен:</span> за вычетом проёмов, которые измеряются по наружным размерам коробок.</p><div class=\"src\">Источник: Сборник 53, п. 2.1–2.7</div></div></details>
<details><summary>Окна, двери, подоконные доски</summary><div class=\"ans\"><p><span class=\"k\">Окна и двери:</span> площадь проёма по наружному обводу коробок.</p><p><span class=\"k\">Подоконные доски:</span> площадь с учётом заделки в стену и в четверть коробки.</p><div class=\"src\">Источник: Сборник 56, п. 2.1, 2.2</div></div></details>
<div class=\"sub\">Лепные работы и леса</div>
<details><summary>Лепные работы</summary><div class=\"ans\"><p><span class=\"k\">Объём:</span> принимается по проекту и по перечню изделий в сборнике.</p><p><span class=\"k\">Высота выпуклых погонных деталей:</span> по огибу поперечного сечения.</p><p><span class=\"k\">Галтели и карнизы (нормативы Е15-109-6 … Е15-109-10):</span> длина устраиваемого карниза без декоративных стыковочных элементов (в том числе угловых), результат × 1,05.</p><p><span class=\"k\">Базы и капители на пилястры и полуколонны:</span> как на колонны, с коэффициентом 0,5.</p><p><span class=\"k\">Угловые базы (четверть окружности или четырёхугольник):</span> по таблицам баз на пилястрах с коэффициентом 0,5.</p><div class=\"src\">Источник: Сборник 15, п. 1.11, 2.19, 2.20; Сборник 64, п. 2.1, 2.2</div></div></details>
<details><summary>Леса и подмости</summary><div class=\"ans\"><p><span class=\"k\">Наружные леса:</span> по площади их вертикальной проекции на фасад.</p><p><span class=\"k\">Внутренние леса со сплошным настилом:</span> по площади горизонтальной проекции на основание (для штукатурки потолков и стен — по горизонтальной проекции потолков).</p><p><span class=\"k\">Внутренние леса только вдоль стен:</span> по площади вертикальной проекции на стены. Расчёт ведётся по нормам на устройство наружных лесов для отделочных работ (таблица 69-20, норма 2).</p><p><span class=\"k\">Фасады при штукатурке:</span> по вертикальной проекции стен без вычета проёмов.</p><div class=\"src\">Источник: Сборник 69, п. 2.1; Сборник 61, п. 2.11</div></div></details></div><p class=\"e-note\">Справочник носит информационный характер. Перед использованием в договорной смете числа проверяет технический специалист по действующим нормам.</p>"
}

pattern EstQualTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=10\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет · Справочник</div><h1>Как определяется качество работ</h1><p class=\"e-lead\">Качество отделки в сметных нормах определяется классом: простая, улучшенная или высококачественная. Класс задаёт, какие операции обязательны. Чем выше класс, тем больше слоёв и проходов, тем дороже и ровнее результат.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\" class=\"on\" aria-current=\"page\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\">{{ t.est_tab_elec }}</a></nav><section class=\"e-sec\"><h2>Три класса отделки</h2><div class=\"e-cards three\"><div class=\"e-card\"><span class=\"e-tag\">Простая</span><h3>9 операций из 19</h3><p>Очистка, расшивка трещин, подмазка и два слоя краски. Без сплошной шпатлёвки: неровности основания остаются заметными. Подходит для подсобных и технических помещений.</p></div><div class=\"e-card\"><span class=\"e-tag\">Улучшенная</span><h3>17 операций из 19</h3><p>К простой добавляются сплошная шпатлёвка, шлифовка, огрунтовка и флейцевание (разглаживание краски мягкой кистью). Поверхность ровная, следов кисти нет. Обычный выбор для квартир и офисов.</p></div><div class=\"e-card\"><span class=\"e-tag ok\">Высококачественная</span><h3>19 операций из 19</h3><p>Две сплошные шпатлёвки с двумя шлифовками. Максимально ровная и гладкая поверхность, нужна под глянец и боковой свет, а также в представительных помещениях.</p></div></div></section><section class=\"e-sec\"><h2>Что входит в каждый класс</h2><p class=\"e-lead2\">Пример: окраска водоэмульсионными составами по штукатурке. Перечень операций изложен по технической части сборника 15 норм НРР-2022 (таблица 7) своими словами; число операций сохранено.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Операция</th><th>Простая</th><th>Улучшенная</th><th>Высококачественная</th></tr></thead><tbody><tr><td>Очистка поверхности</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Сглаживание торцом дерева</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Расшивка трещин</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Проолифка</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Частичная подмазка с проолифкой подмазанных мест</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка подмазанных мест</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Первая сплошная шпатлёвка</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после первой шпатлёвки</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Вторая сплошная шпатлёвка</td><td class=\"m no\">нет</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после второй шпатлёвки</td><td class=\"m no\">нет</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td></tr><tr><td>Огрунтовка</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Флейцевание после грунтовки</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после грунтовки</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Первая окраска</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Флейцевание после первой окраски</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после первой окраски</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Вторая окраска</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Флейцевание или торцевание после второй окраски</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Вытягивание филёнок</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr class=\"tot\"><td>Итого операций</td><td class=\"m\">9</td><td class=\"m\">17</td><td class=\"m\">19</td></tr></tbody></table></div><p class=\"e-note\">Для масляных составов и других оснований (дерево, металл, сборные конструкции) набор операций отличается. Эти таблицы добавим после сверки.</p></section><section class=\"e-sec\"><h2>Карточки по видам работ</h2><p class=\"e-lead2\">Для каждого вида работ: допустимые отклонения, условия приёмки и схема. Числа взяты из белорусских норм: СП 1.03.01-2019 «Отделочные работы» (отделка и полы), ТКП 339-2022 и СН 4.04.01-2019 (электрика). Пункты указаны рядом. Каждую карточку можно скачать картинкой или документом с водяным знаком.</p></section><div class=\"e-sub q-chips\"><a href=\"#sec-obshchie\">Общие условия<span class=\"q-n\">1</span></a><a href=\"#sec-shtukaturka\">Штукатурные работы<span class=\"q-n\">3</span></a><a href=\"#sec-oblitsovka\">Облицовка и потолки<span class=\"q-n\">2</span></a><a href=\"#sec-okraska\">Окраска, обои и стекло<span class=\"q-n\">3</span></a><a href=\"#sec-poly\">Полы<span class=\"q-n\">6</span></a><a href=\"#sec-beton\">Бетонные работы<span class=\"q-n\">4</span></a><a href=\"#sec-sbornye\">Сборные конструкции<span class=\"q-n\">2</span></a><a href=\"#sec-kamen\">Каменные работы<span class=\"q-n\">4</span></a><a href=\"#sec-derevo\">Деревянные конструкции<span class=\"q-n\">3</span></a><a href=\"#sec-elektrika\">Электрика<span class=\"q-n\">13</span></a><a href=\"#sec-vodokanal\">Водоснабжение и канализация<span class=\"q-n\">5</span></a><a href=\"#sec-otoplenie\">Отопление<span class=\"q-n\">4</span></a><a href=\"#sec-ventilyaciya\">Вентиляция<span class=\"q-n\">4</span></a><a href=\"#sec-inzh-obshchie\">Общее для инженерных систем<span class=\"q-n\">4</span></a></div><details class=\"q-sec\" id=\"sec-obshchie\"><summary><span class=\"q-sh\"><b>Общие условия</b><small>Температура, влажность и подготовка основания для любой отделки.</small></span><span class=\"q-n\">1</span></summary><div class=\"e-sub q-chips\"><a href=\"#usloviya\">Условия производства отделки</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"usloviya\"><header><h3>Условия производства отделки</h3><p>Что должно быть выполнено до начала работ и пока идут работы. Общие для штукатурки, окраски, плитки и обоев.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 3.3–3.19, 7.11</div></header><div class=\"q-facts\"><div><b>+10 °C</b><span>и выше: воздух и основание внутри здания</span></div><div><b>≤ 60 %</b><span>влажность воздуха внутри, без сквозняков</span></div><div><b>8 % / 12 %</b><span>предельная влажность основания: бетон, камень, штукатурка / дерево</span></div><div><b>2 + 12 сут</b><span>держать +10 °C до начала и после окончания работ</span></div></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Внутри здания: температура воздуха и основания не ниже +10 °C, влажность воздуха не более 60 %, сквозняков нет (п. 3.14).</li><li>Температуру не ниже +10 °C держат круглосуточно: не менее 2 суток до начала, во время работ и не менее 12 суток после. Для обоев: до сдачи объекта (п. 3.14).</li><li>Снаружи: температура воздуха и основания не ниже +5 °C (п. 3.12).</li><li>Влажность основания под штукатурку, окраску, облицовку и обои: бетон, камень, оштукатуренные и прошпатлёванные поверхности не более 8 %, дерево не более 12 % (п. 3.17).</li><li>Сушить помещение можно калориферами. Открытые жаровни и печи-времянки запрещены (п. 3.15).</li><li>Нельзя красить и клеить обои по основанию с высолами, жировыми и битумными пятнами, наплывами раствора, ржавчиной и побелкой (п. 3.18).</li><li>Перед каждым слоем покрытия поверхность обеспыливают (п. 3.19).</li><li>Материалы поступают с документом о качестве изготовителя, сертификатом или декларацией соответствия (п. 3.4). Работы ведут по проекту производства работ и технологическим картам (п. 3.3).</li><li>Фасады не красят по наледи, в дождь и по сырой стене, при ветре сильнее 10 м/с (п. 7.11).</li></ul></div><p class=\"e-note\">Порядок и методы контроля задают СТБ 1472–1475 и СТБ 1483 (п. 3.9).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/usloviya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/usloviya.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-shtukaturka\"><summary><span class=\"q-sh\"><b>Штукатурные работы</b><small>Геометрия, слои и декоративные покрытия.</small></span><span class=\"q-n\">3</span></summary><div class=\"e-sub q-chips\"><a href=\"#shtukaturka-geometriya\">Штукатурка внутри здания: геометрия</a><a href=\"#shtukaturka-sloi\">Штукатурка: слои, армирование, сцепление</a><a href=\"#dekor-lepnina\">Декоративные покрытия и лепные изделия</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"shtukaturka-geometriya\"><header><h3>Штукатурка внутри здания: геометрия</h3><p>Допустимые отклонения оштукатуренных поверхностей для трёх видов штукатурки. Вид указывает проект (п. 4.2).</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 2, п. 4.2</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Простое</th><th class=\"n\">Улучшенное</th><th class=\"n\">Высококачественное</th></tr></thead><tbody><tr><td>Вертикальность на всю высоту помещения</td><td class=\"n m\">15</td><td class=\"n m\">10</td><td class=\"n m\">5</td></tr><tr><td>Вертикальность на 1 м высоты</td><td class=\"n m\">3</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>Горизонтальность на 1 м</td><td class=\"n m\">3</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>Неровности на участке 4 м²: число, не более (шт.)</td><td class=\"n m\">3</td><td class=\"n m\">2</td><td class=\"n m\">2</td></tr><tr><td>Неровности: глубина (высота), не более</td><td class=\"n m\">5</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>Откосы, пилястры, столбы, лузги: вертикальность на высоту</td><td class=\"n m\">10</td><td class=\"n m\">5</td><td class=\"n m\">3</td></tr><tr><td>Откосы, пилястры, столбы, лузги: на 1 м</td><td class=\"n m\">4</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>Криволинейные поверхности: отклонение от радиуса</td><td class=\"n m\">10</td><td class=\"n m\">7</td><td class=\"n m\">5</td></tr><tr><td>Откосы: отклонение ширины</td><td class=\"n m\">5</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>Тяги: прямолинейность между углами</td><td class=\"n m\">6</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 266\" role=\"img\" aria-label=\"Допуски по классам\" class=\"e-svg\"><rect x=\"190\" y=\"12\" width=\"12\" height=\"12\" fill=\"#c6c8cd\"/><text x=\"208\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Простое</text><rect x=\"281\" y=\"12\" width=\"12\" height=\"12\" fill=\"#6a6d75\"/><text x=\"299\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Улучшенное</text><rect x=\"393\" y=\"12\" width=\"12\" height=\"12\" fill=\"#1d1f23\"/><text x=\"411\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Высококачественное</text><text x=\"0\" y=\"58\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">На всю высоту</text><rect x=\"190\" y=\"34\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"44\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">15 мм</text><rect x=\"190\" y=\"49\" width=\"253.3\" height=\"11\" fill=\"#6a6d75\"/><text x=\"451.33333333333337\" y=\"59\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><rect x=\"190\" y=\"64\" width=\"126.7\" height=\"11\" fill=\"#1d1f23\"/><text x=\"324.6666666666667\" y=\"74\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"116\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">На 1 м высоты</text><rect x=\"190\" y=\"92\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"102\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"107\" width=\"253.3\" height=\"11\" fill=\"#6a6d75\"/><text x=\"451.33333333333337\" y=\"117\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><rect x=\"190\" y=\"122\" width=\"126.7\" height=\"11\" fill=\"#1d1f23\"/><text x=\"324.6666666666667\" y=\"132\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><text x=\"0\" y=\"174\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Глубина неровностей</text><rect x=\"190\" y=\"150\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"160\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><rect x=\"190\" y=\"165\" width=\"228.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"426.0\" y=\"175\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"180\" width=\"152.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"350.0\" y=\"190\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"232\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Откосы, столбы: на высоту</text><rect x=\"190\" y=\"208\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"218\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><rect x=\"190\" y=\"223\" width=\"190.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"388.0\" y=\"233\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><rect x=\"190\" y=\"238\" width=\"114.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"312.0\" y=\"248\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text></svg></div><div class=\"q-viz\"><svg viewBox=\"0 0 620 214\" role=\"img\" aria-label=\"Схема проверки ровности рейкой\" class=\"e-svg\"><g transform=\"translate(0,-68)\"><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170 L600 225 L20 225 Z\" fill=\"#f6f6f7\" opacity=\"0.7\"/><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\"/><rect x=\"50\" y=\"118\" width=\"520\" height=\"10\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"470\" y1=\"128\" x2=\"470\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"458\" y1=\"128\" x2=\"482\" y2=\"128\" stroke=\"#e3000f\" stroke-width=\"2\"/><line x1=\"458\" y1=\"170\" x2=\"482\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"494\" y=\"145\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">размер</text><text x=\"494\" y=\"163\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">неровности</text><text x=\"50\" y=\"108\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">рейка 2 м</text><text x=\"300\" y=\"196\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"middle\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">выпуклость</text><text x=\"24\" y=\"246\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">поверхность</text><text x=\"20\" y=\"272\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"500\" font-family=\"Nunito, Arial, sans-serif\">Допуск глубины неровности: 5 мм (простое), 3 мм (улучшенное), 2 мм (высококачественное)</text></g></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Поверхность гладкая и однородная, без пузырей, включений и трещин. Допускаются только усадочные трещины шириной не более 0,2 мм (п. 4.8).</li><li>Отклонения не выходят за пределы строки таблицы для вида штукатурки из проекта (табл. 2).</li><li>Малярные и обойные работы начинают по основанию, соответствующему табл. 2 (п. 7.1, 8.1).</li></ul></div><p class=\"e-note\">Метод измерений (рейка, отвес, уровень) задают СТБ 1472–1475. Схема проверки ровности показана ниже.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-geometriya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-geometriya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"shtukaturka-sloi\"><header><h3>Штукатурка: слои, армирование, сцепление</h3><p>Сколько слоёв и какой толщины, когда нужна сетка и какую прочность сцепления проверяют.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 1, п. 4.5–4.15</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Однослойное покрытие из гипсовых смесей, не более</td><td class=\"n m\">15</td></tr><tr><td>Однослойное покрытие из других смесей, не более</td><td class=\"n m\">20</td></tr><tr><td>Первый слой (обрызг) по камню и бетону</td><td class=\"n m\">5</td></tr><tr><td>Первый слой (обрызг) по дереву с дранкой</td><td class=\"n m\">9</td></tr><tr><td>Второй слой (грунт): известковый и известково-гипсовый</td><td class=\"n m\">7</td></tr><tr><td>Второй слой (грунт): цементный</td><td class=\"n m\">5</td></tr><tr><td>Третий слой: накрывочный</td><td class=\"n m\">2</td></tr><tr><td>Третий слой: декоративный накрывочный</td><td class=\"n m\">7</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 320\" role=\"img\" aria-label=\"Слои штукатурки\" class=\"e-svg\"><text x=\"0\" y=\"16\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Слои штукатурки по камню и бетону (масштаб 10:1)</text><rect x=\"10\" y=\"36\" width=\"150\" height=\"230\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><line x1=\"10\" y1=\"60\" x2=\"34\" y2=\"36\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"60\" x2=\"104\" y2=\"36\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"84\" x2=\"34\" y2=\"60\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"84\" x2=\"104\" y2=\"60\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"108\" x2=\"34\" y2=\"84\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"108\" x2=\"104\" y2=\"84\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"132\" x2=\"34\" y2=\"108\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"132\" x2=\"104\" y2=\"108\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"156\" x2=\"34\" y2=\"132\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"156\" x2=\"104\" y2=\"132\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"180\" x2=\"34\" y2=\"156\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"180\" x2=\"104\" y2=\"156\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"204\" x2=\"34\" y2=\"180\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"204\" x2=\"104\" y2=\"180\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"228\" x2=\"34\" y2=\"204\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"228\" x2=\"104\" y2=\"204\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"252\" x2=\"34\" y2=\"228\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"252\" x2=\"104\" y2=\"228\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"276\" x2=\"34\" y2=\"252\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"276\" x2=\"104\" y2=\"252\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><text x=\"18\" y=\"286\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">основание</text><rect x=\"160\" y=\"36\" width=\"50\" height=\"230\" fill=\"#c6c8cd\"/><rect x=\"330\" y=\"46\" width=\"16\" height=\"16\" fill=\"#c6c8cd\"/><text x=\"356\" y=\"59\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Обрызг</text><text x=\"356\" y=\"79\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">5 мм (по дереву с дранкой 9 мм)</text><rect x=\"210\" y=\"36\" width=\"70\" height=\"230\" fill=\"#6a6d75\"/><rect x=\"330\" y=\"108\" width=\"16\" height=\"16\" fill=\"#6a6d75\"/><text x=\"356\" y=\"121\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Грунт</text><text x=\"356\" y=\"141\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">7 мм известковый, 5 мм цементный</text><rect x=\"280\" y=\"36\" width=\"20\" height=\"230\" fill=\"#e3000f\"/><rect x=\"330\" y=\"170\" width=\"16\" height=\"16\" fill=\"#e3000f\"/><text x=\"356\" y=\"183\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Накрывка</text><text x=\"356\" y=\"203\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">2 мм (декоративная 7 мм)</text><line x1=\"160\" y1=\"280\" x2=\"300\" y2=\"280\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"330\" y=\"252\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Три слоя вместе: 14 мм</text><text x=\"330\" y=\"272\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Однослойно: до 15 мм (гипс), до 20 мм (прочие)</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Прочность сцепления с основанием: внутри здания не менее 0,2 МПа, снаружи не менее 0,4 МПа, если проект не задаёт иное (п. 4.5).</li><li>Слой до 10 мм можно не армировать. От 10 до 15 мм: стеклянная штукатурная сетка. От 15 до 20 мм: стальная сетка. Больше 20 мм нельзя, кроме лёгких и теплоизоляционных штукатурок (п. 4.13).</li><li>Сетка лежит внутри слоя, не касается основания и не выходит на поверхность (п. 4.14).</li><li>Конструктивное армирование ставят в углах проёмов, под окнами, на выступающих углах, в стыках разных материалов (п. 4.15).</li><li>Нельзя нагревать штукатурку при высыхании выше +23 °C и сквозняком проветривать. При +23 °C и выше основание увлажняют (п. 4.6, 4.7).</li><li>Гипсовое основание штукатурят только гипсовыми смесями по огрунтованной поверхности (п. 4.17).</li></ul></div><p class=\"e-note\">Ячеистый бетон: трещины шире 0,2 мм, раковины глубиной 12 мм и больше и «зуб» выше 1,5 мм в основании недопустимы, первый слой не тоньше 10 мм, водоудерживающая способность смеси не менее 95 % (п. 4.10–4.12).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-sloi.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-sloi.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"dekor-lepnina\"><header><h3>Декоративные покрытия и лепные изделия</h3><p>Гладкие декоративные покрытия выполняют по требованиям к штукатурке. Для лепных изделий есть свои допуски.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 4.18, 4.19, 5.1–5.4</div></header><div class=\"q-facts\"><div><b>1 мм</b><span>на 1 м длины: отклонение лепной детали от вертикали и горизонтали</span></div><div><b>10 мм</b><span>наибольшее смещение осей крупных деталей</span></div></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Декоративное покрытие сплошное, без пропусков, с прочным сцеплением с основанием (п. 5.2).</li><li>Толщину и число слоёв задают проект, технические документы и рекомендации изготовителя смеси (п. 5.3, 5.4).</li><li>Лепные изделия: стыки без перепадов, швы незаметны, нет раковин, изломов, трещин и наплывов, рельеф чёткий (п. 4.19).</li><li>Лепные изделия ставят после схватывания и высыхания штукатурки, крепят к арматуре, защищённой от коррозии (п. 4.18).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/dekor-lepnina.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/dekor-lepnina.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-oblitsovka\"><summary><span class=\"q-sh\"><b>Облицовка и потолки</b><small>Плитка, камень, листовые и панельные облицовки, подвесные потолки.</small></span><span class=\"q-n\">2</span></summary><div class=\"e-sub q-chips\"><a href=\"#oblitsovka-plitkoi\">Облицовка плиткой и камнем стен</a><a href=\"#listovye-potolki\">Листовые и панельные облицовки, подвесные потолки</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"oblitsovka-plitkoi\"><header><h3>Облицовка плиткой и камнем стен</h3><p>Допуски облицовки по виду поверхности и условия приёмки. Облицовку выполняют до устройства покрытия пола.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 3, п. 6.1–6.9</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Зеркальная, лощёная</th><th class=\"n\">Шлифованная и др.</th><th class=\"n\">Керамика</th></tr></thead><tbody><tr><td>Вертикальность на 1 м</td><td class=\"n m\">2</td><td class=\"n m\">3</td><td class=\"n m\">1,5</td></tr><tr><td>Вертикальность на этаж</td><td class=\"n m\">4</td><td class=\"n m\">8</td><td class=\"n m\">4</td></tr><tr><td>Положение швов от вертикали и горизонтали на 1 м</td><td class=\"n m\">1,5</td><td class=\"n m\">3</td><td class=\"n m\">1,5</td></tr><tr><td>Перепады на стыках</td><td class=\"n m\">1</td><td class=\"n m\">1</td><td class=\"n m\">1</td></tr><tr><td>Ровность на 1 м</td><td class=\"n m\">2</td><td class=\"n m\">4</td><td class=\"n m\">2</td></tr><tr><td>Ширина шва (плюс-минус)</td><td class=\"n m\">0,5</td><td class=\"n m\">1</td><td class=\"n m\">0,5</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 266\" role=\"img\" aria-label=\"Допуски облицовки\" class=\"e-svg\"><rect x=\"190\" y=\"12\" width=\"12\" height=\"12\" fill=\"#c6c8cd\"/><text x=\"208\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Зеркальная</text><rect x=\"302\" y=\"12\" width=\"12\" height=\"12\" fill=\"#6a6d75\"/><text x=\"320\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Шлифованная</text><rect x=\"421\" y=\"12\" width=\"12\" height=\"12\" fill=\"#1d1f23\"/><text x=\"439\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Керамика</text><text x=\"0\" y=\"58\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Вертикальность на 1 м</text><rect x=\"190\" y=\"34\" width=\"253.3\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"451.33333333333337\" y=\"44\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><rect x=\"190\" y=\"49\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"59\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"64\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"74\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"116\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Положение швов на 1 м</text><rect x=\"190\" y=\"92\" width=\"190.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"388.0\" y=\"102\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><rect x=\"190\" y=\"107\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"117\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"122\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"132\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"174\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность на 1 м</text><rect x=\"190\" y=\"150\" width=\"190.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"388.0\" y=\"160\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><rect x=\"190\" y=\"165\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"175\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><rect x=\"190\" y=\"180\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"190\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"232\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ширина шва, ±</text><rect x=\"190\" y=\"208\" width=\"190.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"388.0\" y=\"218\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text><rect x=\"190\" y=\"223\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"233\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><rect x=\"190\" y=\"238\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"248\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Прочность сцепления облицовки с основанием не менее 0,4 МПа (п. 6.2).</li><li>Клеевой слой на растворе 7–15 мм. Полимерминеральный клей: 2–3 мм для плитки до 100×100 мм, 3–4 мм для плитки свыше 100×100 до 300×300 мм; клей наносят ровно, без потёков (п. 6.3).</li><li>Поверхность ровная, без провесов в стыках, вибрации и отслоений (п. 6.7).</li><li>Плиты толще 10 мм крепят на растворе с дополнительными креплениями или на относе с вентилируемым зазором. Природный камень на растворе не толще 10 мм (п. 6.9).</li><li>Другие допуски табл. 3: гранит и искусственный камень, мрамор: ширина шва ±1,0; «скала»: вертикальность 3,0 на 1 м, швы 3,0, перепады 2,0, шов ±2,0.</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/oblitsovka-plitkoi.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/oblitsovka-plitkoi.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"listovye-potolki\"><header><h3>Листовые и панельные облицовки, подвесные потолки</h3><p>Гипсокартон, панели, рейки, подвесные потолки: допуски каркаса и поверхности.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 4, п. 6.6–6.8, 7.6</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Перепад между плитами, панелями, рейками, листами</td><td class=\"n m\">2</td></tr><tr><td>Вертикаль и горизонталь каркаса и облицовки на 1 м</td><td class=\"n m\">1,5</td></tr><tr><td>Вертикаль и горизонталь на всю длину</td><td class=\"n m\">7</td></tr><tr><td>Ровность (прямолинейность)</td><td class=\"n m\">1,5</td></tr><tr><td>Вертикальность стыков на 1 м</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Перепад между листами</text><rect x=\"220\" y=\"6\" width=\"97.1\" height=\"22\" fill=\"#1d1f23\"/><text x=\"325.1428571428571\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">На 1 м</text><rect x=\"220\" y=\"40\" width=\"72.9\" height=\"22\" fill=\"#1d1f23\"/><text x=\"300.8571428571429\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность</text><rect x=\"220\" y=\"74\" width=\"72.9\" height=\"22\" fill=\"#1d1f23\"/><text x=\"300.8571428571429\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стыки на 1 м</text><rect x=\"220\" y=\"108\" width=\"48.6\" height=\"22\" fill=\"#1d1f23\"/><text x=\"276.57142857142856\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">На всю длину</text><rect x=\"220\" y=\"142\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">7 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Шаг горизонтальных направляющих каркаса не более 450 мм (п. 6.6).</li><li>Металлический каркас защищён от коррозии, деревянный обработан антисептиком и огнезащитой (п. 6.8).</li><li>Швы гипсокартона проклеены, зашпатлёваны и зашлифованы заподлицо (п. 7.6).</li><li>Конструкции на относе и подвесные потолки выполняют по проектной конструкции (п. 6.6).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/listovye-potolki.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/listovye-potolki.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-okraska\"><summary><span class=\"q-sh\"><b>Окраска, обои и стекло</b><small>Малярные работы, оклейка обоями, остекление.</small></span><span class=\"q-n\">3</span></summary><div class=\"e-sub q-chips\"><a href=\"#okraska\">Окраска и малярные работы</a><a href=\"#oboi\">Оклейка обоями</a><a href=\"#steklo\">Стекольные работы</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"okraska\"><header><h3>Окраска и малярные работы</h3><p>Основание готовят по допускам штукатурки. Вид покрытия (простое, улучшенное, высококачественное) указывает проект.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 5, п. 7.1–7.12 · Сборник 15 НРР-2022, табл. 7</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Простое</th><th class=\"n\">Улучшенное</th><th class=\"n\">Высококачественное</th></tr></thead><tbody><tr><td>Искривление линий в местах сопряжения цветов на 1 м</td><td class=\"n m\">5</td><td class=\"n m\">2</td><td class=\"n m\">не допускается</td></tr><tr><td>Отклонение ширины бордюров, фризов, филёнок при разных колерах на 1 м</td><td class=\"n m\">1</td><td class=\"n m\">1</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 152\" role=\"img\" aria-label=\"Число операций по классам\" class=\"e-svg\"><text x=\"0\" y=\"16\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Число операций из 19 (водоэмульсионная окраска по штукатурке)</text><text x=\"0\" y=\"52\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Простое</text><rect x=\"190\" y=\"34\" width=\"171\" height=\"26\" fill=\"#c6c8cd\"/><text x=\"368.52631578947364\" y=\"53\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">9 из 19</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Улучшенное</text><rect x=\"190\" y=\"72\" width=\"322\" height=\"26\" fill=\"#6a6d75\"/><text x=\"520.1052631578948\" y=\"91\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">17 из 19</text><text x=\"0\" y=\"128\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Высококачественное</text><rect x=\"190\" y=\"110\" width=\"360\" height=\"26\" fill=\"#1d1f23\"/><text x=\"558.0\" y=\"129\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">19 из 19</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Основание соответствует табл. 2 для вида покрытия (п. 7.1).</li><li>Деревянные поверхности строганые, без ворса и заусенцев, при необходимости зашлифованы (п. 7.4).</li><li>Трещины расшивают, грунтуют и заделывают шпатлёвкой на глубину не менее 2 мм (п. 7.6).</li><li>Грунтуют после шлифования каждого слоя шпатлёвки и перед первым слоем краски. Шлифуют после каждого слоя шпатлёвки (п. 7.7, 7.8).</li><li>Число слоёв шпатлёвки зависит от вида покрытия: больше слоёв у высококачественного (п. 7.8).</li><li>Фасады: см. условия производства (наледь, дождь, ветер сильнее 10 м/с).</li></ul></div><p class=\"e-note\">Состав операций: простое 9, улучшенное 17, высококачественное 19 из 19 (водоэмульсионная окраска по штукатурке).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/okraska.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/okraska.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"oboi\"><header><h3>Оклейка обоями</h3><p>Допуски стыков и условия оклейки.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 8.1–8.5</div></header><div class=\"q-facts\"><div><b>2 мм</b><span>наибольшее отклонение стыков от вертикали на всю высоту помещения</span></div><div><b>4 мм</b><span>наибольший нахлёст полотен</span></div><div><b>0,5 мм</b><span>наибольший зазор при стыковке встык</span></div><div><b>≤ 23 °C</b><span>температура воздуха, пока обои сохнут</span></div></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Основание соответствует табл. 2 и требованиям п. 7.6 (п. 8.1).</li><li>До оклейки закончены скрытая электро- и слаботочная проводка (кроме розеток и выключателей), сантехника, окраска потолков и основные малярные работы (п. 8.2).</li><li>Полотна одного цвета и оттенка, кромки нахлёстов обращены к световым проёмам (п. 8.3).</li><li>Нет пузырей, пятен, пропусков, отслоений. Плинтусы, наличники, розетки и выключатели не заклеены (п. 8.3).</li><li>Пока обои сохнут, их защищают от сквозняков и прямого солнца, влажность поддерживают стабильной (п. 8.4).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/oboi.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/oboi.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"steklo\"><header><h3>Стекольные работы</h3><p>Листовое стекло, стеклопакеты и стеклоблоки.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 9.1–9.3</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Стеклоблоки: отклонение положения швов, не более</td><td class=\"n m\">3</td></tr><tr><td>Стеклоблоки: отклонение от вертикали на 1 м</td><td class=\"n m\">2</td></tr><tr><td>Стеклоблоки: отклонение от вертикали на всю высоту</td><td class=\"n m\">10</td></tr><tr><td>Стеклоблоки: видимая толщина шва на растворе</td><td class=\"n m\">8–10</td></tr><tr><td>Стеклоблоки: видимая толщина шва на клее, не более</td><td class=\"n m\">3</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Положение швов</text><rect x=\"220\" y=\"6\" width=\"102.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"330.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Вертикаль на 1 м</text><rect x=\"220\" y=\"40\" width=\"68.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"296.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Вертикаль на всю высоту</text><rect x=\"220\" y=\"74\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Стекло не дребезжит, замазка без трещин, штапики прилегают плотно (п. 9.1.2).</li><li>Нельзя ставить стекла со сколами более 10 мм и грязные, нельзя делать стыки стёкол в жилых и общественных зданиях (п. 9.1.3).</li><li>Стеклопакеты на площадке не дорабатывают. Трещины, сколы, отслоения клеевых швов и повреждённые рамки недопустимы (п. 9.3.1, 9.3.2).</li><li>Стеклопакет ставят на опорные и фиксирующие колодки, зазоры заполняют нетвердеющим герметиком (п. 9.3.3).</li><li>Стеклоблоки: два стержня диаметром 4–6 мм в швах на растворе или две стальные полосы 2×30–40 мм на клее. Крепление к стенам через каждые 3 ряда (блок 60 мм) или 5 рядов (блок 98 мм) (п. 9.2.2, 9.2.3).</li><li>Трещины, выколы, пробоины и загрязнения стеклоблоков недопустимы (п. 9.2.4).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/steklo.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/steklo.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-poly\"><summary><span class=\"q-sh\"><b>Полы</b><small>Основание, стяжка и покрытия: наливные, паркет, ламинат, линолеум, плитка.</small></span><span class=\"q-n\">6</span></summary><div class=\"e-sub q-chips\"><a href=\"#osnovanie-pola\">Основание под полы</a><a href=\"#styazhka\">Стяжка под покрытие</a><a href=\"#nalivnye-polimery\">Наливные и монолитные полы</a><a href=\"#parket-laminat\">Паркет, доска и ламинат</a><a href=\"#linoleum\">Линолеум и рулонные покрытия</a><a href=\"#plitka-pola\">Плиточные полы</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"osnovanie-pola\"><header><h3>Основание под полы</h3><p>Грунт, подсыпка из песка и щебня и бетонный подстилающий слой.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.1–10.4</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Грунт: отклонение от ровности, не более</td><td class=\"n m\">20</td></tr><tr><td>Песок, щебень, гравий: ровность поверхности, не более</td><td class=\"n m\">15</td></tr><tr><td>Бетонный слой под бесшовные покрытия: ровность, не более</td><td class=\"n m\">4</td></tr><tr><td>Бетонный слой под оклеечную гидроизоляцию и мастики: ровность, не более</td><td class=\"n m\">5</td></tr><tr><td>Бетонный слой под прочие покрытия: ровность, не более</td><td class=\"n m\">10</td></tr><tr><td>Бетонный слой: толщина, не менее (жилые и общественные здания)</td><td class=\"n m\">80</td></tr><tr><td>Подсыпка: толщина, не менее (песок / щебень, гравий, шлак)</td><td class=\"n m\">60 / 80</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Грунт</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">20 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Песок, щебень</text><rect x=\"220\" y=\"40\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">15 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Бетон: прочие</text><rect x=\"220\" y=\"74\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Бетон: гидроизоляция</text><rect x=\"220\" y=\"108\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Бетон: бесшовные</text><rect x=\"220\" y=\"142\" width=\"68.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"296.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Класс бетона подстилающего слоя не ниже C8/10, толщина не меньше 80 мм в жилых и общественных зданиях и 100 мм в производственных (п. 10.3.1, 10.3.2).</li><li>Пылевидных и глинистых примесей в подсыпке не более 3 % по массе (п. 10.4.1).</li><li>Растительный грунт, ил, торф и насыпь с мусором под полы не годятся. Мёрзлый грунт в подсыпке недопустим (п. 10.2.3, 10.1.3).</li><li>Уклон и горизонтальность: 0,2 % от размера помещения, а для помещений 25 м и больше не более 50 мм (п. 10.1.8).</li><li>Толщина слоёв по проекту, превышение не более чем на 10 % (п. 10.1.9).</li><li>Полы устраивают после монтажа и испытаний инженерных систем, штукатурки, облицовки и окраски стен и потолков (п. 10.1.1, 3.21).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/osnovanie-pola.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/osnovanie-pola.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"styazhka\"><header><h3>Стяжка под покрытие</h3><p>Допуск на ровность зависит от того, какое покрытие будет сверху.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.5, 10.9.2, 10.1.6, 10.1.7</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Под линолеум, рулонные синтетические, паркет, ламинат, ПВХ-плитку, ПВА-покрытия</td><td class=\"n m\">2</td></tr><tr><td>Под керамическую плитку, бесшовные покрытия, «тёплые полы», плиты других видов</td><td class=\"n m\">4</td></tr><tr><td>Под прочие покрытия</td><td class=\"n m\">6</td></tr><tr><td>Толщина по бетонному основанию и плитам перекрытия, не менее</td><td class=\"n m\">20</td></tr><tr><td>Толщина по тепло- или звукоизоляции, не менее</td><td class=\"n m\">40</td></tr><tr><td>Зазор у стен, заполняется звукоизоляцией</td><td class=\"n m\">10–25</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Под линолеум, паркет, ламинат</text><rect x=\"220\" y=\"6\" width=\"113.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"341.3333333333333\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Под плитку, наливные, «тёплые полы»</text><rect x=\"220\" y=\"40\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Под прочие покрытия</text><rect x=\"220\" y=\"74\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">6 мм</text></svg></div><div class=\"q-viz\"><svg viewBox=\"0 0 620 214\" role=\"img\" aria-label=\"Схема проверки ровности рейкой\" class=\"e-svg\"><g transform=\"translate(0,-68)\"><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170 L600 225 L20 225 Z\" fill=\"#f6f6f7\" opacity=\"0.7\"/><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\"/><rect x=\"50\" y=\"118\" width=\"520\" height=\"10\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"470\" y1=\"128\" x2=\"470\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"458\" y1=\"128\" x2=\"482\" y2=\"128\" stroke=\"#e3000f\" stroke-width=\"2\"/><line x1=\"458\" y1=\"170\" x2=\"482\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"494\" y=\"145\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">размер</text><text x=\"494\" y=\"163\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">неровности</text><text x=\"50\" y=\"108\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">рейка 2 м</text><text x=\"300\" y=\"196\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"middle\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">выпуклость</text><text x=\"24\" y=\"246\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">поверхность</text><text x=\"20\" y=\"272\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"500\" font-family=\"Nunito, Arial, sans-serif\">Допуск просвета под рейкой зависит от покрытия: 2, 4 или 6 мм</text></g></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Бетон стяжки не ниже B7,5, раствор не ниже M100 (п. 10.5.1).</li><li>Цементные слои выдерживают под постоянно влажным материалом не менее 7 суток (п. 10.1.6).</li><li>Ходить по раствору под штучные материалы можно после набора прочности 2,5 МПа, по монолитному покрытию после 5,0 МПа (п. 10.1.7).</li><li>Влажность основания под покрытия из древесины: не более 4 % для панелей перекрытий, 5 % для цементных и полимерцементных стяжек (п. 10.9.2).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/styazhka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/styazhka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"nalivnye-polimery\"><header><h3>Наливные и монолитные полы</h3><p>Бесшовные полимерные, самонивелирующиеся и монолитные покрытия.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.8, 10.12</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ровность: ПВА-покрытия</td><td class=\"n m\">2</td></tr><tr><td>Ровность: полиминеральные покрытия</td><td class=\"n m\">4</td></tr><tr><td>Ровность: асфальтобетон</td><td class=\"n m\">6</td></tr><tr><td>Ровность: цементно-бетонное монолитное покрытие</td><td class=\"n m\">4</td></tr><tr><td>Толщина наливного слоя, не менее</td><td class=\"n m\">3</td></tr><tr><td>Грунтовка, не тоньше</td><td class=\"n m\">0,1</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">ПВА-покрытия</text><rect x=\"220\" y=\"6\" width=\"113.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"341.3333333333333\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Полиминеральные</text><rect x=\"220\" y=\"40\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Цементно-бетонные</text><rect x=\"220\" y=\"74\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Асфальтобетон</text><rect x=\"220\" y=\"108\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">6 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность основания 4–6 %. Укладка при температуре основания 5–25 °C и относительной влажности воздуха около 60 % (п. 10.12.4, 10.12.5).</li><li>Защищать слой от жары, прямого солнца и сквозняков (п. 10.12.7).</li><li>Покрытие сцеплено со всем основанием, без трещин, бугорков и наплывов (п. 10.12.9).</li><li>Монолитные покрытия: бетон не ниже C12/15, раствор не ниже M200, воду на месте укладки не добавляют (п. 10.8.2, 10.8.3).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/nalivnye-polimery.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/nalivnye-polimery.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"parket-laminat\"><header><h3>Паркет, доска и ламинат</h3><p>Влажность материалов, лаги, зазоры и допуски.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.9</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ровность покрытия, не более</td><td class=\"n m\">2</td></tr><tr><td>Зазор между досками, не более</td><td class=\"n m\">1</td></tr><tr><td>Зазор у паркетных досок, щитов и ДВП, не более</td><td class=\"n m\">0,5</td></tr><tr><td>Зазор у штучного паркета, не более</td><td class=\"n m\">0,3</td></tr><tr><td>Клеевой слой, не толще</td><td class=\"n m\">1</td></tr><tr><td>Зазор плинтуса до покрытия или стены, не более</td><td class=\"n m\">1</td></tr><tr><td>Зазор ламината у стен</td><td class=\"n m\">8–10</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Зазор между досками</text><rect x=\"220\" y=\"40\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Паркетные доски, щиты</text><rect x=\"220\" y=\"74\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Штучный паркет</text><rect x=\"220\" y=\"108\" width=\"51.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"279.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность материалов: лаги и прокладки не более 18 %, доски покрытия 12 ± 3 %, штучный паркет, паркетные щиты и ДВП 10 %, ДСП 12 % (п. 10.9.1).</li><li>Шаг лаг 0,4–0,5 м на плитах и балках. Зазор между лагами и стенами 20–30 мм, стыки лаг вразбежку не менее 0,5 м (п. 10.9.6, 10.9.8).</li><li>Паркетная планка приклеена не менее чем на 80 % площади, ДВП не менее чем на 40 % (п. 10.9.14).</li><li>Уступы между элементами недопустимы (п. 10.9.16).</li><li>Ламинат лежит без сцепления с основанием на подложке. Компенсационные швы нужны, если длина или ширина больше 8 м (п. 10.9.19–10.9.21).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/parket-laminat.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/parket-laminat.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"linoleum\"><header><h3>Линолеум и рулонные покрытия</h3><p>Основание, клей, швы и допуски.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.10</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ровность основания, не более</td><td class=\"n m\">2</td></tr><tr><td>Зазор у стен, не более</td><td class=\"n m\">5</td></tr><tr><td>Уступы и зазоры в стыках, не более</td><td class=\"n m\">0,3</td></tr><tr><td>Наплыв сварного шва по высоте, не более</td><td class=\"n m\">0,5</td></tr><tr><td>Клеевой слой, не толще</td><td class=\"n m\">0,8</td></tr><tr><td>Грунт, не тоньше</td><td class=\"n m\">0,3</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Зазор у стен</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность основания</text><rect x=\"220\" y=\"40\" width=\"136.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"364.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Клей</text><rect x=\"220\" y=\"74\" width=\"54.4\" height=\"22\" fill=\"#1d1f23\"/><text x=\"282.4\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,8 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Наплыв шва</text><rect x=\"220\" y=\"108\" width=\"34.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"262.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Уступы, зазоры</text><rect x=\"220\" y=\"142\" width=\"20.4\" height=\"22\" fill=\"#1d1f23\"/><text x=\"248.4\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность основания не более 4–5 % (п. 10.10.1).</li><li>Рулоны выдерживают при температуре не ниже 15 °C, пока не исчезнет волнистость (п. 10.10.3).</li><li>Поперечных швов в зонах интенсивного движения нет. Продольных швов не больше двух на кухнях и в жилых комнатах, трёх в общественных зданиях (п. 10.10.11, 10.10.12).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/linoleum.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/linoleum.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"plitka-pola\"><header><h3>Плиточные полы</h3><p>Прослойка, швы, ровность.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.11</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ширина и прямолинейность швов (плюс-минус)</td><td class=\"n m\">1,5</td></tr><tr><td>Ровность покрытия, не более</td><td class=\"n m\">2</td></tr><tr><td>Уступ между плитками, не более</td><td class=\"n m\">1</td></tr><tr><td>Раствор прослойки, толщина</td><td class=\"n m\">10–15</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Швы, ±</text><rect x=\"220\" y=\"6\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность</text><rect x=\"220\" y=\"40\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Уступ между плитками</text><rect x=\"220\" y=\"74\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text></svg></div><div class=\"q-viz\"><svg viewBox=\"0 0 620 214\" role=\"img\" aria-label=\"Схема проверки ровности рейкой\" class=\"e-svg\"><g transform=\"translate(0,-68)\"><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170 L600 225 L20 225 Z\" fill=\"#f6f6f7\" opacity=\"0.7\"/><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\"/><rect x=\"50\" y=\"118\" width=\"520\" height=\"10\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"470\" y1=\"128\" x2=\"470\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"458\" y1=\"128\" x2=\"482\" y2=\"128\" stroke=\"#e3000f\" stroke-width=\"2\"/><line x1=\"458\" y1=\"170\" x2=\"482\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"494\" y=\"145\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">размер</text><text x=\"494\" y=\"163\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">неровности</text><text x=\"50\" y=\"108\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">рейка 2 м</text><text x=\"300\" y=\"196\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"middle\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">выпуклость</text><text x=\"24\" y=\"246\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">поверхность</text><text x=\"20\" y=\"272\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"500\" font-family=\"Nunito, Arial, sans-serif\">Ровность плиточного покрытия: не более 2 мм</text></g></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность основания не более 4 % для панелей перекрытий и 5 % для стяжек (п. 10.11.3).</li><li>Плитка приклеена всей поверхностью (п. 10.11.8).</li><li>Излишки раствора и клея из швов удаляют на глубину не менее половины толщины плитки (п. 10.11.5).</li><li>Прослойка из клея и мастик: по технической документации и инструкции изготовителя (п. 10.11.2).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/plitka-pola.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/plitka-pola.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-beton\"><summary><span class=\"q-sh\"><b>Бетонные работы</b><small>Опалубка, арматура и защитный слой, классы поверхностей, допуски готовых монолитных конструкций.</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#bt-opalubka\">Опалубка</a><a href=\"#bt-armatura\">Арматура и защитный слой</a><a href=\"#bt-klassy\">Классы бетонных поверхностей</a><a href=\"#bt-konstrukcii\">Готовые монолитные конструкции</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"bt-opalubka\"><header><h3>Опалубка</h3><p>Точность установки опалубки под разную отделку и прочность бетона, при которой опалубку снимают.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 7.2.1–7.2.12, табл. 7.1</div></header><div class=\"q-facts\"><div><b>2 мм</b><span>перепад лицевых поверхностей палубы под шпатлёвку (классы А, Б)</span></div><div><b>1 мм</b><span>перепад палубы под оклейку обоями (класс А)</span></div><div><b>0,2–0,3 МПа</b><span>наименьшая прочность бетона вертикальных конструкций при распалубке</span></div><div><b>15 м/с</b><span>при ветре сильнее опалубку не монтируют и не разбирают</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Перепад лицевых поверхностей палубы под шпатлёвку (классы А, Б), не более, мм</td><td class=\"n m\">2</td></tr><tr><td>Зазор в стыках палубы под шпатлёвку, не более, мм</td><td class=\"n m\">2</td></tr><tr><td>Перепад лицевых поверхностей палубы под обои (класс А), не более, мм</td><td class=\"n m\">1</td></tr><tr><td>Зазор в стыках палубы под обои, не более, мм</td><td class=\"n m\">2</td></tr><tr><td>Отклонение щитов от вертикали на всю высоту: фундаменты, мм</td><td class=\"n m\">12</td></tr><tr><td>То же для стен и колонн, мм</td><td class=\"n m\">10</td></tr><tr><td>Отклонение опалубки перекрытий и балок от горизонтали на всю длину, мм</td><td class=\"n m\">10</td></tr><tr><td>Расстояния между опорами изгибаемых элементов: на 1 м пролёта, мм</td><td class=\"n m\">25</td></tr><tr><td>То же на весь пролёт, не более, мм</td><td class=\"n m\">50</td></tr><tr><td>Расстояние между тяжами, мм</td><td class=\"n m\">20</td></tr><tr><td>Внутренний размер сечения собранной опалубки, мм</td><td class=\"n m\">+5 / −3</td></tr><tr><td>Длина, пролёт или высота опалубки до 6 м, мм</td><td class=\"n m\">±12</td></tr><tr><td>То же более 6 м, мм</td><td class=\"n m\">±20</td></tr><tr><td>Размеры опалубки дверных и оконных проёмов, мм</td><td class=\"n m\">+15 / −12</td></tr><tr><td>Фиксаторы арматуры по сечению колонн и стен, мм</td><td class=\"n m\">+4 / −3</td></tr><tr><td>Фиксаторы арматуры по высоте стены или колонны, мм</td><td class=\"n m\">±20</td></tr><tr><td>Фиксаторы арматуры по длине стены, мм</td><td class=\"n m\">±40</td></tr><tr><td>Телескопические стойки и башни в плоскости опирания, мм</td><td class=\"n m\">±50</td></tr><tr><td>Совмещение рисок осей опалубки с разбивочными осями, мм</td><td class=\"n m\">±8</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Распалубка: пролёт до 2 м</text><rect x=\"220\" y=\"6\" width=\"212.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"440.5\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">50 % проектной прочности</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Пролёт 2–6 м</text><rect x=\"220\" y=\"40\" width=\"297.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"525.5\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">70 % проектной прочности</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Пролёт более 6 м</text><rect x=\"220\" y=\"74\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">80 % проектной прочности</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Опалубка по СТБ 1110 даёт проектную форму, размеры и качество поверхности в пределах допусков. Она прочная, жёсткая, устойчивая, геометрически неизменяемая и достаточно герметичная при бетонировании (п. 7.1.2, 7.2.1).</li><li>Горизонтальные и наклонные конструкции без нагрузки распалубливают при прочности бетона: пролёт до 2 м — 50 % проектной, от 2 до 6 м — 70 %, свыше 6 м — 80 %. Со страховочными стойками при пролёте до 6 м — 50–60 % по проекту (табл. 7.1).</li><li>Загруженные конструкции, в том числе нагруженные вышележащим бетоном, распалубливают по решению ППР, согласованному с проектной организацией (табл. 7.1).</li><li>Решение о распалубке принимают по испытаниям контрольных образцов или по прочности бетона в конструкции неразрушающими методами (п. 7.9.1). Разбирают в порядке, обратном монтажу (п. 7.9.4).</li><li>Опорные элементы опалубки (башни, телескопические стойки, раскосы) без паспортных данных по несущей способности и устойчивости не применяют. При высоте опорной системы более 5 м к ППР прикладывают статические расчёты (п. 7.2.3).</li><li>Опалубку перекрытия на телескопических стойках без временного раскрепления треногами или другими элементами не монтируют (п. 7.2.5).</li><li>Скорость бетонирования выбирают по несущей способности опалубки и боковому давлению смеси (п. 7.2.6).</li><li>Установку опалубки сопровождает геодезический контроль, принимают её по акту (п. 7.2.10).</li></ul></div><p class=\"e-note\">Допуски таблицы 7.1 в ППР можно изменить при обосновании, но готовая конструкция должна укладываться в табл. 7.13 (п. 7.2.9).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-opalubka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-opalubka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"bt-armatura\"><header><h3>Арматура и защитный слой</h3><p>Шаг стержней, расстояния между рядами и допуск толщины защитного слоя бетона.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 7.3.1–7.3.9, табл. 7.2 · СН 1.03.01-2019, п. 7.4.3, 7.4.4</div></header><div class=\"q-facts\"><div><b>±10 мм</b><span>шаг рабочих стержней колонн и балок</span></div><div><b>±20 мм</b><span>шаг стержней плит и стен фундаментов</span></div><div><b>пластик</b><span>материал фиксаторов защитного слоя (по умолчанию)</span></div><div><b>±10 мм</b><span>расстояние между рядами арматуры плит и балок толщиной до 1 м</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Расстояние между рабочими стержнями: колонны и балки</td><td class=\"n m\">±10</td></tr><tr><td>То же плиты и стены фундаментов</td><td class=\"n m\">±20</td></tr><tr><td>То же массивные конструкции</td><td class=\"n m\">±30</td></tr><tr><td>Расстояние между рядами: плиты и балки толщиной до 1 м включительно</td><td class=\"n m\">±10</td></tr><tr><td>То же конструкции толщиной более 1 м</td><td class=\"n m\">±20</td></tr><tr><td>Защитный слой до 15 мм, сечение конструкции до 100 мм</td><td class=\"n m\">+4</td></tr><tr><td>Защитный слой до 15 мм, сечение 101–200 мм</td><td class=\"n m\">+5</td></tr><tr><td>Защитный слой 15–20 мм, сечение до 100 мм</td><td class=\"n m\">+4 / −3</td></tr><tr><td>Защитный слой 15–20 мм, сечение 101–200 мм</td><td class=\"n m\">+8 / −3</td></tr><tr><td>Защитный слой 15–20 мм, сечение 201–300 мм</td><td class=\"n m\">+10 / −3</td></tr><tr><td>Защитный слой 15–20 мм, сечение более 300 мм</td><td class=\"n m\">+15 / −5</td></tr><tr><td>Защитный слой более 20 мм, сечение до 100 мм</td><td class=\"n m\">+4 / −5</td></tr><tr><td>Защитный слой более 20 мм, сечение 101–200 мм</td><td class=\"n m\">+8 / −5</td></tr><tr><td>Защитный слой более 20 мм, сечение 201–300 мм</td><td class=\"n m\">+10 / −5</td></tr><tr><td>Защитный слой более 20 мм, сечение более 300 мм</td><td class=\"n m\">+15 / −5</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Арматурная сталь, изделия и закладные элементы соответствуют проекту и ТНПА. Установка в опалубку, соединения (сварные и бессварочные) — по проекту, разработанному с учётом СП 5.03.01 и ТКП EN 1992-1-1 (п. 7.3.1–7.3.5).</li><li>При вязке крестообразных соединений стержни располагают взаимно перпендикулярно. Допускаются промышленные пружинные фиксаторы и скрепки (п. 7.3.6).</li><li>Проектную толщину защитного слоя обеспечивают пластмассовыми фиксаторами. Деревянные бруски и куски бетона не допускаются. Специально изготовленные бетонные фиксаторы допускаются, если надёжно крепятся к рабочей арматуре и соответствуют технологической документации (п. 7.3.7).</li><li>Арматурные стержни и закладные детали очищают от ржавчины и загрязнений до укладки в опалубку (п. 7.3.9).</li><li>Перед бетонированием по акту скрытых работ принимают основания, установку опалубки и проёмообразователей, арматуру, закладные детали и фиксаторы, электрические коробки и пластмассовые трубки. Подсоединение трубок к опалубке герметичное, чтобы смесь не попала внутрь (п. 7.4.3).</li><li>Арматуру, опалубку и рабочие швы очищают от мусора, грязи, масла, снега и льда, цементной плёнки и ржавчины. Прямо перед укладкой промывают водой и просушивают струёй воздуха (п. 7.4.4).</li><li>Воду в смесь на месте укладки для подвижности не добавляют (п. 7.4.7).</li><li>Сварочные работы вблизи опалубки на стройплощадке допускаются при необходимости и с сохранением опалубки (п. 7.3.7).</li></ul></div><p class=\"e-note\">Допуски защитного слоя применяют при сохранении проектной толщины слоя (табл. 7.11, прим. 2). Значения «+» — в сторону увеличения слоя.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-armatura.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-armatura.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"bt-klassy\"><header><h3>Классы бетонных поверхностей</h3><p>Четыре класса монолитных поверхностей по прямолинейности: где какой нужен, допуск на 0,1 м, 1 м, 2 м, 4 м, 10 м и допустимые дефекты.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 7.10.1–7.10.14, табл. 7.11, 7.12, рис. 7.4</div></header><div class=\"q-facts\"><div><b>3 мм</b><span>допуск класса А на 1 м</span></div><div><b>5 мм</b><span>допуск класса Б на 1 м</span></div><div><b>10 мм</b><span>допуск класса В на 1 м</span></div><div><b>1 мм</b><span>наплыв или впадина под обои</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Класс А</th><th class=\"n\">Класс Б</th><th class=\"n\">Класс В</th><th class=\"n\">Класс Г</th></tr></thead><tbody><tr><td>На измеряемом расстоянии 0,1 м</td><td class=\"n m\">2</td><td class=\"n m\">3</td><td class=\"n m\">5</td><td class=\"n m\">10</td></tr><tr><td>На 1 м</td><td class=\"n m\">3</td><td class=\"n m\">5</td><td class=\"n m\">10</td><td class=\"n m\">20</td></tr><tr><td>На 2 м</td><td class=\"n m\">5</td><td class=\"n m\">7</td><td class=\"n m\">12</td><td class=\"n m\">25</td></tr><tr><td>На 4 м</td><td class=\"n m\">8</td><td class=\"n m\">10</td><td class=\"n m\">15</td><td class=\"n m\">35</td></tr><tr><td>На 10 м</td><td class=\"n m\">15</td><td class=\"n m\">20</td><td class=\"n m\">25</td><td class=\"n m\">—</td></tr><tr><td>Ширина усадочных трещин, не более</td><td class=\"n m\">0,1</td><td class=\"n m\">0,2</td><td class=\"n m\">0,2</td><td class=\"n m\">0,2</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Класс А, на 2 м</text><rect x=\"220\" y=\"6\" width=\"68.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"296.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Класс Б, на 2 м</text><rect x=\"220\" y=\"40\" width=\"95.2\" height=\"22\" fill=\"#1d1f23\"/><text x=\"323.2\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">7 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Класс В, на 2 м</text><rect x=\"220\" y=\"74\" width=\"163.2\" height=\"22\" fill=\"#1d1f23\"/><text x=\"391.2\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">12 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Класс Г, на 2 м</text><rect x=\"220\" y=\"108\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">25 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Класс А — лицевые поверхности стен, колонн и нижние поверхности перекрытий с повышенными требованиями к внешнему виду. Класс Б — те же без повышенных требований. Класс В — лицевые поверхности стен и колонн, нижние и верхние поверхности перекрытий, требующие отделки. Класс Г — минимальные требования, как правило скрытые поверхности (табл. 7.12).</li><li>Класс поверхности указывают в проекте. Для классов В и Г вид опалубки выбирает подрядчик (п. 7.10.1, 7.10.2).</li><li>Промежуточные значения допусков определяют по графику (рис. 7.4) и округляют (табл. 7.11, прим. 1). Местные выступы и впадины оценивают по допуску на 0,1 м (п. 7.10.9).</li><li>На поверхностях всех классов не допускаются участки неуплотнённого бетона. На классах А–В не допускаются жировые пятна и пятна ржавчины (п. 7.10.6, 7.10.7).</li><li>Арматура не обнажена, кроме рабочих выпусков и монтажных крепежных элементов опалубки, и кроме открытых поверхностей стальных закладных (п. 7.10.8).</li><li>Трещины не допускаются, кроме усадочных и других поверхностных технологических трещин: раскрытие не более 0,1 мм для класса А, 0,2 мм для остальных (п. 7.10.10).</li><li>Класс А: раковины и околы рёбер глубиной более 2 мм и длиной более 20 мм на 1 м ребра не допускаются. Классы Б и В: раковины диаметром более 4 и 10 мм соответственно, околы глубиной более 5 мм и длиной более 50 мм на 1 м ребра. Класс Г: раковины диаметром более 20 мм и околы глубиной более 20 мм (п. 7.10.11).</li><li>Под оклейку обоями наплывы и впадины более 1 мм не допускаются. Для классов А и Б местные выступы шлифуют, впадины шпатлюют (п. 7.10.13).</li><li>Допускаются отверстия под тяжи с защитными трубками и под анкеры, отпечатки щитов и элементов опалубки, обнажение арматурных фиксаторов в нижней зоне, оговорённое технологией, на потолке — следы палубы и крепления электроразводки (п. 7.10.12).</li></ul></div><p class=\"e-note\">Допуски прямолинейности действуют при условии сохранения проектной толщины защитного слоя (табл. 7.11, прим. 2). Для торкретированных поверхностей классы не применяют.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-klassy.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-klassy.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"bt-konstrukcii\"><header><h3>Готовые монолитные конструкции</h3><p>Допуски на вертикаль, горизонталь, размеры, проёмы, отметки опор и закладные болты после распалубки.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 7.10.14, 7.10.15, табл. 7.13</div></header><div class=\"q-facts\"><div><b>20 мм</b><span>отклонение фундаментов от вертикали на всю высоту</span></div><div><b>15 мм</b><span>стены и колонны, поддерживающие монолитные перекрытия</span></div><div><b>10 мм</b><span>стены и колонны, поддерживающие сборные балочные конструкции</span></div><div><b>5 мм</b><span>перепад в стыке двух смежных поверхностей</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Вертикаль и проектный наклон на всю высоту: фундаменты, мм</td><td class=\"n m\">20</td></tr><tr><td>То же стены и колонны под монолитные перекрытия, мм</td><td class=\"n m\">15</td></tr><tr><td>То же стены и колонны под сборные балочные конструкции, мм</td><td class=\"n m\">10</td></tr><tr><td>Скользящая опалубка без перекрытий: не более 1/500 высоты и</td><td class=\"n m\">100 мм</td></tr><tr><td>Скользящая опалубка с перекрытиями: не более 1/1000 высоты и</td><td class=\"n m\">50 мм</td></tr><tr><td>Горизонталь плоскостей на длину участка до 6 м, мм</td><td class=\"n m\">10</td></tr><tr><td>То же более 6 м, мм</td><td class=\"n m\">20</td></tr><tr><td>Длина, пролёт, размер в свету или высота до 6 м, мм</td><td class=\"n m\">±10</td></tr><tr><td>То же более 6 м, мм</td><td class=\"n m\">±20</td></tr><tr><td>Размеры оконных, дверных и других проёмов, мм</td><td class=\"n m\">20</td></tr><tr><td>Размер поперечного сечения элементов, мм</td><td class=\"n m\">+10 / −3</td></tr><tr><td>Отметки поверхностей и закладных под стальные или сборные элементы, мм</td><td class=\"n m\">−5</td></tr><tr><td>Уклон опорных поверхностей фундаментов под стальные колонны без подливки</td><td class=\"n m\">0,0007</td></tr><tr><td>Фундаментные и анкерные болты в плане внутри контура опоры, мм</td><td class=\"n m\">5</td></tr><tr><td>То же вне контура опоры, мм</td><td class=\"n m\">10</td></tr><tr><td>Фундаментные и анкерные болты по высоте, мм</td><td class=\"n m\">20</td></tr><tr><td>Перепад в стыке двух смежных поверхностей, мм</td><td class=\"n m\">5</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Требования к монолитным конструкциям лифтовых шахт, лестниц, фундаментов под технологическое оборудование и к криволинейным поверхностям задаёт проект (п. 7.10.15).</li><li>Перепады в швах сопряжений сборных и монолитных конструкций не допускаются, если проект не предусматривает иное (п. 4.12).</li><li>В ходе возведения ведут геодезическую съёмку и составляют исполнительные схемы, акты скрытых работ и промежуточной приёмки ответственных конструкций (п. 7.1.3).</li><li>За состоянием монолитных конструкций, узлов и сопряжений следят внешним осмотром в течение всего строительства, за перемещениями и деформациями — геодезическим контролем (п. 7.1.4).</li><li>Размещение материалов на монолитных перекрытиях определяет ППР с учётом их несущей способности (п. 7.1.6).</li></ul></div><p class=\"e-note\">Поверхность оценивают по классу (табл. 7.11), геометрию конструкции — по этой таблице (табл. 7.13).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-konstrukcii.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-konstrukcii.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-sbornye\"><summary><span class=\"q-sh\"><b>Сборные конструкции</b><small>Фундаментные блоки, колонны, ригели и плиты перекрытий.</small></span><span class=\"q-n\">2</span></summary><div class=\"e-sub q-chips\"><a href=\"#sb-fundament\">Блоки фундаментов и стен подвала</a><a href=\"#sb-karkas\">Колонны, ригели и плиты перекрытий</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"sb-fundament\"><header><h3>Блоки фундаментов и стен подвала</h3><p>Монтаж фундаментных блоков и стен подземной части: основание, швы, допуски.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 6.2.1–6.2.6, табл. 6.1</div></header><div class=\"q-facts\"><div><b>−15 мм</b><span>отклонение отметки песчаного выравнивающего слоя</span></div><div><b>20 мм</b><span>толщина швов между блоками</span></div><div><b>±5 мм</b><span>допуск толщины шва</span></div><div><b>±15 мм</b><span>горизонталь рядов блоков на 10 м</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Совмещение рисок блоков и стаканов с рисками разбивочных осей</td><td class=\"n m\">12</td></tr><tr><td>Совмещение рисок фундаментных блоков с осями</td><td class=\"n m\">10</td></tr><tr><td>Отметка дна стакана до выравнивающего слоя</td><td class=\"n m\">−20</td></tr><tr><td>Отметка дна стакана после выравнивающего слоя</td><td class=\"n m\">±5</td></tr><tr><td>Отклонение плоскостей блоков стен от вертикали</td><td class=\"n m\">12</td></tr><tr><td>Толщина швов между блоками</td><td class=\"n m\">20</td></tr><tr><td>Отклонение толщины шва</td><td class=\"n m\">±5</td></tr><tr><td>Отклонение рядов блоков стены от горизонтали на 10 м длины</td><td class=\"n m\">±15</td></tr><tr><td>Перепад между смежными блоками</td><td class=\"n m\">±10</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Блоки устанавливают на слой песка, выровненный до проектной отметки. Отклонение отметки песка не более минус 15 мм (п. 6.2.1).</li><li>Установка на основание, покрытое водой или снегом, не допускается (п. 6.2.2).</li><li>Блоки стен монтируют с перевязкой в смежных рядах. Минимальная перевязка равна ширине блока, если проект не задаёт иное (п. 6.2.3).</li><li>Вертикальные и горизонтальные швы заполняют раствором и расшивают с двух сторон (п. 6.2.3).</li><li>Блоки фундаментов ставят на цементно-песчаный раствор, вертикальные шпонки между торцами замоноличивают бетоном. Марку раствора и класс бетона берут из проекта (п. 6.2.4).</li><li>В местах примыкания внутренних стен к наружным горизонтальные швы армируют по проекту (п. 6.2.5).</li><li>Надземную часть возводят после подземной части, анкеровки стен, заделки швов между плитами перекрытия и обратной засыпки пазух с уплотнением (п. 4.10).</li></ul></div><p class=\"e-note\">Допуски — предельно допустимые значения при монтаже, односторонняя направленность и суммирование отклонений не допускаются.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/sb-fundament.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/sb-fundament.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"sb-karkas\"><header><h3>Колонны, ригели и плиты перекрытий</h3><p>Допуски монтажа каркаса, укладка плит на раствор, швы между плитами и замоноличивание.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 6.3.1–6.3.6, 6.4.1–6.4.11, табл. 6.2, 6.3 · СН 1.03.01-2019, п. 6.8.1–6.8.6</div></header><div class=\"q-facts\"><div><b>≤ 20 мм</b><span>слой раствора под плитой перекрытия</span></div><div><b>0,2 %</b><span>наибольшее отклонение лицевой поверхности плит от горизонтали по длине</span></div><div><b>М150</b><span>наименьшая марка раствора для замоноличивания стыков</span></div><div><b>С8/10</b><span>наименьший класс бетона для замоноличивания стыков</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Совмещение рисок осей в нижнем сечении колонн, рам, полурам</td><td class=\"n m\">8</td></tr><tr><td>Разность отметок верха колонн каждого яруса многоэтажного здания: установка по маякам</td><td class=\"n m\">10</td></tr><tr><td>То же при контактной установке (n — номер яруса)</td><td class=\"n m\">12 + 2n</td></tr><tr><td>Вертикаль плоскостей диафрагм жёсткости</td><td class=\"n m\">5</td></tr><tr><td>Совмещение осей в верхнем сечении диафрагм с осями колонн</td><td class=\"n m\">10</td></tr><tr><td>Симметричность положения диафрагм между колоннами</td><td class=\"n m\">5</td></tr><tr><td>Отклонение ширины горизонтального стыка между диафрагмами</td><td class=\"n m\">10</td></tr><tr><td>Совмещение рисок в нижнем сечении ригелей, балок, плит</td><td class=\"n m\">8</td></tr></tbody></table></div><h4 class=\"q-h4\">Допуски по длине элемента</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">до 4 м</th><th class=\"n\">4–8 м</th><th class=\"n\">8–16 м</th><th class=\"n\">16–25 м</th></tr></thead><tbody><tr><td>Вертикаль осей колонн одноэтажного здания</td><td class=\"n m\">20</td><td class=\"n m\">25</td><td class=\"n m\">30</td><td class=\"n m\">40</td></tr><tr><td>Разность отметок верха колонн или опорных площадок</td><td class=\"n m\">14</td><td class=\"n m\">16</td><td class=\"n m\">20</td><td class=\"n m\">24</td></tr><tr><td>Совмещение осей в верхнем сечении колонн многоэтажного здания</td><td class=\"n m\">12</td><td class=\"n m\">15</td><td class=\"n m\">20</td><td class=\"n m\">25</td></tr><tr><td>Симметричность опирания концов элемента в направлении пролёта</td><td class=\"n m\">5</td><td class=\"n m\">6</td><td class=\"n m\">8</td><td class=\"n m\">10</td></tr><tr><td>Перепад лицевых поверхностей смежных плит перекрытий в шве</td><td class=\"n m\">5</td><td class=\"n m\">7</td><td class=\"n m\">10</td><td class=\"n m\">—</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Плоские плиты перекрытий укладывают на слой раствора толщиной по проекту, не более 20 мм, совмещая поверхности смежных плит со стороны потолка. Укладка без раствора не допускается (п. 6.4.7).</li><li>Перепад отметок двух смежных опорных граней по ширине плиты не более 0,15 %. Отклонение лицевой поверхности плит от горизонтали или заданного уклона не более 0,2 % по длине (п. 6.4.7).</li><li>Ригели, связевые плиты, фермы и плиты покрытий укладывают насухо на опорные поверхности. Полки ригелей горизонтальны, торцы вплотную к колоннам не примыкают (п. 6.4.3, 6.4.6).</li><li>Диафрагмы жёсткости ставят на слой раствора с обжатием в горизонтальном стыке. На подкладки, петли и клинья с последующим заполнением раствором не ставят. Вплотную к колоннам и друг к другу не примыкают (п. 6.3.4, 6.3.5).</li><li>В жилых домах без отделки требования к лицевой поверхности перекрытий в границах помещений указывает проект, они не ниже категории А6 по ГОСТ 13015.0. Проект же задаёт обработку: заделку отверстий и швов, выравнивающие стяжки, шлифование, затирку (п. 6.4.8).</li><li>Стыки между плитами замоноличивают раствором не ниже М150 или бетоном не ниже С8/10 (п. 6.4.9, 6.8.3).</li><li>Если в распалубленном стыке видны усадка, щели, пустоты или неуплотнённый бетон, стык замоноличивают повторно. Ремонт и заделка дефектов не допускаются (п. 6.8.6).</li><li>Прочность бетона или раствора в стыке при распалубке по проекту, а без указания — не менее 50 % проектной прочности на сжатие (п. 6.8.5).</li><li>Вышележащий этаж монтируют после проектного закрепления нижележащего и набора бетоном замоноличенных стыков прочности по проекту (п. 6.1.3).</li></ul></div><p class=\"e-note\">Односторонняя направленность и суммирование отклонений не допускаются (табл. 6.2, прим. 2). Глубину опирания задаёт расчёт и проект (п. 6.4.2).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/sb-karkas.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/sb-karkas.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-kamen\"><summary><span class=\"q-sh\"><b>Каменные работы</b><small>Швы и армирование, допуски кладки, высота стен и опирание плит, кладка в мороз и жару.</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#kl-shvy\">Кладка: швы, перевязка, армирование</a><a href=\"#kl-dopuski\">Допуски каменной кладки</a><a href=\"#kl-vysota\">Высота стен и перегородок, опирание плит</a><a href=\"#kl-pogoda\">Кладка в мороз и в жару</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"kl-shvy\"><header><h3>Кладка: швы, перевязка, армирование</h3><p>Толщина швов, заполнение раствором, тычковые ряды, армокаменная кладка и клеевая кладка блоков.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 5.2.1–5.2.13, 5.4.1, 5.4.4</div></header><div class=\"q-facts\"><div><b>10 мм</b><span>горизонтальный шов кладки из одинарного кирпича</span></div><div><b>12 мм</b><span>горизонтальный шов кладки из утолщённого кирпича и камней</span></div><div><b>10 мм</b><span>вертикальный шов</span></div><div><b>2–3 мм</b><span>шов на клеевой смеси (блоки)</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Горизонтальный шов, одинарный кирпич, мм</td><td class=\"n m\">10</td></tr><tr><td>Горизонтальный шов, утолщённый кирпич и камни правильной формы, мм</td><td class=\"n m\">12</td></tr><tr><td>Вертикальный шов, мм</td><td class=\"n m\">10</td></tr><tr><td>Шов между блоками на клеевой смеси, мм</td><td class=\"n m\">2–3</td></tr><tr><td>Незаполненная часть шва с лицевой стороны: стены, не более, мм</td><td class=\"n m\">15</td></tr><tr><td>То же столбы, не более, мм</td><td class=\"n m\">10</td></tr><tr><td>Тычковый ряд при кирпиче толщиной 65 мм: один ряд на</td><td class=\"n m\">6 рядов</td></tr><tr><td>То же при кирпиче толщиной 88 мм: один ряд на</td><td class=\"n m\">4 ряда</td></tr><tr><td>Кирпич-половняк, не более, % объёма кладки</td><td class=\"n m\">10</td></tr><tr><td>Сетки через: обычный кирпич</td><td class=\"n m\">5 рядов</td></tr><tr><td>То же утолщённый кирпич</td><td class=\"n m\">4 ряда</td></tr><tr><td>То же керамические камни</td><td class=\"n m\">3 ряда</td></tr><tr><td>Диаметр арматуры сеток, не менее, мм</td><td class=\"n m\">3</td></tr><tr><td>Диаметр арматуры в шве: при пересечении стержней, не более, мм</td><td class=\"n m\">6</td></tr><tr><td>То же без пересечения, не более, мм</td><td class=\"n m\">8</td></tr><tr><td>Расстояние между стержнями сетки, мм</td><td class=\"n m\">30–120</td></tr><tr><td>Шов в армированной кладке: больше суммы диаметров пересекающихся стержней не менее чем на, мм</td><td class=\"n m\">4</td></tr><tr><td>То же толщина шва не более, мм</td><td class=\"n m\">16</td></tr><tr><td>Перехлёст стержней периодического профиля, не менее, мм</td><td class=\"n m\">250</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Шов горизонтальный, одинарный кирпич</text><rect x=\"220\" y=\"6\" width=\"283.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"511.3333333333333\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Шов горизонтальный, утолщённый кирпич</text><rect x=\"220\" y=\"40\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">12 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Шов вертикальный</text><rect x=\"220\" y=\"74\" width=\"283.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"511.3333333333333\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Клеевой шов, верхний предел</text><rect x=\"220\" y=\"108\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Кладку ведут с перевязкой швов по проекту. Тычковые ряды из целых кирпичей обязательны в первом и последнем рядах, на уровне горизонтальных обрезов стен и столбов, в выступающих рядах и под опорами балок, прогонов, перекрытий (п. 5.2.1–5.2.3).</li><li>Горизонтальные и вертикальные швы в стенах, перемычках, простенках и столбах заполняют раствором полностью (п. 5.2.9). Допускаемая глубина незаполненной части шва с лица указана в таблице.</li><li>Кирпичные цоколи делают из полнотелого керамического кирпича. Пустотелый керамический и силикатный кирпич для цоколя не применяют (п. 5.2.5).</li><li>Столбы, пилястры и простенки шириной в два с половиной кирпича и менее, рядовые перемычки и карнизы выкладывают из целого кирпича (п. 5.2.6).</li><li>Раствор используют до начала схватывания и периодически перемешивают. Обезвоженную смесь и разбавление водой после начала схватывания не применяют (п. 5.1.3).</li><li>Стены из мелких блоков: кладка на цементно-песчаном растворе, клеевых смесях или пастах с полным заполнением швов. Заполнение вертикальных швов пазогребневых блоков определяет проект. Однорядная перевязка, в углах и примыканиях перевязка блоков (п. 5.4.1, 5.4.3).</li><li>Под блоки в местах примыкания к цоколю, полу первого этажа и подвалу делают горизонтальную гидроизоляцию из неподверженных гниению рулонных материалов. Первый ряд рекомендуется уложить на пояс из железобетонных перемычек или керамического кирпича, свес стены относительно цоколя не более 50 мм (п. 5.4.2).</li><li>Армокаменные конструкции: сетки выступают не менее чем двумя стержнями на 2–3 мм на поверхность. Продольные стержни соединяют сваркой. Стык без сварки: гладкие стержни с крюками и перехлёстом 20 диаметров (п. 5.2.13).</li><li>Выступающие части кладки защищают от осадков сливами из раствора не ниже М100 по прочности и F50 по морозостойкости, с уклоном для стока воды, если проект не требует иного (п. 5.2.18).</li><li>Швы фасада облегчённой кирпичной стены расшиты, внутренняя отделка выполнена штукатурным покрытием, плитный утеплитель плотно примыкает к кладке, металлические связи имеют антикоррозионное покрытие (п. 5.2.14).</li></ul></div><p class=\"e-note\">Сетки, диаметры и шаг армирования по проекту, значения таблицы действуют, если проект не предусматривает иное (п. 5.2.13).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-shvy.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-shvy.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"kl-dopuski\"><header><h3>Допуски каменной кладки</h3><p>Предельные отклонения толщины, отметок, осей, вертикали, швов и неровностей кладки стен и столбов.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 5.1.12, 5.2.11, 5.2.12, табл. 5.2</div></header><div class=\"q-facts\"><div><b>±15 мм</b><span>толщина стен из кирпича и блоков</span></div><div><b>10 мм</b><span>вертикаль на этаж и смещение осей стен</span></div><div><b>15 мм</b><span>ряды кладки от горизонтали на 10 м стены</span></div><div><b>10 мм</b><span>неровности вертикальной поверхности стены</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Стены</th><th class=\"n\">Столбы</th><th class=\"n\">Фундаменты</th><th class=\"n\">Бут: стены</th><th class=\"n\">Бут: столбы</th></tr></thead><tbody><tr><td>Отклонение толщины конструкций</td><td class=\"n m\">±15</td><td class=\"n m\">±10</td><td class=\"n m\">±30</td><td class=\"n m\">±20</td><td class=\"n m\">±20</td></tr><tr><td>Отклонение отметок опорных поверхностей</td><td class=\"n m\">−10</td><td class=\"n m\">−10</td><td class=\"n m\">−25</td><td class=\"n m\">−15</td><td class=\"n m\">−15</td></tr><tr><td>Отклонение ширины простенков</td><td class=\"n m\">−15</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Отклонение ширины проёмов</td><td class=\"n m\">15</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Центр оконных проёмов на одной вертикальной оси</td><td class=\"n m\">не допускается</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Смещение осей от разбивочных осей</td><td class=\"n m\">10</td><td class=\"n m\">10</td><td class=\"n m\">20</td><td class=\"n m\">15</td><td class=\"n m\">10</td></tr><tr><td>Отклонение граней и углов от вертикали на один этаж</td><td class=\"n m\">10</td><td class=\"n m\">10</td><td class=\"n m\">—</td><td class=\"n m\">20</td><td class=\"n m\">15</td></tr><tr><td>То же на здание выше двух этажей</td><td class=\"n m\">30</td><td class=\"n m\">30</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Ширина горизонтальных швов</td><td class=\"n m\">−2 / +3</td><td class=\"n m\">−2 / +3</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Ширина вертикальных швов</td><td class=\"n m\">−2 / +2</td><td class=\"n m\">−2 / +2</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Отклонение рядов кладки от горизонтали на 10 м стены</td><td class=\"n m\">15</td><td class=\"n m\">—</td><td class=\"n m\">30</td><td class=\"n m\">20</td><td class=\"n m\">—</td></tr><tr><td>Неровности на вертикальной поверхности кладки</td><td class=\"n m\">10</td><td class=\"n m\">5</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Размеры сечения вентиляционных каналов</td><td class=\"n m\">±5</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Колонки «Стены» и «Столбы» относятся к кладке из кирпича и камней правильной формы и мелких блоков. Колонки «Бут» — к кладке из бута и бутобетона (табл. 5.2).</li><li>Вертикальность граней и углов, горизонтальность кладки каждого этажа и отметку верха проверяют инструментально. После кладки каждого этажа проверяют горизонтальность и отметки верха независимо от промежуточных проверок рядов (п. 5.2.11, 5.2.12).</li><li>Разность высот кладки на смежных захватках не более высоты этажа, для стен подземной части — не более 1,2 м (п. 5.1.8).</li><li>Перед началом кладки выносят оси и высотные отметки по проекту и устраивают горизонтальную гидроизоляцию от увлажнения со стороны фундамента, тротуаров и отмосток (п. 5.1.1).</li><li>Скрываемые элементы принимают по актам: места опирания ферм, прогонов, балок и плит, закрепление консолей и анкеровка карнизов, закладные детали и их защита, арматура, осадочные и деформационные швы, гидро- и пароизоляция (п. 5.1.11).</li><li>Номенклатура контролируемых показателей и порядок контроля — с учётом положений СП 1.03.13 (п. 5.1.20).</li></ul></div><p class=\"e-note\">Числа таблицы 5.2 — предельно допустимые отклонения при возведении каменных и армокаменных конструкций.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-dopuski.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-dopuski.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"kl-vysota\"><header><h3>Высота стен и перегородок, опирание плит</h3><p>Предельная высота свободно стоящих стен, высота перегородок, борозды, анкеры и опирание перекрытий.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 5.1.5–5.1.10, 5.1.13–5.1.17, табл. 5.1</div></header><div class=\"q-facts\"><div><b>1,5 м</b><span>наибольшая высота неармированной нераскреплённой перегородки толщиной 9 см</span></div><div><b>1,8 м</b><span>то же для перегородки толщиной 12 см</span></div><div><b>≥ 90 мм</b><span>наименьшая глубина опирания плит на кладку</span></div><div><b>10–15 мм</b><span>слой раствора под опиранием железобетонных и стальных конструкций</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(м)</span></th><th class=\"n\">до 150 Н/м² (15 м/с)</th><th class=\"n\">270 (21)</th><th class=\"n\">450 (27)</th><th class=\"n\">1000 (40)</th></tr></thead><tbody><tr><td>25 см, плотность 1000–1300 кг/м³</td><td class=\"n m\">2,3</td><td class=\"n m\">1,6</td><td class=\"n m\">1,3</td><td class=\"n m\">—</td></tr><tr><td>25 см, 1300–1600 кг/м³</td><td class=\"n m\">3</td><td class=\"n m\">2,1</td><td class=\"n m\">1,4</td><td class=\"n m\">—</td></tr><tr><td>25 см, свыше 1600 кг/м³</td><td class=\"n m\">3,8</td><td class=\"n m\">2,6</td><td class=\"n m\">1,6</td><td class=\"n m\">—</td></tr><tr><td>38 см, 1000–1300 кг/м³</td><td class=\"n m\">4,5</td><td class=\"n m\">4</td><td class=\"n m\">2,4</td><td class=\"n m\">1,3</td></tr><tr><td>38 см, 1300–1600 кг/м³</td><td class=\"n m\">4,8</td><td class=\"n m\">4,3</td><td class=\"n m\">3,1</td><td class=\"n m\">1,5</td></tr><tr><td>38 см, свыше 1600 кг/м³</td><td class=\"n m\">5,2</td><td class=\"n m\">4,7</td><td class=\"n m\">4</td><td class=\"n m\">1,7</td></tr><tr><td>51 см, 1000–1300 кг/м³</td><td class=\"n m\">6</td><td class=\"n m\">5,7</td><td class=\"n m\">4,3</td><td class=\"n m\">2</td></tr><tr><td>51 см, 1300–1600 кг/м³</td><td class=\"n m\">6,3</td><td class=\"n m\">6</td><td class=\"n m\">5,6</td><td class=\"n m\">2,5</td></tr><tr><td>51 см, свыше 1600 кг/м³</td><td class=\"n m\">6,5</td><td class=\"n m\">6,3</td><td class=\"n m\">6</td><td class=\"n m\">3,1</td></tr><tr><td>64 см, 1000–1300 кг/м³</td><td class=\"n m\">7</td><td class=\"n m\">6,6</td><td class=\"n m\">6</td><td class=\"n m\">2,7</td></tr><tr><td>64 см, 1300–1600 кг/м³</td><td class=\"n m\">7,4</td><td class=\"n m\">7</td><td class=\"n m\">6,5</td><td class=\"n m\">3,5</td></tr><tr><td>64 см, свыше 1600 кг/м³</td><td class=\"n m\">7,7</td><td class=\"n m\">7,4</td><td class=\"n m\">7</td><td class=\"n m\">4,3</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Таблица даёт наибольшую высоту свободно стоящих стен без перекрытий и покрытий при разном скоростном напоре ветра. Для промежуточных значений напора высоту находят интерполяцией. Выше этой высоты нужны временные крепления по проекту (п. 5.1.10).</li><li>Неармированные нераскреплённые каменные перегородки: толщиной 9 см — высотой не более 1,5 м, толщиной 12 см — не более 1,8 м (п. 5.1.9).</li><li>Ослаблять кладку отверстиями, бороздами, нишами и проёмами, не предусмотренными проектом, нельзя. В стенах и перегородках толщиной 120 мм и менее инженерные коммуникации не прокладывают, кроме штрабы глубиной до 1/3 толщины стены (п. 5.1.5).</li><li>Разрывы в кладке выполняют наклонной или вертикальной штрабой. При вертикальной штрабе в швы закладывают сетку из стержней диаметром не более 5 мм через 1,5 м по высоте и в уровне каждого перекрытия (п. 5.1.6, 5.1.7).</li><li>Опирание сборных железобетонных и стальных конструкций на кладку — через слой раствора 10–15 мм или на монолитные плиты толщиной, кратной кладке, не менее 140 мм, армированные двумя сетками. Глубина опирания не менее 90 мм (п. 5.1.13).</li><li>Пустотные плиты кладут усиленными торцами по стенам с большей нагрузкой. Установка плит в борозды, оставленные при кладке, не допускается. Кладку над плитами ведут сразу после их монтажа (п. 5.1.13, 5.1.14).</li><li>Опорные участки кладки армируют сетками из стержней диаметром не менее 3 мм с ячейкой не более 60 × 60 мм не менее чем в трёх верхних горизонтальных швах (п. 5.1.15).</li><li>Каменные стены и столбы крепят к перекрытиям и покрытиям анкерами сечением не менее 0,5 см² (п. 5.1.16). Самонесущие стены каркасных зданий соединяют с колоннами гибкими связями с шагом по высоте не более 1,2 м (п. 5.1.17).</li><li>Следующий этаж кладут только после укладки перекрытий нижележащего этажа, анкеровки стен и заделки швов между плитами (п. 5.1.4).</li><li>Перегородки из пустотелого кирпича выкладывают только с вертикальным направлением пустот. Зазоры между перегородками, перекрытиями и стенами берут из проекта (п. 5.1.19).</li></ul></div><p class=\"e-note\">Для промежуточных значений скоростного напора ветра высоту определяют интерполяцией (прим. к табл. 5.1).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-vysota.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-vysota.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"kl-pogoda\"><header><h3>Кладка в мороз и в жару</h3><p>Особые требования при отрицательных температурах и при высокой температуре и сухом воздухе.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 5.5.1–5.5.8, 5.6</div></header><div class=\"q-facts\"><div><b>25 °С и выше</b><span>жаркая погода для кладки при влажности наружного воздуха ниже 50 %</span></div><div><b>≥ 75 %</b><span>водоудерживающая способность раствора от установленной в лаборатории</span></div><div><b>≤ 25 см³</b><span>расслаиваемость смеси подвижностью 10–12 см</span></div><div><b>≤ 40 см³</b><span>то же при подвижности 12–14 см</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Жаркая погода: температура воздуха от, °С</td><td class=\"n m\">25</td></tr><tr><td>Жаркая погода: влажность наружного воздуха ниже, %</td><td class=\"n m\">50</td></tr><tr><td>Водоудерживающая способность раствора, не менее, % от лабораторной</td><td class=\"n m\">75</td></tr><tr><td>Проверка водоудерживающей способности, не реже раз в смену</td><td class=\"n m\">1</td></tr><tr><td>Расслаиваемость при подвижности 10–12 см, не более, см³</td><td class=\"n m\">25</td></tr><tr><td>То же при подвижности 12–14 см, не более, см³</td><td class=\"n m\">40</td></tr><tr><td>Проверка расслаиваемости при перевозке более 5 км, не реже раз в смену</td><td class=\"n m\">2</td></tr><tr><td>Раствор с противоморозными добавками не применяют при влажности воздуха эксплуатации более, %</td><td class=\"n m\">60</td></tr><tr><td>То же при эксплуатационной температуре более, °С</td><td class=\"n m\">40</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Мороз: состав растворов, подвижность и сроки её сохранения задают проект и ТНПА. На перерыв верх кладки накрывают от обледенения и снега и не оставляют на нём раствор (п. 5.5.1, 5.5.2).</li><li>Растворы с противоморозными добавками не применяют для зданий с влажностью воздуха эксплуатации более 60 %, температурой эксплуатации более 40 °С или агрессивной средой. Ёмкости с раствором укрывают и утепляют (п. 5.5.4).</li><li>Кладку способом замораживания допускают только по указаниям проекта. При оттаивании постоянно наблюдают за осадками стен и деформациями, дальнейшее возведение — после набора раствором прочности по расчёту, подтверждённой лабораторией (п. 5.5.5–5.5.7).</li><li>В журнале работ при отрицательных температурах записывают температуру воздуха, количество добавок и температуру раствора при укладке (п. 5.5.8).</li><li>Жара и сухость: кладку держат влажной в жаркое время суток, ёмкости с раствором укрывают от солнца. Керамический кирпич и изделия перед укладкой обильно смачивают (п. 5.6).</li><li>При перерывах верхний ряд раствором не прикрывают, перед возобновлением поливают водой (п. 5.6).</li></ul></div><p class=\"e-note\">Расслаиваемость проверяют непосредственно на стройплощадке, если смесь перевозили неспециализированным транспортом.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-pogoda.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-pogoda.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-derevo\"><summary><span class=\"q-sh\"><b>Деревянные конструкции</b><small>Крепёж и сборка, допуски монтажа, опирание балок и ферм, перекрытия.</small></span><span class=\"q-n\">3</span></summary><div class=\"e-sub q-chips\"><a href=\"#dr-sborka\">Сборка деревянных конструкций: крепёж</a><a href=\"#dr-dopuski\">Деревянные конструкции: допуски монтажа</a><a href=\"#dr-perekrytiya\">Деревянные перекрытия, фермы и стеновые панели</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"dr-sborka\"><header><h3>Сборка деревянных конструкций: крепёж</h3><p>Отверстия, гвозди, шурупы, болты, нагели и зубчатые пластины в соединениях.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 9.1.1–9.1.8</div></header><div class=\"q-facts\"><div><b>0,7 d</b><span>диаметр отверстия под шуруп от диаметра резьбы</span></div><div><b>4 d</b><span>наименьшая длина защемления шурупа в древесине</span></div><div><b>15 d</b><span>наименьшее расстояние от крайнего гвоздя или шурупа до торца вдоль волокон</span></div><div><b>50 см²</b><span>наименьшая площадь, перекрываемая зубчатой пластиной на каждом элементе</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Отверстие под рабочие болты и нагели: не более диаметра стержня</td><td class=\"n m\">≤ 1 d</td></tr><tr><td>Отверстие под стяжные болты и шпильки: превышение над диаметром стержня не более, мм</td><td class=\"n m\">1</td></tr><tr><td>Отверстие под шуруп: доля диаметра резьбы</td><td class=\"n m\">0,7</td></tr><tr><td>Длина защемления шурупа в древесине, не менее, диаметров</td><td class=\"n m\">4</td></tr><tr><td>Диаметр гвоздя: не более доли толщины пробиваемого элемента</td><td class=\"n m\">0,25</td></tr><tr><td>Отверстие под гвозди диаметром 6 мм и более: не более доли диаметра гвоздя</td><td class=\"n m\">0,8</td></tr><tr><td>Число гвоздей или шурупов в соединении, не менее</td><td class=\"n m\">2</td></tr><tr><td>Расстояние от крайнего гвоздя или шурупа до торца вдоль волокон, не менее, диаметров</td><td class=\"n m\">15</td></tr><tr><td>Расстояние до кромки элемента поперёк волокон, не менее, диаметров</td><td class=\"n m\">4</td></tr><tr><td>Площадь зубчатой пластины на каждом соединяемом элементе, не менее, см²</td><td class=\"n m\">50</td></tr><tr><td>Расстояние от кромки и торца элемента до крайних зубьев пластины, не менее, мм</td><td class=\"n m\">10</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Отверстия под крепёж сверлят только в предварительно закреплённом пакете, места сверления размечают по шаблону (п. 9.1.1).</li><li>Шурупы заворачивают в древесину до отказа, забивать шурупы нельзя (п. 9.1.1).</li><li>Гвозди забивают по шаблону под прямым углом к древесине (кроме Т-образных соединений). При встречной забивке гвозди не пробивают пакет насквозь. При сквозной забивке выступающие концы загибают поперёк волокон. Шляпки заподлицо с поверхностью (п. 9.1.1).</li><li>Не допускается забивать гвозди и заворачивать шурупы в увлажнённую и мёрзлую древесину, в сучки и трещины (п. 9.1.1).</li><li>Количество гвоздей и шурупов определяет проект. Ослаблять кромки стыкуемых элементов смятием и другими повреждениями нельзя (п. 9.1.1).</li><li>Металлические зубчатые пластины ставят в узлах симметрично ко всем стыкуемым элементам. Зубья вдавлены на всю глубину, пластины плотно прилегают по всей площади (п. 9.1.1).</li><li>Соединения элементов в пакетах плотные по всей площади примыкания, зазоры не допускаются (п. 9.1.2).</li><li>Стальные изделия для сборки и крепления предварительно защищают от коррозии по всей поверхности по ТНПА. Гвозди и проволока оцинкованные (п. 9.1.5).</li><li>Зимой конструкции, элементы, опоры, сопряжения и стыки тщательно очищают от снега, инея и наледи. Особенности работ в холодный период указывают в проекте и ППР (п. 9.1.3, 9.1.4).</li><li>Способы и средства крепления (хомуты, болты, нагели, гвозди) принимают по проекту с учётом СП 5.05.01. При электросварке закладных деталей работают циклами не более 1,5 мин с полным охлаждением металла (п. 9.2.10–9.2.12).</li><li>Работы ежедневно вносят в журнал монтажа по СН 1.03.04, ведут исполнительную геодезическую съёмку, составляют акты скрытых работ и промежуточной приёмки ответственных конструкций (п. 9.1.6).</li><li>В процессе монтажа до окончания возведения следят за трещинами, влажностью древесины и состоянием защитных покрытий (п. 9.1.8).</li></ul></div><p class=\"e-note\">d — диаметр. Диаметры отверстий принимают также по СП 5.05.01 (п. 9.2.11).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-sborka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-sborka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"dr-dopuski\"><header><h3>Деревянные конструкции: допуски монтажа</h3><p>Отклонения балок, ферм, колонн, врубок, болтов и гвоздей, рубленых стен и перегородок.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 9.2.6–9.2.9, табл. 9.1</div></header><div class=\"q-facts\"><div><b>±2 мм</b><span>нижние грани балок перекрытий от горизонтали на 1 м длины</span></div><div><b>±10 мм</b><span>нижние грани балок на всю длину; прямолинейность поясов ферм и балок</span></div><div><b>1 мм</b><span>наибольший зазор в стыках элементов</span></div><div><b>±3 мм</b><span>грани венцов рубленых стен от горизонтали на 1 м</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Нижние грани балок перекрытий от горизонтали на 1 м длины</td><td class=\"n m\">±2</td></tr><tr><td>Нижние грани балок перекрытий от горизонтали на всю длину</td><td class=\"n m\">±10</td></tr><tr><td>Прямолинейность поясов ферм и балок</td><td class=\"n m\">±10</td></tr><tr><td>Расстояния между осями конструкций</td><td class=\"n m\">±20</td></tr><tr><td>Вертикальность несущих конструкций, % высоты конструкции</td><td class=\"n m\">±5</td></tr><tr><td>Оси колонн, стоек, полурам, полуарок от разбивочных осей в опорном сечении</td><td class=\"n m\">±10</td></tr><tr><td>Глубина врубок от указанной в проекте</td><td class=\"n m\">±2</td></tr><tr><td>Расстояния между центрами болтов, нагелей, шпонок: входные отверстия</td><td class=\"n m\">±2</td></tr><tr><td>То же поперёк волокон: 2 % толщины пакета, но не менее</td><td class=\"n m\">5</td></tr><tr><td>То же вдоль волокон: 4 % толщины пакета, но не более</td><td class=\"n m\">10</td></tr><tr><td>Расстояния между центрами гвоздей со стороны забивки</td><td class=\"n m\">±2</td></tr><tr><td>Грани венцов рубленых стен от горизонтали на 1 м длины</td><td class=\"n m\">±3</td></tr><tr><td>Стены и перегородки от вертикали на 1 м высоты</td><td class=\"n m\">±3</td></tr><tr><td>Зазор в стыках сопрягаемых элементов, не более</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>При установке колонн, стоек, стропильных конструкций, балок перекрытий и при стыковке элементов торцы плотно примыкают друг к другу. Зазор в стыках не более 1 мм, сквозные щели не допускаются (п. 9.2.8).</li><li>Допуски и отклонения, характеризующие точность монтажа, назначаются в проекте в зависимости от заданного класса точности. Монтаж ведут с соблюдением требований таблицы 9.1 (п. 9.2.6, 9.2.7).</li><li>Конструкции защищают от увлажнения, гниения, коррозии и возгорания составами, указанными в проекте (п. 9.2.9).</li><li>Монтаж начинают с пространственно устойчивой части (связевой ячейки). Монтаж ведут по захваткам, вышележащий этаж — после проектного закрепления всех монтажных элементов нижележащего (п. 9.2.1–9.2.3).</li><li>Смонтированные конструкции изолируют при контакте с грунтом основания, кирпичной кладкой, монолитным бетоном и т. п., как предусмотрено проектом (п. 9.2.5).</li><li>Несущие конструкции монтируют в максимально укрупнённом виде. Укрупнительную сборку с затяжкой выполняют только в вертикальном положении, без затяжки — в горизонтальном (п. 9.2.4).</li></ul></div><p class=\"e-note\">Значение вертикальности «±5 % высоты» приведено так, как оно напечатано в выборке; перед применением его сверяют с официальным текстом.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-dopuski.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-dopuski.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"dr-perekrytiya\"><header><h3>Деревянные перекрытия, фермы и стеновые панели</h3><p>Опирание балок и ферм на стены, зазоры, антисептирование, подъём ферм, плиты покрытия и стеновые панели.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 9.2.13–9.2.17</div></header><div class=\"q-facts\"><div><b>≥ 200 мм</b><span>наименьшая длина опирания балок и брусьев перекрытий</span></div><div><b>≥ 30 мм</b><span>расстояние от торцов балок и ферм до каменных и бетонных стен</span></div><div><b>≥ 750 мм</b><span>длина антисептирования концов балок на каменных стенах со всех сторон</span></div><div><b>≥ 1/200</b><span>строительный подъём нижнего пояса фермы от пролёта</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Длина опирания балок и брусьев перекрытий на стены, не менее, мм</td><td class=\"n m\">200</td></tr><tr><td>Расстояние от торцов балок, брусьев и ферм до каменных и бетонных стен, не менее, мм</td><td class=\"n m\">30</td></tr><tr><td>Длина антисептирования концов балок на каменных стенах, не менее, мм</td><td class=\"n m\">750</td></tr><tr><td>Строительный подъём нижнего пояса фермы, не менее, доли пролёта</td><td class=\"n m\">1/200</td></tr><tr><td>Глубина опирания плит покрытия по тексту нормы, мм</td><td class=\"n m\">55</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Балки и брусья перекрытий укладывают по стенам с опиранием по проекту и обязательной анкеровкой. Торцы отстоят от стен не менее чем на 30 мм и отделены от них теплоизоляционными вкладышами. Глухая заделка концов не допускается (п. 9.2.17).</li><li>Концы балок и брусьев на каменных стенах обрабатывают антисептиком на длину не менее 750 мм со всех сторон и оборачивают изоляционным материалом на негниющей основе (п. 9.2.17).</li><li>Перед монтажом балок разбивают оси на опорах и обеспечивают проектное положение опор в стенах. Настил кладут по балкам и брусьям после их выверки и закрепления (п. 9.2.17).</li><li>Стропильные фермы и балки монтируют только после проектного закрепления и обеспечения устойчивости колонн или приёмки мест опирания в стенах. На опорные части наносят изоляционные покрытия (п. 9.2.14).</li><li>Первую смонтированную ферму крепят в коньке расчалками, последующие — временными распорками. Расчалки и распорки снимают после монтажа проектных элементов жёсткости (п. 9.2.14).</li><li>Фермы собирают со строительным подъёмом нижнего пояса не менее 1/200 пролёта, значение указано в проекте. Фермы и балки сразу перекрывают плитами покрытия (п. 9.2.14).</li><li>Торцы ферм и балок отстоят от каменных и бетонных стен не менее чем на 30 мм и отделены теплоизоляционными вкладышами. Глухая заделка опорных частей в стены не допускается (п. 9.2.14).</li><li>Плиты покрытия монтируют в одном потоке со стропильными конструкциями. Расстроповка только после закрепления обоих концов на опорах. Зазоры между плитами по проекту, заполняют в процессе монтажа. Утеплитель не мнут, не загрязняют и не увлажняют (п. 9.2.15).</li><li>Стеновые панели устанавливают по отметкам на каркасе, наружные поверхности панелей в одной плоскости, перепады между панелями не допускаются (п. 9.2.16).</li><li>Колонны, стойки, рамы и арки монтируют после проверки положения фундаментов и нанесения изоляции на опорные части. Положение выверяют по осям здания и нивелировочным отметкам. Ригели полурам и концы полуарок временно опирают на передвижную вышку до закрепления рамы или арки (п. 9.2.13).</li></ul></div><p class=\"e-note\">Глубина опирания плит покрытия определяется проектом; значение 55 мм приведено так, как оно напечатано в выборке нормы.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-perekrytiya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-perekrytiya.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-elektrika\"><summary><span class=\"q-sh\"><b>Электрика</b><small>Проводки, светильники, щитки, автоматы и УЗО, вводные устройства, учёт электроэнергии, заземление: сечения, прокладка, розетки, ванные, приёмка.</small></span><span class=\"q-n\">13</span></summary><div class=\"e-sub q-chips\"><a href=\"#el-gruppovye\">Групповые линии: жилы и сечения</a><a href=\"#el-prokladka\">Прокладка электропроводки</a><a href=\"#el-rozetki\">Розетки и выключатели</a><a href=\"#el-svetilniki\">Светильники</a><a href=\"#el-vannaya\">Ванные и душевые помещения</a><a href=\"#el-shchitki\">Щитки и электрощитовые</a><a href=\"#el-avtomaty\">Автоматические выключатели</a><a href=\"#el-uzo\">УЗО</a><a href=\"#el-priyemka\">Проверка электропроводки при приёмке</a><a href=\"#el-vru\">Вводные устройства: ВУ, ВРУ, ГРЩ</a><a href=\"#el-uchet\">Учёт электроэнергии</a><a href=\"#el-zazemlenie\">Заземление и уравнивание потенциалов</a><a href=\"#el-zaz-proverka\">Проверка заземляющего устройства</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"el-gruppovye\"><header><h3>Групповые линии: жилы и сечения</h3><p>Какими проводниками выполняют линии от щитка до светильников и розеток и какие сечения допустимы.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.4.4–8.4.6, 8.4.14, табл. 8.1 · СН 4.04.01-2019, п. 7.1.2, 7.1.3, 9.14, 10.8</div></header><div class=\"q-facts\"><div><b>3 жилы</b><span>L, N и PE в каждой групповой линии</span></div><div><b>1,5 мм²</b><span>наименьшее сечение меди в силовых и осветительных цепях</span></div><div><b>2,5 мм²</b><span>наименьшее сечение алюминия</span></div><div><b>≤ 3 %</b><span>потери напряжения от щита до самого дальнего светильника общего освещения</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Медь, силовые и осветительные цепи: наименьшее сечение, мм²</td><td class=\"n m\">1,5</td></tr><tr><td>Алюминий, силовые и осветительные цепи: наименьшее сечение, мм²</td><td class=\"n m\">2,5</td></tr><tr><td>Медь, цепи сигнализации и управления: наименьшее сечение, мм²</td><td class=\"n m\">0,5</td></tr><tr><td>Нулевой рабочий N при однофазных нагрузках</td><td class=\"n m\">= фазному</td></tr><tr><td>Защитный PE при фазных жилах до 16 мм²</td><td class=\"n m\">= фазному</td></tr><tr><td>PE при фазных жилах 16–35 мм², мм²</td><td class=\"n m\">16</td></tr><tr><td>PE при фазных жилах больше 35 мм²</td><td class=\"n m\">50 % фазного</td></tr><tr><td>PE вне кабеля: с механической защитой / без неё, мм²</td><td class=\"n m\">2,5 / 4</td></tr><tr><td>Потери напряжения от ГРЩ (ВРУ) до светильников общего освещения, не более, %</td><td class=\"n m\">3</td></tr><tr><td>То же до прочих электроприёмников, не более, %</td><td class=\"n m\">5</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Медь: сигнализация</text><rect x=\"220\" y=\"6\" width=\"10.6\" height=\"22\" fill=\"#1d1f23\"/><text x=\"238.625\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм²</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Медь: силовые, освещение</text><rect x=\"220\" y=\"40\" width=\"31.9\" height=\"22\" fill=\"#1d1f23\"/><text x=\"259.875\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм²</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Алюминий</text><rect x=\"220\" y=\"74\" width=\"53.1\" height=\"22\" fill=\"#1d1f23\"/><text x=\"281.125\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2,5 мм²</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Неизол. медь</text><rect x=\"220\" y=\"108\" width=\"212.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"440.5\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм²</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Неизол. алюминий</text><rect x=\"220\" y=\"142\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">16 мм²</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Линии от групповых щитков и щитков на этажах и в квартирах до светильников общего освещения, розеток и стационарных приёмников выполняют трёхпроводными: фазный L, нулевой рабочий N и нулевой защитный PE (ТКП 339-2022, п. 8.4.6; СН 4.04.01, п. 7.1.3).</li><li>Нулевые проводники разных групповых линий не объединяют. На щитке N и PE не подключают под один общий зажим (п. 8.4.6).</li><li>Групповые сети сечением до 16 мм² выполняют медными жилами. Групповые сети инженерного оборудования могут быть алюминиевыми (п. 8.4.4).</li><li>В жилых зданиях допускается до 12 проводов групповых сетей квартир в одном канале (п. 8.4.5).</li><li>Распределительные сети выполняют с возможностью замены проводов, групповые сети рекомендуется выполнять так же (п. 8.4.7).</li><li>Сечение выбирают по нагреву длительным расчётным током с учётом способа прокладки, затем проверяют по потере напряжения и по уставке аппарата защиты (СН 4.04.01, п. 10.8). Расчёт есть в калькуляторах раздела «Электрика».</li><li>Места соединения и ответвления проводов и кабелей доступны для осмотра и ремонта (СН 4.04.01, п. 11.32).</li></ul></div><p class=\"e-note\">Наименьшие сечения взяты из табл. 8.1 и п. 8.4.14 ТКП 339-2022. Для цепей электронного оборудования допускается меньшее сечение по табл. 8.1.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-gruppovye.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-gruppovye.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-prokladka\"><header><h3>Прокладка электропроводки</h3><p>Где и как вести проводку: скрыто и открыто, над потолками, через стены, на чердаке.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.4.7–8.4.10, 8.5.7, табл. 8.2 · СН 4.04.01-2019, п. 11.2–11.6, 11.13–11.16</div></header><div class=\"q-facts\"><div><b>2,5 м</b><span>наименьшая высота открытой прокладки голых проводов на изоляторах (чердак)</span></div><div><b>1 000 мм</b><span>наибольший шаг изоляторов на чердаке</span></div><div><b>50 мм</b><span>наименьшее расстояние между проводами на изоляторах</span></div><div><b>0,5 м</b><span>от выключателей, розеток и щитов до газопроводов</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Медь до 2,5 мм² (алюминий до 4 мм²)</td><td class=\"n m\">не нормируется</td></tr><tr><td>Алюминий 6 мм²</td><td class=\"n m\">2,5</td></tr><tr><td>Медь 4 мм² (алюминий 10 мм²)</td><td class=\"n m\">2,8</td></tr><tr><td>Медь 6 и 10 мм² (алюминий 16 и 25 мм²)</td><td class=\"n m\">3,2</td></tr><tr><td>Медь 16 мм² (алюминий 35 и 50 мм²)</td><td class=\"n m\">3,5</td></tr><tr><td>Медь 25 и 35 мм² (алюминий 70 мм²)</td><td class=\"n m\">4</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>В полостях над непроходными подвесными потолками и внутри пустотных перегородок проводку выполняют сменяемой. При каркасе из материалов горючести Г2–Г4 провода идут в стальных трубах со стенкой не тоньше значений таблицы. При негорючих материалах или Г1 допустимы поливинилхлоридные трубы и глухие короба или открытые кабели, не распространяющие горение, с пониженным дымо- и газовыделением (ТКП 339-2022, п. 8.4.8; СН 4.04.01, п. 11.3).</li><li>К светильникам, ответвительным и протяжным коробкам над потолками сохраняют доступ (СН 4.04.01, п. 11.3).</li><li>В ванных, санузлах, душевых и саунах, как правило, скрытая проводка. Открыто можно вести кабели, но не в металлических трубах и рукавах и не провода в металлической оболочке (п. 8.4.9; СН 4.04.01, п. 11.13).</li><li>Провода, закладываемые в стены или жёстко закрепляемые на них, идут горизонтально, вертикально или параллельно кромкам стен. В перекрытиях без крепления допускается кратчайший путь (СН 4.04.01, п. 11.14).</li><li>Проход через стены, перегородки и перекрытия выполняют в трубе, коробе или проёме так, чтобы проводку можно было заменить. Зазоры заполняют легкоудаляемым материалом (СН 4.04.01, п. 11.15). Пересечение температурных и осадочных швов: компенсирующие меры (п. 11.16).</li><li>В вентиляционных каналах и шахтах провода не прокладывают. Пересекать их можно одиночными линиями в стальных трубах (СН 4.04.01, п. 11.4).</li><li>Линии разных квартир не ведут в одном канале, трубе или коробе без сплошных металлических перегородок. Транзит групповых линий через квартиры других собственников не допускается (СН 4.04.01, п. 11.2, 11.6).</li><li>В панелях стен, перегородок и перекрытий заводского изготовления и в монтажных стыках панелей проводку без возможности замены не прокладывают (п. 8.4.7).</li><li>На чердаке: открыто в стальных трубах или в оболочке из негорючего материала. Неметаллические трубы запрещены. Голые одножильные провода на изоляторах только на высоте не менее 2,5 м. Открытая проводка на чердаке медная, алюминий допустим в стальных трубах или скрыто в несгораемых конструкциях (п. 8.4.10).</li></ul></div><p class=\"e-note\">Таблица: наименьшая толщина стенки стальных труб при прокладке над подвесными потолками и в пустотных перегородках (табл. 8.2). Способ монтажа по типу провода выбирают по ГОСТ 30331.15.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-prokladka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-prokladka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-rozetki\"><header><h3>Розетки и выключатели</h3><p>Номиналы, высота, расстояния и места, где ставить нельзя.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.5.6–8.5.9 · СН 4.04.01-2019, п. 7.1.4, 7.1.5, 7.4.3, 11.19–11.22, 11.25–11.27</div></header><div class=\"q-facts\"><div><b>10 А</b><span>наименьший ток розеток с защитным контактом</span></div><div><b>0,8–1,7 м</b><span>рекомендуемая высота выключателей от пола, со стороны дверной ручки</span></div><div><b>32 А</b><span>розетка и защита линии стационарной электроплиты</span></div><div><b>0,6 м</b><span>наименьшее расстояние от выключателей и розеток до дверного проёма душевой кабины</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Розетка с защитным контактом: ток, не менее, А</td><td class=\"n m\">10</td></tr><tr><td>Клеммные колодки светильников в жилых домах: ток, не менее, А</td><td class=\"n m\">10</td></tr><tr><td>Выключатель: рекомендуемая высота от пола, м</td><td class=\"n m\">0,8–1,7</td></tr><tr><td>Розетки в детских учреждениях: высота от пола, м</td><td class=\"n m\">1,8</td></tr><tr><td>Линия электроплиты: розетка и аппарат защиты, не менее, А</td><td class=\"n m\">32</td></tr><tr><td>До газопроводов и газовых счётчиков, не менее, м</td><td class=\"n m\">0,5</td></tr><tr><td>До дверного проёма душевой кабины, не менее, м</td><td class=\"n m\">0,6</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Там, где проложена трёхпроводная сеть, ставят розетки на ток не менее 10 А с защитным контактом (ТКП 339-2022, п. 8.5.8). В жилых домах розетки на 10 (16) А, клеммные колодки светильников не менее чем на 10 А (СН 4.04.01, п. 7.1.4).</li><li>Выключатели рекомендуется ставить на стене со стороны дверной ручки на высоте 0,8–1,7 м. Допускается под потолком с управлением шнуром (п. 8.5.9).</li><li>В квартирах и в помещениях для детей розетки с устройством, закрывающим гнёзда при вынутой вилке (СН 4.04.01, п. 11.21). В детских учреждениях розетки на высоте 1,8 м, кроме розеток на столах в кабинетах и в компьютерных классах (п. 8.5.9).</li><li>Для стационарной электроплиты отдельная групповая линия к розетке не менее чем на 32 А с аппаратом защиты не менее чем на 32 А (СН 4.04.01, п. 11.19). Розетки не ставят над и под мойками и в кухонных шкафах (п. 11.20).</li><li>В ванных комнатах квартир розетки допускаются только в зоне 3, через разделительный трансформатор или с УЗО до 30 мА (п. 8.5.6; СН 4.04.01, п. 11.26). Выключатели в ванных, душевых, саунах и кладовых не устанавливают (СН 4.04.01, п. 7.4.3).</li><li>В кладовых и гардеробных жилых и усадебных домов розетки запрещены (СН 4.04.01, п. 7.1.5).</li><li>Скрытая установка розеток и выключателей на одной оси в общих стенах разных квартир не допускается (СН 4.04.01, п. 11.22).</li><li>Розетки на разные напряжения в одном здании конструктивно отличаются. Розетки в сети аварийного освещения запрещены (СН 4.04.01, п. 11.25, 11.27).</li><li>От выключателей, розеток и щитов до газопроводов и газовых счётчиков не менее 0,5 м (п. 8.5.7; СН 4.04.01, п. 11.20).</li></ul></div><p class=\"e-note\">Высоту установки розеток в жилых помещениях просмотренные разделы норм не задают, её определяет проект.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-rozetki.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-rozetki.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-svetilniki\"><header><h3>Светильники</h3><p>Подключение, подвес, защита по зонам, потери напряжения в линиях освещения.</p><div class=\"q-src\">Источник: СН 4.04.01-2019, п. 7.1.2–7.1.4, 7.3.6, 7.3.9, 7.3.10, 7.4.3, 9.14 · ТКП 339-2022, п. 8.5.4, 8.5.5, 8.7.3</div></header><div class=\"q-facts\"><div><b>≥ 10 А</b><span>клеммные колодки для подключения светильников в жилых домах</span></div><div><b>5 × масса</b><span>нагрузка на подвес светильника, 10 мин</span></div><div><b>10 кг</b><span>масса светильника для проекта в жилых комнатах, кухнях и прихожих</span></div><div><b>≤ 3 %</b><span>потери напряжения до самого дальнего светильника общего освещения</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Нагрузка на подвес, держится 10 мин без остаточных деформаций</td><td class=\"n m\">5 × масса</td></tr><tr><td>Люстры массой 25 кг и более</td><td class=\"n m\">2 × масса + 80 кг</td></tr><tr><td>Масса светильника в проекте (жилые комнаты, кухни, прихожие), кг</td><td class=\"n m\">10</td></tr><tr><td>Клеммные колодки светильников в жилых домах, не менее, А</td><td class=\"n m\">10</td></tr><tr><td>Потери напряжения от ГРЩ (ВРУ) до светильников общего освещения, не более, %</td><td class=\"n m\">3</td></tr><tr><td>Светильники в ванной, зона 3: класс защиты</td><td class=\"n m\">II</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>В жилых комнатах, кухнях и прихожих квартир предусматривают закладные детали и клеммные колодки на 10 А. В кухнях и прихожих кроме того подвесные патроны, подключаемые к колодке, в санузлах и застеклённых лоджиях стенной патрон (СН 4.04.01, п. 7.1.3).</li><li>Приспособления для подвеса держат пятикратную массу светильника в течение 10 мин без повреждений и остаточных деформаций. Для люстр массой 25 кг и более нагрузка равна двойной массе плюс 80 кг (СН 4.04.01, п. 7.3.10).</li><li>Линии освещения трёхпроводные (L, N, PE). В двух- и трёхфазных линиях освещения не используют предохранители и однополюсные автоматы (СН 4.04.01, п. 7.1.2).</li><li>В ванных комнатах выбирают светильники по зонам по ГОСТ 30331.11. В зоне 3 класс защиты II (СН 4.04.01, п. 7.3.6; ТКП 339-2022, п. 8.5.5). Выключатели в ванных, душевых и саунах не устанавливают (СН 4.04.01, п. 7.4.3).</li><li>Подвесные светильники без зажима для PE допустимы в помещениях без повышенной опасности при изолированном крюке, но проводка при этом остаётся трёхпроводной (ТКП 339-2022, п. 8.7.3).</li><li>Светильники с люминесцентными и светодиодными лампами: коэффициент пульсации освещённости в пределах СН 2.04.03 (СН 4.04.01, п. 7.3.9).</li><li>Над рабочими местами в помещениях приготовления пищи (кроме квартир): светильники с лампами накаливания со стеклом снизу, люминесцентные с решётками, сетками или держателями ламп (ТКП 339-2022, п. 8.5.4).</li><li>Потери напряжения до самого дальнего светильника общего освещения не более 3 % номинального, до прочих приёмников не более 5 % (СН 4.04.01, п. 9.14).</li></ul></div><p class=\"e-note\">Нормы освещённости помещений даёт СН 2.04.03, в калькуляторе освещения использованы значения гигиенической нормы.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-svetilniki.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-svetilniki.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-vannaya\"><header><h3>Ванные и душевые помещения</h3><p>Степень защиты по зонам, что можно ставить и обязательное дополнительное уравнивание потенциалов.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.5.5, 8.5.6, 8.7.4, 8.7.20, 8.4.9 · СН 4.04.01-2019, п. 7.3.6, 7.4.3, 11.13, 11.26</div></header><div class=\"q-facts\"><div><b>IPX7</b><span>зона 0, внутри ванны или поддона</span></div><div><b>IPX5</b><span>зона 1</span></div><div><b>IPX4</b><span>зона 2</span></div><div><b>IPX1</b><span>зона 3</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>В ваннах общего пользования зоны 2 и 3: степень защиты, не ниже</td><td class=\"n m\">IPX5</td></tr><tr><td>Безопасное напряжение для расчёта уравнивания потенциалов, В</td><td class=\"n m\">12</td></tr><tr><td>Розетки и выключатели от проёма душевой кабины, не менее, м</td><td class=\"n m\">0,6</td></tr><tr><td>УЗО розеток в зоне 3: ток срабатывания, не более, мА</td><td class=\"n m\">30</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 228\" role=\"img\" aria-label=\"Зоны ванной комнаты\" class=\"e-svg\"><rect x=\"0\" y=\"8\" width=\"200\" height=\"44\" fill=\"#1d1f23\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"12\" y=\"28\" font-size=\"15\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Зона 0</text><text x=\"12\" y=\"45\" font-size=\"11\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">внутри ванны или поддона</text><text x=\"216\" y=\"37\" font-size=\"18\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">IPX7</text><text x=\"310\" y=\"36\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">приборы до 12 В</text><rect x=\"0\" y=\"62\" width=\"200\" height=\"44\" fill=\"#6a6d75\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"12\" y=\"82\" font-size=\"15\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Зона 1</text><text x=\"12\" y=\"99\" font-size=\"11\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">над ванной</text><text x=\"216\" y=\"91\" font-size=\"18\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">IPX5</text><text x=\"310\" y=\"90\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">только водонагреватели</text><rect x=\"0\" y=\"116\" width=\"200\" height=\"44\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"12\" y=\"136\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Зона 2</text><text x=\"12\" y=\"153\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">рядом с ванной</text><text x=\"216\" y=\"145\" font-size=\"18\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">IPX4</text><text x=\"310\" y=\"144\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">водонагреватели, светильники класса II</text><rect x=\"0\" y=\"170\" width=\"200\" height=\"44\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"12\" y=\"190\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Зона 3</text><text x=\"12\" y=\"207\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">дальше от ванны</text><text x=\"216\" y=\"199\" font-size=\"18\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">IPX1</text><text x=\"310\" y=\"198\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">розетки через трансформатор или УЗО 30 мА</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Электрооборудование выбирают из предназначенного для своей зоны по ГОСТ 30331.11 со степенью защиты по воде: зона 0 не ниже IPX7, зона 1 IPX5, зона 2 IPX4, зона 3 IPX1. В ваннах общего пользования в зонах 2 и 3 IPX5 (ТКП 339-2022, п. 8.5.5).</li><li>В зоне 0 допускаются только приборы напряжением до 12 В, источник питания вне зоны. В зоне 1 только водонагреватели. В зоне 2 водонагреватели и светильники класса защиты II (п. 8.5.5).</li><li>В зонах 0, 1 и 2 соединительные коробки, распределительные устройства и приборы управления не устанавливают (п. 8.5.5).</li><li>Розетки допускаются только в зоне 3, через разделительный трансформатор или с УЗО на ток не более 30 мА. Любые выключатели и розетки не ближе 0,6 м от дверного проёма душевой кабины (п. 8.5.6; СН 4.04.01, п. 11.26).</li><li>Проводка скрытая в негорючих неметаллических трубках или каналах конструкций. Открыто можно вести только кабели, не в металлических трубах и рукавах и не в металлической оболочке (СН 4.04.01, п. 11.13; ТКП 339-2022, п. 8.4.9).</li><li>УЗО обязательны в линиях, питающих стационарное оборудование и светильники в ванных и душевых (п. 8.7.4).</li><li>Дополнительное уравнивание потенциалов в ванных, душевых и саунах обязательно (п. 8.7.20). К нему подключают сторонние проводящие части и защитные проводники оборудования, включая розетки.</li><li>Сопротивление проводников дополнительного уравнивания между любыми двумя одновременно доступными частями не более R = U / Ia. Здесь U = 12 В, Ia — ток, обеспечивающий срабатывание защиты от сверхтока за время не более 5 с, а при дифференциальной защите — номинальный отключающий ток вводного аппарата (п. 8.7.20.4).</li><li>При металлопластовых трубах краны, смесители и полотенцесушители считают сторонними частями. Их подключают к уравниванию либо ставят токопроводящие вставки на подаче воды перед входным вентилем со стороны стояка (п. 8.7.20.1).</li><li>Для саун нужна проводка с изоляцией, рассчитанной не ниже чем на 170 °C (п. 8.4.9).</li></ul></div><p class=\"e-note\">Размеры зон 0–3 задаёт ГОСТ 30331.11, здесь схема условная.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-vannaya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-vannaya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-shchitki\"><header><h3>Щитки и электрощитовые</h3><p>Где ставят щитки и вводно-распределительные устройства, какая защита и какие расстояния.</p><div class=\"q-src\">Источник: СН 4.04.01-2019, п. 10.2, 11.18, 11.28, 13.1–13.4 · ТКП 339-2022, п. 8.3.6, 8.3.9, 8.5.3</div></header><div class=\"q-facts\"><div><b>IP31</b><span>наименьшая степень защиты ВУ, ВРУ и ГРЩ вне электрощитовой</span></div><div><b>1 м</b><span>наименьшее расстояние до щитка от труб, радиаторов, газопроводов и счётчиков</span></div><div><b>IP44</b><span>наименьшая степень защиты щитов и аппаратов на чердаке</span></div><div><b>0,5 м</b><span>до газопроводов от щитов, выключателей и розеток</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>ВУ, ВРУ, ГРЩ вне электрощитовой: степень защиты, не ниже</td><td class=\"n m\">IP31</td></tr><tr><td>От труб, радиаторов, газопроводов и газовых счётчиков до щитков, не менее, м</td><td class=\"n m\">1</td></tr><tr><td>От щитов, выключателей и розеток до газопроводов, не менее, м</td><td class=\"n m\">0,5</td></tr><tr><td>Щиты и аппараты в чердачных помещениях: степень защиты, не ниже</td><td class=\"n m\">IP44</td></tr><tr><td>Панели ВРУ и ГРЩ рядом со слаботочным оборудованием: степень защиты, не ниже</td><td class=\"n m\">IP2X</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>ВУ, ВРУ и ГРЩ размещают в отдельных запирающихся электрощитовых. Дверь электрощитовой не открывают внутрь. В электрощитовой есть аварийное освещение и естественная вентиляция (СН 4.04.01, п. 13.1).</li><li>Вне электрощитовой щиты ставят в удобных, доступных местах в металлическом шкафу или нише с запирающимися дверцами. Рукоятки аппаратов съёмные или запираются. В общественных зданиях групповые щитки допустимы с пластиковой негорючей оболочкой, встроенные в стены из материалов горючести не ниже Г2 (СН 4.04.01, п. 13.2).</li><li>До места установки щитков от труб водопровода, отопления, канализации и водостоков, приборов отопления, газопроводов и газовых счётчиков не менее 1 м (СН 4.04.01, п. 13.2).</li><li>Электрощитовые и щитки вне них не располагают под уборными, ванными, душевыми, моечными, парильными и другими помещениями с мокрыми процессами. В районах затопления ставят выше возможного уровня воды (СН 4.04.01, п. 13.3).</li><li>Через электрощитовую допускаются трубы водоснабжения и отопления без ответвлений, люков, задвижек, фланцев и вентилей. Газопроводы, канализация и водостоки запрещены (СН 4.04.01, п. 13.4).</li><li>Щитки и шкафы любого назначения не ставят в объёме незадымляемых лестничных клеток (СН 4.04.01, п. 11.28). ВУ и ВРУ нельзя размещать и в обычных лестничных клетках новых зданий (п. 13.2).</li><li>В обычных лестничных клетках реконструируемых и ремонтируемых зданий при обосновании разрешены ВУ, ВРУ, распределительные пункты и групповые щитки, выступающие из стены на высоте до 2,2 м над ступенями и площадками, если минимальная эвакуационная ширина проходов не уменьшается (СН 4.04.01, п. 13.2).</li><li>Групповой щиток, питающий квартиры, располагают на лестничной клетке, в холле или в коридоре на этаже (ТКП 339-2022, п. 8.3.6).</li><li>В квартирных щитках, расположенных вне квартир, предохранители не допускаются (СН 4.04.01, п. 10.2).</li><li>Предельная коммутационная способность автоматов выше расчётного максимального тока короткого замыкания в месте их установки (СН 4.04.01, п. 10.4).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-shchitki.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-shchitki.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-avtomaty\"><header><h3>Автоматические выключатели</h3><p>Какие автоматы применяют, как выбирают номиналы и добиваются селективности, как их проверяют при приёмке.</p><div class=\"q-src\">Источник: СН 4.04.01-2019, п. 7.1.2, 8.1.4, 10.2–10.6, 11.19 · ТКП 339-2022, п. 4.4.26.3, 4.4.26.4, 4.4.28.5</div></header><div class=\"q-facts\"><div><b>2 ступени</b><span>на столько выше номинал аппарата, ближайшего к источнику (допустима 1)</span></div><div><b>1,1</b><span>кратность верхнего значения тока срабатывания мгновенного расцепителя при проверке</span></div><div><b>1–2 %</b><span>доля групповых выключателей приёмников 1 и 2 категории, проверяемая выборочно</span></div><div><b>2×</b><span>число проверяемых выключателей при браке</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Вводные и секционные выключатели: доля проверки, %</td><td class=\"n m\">100</td></tr><tr><td>Выключатели цепей аварийного освещения, пожарной сигнализации, пожаротушения, %</td><td class=\"n m\">100</td></tr><tr><td>Прочие выключатели защиты приёмников 1 и 2 категории, не менее, %</td><td class=\"n m\">1–2</td></tr><tr><td>Мгновенный расцепитель срабатывает при токе не более, × верхнего значения</td><td class=\"n m\">1,1</td></tr><tr><td>Сопротивление изоляции выключателей на 400 А и более, не менее, МОм</td><td class=\"n m\">1</td></tr><tr><td>Номинал линии электроплиты, не менее, А</td><td class=\"n m\">32</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Для защиты распределительных и групповых линий применяют одно-, двух- и трёхполюсные автоматы с комбинированными расцепителями. Автоматы только с электромагнитным мгновенным расцепителем не применяют, кроме линий пожарной автоматики (СН 4.04.01, п. 10.2). В квартирных щитках вне квартир предохранители не допускаются.</li><li>Уставки выбирают как можно ближе к расчётному току линии, но так, чтобы аппарат не отключал при кратковременных перегрузках, например пусковых токах (п. 10.5).</li><li>Для селективности каждый аппарат, ближайший к источнику, имеет номинал на две ступени выше предыдущего, в обоснованных случаях на одну (п. 10.5).</li><li>Предельная коммутационная способность автомата выше расчётного максимального тока короткого замыкания в точке подключения (п. 10.4).</li><li>Защита надёжно отключает повреждённый участок при трёх-, двух- и однофазном коротком замыкании в конце линии. Осветительные сети и сети бытовых и переносных приёмников защищены от перегрузки (п. 10.6).</li><li>Аппараты управления одновременно отключают все фазные проводники (п. 8.1.4). В двух- и трёхфазных групповых линиях освещения однополюсные автоматы и предохранители запрещены (п. 7.1.2).</li><li>Линия стационарной электроплиты: розетка и аппарат защиты не менее чем на 32 А (п. 11.19).</li><li>Проверка при приёмке: срабатывание мгновенного расцепителя при токе не более 1,1 верхнего значения, указанного изготовителем. Проверяют все вводные и секционные выключатели и выключатели цепей аварийного освещения, пожарной сигнализации и пожаротушения, а также не менее 1 % (в части электроустановок 2 %) прочих, защищающих приёмники 1 и 2 категории. При браке проверяют удвоенное число (ТКП 339-2022, п. 4.4.26.4).</li><li>Цепь «фаза–нуль» проверяют измерением тока однофазного замыкания или измерением полного сопротивления цепи «фаза–нулевой защитный проводник» с расчётом тока. Ток должен надёжно вызывать срабатывание защиты (п. 4.4.26.3, 4.4.28.5).</li></ul></div><p class=\"e-note\">Номиналы под конкретную нагрузку подбирает калькулятор «Подбор кабеля» раздела «Электрика».</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-avtomaty.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-avtomaty.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-uzo\"><header><h3>УЗО</h3><p>Где УЗО обязательны, на какой ток их выбирают, как проверяют при приёмке.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.7.4–8.7.18, 4.4.26.7, табл. 4.4.47, 4.4.49 · СН 4.04.01-2019, п. 16.3.1–16.3.13</div></header><div class=\"q-facts\"><div><b>30 мА</b><span>ток срабатывания для розеток, ванных, стиральных, посудомоечных машин, плит, водонагревателей</span></div><div><b>300 мА</b><span>на вводе в квартиру или дом, защита от возгорания</span></div><div><b>1/3</b><span>наибольшая доля от номинального тока УЗО, которую составляет суммарная утечка</span></div><div><b>0,5–1</b><span>надёжное срабатывание в диапазоне от 0,5 до 1 номинального тока</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>УЗО на розеточных группах и мокрых помещениях: ток срабатывания, не более, мА</td><td class=\"n m\">30</td></tr><tr><td>УЗО на вводе для защиты от возгорания: ток срабатывания, не более, мА</td><td class=\"n m\">300</td></tr><tr><td>Суммарный ток утечки, не более, от номинального тока УЗО</td><td class=\"n m\">1/3</td></tr><tr><td>Утечка приёмника больше 32 А без данных, мА на 1 А тока нагрузки</td><td class=\"n m\">0,4</td></tr><tr><td>Утечка сети, мкА на 1 м фазного провода</td><td class=\"n m\">10</td></tr><tr><td>Электроплита с расчётным током больше 32 А: ток УЗО не более, мА / время не более, мс</td><td class=\"n m\">100 / 100</td></tr><tr><td>Селективность: уставка и время ближнего к источнику УЗО, не менее, ×</td><td class=\"n m\">3</td></tr><tr><td>УЗО сохраняет работоспособность при падении напряжения до 50 %, не менее, с</td><td class=\"n m\">5</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">при Iотк</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 с</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">при 2·Iотк</text><rect x=\"220\" y=\"40\" width=\"102.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"330.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,15 с</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">при 5·Iотк</text><rect x=\"220\" y=\"74\" width=\"27.2\" height=\"22\" fill=\"#1d1f23\"/><text x=\"255.2\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,04 с</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Обязательны: групповые линии розеток, стиральные и посудомоечные машины, электроплиты, электроводонагреватели, стационарное оборудование и светильники в ванных и душевых, электрообогрев поверхностей, световая реклама и архитектурное освещение, садовые домики, а также случаи, когда автомат не обеспечивает нормируемого времени отключения (ТКП 339-2022, п. 8.7.4; СН 4.04.01, п. 16.3.3, 16.3.4).</li><li>Действующая редакция: в линиях стационарного оборудования и светильников (кроме ванных) и в общих сетях освещения УЗО не обязательно (п. 8.7.11). Для приёмников, отключение которых опасно, например пожарной сигнализации, УЗО запрещено (п. 8.7.13).</li><li>Изменение № 2 к СН 4.04.01 (пост. от 17.09.2026 № 75, вступает через 60 дней после официального опубликования) вводит УЗО для светильников общего освещения (кроме аварийного), для приборов отопления и электроводонагревателей, зарядных станций электромобилей (кроме случаев, когда станция сама имеет УЗО). УЗО не может быть единственной мерой защиты от поражения током (п. 16.3.1, 16.3.3).</li><li>По Изм. № 2 ток УЗО в групповых линиях: до 30 мА при расчётном токе до 32 А; при токе свыше 32 А не более 100 мА и 100 мс; до 10 мА в помещениях с постоянным пребыванием детей и беременных женщин (п. 16.3.13).</li><li>Для защиты от поражения током УЗО ставят, как правило, в отдельных групповых линиях. К одному УЗО допускается несколько линий через отдельные автоматы (п. 8.7.11).</li><li>УЗО лучше применять совмещённым с автоматом. Без защиты от сверхтока УЗО в линии без дополнительного аппарата не допускается (п. 8.7.8).</li><li>Номинальный отключающий дифференциальный ток не менее чем втрое больше суммарного тока утечки сети и подключённых приёмников (п. 8.7.14). Фактический ток отключения по СТБ ГОСТ Р 50807 лежит в диапазоне от половины до целого номинального значения (п. 8.7.15).</li><li>В жилых зданиях УЗО не должно отключать нагрузку при исчезновении или падении напряжения. Оно сохраняет работу не менее 5 с при снижении до 50 % номинального (п. 8.7.9).</li><li>В зоне действия УЗО нулевой рабочий проводник не соединяют с заземлёнными элементами и нулевым защитным проводником (п. 8.7.6). УЗО, защищающее от возгорания, отключает фазный и нулевой проводники (п. 8.7.18).</li><li>Тип A реагирует на переменные и пульсирующие токи утечки (стиральные машины с регулятором скорости, регулируемые источники света, телевизоры, компьютеры), тип AC только на переменные (п. 8.7.10).</li><li>Приёмка: на каждый полюс серии по пять измерений. Ток отключения лежит между неотключаемым током и номинальным током отключения. Время отключения типа АС при Iотк больше 0,03 А для защиты при косвенном прикосновении не более 5 с при Iотк, 0,3 с при 2·Iотк, 0,15 с при 5·Iотк. При снятии напряжения без нагрузки УЗО не отключается, автоматического повторного включения нет (п. 4.4.26.7, табл. 4.4.47).</li></ul></div><p class=\"e-note\">На диаграмме номинальное время отключения по табл. 4.4.49: 0,5 с при Iотк, 0,15 с при 2·Iотк, 0,04 с при 5·Iотк.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-uzo.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-uzo.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-priyemka\"><header><h3>Проверка электропроводки при приёмке</h3><p>Сопротивление изоляции, цепь «фаза–нуль», выборочная проверка аппаратов защиты.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 4.4.26.1–4.4.26.4, 4.4.28.5–4.4.28.7, 4.4.29.2, табл. 4.4.46</div></header><div class=\"q-facts\"><div><b>0,5 МОм</b><span>наименьшее сопротивление изоляции силовых и осветительных сетей</span></div><div><b>1000 В</b><span>напряжение мегаомметра для силовых и осветительных сетей</span></div><div><b>500 В</b><span>мегаомметр для цепей до 60 В</span></div><div><b>2500 В</b><span>мегаомметр для силовых кабелей, изоляция не менее 0,5 МОм</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Силовые и осветительные сети: мегаомметр 1000 В, не менее, МОм</td><td class=\"n m\">0,5</td></tr><tr><td>Распределительные устройства (каждая секция), щиты, токопроводы: мегаомметр 500–1000 В, не менее, МОм</td><td class=\"n m\">0,5</td></tr><tr><td>Вторичные цепи до 60 В от отдельного источника или разделительного трансформатора: 500 В, не менее, МОм</td><td class=\"n m\">0,5</td></tr><tr><td>Вторичные цепи присоединений и питания приводов: 1000–2500 В, не менее, МОм</td><td class=\"n m\">1</td></tr><tr><td>Силовые кабели до 1 кВ: мегаомметр 2500 В, не менее, МОм</td><td class=\"n m\">0,5</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Сопротивление изоляции силовых и осветительных сетей измеряют между каждым проводом и землёй и между каждыми двумя проводами. Оно не менее значений таблицы (табл. 4.4.46, прим. 3).</li><li>При измерении изоляции вторичных цепей с подключёнными аппаратами принимают меры против повреждения микроэлектронных и полупроводниковых элементов (табл. 4.4.46, прим. 1, 2).</li><li>Цепь «фаза–нуль» силовых и осветительных сетей в сетях с системой TN проверяют: либо измеряют ток однофазного замыкания на корпус или нулевой защитный проводник специальными приборами, либо измеряют полное сопротивление цепи «фаза–нулевой защитный проводник» и вычисляют ток. Он должен надёжно вызывать срабатывание защиты (п. 4.4.26.3, 4.4.28.5).</li><li>Автоматические выключатели: проверка мгновенных расцепителей, объём выборки и удвоение при браке, подробности в карточке «Автоматические выключатели» (п. 4.4.26.4).</li><li>УЗО проверяют по СТБ ГОСТ Р 50807, подробности в карточке «УЗО» (п. 4.4.26.7).</li><li>Сопротивление заземляющих устройств и напряжение прикосновения, где оно нормируется, проверяют по п. 4.4.28.6 и 4.4.28.7. Средства измерений аттестованы или поверены (п. 4.4.26, в).</li></ul></div><p class=\"e-note\">Использована действующая редакция ТКП 339-2022. Редакция ТКП 339-2011 утратила силу.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-priyemka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-priyemka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-vru\"><header><h3>Вводные устройства: ВУ, ВРУ, ГРЩ</h3><p>Где и как размещают вводно-распределительные устройства, какая защита, расстояния и требования к электрощитовой.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.1.3, 8.2.8, 8.3.1–8.3.10 · СН 4.04.01-2019, п. 9.10–9.12, 12.1, 13.1–13.5</div></header><div class=\"q-facts\"><div><b>IP31</b><span>наименьшая степень защиты ВУ, ВРУ, ГРЩ вне электрощитовой</span></div><div><b>1 м</b><span>до труб водопровода, отопления, канализации, газопроводов и газовых счётчиков</span></div><div><b>+5 °С</b><span>наименьшая температура в помещении с ВРУ и ГРЩ</span></div><div><b>250 А</b><span>нагрузка линии от ВРУ в жилом доме, как правило, не более</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Степень защиты ВУ, ВРУ, ГРЩ вне электрощитовой, не ниже</td><td class=\"n m\">IP31</td></tr><tr><td>Расстояние от труб (вода, отопление, канализация, водостоки), приборов отопления, газопроводов и газовых счётчиков, не менее, м</td><td class=\"n m\">1</td></tr><tr><td>Температура в помещении с ВРУ и ГРЩ, не ниже, °С</td><td class=\"n m\">5</td></tr><tr><td>Огнестойкость перегородок сухого подвала с ВРУ, не менее</td><td class=\"n m\">EI45</td></tr><tr><td>Нагрузка распределительной линии от ВРУ в жилом доме, как правило, не более, А</td><td class=\"n m\">250</td></tr><tr><td>Нагрузка на вводе в квартиру, при которой нужен трёхфазный ввод, более, кВт</td><td class=\"n m\">12</td></tr><tr><td>Степень защиты панелей ВРУ и ГРЩ при слаботочных устройствах в помещении, не ниже</td><td class=\"n m\">IP2X</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>На вводе в здание ставят ГРЩ, ВУ или ВРУ. При нескольких обособленных потребителях каждому рекомендуется своё ВУ или ВРУ. Перед вводом в здание дополнительные кабельные ящики не ставят, кроме выносных щитков учёта (ТКП 339-2022, п. 8.3.1, 8.3.2).</li><li>Аппараты защиты устанавливают на вводе питающих линий и на всех отходящих линиях. На вводе нужны аппараты управления. Автоматический выключатель считают аппаратом защиты и управления (п. 8.3.3, 8.3.4; СН 4.04.01, п. 9.10).</li><li>Групповой щиток для питания квартир ставят на лестничной клетке, в холле или в коридоре на этаже (п. 8.3.6).</li><li>ВУ, ВРУ, ГРЩ размещают в запирающихся электрощитовых, доступных только персоналу. Дверь электрощитовой открывается наружу. Вход в электрощитовую во внутрь не предусматривают (п. 8.3.8, 8.3.9; СН 4.04.01, п. 13.1).</li><li>В электрощитовой делают естественную вентиляцию и электрическое освещение, по СН 4.04.01 — также аварийное освещение. Температура не ниже +5 °С (п. 8.3.10; СН 4.04.01, п. 13.1).</li><li>Допускается размещать устройства в сухом подвале, доступном персоналу, если он отделён перегородками не менее EI45. В районах возможного затопления устройства ставят выше уровня затопления (п. 8.3.8; СН 4.04.01, п. 13.3).</li><li>Вне электрощитовой: в шкафу или нише с запирающимися дверцами, степень защиты не ниже IP31, в удобном и доступном месте, на расстоянии не менее 1 м от труб, приборов отопления, газопроводов и счётчиков. Рукоятки аппаратов не выводят наружу, они съёмные или запираются (п. 8.3.8; СН 4.04.01, п. 13.2).</li><li>Не допускается размещать ВУ и ВРУ в незадымляемых лестничных клетках и в обычных лестничных клетках вновь строящихся зданий. При обосновании в реконструируемых зданиях допускаются устройства, выступающие до высоты 2,2 м от проступей и площадок, если не уменьшается эвакуационная ширина (СН 4.04.01, п. 13.2).</li><li>Электрощитовые и ВРУ не располагают под санузлами, ванными, душевыми, кухнями (кроме кухонь квартир), мойками, парильными и другими влажными помещениями (п. 8.3.9; СН 4.04.01, п. 13.3).</li><li>Через электрощитовую не рекомендуется прокладывать трубопроводы воды и отопления. Если проходят, то без ответвлений, люков, задвижек, фланцев и вентилей в пределах помещения. Газопроводы, трубопроводы с горючими жидкостями (а по СН 4.04.01 и канализация, водостоки) запрещены (п. 8.3.9; СН 4.04.01, п. 13.4).</li><li>На вводе во ВУ или ВРУ устанавливают ограничители импульсных перенапряжений. Устройства защиты от искрения рекомендуются (п. 8.1.3).</li><li>При питании однофазных потребителей от многофазной сети допускаются общие N и PE, проложенные от ВРУ. Объединять N и PE в четырёхпроводную сеть с PEN не допускается. В цепях PE и PEN нет коммутирующих элементов (п. 8.2.8).</li><li>ВУ, ВРУ и ГРЩ проверяют по режиму короткого замыкания (СН 4.04.01, п. 12.1).</li></ul></div><p class=\"e-note\">Ширину и высоту проходов у ВУ, ВРУ, ГРЩ берут из п. 6.1.6.1 ТКП 339-2022, в просмотренной выборке этот пункт не приведён.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-vru.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-vru.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-uchet\"><header><h3>Учёт электроэнергии</h3><p>Какие счётчики ставят, где размещают, что должно быть до и после счётчика, выносной щиток учёта.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.6.1–8.6.17 · СН 4.04.01-2019, п. 9.12</div></header><div class=\"q-facts\"><div><b>до 100 А</b><span>непосредственное включение счётчика, выше — через трансформаторы тока</span></div><div><b>4 тарифа</b><span>наименьшее число тарифов расчётного счётчика</span></div><div><b>1,0</b><span>наименьший класс точности расчётного счётчика</span></div><div><b>IP54</b><span>наименьшая степень защиты выносного щитка учёта</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Тарифов у многотарифного статического счётчика, не менее</td><td class=\"n m\">4</td></tr><tr><td>Класс точности расчётного счётчика, не ниже</td><td class=\"n m\">1</td></tr><tr><td>Класс точности трансформаторов тока для расчётных счётчиков, не ниже</td><td class=\"n m\">0,5 S</td></tr><tr><td>Нагрузка, до которой счётчик включают непосредственно, А</td><td class=\"n m\">100</td></tr><tr><td>Расчётных счётчиков на квартиру</td><td class=\"n m\">1</td></tr><tr><td>Дополнительный счётчик при электроотоплении и горячем водоснабжении суммарной мощностью более, кВт</td><td class=\"n m\">5</td></tr><tr><td>Объекты с расчётной мощностью до, кВт: допускается класс 1,0 без цифрового интерфейса</td><td class=\"n m\">15</td></tr><tr><td>Индукционные счётчики класса не ниже 2,0: индивидуальные дома до, кВт</td><td class=\"n m\">3,5</td></tr><tr><td>То же стройплощадки, сезонные объекты до, кВт</td><td class=\"n m\">40</td></tr><tr><td>Испытательные колодки под счётчиком с трансформаторами, не далее, м</td><td class=\"n m\">0,5</td></tr><tr><td>Степень защиты выносного щитка учёта, не ниже</td><td class=\"n m\">IP54</td></tr><tr><td>Балансных счётчиков на секцию ВРУ с квартирами</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Расчётные счётчики: статические многотарифные (не менее четырёх тарифов), класса точности не ниже 1,0, с цифровым интерфейсом. Непосредственное включение при нагрузках до 100 А, при больших нагрузках — трансформаторное, трансформаторы тока не ниже 0,5 S (п. 8.6.2).</li><li>Для объектов до 15 кВт (павильоны, киоски, малый бизнес в отдельных зданиях, дачные и гаражные кооперативы) допускаются статические счётчики класса 1,0 без цифрового интерфейса. Для индивидуальных домов с мощностью до 3,5 кВт, строительных площадок и сезонных объектов до 40 кВт допускаются индукционные счётчики класса не ниже 2,0 (п. 8.6.2).</li><li>Счётчики серийные, их типы внесены в Государственный реестр средств измерений. Для АСКУЭ нужен ещё и отраслевой перечень Министерства энергетики (п. 8.6.3).</li><li>На каждую квартиру один одно- или трёхфазный расчётный счётчик. При суммарной мощности электроотопления и горячего водоснабжения более 5 кВт ставят дополнительный счётчик (п. 8.6.4). Для двух однофазных вводов в квартиру с разными тарифами ставят отдельные счётчики (СН 4.04.01, п. 9.12).</li><li>В общественных зданиях счётчики ставят на ВРУ (ГРЩ) в точках балансового разграничения. Каждому обособленному потребителю (ателье, магазины, склады) свой расчётный счётчик (п. 8.6.5, 8.6.6).</li><li>В многоквартирных домах предусматривают раздельный учёт освещения вспомогательных помещений, лифтов и водоповысительных установок. Счётчики общедомовой нагрузки рекомендуется ставить в шкафах ВРУ или на панелях ГРЩ (п. 8.6.6, 8.6.7).</li><li>На каждой секции ВРУ, от которой питаются квартиры, ставят один балансный счётчик для сравнения с суммой показаний квартирных (п. 8.6.8).</li><li>Квартирные счётчики размещают в отдельном отсеке этажного щитка с врезным замком и окном для снятия показаний. Защитно-коммутационную аппаратуру в этом отсеке не размещают (п. 8.6.9).</li><li>Перед счётчиком прямого включения ставят коммутационный аппарат с возможностью опломбирования, снимающий напряжение со всех фаз. После счётчика ставят аппарат защиты. Если после счётчика несколько линий, снабжённых аппаратами защиты, общий аппарат не нужен, а при размещении аппаратов за пределами помещения счётчика нужен общий отключающий аппарат (п. 8.6.10, 8.6.11).</li><li>Под счётчиками с измерительными трансформаторами не далее 0,5 м ставят испытательные колодки с опломбированием (п. 8.6.12).</li><li>В одноквартирных и блокированных домах счётчик, как правило, в запираемом выносном щитке на границе земельного участка, с электроподогревом зимой при необходимости, или на опоре воздушной линии. Допускается сплит-счётчик (п. 8.6.13).</li><li>Выносной щиток: по ГОСТ IEC 61439-1, степень защиты не ниже IP54, исполнение У1 по ГОСТ 15150, со смотровым окном, антивандальный, доступ только персоналу энергоснабжающей организации. Коммутационная аппаратура до счётчика и защитная после него размещаются в этом же щитке (п. 8.6.14–8.6.16).</li><li>Дополнительные требования к щитку может задать энергоснабжающая организация в технических условиях (п. 8.6.17).</li></ul></div><p class=\"e-note\">Требования к учёту в разд. 8.6 дополняют раздел 15 основного ТКП (на него ссылается п. 8.6.1). Тип и место установки счётчика согласуют с энергоснабжающей организацией.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-uchet.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-uchet.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-zazemlenie\"><header><h3>Заземление и уравнивание потенциалов</h3><p>Система заземления, сечения защитных проводников и проводников уравнивания потенциалов, главная заземляющая шина.</p><div class=\"q-src\">Источник: СН 4.04.01-2019, п. 16.1.2–16.1.17 · ТКП 339-2022, п. 8.2.8, 8.7.1–8.7.3, 8.7.19, 8.7.20</div></header><div class=\"q-facts\"><div><b>TN-S, TN-C-S</b><span>системы заземления жилых и общественных зданий</span></div><div><b>6 мм²</b><span>наименьшее сечение главного проводника уравнивания по меди</span></div><div><b>25 мм²</b><span>сечение по меди, большее которого не требуется</span></div><div><b>12 В</b><span>безопасное напряжение для расчёта уравнивания в ванне и поддоне</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Защитный PE при фазных проводниках до 16 мм²</td><td class=\"n m\">= фазному</td></tr><tr><td>PE при фазных проводниках от 16 до 35 мм², мм²</td><td class=\"n m\">16</td></tr><tr><td>PE при фазных проводниках свыше 35 мм²</td><td class=\"n m\">50 % фазного</td></tr><tr><td>PEN или PEM, наименьшее сечение по меди, мм²</td><td class=\"n m\">10</td></tr><tr><td>PEN или PEM, наименьшее сечение по алюминию, мм²</td><td class=\"n m\">16</td></tr><tr><td>Главный проводник уравнивания: не менее половины PE питающей линии, но не менее по меди, мм²</td><td class=\"n m\">6</td></tr><tr><td>То же по алюминию, мм²</td><td class=\"n m\">16</td></tr><tr><td>То же по стали, мм²</td><td class=\"n m\">50</td></tr><tr><td>Главный проводник уравнивания: сечение больше не требуется по меди, мм²</td><td class=\"n m\">25</td></tr><tr><td>Уравнивание между двумя сторонними частями с механической защитой: медь, мм²</td><td class=\"n m\">2,5</td></tr><tr><td>То же без механической защиты: медь, мм²</td><td class=\"n m\">4</td></tr><tr><td>То же алюминий, мм²</td><td class=\"n m\">16</td></tr><tr><td>Отдельно стоящая ГЗШ в месте, доступном посторонним: оболочка не ниже</td><td class=\"n m\">IP21</td></tr><tr><td>Самостоятельное функциональное заземление: расстояние до других заземлителей, не менее, м</td><td class=\"n m\">15</td></tr><tr><td>То же сопротивление, не более, Ом</td><td class=\"n m\">4</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>В жилых и общественных зданиях применяют системы заземления TN-S или TN-C-S (СН 4.04.01, п. 16.1.2).</li><li>Открытые проводящие части светильников общего освещения и стационарных электроприёмников присоединяют к защитному проводнику. Корпуса переносных приборов класса I и настольной оргтехники подключают к PE трёхпроводной линии. К защитным проводникам присоединяют металлические каркасы перегородок, дверей, рам и подвесных потолков, используемых для прокладки кабелей (п. 16.1.3–16.1.5; ТКП 339-2022, п. 8.7.2).</li><li>Нулевой рабочий и нулевой защитный проводники под общий зажим не подключают (п. 16.1.9). PE прокладывают в общей оболочке или трубе с фазными проводниками либо рядом с ними (п. 16.1.8, 16.1.10).</li><li>Объединённые PEN и PEM применяют только в стационарных установках на участках, не защищённых УЗО. Металлические оболочки проводок и сторонние проводящие части в качестве PEN или PEM использовать нельзя (п. 16.1.11).</li><li>Подвесные светильники без зажима для PE допускаются в помещениях без повышенной опасности при изолированном крюке. Это не основание для двухпроводных проводок (ТКП 339-2022, п. 8.7.3).</li><li>Основная система уравнивания потенциалов обязательна в каждой электроустановке здания. Через ГЗШ соединяют PE и PEN питающей сети, повторное заземление на вводе, металлические трубы воды, канализации, отопления и газа (соединённые между собой на вводе), металлические части несущих конструкций и фундамента, металлические части централизованной вентиляции и кондиционирования, молниезащиту, оболочки телекоммуникационных кабелей (п. 16.1.13).</li><li>Все соединения с ГЗШ надёжные, с индивидуальным отсоединением инструментом для измерения сопротивления заземляющего устройства (п. 16.1.13).</li><li>При нескольких вводах или встроенных ТП делают ГЗШ для каждого ВУ, ВРУ и каждой ТП. ГЗШ соединяют между собой проводником сечением меньшей из соединяемых ГЗШ (п. 16.1.14). Отдельно стоящую ГЗШ ставят в доступном месте у вводного устройства (п. 16.1.15).</li><li>В ванных, душевых и саунах дополнительное уравнивание потенциалов обязательно. В прочих помещениях рекомендуется: к нему присоединяют доступные открытые проводящие части, сторонние проводящие части и защитные проводники, в том числе розеток (ТКП 339-2022, п. 8.7.19, 8.7.20; СН 4.04.01, п. 16.1.16).</li><li>Проводник доп. уравнивания между двумя открытыми частями не слабее наименьшего из присоединённых PE. Между открытой и сторонней частью — не слабее половины соответствующего PE (СН 4.04.01, п. 16.1.17).</li><li>Сопротивление проводников доп. уравнивания между доступными одновременному прикосновению частями не более R = U / Ia, где U = 12 В, Ia — ток срабатывания защиты за время не более 5 с в TN (при отсутствии данных — ток отсечки) (ТКП 339-2022, п. 8.7.20.4).</li><li>Металлопластовые трубы: краны, смесители, полотенцесушители считают сторонними частями, их подключают к доп. уравниванию. Либо ставят токопроводящие вставки на подаче воды перед входным вентилем, тогда отдельно арматуру подключать не нужно. При металлических стояках в коробе достаточно подключить проводник к трубам стояков (п. 8.7.20.1).</li><li>При изолирующих водопроводных трубах обеспечивают электрическую связь воды с основной системой уравнивания на вводе и внутри здания. В частных домах с автономной канализацией ставят токопроводящую вставку в фановой трубе и (или) подключают проводящие части накопителя стоков (п. 8.7.20.2, 8.7.20.3).</li></ul></div><p class=\"e-note\">Сечение защитных проводников при ином материале, чем у фазных, пересчитывают по проводимости (п. 16.1.7). Конструкция и сопротивление заземлителей, молниезащита задаются проектом по ТКП 339-2022 (подраздел 4.3) и СН 4.04.03, их в выборке нет.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-zazemlenie.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-zazemlenie.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-zaz-proverka\"><header><h3>Проверка заземляющего устройства</h3><p>Что проверяют при приёмке заземления: соединения, переходное сопротивление, цепь «фаза-нуль», напряжение прикосновения.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 4.4.28.1–4.4.28.7, табл. 4.4.56 · ТКП 339-2022, п. 8.7.20.4</div></header><div class=\"q-facts\"><div><b>0,05 Ом</b><span>переходное сопротивление исправного контактного соединения не превышает</span></div><div><b>60 В</b><span>допустимое напряжение прикосновения при длительности 1 с (до 1 кВ)</span></div><div><b>20 В</b><span>то же при длительности более 1 с</span></div><div><b>5 с</b><span>время срабатывания защиты для расчёта доп. уравнивания в TN</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, В</th></tr></thead><tbody><tr><td>Длительность воздействия 0,1 с</td><td class=\"n m\">340</td></tr><tr><td>Длительность воздействия 0,2 с</td><td class=\"n m\">160</td></tr><tr><td>Длительность воздействия 0,5 с</td><td class=\"n m\">105</td></tr><tr><td>Длительность воздействия 1,0 с</td><td class=\"n m\">60</td></tr><tr><td>Длительность воздействия более 1,0 с</td><td class=\"n m\">20</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">0,1 с</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">340 В</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">0,2 с</text><rect x=\"220\" y=\"40\" width=\"160.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">160 В</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">0,5 с</text><rect x=\"220\" y=\"74\" width=\"105.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"333.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">105 В</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">1,0 с</text><rect x=\"220\" y=\"108\" width=\"60.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"288.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">60 В</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Более 1,0 с</text><rect x=\"220\" y=\"142\" width=\"20.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"248.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">20 В</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Конструкцию заземляющего устройства проверяют после монтажа до засыпки грунта и присоединения естественных заземлителей и заземляемых элементов. Сечения и проводимости элементов должны соответствовать подразделу 4.3 (ТКП 339-2022, п. 4.4.28.1).</li><li>Цепи и контактные соединения между заземлителями и заземляемыми элементами, а также соединения естественных заземлителей осматривают на обрывы и другие дефекты. Надёжность сварки проверяют простукиванием молотком. Может измеряться переходное сопротивление: у исправного соединения оно не превышает 0,05 Ом (п. 4.4.28.2).</li><li>В электроустановках до 1 кВ с системой TN проверяют цепь «фаза-нуль»: измеряют ток однофазного замыкания на корпус или нулевой защитный проводник либо полное сопротивление цепи «фаза — нулевой защитный проводник» с расчётом тока. Ток должен обеспечивать надёжное срабатывание защиты (п. 4.4.28.5).</li><li>Пробивные предохранители в установках до 1 кВ должны быть исправны и соответствовать номинальному напряжению установки (п. 4.4.28.4).</li><li>Сопротивление заземляющих устройств с присоединёнными естественными заземлителями должно удовлетворять значениям, приведённым в соответствующих разделах кодекса (п. 4.4.28.6).</li><li>Напряжение прикосновения измеряют, если установка выполнена по нормам на напряжение прикосновения (табл. 4.4.56), при присоединённых естественных заземлителях, на рабочих местах и в контрольных точках, определённых расчётом при проектировании. Длительность воздействия — суммарное время действия релейной защиты и собственное время отключения выключателя (п. 4.4.28.7).</li><li>Сопротивление проводников дополнительного уравнивания потенциалов в ванных и душевых не более R = U / Ia при U = 12 В (п. 8.7.20.4).</li></ul></div><p class=\"e-note\">Таблица 4.4.56: значения для электроустановок до 1 кВ с любой нейтралью (и 1–35 кВ с изолированной нейтралью). Для 110–750 кВ нормы другие, их здесь нет.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-zaz-proverka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-zaz-proverka.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-vodokanal\"><summary><span class=\"q-sh\"><b>Водоснабжение и канализация</b><small>Монтаж ХВС и ГВС, внутренняя канализация, высоты приборов, водостоки.</small></span><span class=\"q-n\">5</span></summary><div class=\"e-sub q-chips\"><a href=\"#ov-hvs\">Монтаж холодного и горячего водоснабжения</a><a href=\"#ov-kanalizaciya\">Внутренняя канализация: сети, трапы, вентиляция стояков</a><a href=\"#ov-kanal-montazh\">Монтаж канализации и водостоков</a><a href=\"#ov-vysoty\">Высота установки санитарных приборов</a><a href=\"#ov-vodostok\">Внутренние водостоки</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"ov-hvs\"><header><h3>Монтаж холодного и горячего водоснабжения</h3><p>Уклоны, вертикаль, расстояния до стены, гильзы, температура монтажа и испытания труб ХВС и ГВС.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 4.3–4.8, 6.1.2–6.1.18</div></header><div class=\"q-facts\"><div><b>0,002</b><span>наименьший уклон труб холодной и горячей воды и отопления</span></div><div><b>2 мм</b><span>наибольшее отклонение трубы от вертикали на 1 м</span></div><div><b>≥ 30 мм</b><span>выступ гильзы над чистым полом</span></div><div><b>≥ 25 мм</b><span>расстояние между полимерными трубами горячей и холодной воды</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Отклонение трубы от вертикали, не более, мм на 1 м</td><td class=\"n m\">2</td></tr><tr><td>Уклон труб ХВС, ГВС и отопления, не менее</td><td class=\"n m\">0,002</td></tr><tr><td>Допустимое отклонение уклона, не более, % от проектного</td><td class=\"n m\">10</td></tr><tr><td>Расстояние от штукатурки до оси неизолированной трубы Dу до 32 мм, мм</td><td class=\"n m\">35–55</td></tr><tr><td>То же для труб Dу 40–50 мм, мм</td><td class=\"n m\">50–60</td></tr><tr><td>Выступ гильзы над чистым полом, не менее, мм</td><td class=\"n m\">30</td></tr><tr><td>Зазор между трубой и гильзой Dу до 32 мм, не менее, мм</td><td class=\"n m\">5</td></tr><tr><td>Зазор между трубой и гильзой больших диаметров, не менее, мм</td><td class=\"n m\">10</td></tr><tr><td>Расстояние между полимерными трубами горячей и холодной воды, не менее, мм</td><td class=\"n m\">25</td></tr><tr><td>Температура воздуха при монтаже полимерных труб, не ниже, °С</td><td class=\"n m\">5</td></tr><tr><td>Лючок для доступа в санузле, не менее, мм</td><td class=\"n m\">300 × 300</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Вертикаль трубы, на 1 м</text><rect x=\"220\" y=\"6\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Горизонталь отопительного прибора, на 1 м</text><rect x=\"220\" y=\"40\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Горизонталь санитарного прибора, на 1 м</text><rect x=\"220\" y=\"74\" width=\"147.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"375.33333333333337\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Холодную воду прокладывают ниже горячей и ниже отопления, расстояние между осями труб — 80 мм (п. 6.1.12).</li><li>Зазор между трубой и гильзой заполняют негорючим материалом. Гильзы ставят там, где труба проходит через перекрытия и стены (п. 6.1.8).</li><li>Санитарные приборы устанавливают горизонтально: отклонение не более 1,3 мм на 1 м. Отопительные приборы — не более 3 мм на 1 м (п. 6.1.6).</li><li>Системы испытывают до закрытия борозд и отделки, затем промывают (п. 6.1.17, 6.1.18).</li><li>Люки в санузлах для доступа к арматуре и ревизиям — не менее 300 × 300 мм. От креплений до фасонных частей полимерных труб — не менее 50 мм (п. 4.3–4.8).</li><li>Счётчики воды с фильтром устанавливают на высоте 900–1500 мм (п. 6.2.5).</li></ul></div><p class=\"e-note\">Числа даны по выборке из ТКП 45-1.03-85, раздел 6. Порядок работ в санузлах и перечень испытаний уточняют по полному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-hvs.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-hvs.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-kanalizaciya\"><header><h3>Внутренняя канализация: сети, трапы, вентиляция стояков</h3><p>Уклоны, скорость стоков, трапы, ревизии и вывод вентиляционной части стояка над кровлей.</p><div class=\"q-src\">Источник: СН 4.01.03-2019, п. 16.3, 16.4, 17.1, 17.2, 18.2, 18.3</div></header><div class=\"q-facts\"><div><b>≥ 0,7 м/с</b><span>наименьшая скорость движения стоков</span></div><div><b>0,03 / 0,02</b><span>уклон нерассчитываемых участков Ø до 50 мм / свыше 50 мм</span></div><div><b>≥ 25 мм</b><span>разрыв струи при присоединении к сети</span></div><div><b>0,01–0,02</b><span>уклон пола душевых и санузлов</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Скорость стоков, не менее, м/с</td><td class=\"n m\">0,7</td></tr><tr><td>Наполнение трубы при расчёте, не менее</td><td class=\"n m\">0,3</td></tr><tr><td>Уклон нерассчитываемых участков Ø до 50 мм</td><td class=\"n m\">0,03</td></tr><tr><td>Уклон нерассчитываемых участков Ø свыше 50 мм</td><td class=\"n m\">0,02</td></tr><tr><td>Наибольший уклон трубопровода (кроме ответвлений от приборов длиной до 1,5 м)</td><td class=\"n m\">0,15</td></tr><tr><td>Уклон пола душевых и санузлов</td><td class=\"n m\">0,01–0,02</td></tr><tr><td>Уклон выпусков подземных этажей, не менее</td><td class=\"n m\">0,02</td></tr><tr><td>Разрыв струи при присоединении, не менее, мм</td><td class=\"n m\">25</td></tr><tr><td>Горизонтальное расстояние от вытяжной части стояка до окон и балконов, не менее, м</td><td class=\"n m\">4</td></tr></tbody></table></div><h4 class=\"q-h4\">Вытяжная часть стояка выше кровли</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, м</th></tr></thead><tbody><tr><td>Над сборной вентиляционной шахтой</td><td class=\"n m\">0,1</td></tr><tr><td>Над плоской неэксплуатируемой кровлей</td><td class=\"n m\">0,3</td></tr><tr><td>Над скатной кровлей</td><td class=\"n m\">0,5</td></tr><tr><td>Над эксплуатируемой кровлей</td><td class=\"n m\">3</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Трапы Ø50 мм ставят в душевых на 1–2 душа, в полах санузлов гостиничных номеров, в умывальных с пятью и более умывальниками (п. 16.3).</li><li>Трапы Ø100 мм ставят в душевых на 3–4 душа, в общественных туалетах с тремя и более унитазами или писсуарами, в мусоросборных камерах, производственных помещениях (п. 16.3).</li><li>Ванны с двусторонним присоединением подключают только косой крестовиной. Приборы разных квартир к одному отводу не присоединяют. Прямые крестовины на горизонтальных сборных линиях не применяют (п. 17.1).</li><li>Не прокладывают канализацию в электрощитовых и над жилыми комнатами (кроме студий). Ревизии ставят на нижнем и верхнем этажах, а при пяти этажах и более — не реже чем через три этажа (п. 17.1).</li><li>Диаметр вытяжной части равен диаметру стояка. Её нельзя соединять с вентиляцией и дымоходами. Дефлекторы не применяют. Невентилируемые стояки допускаются только в одноэтажных усадебных домах (п. 17.2).</li></ul></div><p class=\"e-note\">Значение «V·√(h/d) ≥ K» (K = 0,5 для полимерных, 0,6 для прочих труб) в выборке читается неоднозначно, его проверяют по полному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kanalizaciya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kanalizaciya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-kanal-montazh\"><header><h3>Монтаж канализации и водостоков</h3><p>Шаг креплений, ревизии, раструбы, трапы, унитаз и уклоны отводов водостоков.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 6.1.5, 6.3 · СН 4.01.03-2019, п. 20.11</div></header><div class=\"q-facts\"><div><b>0,005</b><span>уклон отводных трубопроводов водостоков</span></div><div><b>1 м</b><span>высота ревизии водосточного стояка над полом</span></div><div><b>≤ 2 м</b><span>шаг креплений горизонтальной чугунной канализации</span></div><div><b>≥ 5 °С</b><span>температура при монтаже унитаза на клей</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Уклон подвесных отводных трубопроводов водостоков, не менее</td><td class=\"n m\">0,005</td></tr><tr><td>Высота ревизии водосточного стояка над полом, м</td><td class=\"n m\">1</td></tr><tr><td>Шаг креплений горизонтальной чугунной канализации, не более, м</td><td class=\"n m\">2</td></tr><tr><td>Шаг креплений вертикальных полимерных труб диаметром до 32 мм, не более, мм</td><td class=\"n m\">1000</td></tr><tr><td>То же для труб большего диаметра, не более, мм</td><td class=\"n m\">1500</td></tr><tr><td>Длина подводки, при которой её крепят посередине, свыше, мм</td><td class=\"n m\">1500</td></tr><tr><td>Температура при монтаже унитаза на клей, не ниже, °С</td><td class=\"n m\">5</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Раструбы труб направляют против движения стоков. Отверстия незаглушённых труб на время работ закрывают заглушками (п. 6.3).</li><li>Трапы устанавливают заподлицо с чистым полом (п. 6.3).</li><li>Унитаз закрепляют к полу шурупами или на клей. Клей применяют при температуре не ниже 5 °С (п. 6.3).</li><li>Горизонтальные отводные трубопроводы гравитационно-сифонной системы водостоков прокладывают без уклона (п. 20.11).</li><li>Вертикальные стальные трубы при высоте этажа более 3 м крепят на половине высоты этажа (п. 6.1.5).</li></ul></div><p class=\"e-note\">Карточка собрана из выборки ТКП 45-1.03-85 (разд. 6.1 и 6.3). Остальные пункты монтажа сетей смотрят в полном тексте.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kanal-montazh.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kanal-montazh.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vysoty\"><header><h3>Высота установки санитарных приборов</h3><p>Высота от чистого пола до верха прибора по назначению здания, расстояния между приборами.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, прил. В, табл. В.1, п. 6.2.2</div></header><div class=\"q-facts\"><div><b>800 мм</b><span>умывальник в жилых и общественных зданиях</span></div><div><b>850 мм</b><span>раковина и мойка</span></div><div><b>400 мм</b><span>унитаз в жилых и общественных зданиях</span></div><div><b>±10 мм</b><span>допуск положения отдельного прибора</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Жилые, общественные, производственные</th><th class=\"n\">Школы, дошкольные, лечебные</th><th class=\"n\">Дошкольные</th><th class=\"n\">Для инвалидов</th></tr></thead><tbody><tr><td>Умывальники</td><td class=\"n m\">800</td><td class=\"n m\">700</td><td class=\"n m\">400 (500)</td><td class=\"n m\">750</td></tr><tr><td>Раковины и мойки</td><td class=\"n m\">850</td><td class=\"n m\">850</td><td class=\"n m\">850</td><td class=\"n m\">800</td></tr><tr><td>Писсуары настенные</td><td class=\"n m\">650</td><td class=\"n m\">500</td><td class=\"n m\">—</td><td class=\"n m\">650</td></tr><tr><td>Питьевые фонтанчики</td><td class=\"n m\">900</td><td class=\"n m\">750</td><td class=\"n m\">—</td><td class=\"n m\">700</td></tr><tr><td>Унитаз</td><td class=\"n m\">400</td><td class=\"n m\">400 (340 для младших классов)</td><td class=\"n m\">340</td><td class=\"n m\">400</td></tr><tr><td>Напольная чаша</td><td class=\"n m\">300</td><td class=\"n m\">300</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Гигиенический душ</td><td class=\"n m\">400</td><td class=\"n m\">400</td><td class=\"n m\">400</td><td class=\"n m\">400</td></tr></tbody></table></div><h4 class=\"q-h4\">Расстояния между приборами</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Обычные</th><th class=\"n\">Для инвалидов</th></tr></thead><tbody><tr><td>Между осями умывальников, не менее</td><td class=\"n m\">650</td><td class=\"n m\">800</td></tr><tr><td>Между осями ванн и писсуаров, не менее</td><td class=\"n m\">700</td><td class=\"n m\">850</td></tr><tr><td>От оси прибора до боковой стены, не менее</td><td class=\"n m\">—</td><td class=\"n m\">400</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Допуск положения: ±10 мм для отдельных приборов, ±5 мм для однотипных приборов в ряд (прил. В).</li><li>Если умывальник и ванна работают на общий смеситель, смеситель ставят на высоте 850 мм (прим. к табл. В.1).</li><li>В общественных уборных с двумя и более писсуарами один из них устанавливают на высоте не более 400 мм (прим. к табл. В.1).</li><li>Смывные трубы к лотковым писсуарам — 1500 мм. В дошкольных учреждениях умывальники для яслей — 400 мм, для дошкольных групп — 500 мм (прим. к табл. В.1).</li><li>Душевая сетка: 2100–2250 мм; в дошкольных учреждениях 1500 мм; для инвалидов 1500–1900 мм (п. 6.2.2).</li></ul></div><p class=\"e-note\">В столбце «Дошкольные» значение в скобках и в столбце школ значение для младших классов даны так, как приведены в выборке. Сноски таблицы В.1 проверяют по официальному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vysoty.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vysoty.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vodostok\"><header><h3>Внутренние водостоки</h3><p>Допустимый расход на водосточный стояк, расчётная площадь кровли, скорость и уклоны отводов.</p><div class=\"q-src\">Источник: СН 4.01.03-2019, п. 20.2, 20.5, 20.8, 20.10, 20.11, табл. 20.1 · ТКП 45-1.03-85-2007, п. 6.3.9</div></header><div class=\"q-facts\"><div><b>80 л/с</b><span>наибольший расчётный расход на стояк Ø200 мм</span></div><div><b>+ 30 %</b><span>площади примыкающих стен добавляют к площади кровли</span></div><div><b>≥ 0,7 м/с</b><span>наименьшая скорость в гравитационно-сифонной системе</span></div><div><b>≤ 2,5 м/с</b><span>наибольшая скорость в точке выпуска</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, л/с</th></tr></thead><tbody><tr><td>Стояк Ø85 мм</td><td class=\"n m\">10</td></tr><tr><td>Стояк Ø100 мм</td><td class=\"n m\">20</td></tr><tr><td>Стояк Ø150 мм</td><td class=\"n m\">50</td></tr><tr><td>Стояк Ø200 мм</td><td class=\"n m\">80</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стояк Ø85 мм</text><rect x=\"220\" y=\"6\" width=\"42.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"270.5\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 л/с</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стояк Ø100 мм</text><rect x=\"220\" y=\"40\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">20 л/с</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стояк Ø150 мм</text><rect x=\"220\" y=\"74\" width=\"212.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"440.5\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">50 л/с</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стояк Ø200 мм</text><rect x=\"220\" y=\"108\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">80 л/с</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Воду из внутренних водостоков отводят в наружную дождевую или общесплавную канализацию. В бытовую канализацию отвод запрещён, как и присоединение санитарных приборов к водостоку (п. 20.2).</li><li>К одному стояку самотечной системы подключают воронки разных уровней, если общий расчётный расход не превышает значений таблицы 20.1 (п. 20.5).</li><li>К расчётной водосборной площади добавляют 30 % суммарной площади вертикальных стен, примыкающих к кровле и возвышающихся над ней (п. 20.8).</li><li>Гравитационно-сифонная система: скорость не менее 0,7 м/с для самоочищения, в точке выпуска не более 2,5 м/с (п. 20.10).</li><li>Подвесные отводные трубопроводы — с уклоном не менее 0,005. Горизонтальные отводы гравитационно-сифонной системы — без уклона (п. 20.11).</li><li>На водосточном стояке ревизию ставят на высоте 1 м от пола (п. 6.3.9 ТКП).</li></ul></div><p class=\"e-note\">Таблица 20.1 даёт расчётный расход дождевых вод на стояк, значения не заменяют гидравлический расчёт.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vodostok.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vodostok.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-otoplenie\"><summary><span class=\"q-sh\"><b>Отопление</b><small>Системы и температуры, скорость воды, приборы и кронштейны, монтаж и тёплый пол.</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#ov-ot-sistemy\">Системы отопления по назначению помещений</a><a href=\"#ov-ot-truby\">Трубопроводы отопления: скорость воды и температуры</a><a href=\"#ov-ot-pribory\">Отопительные приборы и арматура: установка и крепление</a><a href=\"#ov-ot-montazh\">Монтаж отопления и тёплого пола</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"ov-ot-sistemy\"><header><h3>Системы отопления по назначению помещений</h3><p>Предельная температура водяного теплоносителя и допустимые виды отопления для помещений разного назначения.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, прил. Ж, табл. Ж.1, п. 7.1.10</div></header><div class=\"q-facts\"><div><b>95 °С</b><span>жилые, общественные, детские, спортзалы, бани, торговые залы, киоски</span></div><div><b>85 °С</b><span>палаты и операционные в больницах (кроме психиатрических)</span></div><div><b>120 °С</b><span>производственные Г1, Г2, Д; лестничные клетки; тепловые пункты</span></div><div><b>150 °С</b><span>пассажирские залы вокзалов</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, °С</th></tr></thead><tbody><tr><td>Жилые, общественные, административные, бытовые</td><td class=\"n m\">95</td></tr><tr><td>Детские дошкольные учреждения, их лестничные клетки и вестибюли</td><td class=\"n m\">95</td></tr><tr><td>Палаты, операционные, лечебные помещения в больницах (кроме психиатрических и наркологических)</td><td class=\"n m\">85</td></tr><tr><td>Лечебные помещения в психиатрических и наркологических больницах</td><td class=\"n m\">95</td></tr><tr><td>Спортивные залы</td><td class=\"n m\">95</td></tr><tr><td>Бани, прачечные, душевые</td><td class=\"n m\">95</td></tr><tr><td>Общественное питание (кроме ресторанов), торговые залы</td><td class=\"n m\">95</td></tr><tr><td>Пассажирские залы вокзалов</td><td class=\"n m\">150</td></tr><tr><td>Зрительные залы и залы ресторанов</td><td class=\"n m\">95</td></tr><tr><td>Производственные А, Б и В1–В4 без горючей пыли и аэрозолей</td><td class=\"n m\">120</td></tr><tr><td>Производственные А, Б с горючей пылью и аэрозолями</td><td class=\"n m\">110</td></tr><tr><td>Производственные В2–В4 с горючей пылью и аэрозолями</td><td class=\"n m\">120</td></tr><tr><td>Производственные Г1, Г2, Д</td><td class=\"n m\">120</td></tr><tr><td>Лестничные клетки, пешеходные переходы, вестибюли</td><td class=\"n m\">120</td></tr><tr><td>Тепловые пункты</td><td class=\"n m\">120</td></tr><tr><td>Киоски и павильоны</td><td class=\"n m\">95</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Для жилых, общественных, административных и бытовых помещений допускаются водяное отопление приборами, встроенные нагревательные элементы в стенах, перекрытиях и полах, воздушное и квартирное отопление, электрическое и газовое с температурой поверхности не более 95 °С (поз. 1).</li><li>Газовое отопление в зданиях III–V степеней огнестойкости не допускается (прим. 2 к табл. Ж.1).</li><li>В детских учреждениях образования, в помещениях с постоянным пребыванием детей, приборы с прямым превращением электроэнергии в тепло не применяют. Допускаются электрообогрев бетонного пола по СП 4.04.04 и водяное отопление с электрокотлом (прим. 3).</li><li>Температура воздуха в системах воздушного отопления рассчитывается по п. 7.1.10. Её принимают не менее чем на 20 % ниже температуры самовоспламенения веществ, выделяющихся в помещении.</li><li>Для торговых залов и помещений с легковоспламеняющимися жидкостями принимают позицию 11, перечисление а) или б) (поз. 8).</li></ul></div><p class=\"e-note\">Показана предельная температура воды. Для электрических приборов она зависит от помещения: 95, 115, 130 или 150 °С по таблице Ж.1.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-sistemy.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-sistemy.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-ot-truby\"><header><h3>Трубопроводы отопления: скорость воды и температуры</h3><p>Допустимая скорость воды по уровню шума и температура поверхности встроенных нагревательных элементов.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, п. 6.2.5, 6.2.8, 6.3.4, прил. М, табл. М.1</div></header><div class=\"q-facts\"><div><b>95 °С</b><span>теплоноситель отопления жилых и общественных зданий</span></div><div><b>120 °С</b><span>теплоноситель систем теплоснабжения</span></div><div><b>1,5 м/с</b><span>наибольшая скорость при шуме более 40 дБА в общественных зданиях</span></div><div><b>29 °С</b><span>пол при постоянном пребывании людей</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(м/с)</span></th><th class=\"n\">До 5</th><th class=\"n\">10</th><th class=\"n\">15</th><th class=\"n\">20</th><th class=\"n\">30</th></tr></thead><tbody><tr><td>Эквивалентный уровень шума 25 дБ</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,1 / 0,7</td><td class=\"n m\">0,9 / 0,55</td><td class=\"n m\">0,75 / 0,50</td><td class=\"n m\">0,60 / 0,40</td></tr><tr><td>Эквивалентный уровень шума 30 дБ</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,2</td><td class=\"n m\">1,2 / 1,00</td><td class=\"n m\">1,00 / 0,80</td><td class=\"n m\">0,85 / 0,65</td></tr><tr><td>Эквивалентный уровень шума 35 дБ</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,10</td><td class=\"n m\">1,20 / 0,95</td><td class=\"n m\">1,00 / 0,80</td></tr><tr><td>Эквивалентный уровень шума 40 дБ</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,50</td><td class=\"n m\">1,50 / 1,50</td><td class=\"n m\">1,30 / 1,20</td></tr></tbody></table></div><h4 class=\"q-h4\">Температура поверхности встроенных нагревательных элементов</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, °С</th></tr></thead><tbody><tr><td>Пол: постоянное пребывание людей</td><td class=\"n m\">29</td></tr><tr><td>Пол: временное пребывание</td><td class=\"n m\">33</td></tr><tr><td>Пол в детских и лечебных помещениях: постоянное / временное пребывание</td><td class=\"n m\">26 / 31</td></tr><tr><td>Пол по оси элемента: жилые помещения и бассейны, не более</td><td class=\"n m\">37</td></tr><tr><td>Пол по оси элемента: детские помещения, не более</td><td class=\"n m\">35</td></tr><tr><td>Потолок высотой 2,5–2,8 м</td><td class=\"n m\">28</td></tr><tr><td>Потолок высотой 2,8–3,0 м</td><td class=\"n m\">30</td></tr><tr><td>Потолок высотой 3,0–3,5 м</td><td class=\"n m\">33</td></tr><tr><td>Потолок высотой 3,5–4,0 м</td><td class=\"n m\">36</td></tr><tr><td>Потолок высотой 4,0–6,0 м</td><td class=\"n m\">38</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Верхнее значение скорости — для кранов пробочных, трёхходовых и двойной регулировки, нижнее — для вентилей. В столбцах указан коэффициент местных сопротивлений узла прибора или стояка (прим. 1 к табл. М.1).</li><li>Для трубы, идущей через несколько помещений, скорость определяют по помещению с наименьшим допустимым уровнем шума и по арматуре с наибольшим сопротивлением на участке длиной 30 м в обе стороны от помещения (прим. 2).</li><li>При уровне шума выше 40 дБА скорость воды ограничена: 1,5 м/с в общественных зданиях, 2,0 м/с в административных и бытовых, 3,0 м/с в производственных (п. 6.3.4).</li><li>Температура теплоносителя: до 95 °С для отопления жилых и общественных зданий, до 120 °С для теплоснабжения (п. 6.2.8).</li><li>Полимерные трубы скрыто прокладывают в помещениях категорий А, Б и В1–В3 по условиям п. 6.3.13. Транзит труб через убежища и электротехнические помещения запрещён (п. 6.3.14).</li><li>При температуре теплоносителя выше 105 °С до горючих конструкций Г3 и Г4 оставляют не менее 100 мм (п. 6.3.18).</li></ul></div><p class=\"e-note\">Температуры поверхности взяты из п. 6.2.5. Значение «наружные стены до 1,0 м — 95 °С» в выборке читается неоднозначно, его проверяют по полному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-truby.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-truby.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-ot-pribory\"><header><h3>Отопительные приборы и арматура: установка и крепление</h3><p>Расстояния от радиаторов и конвекторов до пола, подоконника и стены, число кронштейнов, арматура и контроль.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 6.4.3–6.4.15, табл. 2</div></header><div class=\"q-facts\"><div><b>≥ 60 мм</b><span>расстояние от радиатора до пола</span></div><div><b>≥ 50 мм</b><span>расстояние от радиатора до подоконника</span></div><div><b>≥ 25 мм</b><span>расстояние от радиатора до стены</span></div><div><b>≥ 100 мм</b><span>заглубление дюбеля в основание</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Радиатор: от пола, не менее, мм</td><td class=\"n m\">60</td></tr><tr><td>Радиатор: от подоконника, не менее, мм</td><td class=\"n m\">50</td></tr><tr><td>Радиатор: от стены, не менее, мм</td><td class=\"n m\">25</td></tr><tr><td>Гладкие и ребристые трубы: от пола и подоконника, не менее, мм</td><td class=\"n m\">200</td></tr><tr><td>Гладкие и ребристые трубы: от стены, мм</td><td class=\"n m\">25</td></tr><tr><td>Гладкие и ребристые трубы: между осями, не менее, мм</td><td class=\"n m\">200</td></tr><tr><td>Стояк от края окна, мм</td><td class=\"n m\">150 ± 50</td></tr><tr><td>Заглубление дюбеля в основание, не менее, мм</td><td class=\"n m\">100</td></tr><tr><td>Кронштейнов на 1 м² нагревательной поверхности радиатора</td><td class=\"n m\">1</td></tr><tr><td>Кронштейнов на один радиатор, не менее</td><td class=\"n m\">3</td></tr></tbody></table></div><h4 class=\"q-h4\">Число кронштейнов на секционный радиатор (табл. 2)</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Одиночных</th><th class=\"n\">или двойных</th></tr></thead><tbody><tr><td>2 секции</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>3–7 секций</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>8–16 секций</td><td class=\"n m\">4</td><td class=\"n m\">3</td></tr><tr><td>17–19 секций</td><td class=\"n m\">5</td><td class=\"n m\">3</td></tr><tr><td>20–28 секций</td><td class=\"n m\">8</td><td class=\"n m\">4</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Подставки: два при установке до 10 секций, три при большем числе секций. Конвекторы крепят в двух или трёх точках (п. 6.4.9, 6.4.10).</li><li>Конвекторы ставят на расстоянии не менее 20 мм до стены. Кожух отступает от стены до 3 мм (п. 6.4.4).</li><li>На гладких и ребристых трубах не допускается отклонение более 5 мм в меньшую сторону от проектного расстояния (п. 6.4.6).</li><li>Манометры устанавливают через трёхходовой кран при температуре воды до 105 °С (п. 6.4.14).</li></ul></div><p class=\"e-note\">В таблице 2 одиночные кронштейны и двойной кронштейн взаимозаменяемы: указано число тех или других на радиатор. Значения прочитаны по выборке, их проверяют по официальному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-pribory.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-pribory.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-ot-montazh\"><header><h3>Монтаж отопления и тёплого пола</h3><p>Уклоны подводок, опрессовка, пуск тёплого пола, пробное давление радиаторов.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 6.4.1, 6.4.8, 6.4.17–6.4.19</div></header><div class=\"q-facts\"><div><b>0,002</b><span>наименьший уклон труб отопления</span></div><div><b>0,3 МПа</b><span>давление в трубах тёплого пола при замоноличивании</span></div><div><b>≥ 20 сут</b><span>срок до пуска тёплого пола после замоноличивания</span></div><div><b>3 сут</b><span>выдержка при начальной температуре</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Подводка длиной до 500 мм: уклон</td><td class=\"n m\">не требуется</td></tr><tr><td>Подводка длиной 500–600 мм: перепад на длину, мм</td><td class=\"n m\">5</td></tr><tr><td>Подводка длиной более 600 мм: перепад на длину, мм</td><td class=\"n m\">10</td></tr><tr><td>Наименьший уклон труб отопления</td><td class=\"n m\">0,002</td></tr><tr><td>Давление в трубах тёплого пола при замоноличивании, МПа</td><td class=\"n m\">0,3</td></tr><tr><td>Срок до пуска тёплого пола после замоноличивания, не менее, сут</td><td class=\"n m\">20</td></tr><tr><td>Начальная температура воды при пуске тёплого пола, °С</td><td class=\"n m\">25</td></tr><tr><td>Подъём температуры воды, °С в сутки</td><td class=\"n m\">5</td></tr><tr><td>Выдержка при начальной температуре, сут</td><td class=\"n m\">3</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Тёплый пол пускают не ранее чем через 20 суток после замоноличивания: сначала подают воду 25 °С и выдерживают 3 суток, затем повышают температуру на 5 °С в сутки (п. 6.4.17).</li><li>Радиаторы перед установкой испытывают пробным давлением 1,5 МПа гидравлически или 0,1 МПа пузырьковым способом (п. 5.2 ТКП).</li><li>Подводки длиной до 500 мм ставят без уклона, при 500–600 мм перепад 5 мм, при большей длине 10 мм (п. 6.4.1).</li></ul></div><p class=\"e-note\">Пункты 6.4.17 и 6.4.19 (уклоны 0,002 и 0,006) прочитаны по выборке; к какой трубе относится каждое значение, проверяют по полному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-montazh.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-montazh.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-ventilyaciya\"><summary><span class=\"q-sh\"><b>Вентиляция</b><small>Воздухообмен, оборудование и венткамеры, воздуховоды, монтаж.</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#ov-vent-vozdukh\">Воздухообмен и расход наружного воздуха</a><a href=\"#ov-vent-sistemy\">Системы вентиляции: оборудование и помещения для него</a><a href=\"#ov-vent-vozdukhovody\">Воздуховоды: материалы, герметичность, противопожарные клапаны</a><a href=\"#ov-vent-montazh\">Монтаж вентиляции и кондиционирования</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"ov-vent-vozdukh\"><header><h3>Воздухообмен и расход наружного воздуха</h3><p>Минимальный расход наружного воздуха по назначению помещений, избыточное давление в тамбурах-шлюзах, места удаления воздуха.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, п. 7.4.2, 7.4.3, 7.5.3, 7.5.10, 7.5.11, прил. П, табл. П.1</div></header><div class=\"q-facts\"><div><b>3 м³/ч</b><span>наружный воздух на 1 м² жилых помещений</span></div><div><b>30 / 20 м³/ч</b><span>на человека в производственных помещениях с проветриванием</span></div><div><b>60 м³/ч</b><span>на человека без проветривания</span></div><div><b>20 Па</b><span>избыточное давление в тамбуре-шлюзе</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Жилые помещения: на 1 м² жилых помещений, м³/ч</td><td class=\"n m\">3</td></tr><tr><td>Жилые помещения без людей: общий обмен, не менее, раз в час</td><td class=\"n m\">0,5</td></tr><tr><td>Производственные с проветриванием: объём на человека менее 20 м³, м³/ч на человека</td><td class=\"n m\">30</td></tr><tr><td>То же при объёме 20 м³ на человека и более, м³/ч на человека</td><td class=\"n m\">20</td></tr><tr><td>Производственные без проветривания, м³/ч на человека</td><td class=\"n m\">60</td></tr><tr><td>Общественные, административные, бытовые без проветривания, м³/ч на человека</td><td class=\"n m\">60</td></tr><tr><td>Залы, где люди находятся до 3 ч непрерывно, м³/ч на человека</td><td class=\"n m\">20</td></tr><tr><td>Подача воздуха в тамбур-шлюз, не менее, м³/ч</td><td class=\"n m\">250</td></tr><tr><td>Избыточное давление в тамбуре-шлюзе при закрытых дверях, Па</td><td class=\"n m\">20</td></tr><tr><td>Разность давления тамбура-шлюза и помещения, не более, Па</td><td class=\"n m\">50</td></tr><tr><td>Дисбаланс без тамбура-шлюза: избыточное давление, не менее, Па</td><td class=\"n m\">10</td></tr><tr><td>То же, не менее на каждую дверь, м³/ч</td><td class=\"n m\">100</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Расход наружного воздуха определяют по воздуху, удаляемому вытяжкой и технологическим оборудованием, с учётом нормируемого дисбаланса, но не меньше значений прил. П (п. 7.4.2).</li><li>Вытяжные отверстия для удаления тепла, влаги и вредных газов из верхней зоны размещают под потолком, но не ниже 2 м от пола до низа отверстий (п. 7.5.10 а).</li><li>Из нижней зоны воздух удаляют на уровне до 0,3 м от пола до низа отверстий (п. 7.5.11).</li><li>Для кондиционируемых помещений без вредных и взрывоопасных выделений предусматривают положительный дисбаланс (п. 7.5.3).</li><li>Рециркуляция ограничивается пределами одной квартиры, номера гостиницы или дома одной семьи (п. 7.4.7). Не допускается из помещений категорий А и Б, из тамбуров-шлюзов и из систем местных отсосов вредных веществ (п. 7.4.6).</li><li>Производственные помещения, приточные системы с рециркуляцией при кратности менее 10 обменов в час: наружный воздух не менее 20 % общего воздухообмена при 60 м³/ч на человека, 15 % при 90 м³/ч, 10 % при 120 м³/ч (табл. П.1).</li><li>Для общественных, административных и бытовых зданий расход определяют по требованиям соответствующих технических нормативных правовых актов (табл. П.1).</li></ul></div><p class=\"e-note\">Строки таблицы П.1 про рециркуляцию в выборке читаются неоднозначно, порядок значений проверяют по официальному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-vozdukh.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-vozdukh.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vent-sistemy\"><header><h3>Системы вентиляции: оборудование и помещения для него</h3><p>Резервирование установок, объединение систем, высота и проходы в венткамерах, воздухообмен в них.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, п. 7.2.5, 7.2.13, 7.3.4, 7.8.2, 7.8.5, 7.8.8, 7.10.7–7.10.11</div></header><div class=\"q-facts\"><div><b>50 %</b><span>расход каждой из двух установок от требуемого воздухообмена</span></div><div><b>200 м²</b><span>наибольшая площадь присоединяемой группы помещений</span></div><div><b>≥ 1,8 м</b><span>высота венткамеры до низа выступающих конструкций</span></div><div><b>≥ 0,7 м</b><span>ширина прохода между оборудованием и конструкциями</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Расход каждой из двух приточных и двух вытяжных установок, не менее, % требуемого воздухообмена</td><td class=\"n m\">50</td></tr><tr><td>Площадь присоединяемой к системе группы помещений другого назначения, не более, м²</td><td class=\"n m\">200</td></tr><tr><td>Расстояние между приёмными устройствами наружного воздуха смежных пожарных отсеков, не менее, м</td><td class=\"n m\">3</td></tr><tr><td>Скорость воды в трубках воздухонагревателя без смесительных насосов, не менее, м/с</td><td class=\"n m\">0,12</td></tr><tr><td>Превышение теплового потока воздухонагревателя над расчётным, не более, %</td><td class=\"n m\">10</td></tr><tr><td>Конденсатоотводчики ниже патрубков воздухонагревателя, не менее, мм</td><td class=\"n m\">300</td></tr><tr><td>Высота венткамеры больше высоты оборудования, как правило, на, м</td><td class=\"n m\">0,8</td></tr><tr><td>Высота венткамеры до низа выступающих конструкций, не менее, м</td><td class=\"n m\">1,8</td></tr><tr><td>Проход между оборудованием и конструкциями, не менее, м</td><td class=\"n m\">0,7</td></tr><tr><td>То же с необслуживаемой стороны, не менее, м</td><td class=\"n m\">0,5</td></tr><tr><td>Воздухообмен в венткамере вытяжных систем, не менее, раз в час</td><td class=\"n m\">1</td></tr><tr><td>Воздухообмен в венткамере приточных систем, не менее, раз в час</td><td class=\"n m\">2</td></tr><tr><td>Грузоподъёмные машины для оборудования массой единицы более, кг</td><td class=\"n m\">50</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Системы кондиционирования и общеобменной вентиляции для помещений с постоянным пребыванием людей без естественного проветривания выполняют с резервными вентиляторами или двигателями либо двумя приточными и двумя вытяжными установками (п. 7.2.5).</li><li>Системы вентиляции жилых помещений выполняют отдельными от систем других групп помещений (п. 7.2.12).</li><li>Системы воздушного отопления без других систем отопления предусматривают с резервом: вентиляторы, насосы воздухонагревателей или не менее двух агрегатов на помещение (п. 7.2.4).</li><li>Через венткамеру не прокладывают трубы с легковоспламеняющимися и горючими жидкостями и газами. Канализационные трубы через камеры приточных систем не прокладывают, кроме ливневых и труб сбора воды из вышележащих венткамер (п. 7.10.10).</li><li>Защитные ограждения ставят на всасывающих и нагнетательных отверстиях вентиляторов, не присоединённых к воздуховодам. На вытяжке в помещениях с газовыми приборами ставят решётки, которые нельзя закрыть полностью (п. 7.8.5, 7.8.8).</li><li>Помещения для вентиляционного оборудования размещают в пределах пожарного отсека обслуживаемых помещений (п. 7.10.5).</li></ul></div><p class=\"e-note\">Для помещений категорий А и Б и производственных зданий действуют дополнительные требования раздела 7. Карточка охватывает общие условия.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-sistemy.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-sistemy.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vent-vozdukhovody\"><header><h3>Воздуховоды: материалы, герметичность, противопожарные клапаны</h3><p>Класс герметичности, негорючие воздуховоды, гибкие вставки, клапаны на перекрытиях и шахты для транзита.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, п. 7.11.1–7.11.11, табл. 7.1 (с изм. № 2)</div></header><div class=\"q-facts\"><div><b>класс В</b><span>герметичность транзитных воздуховодов и коллекторов</span></div><div><b>класс А</b><span>герметичность остальных воздуховодов</span></div><div><b>80 °С</b><span>от этой температуры воздуха воздуховоды только из негорючих материалов</span></div><div><b>EI 30</b><span>предел огнестойкости шахты, кожуха или гильзы для транзита</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Транзитные участки, коллекторы, шахты: класс герметичности</td><td class=\"n m\">В</td></tr><tr><td>Прочие воздуховоды: класс герметичности</td><td class=\"n m\">А</td></tr><tr><td>Перепад давления воздуховод/помещение 1000–2000 Па: класс герметичности</td><td class=\"n m\">С</td></tr><tr><td>Температура воздуха, от которой воздуховоды только из негорючих материалов, °С</td><td class=\"n m\">80</td></tr><tr><td>Окраска или плёнка для защиты от коррозии: толщина не более, мм</td><td class=\"n m\">0,5</td></tr><tr><td>Гибкие вставки и отводы Г2 в помещениях категории Д: доля длины воздуховодов группы Г1, не более, %</td><td class=\"n m\">10</td></tr><tr><td>То же, доля длины негорючих воздуховодов, не более, %</td><td class=\"n m\">5</td></tr><tr><td>Шахта, кожух или гильза для транзита из горючих материалов: предел огнестойкости не менее</td><td class=\"n m\">EI 30</td></tr><tr><td>Общая шахта для стальных транзитных воздуховодов толщиной 1 мм: предел огнестойкости не менее</td><td class=\"n m\">EI 30</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Противопожарные клапаны ставят там, где коллектор пересекает междуэтажные перекрытия, и где воздуховоды пересекают противопожарные преграды. Исключения: кухни в жилых зданиях, санузлы, умывальные и душевые (п. 7.11.1).</li><li>Воздушные затворы на поэтажных воздуховодах ставят в жилых и общественных зданиях при присоединении к коллектору. В санузлах, умывальных и душевых воздушные затворы не предусматривают (п. 7.11.1).</li><li>Воздуховоды только из негорючих материалов: местные отсосы взрывоопасных и пожароопасных смесей, аварийная вентиляция, транзитные участки и коллекторы, венткамеры, технические этажи, чердаки и подвалы (п. 7.11.4).</li><li>Воздуховоды из материалов группы Г1 допускаются в одноэтажных зданиях, за исключением помещений категорий А, Б, В1–В3, с пожарной нагрузкой более 2000 МДж и с массовым пребыванием людей (п. 7.11.5).</li><li>Предел огнестойкости транзитных воздуховодов за пределами обслуживаемого этажа и в разных помещениях принимают по таблице 7.1. Через жилые комнаты транзит запрещён (табл. 7.1, сноска).</li><li>Изменение № 2 распространяет п. 7.11.9 на здания I–IV степеней огнестойкости, а п. 7.11.10 — на категории Г1 и Г2.</li></ul></div><p class=\"e-note\">Сама таблица 7.1 в выборке читается неоднозначно (числитель и знаменатель по этажам, значения НД и НН), поэтому цифры предела огнестойкости здесь не приводятся. Их берут из официального текста.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-vozdukhovody.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-vozdukhovody.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vent-montazh\"><header><h3>Монтаж вентиляции и кондиционирования</h3><p>Изготовление воздуховодов, шаг креплений, прокладки, вентиляторы и клапаны.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 5.3, 6.5</div></header><div class=\"q-facts\"><div><b>4 м / 3 м</b><span>шаг креплений бесфланцевых воздуховодов размером до 400 мм / от 400 мм</span></div><div><b>6 м</b><span>шаг креплений фланцевых воздуховодов размером до 2000 мм</span></div><div><b>≤ 1 %</b><span>зазор между колесом и корпусом вентилятора от диаметра колеса</span></div><div><b>± 0,5 мм/м</b><span>горизонтальность вала вентилятора</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Шаг креплений бесфланцевых воздуховодов размером до 400 мм, не более, м</td><td class=\"n m\">4</td></tr><tr><td>То же размером 400 мм и более, не более, м</td><td class=\"n m\">3</td></tr><tr><td>Шаг креплений фланцевых воздуховодов размером до 2000 мм, не более, м</td><td class=\"n m\">6</td></tr><tr><td>Шаг креплений вертикальных воздуховодов, не более, м</td><td class=\"n m\">4</td></tr><tr><td>Полимерные воздуховоды: подвески горизонтальных, не более, м</td><td class=\"n m\">2,5</td></tr><tr><td>Полимерные воздуховоды: подвески вертикальных, не более, м</td><td class=\"n m\">3</td></tr><tr><td>Прокладки между фланцами полимерных воздуховодов, мм</td><td class=\"n m\">3–5</td></tr><tr><td>Уплотнитель фланцев из резины при температуре воздуха до 70 °С, мм</td><td class=\"n m\">4–5</td></tr><tr><td>Зазор между колесом и корпусом вентилятора, не более, % диаметра колеса</td><td class=\"n m\">1</td></tr><tr><td>Отклонение вала вентилятора, мм на 1 м</td><td class=\"n m\">±0,5</td></tr><tr><td>Шаг зигов при стороне воздуховода более 400 мм, мм</td><td class=\"n m\">200–300</td></tr><tr><td>Рамки жёсткости при стороне воздуховода более, мм</td><td class=\"n m\">1000</td></tr><tr><td>Заклёпки Ø4–5 мм: шаг, мм</td><td class=\"n m\">200–250</td></tr><tr><td>Заклёпок на соединение, не менее</td><td class=\"n m\">4</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Запорно-регулирующие устройства после монтажа оставляют в положении «Открыто» (п. 6.5.24).</li><li>Горизонтальные бесфланцевые воздуховоды размером до 400 мм крепят не реже чем через 4 м, размером 400 мм и более — через 3 м. Вертикальные — не реже чем через 4 м (п. 6.5).</li></ul></div><p class=\"e-note\">Карточка собрана из выборок п. 5.3 и 6.5. Подробный порядок монтажа вентиляторов, клапанов и приёмки систем смотрят в полном тексте.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-montazh.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-montazh.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-inzh-obshchie\"><summary><span class=\"q-sh\"><b>Общее для инженерных систем</b><small>Шаг креплений труб, отверстия и борозды, заготовка и испытания узлов.</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#ov-kreplenie-stal\">Шаг креплений стальных труб и расстояния до конструкций</a><a href=\"#ov-kreplenie-polimer\">Шаг креплений полимерных и металлополимерных труб</a><a href=\"#ov-otverstiya\">Отверстия и борозды для прокладки труб и воздуховодов</a><a href=\"#ov-zagotovka\">Заготовка труб, гибка, сварка полимерных труб и испытания узлов</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"ov-kreplenie-stal\"><header><h3>Шаг креплений стальных труб и расстояния до конструкций</h3><p>Наибольшее расстояние между опорами металлических труб по диаметру и расстояния в свету от изоляции до стен, пола и перекрытий.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, прил. Б, табл. Б.1, Б.4</div></header><div class=\"q-facts\"><div><b>2,5 м</b><span>труба Dу 15 неизолированная</span></div><div><b>6,0 м</b><span>труба Dу 70–100 неизолированная</span></div><div><b>8,0 м</b><span>труба Dу 150 неизолированная</span></div><div><b>± 20 мм</b><span>допуск расстояний по табл. Б.4</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(м)</span></th><th class=\"n\">Неизолированные</th><th class=\"n\">Изолированные</th></tr></thead><tbody><tr><td>Dу 15</td><td class=\"n m\">2,5</td><td class=\"n m\">1,5</td></tr><tr><td>Dу 20</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>Dу 25</td><td class=\"n m\">3,5</td><td class=\"n m\">2</td></tr><tr><td>Dу 32</td><td class=\"n m\">4</td><td class=\"n m\">2,5</td></tr><tr><td>Dу 40</td><td class=\"n m\">4,5</td><td class=\"n m\">3</td></tr><tr><td>Dу 50</td><td class=\"n m\">5</td><td class=\"n m\">3</td></tr><tr><td>Dу 70</td><td class=\"n m\">6</td><td class=\"n m\">4</td></tr><tr><td>Dу 80</td><td class=\"n m\">6</td><td class=\"n m\">4</td></tr><tr><td>Dу 100</td><td class=\"n m\">6</td><td class=\"n m\">4,5</td></tr><tr><td>Dу 125</td><td class=\"n m\">7</td><td class=\"n m\">5</td></tr><tr><td>Dу 150</td><td class=\"n m\">8</td><td class=\"n m\">6</td></tr></tbody></table></div><h4 class=\"q-h4\">Расстояние в свету от поверхности изоляции, мм (табл. Б.4)</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">До стены</th><th class=\"n\">До пола</th><th class=\"n\">До перекрытия</th><th class=\"n\">Между смежными по вертикали</th><th class=\"n\">Между смежными по горизонтали</th></tr></thead><tbody><tr><td>Dу 25–80</td><td class=\"n m\">150</td><td class=\"n m\">100</td><td class=\"n m\">150</td><td class=\"n m\">100</td><td class=\"n m\">100</td></tr><tr><td>Dу 100–250</td><td class=\"n m\">170</td><td class=\"n m\">100</td><td class=\"n m\">200</td><td class=\"n m\">140</td><td class=\"n m\">140</td></tr><tr><td>Dу 300–350</td><td class=\"n m\">200</td><td class=\"n m\">120</td><td class=\"n m\">200</td><td class=\"n m\">160</td><td class=\"n m\">160</td></tr><tr><td>Dу 400–450</td><td class=\"n m\">200</td><td class=\"n m\">120</td><td class=\"n m\">200</td><td class=\"n m\">160</td><td class=\"n m\">200</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 15</text><rect x=\"220\" y=\"6\" width=\"106.2\" height=\"22\" fill=\"#1d1f23\"/><text x=\"334.25\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2,5 м</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 25</text><rect x=\"220\" y=\"40\" width=\"148.8\" height=\"22\" fill=\"#1d1f23\"/><text x=\"376.75\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3,5 м</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 50</text><rect x=\"220\" y=\"74\" width=\"212.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"440.5\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 м</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 100</text><rect x=\"220\" y=\"108\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">6 м</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 150</text><rect x=\"220\" y=\"142\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">8 м</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Расстояния Б.1 — наибольшие между опорами металлических труб. Для вертикальных стальных труб при высоте этажа более 3 м добавляют крепление на половине этажа (п. 6.1.5).</li><li>Допускаемое отклонение расстояний по таблице Б.4 — ±20 мм (прил. Б).</li></ul></div><p class=\"e-note\">Таблица Б.1 относится к металлическим трубам, значения даны по выборке и сверяются с официальным текстом.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kreplenie-stal.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kreplenie-stal.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-kreplenie-polimer\"><header><h3>Шаг креплений полимерных и металлополимерных труб</h3><p>Наибольшее расстояние между опорами по наружному диаметру, горизонтальные и вертикальные участки.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, прил. Б, табл. Б.2, Б.3</div></header><div class=\"q-facts\"><div><b>500 мм</b><span>труба 16–20 мм неизолированная полимерная</span></div><div><b>1200 мм</b><span>металлополимерная 25 мм, вертикально</span></div><div><b>3000 мм</b><span>металлополимерная 50 мм, вертикально</span></div><div><b>1200 мм</b><span>полимерная 90 мм, неизолированная</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Диаметр 16 и 20 мм</td><td class=\"n m\">500</td></tr><tr><td>Диаметр 25 и 32 мм</td><td class=\"n m\">600</td></tr><tr><td>Диаметр 40 мм</td><td class=\"n m\">750</td></tr><tr><td>Диаметр 50 мм</td><td class=\"n m\">900</td></tr><tr><td>Диаметр 63 мм</td><td class=\"n m\">1000</td></tr><tr><td>Диаметр 75 мм</td><td class=\"n m\">1100</td></tr><tr><td>Диаметр 90 мм</td><td class=\"n m\">1200</td></tr></tbody></table></div><h4 class=\"q-h4\">Металлополимерные трубы (табл. Б.3)</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Горизонтальные</th><th class=\"n\">Вертикальные</th></tr></thead><tbody><tr><td>До 16 мм</td><td class=\"n m\">500</td><td class=\"n m\">1000</td></tr><tr><td>20 мм</td><td class=\"n m\">500</td><td class=\"n m\">1000</td></tr><tr><td>25 мм</td><td class=\"n m\">750</td><td class=\"n m\">1200</td></tr><tr><td>32 мм</td><td class=\"n m\">1000</td><td class=\"n m\">2400</td></tr><tr><td>40 мм</td><td class=\"n m\">1000</td><td class=\"n m\">2400</td></tr><tr><td>50 мм</td><td class=\"n m\">1000</td><td class=\"n m\">3000</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ø16–20 мм</text><rect x=\"220\" y=\"6\" width=\"141.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"369.66666666666663\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">500 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ø25–32 мм</text><rect x=\"220\" y=\"40\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">600 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ø50 мм</text><rect x=\"220\" y=\"74\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">900 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ø90 мм</text><rect x=\"220\" y=\"108\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1200 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Таблица Б.2 относится к неизолированным полимерным трубам, таблица Б.3 — к металлополимерным (прил. Б).</li><li>Шаг креплений вертикальных полимерных канализационных труб: до 1000 мм при диаметре до 32 мм и до 1500 мм при большем диаметре (п. 6.1.5).</li></ul></div><p class=\"e-note\">Расстояния приведены по прил. Б ТКП 45-1.03-85. Для изолированных и тёплых трубопроводов шаг может быть меньше, его принимают по проекту и данным изготовителя.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kreplenie-polimer.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kreplenie-polimer.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-otverstiya\"><header><h3>Отверстия и борозды для прокладки труб и воздуховодов</h3><p>Размеры отверстий в стенах и перекрытиях и борозд в стенах под стояки, подводки, магистрали.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, прил. А, табл. А.1</div></header><div class=\"q-facts\"><div><b>100 × 100</b><span>отверстие под один стояк отопления или водопровода</span></div><div><b>130 × 130</b><span>борозда под один стояк</span></div><div><b>D + 150</b><span>отверстие под воздуховод</span></div><div><b>≥ 400 × 400</b><span>ввод и выпуск</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Отверстие</th><th class=\"n\">Борозда</th></tr></thead><tbody><tr><td>Стояк однотрубной системы отопления</td><td class=\"n m\">100 × 100</td><td class=\"n m\">130 × 130</td></tr><tr><td>Два стояка двухтрубной системы отопления</td><td class=\"n m\">150 × 100</td><td class=\"n m\">200 × 130</td></tr><tr><td>Подводка к отопительным приборам</td><td class=\"n m\">100 × 100</td><td class=\"n m\">60 × 60</td></tr><tr><td>Главный стояк</td><td class=\"n m\">200 × 200</td><td class=\"n m\">200 × 200</td></tr><tr><td>Один водопроводный стояк</td><td class=\"n m\">100 × 100</td><td class=\"n m\">130 × 130</td></tr><tr><td>Два водопроводных стояка</td><td class=\"n m\">200 × 100</td><td class=\"n m\">200 × 130</td></tr><tr><td>Водопроводный стояк и канализационный Ø50</td><td class=\"n m\">250 × 150</td><td class=\"n m\">250 × 130</td></tr><tr><td>Водопроводный стояк и канализационный Ø100–150</td><td class=\"n m\">350 × 200</td><td class=\"n m\">350 × 200</td></tr><tr><td>Канализационный стояк Ø50</td><td class=\"n m\">150 × 150</td><td class=\"n m\">200 × 130</td></tr><tr><td>Канализационный стояк Ø100–150</td><td class=\"n m\">200 × 200</td><td class=\"n m\">250 × 250</td></tr><tr><td>Два водопроводных и канализационный Ø50</td><td class=\"n m\">320 × 150</td><td class=\"n m\">300 × 130</td></tr><tr><td>Два водопроводных и канализационный Ø100–150</td><td class=\"n m\">350 × 200</td><td class=\"n m\">380 × 250</td></tr><tr><td>Три водопроводных и канализационный Ø50</td><td class=\"n m\">450 × 150</td><td class=\"n m\">350 × 130</td></tr><tr><td>Три водопроводных и канализационный Ø100–150</td><td class=\"n m\">500 × 200</td><td class=\"n m\">480 × 250</td></tr><tr><td>Водопроводная подводка</td><td class=\"n m\">100 × 100</td><td class=\"n m\">60 × 60</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Отверстие под воздуховод — размер воздуховода плюс 150 мм (D + 150).</li><li>Отверстия для ввода и выпуска — не менее 400 × 400 мм.</li><li>Для двух подводок водопровода размеры отверстия увеличены до 100 × 200 мм.</li></ul></div><p class=\"e-note\">Размеры даны в мм, порядок «ширина × высота» принят по выборке. Значения в скобках из таблицы (например, «300» у позиции с двумя водопроводными стояками) в карточку не вынесены, их сверяют по официальному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-otverstiya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-otverstiya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-zagotovka\"><header><h3>Заготовка труб, гибка, сварка полимерных труб и испытания узлов</h3><p>Допуски на заготовку стальных труб, радиус гиба, сварка полимерных труб, пробное давление.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 5.2, табл. 1</div></header><div class=\"q-facts\"><div><b>± 2 мм</b><span>длина заготовки до 1 м</span></div><div><b>2,5 Dн / 3,5 Dн</b><span>наименьший радиус гиба стальной трубы Dу до 40 / от 50</span></div><div><b>≤ 10 %</b><span>овальность гиба и смещение кромок при сварке</span></div><div><b>1,5 Ру</b><span>пробное давление узла</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Перпендикулярность торцов к оси, не более, градусов</td><td class=\"n m\">2</td></tr><tr><td>Длина заготовки до 1 м, мм</td><td class=\"n m\">±2</td></tr><tr><td>Добавка на каждый следующий метр, мм</td><td class=\"n m\">±1</td></tr><tr><td>Овальность гиба, не более, %</td><td class=\"n m\">10</td></tr><tr><td>Радиус гиба стальных труб Dу до 40 мм, не менее, Dн</td><td class=\"n m\">2,5</td></tr><tr><td>Радиус гиба стальных труб Dу 50 мм и более, не менее, Dн</td><td class=\"n m\">3,5</td></tr><tr><td>Нитки с неполной резьбой, не более, %</td><td class=\"n m\">10</td></tr><tr><td>Заусенцы, не более, мм</td><td class=\"n m\">0,1</td></tr><tr><td>Радиус гиба полиэтиленовых труб, не менее, диаметров</td><td class=\"n m\">5</td></tr><tr><td>Радиус гиба полипропиленовых труб, не менее, диаметров</td><td class=\"n m\">8</td></tr><tr><td>Смещение кромок при сварке полимерных труб, не более, % толщины стенки</td><td class=\"n m\">10</td></tr><tr><td>Усиление шва при стенке менее 10 мм, не более, мм</td><td class=\"n m\">2,5</td></tr><tr><td>Усиление шва при большей стенке, мм</td><td class=\"n m\">3–4</td></tr></tbody></table></div><h4 class=\"q-h4\">Испытания</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Узлы водо- и теплоснабжения, гидравлически: давление / выдержка</td><td class=\"n m\">1,5 Ру / 3 мин</td></tr><tr><td>Узлы, пузырьковым способом: давление / выдержка</td><td class=\"n m\">0,15 МПа / 30 с</td></tr><tr><td>Стальная канализация: давление / выдержка</td><td class=\"n m\">0,2 МПа / 3 мин</td></tr><tr><td>Радиаторы: гидравлически</td><td class=\"n m\">1,5 МПа</td></tr><tr><td>Радиаторы: пузырьковым способом</td><td class=\"n m\">0,1 МПа</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Длина резьбы: короткой допускается на 10 % меньше, длинной — на 5 мм больше (табл. 1).</li><li>Чугунные канализационные трубы: перпендикулярность торцов 5°, трещины длиной не более 15 мм, волнистость не более 10 мм, размеры узлов ±10 мм (п. 5.2).</li><li>Воздуховоды: зиги шагом 200–300 мм при стороне более 400 мм, рамки жёсткости при стороне более 1000 мм (п. 5.3).</li></ul></div><p class=\"e-note\">Dн — наружный диаметр, Dу — условный проход, Ру — условное давление. Значения ТКП 45-1.03-85 (табл. 1) сверяют по официальному тексту, особенно допуск резьбы.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-zagotovka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-zagotovka.pdf\" download>Документ PDF</a></div></article></div></details><script src=\"/static/q.js?v=1\"></script><section class=\"e-sec\"><h2>Как проверяют на объекте</h2><div class=\"e-two\"><div class=\"e-card\"><h3>Входной контроль</h3><ul><li>Проверяют документы на материалы: сертификат или декларация соответствия, документ о качестве изготовителя (п. 3.4).</li><li>Проверяют основание: влажность, чистоту, ровность по таблице допусков (п. 3.17, 3.18, табл. 2).</li><li>Проверяют условия: температуру и влажность воздуха (п. 3.14).</li></ul></div><div class=\"e-card\"><h3>Приёмка</h3><ul><li>Сравнивают результат с таблицей допусков для вида отделки из проекта.</li><li>Осматривают поверхность: без пузырей, трещин, пятен, пропусков и следов кисти.</li><li>Измерения и порядок приёмки задают СТБ 1472–1475 и СТБ 1483 (п. 3.9). Недочёты фиксируют списком и устраняют в оговорённый срок.</li></ul></div></div><p class=\"e-note\">Все числа выше изложены по тексту СП 1.03.01-2019 и перед внесением в договор сверяются с официальной редакцией документа специалистом.</p></section>"
}

pattern EstElecTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=10\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет · Электрика</div><h1>Электрические калькуляторы</h1><p class=\"e-lead\">Подбор сечения кабеля с учётом прочности, нагрева и потери напряжения, ток короткого замыкания, заземление, освещение помещений. Результат можно перенести в смету.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\" class=\"on\" aria-current=\"page\">{{ t.est_tab_elec }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Электрика\"><a href=\"#cable\" data-sub=\"cable\">Подбор кабеля</a><a href=\"#kz\" data-sub=\"kz\">Ток КЗ</a><a href=\"#ground\" data-sub=\"ground\">Заземление</a><a href=\"#light\" data-sub=\"light\">Освещение</a><a href=\"#apparaty\" data-sub=\"apparaty\">Автоматы и УЗО</a><a href=\"#ref\" data-sub=\"ref\">Справочник</a><a href=\"#guide\" data-sub=\"guide\">Как подобрать кабель</a></div><div class=\"e-elec\" id=\"e-elec\"><section class=\"e-panel\" id=\"cable\" data-panel=\"cable\"><div class=\"e-sech\"><small>01</small><h2>Подбор сечения кабеля</h2></div><p class=\"e-lead2\">Выберите сеть, материал, изоляцию и способ прокладки, задайте мощность или ток, длину линии и cos φ. Калькулятор проверит сечение по механической прочности, нагреву током с учётом автомата и потере напряжения и покажет, что определило результат.</p><div class=\"e-calc\"><div class=\"e-form\"><fieldset class=\"e-seg\"><legend>Сеть</legend><label><input type=\"radio\" name=\"c-ph\" value=\"1\" checked><span>1 фаза</span></label><label><input type=\"radio\" name=\"c-ph\" value=\"3\"><span>3 фазы</span></label></fieldset><fieldset class=\"e-seg\"><legend>Материал жилы</legend><label><input type=\"radio\" name=\"c-mat\" value=\"cu\" checked><span>Медь</span></label><label><input type=\"radio\" name=\"c-mat\" value=\"al\"><span>Алюминий</span></label></fieldset><fieldset class=\"e-seg\"><legend>Изоляция</legend><label><input type=\"radio\" name=\"c-ins\" value=\"pvc\" checked><span>Изоляция ПВХ (до 70 °С)</span></label><label><input type=\"radio\" name=\"c-ins\" value=\"xlpe\"><span>Сшитый полиэтилен (до 90 °С)</span></label></fieldset><fieldset class=\"e-seg\"><legend>Исходные данные</legend><label><input type=\"radio\" name=\"c-mode\" value=\"p\" checked><span>Задана мощность</span></label><label><input type=\"radio\" name=\"c-mode\" value=\"i\"><span>Задан ток</span></label></fieldset><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"c-lay\">Способ прокладки</label><div class=\"e-in\"><select id=\"c-lay\"><option value=\"B1\" selected>В трубе или коробе, скрыто в стене (B1)</option><option value=\"C\">Кабелем открыто по стене (C)</option><option value=\"A1\">В трубе в утеплённой стене (A1)</option><option value=\"E\">На лотке в воздухе (E)</option></select></div></div><div class=\"e-f wide\"><label for=\"c-kind\">Назначение линии</label><div class=\"e-in\"><select id=\"c-kind\"><option value=\"sock\" selected>Розетки и бытовые приборы</option><option value=\"light\">Освещение</option><option value=\"power\">Силовая линия, питание щита</option></select></div></div><div class=\"e-f\"><label for=\"c-u\">Напряжение</label><div class=\"e-in\"><input id=\"c-u\" inputmode=\"decimal\" autocomplete=\"off\" value=\"230\"><span class=\"u\">В</span></div></div><div class=\"e-f\" id=\"c-wp\"><label for=\"c-p\">Мощность</label><div class=\"e-in\"><input id=\"c-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3,5\"><span class=\"u\">кВт</span></div></div><div class=\"e-f\" id=\"c-wi\" hidden><label for=\"c-i\">Ток</label><div class=\"e-in\"><input id=\"c-i\" inputmode=\"decimal\" autocomplete=\"off\" value=\"16\"><span class=\"u\">А</span></div></div><div class=\"e-f\"><label for=\"c-cos\">cos φ</label><div class=\"e-in\"><input id=\"c-cos\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,0\"></div></div><div class=\"e-f\"><label for=\"c-l\">Длина линии</label><div class=\"e-in\"><input id=\"c-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"c-k\">Одновременность</label><div class=\"e-in\"><input id=\"c-k\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,0\"></div></div><div class=\"e-f\"><label for=\"c-lim\">Допустимая потеря</label><div class=\"e-in\"><input id=\"c-lim\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">%</span></div></div><div class=\"e-f\"><label for=\"c-t\">Температура воздуха</label><div class=\"e-in\"><input id=\"c-t\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"c-n\">Цепей рядом в одном канале</label><div class=\"e-in\"><input id=\"c-n\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div></div><div class=\"e-formula\">Итог = наибольшее из трёх сечений: по механической прочности, по нагреву и по потере напряжения<br>Нагрев: I ≤ автомат ≤ Iдоп · k<sub>t</sub> · k<sub>гр</sub><br>1 фаза: I = P ÷ (U · cos φ), ΔU = 2 · I · L · (ρ ÷ S · cos φ + x · sin φ)<br>3 фазы: I = P ÷ (1,73 · U · cos φ), ΔU = 1,73 · I · L · (ρ ÷ S · cos φ + x · sin φ)<br>ρ при рабочей температуре жилы, x = 0,08 мОм/м</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Расчётный ток</span><b id=\"c-r-i\">—</b></div><div class=\"kv\"><span>По механической прочности</span><b id=\"c-r-mech\">—</b></div><div class=\"kv\"><span>По нагреву током и автомату</span><b id=\"c-r-cur\">—</b></div><div class=\"kv\"><span>По потере напряжения</span><b id=\"c-r-drop\">—</b></div><div class=\"kv\"><span>Итоговое сечение</span><b id=\"c-r-s\">—</b></div><div class=\"kv\"><span>Определяет</span><b id=\"c-r-by\">—</b></div><div class=\"kv\"><span>Автомат</span><b id=\"c-r-in\">—</b></div><div class=\"kv\"><span>Допустимый ток кабеля</span><b id=\"c-r-iz\">—</b></div><div class=\"kv\"><span>Потеря напряжения</span><b id=\"c-r-du\">—</b></div><div class=\"verdict\" id=\"c-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"kz\" data-panel=\"kz\"><div class=\"e-sech\"><small>02</small><h2>Ток короткого замыкания и срабатывание автомата</h2></div><p class=\"e-lead2\">Проверка, что при замыкании фазы на ноль автомат отключится быстро. Нужны длина и сечение линии и сопротивление питающей части.</p><div class=\"e-calc\"><div class=\"e-form\"><fieldset class=\"e-seg\"><legend>Материал жилы</legend><label><input type=\"radio\" name=\"k-mat\" value=\"cu\" checked><span>Медь</span></label><label><input type=\"radio\" name=\"k-mat\" value=\"al\"><span>Алюминий</span></label></fieldset><div class=\"e-row\"><div class=\"e-f\"><label for=\"k-u\">Напряжение фазы</label><div class=\"e-in\"><input id=\"k-u\" inputmode=\"decimal\" autocomplete=\"off\" value=\"230\"><span class=\"u\">В</span></div></div><div class=\"e-f\"><label for=\"k-s\">Сечение</label><div class=\"e-in\"><input id=\"k-s\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,5\"><span class=\"u\">мм²</span></div></div><div class=\"e-f\"><label for=\"k-l\">Длина</label><div class=\"e-in\"><input id=\"k-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"40\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"k-zs\">Сопротивление питания</label><div class=\"e-in\"><input id=\"k-zs\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,05\"><span class=\"u\">Ом</span></div></div><div class=\"e-f\"><label for=\"k-in\">Номинал автомата</label><div class=\"e-in\"><input id=\"k-in\" inputmode=\"decimal\" autocomplete=\"off\" value=\"16\"><span class=\"u\">А</span></div></div><div class=\"e-f\"><label for=\"k-type\">Тип расцепителя</label><div class=\"e-in\"><select id=\"k-type\"><option value=\"10:C\" selected>C (5–10 × Iном)</option><option value=\"5:B\">B (3–5 × Iном)</option><option value=\"20:D\">D (10–20 × Iном)</option></select></div></div></div><div class=\"e-formula\">Z петли = 2 · ρ · L ÷ S + Z питания<br>Iкз = U фазы ÷ Z петли<br>Порог мгновенного срабатывания берётся по верхней границе диапазона типа расцепителя</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Сопротивление петли</span><b id=\"k-r-z\">—</b></div><div class=\"kv\"><span>Ток КЗ</span><b id=\"k-r-ik\">—</b></div><div class=\"kv\"><span>Порог срабатывания</span><b id=\"k-r-th\">—</b></div><div class=\"kv\"><span>Запас</span><b id=\"k-r-m\">—</b></div><div class=\"verdict\" id=\"k-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"ground\" data-panel=\"ground\"><div class=\"e-sech\"><small>03</small><h2>Заземление: число стержней</h2></div><p class=\"e-lead2\">Подбор числа вертикальных заземлителей по сопротивлению грунта. Ориентировочный расчёт; на месте обязателен замер.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"g-rho\">Удельное сопротивление грунта</label><div class=\"e-in\"><input id=\"g-rho\" inputmode=\"decimal\" autocomplete=\"off\" value=\"100\"><span class=\"u\">Ом·м</span></div></div><div class=\"e-f\"><label for=\"g-l\">Длина стержня</label><div class=\"e-in\"><input id=\"g-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"g-d\">Диаметр</label><div class=\"e-in\"><input id=\"g-d\" inputmode=\"decimal\" autocomplete=\"off\" value=\"16\"><span class=\"u\">мм</span></div></div><div class=\"e-f\"><label for=\"g-t0\">Заглубление верха</label><div class=\"e-in\"><input id=\"g-t0\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,8\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"g-r\">Нужное сопротивление</label><div class=\"e-in\"><input id=\"g-r\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">Ом</span></div></div><div class=\"e-f\"><label for=\"g-eta\">Коэфф. использования</label><div class=\"e-in\"><input id=\"g-eta\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,7\"></div></div><div class=\"e-f\"><label for=\"g-a\">Шаг между стержнями</label><div class=\"e-in\"><input id=\"g-a\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м</span></div></div></div><div class=\"e-formula\">R стержня = ρ ÷ (2π·l) · (ln(2l ÷ d) + ½ · ln((4t + l) ÷ (4t − l)))<br>n = R стержня ÷ (R нужное · η), t — глубина середины стержня</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Один стержень</span><b id=\"g-r-1\">—</b></div><div class=\"kv\"><span>Нужно стержней</span><b id=\"g-r-n\">—</b></div><div class=\"kv\"><span>Итого</span><b id=\"g-r-tot\">—</b></div><div class=\"kv\"><span>Полоса связи</span><b id=\"g-r-strip\">—</b></div><div class=\"verdict\" id=\"g-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"light\" data-panel=\"light\"><div class=\"e-sech\"><small>04</small><h2>Освещение помещения</h2></div><p class=\"e-lead2\">Выберите тип помещения и светильник. Калькулятор возьмёт норму освещённости, найдёт нужное число светильников и покажет, как расставить их на плане.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"l-room\">Тип помещения</label><div class=\"e-in\"><select id=\"l-room\"><option value=\"150\">Жилая комната, спальня</option><option value=\"150\">Кухня, кухня-столовая</option><option value=\"200\">Детская</option><option value=\"300\">Кабинет</option><option value=\"75\">Гардеробная</option><option value=\"50\">Коридор, холл в квартире</option><option value=\"50\">Ванная, санузел</option><option value=\"30\">Кладовая</option><option value=\"20\">Лестница</option></select></div></div><div class=\"e-f\"><label for=\"l-e\">Норма</label><div class=\"e-in\"><input id=\"l-e\" inputmode=\"decimal\" autocomplete=\"off\" value=\"150\"><span class=\"u\">лк</span></div></div><div class=\"e-f\"><label for=\"l-a\">Длина</label><div class=\"e-in\"><input id=\"l-a\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5,0\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"l-b\">Ширина</label><div class=\"e-in\"><input id=\"l-b\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4,0\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"l-h\">Высота потолка</label><div class=\"e-in\"><input id=\"l-h\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,7\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"l-hp\">Высота плоскости</label><div class=\"e-in\"><input id=\"l-hp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,0\"><span class=\"u\">м</span></div></div><div class=\"e-f wide\"><label for=\"l-fix\">Светильник</label><div class=\"e-in\"><select id=\"l-fix\"><option value=\"12:1500\">Потолочный LED, 12 Вт, 1 500 лм</option><option value=\"18:2000\">Потолочный LED, 18 Вт, 2 000 лм</option><option value=\"36:3600\">Панель LED 600×600, 36 Вт, 3 600 лм</option><option value=\"5:450\">Точечный LED, 5 Вт, 450 лм</option><option value=\"24:2800\">Подвесной LED, 24 Вт, 2 800 лм</option></select></div></div><div class=\"e-f wide\"><label for=\"l-ref\">Отражение потолок / стены / пол</label><div class=\"e-in\"><select id=\"l-ref\"><option value=\"1\" selected>70 / 50 / 30 %</option><option value=\"0.85\">50 / 30 / 10 %</option><option value=\"0.75\">30 / 30 / 10 %</option></select></div></div><div class=\"e-f\"><label for=\"l-kz\">Коэфф. запаса</label><div class=\"e-in\"><input id=\"l-kz\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,3\"></div></div><div class=\"e-f\"><label for=\"l-z\">Неравномерность</label><div class=\"e-in\"><input id=\"l-z\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,1\"></div></div></div><div class=\"e-plan\"><b>План расстановки</b><svg id=\"l-svg\" viewBox=\"0 0 620 500\" role=\"img\" aria-label=\"План комнаты с расстановкой светильников\"></svg><p class=\"e-note\" id=\"l-plan-note\"></p></div><div class=\"e-rooms\"><b>Квартира целиком</b><p class=\"e-lead2\">Добавляйте помещения и получите список светильников для сметы и общую мощность освещения.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Помещение</th><th>Площадь, м²</th><th>Норма, лк</th><th>Светильников</th><th>Получится, лк</th><th>Мощность, Вт</th><th></th></tr></thead><tbody id=\"l-rooms\"></tbody></table></div><div class=\"e-actions\"><button class=\"e-btn\" id=\"l-add\" type=\"button\">Добавить это помещение</button><button class=\"e-btn ghost\" id=\"l-clear\" type=\"button\">Очистить список</button></div></div><div class=\"e-formula\">Индекс помещения i = A · B ÷ (h · (A + B))<br>N = E · S · Kз · Z ÷ (F · η)<br>E — норма, лк; S — площадь; Kз — запас; Z — неравномерность; F — поток светильника, лм; η — коэффициент использования</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Норма освещённости</span><b id=\"l-r-e\">—</b></div><div class=\"kv\"><span>Индекс помещения</span><b id=\"l-r-i\">—</b></div><div class=\"kv\"><span>Коэфф. использования</span><b id=\"l-r-eta\">—</b></div><div class=\"kv\"><span>Нужный поток</span><b id=\"l-r-f\">—</b></div><div class=\"kv\"><span>Светильников</span><b id=\"l-r-n\">—</b></div><div class=\"kv\"><span>Получится</span><b id=\"l-r-got\">—</b></div><div class=\"kv\"><span>Мощность</span><b id=\"l-r-w\">—</b></div><div class=\"verdict\" id=\"l-verdict\" role=\"status\"></div><button class=\"e-btn wide\" id=\"l-tocable\" type=\"button\">Передать мощность в «Подбор кабеля»</button></div></div></div></section><section class=\"e-panel\" id=\"apparaty\" data-panel=\"apparaty\"><div class=\"e-sech\"><small>05</small><h2>Автоматы, дифавтоматы и УЗО</h2></div><p class=\"e-lead2\">Справка по обозначениям на корпусе и по применению. Автомат защищает кабель от перегрузки и короткого замыкания. УЗО защищает людей и имущество от тока утечки, но от перегрузки и короткого замыкания не защищает. Дифавтомат объединяет и то, и другое в одном корпусе.</p><div class=\"e-step\"><div class=\"e-sech\"><small>А</small><h3>Что читать на корпусе</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Обозначение</th><th>Что значит</th><th>Как использовать</th></tr></thead><tbody><tr><td class=\"m\">C16</td><td>Буква — характеристика срабатывания (кривая) мгновенного расцепителя. Число — номинальный ток In, А.</td><td>Номинал не меньше расчётного тока линии и не больше допустимого тока кабеля. Букву выбирают по нагрузке, см. таблицу ниже.</td></tr><tr><td class=\"m\">6000, 6 кА</td><td>Номинальная предельная коммутационная способность Icn: наибольший ток короткого замыкания, который автомат отключает и остаётся исправным. Обычно в рамке на корпусе.</td><td>Должна быть выше расчётного максимального тока короткого замыкания в месте установки (СН 4.04.01, п. 10.4). Бывает 3000, 4500, 6000, 10 000 А.</td></tr><tr><td class=\"m\">Цифра 1, 2 или 3 под рамкой</td><td>Класс токоограничения: чем выше, тем меньше энергия, пропускаемая при коротком замыкании.</td><td>Класс 3 даёт наименьший нагрев кабеля при коротком замыкании. Без цифры — класс 1 (токоограничения нет).</td></tr><tr><td class=\"m\">1P, 1P+N, 2P, 3P, 3P+N, 4P</td><td>Число полюсов. P — защищённые полюса, +N — отключаемый нулевой полюс без расцепителя.</td><td>В двух- и трёхфазных групповых линиях освещения однополюсные автоматы запрещены (СН 4.04.01, п. 7.1.2). Аппараты управления отключают все фазные проводники (п. 8.1.4).</td></tr><tr><td class=\"m\">230/400 В ~ 50 Гц</td><td>Номинальное напряжение и частота.</td><td>Для сетей Беларуси 230 В одна фаза и 400 В три фазы.</td></tr><tr><td class=\"m\">IΔn 30 мА</td><td>Номинальный отключающий дифференциальный ток: уставка УЗО и дифавтомата.</td><td>Для людей 30 мА, для защиты от возгорания 300 мА. Отключение происходит между 0,5 и 1 IΔn (ТКП 339-2022, п. 8.7.15).</td></tr><tr><td class=\"m\">AC, A, F, B</td><td>Тип по форме тока утечки, на который реагирует УЗО или дифавтомат.</td><td>См. таблицу типов ниже.</td></tr><tr><td class=\"m\">S</td><td>Селективное УЗО с выдержкой времени отключения.</td><td>Ставят на вводе перед УЗО на 30 мА, чтобы при утечке на линии отключалась только она. Условие селективности: уставка и время вводного УЗО не менее чем втрое больше (ТКП 339-2022, табл. 4.4.47).</td></tr><tr><td class=\"m\">Im, I(m), 500 А</td><td>Номинальная включающая и отключающая способность УЗО: ток замыкания, который оно выдерживает, пока его не отключит автомат перед ним.</td><td>УЗО без защиты от сверхтока ставят только в паре с автоматом (ТКП 339-2022, п. 8.7.8). Номинал автомата не выше указанного изготовителем.</td></tr><tr><td class=\"m\">T, кнопка «Тест»</td><td>Проверка механизма УЗО искусственной утечкой.</td><td>Нажимают периодически по паспорту изготовителя. Аппарат должен отключиться. Если нет, его заменяют.</td></tr></tbody></table></div></div><div class=\"e-step\"><div class=\"e-sech\"><small>Б</small><h3>Характеристика автомата: B, C или D</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Характеристика</th><th>Срабатывание мгновенного расцепителя</th><th>Где применяют</th></tr></thead><tbody><tr><td class=\"m\">B</td><td>3–5 In</td><td>Освещение, длинные линии с малым током короткого замыкания, нагрузки без пусковых токов.</td></tr><tr><td class=\"m\">C</td><td>5–10 In</td><td>Розеточные группы и бытовые приборы, смешанная нагрузка. Обычный выбор для квартир.</td></tr><tr><td class=\"m\">D</td><td>10–20 In</td><td>Электродвигатели, насосы, компрессоры, трансформаторы, оборудование с большими пусковыми токами.</td></tr></tbody></table></div><p class=\"e-note\">Автомат не отключается при токе 1,13 In в течение часа и отключается в течение часа при токе 1,45 In (ГОСТ IEC 60898-1, для аппаратов до 63 А). Значения кратностей зависят от изготовителя: берите из паспорта.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>В</small><h3>Тип УЗО и дифавтомата</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Тип</th><th>На какие токи утечки реагирует</th><th>Для чего применяют</th></tr></thead><tbody><tr><td class=\"m\">AC</td><td>Синусоидальный переменный ток</td><td>Освещение, нагреватели, приборы без электроники. Для электронной техники не подходит.</td></tr><tr><td class=\"m\">A</td><td>Переменный и пульсирующий постоянный ток</td><td>Стиральные и посудомоечные машины, плиты с электроникой, регулируемые светильники, телевизоры, компьютеры. Обычный выбор для квартир (ТКП 339-2022, п. 8.7.10).</td></tr><tr><td class=\"m\">F</td><td>Как тип A, плюс токи смешанных частот</td><td>Однофазные приборы с частотным преобразователем: инверторные кондиционеры, насосы и стиральные машины с инвертором.</td></tr><tr><td class=\"m\">B</td><td>Как тип F, плюс гладкий постоянный ток</td><td>Трёхфазные частотные преобразователи, зарядные станции электромобилей, источники бесперебойного питания, если изготовитель оборудования требует тип B.</td></tr></tbody></table></div></div><div class=\"e-step\"><div class=\"e-sech\"><small>Г</small><h3>Дифавтомат или автомат с УЗО</h3></div><p>Дифавтомат ставят на отдельную линию: при утечке отключается только она, остальной дом остаётся с электричеством. Он занимает один-два модуля и стоит дороже пары «автомат и УЗО». Общее УЗО на несколько линий дешевле, но при утечке на любой из них отключаются все линии за ним. Номинальный ток такого УЗО не меньше номинала автомата, который его защищает. Для морозильника, котла и других линий, где отключение нежелательно, лучше отдельный дифавтомат.</p><p>Норма допускает один УЗО на несколько линий, если у каждой свой автомат (ТКП 339-2022, п. 8.7.11). Суммарный ток утечки сети и приборов не более трети номинального тока УЗО (п. 8.7.14).</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>Д</small><h3>Куда какие аппараты ставить</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Место в схеме</th><th>Какие аппараты ставят</th><th>Основание</th></tr></thead><tbody><tr><td>Ввод в здание: ВУ, ВРУ, ГРЩ</td><td>На вводе питающей линии: аппарат управления и аппарат защиты (автомат считается и тем и другим). На каждой отходящей линии: аппарат защиты. Аппараты управления на отходящих линиях ставят на каждую или один общий на несколько.</td><td>ТКП 339-2022, п. 8.3.3, 8.3.4; СН 4.04.01, п. 9.10</td></tr><tr><td>Распределительные линии жилого дома</td><td>Нагрузка одной линии от ВРУ, как правило, не более 250 А. Когда к линии присоединено несколько стояков питания квартир, а дом выше пяти этажей, на ответвлении к каждому стояку ставят отключающий аппарат.</td><td>СН 4.04.01, п. 9.11, 9.12</td></tr><tr><td>Общедомовое освещение и силовые потребители</td><td>Питание от ГРЩ или ВРУ. Освещение лестниц, коридоров, входов и домофоны питают прямо от ГРЩ (ВРУ) или щитка управления освещением в электрощитовой. Лифты, насосы, вентиляторы — отдельная силовая сеть. В общественных зданиях на каждую линию рабочего, аварийного и эвакуационного освещения свой аппарат защиты и управления.</td><td>СН 4.04.01, п. 9.12, 9.13</td></tr><tr><td>Системы противопожарной защиты</td><td>Для них обязательны аппараты с электромагнитным расцепителем (отсечкой), допускаются автоматы только с отсечкой. Аппараты на ГРЩ (ВРУ) окрашивают в красный цвет. УЗО на такие линии ставить запрещено.</td><td>СН 4.04.01, п. 9.5, 10.2, 16.3.2</td></tr><tr><td>Этажный щиток</td><td>Групповой щиток для квартир ставят на лестничной клетке, в холле или в коридоре этажа. Предохранители в квартирных щитках вне квартир не допускаются. Счётчики размещают в отдельном отсеке, защитно-коммутационную аппаратуру в этом отсеке не ставят. Перед счётчиком прямого включения ставят коммутационный аппарат с опломбированием, снимающий напряжение со всех фаз; в многоквартирных домах он вне квартиры.</td><td>ТКП 339-2022, п. 8.3.6, 8.6.9, 8.6.10; СН 4.04.01, п. 10.2, 15.2</td></tr><tr><td>После счётчика</td><td>Аппарат защиты не дальше 3 м по длине проводки от счётчика. Если после счётчика отходят несколько линий со своими аппаратами защиты, общий не нужен. Если эти аппараты стоят вне помещения счётчика, ставят общий отключающий аппарат.</td><td>СН 4.04.01, п. 15.3; ТКП 339-2022, п. 8.6.11</td></tr><tr><td>Квартирный щиток</td><td>Вводной автомат, затем групповые автоматы и дифавтоматы. На вводе в квартиру или дом предусматривают УЗО до 300 мА для защиты от возгорания. В жилых зданиях УЗО рекомендуется ставить в квартирных щитках, допускается в этажных. Одно УЗО до 30 мА может выполнять обе функции. Расчётная нагрузка до 12 кВт: однофазный ввод, больше: трёхфазный.</td><td>СН 4.04.01, п. 9.12, 16.3.5; ТКП 339-2022, п. 8.7.12, 8.7.16, 8.7.17</td></tr><tr><td>Групповые линии</td><td>Каждая линия имеет свой автомат. В двух- и трёхфазных групповых линиях однополюсные автоматы и предохранители запрещены. Для лампы мощностью 10 кВт и более нужен свой аппарат защиты. Нулевые N и PE разных линий не объединяют. УЗО для защиты людей ставят на отдельные линии, разрешается одно УЗО на несколько линий через отдельные автоматы.</td><td>СН 4.04.01, п. 7.1.2, 7.1.6, 16.3.6</td></tr></tbody></table></div></div><div class=\"e-step\"><div class=\"e-sech\"><small>Е</small><h3>Требования к УЗО: сейчас и по новым нормам</h3></div><p>Изменение № 2 к СН 4.04.01-2019 введено постановлением Министерства архитектуры и строительства от 17 сентября 2026 г. № 75 и вступает в силу через 60 календарных дней после официального опубликования. До этого действуют правила из средней колонки. Официальную дату вступления смотрите на сайте Национального фонда ТНПА.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Линия</th><th>Сейчас: СН 4.04.01 с Изм. № 1, ТКП 339-2022</th><th>По Изм. № 2 к СН 4.04.01</th></tr></thead><tbody><tr><td>Розеточные группы</td><td>УЗО обязательно (ТКП 339-2022, п. 8.7.4)</td><td>УЗО обязательно, до 30 мА при расчётном токе до 32 А</td></tr><tr><td>Светильники общего освещения</td><td>УЗО не требуется, кроме особо опасных помещений при низкой установке и ванных</td><td>УЗО требуется для светильников общего освещения, кроме аварийного освещения</td></tr><tr><td>Электроплита</td><td>Отдельная линия, розетка и автомат не менее 32 А, УЗО до 30 мА. При расчётном токе больше 32 А УЗО не более 100 мА и 100 мс</td><td>То же. Учитывают блокировки изготовителя, ограничивающие максимальную мощность плиты</td></tr><tr><td>Электроводонагреватели и приборы отопления</td><td>УЗО для электроводонагревателей в квартирах и коттеджах, для стиральных и посудомоечных машин, плит (ТКП 339-2022, п. 8.7.4)</td><td>УЗО для электроводонагревателей и приборов отопления</td></tr><tr><td>Тёплые полы и обогрев поверхностей</td><td>УЗО обязательно</td><td>УЗО обязательно</td></tr><tr><td>Ванные и душевые</td><td>УЗО на электроприёмники классов 01 и I</td><td>УЗО на электроприёмники класса I</td></tr><tr><td>Зарядка электромобилей</td><td>В списке нет</td><td>УЗО на линию, кроме случаев, когда зарядная станция сама оснащена УЗО по ГОСТ IEC 61851-1</td></tr><tr><td>Помещения с постоянным пребыванием детей и беременных женщин</td><td>Общее правило: до 30 мА</td><td>УЗО до 10 мА</td></tr><tr><td>УЗО как мера защиты</td><td>Дополняет защиту от сверхтока и не заменяет основные виды защиты</td><td>Прямой запрет использовать УЗО как единственную меру защиты от поражения током</td></tr></tbody></table></div></div><div class=\"e-step\"><div class=\"e-sech\"><small>Ж</small><h3>Что выбрать для линии</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Линия или нагрузка</th><th>Аппарат</th><th>Основание</th></tr></thead><tbody><tr><td>Розеточные группы</td><td>Дифавтомат или УЗО до 30 мА с автоматом C16 при кабеле 2,5 мм²</td><td>Норма: УЗО (СН 4.04.01, п. 16.3.3, 16.3.13). Номинал 16 А: практика, определяется кабелем</td></tr><tr><td>Общее освещение</td><td>Автомат B10 или C10. По Изм. № 2 добавляют УЗО до 30 мА или ставят дифавтомат</td><td>Норма: УЗО по Изм. № 2 (п. 16.3.3). B10: практика</td></tr><tr><td>Стиральная и посудомоечная машины</td><td>Дифавтомат C16, 30 мА, тип A</td><td>Норма: УЗО (ТКП 339-2022, п. 8.7.4). Тип A: практика по п. 8.7.10</td></tr><tr><td>Электроплита</td><td>Автомат не менее 32 А с УЗО</td><td>Норма: СН 4.04.01, п. 11.19, 16.3.13</td></tr><tr><td>Водонагреватель</td><td>Автомат по току нагрузки с УЗО до 30 мА</td><td>Норма: СН 4.04.01, п. 16.3.3, 16.3.13</td></tr><tr><td>Двигатели, насосы, компрессоры</td><td>Автомат C или D по пусковому току. При инверторном приводе УЗО тип F или B</td><td>Практика: по данным изготовителя</td></tr><tr><td>Зарядная станция электромобиля</td><td>По требованию изготовителя станции: УЗО тип A с контролем постоянной составляющей или тип B</td><td>Изм. № 2 к СН 4.04.01 (п. 16.3.3), ГОСТ IEC 61851-1. Тип УЗО: практика</td></tr></tbody></table></div></div><div class=\"e-basis\"><b>На чём основан справочник</b><p>Нормы Беларуси: ТКП 339-2022 (разд. 8, подразд. 4.4) и СН 4.04.01-2019 с изменениями № 1 и № 2. Изменение № 2 заменило в СН 4.04.01 ссылки на ТКП 339 ссылками на СН 4.04.05-2025, поэтому статус ТКП 339-2022 для внутренних сетей проверьте на сайте Нацфонда ТНПА. подробности по приёмке есть в карточках «Автоматические выключатели» и «УЗО» раздела «Качество работ». Система обозначений общая международная, по ГОСТ IEC 60898-1 (автоматы), ГОСТ IEC 61008-1 (УЗО), ГОСТ IEC 61009-1 (дифавтоматы). Текстов этих ГОСТ в материалах сайта нет, поэтому обозначения перед публикацией сверяет технический специалист. Конкретный аппарат всегда читают по его паспорту.</p></div></section><section class=\"e-panel\" id=\"ref\" data-panel=\"ref\"><div class=\"e-sech\"><small>06</small><h2>Справочник мощностей приборов</h2></div><p class=\"e-lead2\">Типичные диапазоны. Кнопка «В расчёт» переносит верхнее значение в калькулятор «Подбор кабеля». Точное значение смотрите на шильдике прибора.</p><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Прибор</th><th>Мощность, кВт</th><th></th></tr></thead><tbody><tr><td>Чайник</td><td class=\"m\">1,8–2,2</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.2\">В расчёт</button></td></tr><tr><td>Стиральная машина</td><td class=\"m\">2,0–2,5</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.5\">В расчёт</button></td></tr><tr><td>Посудомоечная машина</td><td class=\"m\">1,8–2,2</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.2\">В расчёт</button></td></tr><tr><td>Духовой шкаф</td><td class=\"m\">2,0–3,5</td><td><button class=\"e-link\" type=\"button\" data-kw=\"3.5\">В расчёт</button></td></tr><tr><td>Варочная панель</td><td class=\"m\">3,5–7,0</td><td><button class=\"e-link\" type=\"button\" data-kw=\"7.0\">В расчёт</button></td></tr><tr><td>Микроволновка</td><td class=\"m\">0,8–1,5</td><td><button class=\"e-link\" type=\"button\" data-kw=\"1.5\">В расчёт</button></td></tr><tr><td>Утюг</td><td class=\"m\">1,8–2,4</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.4\">В расчёт</button></td></tr><tr><td>Холодильник</td><td class=\"m\">0,15–0,4</td><td><button class=\"e-link\" type=\"button\" data-kw=\"0.4\">В расчёт</button></td></tr></tbody></table></div></section><section class=\"e-panel\" id=\"guide\" data-panel=\"guide\"><div class=\"e-sech\"><small>07</small><h2>Как подобрать кабель</h2></div><p class=\"e-lead2\">Шесть шагов от мощности приборов до марки кабеля. Все числа показаны на одном примере.</p><div class=\"e-step\"><div class=\"e-sech\"><small>01</small><h3>Узнайте ток нагрузки</h3></div><p>Сложите мощность приборов на линии. Чем она больше, тем толще кабель. Мощность переводят в ток по формуле. Для обычных нагревательных приборов коэффициент мощности принимают равным 1.</p><div class=\"e-formula\">Однофазная сеть 230 В:&nbsp; I = P ÷ (U × cosφ)<br>Трёхфазная сеть 400 В:&nbsp; I = P ÷ (1,73 × U × cosφ)<br>Пример: 3 500 Вт ÷ 230 В = 15,2 А</div></div><div class=\"e-step\"><div class=\"e-sech\"><small>02</small><h3>Учтите, что приборы работают не одновременно</h3></div><p>Чайник, плита и стиральная машина редко включены вместе на полную мощность. Для расчёта линии на несколько приборов берут коэффициент одновременности меньше единицы. Для одного мощного прибора он равен 1.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>03</small><h3>Выберите автомат</h3></div><p>Автомат защищает кабель от перегрева. Его номинальный ток должен быть не меньше тока нагрузки и не больше допустимого тока кабеля. В нашем примере ток 15,2 А, значит подходит автомат на 16 А.</p><div class=\"e-formula\">Ток нагрузки ≤ ток автомата ≤ допустимый ток кабеля<br>15,2 А ≤ 16 А ≤ 27 А</div></div><div class=\"e-step\"><div class=\"e-sech\"><small>04</small><h3>Подберите сечение по допустимому току</h3></div><p>Допустимый ток зависит от материала жилы, способа прокладки, температуры и числа кабелей в одном пучке. В пучке и в тёплом помещении допустимый ток снижают. Если сомневаетесь, берите ближайшее большее сечение.</p><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Сечение жилы, мм²</th><th>Допустимый ток, А</th><th>Автомат, А</th><th>Обычно для</th></tr></thead><tbody><tr><td class=\"m\">1,5</td><td class=\"m\">19</td><td class=\"m\">10</td><td>освещение</td></tr><tr><td class=\"m\">2,5</td><td class=\"m\">27</td><td class=\"m\">16</td><td>розетки</td></tr><tr><td class=\"m\">4</td><td class=\"m\">36</td><td class=\"m\">25</td><td>мощные приборы</td></tr><tr><td class=\"m\">6</td><td class=\"m\">46</td><td class=\"m\">32</td><td>плита, духовой шкаф</td></tr><tr><td class=\"m\">10</td><td class=\"m\">63</td><td class=\"m\">50</td><td>ввод в квартиру, щиты</td></tr></tbody></table></div><p class=\"e-note\">Медная жила, изоляция ПВХ, один кабель, открытая или скрытая прокладка по стене. Значения образца: точные берутся из норм и документации производителя кабеля.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>05</small><h3>Проверьте падение напряжения</h3></div><p>На длинной линии часть напряжения теряется в самом кабеле. Нужно, чтобы потери были небольшими: в расчётах обычно держат их в пределах 3–5 %, а точный предел задают нормы. Если потери больше, берут сечение крупнее.</p><div class=\"e-formula\">Потеря, В = 2 × I × L × ρ ÷ S&nbsp;&nbsp;(ρ меди 0,0175; алюминия 0,028)<br>Пример: 2 × 15,2 × 30 м × 0,0175 ÷ 2,5 мм² = 6,4 В = 2,8 % от 230 В</div></div><div class=\"e-step\"><div class=\"e-sech\"><small>06</small><h3>Подберите марку кабеля</h3></div><p>Для жилых и общественных зданий чаще используют кабели, которые не поддерживают горение и мало дымят при пожаре. Такие обозначают индексом нг(А)-LS, например ВВГнг(А)-LS. Для скрытой проводки в земле и на улице марку выбирают отдельно.</p></div><div class=\"e-basis\"><b>На чём основаны правила</b><p>Выбор сечения кабеля, защита и допустимые потери напряжения описаны в белорусских технических нормах для электроустановок (серия ТКП 339) и в международной серии IEC 60364, допустимые токи конкретной марки задаёт ГОСТ 31996 на силовые кабели и документация завода. Справочник даёт общий порядок и ориентиры. Проект электроснабжения выполняет проектировщик, а числа в таблице перед публикацией проверит технический специалист.</p></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Калькуляторы дают ориентир для сметы и для разговора с электриком. Они не заменяют проект электроснабжения, который выполняет проектировщик по нормам ТКП 339 и серии IEC 60364. Допустимые токи, пороги срабатывания, нормы освещённости (гигиенический норматив, постановление Минздрава № 82 от 28.06.2012) и коэффициенты перед публикацией проверит технический специалист.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/elec.js?v=3\"></script>"
}

pattern EstCalcTabs(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=10\"><nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\">{{ t.est_tab_elec }}</a></nav>"
}

