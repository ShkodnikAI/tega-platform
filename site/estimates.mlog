width=\"10.5\" height=\"0.0\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"680.2\" y=\"224\" font-size=\"10.5\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><rect x=\"687.5\" y=\"210.0\" width=\"10.5\" height=\"0.0\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"700.0\" y=\"210.0\" width=\"10.5\" height=\"0.0\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"712.5\" y=\"210.0\" width=\"10.5\" height=\"0.0\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><polyline points=\"430.2,166.9 442.8,176.5 455.2,178.9 467.8,178.9 480.2,176.5 492.8,166.9 505.2,126.2 517.8,78.3 530.2,78.3 542.8,90.3 555.2,90.3 567.8,78.3 580.2,66.3 592.8,78.3 605.2,90.3 617.8,90.3 630.2,78.3 642.8,54.4 655.2,42.4 667.8,42.4 680.2,66.3 692.8,102.2 705.2,126.2 717.8,150.1\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/><polyline points=\"430.2,176.0 442.8,176.0 455.2,176.0 467.8,176.0 480.2,176.0 492.8,176.0 505.2,176.0 517.8,176.0 530.2,176.0 542.8,176.0 555.2,175.3 567.8,172.3 580.2,171.6 592.8,173.4 605.2,176.0 617.8,176.0 630.2,176.0 642.8,176.0 655.2,176.0 667.8,176.0 680.2,176.0 692.8,176.0 705.2,176.0 717.8,176.0\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"2.2\" stroke-dasharray=\"5 4\" stroke-linejoin=\"round\"/><rect x=\"42\" y=\"238\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"60\" y=\"249\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">выработка</text><line x1=\"150\" y1=\"244\" x2=\"174\" y2=\"244\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><text x=\"180\" y=\"249\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">нагрузка дома</text><line x1=\"300\" y1=\"244\" x2=\"324\" y2=\"244\" stroke=\"#e3000f\" stroke-width=\"2.2\" stroke-dasharray=\"5 4\"/><text x=\"330\" y=\"249\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">заряд батареи (высота графика = 10 кВт·ч)</text><text x=\"724\" y=\"249\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">час суток</text></svg><figcaption>Летом выработка с запасом закрывает дневную нагрузку, батарея заряжается к вечеру; зимой солнца едва хватает дому, батарея почти не работает. Расчёт: сценарий «дом 10 кВт + батарея, двухзонный тариф».</figcaption></figure><figure class=\"e-fig\"><svg viewBox=\"0 0 760 256\" role=\"img\" aria-label=\"Из чего складывается стоимость станции\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"160\" y=\"36\" font-size=\"12.5\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">Дом 5 кВт</text><rect x=\"170\" y=\"14\" width=\"143.1\" height=\"34\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"241.6\" y=\"36\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">30%</text><rect x=\"313.1\" y=\"14\" width=\"52.5\" height=\"34\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"339.4\" y=\"36\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">11%</text><rect x=\"365.6\" y=\"14\" width=\"64.4\" height=\"34\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"397.8\" y=\"36\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">14%</text><rect x=\"430.0\" y=\"14\" width=\"89.9\" height=\"34\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"474.9\" y=\"36\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">19%</text><rect x=\"519.8\" y=\"14\" width=\"120.2\" height=\"34\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"579.9\" y=\"36\" font-size=\"11.5\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">26%</text><text x=\"646\" y=\"36\" font-size=\"11.5\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">9 тыс. BYN</text><text x=\"160\" y=\"86\" font-size=\"12.5\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">Дом 10 кВт + АКБ 10</text><rect x=\"170\" y=\"64\" width=\"96.4\" height=\"34\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"218.2\" y=\"86\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">21%</text><rect x=\"266.4\" y=\"64\" width=\"35.3\" height=\"34\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"301.7\" y=\"64\" width=\"77.5\" height=\"34\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"340.5\" y=\"86\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">16%</text><rect x=\"379.2\" y=\"64\" width=\"135.7\" height=\"34\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"447.1\" y=\"86\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">29%</text><rect x=\"515.0\" y=\"64\" width=\"51.8\" height=\"34\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"540.8\" y=\"86\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">11%</text><rect x=\"566.7\" y=\"64\" width=\"73.3\" height=\"34\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"603.4\" y=\"86\" font-size=\"11.5\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">16%</text><text x=\"646\" y=\"86\" font-size=\"11.5\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">27 тыс. BYN</text><text x=\"160\" y=\"136\" font-size=\"12.5\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">Кровля + забор + АКБ</text><rect x=\"170\" y=\"114\" width=\"101.3\" height=\"34\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"220.6\" y=\"136\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">22%</text><rect x=\"271.3\" y=\"114\" width=\"50.7\" height=\"34\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"296.6\" y=\"136\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">11%</text><rect x=\"321.9\" y=\"114\" width=\"95.0\" height=\"34\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"369.4\" y=\"136\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">20%</text><rect x=\"416.9\" y=\"114\" width=\"110.9\" height=\"34\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"472.4\" y=\"136\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">24%</text><rect x=\"527.9\" y=\"114\" width=\"38.7\" height=\"34\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"547.2\" y=\"136\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">8%</text><rect x=\"566.6\" y=\"114\" width=\"73.4\" height=\"34\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"603.3\" y=\"136\" font-size=\"11.5\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">16%</text><text x=\"646\" y=\"136\" font-size=\"11.5\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">33 тыс. BYN</text><text x=\"160\" y=\"186\" font-size=\"12.5\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">Хозяйство 30 кВт</text><rect x=\"170\" y=\"164\" width=\"175.3\" height=\"34\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"257.7\" y=\"186\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">37%</text><rect x=\"345.3\" y=\"164\" width=\"64.3\" height=\"34\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"377.5\" y=\"186\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">14%</text><rect x=\"409.6\" y=\"164\" width=\"78.8\" height=\"34\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"449.0\" y=\"186\" font-size=\"11.5\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">17%</text><rect x=\"488.4\" y=\"164\" width=\"27.5\" height=\"34\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"516.0\" y=\"164\" width=\"124.0\" height=\"34\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"578.0\" y=\"186\" font-size=\"11.5\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">26%</text><text x=\"646\" y=\"186\" font-size=\"11.5\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">44 тыс. BYN</text><rect x=\"10\" y=\"232\" width=\"11\" height=\"11\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"26\" y=\"242\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Модули</text><rect x=\"74.0\" y=\"232\" width=\"11\" height=\"11\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"90.0\" y=\"242\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Крепление и каркас</text><rect x=\"210.0\" y=\"232\" width=\"11\" height=\"11\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"226.0\" y=\"242\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Инвертор</text><rect x=\"286.0\" y=\"232\" width=\"11\" height=\"11\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"302.0\" y=\"242\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Батарея</text><rect x=\"356.0\" y=\"232\" width=\"11\" height=\"11\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"372.0\" y=\"242\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Защиты и учёт</text><rect x=\"462.0\" y=\"232\" width=\"11\" height=\"11\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"478.0\" y=\"242\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Монтаж и проект</text></svg><figcaption>Батарея в гибридной системе съедает до трети бюджета: её ставят под резерв или зонный тариф, а не «чтобы была».</figcaption></figure><ul class=\"e-ul\"><li><b>Сеть и излишки.</b> Продать солнце в сеть не бизнес: в домашних сценариях 40–70 % выработки уходит по низкой цене. Каждый процент самопотребления ускоряет окупаемость сильнее, чем лишний киловатт панелей.</li><li><b>Профиль решает.</b> Тот же дом 5 кВт окупается за 9,9 лет при вечернем профиле и за 8,9 при профиле «днём дома»: сдвиг стирки, бойлера и зарядки электромобиля на 10–15 часов даёт больше, чем батарея.</li><li><b>Дневное хозяйство</b> окупается быстрее всего (СТО, ферма, пекарня, мастерская): нагрузка совпадает с выработкой, самопотребление 70 %. Для юрлиц тариф выше: введите поправку в калькуляторе.</li><li><b>Тариф.</b> Рост тарифа главный фактор неопределённости: на странице «Окупаемость» есть таблица окупаемости при росте 0–12 % и затратах ±20 %.</li></ul><div class=\"e-basis\"><b>Какая мощность оправдана</b><p>Ориентир для РБ: мощность в кВтп примерно равна годовому потреблению в МВт·ч, делённому на 1,1. Для дома 6 МВт·ч это около 5,5 кВтп; больше только при осознанной продаже по низкой цене. Смысла нет при потреблении меньше 3 МВт·ч в год, постоянной тени на скатах, ориентации «только на продажу» и батарее без аварий и зонного тарифа.</p></div></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Типичные ошибки: 12 способов закопать солнце в землю</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. Крыша «на глаз», без аудита тени</h4><p class=\"x\">✗ Труба и дерево срезают 20–40 % строки: MPPT тянет всех вниз.</p><p class=\"v\">✓ Аудит тени по солнцестояниям (декабрь важнее), разбивка на MPPT, оптимизаторы на проблемных модулях.</p></div><div class=\"e-err\"><h4>2. Модули вплотную к покрытию</h4><p class=\"x\">✗ Плюс 15–20 °C к температуре ячейки: потеря 2–3 % за год и старение.</p><p class=\"v\">✓ Вентзазор 80–120 мм, проходки по кровельным нормам.</p></div><div class=\"e-err\"><h4>3. Забор на лёгких столбах</h4><p class=\"x\">✗ Парусность вертикали: ураган кладёт секции вместе с модулями.</p><p class=\"v\">✓ Расчёт ветровой нагрузки, бетонирование, диагональные связи; учтён снеговой район.</p></div><div class=\"e-err\"><h4>4. Инвертор «по мощности панелей»</h4><p class=\"x\">✗ Клиппинг пиков и работа на пределе летом.</p><p class=\"v\">✓ DC/AC 1,2–1,4 (восток–запад до 1,6); запас по току строки под модули 550 Вт и выше.</p></div><div class=\"e-err\"><h4>5. Строка считалась по лету</h4><p class=\"x\">✗ На морозе −25 °C Voc растёт на 12 %: строка пробивает лимит инвертора, гарантия не признаётся.</p><p class=\"v\">✓ Расчёт Voc по минимальной температуре; калькулятор делает это за вас.</p></div><div class=\"e-err\"><h4>6. Юг и восток–запад в один MPPT</h4><p class=\"x\">✗ Несовпадение кривых: −10…−25 % выработки массива.</p><p class=\"v\">✓ Раздельные трекеры или оптимизаторы; забор и крыша на разные входы.</p></div><div class=\"e-err\"><h4>7. Батарея «для выгоды» без зон и аварий</h4><p class=\"x\">✗ Окупаемость 15+ лет, деградация идёт без работы.</p><p class=\"v\">✓ Батарея под задачу: резерв, арбитраж, I категория; иначе начать без неё.</p></div><div class=\"e-err\"><h4>8. Без УЗИП на DC-стороне</h4><p class=\"x\">✗ Гроза выжигает инвертор и строки: ремонт дороже всей защиты.</p><p class=\"v\">✓ УЗИП II на DC и AC, заземление и уравнивание потенциалов по проекту.</p></div><div class=\"e-err\"><h4>9. Нет выключателя для пожарных</h4><p class=\"x\">✗ Крыша под напряжением при тушении: риск для людей.</p><p class=\"v\">✓ Видимый DC-разъединитель, маркировка трасс, rapid shutdown где применимо.</p></div><div class=\"e-err\"><h4>10. Всё в сеть по низкому тарифу</h4><p class=\"x\">✗ Продажа в 2–3 раза дешевле самопотребления.</p><p class=\"v\">✓ Сдвиг нагрузки на день (бойлер, стирка, EV), батарея под вечерний пик, меньше мощность.</p></div><div class=\"e-err\"><h4>11. Разные модули в одной строке, монтаж «ногами»</h4><p class=\"x\">✗ Разброс токов греет и режет выработку; микротрещины.</p><p class=\"v\">✓ Один тип и партия на строку; монтаж по регламенту производителя.</p></div><div class=\"e-err\"><h4>12. «Снег сам сойдёт»</h4><p class=\"x\">✗ Кромка без просвета: сугроб держит нижний ряд до апреля; без мониторинга деградация и грязь годами незаметны.</p><p class=\"v\">✓ Просвет под модулями, угол и раскладка под самоочистку; постринговый мониторинг, регламент осмотра.</p></div></div></div><div class=\"e-art\" id=\"art8\"><div class=\"e-sech\"><small>8</small><h3>Выводы, чек-лист и вопросы подрядчику</h3></div><h4 class=\"e-h4\">Вопросы подрядчику до договора</h4><ul class=\"e-ul\"><li>Где расчёт выработки по ориентациям и тени (почасовой, а не «1 кВт = 1 МВт·ч»)?</li><li>Какие MPPT за какими массивами, какой DC/AC, что происходит с клиппингом и Voc на морозе?</li><li>Сценарии EMS: самопотребление, пик 17–22, резервный заряд показаны в предложении?</li><li>Защиты: УЗИП DC и AC, заземление, выключатель для пожарных в спецификации?</li><li>Гарантии на модули, инвертор, монтаж; кто сервис и где склад запчастей?</li><li>Кто оформит подключение микрогенерации, счётчик и договор выкупа, какие условия действуют сегодня?</li></ul><h4 class=\"e-h4\">Красные флаги</h4><ul class=\"e-ul\"><li>«Поставим максимально, всё равно днём всё работает».</li><li>Батарея «для экономии» без зонного тарифа и расчёта циклов.</li><li>Один MPPT на три ориентации.</li><li>В смете нет УЗИП и заземления.</li><li>Инвертор без сертификата для приёмки микрогенерации.</li><li>Гарантия «от нас» без официального сервиса бренда.</li></ul><h4 class=\"e-h4\">Чек-лист покупателя</h4><ul class=\"e-ul\"><li>Выписать потребление за 12 месяцев по квитанциям и разложить на день, вечер, ночь.</li><li>Проверить тень крыши и периметра в декабре (например, в ShadeMap на 21 декабря): солнце низко, тени вдвое длиннее.</li><li>Уточнить у энергоснабжающей организации порядок подключения и цену выкупа.</li><li>Попросить проект с морозной поправкой Voc и расчётом снеговой и ветровой нагрузки.</li><li>Брать гибрид-совместимый инвертор с портом АКБ, даже если батарею ставить «потом».</li><li>Батарея LFP с 6000+ циклов; для холодного помещения с подогревом или Na-ion.</li><li>В смете должны быть: замена инвертора и батареи в горизонте 12–13 лет, обслуживание, страхование монтажа.</li><li>Сравнить минимум два бренда инверторов по наличию сервиса в РБ, а не по КПД из даташита.</li></ul><h4 class=\"e-h4\">Пять тезисов</h4><ul class=\"e-ul\"><li>Считайте от потребления и тарифа: самопотреблённый кВт·ч в 2–3 раза ценнее проданного.</li><li>Кровля даёт количество, забор стабильность; вертикаль на юг зимой в 1,7–1,8 раза выше кровли, но летом на треть ниже.</li><li>Гибрид с LFP оправдан резервом и профилем, а не «экономией вообще»; ионистор буфер пиков, а не склад энергии.</li><li>Мощность ≈ потребление, МВт·ч / 1,1; сверх лимита микрогенерации частному дому смысла нет.</li><li>Деньги теряются в мелочах: тень, вентзазор, MPPT, Voc на морозе, УЗИП, мониторинг. Чек-лист приёмки важнее бренда модуля.</li></ul><div class=\"e-basis\"><b>Источники и ограничения</b><p>Закон Республики Беларусь от 27.12.2010 № 204-З «О возобновляемых источниках энергии»; постановление Совмина от 25.02.2026 № 93 (тарифы для населения); Белэнерго и энергоснабжающие организации (условия подключения и выкупа); данные БГУ по солнечной радиации Беларуси; SolarPower Europe и IEA PVPS 2025–26; паспорта производителей. Расчёты оценочные (Минск, типовой год), не проект и не оферта: цены, тарифы и курс меняют ответ сильнее всего, проверяйте на дату проекта.</p></div></div></section><section class=\"e-panel\" id=\"sgcalc\" data-panel=\"sgcalc\"><div class=\"e-sech\"><small>02</small><h2>Расчёт системы</h2></div><p class=\"e-lead2\">Задайте потребление, тариф и массивы модулей. Калькулятор посчитает выработку по часам для Минска, режим батареи, оборудование и окупаемость.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f wide\"><label for=\"sg-preset\">Готовый пример</label><div class=\"e-in\"><select id=\"sg-preset\"><option value=\"\" selected>Свои данные</option><option value=\"p5\">Дом: 5 кВт, вечерний профиль, без батареи</option><option value=\"p10\">Дом: 10 кВт + батарея 10 кВт·ч, двухзонный тариф</option><option value=\"pfence\">Дом: кровля 6,6 кВтп + забор 5,8 кВтп + батарея</option><option value=\"p30\">Хозяйство: 30 кВт днём (юрлицо)</option></select></div></div><div class=\"e-f\"><label for=\"sg-load\">Потребление за год</label><div class=\"e-in\"><input id=\"sg-load\" inputmode=\"decimal\" autocomplete=\"off\" value=\"6000\"><span class=\"u\">кВт·ч</span></div></div><div class=\"e-f wide\"><label for=\"sg-profile\">Профиль нагрузки по часам</label><div class=\"e-in\"><select id=\"sg-profile\"><option value=\"evening\" selected>Вечерний дом (работа вне дома)</option><option value=\"home\">Дом днём (удалёнка, семья дома)</option><option value=\"day\">Дневное хозяйство (СТО, ферма, мастерская)</option><option value=\"flat\">Ровная нагрузка (котельная, насосы)</option></select></div></div><div class=\"e-f wide\"><label for=\"sg-season\">Сезонность потребления</label><div class=\"e-in\"><select id=\"sg-season\"><option value=\"usual\" selected>Обычный дом (зимой немного больше)</option><option value=\"heat\">Электроотопление или тепловой насос</option><option value=\"flat\">Ровно по году</option></select></div></div><div class=\"e-f\"><label for=\"sg-shift\">Сдвиг вечерней нагрузки на день</label><div class=\"e-in\"><input id=\"sg-shift\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">%</span></div></div><fieldset class=\"e-seg\"><legend>Подключение</legend><label><input type=\"radio\" name=\"sg-ph\" value=\"1\" checked><span>Сеть 1 фаза</span></label><label><input type=\"radio\" name=\"sg-ph\" value=\"3\"><span>Сеть 3 фазы</span></label></fieldset><div class=\"e-f wide\"><label for=\"sg-who\">Заказчик</label><div class=\"e-in\"><select id=\"sg-who\"><option value=\"phys\" selected>Физлицо (микрогенерация до 15 кВт)</option><option value=\"jur\">Юрлицо или ИП</option></select></div></div><div class=\"e-f wide\"><label for=\"sg-tariff\">Тариф для населения с 01.03.2026</label><div class=\"e-in\"><select id=\"sg-tariff\"><option value=\"a\" selected>Электроплита, без газа (0,2581 BYN)</option><option value=\"b\">Остальные случаи (0,3037 BYN)</option></select></div></div><fieldset class=\"e-seg\"><legend>Схема учёта</legend><label><input type=\"radio\" name=\"sg-scheme\" value=\"one\" checked><span>Одноставочный</span></label><label><input type=\"radio\" name=\"sg-scheme\" value=\"two\"><span>Двухзонный</span></label><label><input type=\"radio\" name=\"sg-scheme\" value=\"three\"><span>Трёхзонный</span></label></fieldset><div class=\"e-f\"><label for=\"sg-tk\">Поправка к тарифу (для юрлиц)</label><div class=\"e-in\"><input id=\"sg-tk\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">%</span></div></div><div class=\"e-f\"><label for=\"sg-buy\">Цена выкупа излишков</label><div class=\"e-in\"><input id=\"sg-buy\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,10\"><span class=\"u\">BYN/кВт·ч</span></div></div><div class=\"e-f\"><label for=\"sg-growth\">Рост тарифа</label><div class=\"e-in\"><input id=\"sg-growth\" inputmode=\"decimal\" autocomplete=\"off\" value=\"6\"><span class=\"u\">% в год</span></div></div><div class=\"e-f\"><label for=\"sg-disc\">Дисконт для NPV</label><div class=\"e-in\"><input id=\"sg-disc\" inputmode=\"decimal\" autocomplete=\"off\" value=\"8\"><span class=\"u\">% в год</span></div></div><p class=\"e-note\"><b>Массив 1 (кровля, юг)</b></p><div class=\"e-f\"><label for=\"sg-a1-n\">Модулей</label><div class=\"e-in\"><input id=\"sg-a1-n\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">шт</span></div></div><div class=\"e-f\"><label for=\"sg-a1-type\">Тип модуля</label><div class=\"e-in\"><select id=\"sg-a1-type\"><option value=\"m550\" selected>TOPCon 550 Вт</option><option value=\"m450\">Моно 450 Вт</option><option value=\"b580\">Bifacial 580 Вт (двусторонний)</option><option value=\"custom\">Свой модуль (данные ниже)</option></select></div></div><div class=\"e-f\"><label for=\"sg-a1-tilt\">Наклон</label><div class=\"e-in\"><input id=\"sg-a1-tilt\" inputmode=\"decimal\" autocomplete=\"off\" value=\"35\"><span class=\"u\">°</span></div></div><div class=\"e-f\"><label for=\"sg-a1-az\">Азимут (0 юг, 90 запад, −90 восток)</label><div class=\"e-in\"><input id=\"sg-a1-az\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">°</span></div></div><div class=\"e-f\"><label for=\"sg-a1-tight\">Монтаж</label><div class=\"e-in\"><select id=\"sg-a1-tight\"><option value=\"0\" selected>С вентзазором</option><option value=\"1\">Плотно к покрытию</option></select></div></div><p class=\"e-note\"><b>Массив 2 (другой скат)</b></p><div class=\"e-f\"><label for=\"sg-a2-n\">Модулей</label><div class=\"e-in\"><input id=\"sg-a2-n\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">шт</span></div></div><div class=\"e-f\"><label for=\"sg-a2-type\">Тип модуля</label><div class=\"e-in\"><select id=\"sg-a2-type\"><option value=\"m550\" selected>TOPCon 550 Вт</option><option value=\"m450\">Моно 450 Вт</option><option value=\"b580\">Bifacial 580 Вт (двусторонний)</option><option value=\"custom\">Свой модуль (данные ниже)</option></select></div></div><div class=\"e-f\"><label for=\"sg-a2-tilt\">Наклон</label><div class=\"e-in\"><input id=\"sg-a2-tilt\" inputmode=\"decimal\" autocomplete=\"off\" value=\"35\"><span class=\"u\">°</span></div></div><div class=\"e-f\"><label for=\"sg-a2-az\">Азимут (0 юг, 90 запад, −90 восток)</label><div class=\"e-in\"><input id=\"sg-a2-az\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">°</span></div></div><div class=\"e-f\"><label for=\"sg-a2-tight\">Монтаж</label><div class=\"e-in\"><select id=\"sg-a2-tight\"><option value=\"0\" selected>С вентзазором</option><option value=\"1\">Плотно к покрытию</option></select></div></div><p class=\"e-note\"><b>Массив 3 (забор или фасад)</b></p><div class=\"e-f\"><label for=\"sg-a3-n\">Модулей</label><div class=\"e-in\"><input id=\"sg-a3-n\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">шт</span></div></div><div class=\"e-f\"><label for=\"sg-a3-type\">Тип модуля</label><div class=\"e-in\"><select id=\"sg-a3-type\"><option value=\"b580\" selected>Bifacial 580 Вт (двусторонний)</option><option value=\"m550\">TOPCon 550 Вт</option><option value=\"m450\">Моно 450 Вт</option><option value=\"custom\">Свой модуль (данные ниже)</option></select></div></div><div class=\"e-f\"><label for=\"sg-a3-tilt\">Наклон</label><div class=\"e-in\"><input id=\"sg-a3-tilt\" inputmode=\"decimal\" autocomplete=\"off\" value=\"90\"><span class=\"u\">°</span></div></div><div class=\"e-f\"><label for=\"sg-a3-az\">Азимут (0 юг, 90 запад, −90 восток)</label><div class=\"e-in\"><input id=\"sg-a3-az\" inputmode=\"decimal\" autocomplete=\"off\" value=\"90\"><span class=\"u\">°</span></div></div><div class=\"e-f\"><label for=\"sg-a3-tight\">Монтаж</label><div class=\"e-in\"><select id=\"sg-a3-tight\"><option value=\"0\" selected>С вентзазором</option><option value=\"1\">Плотно к покрытию</option></select></div></div><div class=\"e-f\"><label for=\"sg-bat\">Накопитель (LFP), 0 если не нужен</label><div class=\"e-in\"><input id=\"sg-bat\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">кВт·ч</span></div></div><div class=\"e-f\"><label for=\"sg-rsv\">Резерв заряда на аварию</label><div class=\"e-in\"><input id=\"sg-rsv\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">%</span></div></div><div class=\"e-f\"><label for=\"sg-crit\">Нагрузка резерва</label><div class=\"e-in\"><input id=\"sg-crit\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"><span class=\"u\">кВт</span></div></div><p class=\"e-note\"><b>Свой модуль.</b> Выберите «Свой модуль» в типе модуля и впишите данные из паспорта (раздел «Электрические характеристики при STC»).</p><div class=\"e-f\"><label for=\"sg-cm-p\">Мощность Pmax</label><div class=\"e-in\"><input id=\"sg-cm-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"600\"><span class=\"u\">Вт</span></div></div><div class=\"e-f\"><label for=\"sg-cm-voc\">Напряжение холостого хода Voc</label><div class=\"e-in\"><input id=\"sg-cm-voc\" inputmode=\"decimal\" autocomplete=\"off\" value=\"51,5\"><span class=\"u\">В</span></div></div><div class=\"e-f\"><label for=\"sg-cm-vmp\">Напряжение Vmp</label><div class=\"e-in\"><input id=\"sg-cm-vmp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"43,2\"><span class=\"u\">В</span></div></div><div class=\"e-f\"><label for=\"sg-cm-isc\">Ток короткого замыкания Isc</label><div class=\"e-in\"><input id=\"sg-cm-isc\" inputmode=\"decimal\" autocomplete=\"off\" value=\"14,9\"><span class=\"u\">А</span></div></div><div class=\"e-f\"><label for=\"sg-cm-imp\">Ток Imp</label><div class=\"e-in\"><input id=\"sg-cm-imp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"13,9\"><span class=\"u\">А</span></div></div><div class=\"e-f\"><label for=\"sg-cm-tp\">Температурный коэффициент Pmax</label><div class=\"e-in\"><input id=\"sg-cm-tp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,30\"><span class=\"u\">%/°С (по модулю)</span></div></div><div class=\"e-f\"><label for=\"sg-cm-tv\">Температурный коэффициент Voc</label><div class=\"e-in\"><input id=\"sg-cm-tv\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,25\"><span class=\"u\">%/°С (по модулю)</span></div></div><div class=\"e-f\"><label for=\"sg-cm-bif\">Коэффициент двусторонности</label><div class=\"e-in\"><input id=\"sg-cm-bif\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">(0 если модуль односторонний, у bifacial 0,6–0,8)</span></div></div><div class=\"e-f\"><label for=\"sg-shade\">Затенение массивов</label><div class=\"e-in\"><input id=\"sg-shade\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">%</span></div></div><p class=\"e-note\">Как оценить тень, смотрите в статье: сервис ShadeMap показывает, где ложится тень на участке в нужный день и час. <a href=\"https://shademap.app\" target=\"_blank\" rel=\"noopener\">shademap.app</a></p><div class=\"e-f\"><label for=\"sg-tmin\">Мин. температура расчётная</label><div class=\"e-in\"><input id=\"sg-tmin\" inputmode=\"decimal\" autocomplete=\"off\" value=\"-25\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"sg-dist\">Кабель DC до инвертора</label><div class=\"e-in\"><input id=\"sg-dist\" inputmode=\"decimal\" autocomplete=\"off\" value=\"15\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"sg-distac\">Кабель AC до щита</label><div class=\"e-in\"><input id=\"sg-distac\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">м</span></div></div><div class=\"e-formula\">E = Σ (P · G<sub>плоскости</sub> · КПД температуры и потерь), по часам типового дня каждого месяца<br>Экономия = Σ (нагрузка − закупка из сети) · тариф зоны + излишки · цена выкупа</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Мощность</span><b id=\"sg-kwp\">—</b></div><div class=\"kv\"><span>Инвертор</span><b id=\"sg-inv\">—</b></div><div class=\"kv\"><span>Выработка за год</span><b id=\"sg-gen\">—</b></div><div class=\"kv\"><span>Удельная</span><b id=\"sg-yield\">—</b></div><div class=\"kv\"><span>Идёт на своё потребление</span><b id=\"sg-self\">—</b></div><div class=\"kv\"><span>Покрывает потребление</span><b id=\"sg-cover\">—</b></div><div class=\"kv\"><span>Уходит в сеть</span><b id=\"sg-exp\">—</b></div><div class=\"kv\"><span>Берётся из сети</span><b id=\"sg-imp\">—</b></div><div class=\"kv\"><span>Экономия за первый год</span><b id=\"sg-sav\">—</b></div><div class=\"kv\"><span>Затраты на систему</span><b id=\"sg-capex\">—</b></div><div class=\"kv\"><span>Окупаемость</span><b id=\"sg-pay\">—</b></div><div class=\"kv\"><span>NPV за 25 лет</span><b id=\"sg-npv\">—</b></div><div class=\"kv\"><span>Вклад батареи</span><b id=\"sg-bw\">—</b></div><div class=\"verdict\" id=\"sg-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"sgyear\" data-panel=\"sgyear\" data-xp=\"1\"><div class=\"e-sech\"><small>03</small><h2>Год по месяцам</h2></div><p class=\"e-lead2\">Выработка, потребление и избыток по месяцам. Тёмная часть столбца идёт на своё потребление, красная уходит в сеть.</p><figure class=\"e-fig\"><div id=\"sg-ch-year\"></div><figcaption>Выработка по месяцам и потребление дома (серая черта). Зимний провал виден по любой конфигурации.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\" id=\"sg-tb-year\"></table></div></section><section class=\"e-panel\" id=\"sgday\" data-panel=\"sgday\" data-xp=\"1\"><div class=\"e-sech\"><small>04</small><h2>Типовые сутки</h2></div><p class=\"e-lead2\">Как за сутки выработка, нагрузка и заряд батареи совпадают по часам. Выберите месяц.</p><div class=\"e-f\"><label for=\"sg-day-m\">Месяц</label><div class=\"e-in\"><select id=\"sg-day-m\"><option value=\"0\">Январь</option><option value=\"1\">Февраль</option><option value=\"2\">Март</option><option value=\"3\">Апрель</option><option value=\"4\">Май</option><option value=\"5\">Июнь</option><option value=\"6\" selected>Июль</option><option value=\"7\">Август</option><option value=\"8\">Сентябрь</option><option value=\"9\">Октябрь</option><option value=\"10\">Ноябрь</option><option value=\"11\">Декабрь</option></select></div></div><figure class=\"e-fig\"><div id=\"sg-ch-day\"></div><figcaption id=\"sg-day-sum\"></figcaption></figure></section><section class=\"e-panel\" id=\"sgbom\" data-panel=\"sgbom\" data-xp=\"1\"><div class=\"e-sech\"><small>05</small><h2>Оборудование</h2></div><p class=\"e-lead2\">Подбор инвертора, схема строк с поправкой на мороз, спецификация и защиты. Цены розничные, их можно заменить на свои.</p><div id=\"sg-bom\"></div><details class=\"e-note\"><summary><b>Цены и курс</b></summary><div class=\"e-row\"><div class=\"e-f\"><label for=\"sg-pr-mod_w\">Модули, USD за Вт</label><div class=\"e-in\"><input id=\"sg-pr-mod_w\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-mount_roof_w\">Крепление на кровле, USD за Вт</label><div class=\"e-in\"><input id=\"sg-pr-mount_roof_w\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-mount_fence_w\">Каркас забора, USD за Вт</label><div class=\"e-in\"><input id=\"sg-pr-mount_fence_w\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-inv_hyb_kw\">Гибридный инвертор, USD за кВт</label><div class=\"e-in\"><input id=\"sg-pr-inv_hyb_kw\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-inv_grid_kw\">Сетевой инвертор, USD за кВт</label><div class=\"e-in\"><input id=\"sg-pr-inv_grid_kw\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-bat_kwh\">Накопитель, USD за кВт·ч</label><div class=\"e-in\"><input id=\"sg-pr-bat_kwh\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-cab_dc_m\">Кабель PV1-F, USD за м</label><div class=\"e-in\"><input id=\"sg-pr-cab_dc_m\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-mc4\">Разъёмы MC4, USD за пару</label><div class=\"e-in\"><input id=\"sg-pr-mc4\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-spd_dc\">УЗИП DC, USD</label><div class=\"e-in\"><input id=\"sg-pr-spd_dc\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-spd_ac\">УЗИП AC, USD</label><div class=\"e-in\"><input id=\"sg-pr-spd_ac\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-dcsw\">DC-разъединитель, USD</label><div class=\"e-in\"><input id=\"sg-pr-dcsw\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-acbrk\">Автомат AC, USD</label><div class=\"e-in\"><input id=\"sg-pr-acbrk\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-rcd\">УЗО, USD</label><div class=\"e-in\"><input id=\"sg-pr-rcd\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-eps_box\">Щит резерва, USD</label><div class=\"e-in\"><input id=\"sg-pr-eps_box\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-meter\">Счётчик двунаправленный, USD</label><div class=\"e-in\"><input id=\"sg-pr-meter\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-logger\">Логгер, USD</label><div class=\"e-in\"><input id=\"sg-pr-logger\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-ground\">Заземление, USD</label><div class=\"e-in\"><input id=\"sg-pr-ground\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-ac_cab_m\">Кабель AC (база 6 мм²), USD за м</label><div class=\"e-in\"><input id=\"sg-pr-ac_cab_m\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-labor_w\">Монтаж и наладка, USD за Вт</label><div class=\"e-in\"><input id=\"sg-pr-labor_w\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-design\">Проект и аудит тени, USD</label><div class=\"e-in\"><input id=\"sg-pr-design\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div><div class=\"e-f\"><label for=\"sg-pr-rate\">Курс, BYN за 1 USD</label><div class=\"e-in\"><input id=\"sg-pr-rate\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"></div></div></div><button class=\"e-btn sm\" id=\"sg-pr-reset\" type=\"button\">Вернуть цены по умолчанию</button></details></section><section class=\"e-panel\" id=\"sgpay\" data-panel=\"sgpay\" data-xp=\"1\"><div class=\"e-sech\"><small>06</small><h2>Окупаемость и подбор мощности</h2></div><p class=\"e-lead2\">Накопленный поток денег за 25 лет, чувствительность к тарифу и затратам, перебор мощности и батареи.</p><figure class=\"e-fig\"><div id=\"sg-ch-cash\"></div><figcaption id=\"sg-cash-note\"></figcaption></figure><h4 class=\"e-h4\">Простая окупаемость при разном росте тарифа и затратах</h4><div class=\"e-scroll\"><table class=\"e-tbl\" id=\"sg-tb-sens\"></table></div><h4 class=\"e-h4\">Подобрать мощность и батарею</h4><button class=\"e-btn\" id=\"sg-opt-btn\" type=\"button\">Перебрать варианты</button><div id=\"sg-opt\"></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Это ориентировочный расчёт для разговора с проектировщиком, а не проект и не коммерческое предложение. Климат взят для Минска (радиация по данным БГУ), типовой год; тарифы для населения с 01.03.2026 по постановлению Совмина № 93. Цена выкупа излишков и лимит мощности микрогенерации зависят от энергоснабжающей организации: проверьте их перед решением. Цены оборудования розничные ориентировочные. Окончательные значения подтверждает проект с аудитом тени, расчётом снеговой и ветровой нагрузки.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/solar-model.js?v=1\"></script><script src=\"/static/solar.js?v=1\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstCondTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Кондиционирование</div><h1>Кондиционирование: расчёт мощности и сезона</h1><p class=\"e-lead\">Тепловая нагрузка по часам жаркого дня для Минска, расход электричества, трасса и шум.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\" class=\"on\" aria-current=\"page\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Кондиционирование\"><a href=\"#acart\" data-sub=\"acart\" class=\"art\">Статья</a><a href=\"#accalc\" data-sub=\"accalc\">Мощность</a><a href=\"#acen\" data-sub=\"acen\">Электричество</a><a href=\"#actr\" data-sub=\"actr\">Трасса</a><a href=\"#acnoise\" data-sub=\"acnoise\">Шум</a></div><div class=\"e-elec\" id=\"e-ac\"><section class=\"e-panel\" id=\"acart\" data-panel=\"acart\"><div class=\"e-sech\"><small>01</small><h2>Кондиционирование: как выбрать и посчитать</h2></div><p class=\"e-lead2\">Мощность, тип блока, трасса, шум и хладагент: что выбрать и где чаще всего ошибаются.</p><div class=\"e-kpis\"><div class=\"e-kpi\"><b>SEER / SCOP</b><span>лето и зима: сколько кВт·ч холода или тепла с 1 кВт·ч электричества</span></div><div class=\"e-kpi\"><b>1 час пика</b><span>мощность считают по самому тяжёлому часу, а не по площади</span></div><div class=\"e-kpi\"><b>40 / 30 дБА</b><span>в жилой комнате днём и ночью, для кондиционера на 5 дБ меньше</span></div><div class=\"e-kpi\"><b>вакуум</b><span>решает срок жизни компрессора, а не бренд</span></div></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 108\" role=\"img\" aria-label=\"Шесть шагов выбора и установки кондиционера\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"6\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"18\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">1</text><text x=\"18\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Теплопритоки</text><text x=\"18\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">по часам, не по площади</text><text x=\"127\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"132\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"144\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">2</text><text x=\"144\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Тип системы</text><text x=\"144\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">куда поставить блок</text><text x=\"253\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"258\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"270\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">3</text><text x=\"270\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Эффективность</text><text x=\"270\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">SEER и SCOP</text><text x=\"379\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"384\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"396\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">4</text><text x=\"396\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Трасса</text><text x=\"396\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">длина, перепад, дренаж</text><text x=\"505\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"510\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"522\" y=\"36\" font-size=\"20\" fill=\"#ffd0d4\" text-anchor=\"start\" font-weight=\"700\">5</text><text x=\"522\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Монтаж</text><text x=\"522\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">вакуум, моменты</text><text x=\"631\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"636\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"648\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">6</text><text x=\"648\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Сервис</text><text x=\"648\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">фильтры, конденсор</text></svg><figcaption>Шесть шагов. Пропущенный первый шаг возвращается на шестом: блок не держит температуру, а счёт за электричество растёт. Красным выделен монтаж: на нём экономят чаще всего и платят компрессором.</figcaption></figure><div class=\"e-basis\"><b>Главный принцип</b><p>Мощность считают по теплопритокам в самый тяжёлый час, а не по площади. Тип системы выбирают по архитектуре: куда поставить внутренний блок и как раздать воздух. Класс эффективности выбирают по сезону: SEER и SCOP считают деньги каждый час работы. Калькулятор слева на этой странице считает первый шаг.</p></div><div class=\"e-art\" id=\"art0\"><div class=\"e-sech\"><small>0</small><h3>Физика и главный миф: кондиционер не даёт свежего воздуха</h3></div><p class=\"e-lead2\">Кондиционер не делает холод и не привозит воздух с улицы: он переносит тепло из комнаты наружу через хладагент. Хладагент кипит при низкой температуре в испарителе внутреннего блока и конденсируется в наружном. Отсюда две цифры качества: SEER (сезонная эффективность охлаждения, кВт·ч холода на 1 кВт·ч электричества) и SCOP (то же зимой в режиме нагрева). Современный инвертор даёт SEER около 6–9 по паспорту, поэтому летом он вытягивает тепло экономно, а в межсезонье работает как тепловой насос «воздух-воздух».</p><p class=\"e-lead2\">Главный миф, который стоит денег: бытовой кондиционер не подаёт свежий воздух и не снижает CO₂. Он гоняет по кругу комнатный воздух. Духота при закрытых окнах «вместо вентиляции» не лечится, а фильтры сплита ловят пыль, но не выдох людей. Свежий воздух даёт приточная вентиляция. В канальных схемах обе системы соединяют подмесом наружного воздуха: это лучший сценарий для дома и офиса, но и самый дорогой в нагрузке (см. раздел 3).</p></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Шесть типов по отдельности: от сплита до VRF</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Тип</th><th>Холод, кВт</th><th>Сильные стороны</th><th>Ограничения</th><th>Куда</th></tr></thead><tbody><tr><td>Настенный сплит</td><td>2–7</td><td>Цена, тишина внутреннего блока, простой монтаж</td><td>Одна комната, не подаёт свежий воздух</td><td>Комнаты квартир и домов</td></tr><tr><td>Мульти-сплит</td><td>4–12, 2–5 зон</td><td>Один наружный блок на несколько комнат</td><td>Зоны зависят от одного блока, трассы длиннее</td><td>Квартиры, где нельзя ставить много наружных блоков</td></tr><tr><td>Канальный</td><td>3,5–25</td><td>Скрытая раздача, подмес свежего воздуха</td><td>Нужен подшивной потолок или техпомещение, проект воздуховодов</td><td>Дома с приточной вентиляцией, офисы</td></tr><tr><td>Кассетный</td><td>3,5–14</td><td>Четыре потока, ровное поле температуры, ячейка 600×600</td><td>Нужна высота подшивного потолка по паспорту, виден диффузор</td><td>Опенспейсы, залы, магазины</td></tr><tr><td>Напольно-потолочный</td><td>3,5–17</td><td>Нет ниш и потолков: поток вдоль перекрытия</td><td>Виден блок, шумнее настенного</td><td>Серверные, магазины, панорамное остекление</td></tr><tr><td>VRF и мини-VRF</td><td>8–100 и больше</td><td>Единая система, диспетчеризация, учёт по зонам</td><td>Цена, проект обязателен</td><td>Административные и коммерческие здания</td></tr></tbody></table></div><p class=\"e-note\">Диапазоны мощности ориентировочные: берите их из каталога конкретной серии.</p><div class=\"e-basis\"><b>Что происходит на рынке</b><p>Хладагенты. По странице Еврокомиссии с 01.01.2025 в ЕС запрещены одиночные сплиты с заправкой менее 3 кг фторсодержащих газов с GWP 750 и выше: хладагент R410A (GWP около 2 000) ушёл, рынок перешёл на R32 (GWP 675) и R290 (пропан, GWP 3). Дальше в ЕС по тем же правилам идут ограничения для типов оборудования и систем до 12 кВт с GWP 150 и выше в 2027 и 2029 годах, а для сплитов до 12 кВт запрет любых F-газов с 2035 года (с исключениями по требованиям безопасности). Это справка о европейском рынке, а не белорусская норма, но от неё зависит, какие блоки поставляют и чем их будут обслуживать. R32 и R290 горючие: монтаж и ремонт ведут только по инструкции производителя, с учётом предельной заправки на помещение. <a href=\"https://climate.ec.europa.eu/eu-action/fluorinated-greenhouse-gases/climate-friendly-alternatives-f-gases/air-conditioning_en\" target=\"_blank\" rel=\"noopener\">Страница Еврокомиссии о кондиционерах и тепловых насосах</a>.</p></div><p class=\"e-lead2\">Остальные тенденции: холодноклиматные инверторы заявляют нагрев при низких температурах (сколько мощности остаётся при морозе, смотрите в таблице паспорта), HEPA-ступени, датчики CO₂ и PM2.5, внутренние блоки с шумом около 20 дБА, управление по Wi-Fi и расписаниям.</p></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Три типа объектов: квартира, дом, административное здание</h3></div><p class=\"e-lead2\"><b>Квартира.</b> Рабочая схема: настенный сплит или мульти-сплит, по блоку в спальню и гостиную. Наружный блок ставят на фасад или в корзину с соблюдением правил вашего дома и благоустройства: уточните их в управляющей организации. Дренаж не должен литься на прохожих, конденсат отводят. Критичен шум и соседи: наружный блок не ставят под окна спален своей и чужой квартир, внутренний не вешают над изголовьем и рабочим местом: поток важнее красивой стены. Для южного остекления мощность считают по часам, а не по площади (раздел 3).</p><p class=\"e-lead2\"><b>Загородный дом.</b> Лучше всего подходит канальная система с подмесом наружного воздуха или мульти-сплит по спальням плюс отдельный блок в гостиной. Канальный блок прячется в техпомещении или под потолком, раздаёт воздух диффузорами и закрывает главный миф: свежий воздух идёт в том же тракте. Для двух-трёх этажей есть мини-VRF: один наружный блок, учёт по зонам. Зимой инвертор работает как тепловой насос, но пиковые морозы закрывает основной источник тепла (раздел 4).</p><p class=\"e-lead2\"><b>Административное здание.</b> Стандарт: VRF или связка чиллер-фанкойл при больших площадях. Десятки внутренних блоков на один-два наружных, диспетчеризация, графики по датчикам присутствия, учёт энергии по этажам. Обязателен проект с почасовым расчётом теплопритоков (солнце, люди, техника), зонирование по фасадам (солнечная сторона получает свой контур), резерв для критичных зон и шумовые требования к фасаду.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Объект</th><th>Рабочая схема</th><th>Ключевой нюанс</th></tr></thead><tbody><tr><td>Квартира</td><td>Настенный сплит, мульти-сплит</td><td>Фасад и дренаж по правилам дома; шум блока не под окна соседей; мощность с учётом южного остекления</td></tr><tr><td>Загородный дом</td><td>Канальная с подмесом воздуха; мульти-сплит; мини-VRF</td><td>Связка с приточной вентиляцией; зимний режим по паспорту; трассы закладывают до отделки</td></tr><tr><td>Административное здание</td><td>VRF, кассеты и каналы; чиллер-фанкойл</td><td>Почасовой расчёт теплопритоков; зонирование по фасадам; диспетчеризация и учёт; серверные отдельными блоками</td></tr></tbody></table></div></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Расчёт холода: мощность по часам и деньги за сезон</h3></div><p class=\"e-lead2\">Старое правило «100 Вт на м²» годится как первая прикидка для обычной комнаты. Оно ошибается в обе стороны. Спальня с восточным окном по нему «требует» 1,4 кВт, а по расчёту ей нужно около 0,4 кВт. Гостиная с южным окном требует 2,5 кВт по правилу и 3,4 кВт по расчёту. Мансарда в вечерний час даёт 2,4 кВт. Поэтому калькулятор на этой странице считает нагрузку по часам жаркого дня: солнце через окна, тепло через стены и кровлю с запаздыванием, людей, технику, воздух.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 312\" role=\"img\" aria-label=\"Нагрузка на кондиционер по часам в жаркий день для трёх помещений\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"64\" y1=\"36\" x2=\"64\" y2=\"266\" stroke=\"#4a4d55\" stroke-width=\"1\"/><line x1=\"64\" y1=\"266\" x2=\"714\" y2=\"266\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"70\" y=\"28\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">тепловая нагрузка, Вт</text><line x1=\"60\" y1=\"266.0\" x2=\"714\" y2=\"266.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"270.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0</text><line x1=\"60\" y1=\"208.5\" x2=\"714\" y2=\"208.5\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"212.5\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">900</text><line x1=\"60\" y1=\"151.0\" x2=\"714\" y2=\"151.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"155.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">1 800</text><line x1=\"60\" y1=\"93.5\" x2=\"714\" y2=\"93.5\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"97.5\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">2 700</text><line x1=\"60\" y1=\"36.0\" x2=\"714\" y2=\"36.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"40.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">3 600</text><line x1=\"64.0\" y1=\"266\" x2=\"64.0\" y2=\"270\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"64.0\" y=\"284\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><line x1=\"145.25\" y1=\"266\" x2=\"145.25\" y2=\"270\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"145.25\" y=\"284\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">3</text><line x1=\"226.5\" y1=\"266\" x2=\"226.5\" y2=\"270\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"226.5\" y=\"284\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">6</text><line x1=\"307.75\" y1=\"266\" x2=\"307.75\" y2=\"270\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"307.75\" y=\"284\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">9</text><line x1=\"389.0\" y1=\"266\" x2=\"389.0\" y2=\"270\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"389.0\" y=\"284\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">12</text><line x1=\"470.25\" y1=\"266\" x2=\"470.25\" y2=\"270\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"470.25\" y=\"284\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">15</text><line x1=\"551.5\" y1=\"266\" x2=\"551.5\" y2=\"270\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"551.5\" y=\"284\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">18</text><line x1=\"632.75\" y1=\"266\" x2=\"632.75\" y2=\"270\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"632.75\" y=\"284\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">21</text><line x1=\"714.0\" y1=\"266\" x2=\"714.0\" y2=\"270\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"714.0\" y=\"284\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">24</text><text x=\"714\" y=\"300\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">час суток</text><polyline points=\"77.54166666666667,264.59444444444443 104.625,264.59444444444443 131.70833333333334,264.59444444444443 158.79166666666669,264.59444444444443 185.875,264.59444444444443 212.95833333333331,264.59444444444443 240.04166666666666,264.53055555555557 267.125,255.26666666666665 294.20833333333337,192.3361111111111 321.29166666666663,175.2138888888889 348.375,136.5611111111111 375.45833333333337,95.67222222222222 402.5416666666667,65.26111111111112 429.625,50.88611111111112 456.7083333333333,54.27222222222221 483.7916666666667,75.10000000000002 510.875,110.11111111111111 537.9583333333333,150.9361111111111 565.0416666666667,180.51666666666665 592.125,189.90833333333333 619.2083333333333,199.10833333333335 646.2916666666667,207.925 673.375,209.77777777777777 700.4583333333333,264.59444444444443\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"429.6\" cy=\"50.9\" r=\"5\" fill=\"#e3000f\"/><text x=\"419.625\" y=\"42.88611111111112\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"end\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">3 367 Вт, 13:00</text><polyline points=\"77.54166666666667,264.85 104.625,264.85 131.70833333333334,264.85 158.79166666666669,264.85 185.875,264.85 212.95833333333331,264.85 240.04166666666666,264.85 267.125,261.9111111111111 294.20833333333337,256.9916666666667 321.29166666666663,250.92222222222222 348.375,244.91666666666666 375.45833333333337,239.61388888888888 402.5416666666667,235.20555555555555 429.625,230.98888888888888 456.7083333333333,218.59444444444443 483.7916666666667,190.0361111111111 510.875,164.225 537.9583333333333,110.55833333333334 565.0416666666667,110.23888888888891 592.125,126.97777777777779 619.2083333333333,165.69444444444446 646.2916666666667,216.67777777777778 673.375,221.6611111111111 700.4583333333333,225.43055555555554\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"565.0\" cy=\"110.2\" r=\"5\" fill=\"#1d1f23\"/><text x=\"575.0416666666667\" y=\"102.23888888888891\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">2 438 Вт, 18:00</text><polyline points=\"77.54166666666667,243.575 104.625,244.0222222222222 131.70833333333334,244.27777777777777 158.79166666666669,244.46944444444443 185.875,244.46944444444443 212.95833333333331,244.27777777777777 240.04166666666666,237.50555555555556 267.125,243.25555555555556 294.20833333333337,234.69444444444446 321.29166666666663,232.075 348.375,234.24722222222223 375.45833333333337,240.50833333333333 402.5416666666667,249.19722222222222 429.625,255.96944444444443 456.7083333333333,256.4166666666667 483.7916666666667,256.1611111111111 510.875,256.35277777777776 537.9583333333333,256.9916666666667 565.0416666666667,258.0777777777778 592.125,259.6111111111111 619.2083333333333,261.52777777777777 646.2916666666667,263.5083333333333 673.375,242.48888888888888 700.4583333333333,243.0638888888889\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"240.0\" cy=\"237.5\" r=\"5\" fill=\"#7d8089\"/><text x=\"250.04166666666666\" y=\"229.50555555555556\" font-size=\"12\" fill=\"#7d8089\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">446 Вт, 6:00</text><line x1=\"76\" y1=\"12\" x2=\"98\" y2=\"12\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"104\" y=\"16\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Гостиная 25 м², южное окно 8 м²</text><line x1=\"326\" y1=\"12\" x2=\"348\" y2=\"12\" stroke=\"#1d1f23\" stroke-width=\"3\"/><text x=\"354\" y=\"16\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Мансарда 22 м², скат</text><line x1=\"516\" y1=\"12\" x2=\"538\" y2=\"12\" stroke=\"#7d8089\" stroke-width=\"3\"/><text x=\"544\" y=\"16\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Спальня 14 м², окно на восток</text></svg><figcaption>Расчёт по модели калькулятора, Минск, 30 °С днём, ясный день. Пик гостиной с южным окном приходится на 13 часов, пик мансарды на 18, а спальне с восточным окном нужна малая мощность и ночью. «Час пика» у каждого помещения свой, поэтому мощность нельзя взять из таблицы.</figcaption></figure><figure class=\"e-fig\"><svg viewBox=\"0 0 760 246\" role=\"img\" aria-label=\"Из чего складывается нагрузка в час пика\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"198\" y=\"50\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">Гостиная 25 м²</text><rect x=\"210\" y=\"26\" width=\"344.49999999999994\" height=\"36\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"554.5\" y=\"26\" width=\"12.133333333333333\" height=\"36\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"566.6333333333333\" y=\"26\" width=\"56.33333333333333\" height=\"36\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"622.9666666666667\" y=\"26\" width=\"65.0\" height=\"36\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"687.9666666666667\" y=\"26\" width=\"8.522222222222222\" height=\"36\" rx=\"0\" fill=\"#e4e5e8\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"704.4888888888889\" y=\"50\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">3 367 Вт</text><text x=\"210\" y=\"80\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">солнце через окна 71 % нагрузки в час пика</text><text x=\"198\" y=\"112\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">Мансарда 22 м²</text><rect x=\"210\" y=\"88\" width=\"220.99999999999997\" height=\"36\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"431.0\" y=\"88\" width=\"36.977777777777774\" height=\"36\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"467.97777777777776\" y=\"88\" width=\"37.55555555555555\" height=\"36\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"505.5333333333333\" y=\"88\" width=\"50.55555555555555\" height=\"36\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"556.0888888888888\" y=\"88\" width=\"6.21111111111111\" height=\"36\" rx=\"0\" fill=\"#e4e5e8\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"570.3\" y=\"112\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">2 438 Вт</text><text x=\"210\" y=\"142\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">солнце через окна 63 % нагрузки в час пика</text><text x=\"198\" y=\"174\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">Спальня 14 м²</text><rect x=\"210\" y=\"150\" width=\"14.588888888888887\" height=\"36\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"224.58888888888887\" y=\"150\" width=\"0.28888888888888886\" height=\"36\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"224.87777777777777\" y=\"150\" width=\"37.55555555555555\" height=\"36\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"262.43333333333334\" y=\"150\" width=\"11.555555555555554\" height=\"36\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"273.9888888888889\" y=\"150\" width=\"0.4333333333333333\" height=\"36\" rx=\"0\" fill=\"#e4e5e8\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"282.4222222222222\" y=\"174\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">446 Вт</text><text x=\"210\" y=\"204\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">солнце через окна 23 % нагрузки в час пика</text><rect x=\"20\" y=\"222\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#e3000f\" stroke=\"#c6c8cd\" stroke-width=\"0.5\"/><text x=\"38\" y=\"233\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Солнце через окна</text><rect x=\"159.4\" y=\"222\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#7d8089\" stroke=\"#c6c8cd\" stroke-width=\"0.5\"/><text x=\"177.4\" y=\"233\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Стены, кровля, тепло через стекло</text><rect x=\"398.0\" y=\"222\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"#c6c8cd\" stroke-width=\"0.5\"/><text x=\"416.0\" y=\"233\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Люди</text><rect x=\"456.8\" y=\"222\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"#c6c8cd\" stroke-width=\"0.5\"/><text x=\"474.8\" y=\"233\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Техника и свет</text><rect x=\"577.6\" y=\"222\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#e4e5e8\" stroke=\"#c6c8cd\" stroke-width=\"0.5\"/><text x=\"595.6\" y=\"233\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Воздух и щели</text></svg><figcaption>Состав тепловой нагрузки в час пика по тем же трём помещениям. Главный источник тепла в жару это солнце через стекло, а не площадь и не температура на улице. Поэтому «100 Вт на м²» ошибается в обе стороны.</figcaption></figure><p class=\"e-lead2\">Что из этого следует.</p><ul class=\"e-ul\"><li>Час пика у разных помещений разный: южная комната горячая днём, западная и мансарда вечером, восточная утром. Блок выбирают по тому часу, когда он нужен.</li><li>Главный источник тепла почти всегда солнце через окна. Площадь стекла, его тип и защита влияют сильнее, чем площадь комнаты.</li><li>Люди и техника дают заметную постоянную добавку. Человек выделяет около 130 Вт (явное тепло и влага), компьютер, телевизор и плита добавляют сотни ватт.</li><li>Подмес наружного воздуха от приточной вентиляции может прибавить к нагрузке заметную долю: калькулятор учитывает его полем «Свежий воздух».</li><li>Запас берут небольшой: 10–15 % на старение конденсора и жару выше расчётной, а не «возьмём в два раза мощнее».</li></ul><figure class=\"e-fig\"><svg viewBox=\"0 0 760 220\" role=\"img\" aria-label=\"Как защита от солнца меняет пик нагрузки\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"140\" y=\"54\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Без защиты</text><rect x=\"150\" y=\"30\" width=\"439.5805555555556\" height=\"32\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"597.5805555555555\" y=\"52\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">3 367 Вт, блок 5,0 кВт</text><text x=\"140\" y=\"100\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Внутренние жалюзи</text><rect x=\"150\" y=\"76\" width=\"330.69722222222225\" height=\"32\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"488.69722222222225\" y=\"98\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">2 533 Вт, блок 3,5 кВт</text><text x=\"140\" y=\"146\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Плёнка, светлые жалюзи</text><rect x=\"150\" y=\"122\" width=\"283.95833333333337\" height=\"32\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"441.95833333333337\" y=\"144\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">2 175 Вт, блок 2,5 кВт</text><text x=\"140\" y=\"192\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Наружные ставни, ролеты</text><rect x=\"150\" y=\"168\" width=\"206.14722222222224\" height=\"32\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"364.14722222222224\" y=\"190\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">1 579 Вт, блок 2,0 кВт</text></svg><figcaption>Гостиная 25 м² с южным окном 8 м². Защита снаружи окна снимает больше половины пика и может сдвинуть выбор блока на ступень вниз. Внутренние шторы работают хуже: солнце уже попало в помещение.</figcaption></figure><p class=\"e-lead2\">На примере гостиной защита снаружи окна снижает пик с 3 367 до 1 579 Вт, внутренние жалюзи только до 2 533 Вт. Это самый дешёвый способ уменьшить блок и счёт за электричество.</p><div class=\"e-basis\"><b>Что считает модель, а что нет</b><p>Модель считает ясный день по часам для Минска (широта 53,9°, 21 июля): положение солнца, излучение на окна с учётом угла падения, температуру стен и кровли с солнцем, запаздывание и затухание колебаний, людей, технику, воздух. Она не заменяет проект по СН 4.02.03-2019 и не учитывает затенение соседними зданиями, тепловую инерцию мебели и перекрытий, неравномерную раздачу воздуха. Пик по модели лёгкий с запасом: инерция уменьшила бы его.</p></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 210\" role=\"img\" aria-label=\"Электричество летом и цена тепла зимой\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"20\" y=\"24\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Лето: электричество блока 3,5 кВт за сезон</text><text x=\"150\" y=\"66\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">on/off, SEER 5,4</text><rect x=\"156\" y=\"44\" width=\"200.0\" height=\"32\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"364.0\" y=\"59\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">140 кВт·ч</text><text x=\"364.0\" y=\"75\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">43 BYN</text><text x=\"150\" y=\"116\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">инвертор, SEER 7</text><rect x=\"156\" y=\"94\" width=\"154.28571428571428\" height=\"32\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"318.2857142857143\" y=\"109\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">108 кВт·ч</text><text x=\"318.2857142857143\" y=\"125\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">33 BYN</text><text x=\"150\" y=\"166\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">инвертор, SEER 9</text><rect x=\"156\" y=\"144\" width=\"120.0\" height=\"32\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"284.0\" y=\"159\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">84 кВт·ч</text><text x=\"284.0\" y=\"175\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">26 BYN</text><text x=\"400\" y=\"24\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\"></text><text x=\"520\" y=\"24\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Зима: цена 1 кВт·ч тепла, BYN</text><text x=\"520\" y=\"56\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">электрообогрев</text><rect x=\"520\" y=\"62\" width=\"140.0\" height=\"14\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"668.0\" y=\"74\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">0,304</text><text x=\"520\" y=\"96\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">тепловой насос, SCOP 3</text><rect x=\"520\" y=\"102\" width=\"46.666666666666664\" height=\"14\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"574.6666666666666\" y=\"114\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">0,101</text><text x=\"520\" y=\"136\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">тепловой насос, SCOP 4</text><rect x=\"520\" y=\"142\" width=\"35.0\" height=\"14\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"563.0\" y=\"154\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">0,076</text><text x=\"520\" y=\"176\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">тепловой насос, SCOP 5</text><rect x=\"520\" y=\"182\" width=\"28.0\" height=\"14\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"556.0\" y=\"194\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">0,061</text></svg><figcaption>Слева сезон охлаждения блока 3,5 кВт при 216 эквивалентных часах полной нагрузки (допущение: 540 часов работы, загрузка 40 %), справа цена 1 кВт·ч тепла при тарифе 0,3037 BYN. SEER и SCOP берите из паспорта блока и режима работы.</figcaption></figure><p class=\"e-lead2\">Пример сезона: блок 3,5 кВт, 540 часов работы за лето при загрузке 40 %, это 216 часов полной нагрузки. При SEER 7 блок потребит около 108 кВт·ч, это около 33 BYN по тарифу 0,3037 BYN/кВт·ч. Блок on/off с SEER около 5,4 за тот же сезон тратит около 140 кВт·ч, то есть примерно на 30 % больше. Часы и загрузку вы задаёте сами во второй вкладке калькулятора: это допущение, а не норма.</p></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Зима наоборот: кондиционер как тепловой насос</h3></div><p class=\"e-lead2\">Теплопроизводительность инвертора зимой падает с температурой. У холодноклиматных серий производители заявляют работу при низких температурах и таблицу теплоотдачи для каждой температуры, обычные инверторы работают до порядка −15 °C, блок on/off греть на морозе не рассчитан. Смотрите в паспорте таблицу «теплоотдача при −15, −20, −25 °C» и сверяйте её с расчётными потерями дома.</p><ul class=\"e-ul\"><li>Экономика нагрева. Цена 1 кВт·ч тепла равна тарифу, делённому на SCOP. При SCOP 4 и тарифе 0,3037 BYN это около 0,076 BYN против 0,304 BYN у прямого электрообогрева. Сравнивайте со своим источником тепла по его цене, а не по общим словам.</li><li>Зимний пакет. Подогрев поддона и картера компрессора, обогрев дренажа: без них наружный блок обрастает льдом и течёт на фасад. Для серверных нужен низкотемпературный комплект и охлаждение круглый год.</li><li>Дренаж и оттаивание. В режиме нагрева наружный блок сбрасывает конденсат, отвод закладывают в проект, а не «на козырёк соседа».</li><li>Предел смысла. При сильных морозах даже холодная серия теряет мощность: пиковые морозы закрывает основной источник тепла, а кондиционер берёт межсезонье, осень и весну. Калькулятор сверяет потери помещения с теплоотдачей из паспорта.</li></ul><div class=\"e-basis\"><b>Запоминалка</b><p>SEER это лето, SCOP это зима, вакуум это жизнь компрессора. Класс эффективности выбирают по сезону, а влага в контуре, оставленная при монтаже «продувкой», съедает компрессор за несколько лет.</p></div></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Монтаж: трасса, вакуум, дренаж, электрика, шум</h3></div><p class=\"e-lead2\">Значения ниже это практика монтажа. Точные цифры берите в монтажной инструкции производителя конкретной серии.</p><ul class=\"e-ul\"><li><b>Трасса.</b> Длину и перепад высот ограничивает паспорт (у настенных сплитов обычно порядка 15–25 м и 5–10 м). Сверх заводской длины нужна дозаправка по паспорту, обычно 10–30 г на метр, по весам и манометру, а не на глаз. Медь только холодильная, в изоляции по всей длине, без пережимов, изгибы пружиной с радиусом не меньше трёх-четырёх диаметров.</li><li><b>Вакуумирование обязательно.</b> Вакуумный насос и манометрический коллектор, вакуум до уровня по инструкции (на практике около 1 торр и ниже) и выдержка под вакуумом с контролем натекания. «Продувка своим хладагентом» выталкивает фреон, но оставляет влагу и воздух: кислота и нагар убивают компрессор.</li><li><b>Вальцовка и моменты.</b> Динамометрический ключ по таблице производителя: пережим даёт микротрещину и утечку через сезон. Течеискатель или мыльный тест на всех соединениях до закрытия трассы.</li><li><b>Дренаж.</b> Уклон по всей длине, практика около 1–2 %, без контруклонов и колен-ловушек, при сбросе в канализацию гидрозатвор, зимой обогрев линии или отвод в тёплую зону. Проверка проливом при сдаче.</li><li><b>Электрика.</b> Отдельная линия с автоматом по паспорту и УЗО. Для блока 2,5–3,5 кВт часто достаточно автомата на 16 А и кабеля 3×2,5 мм², но номинал и сечение определяют по паспорту и проверяют расчётом (калькулятор электрики этого же раздела). Межблочный кабель по схеме производителя, не «телефонкой».</li><li><b>Наружный блок.</b> Свободный выброс воздуха без ниши и решётки, зазоры по паспорту, виброопоры, доступ для сервиса, защита от снега и льда, отвод конденсата.</li></ul><p class=\"e-lead2\"><b>Шум.</b> Нормы здесь простые, но в исходном тексте они были перепутаны. По постановлению Минздрава № 115 от 2011 года в жилых комнатах допускается 40 дБА днём и 30 дБА ночью, а на территории у жилых домов 55 дБА днём и 45 дБА ночью. Для оборудования кондиционирования допустимый уровень снижается на 5 дБ: в комнате получается 35 и 25 дБА, у дома 50 и 40 дБА. Звуковая мощность блока из паспорта не равна давлению у окна: с расстоянием шум падает, а стена и угол его прибавляют. Это считает вкладка «Шум». <a href=\"https://minzdrav.gov.by/upload/dadvfiles/Документы/Постановления/2011/Pos_115_2011.doc\" target=\"_blank\" rel=\"noopener\">Постановление Минздрава № 115 от 2011 года</a>.</p><div class=\"e-basis\"><b>Что остаётся на руках после монтажа</b><p>Паспорт и гарантия с датой пуска; протокол вакуумирования и опрессовки; схема трассы с длинами и количеством дозаправленного хладагента; акт проверки дренажа проливом; замеры шума при первом пуске; инструкция по фильтрам и сезонному обслуживанию. Без протокола вакуума длинная гарантия остаётся бумагой.</p></div></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Типичные ошибки: 12 способов превратить комфорт в ремонт</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. Мощность по площади</h4><p class=\"x\">✗ Южное остекление, люди и техника добавляют нагрузку, блок работает на пределе и не держит температуру.</p><p class=\"v\">✓ Расчёт по теплопритокам, запас 10–15 %.</p></div><div class=\"e-err\"><h4>2. Продувка вместо вакуума</h4><p class=\"x\">✗ Влага и воздух в контуре: кислота, нагар, ремонт компрессора через несколько лет.</p><p class=\"v\">✓ Вакуумный насос и манометр, выдержка, протокол в сдачу.</p></div><div class=\"e-err\"><h4>3. Дренаж без уклона или в открытый лоток</h4><p class=\"x\">✗ Лужи на фасаде, запах из канализации в комнате, зимой лёд.</p><p class=\"v\">✓ Уклон, гидрозатвор при сбросе в канализацию, обогрев линии.</p></div><div class=\"e-err\"><h4>4. Трасса длиннее заводской «как есть»</h4><p class=\"x\">✗ Недозаправка: холода меньше, компрессор перегревается.</p><p class=\"v\">✓ Дозаправка по паспорту, весы и манометр, длина зафиксирована в схеме.</p></div><div class=\"e-err\"><h4>5. Наружный блок в нише или за решёткой</h4><p class=\"x\">✗ Рециркуляция горячего воздуха, аварийный останов в жару.</p><p class=\"v\">✓ Свободный выброс, проверка летом.</p></div><div class=\"e-err\"><h4>6. Блок над изголовьем и над столом</h4><p class=\"x\">✗ Холодный поток на людей, жалобы и простуды.</p><p class=\"v\">✓ Поток вдоль зоны, режимы и дефлекторы без сквозняка.</p></div><div class=\"e-err\"><h4>7. Кондиционер вместо вентиляции</h4><p class=\"x\">✗ CO₂ не снижается, духота остаётся, окна открывают и холод уходит.</p><p class=\"v\">✓ Приточная вентиляция отдельно или канальная схема с подмесом.</p></div><div class=\"e-err\"><h4>8. Нет доступа к наружному блоку</h4><p class=\"x\">✗ Обслуживание дорожает, чистку конденсора откладывают «никогда».</p><p class=\"v\">✓ Площадка или кронштейн с доступом, закладывают при проектировании фасада.</p></div><div class=\"e-err\"><h4>9. Фильтры «раз в год»</h4><p class=\"x\">✗ Забитый испаритель: обмерзание, запах, меньше холода, рост счёта.</p><p class=\"v\">✓ Фильтры по графику сезона, мойка конденсора раз в сезон.</p></div><div class=\"e-err\"><h4>10. Зимний пуск без зимнего комплекта</h4><p class=\"x\">✗ Замёрзший дренаж и лёд на блоке в мороз.</p><p class=\"v\">✓ Подогрев поддона, картера и дренажа, холодная серия для нагрева.</p></div><div class=\"e-err\"><h4>11. Мульти-сплит на весь дом без резерва</h4><p class=\"x\">✗ Отказ одного наружного блока оставляет весь дом без холода.</p><p class=\"v\">✓ Для критичных зон отдельные блоки или VRF с резервом.</p></div><div class=\"e-err\"><h4>12. Блок у окон соседей</h4><p class=\"x\">✗ Шум ночью выше нормы: жалобы, предписания, перенос за свой счёт.</p><p class=\"v\">✓ Размещение по нормам шума, замер до сдачи.</p></div></div></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Вопросы подрядчику, красные флаги, итоги</h3></div><ul class=\"e-ul\"><li>Покажите расчёт теплопритоков по комнатам: остекление, стороны света, люди, техника.</li><li>Какие SEER и SCOP и какой шум внутреннего и наружного блока в рабочей точке, а не «на минимуме»?</li><li>Какая длина трассы и перепад, нужна ли дозаправка? Чем вакуумируете и что пишете в протоколе?</li><li>Куда идёт дренаж и как он защищён зимой, кто отвечает за фасад и отвод конденсата?</li><li>Гарантия и обслуживание: срок, кто обслуживает, есть ли доступ к наружному блоку без альпинистов?</li></ul><div class=\"e-basis\"><b>Красные флаги</b><p>«Возьмём мощнее» без расчёта; монтаж без вакуумного насоса; цена «по факту» без трассы и дренажа; блок «куда скажете» без замера шума у соседних окон; гарантия без регистрации пуска. Любого пункта достаточно, чтобы отказаться.</p></div><p class=\"e-lead2\">Пять тезисов, с которыми можно принимать решение.</p><ul class=\"e-ul\"><li>Кондиционер считают по теплопритокам, а не по площади: остекление, люди и техника решают мощность. Запас 10–15 %, не «вдвое».</li><li>Бытовой сплит не подаёт свежий воздух: духота лечится приточной вентиляцией, а в доме идеальна канальная схема с подмесом.</li><li>Инвертор с высоким SCOP это тепловой насос на межсезонье и умеренные морозы: тепло дешевле прямого электрообогрева в SCOP раз. Пиковые морозы закрывает основной источник тепла.</li><li>Жизнь компрессора определяет монтаж: вакуум, моменты вальцовки, дренаж с уклоном. Протоколы важнее бренда.</li><li>Шум и доступ это юридические риски: наружный блок по нормам шума и с сервисным доступом, иначе перенос и конфликты за свой счёт.</li></ul><p class=\"e-note\">Источники: Регламент (EU) 2024/573 (по странице Еврокомиссии); СН 4.02.03-2019 «Отопление, вентиляция и кондиционирование воздуха»; постановление Минздрава № 115 от 2011 года (шум); постановление Совета Министров № 93 от 25.02.2026 (тарифы); паспорта производителей. Расчёты сезона оценочные, не оферта.</p></div></section><section class=\"e-panel\" id=\"accalc\" data-panel=\"accalc\"><div class=\"e-sech\"><small>02</small><h2>Мощность кондиционера</h2></div><p class=\"e-lead2\">Опишите помещение: расчёт пройдёт по часам жаркого дня в Минске (ясное небо) и найдёт час пика. Номинал подбирается из ряда блоков 2,0–16 кВт.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f wide\"><label for=\"ac-preset\">Готовый пример</label><div class=\"e-in\"><select id=\"ac-preset\"><option value=\"\" selected>Свои данные</option><option value=\"sleep\">Спальня 14 м², окно на восток</option><option value=\"south\">Гостиная 25 м², большое южное окно</option><option value=\"attic\">Мансарда 22 м² под скатом</option><option value=\"office\">Офис 30 м², 4 человека</option><option value=\"server\">Серверная 12 м², 2,5 кВт техники</option></select></div></div><div class=\"e-f\"><label for=\"ac-area\">Площадь</label><div class=\"e-in\"><input id=\"ac-area\" inputmode=\"decimal\" autocomplete=\"off\" value=\"25\"><span class=\"u\">м²</span></div></div><div class=\"e-f\"><label for=\"ac-h\">Высота потолка</label><div class=\"e-in\"><input id=\"ac-h\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,7\"><span class=\"u\">м</span></div></div><div class=\"e-f wide\"><label for=\"ac-roof\">Что над помещением</label><div class=\"e-in\"><select id=\"ac-roof\"><option value=\"none\" selected>Выше жилые этажи</option><option value=\"flat\">Плоская утеплённая кровля</option><option value=\"attic\">Холодный чердак</option><option value=\"mans\">Мансарда, утеплённый скат</option></select></div></div><div class=\"e-f wide\"><label for=\"ac-prof\">Когда в помещении люди и работает техника</label><div class=\"e-in\"><select id=\"ac-prof\"><option value=\"day\" selected>Дома весь день (8–23 ч)</option><option value=\"eve\">Вечер и ночь (17–24 ч)</option><option value=\"office\">Офис (9–18 ч)</option><option value=\"sleep\">Спальня (22–7 ч)</option><option value=\"all\">Круглосуточно</option></select></div></div><p class=\"e-note\"><b>Наружные стены и окна: сторона 1</b></p><div class=\"e-f\"><label for=\"ac-f1-az\">Куда смотрит</label><div class=\"e-in\"><select id=\"ac-f1-az\"><option value=\"0\" selected>Юг</option><option value=\"45\">Юго-запад</option><option value=\"90\">Запад</option><option value=\"135\">Северо-запад</option><option value=\"180\">Север</option><option value=\"-135\">Северо-восток</option><option value=\"-90\">Восток</option><option value=\"-45\">Юго-восток</option></select></div></div><div class=\"e-f\"><label for=\"ac-f1-g\">Окна</label><div class=\"e-in\"><input id=\"ac-f1-g\" inputmode=\"decimal\" autocomplete=\"off\" value=\"8\"><span class=\"u\">м²</span></div></div><div class=\"e-f\"><label for=\"ac-f1-w\">Стена без окон</label><div class=\"e-in\"><input id=\"ac-f1-w\" inputmode=\"decimal\" autocomplete=\"off\" value=\"6\"><span class=\"u\">м²</span></div></div><p class=\"e-note\"><b>Сторона 2 (если есть)</b></p><div class=\"e-f\"><label for=\"ac-f2-az\">Куда смотрит</label><div class=\"e-in\"><select id=\"ac-f2-az\"><option value=\"180\" selected>Север</option><option value=\"0\">Юг</option><option value=\"45\">Юго-запад</option><option value=\"90\">Запад</option><option value=\"135\">Северо-запад</option><option value=\"-135\">Северо-восток</option><option value=\"-90\">Восток</option><option value=\"-45\">Юго-восток</option></select></div></div><div class=\"e-f\"><label for=\"ac-f2-g\">Окна</label><div class=\"e-in\"><input id=\"ac-f2-g\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">м²</span></div></div><div class=\"e-f\"><label for=\"ac-f2-w\">Стена без окон</label><div class=\"e-in\"><input id=\"ac-f2-w\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">м²</span></div></div><div class=\"e-f wide\"><label for=\"ac-glass\">Стеклопакет</label><div class=\"e-in\"><select id=\"ac-glass\"><option value=\"d2\" selected>Двухкамерный</option><option value=\"d1\">Однокамерный</option><option value=\"low\">Энергосберегающий (low-e)</option><option value=\"sun\">Солнцезащитный</option></select></div></div><div class=\"e-f wide\"><label for=\"ac-shade\">Защита от солнца</label><div class=\"e-in\"><select id=\"ac-shade\"><option value=\"none\" selected>Нет</option><option value=\"blind\">Внутренние жалюзи или шторы</option><option value=\"film\">Плёнка или светлые жалюзи</option><option value=\"out\">Наружные ставни, маркиза, ролеты</option></select></div></div><div class=\"e-f wide\"><label for=\"ac-wall\">Стены</label><div class=\"e-in\"><select id=\"ac-wall\"><option value=\"new\" selected>Новый дом, утеплённая стена</option><option value=\"brick\">Кирпич или блок без утепления</option><option value=\"panel\">Панельный дом</option><option value=\"frame\">Каркас, дерево</option></select></div></div><div class=\"e-f\"><label for=\"ac-ppl\">Людей</label><div class=\"e-in\"><input id=\"ac-ppl\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">чел</span></div></div><div class=\"e-f\"><label for=\"ac-eq\">Техника</label><div class=\"e-in\"><input id=\"ac-eq\" inputmode=\"decimal\" autocomplete=\"off\" value=\"300\"><span class=\"u\">Вт</span></div></div><div class=\"e-f\"><label for=\"ac-lt\">Освещение</label><div class=\"e-in\"><input id=\"ac-lt\" inputmode=\"decimal\" autocomplete=\"off\" value=\"150\"><span class=\"u\">Вт</span></div></div><div class=\"e-f\"><label for=\"ac-ti\">Температура внутри</label><div class=\"e-in\"><input id=\"ac-ti\" inputmode=\"decimal\" autocomplete=\"off\" value=\"24\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"ac-tmax\">Жаркий день: максимум на улице</label><div class=\"e-in\"><input id=\"ac-tmax\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"ac-sw\">Суточный размах</label><div class=\"e-in\"><input id=\"ac-sw\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"ac-inf\">Воздухообмен через щели</label><div class=\"e-in\"><input id=\"ac-inf\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,3\"><span class=\"u\">1/ч</span></div></div><div class=\"e-f\"><label for=\"ac-fresh\">Свежий воздух</label><div class=\"e-in\"><input id=\"ac-fresh\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">м³/ч на человека</span></div></div><div class=\"e-f\"><label for=\"ac-rsv\">Запас</label><div class=\"e-in\"><input id=\"ac-rsv\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">%</span></div></div><div class=\"e-formula\">Q(час) = Q<sub>солнце через окна</sub> + Q<sub>стены и кровля с запаздыванием</sub> + Q<sub>люди, техника, свет</sub> + Q<sub>воздух</sub><br>Пик = максимум Q по 24 часам, номинал = ближайший блок из ряда не меньше пика с запасом</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Пик нагрузки</span><b id=\"ac-peak\">—</b></div><div class=\"kv\"><span>Час пика</span><b id=\"ac-hour\">—</b></div><div class=\"kv\"><span>Доля явного тепла</span><b id=\"ac-sens\">—</b></div><div class=\"kv\"><span>С запасом</span><b id=\"ac-req\">—</b></div><div class=\"kv\"><span>Подходит блок</span><b id=\"ac-nom\">—</b></div><div class=\"kv\"><span>Правило «100 Вт на м²»</span><b id=\"ac-rule\">—</b></div><div id=\"ac-parts\"></div><div class=\"verdict\" id=\"ac-verdict\" role=\"status\"></div></div></div></div><figure class=\"e-fig\"><div id=\"ac-ch\"></div><figcaption id=\"ac-chn\"></figcaption></figure></section><section class=\"e-panel\" id=\"acen\" data-panel=\"acen\"><div class=\"e-sech\"><small>03</small><h2>Электричество летом и отопление зимой</h2></div><p class=\"e-lead2\">Сколько потребит блок за сезон и во что обходится обогрев тепловым насосом. Часы и коэффициенты вы задаёте сами: это допущения, а не нормы.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f\"><label for=\"ac-q\">Нагрузка (пусто: из первого расчёта)</label><div class=\"e-in\"><input id=\"ac-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">кВт</span></div></div><div class=\"e-f\"><label for=\"ac-seer\">Сезонный SEER блока</label><div class=\"e-in\"><input id=\"ac-seer\" inputmode=\"decimal\" autocomplete=\"off\" value=\"6,5\"></div></div><div class=\"e-f\"><label for=\"ac-eflh\">Эквивалентные часы полной нагрузки за лето</label><div class=\"e-in\"><input id=\"ac-eflh\" inputmode=\"decimal\" autocomplete=\"off\" value=\"250\"><span class=\"u\">ч</span></div></div><div class=\"e-f wide\"><label for=\"ac-tar\">Тариф</label><div class=\"e-in\"><select id=\"ac-tar\"><option value=\"0.3037\" selected>Остальные случаи, 0,3037 BYN/кВт·ч</option><option value=\"0.2581\">Электроплита без газа, 0,2581 BYN/кВт·ч</option><option value=\"0\">Свой (поле ниже)</option></select></div></div><div class=\"e-f\"><label for=\"ac-tar2\">Свой тариф</label><div class=\"e-in\"><input id=\"ac-tar2\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,30\"><span class=\"u\">BYN/кВт·ч</span></div></div><p class=\"e-note\"><b>Зима: обогрев как тепловой насос</b></p><div class=\"e-f\"><label for=\"ac-scop\">Сезонный SCOP</label><div class=\"e-in\"><input id=\"ac-scop\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3,8\"></div></div><div class=\"e-f\"><label for=\"ac-loss\">Потери помещения при расчётной температуре</label><div class=\"e-in\"><input id=\"ac-loss\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1500\"><span class=\"u\">Вт</span></div></div><div class=\"e-f\"><label for=\"ac-tw\">Расчётная зимняя температура</label><div class=\"e-in\"><input id=\"ac-tw\" inputmode=\"decimal\" autocomplete=\"off\" value=\"-25\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"ac-tmin\">Нижний предел работы блока по паспорту</label><div class=\"e-in\"><input id=\"ac-tmin\" inputmode=\"decimal\" autocomplete=\"off\" value=\"-25\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"ac-cap\">Теплоотдача блока при расчётной температуре (паспорт)</label><div class=\"e-in\"><input id=\"ac-cap\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">кВт</span></div></div><div class=\"e-formula\">E = Q · EFLH / SEER, стоимость = E · тариф<br>Тепло: 1 кВт·ч тепла = тариф / SCOP</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Электричество за лето</span><b id=\"ac-e-cool\">—</b></div><div class=\"kv\"><span>Стоимость за сезон</span><b id=\"ac-e-cost\">—</b></div><div class=\"kv\"><span>Против блока SEER 5</span><b id=\"ac-e-vs5\">—</b></div><div class=\"kv\"><span>Против блока SEER 8,5</span><b id=\"ac-e-vs9\">—</b></div><div class=\"kv\"><span>1 кВт·ч тепла от блока</span><b id=\"ac-h-cost\">—</b></div><div class=\"kv\"><span>Экономия против электрообогрева</span><b id=\"ac-h-save\">—</b></div><div class=\"kv\"><span>Покрытие потерь зимой</span><b id=\"ac-h-cov\">—</b></div><div class=\"verdict\" id=\"ac-e-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"actr\" data-panel=\"actr\"><div class=\"e-sech\"><small>04</small><h2>Трасса, автомат и конденсат</h2></div><p class=\"e-lead2\">Дозаправка хладагентом, проверка длины трассы и высоты по паспорту, автомат и количество конденсата.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f\"><label for=\"ac-l\">Длина трассы</label><div class=\"e-in\"><input id=\"ac-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"7\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ac-l0\">Заводская длина без дозаправки</label><div class=\"e-in\"><input id=\"ac-l0\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ac-gm\">Дозаправка по паспорту</label><div class=\"e-in\"><input id=\"ac-gm\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">г/м</span></div></div><div class=\"e-f\"><label for=\"ac-lmax\">Макс. длина по паспорту</label><div class=\"e-in\"><input id=\"ac-lmax\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ac-dh\">Перепад высот блоков</label><div class=\"e-in\"><input id=\"ac-dh\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ac-dhmax\">Макс. перепад по паспорту</label><div class=\"e-in\"><input id=\"ac-dhmax\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ac-cur\">Рабочий ток блока по паспорту</label><div class=\"e-in\"><input id=\"ac-cur\" inputmode=\"decimal\" autocomplete=\"off\" value=\"7\"><span class=\"u\">А</span></div></div><div class=\"e-formula\">Дозаправка = (L − L₀) · г/м<br>Автомат ≥ 1,25 · I, конденсат = Q<sub>влага</sub> / 2,45 МДж/кг</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Дозаправка</span><b id=\"ac-t-add\">—</b></div><div class=\"kv\"><span>Трасса и высота</span><b id=\"ac-t-chk\">—</b></div><div class=\"kv\"><span>Автомат</span><b id=\"ac-t-br\">—</b></div><div class=\"kv\"><span>Конденсат</span><b id=\"ac-t-cond\">—</b></div><div class=\"verdict\" id=\"ac-t-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"acnoise\" data-panel=\"acnoise\"><div class=\"e-sech\"><small>05</small><h2>Шум наружного и внутреннего блока</h2></div><p class=\"e-lead2\">Проверка по паспортным уровням звука и нормам: у дома 55 и 45 дБА, в комнате 40 и 30 дБА, для кондиционеров минус 5 дБ (постановление Минздрава № 115 от 2011 года).</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f\"><label for=\"ac-lo\">Звуковое давление наружного блока на 1 м (паспорт)</label><div class=\"e-in\"><input id=\"ac-lo\" inputmode=\"decimal\" autocomplete=\"off\" value=\"52\"><span class=\"u\">дБА</span></div></div><div class=\"e-f\"><label for=\"ac-d\">Расстояние до окна соседа или своего</label><div class=\"e-in\"><input id=\"ac-d\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ac-pos\">Положение</label><div class=\"e-in\"><select id=\"ac-pos\"><option value=\"0\" selected>На открытой стене</option><option value=\"3\">Рядом со стеной (+3 дБ)</option><option value=\"6\">В углу (+6 дБ)</option></select></div></div><div class=\"e-f\"><label for=\"ac-li\">Звуковое давление внутреннего блока на 1 м</label><div class=\"e-in\"><input id=\"ac-li\" inputmode=\"decimal\" autocomplete=\"off\" value=\"22\"><span class=\"u\">дБА</span></div></div><div class=\"e-f\"><label for=\"ac-di\">Расстояние до головы</label><div class=\"e-in\"><input id=\"ac-di\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2\"><span class=\"u\">м</span></div></div><div class=\"e-formula\">L(r) = L<sub>1 м</sub> − 20·lg(r) + поправка за положение (свободное поле, без учёта отражений)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>У окна</span><b id=\"ac-n-out\">—</b></div><div class=\"kv\"><span>Норма снаружи</span><b id=\"ac-n-lim\">—</b></div><div class=\"kv\"><span>С приоткрытым окном</span><b id=\"ac-n-win\">—</b></div><div class=\"kv\"><span>Внутри</span><b id=\"ac-n-in\">—</b></div><div class=\"kv\"><span>Норма внутри</span><b id=\"ac-n-inlim\">—</b></div><div class=\"verdict\" id=\"ac-n-verdict\" role=\"status\"></div></div></div></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Это ориентировочный расчёт для выбора класса кондиционера и разговора с проектировщиком, а не проект. Модель считает ясный день по часам для Минска (широта 53,9°, 21 июля), солнечное тепло через окна, теплопередачу стен и кровли с запаздыванием, людей, технику и воздух. Эквивалентные часы, SEER и SCOP зависят от блока и привычек: это допущения. Окончательные значения подтверждает проект по СН 4.02.03-2019 и документация производителя.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/ac-model.js?v=2\"></script><script src=\"/static/ac.js?v=2\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstSmartTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Умный дом</div><h1>Умный дом без мифов</h1><p class=\"e-lead\">Архитектуры и протоколы, управление, монтаж и приёмка: что выбрать и как не получить дорогую игрушку.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\" class=\"on\" aria-current=\"page\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-ref\"><div class=\"e-sech\"><small>01</small><h2>Системы, протоколы, цифры</h2></div><div class=\"e-kpis\"><div class=\"e-kpi\"><b>100–300 мс</b><span>отклик локальной сцены, практика; облако 0,5–2 с и зависит от сети</span></div><div class=\"e-kpi\"><b>локально</b><span>критичная логика живёт в доме, облако только для уведомлений</span></div><div class=\"e-kpi\"><b>нейтраль</b><span>в каждом подрозетнике: без неё умные выключатели не встанут</span></div><div class=\"e-kpi\"><b>ИБП</b><span>на хаб, роутер и клапаны: час аварии не должен быть заметен</span></div></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 108\" role=\"img\" aria-label=\"Шесть шагов проекта умного дома\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"6\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"18\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">1</text><text x=\"18\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Сценарии</text><text x=\"18\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">что и когда происходит</text><text x=\"127\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"132\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"144\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">2</text><text x=\"144\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Зоны и архитектура</text><text x=\"144\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">шина или радио</text><text x=\"253\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"258\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"270\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">3</text><text x=\"270\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Протокол</text><text x=\"270\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">и открытость</text><text x=\"379\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"384\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"396\" y=\"36\" font-size=\"20\" fill=\"#ffd0d4\" text-anchor=\"start\" font-weight=\"700\">4</text><text x=\"396\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Электрика</text><text x=\"396\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">нейтраль, кабель, ИБП</text><text x=\"505\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"510\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"522\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">5</text><text x=\"522\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Монтаж</text><text x=\"522\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">и пусконаладка</text><text x=\"631\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"636\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"648\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">6</text><text x=\"648\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Сдача</text><text x=\"648\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">тесты и документы</text></svg><figcaption>Шесть шагов: сценарии раньше железа, архитектура раньше протокола, электрика раньше отделки. Красным выделен шаг, который нельзя исправить дёшево после ремонта.</figcaption></figure><div class=\"e-basis\"><b>Главный принцип</b><p>Сначала сценарии и зоны, потом протокол и устройства. Фраза «хочу умный дом» без списка «что должно происходить и когда» заканчивается витриной гаджетов без пользы. Сценарии диктуют архитектуру: проводную шину закладывают в черновике, беспроводную сеть добавляют в чистовой, а гибрид закрывает и то и другое.</p></div><div class=\"e-art\" id=\"art0\"><div class=\"e-sech\"><small>0</small><h3>Суть: датчик, логика, исполнитель, и три метрики</h3></div><p class=\"e-lead2\">Умный дом это не колонка и не «лампочка из приложения», а замкнутый контур: датчики (движение и присутствие, протечка, CO₂, температура, контакты окон), логика (хаб или контроллер со сценариями) и исполнительные устройства (реле, диммеры, приводы клапанов, клавиатуры климата). Ценность дают три метрики.</p><ul class=\"e-ul\"><li><b>Отклик.</b> Локальная сцена срабатывает за доли секунды (практика 100–300 мс), через облако дольше и с зависимостью от интернета.</li><li><b>Надёжность.</b> Работает ли дом без интернета и электричества час-два: это проверяется на приёмке, а не обещается.</li><li><b>Энергоэффективность.</b> Климат по расписанию и присутствию, свет по присутствию, дежурные режимы. Для умных термостатов есть опубликованные оценки: ENERGY STAR называет в среднем около 8 % экономии на отоплении и охлаждении, исследования производителей дают 10–15 %. Для дома целиком цифру задаёт ваш режим и инженерные системы: считайте по своим счетам, а не по общему проценту.</li></ul><p class=\"e-lead2\">Практичный факт, который экономит бюджет: основную пользу дают немногие сценарии. Климат по расписанию и геозоне, свет по присутствию, защита от протечек, сцены «ушёл», «сон», «кино» и надёжные физические кнопки. Остальное чаще всего гаджеты, которые отключают через месяц.</p></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Разновидности: проводные, беспроводные, гибридные и экосистемы</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Архитектура</th><th>Протоколы</th><th>Плюсы</th><th>Минусы</th><th>Когда</th></tr></thead><tbody><tr><td>Проводная шинная</td><td>KNX, DALI (свет), BACnet и Modbus (инженерные системы)</td><td>Предсказуемая работа, срок жизни десятилетия, не зависит от эфира и облаков</td><td>Закладывается в черновике, цена шины и пусконаладки</td><td>Новые дома, офисы, здания</td></tr><tr><td>Беспроводная mesh</td><td>Zigbee, Z-Wave, Thread (с Matter)</td><td>Монтаж в чистовой, батареи месяцы и годы, сеть самовосстанавливается</td><td>Zigbee и Thread делят 2,4 ГГц с Wi-Fi; лимит устройств на хаб по паспорту</td><td>Квартиры, ретрофит, аренда</td></tr><tr><td>Wi-Fi и Ethernet</td><td>Wi-Fi 2,4 и 5 ГГц, PoE-камеры</td><td>Высокий трафик: камеры, медиа, панели</td><td>Много устройств перегружают эфир, роуминг</td><td>Точечно: камеры, медиа, ТВ</td></tr><tr><td>Гибрид (рабочая схема)</td><td>Шина + mesh-надстройка + мост Matter</td><td>Надёжность ядра и гибкость периферии</td><td>Нужен квалифицированный интегратор</td><td>Дом и административные здания</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Экосистемы и мосты.</b> Потребительские платформы (Apple Home, Google Home, Amazon Alexa, Samsung SmartThings и другие) удобны, но привязывают к своему облаку. Открытые платформы (Home Assistant, openHAB) дают локальную логику и сотни интеграций без привязки к вендору. Связующее звено это Matter, стандарт Connectivity Standards Alliance: устройство с Matter работает сразу в нескольких экосистемах и управляется локально. Matter идёт поверх Wi-Fi, Ethernet и Thread. Thread строит самовосстанавливающуюся mesh-сеть, но выходит в домашнюю сеть через пограничный маршрутизатор (Border Router), который есть во многих хабах и колонках.</p><p class=\"e-note\">Покупка устройств без Matter и открытого протокола это осознанный риск привязки к вендору: если облако закроют, устройство может перестать работать.</p></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Тенденции и что у нас</h3></div><ul class=\"e-ul\"><li><b>Matter и Thread как общий стандарт.</b> Его поддерживают крупные платформы, список сертифицированных устройств растёт. Проверяйте сертификацию конкретной модели.</li><li><b>Local-first и приватность.</b> Сцены работают без интернета, облако остаётся для уведомлений и удалённого доступа, видео хранится дома, где это возможно.</li><li><b>Предиктивные сценарии.</b> Расписания дополняются прогнозом погоды и учётом присутствия: дом готовит климат к приходу.</li><li><b>Энергетическая гибкость.</b> Связка с тепловым насосом, солнечной станцией и зарядкой электромобиля, сдвиг нагрузки на дешёвые часы.</li><li><b>Помощь пожилым.</b> Датчики присутствия и падения, сценарии «тревога»: растущая область, но медицинское оборудование и экстренная связь остаются отдельными системами.</li></ul><div class=\"e-basis\"><b>А в Беларуси?</b><p>Входом в тему обычно становятся датчики протечки, климат и свет на беспроводных протоколах; комплексные объекты (коттеджи, офисы) закладывают проводную шину в черновике и поручают проект интегратору. Для сдвига нагрузки есть двухзонные тарифы для населения (постановление Совмина № 93 от 25.02.2026): для жилья с электроплитой и без газа 0,5162 BYN днём и 0,1807 BYN ночью, для остальных случаев 0,6074 и 0,2126 BYN за кВт·ч. Окупаемость сценариев сдвига зависит от вашей нагрузки: калькулятор «Солнечные системы» этого же раздела считает её по часам.</p></div><p class=\"e-lead2\">Конкретные модели и цены здесь не приводятся: наличие, сертификация и поддержка у производителей меняются, проверяйте их на момент покупки.</p></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Три типа объектов: квартира, дом, административное здание</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 336\" role=\"img\" aria-label=\"Архитектура умного дома: локальный хаб и необязательное облако\" xmlns=\"http://www.w3.org/2000/svg\"><rect stroke-dasharray=\"7 5\" x=\"250\" y=\"8\" width=\"260\" height=\"40\" rx=\"0\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"2\"/><text x=\"380\" y=\"25\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">облако: уведомления, удалённый доступ</text><text x=\"380\" y=\"41\" font-size=\"11\" fill=\"#7d8089\" text-anchor=\"middle\" font-weight=\"400\">необязательный слой</text><line x1=\"380\" y1=\"48\" x2=\"380\" y2=\"96\" stroke=\"#7d8089\" stroke-width=\"2\" stroke-dasharray=\"6 5\"/><text x=\"110\" y=\"82\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Датчики</text><rect x=\"10\" y=\"96\" width=\"200\" height=\"40\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"110\" y=\"121\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">присутствие, движение</text><line x1=\"210\" y1=\"116\" x2=\"290\" y2=\"160.0\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"290,160.0 281.0,159.5 284.8,152.7\" fill=\"#1d1f23\"/><rect x=\"10\" y=\"146\" width=\"200\" height=\"40\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"110\" y=\"171\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">протечка</text><line x1=\"210\" y1=\"166\" x2=\"290\" y2=\"172.5\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"290,172.5 281.6,175.7 282.2,167.9\" fill=\"#1d1f23\"/><rect x=\"10\" y=\"196\" width=\"200\" height=\"40\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"110\" y=\"221\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">CO₂, температура</text><line x1=\"210\" y1=\"216\" x2=\"290\" y2=\"185.0\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"290,185.0 283.9,191.6 281.0,184.3\" fill=\"#1d1f23\"/><rect x=\"10\" y=\"246\" width=\"200\" height=\"40\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"110\" y=\"271\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">окна и двери</text><line x1=\"210\" y1=\"266\" x2=\"290\" y2=\"197.5\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"290,197.5 286.4,205.7 281.3,199.8\" fill=\"#1d1f23\"/><rect x=\"290\" y=\"96\" width=\"180\" height=\"190\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"380\" y=\"128\" font-size=\"15\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Локальный хаб</text><text x=\"380\" y=\"152\" font-size=\"12\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">сценарии и логика</text><text x=\"380\" y=\"170\" font-size=\"12\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">работает без интернета</text><rect x=\"306\" y=\"196\" width=\"148\" height=\"34\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"380\" y=\"218\" font-size=\"12\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">ИБП на хаб и сеть</text><text x=\"380\" y=\"258\" font-size=\"11\" fill=\"#9a9ca3\" text-anchor=\"middle\" font-weight=\"400\">отклик 100–300 мс</text><text x=\"380\" y=\"274\" font-size=\"11\" fill=\"#9a9ca3\" text-anchor=\"middle\" font-weight=\"400\">(ориентир практики)</text><text x=\"650\" y=\"82\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Исполнители</text><rect x=\"550\" y=\"96\" width=\"200\" height=\"40\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"650\" y=\"121\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">свет: реле, диммеры</text><line x1=\"470\" y1=\"160.0\" x2=\"550\" y2=\"116\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"550,116 544.8,123.3 541.0,116.5\" fill=\"#1d1f23\"/><rect x=\"550\" y=\"146\" width=\"200\" height=\"40\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"650\" y=\"171\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">клапаны протечки</text><line x1=\"470\" y1=\"172.5\" x2=\"550\" y2=\"166\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"550,166 542.2,170.6 541.6,162.8\" fill=\"#1d1f23\"/><rect x=\"550\" y=\"196\" width=\"200\" height=\"40\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"650\" y=\"221\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">климат: котёл, тепловой насос</text><line x1=\"470\" y1=\"185.0\" x2=\"550\" y2=\"216\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"550,216 541.0,216.7 543.9,209.4\" fill=\"#1d1f23\"/><rect x=\"550\" y=\"246\" width=\"200\" height=\"40\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"650\" y=\"271\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">кондиционер, вентиляция</text><line x1=\"470\" y1=\"197.5\" x2=\"550\" y2=\"266\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"550,266 541.3,263.7 546.4,257.8\" fill=\"#1d1f23\"/><text x=\"10\" y=\"316\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"700\">Управление:</text><rect x=\"100\" y=\"300\" width=\"122\" height=\"22\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"161.0\" y=\"316\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">кнопки и сцены</text><rect x=\"230\" y=\"300\" width=\"157\" height=\"22\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"308.5\" y=\"316\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">панель и приложение</text><rect x=\"395\" y=\"300\" width=\"59\" height=\"22\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"424.5\" y=\"316\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">голос</text><text x=\"750\" y=\"316\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">первичное, вторичное, третье</text></svg><figcaption>Датчики, хаб и исполнители работают локально. Облако даёт уведомления и удалённый доступ, но выключатели и климат от него не зависят. Питание ядра держит ИБП.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Объект</th><th>Рабочая конфигурация</th><th>Ключевые сценарии и нюансы</th></tr></thead><tbody><tr><td>Квартира</td><td>Беспроводной ретрофит: хаб, датчики (протечка, движение, окна), умные реле в подрозетниках, управление кондиционером</td><td>Сцены «ушёл» и «сон», защита от протечек с клапаном, климат по геозоне, монтаж без штробления за день</td></tr><tr><td>Загородный дом</td><td>Гибрид: шина в черновике и mesh в чистовой; интеграции котла или теплового насоса, кондиционеров и вентиляции, солнечной станции, скважины, охраны и протечек</td><td>Климат по зонам и погоде, свет по присутствию, сценарии «гости» и «отпуск», ИБП на хаб и сеть, трассы шины закладывают до отделки</td></tr><tr><td>Административное здание</td><td>BACnet, KNX, DALI: диспетчеризация климата и света, доступ и учёт, расписания по присутствию и CO₂</td><td>Отчёты по энергии, зонирование по фасадам; связь с пожарной автоматикой только через нормируемые интерфейсы</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Показатели, по которым сравнивают системы.</b> Отклик сцены (локально доли секунды, облако секунды). Ёмкость хаба: берите из паспорта, у радиохабов она ограничена десятками и сотнями устройств, у шин сотни адресов. Автономность: ИБП держит хаб, роутер и радиоканал от десятков минут до нескольких часов в зависимости от ёмкости. Срок батарей датчиков: у Zigbee и Thread обычно месяцы и годы, у Wi-Fi-датчиков меньше. Работа локальной логики без интернета. Стоимость владения: подписки на облако это скрытая строка бюджета.</p></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Управление: интерфейсы, автоматизации, сеть и безопасность</h3></div><ul class=\"e-ul\"><li><b>Иерархия интерфейсов.</b> Физические кнопки и сценарные клавиши первичны (гости, дети, пожилые, «нет сети»), панели и приложение вторичны, голос третий слой для занятых рук. Дом, который управляется только голосом или телефоном, не проходит приёмку.</li><li><b>Типы автоматизаций.</b> Реактивные (датчик, действие), расписания и геозоны, предиктивные (прогноз и привычки). Правило: одна причина, одно предсказуемое действие. Каскады «если-то-если» через год никто не отладит.</li><li><b>Локально или в облаке.</b> Вся критичная логика (климат, протечки, свет, охрана) в локальном хабе, облако для уведомлений и удалённого доступа. Тест приёмки: отключить интернет, дом не должен заметить.</li><li><b>Сеть как инженерная система.</b> Отдельная сеть или VLAN для умных устройств, PoE для камер и точек доступа, покрытие Wi-Fi по плану, а не «роутер в коридоре». Mesh-протоколы разгружают эфир Wi-Fi.</li><li><b>Безопасность и приватность.</b> Обновления прошивок по регламенту, уникальные пароли, смена паролей интегратора при сдаче. Видео и записи голоса о людях могут быть персональными данными: действует Закон от 07.05.2021 № 99-З «О защите персональных данных», в нём есть правила передачи данных за границу. Для офиса и общих зон уточните требования у юриста до выбора облачной камеры.</li></ul><div class=\"e-basis\"><b>Запоминалка «Три Л»</b><p>Локально, Логично, Документировано. Локально: критичная логика живёт дома. Логично: один датчик одно действие, кнопки дублируют голос. Документировано: схемы, пароли и инструкции остаются владельцу, а не интегратору.</p></div></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Нюансы монтажа: черновик, сеть, питание, сдача</h3></div><ul class=\"e-ul\"><li><b>Черновик решает всё.</b> Шинный кабель и резервные линии закладывают до отделки. В подрозетники выключателей тянут нейтраль N: без неё умные реле и диммеры не работают. Датчики присутствия размечают на потолке с питанием или шиной, камеры идут по PoE.</li><li><b>Питание ядра.</b> ИБП на хаб, роутер, радиоканал и клапаны протечки: час автономности превращает аварию в «не заметили». Щит умного дома отдельный, линии маркированы. Сечения и автоматы считайте в калькуляторе электрики этого раздела.</li><li><b>Размещение датчиков.</b> Присутствие: потолок или угол с обзором зоны, а не «над диваном». Протечка: под трапом, мойкой, котлом. CO₂: в зоне дыхания спален и переговорных. Окна и двери: герконы с защитой от ложных срабатываний.</li><li><b>Исполнительные устройства.</b> Реле и диммеры подбирают по нагрузке и типу ламп (диммируются не все LED). Клапаны протечки с возвратом и ручным дублёром. Приводы клапанов тёплых полов и радиаторов совместимы с выбранной шиной.</li><li><b>Пусконаладка и сдача.</b> Прогон всех сцен при заказчике, тест без интернета, тест ИБП, замер отклика. В комплект сдачи входят исполнительные схемы, адреса устройств, пароли администратора, инструкция и обучение. Без этого дом после ухода интегратора превращается в чёрный ящик.</li></ul><div class=\"e-basis\"><b>Чек-лист приёмки умного дома</b><p>1) Сценарии из задания работают без интернета. 2) ИБП держит ядро заявленное время. 3) Кнопки и сцены дублируют приложение и голос. 4) Все датчики в мониторинге, заряд батарей виден. 5) Пароли, схемы и адреса переданы владельцу. 6) Обновление прошивок показано. 7) Подписки и их стоимость прописаны в договоре. Эти пункты закрывают большую часть конфликтов при сдаче.</p></div></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Типичные ошибки: 12 способов получить дорогую игрушку</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. Гаджеты раньше сценариев</h4><p class=\"x\">✗ Коробка устройств без пользы, через месяц их отключают.</p><p class=\"v\">✓ Список «что должно происходить и когда» до сметы.</p></div><div class=\"e-err\"><h4>2. Привязка к вендору без открытого протокола</h4><p class=\"x\">✗ Экосистема закрывается, дом перестаёт работать, переезд это демонтаж.</p><p class=\"v\">✓ Устройства с Matter, Thread или открытой платформой.</p></div><div class=\"e-err\"><h4>3. Вся логика в облаке</h4><p class=\"x\">✗ Интернет пропал: свет, климат и охрана тоже.</p><p class=\"v\">✓ Локальный хаб, облако только для уведомлений и удалённого доступа.</p></div><div class=\"e-err\"><h4>4. Нет нейтрали в подрозетниках</h4><p class=\"x\">✗ Умные выключатели не ставятся без ломки готовой отделки.</p><p class=\"v\">✓ Нейтраль N в каждый подрозетник на этапе электрики.</p></div><div class=\"e-err\"><h4>5. Wi-Fi на все устройства</h4><p class=\"x\">✗ Десятки устройств перегружают эфир: отвалы и перезагрузки.</p><p class=\"v\">✓ Mesh-протоколы для датчиков, Wi-Fi только для камер и медиа.</p></div><div class=\"e-err\"><h4>6. Нет ИБП на ядро</h4><p class=\"x\">✗ Час аварии это час «глупого» дома и закрытые клапаны.</p><p class=\"v\">✓ ИБП на хаб, роутер, радио и приводы, тест при сдаче.</p></div><div class=\"e-err\"><h4>7. Устройства в общей сети с заводскими паролями</h4><p class=\"x\">✗ Камеры и доступы становятся лёгкой целью.</p><p class=\"v\">✓ Отдельная сеть, уникальные пароли, обновления по регламенту, учёт 99-З.</p></div><div class=\"e-err\"><h4>8. Только голос и приложение</h4><p class=\"x\">✗ Гости, дети и пожилые остаются без света при разряженном телефоне.</p><p class=\"v\">✓ Физические кнопки и сцены как первичный интерфейс.</p></div><div class=\"e-err\"><h4>9. Сценарии после ремонта</h4><p class=\"x\">✗ Нет шины и нейтрали: штробление готовой отделки.</p><p class=\"v\">✓ Проектировать вместе с электрикой, до отделки.</p></div><div class=\"e-err\"><h4>10. Нет документации и паролей</h4><p class=\"x\">✗ Интегратор исчез, и дом остаётся чёрным ящиком.</p><p class=\"v\">✓ Схемы, адреса, пароли и инструкция в комплекте сдачи.</p></div><div class=\"e-err\"><h4>11. Датчики без регламента</h4><p class=\"x\">✗ Севшая батарейка это тихая протечка без сигнала.</p><p class=\"v\">✓ Мониторинг батарей, проверка раз в сезон, журнал срабатываний.</p></div><div class=\"e-err\"><h4>12. «Умный дом» вместо пожарной сигнализации</h4><p class=\"x\">✗ Бытовой датчик не заменяет проектируемую пожарную сигнализацию и оповещение.</p><p class=\"v\">✓ Пожарная автоматика проектируется отдельно по нормам, умный дом лишь дублирует уведомления.</p></div></div></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Приоритеты и чек-лист заказчика</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Сегмент</th><th>На что смотреть</th><th>Что проверить в Беларуси</th></tr></thead><tbody><tr><td>Проводные шины</td><td>KNX, DALI-2 для света, BACnet и Modbus для инженерных систем</td><td>Наличие интегратора, проект и пусконаладка обязательны</td></tr><tr><td>Потребительские экосистемы</td><td>Поддержка Matter, работа без облака, региональная доступность</td><td>Доступность сервисов и поддержка в стране на момент покупки</td></tr><tr><td>Открытые платформы</td><td>Локальная работа, число интеграций, сообщество</td><td>Хороший выбор против привязки к вендору, нужен специалист</td></tr><tr><td>Matter и Thread</td><td>Сертификация конкретной модели, наличие Border Router</td><td>Поставки через розницу и маркетплейсы</td></tr><tr><td>Климат и энергия</td><td>Шлюзы Opentherm, Modbus, BACnet к котлам, тепловым насосам, VRF и вентиляции</td><td>Совместимость конкретных моделей по паспорту</td></tr></tbody></table></div><p class=\"e-lead2\">Вопросы подрядчику до договора.</p><ul class=\"e-ul\"><li>Где список сценариев и зон, на который вы даёте цену, и что из него работает локально без интернета?</li><li>Какой протокол и почему: KNX, Zigbee, Thread и Matter? Что произойдёт, если облако вендора закроют?</li><li>Нейтраль и шинный кабель заложены в электрику? Кто и когда их тянет?</li><li>ИБП на ядро: что держит и сколько минут, будет ли тест при сдаче?</li><li>Что передаётся владельцу: схемы, адреса, пароли администратора, инструкции?</li><li>Подписки и облачные сервисы: стоимость в год и что перестанет работать без них?</li></ul><div class=\"e-basis\"><b>Красные флаги</b><p>«Поставим всё на наше облако, так надёжнее»; цена без пусконаладки и обучения; умный дом вместо проекта пожарной автоматики; отказ передать пароли и схемы; Wi-Fi-датчики «на всё»; ни одной физической кнопки в смете. Любого пункта достаточно, чтобы не подписывать договор.</p></div><p class=\"e-lead2\">Пять тезисов, с которыми можно принимать решение.</p><ul class=\"e-ul\"><li>Умный дом начинается со списка сценариев, а не с витрины устройств.</li><li>Локальная логика и открытые протоколы (Matter, Thread, KNX) защищают от закрытия облаков и вендоров; облако оставляют уведомлениям, а не выключателям.</li><li>Экономия измеряется энергией: считайте по своим счетам и тарифу, а не по общим процентам.</li><li>Надёжность живёт в черновике: нейтраль в подрозетниках, шинный кабель до отделки, ИБП на ядро, отдельная сеть для умных устройств.</li><li>Приёмка это документы и тесты: сцены без интернета, ИБП под нагрузкой, пароли и схемы владельцу.</li></ul><p class=\"e-note\">Источники: Закон Республики Беларусь от 07.05.2021 № 99-З «О защите персональных данных»; постановление Совета Министров № 93 от 25.02.2026 (тарифы); ENERGY STAR (умные термостаты); спецификации Matter (CSA); паспорта производителей. Пожарная автоматика проектируется по действующим нормам отдельно от умного дома. Оценки не оферта.</p></div></div><div class=\"e-basis\"><b>Важно знать</b><p>Это справочная статья, а не проект. Цифры отклика и автономности это практика и паспорта производителей, они зависят от оборудования. Пожарная сигнализация, оповещение и электроустановка проектируются отдельно по действующим нормам.</p></div>"
}

pattern EstPriceTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет · Цена работ</div><h1>Из чего состоит цена строительных работ</h1><p class=\"e-lead\">ОХР и ОПР, плановая прибыль, постатейная структура затрат и конкурсный коэффициент: почему цена не растягивается в обе стороны.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/otdelka\">{{ t.est_tab_fin }}</a><a href=\"{{ p }}/raschet-smet/formy\">{{ t.est_tab_forms }}</a><a href=\"{{ p }}/raschet-smet/cenoobrazovanie\" class=\"on\" aria-current=\"page\">{{ t.est_tab_price }}</a></nav><div class=\"e-ref\"><div class=\"e-sech\"><small>01</small><h2>Конструкция цены</h2></div><div class=\"e-kpis\"><div class=\"e-kpi\"><b>67,30 %</b><span>норма ОХР и ОПР для городских строительных работ, по образцу, к зарплате рабочих и машинистов</span></div><div class=\"e-kpi\"><b>61,18 %</b><span>норма плановой прибыли, та же база, по образцу</span></div><div class=\"e-kpi\"><b>k ≥ 0,9</b><span>граница конкурсного коэффициента по образцу: не больше 10 % снижения</span></div><div class=\"e-kpi\"><b>13.02.2026</b><span>дата вступления в силу постановления № 146 с новыми нормами</span></div></div><div class=\"e-basis\"><b>Главное</b><p>Смета это не придуманная цифра, а сумма нормативных слагаемых. Основная часть цены это материалы, зарплата и машины. Накладные расходы (ОХР и ОПР) и плановая прибыль считаются от зарплаты рабочих и машинистов по нормам. На торгах подрядчик может снизить цену, но не ниже границы по конкурсному коэффициенту. Значения норм и границы ниже даны по образцу ООО «Тэга плюс», перед договором сверяйте их с текстом актов.</p></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Как цена собирается слой за слоем</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Слой</th><th>Что это</th><th>Как считается</th><th>Типичная доля, ориентир практики</th></tr></thead><tbody><tr><td>Материалы, изделия, конструкции</td><td>Всё, что остаётся в здании</td><td>расход по нормам × текущие цены республиканской базы</td><td>около 50–60 %</td></tr><tr><td>Зарплата рабочих и машинистов</td><td>Труд на площадке</td><td>человеко-часы 4-го разряда × затраты труда по нормам</td><td>около 10–16 %</td></tr><tr><td>Эксплуатация машин и механизмов</td><td>Техника и вспомогательное</td><td>машино-часы × цена машино-часа</td><td>около 8–12 %</td></tr><tr><td>ОХР и ОПР</td><td>Организация, управление и обслуживание строительства</td><td>норма % от базы (зарплата рабочих и машинистов)</td><td>норма, по образцу 67,30 % от базы</td></tr><tr><td>Плановая прибыль</td><td>Оборотные средства, потребление, налог на прибыль</td><td>норма % от той же базы</td><td>норма, по образцу 61,18 % от базы</td></tr><tr><td>Временные здания, зимнее удорожание, прочее</td><td>Титульные временные здания, зимние, расходы заказчика</td><td>по нормам и смете</td><td>около 3–8 %</td></tr><tr><td>НДС, налоги из выручки, взносы в ФРСО</td><td>По законодательству</td><td>ставка налога, НДС по действующей ставке</td><td>по закону</td></tr><tr><td>Цена заказчика, цена предложения подрядчика</td><td>Итог</td><td>цена предложения = цена заказчика × k</td><td>k по образцу от 0,9 до 1,0</td></tr></tbody></table></div><p class=\"e-note\">Доли по слоям это ориентиры из практики, они сильно зависят от вида работ. Нормы ОХР, ОПР и плановой прибыли зависят от вида работ (строительные, монтажные, специальные, ремонтные и т. д.) и места (город, село), для реконструкции и модернизации (кроме жилищного фонда) к ОХР и ОПР применяется коэффициент 1,1, для текущего ремонта к плановой прибыли 1,115.</p></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>ОХР и ОПР: куда уходит каждый рубль нормы</h3></div><p class=\"e-lead2\">По образцу, норма ОХР и ОПР для городских строительных работ составляет 67,30 % к зарплате рабочих и машинистов. Внутри неё затраты распределены по четырём группам. Постановлением № 146 нормы утверждены с 13.02.2026: по комментариям к нему, в норму для городских работ добавили налог на недвижимость, поэтому она выше прежней. Точные значения для вашего вида работ ищите в приложении 1 к постановлению.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 214\" role=\"img\" aria-label=\"Структура норм общехозяйственных и общепроизводственных расходов\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"20\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Структура норм ОХР и ОПР 67,30 % по четырём группам (доли в норме)</text><rect x=\"20\" y=\"36\" width=\"405.86400000000003\" height=\"54\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"222.93200000000002\" y=\"69\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">А · 56,37 %</text><rect x=\"425.86400000000003\" y=\"36\" width=\"178.632\" height=\"54\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"515.1800000000001\" y=\"69\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Б · 24,81 %</text><rect x=\"604.4960000000001\" y=\"36\" width=\"108.936\" height=\"54\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"658.964\" y=\"69\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">В · 15,13 %</text><rect x=\"713.4320000000001\" y=\"36\" width=\"26.568\" height=\"54\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"734.0000000000001\" y=\"106\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">Г · 3,69 %</text><rect x=\"20\" y=\"121\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"40\" y=\"132\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">А. Административно-хозяйственные: 56,37 % группы, это 37,94 п. п. из 67,30</text><rect x=\"20\" y=\"145\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"40\" y=\"156\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Б. Обслуживание работников: 24,81 % группы, это 16,70 п. п. из 67,30</text><rect x=\"20\" y=\"169\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"40\" y=\"180\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">В. Организация работ на площадках: 15,13 % группы, это 10,18 п. п. из 67,30</text><rect x=\"20\" y=\"193\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"40\" y=\"204\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Г. Прочие накладные: 3,69 % группы, это 2,48 п. п. из 67,30</text></svg><figcaption>Четыре группы затрат внутри нормы ОХР и ОПР. В пересчёте на норму 67,30 % к базе (зарплата рабочих и машинистов): А 37,94 п. п., Б 16,70, В 10,18, Г 2,48. Структура по таблице образца, сверяйте с первоисточником.</figcaption></figure><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Статья нормы</th><th>Доля в норме, %</th></tr></thead><tbody><tr><td>Заработная плата аппарата управления, прорабов, охраны, геодезистов, лаборантов, ППР</td><td>48,68</td></tr><tr><td>Взносы в ФСЗН и страхование от несчастных случаев</td><td>17,04</td></tr><tr><td>Прочие расходы: связь, аудит, налоги, аттестация, страхование, платные дороги</td><td>19,24</td></tr><tr><td>Материалы: ГСМ, спецодежда и СИЗ, канцелярия, моющие средства</td><td>5,52</td></tr><tr><td>Содержание зданий: коммуналка и ремонт помещений</td><td>3,85</td></tr><tr><td>Амортизация основных средств аппарата управления, нематериальных активов, инвентаря, приборов</td><td>3,27</td></tr><tr><td>Тепловая энергия</td><td>1,44</td></tr><tr><td>Транспортные затраты</td><td>0,54</td></tr><tr><td>Электроэнергия</td><td>0,42</td></tr><tr><td>Итого</td><td>100,00</td></tr></tbody></table></div><p class=\"e-note\">Сумма долей 100,00 проверена, структура взята из образца и таблицы Минстройархитектуры в справочной публикации. Сверьте её с первоисточником.</p></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Постатейная структура: четыре группы</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Группа</th><th>Что в ней</th><th>Статьи (доля внутри нормы, %)</th></tr></thead><tbody><tr><td>А. Административно-хозяйственные, 56,37</td><td>Содержание аппарата управления: зарплаты дирекции, прорабов и мастеров с отчислениями, офис, связь, служебные авто и техника</td><td>Зарплата аппарата управления и линейного персонала 35,40; отчисления на соцстрахование АХП 12,39; содержание и эксплуатация зданий 3,13; почта, телеграф, телефон 1,26; вычислительная техника 1,02; служебные разъезды и командировки 0,98; ремонтный фонд ОС аппарата управления 0,95; служебный автотранспорт 0,55; амортизация ОС, износ и ремонт МБП 0,45; канцелярия, типография 0,24</td></tr><tr><td>Б. Обслуживание работников, 24,81</td><td>Выплаты людям сверх расценки: допотпуска и доплаты, санбыт, спецодежда и охрана труда, обучение кадров</td><td>Дополнительная зарплата рабочих основного производства 10,08; охрана труда и техника безопасности 6,63; соцстрахование с дополнительной зарплаты 3,74; санитарно-гигиенические и бытовые условия 2,91; подготовка и переподготовка кадров 1,45</td></tr><tr><td>В. Организация работ на площадках, 15,13</td><td>Сама площадка: нетитульные времянки, инструмент, охрана, геодезия, ППР, лаборатории, благоустройство и сдача</td><td>Малоценные и быстроизнашивающиеся предметы 4,17; амортизация, ремонт, перемещение приспособлений 2,91; ведомственная, пожарная и сторожевая охрана 2,44; временные (нетитульные) сооружения 1,78; подготовка объектов к сдаче 1,17; благоустройство стройплощадок 0,92; производственные лаборатории 0,49; проектирование производства работ (ППР) 0,48; геодезические работы 0,35; рационализация производства 0,31; перебазирование в пределах стройки 0,11</td></tr><tr><td>Г. Прочие накладные, 3,69</td><td>Внешние услуги и платежи: страхование имущества, банки, реклама, аудит, лицензии и торги</td><td>Услуги банков 2,11; реклама, аудит, консультации, информация 0,68; обязательное страхование имущества 0,61; лицензирование, торги и другие расходы 0,29</td></tr></tbody></table></div><p class=\"e-note\">Группа Б в образце содержала опечатку (10,68 вместо 10,08 по первой строке), исправлено так, чтобы сумма группы составляла 24,81.</p></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Конкурсный коэффициент: 0,9 это пол, а не потолок торга</h3></div><p class=\"e-lead2\">Конкурсный коэффициент это рассчитываемый подрядчиком коэффициент, учитывающий компенсацию рисков от непредвиденных обстоятельств и его внутренние конкурентные преимущества. По образцу, на бюджетных объектах цена предложения подрядчика не может быть ниже цены заказчика более чем на 10 %, то есть k находится в пределах от 0,9 до 1,0 (Положение № 1553, часть 2 пункта 8, в редакции постановления Совмина от 15.05.2025 № 266). Действует ли граница для вашей закупки, зависит от вида закупки, источника финансирования и условий конкурса: проверьте по тексту Положения и по конкурсной документации.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 172\" role=\"img\" aria-label=\"Шкала конкурсного коэффициента\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"40\" y=\"60\" width=\"680\" height=\"24\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><rect x=\"584.0\" y=\"60\" width=\"136.0\" height=\"24\" rx=\"0\" fill=\"#dcdde0\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"40\" y=\"60\" width=\"544.0\" height=\"24\" rx=\"0\" fill=\"#fbd5d8\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"40.0\" y1=\"84\" x2=\"40.0\" y2=\"92\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"40.0\" y=\"108\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0,50</text><line x1=\"175.99999999999997\" y1=\"84\" x2=\"175.99999999999997\" y2=\"92\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"175.99999999999997\" y=\"108\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0,60</text><line x1=\"311.99999999999994\" y1=\"84\" x2=\"311.99999999999994\" y2=\"92\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"311.99999999999994\" y=\"108\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0,70</text><line x1=\"448.00000000000006\" y1=\"84\" x2=\"448.00000000000006\" y2=\"92\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"448.00000000000006\" y=\"108\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0,80</text><line x1=\"584.0\" y1=\"84\" x2=\"584.0\" y2=\"92\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"584.0\" y=\"108\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0,90</text><line x1=\"720.0\" y1=\"84\" x2=\"720.0\" y2=\"92\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"720.0\" y=\"108\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">1,00</text><line x1=\"584.0\" y1=\"46\" x2=\"584.0\" y2=\"84\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"584.0\" y=\"40\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"700\">0,90: нижняя граница по образцу</text><circle cx=\"516.0\" cy=\"72\" r=\"6\" fill=\"#1d1f23\"/><text x=\"516.0\" y=\"138\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">k = 0,85: −15 %</text><circle cx=\"380.0\" cy=\"72\" r=\"6\" fill=\"#1d1f23\"/><text x=\"380.0\" y=\"138\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">k = 0,75: −25 %</text><circle cx=\"135.2\" cy=\"72\" r=\"6\" fill=\"#1d1f23\"/><text x=\"135.19999999999993\" y=\"138\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">k = 0,57: −43 %</text><text x=\"651.9999999999999\" y=\"138\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">k = 0,90 … 1,00</text><text x=\"40\" y=\"26\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Конкурсный коэффициент k и снижение цены относительно цены заказчика</text></svg><figcaption>Снижение цены равно 1 − k. Левее красной черты (k ниже 0,9) цена выходит за границу, о которой говорит образец: снижение больше 10 % от цены заказчика.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>k</th><th>Снижение цены</th><th>Что происходит в смете (ориентир практики, не норма)</th></tr></thead><tbody><tr><td>0,90</td><td>−10 %</td><td>Срезается плановая прибыль и часть оборотных средств. Площадка работает штатно, запаса на риски нет.</td></tr><tr><td>0,85</td><td>−15 %</td><td>Под давлением охрана труда: СИЗ, обучение, аттестация рабочих мест. Менее строгий контроль на объекте.</td></tr><tr><td>0,75</td><td>−25 %</td><td>Экономят на охране площадки, лаборатории, геодезии, разработке ППР. Работы ведутся «на глаз».</td></tr><tr><td>0,57</td><td>−43 %</td><td>Цена ниже возможной себестоимости: признак демпинга или доработок заказчиком.</td></tr></tbody></table></div><ul class=\"e-ul\"><li><b>Это требование закона, а не позиция подрядчика</b>: граница введена против срывов сроков и некачественных работ.</li><li><b>Снижать физически нечего</b>: по структуре выше 65,72 % массы накладных расходов это зарплата и взносы (48,68 + 17,04), ещё около 19 % налоги, аудит, страхование, аттестация.</li><li><b>Первыми «экономят» на безопасности</b>: из ОХР и ОПР платят за СИЗ, обучение, аттестацию рабочих мест, охрану площадки, ППР и лабораторию.</li></ul></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Что делать заказчику и подрядчику</h3></div><ul class=\"e-ul\"><li>Просите расшифровку цены по слоям: материалы, зарплата, машины, ОХР и ОПР, плановая прибыль, налоги. Если накладные расходы и прибыль в предложении не видны, спросите, как они учтены.</li><li>Сравнивайте предложения по составу работ, а не по итоговой цифре: низкая цена при равном объёме должна объясняться, а не скрываться.</li><li>Для бюджетных закупок проверьте, применим ли к вам нижний предел конкурсного коэффициента и как он указан в документации.</li><li>Для частных договоров сверяйте с условиями договора, какие нормы применяются: ОХР, ОПР и плановая прибыль в любом случае дают понятную точку отсчёта при разговоре о цене.</li><li>Проверяйте актуальность норм: вид работ, город или село, коэффициенты 1,1 и 1,115 для реконструкции и текущего ремонта. Калькулятор сметы на этом сайте считает стоимость ремонта по расценкам, а не по этим нормам.</li></ul><p class=\"e-note\">Источники: <a href=\"https://pravo.by/document/?guid=12551&p0=W22644580\" target=\"_blank\" rel=\"noopener\">постановление Министерства архитектуры и строительства от 17.12.2025 № 146 «О применении норм общехозяйственных и общепроизводственных расходов, плановой прибыли»</a> (действует с 13.02.2026); Инструкция № 116 от 13.10.2025; РСН 8.01.105-2007 (по образцу); Положение № 1553 в редакции постановления Совета Министров от 15.05.2025 № 266 (по образцу). Значения норм и границы коэффициента даны по образцу ООО «Тэга плюс» и перед применением в договоре сверяются с текстом актов специалистом. Справка не является расчётом сметы.</p></div></div><div class=\"e-basis\"><b>Важно знать</b><p>Это справочная статья, а не смета и не юридическая консультация. Нормы, коэффициенты и границы торгов меняются и зависят от вида работ и закупки: перед применением в договоре их сверяет специалист по тексту действующих актов.</p></div>"
}

pattern EstPondTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Пруды</div><h1>Пруды и биопруды: расчёт и статья</h1><p class=\"e-lead\">Объём, оборот воды, насос, биофильтр, плёнка, растения и электричество для декоративного пруда, кой-пруда и пруда для купания.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\" class=\"on\" aria-current=\"page\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Пруды\"><a href=\"#pdart\" data-sub=\"pdart\" class=\"art\">Статья</a><a href=\"#pdgeo\" data-sub=\"pdgeo\">Параметры</a><a href=\"#pdeq\" data-sub=\"pdeq\">Оборудование</a><a href=\"#pdpl\" data-sub=\"pdpl\">Растения</a><a href=\"#pdbud\" data-sub=\"pdbud\">Смета</a></div><div class=\"e-elec\" id=\"e-pd\"><section class=\"e-panel\" id=\"pdart\" data-panel=\"pdart\"><div class=\"e-sech\"><small>01</small><h2>Пруды и биопруды: экосистема, материалы, расчёт</h2></div><p class=\"e-lead2\">Азотный цикл, типы прудов, профиль чаши, оборудование по обороту, растения, монтаж и зимовка.</p><div class=\"e-kpis\"><div class=\"e-kpi\"><b>4–6 нед</b><span>созревание биофильтра: «зелёная вода» в начале нормальна</span></div><div class=\"e-kpi\"><b>0,5–4 об/ч</b><span>оборот воды: от декора до кой-пруда, ориентир практики</span></div><div class=\"e-kpi\"><b>≥ 1,5 м</b><span>зимовальная яма ниже промерзания, если в пруде зимует рыба</span></div><div class=\"e-kpi\"><b>30–50 %</b><span>зеркала занимают растения в декоративном пруду</span></div></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 160\" role=\"img\" aria-label=\"Азотный цикл пруда\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"6\" y=\"20\" width=\"138\" height=\"80\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"75.0\" y=\"52\" font-size=\"12\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Корм, листва</text><text x=\"75.0\" y=\"78\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">органика</text><line x1=\"145\" y1=\"60\" x2=\"154\" y2=\"60\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"154,60 145.9,63.9 145.9,56.1\" fill=\"#4a4d55\"/><rect x=\"156\" y=\"20\" width=\"138\" height=\"80\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"225.0\" y=\"52\" font-size=\"12\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Аммоний</text><text x=\"225.0\" y=\"78\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">токсичен</text><line x1=\"295\" y1=\"60\" x2=\"304\" y2=\"60\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"304,60 295.9,63.9 295.9,56.1\" fill=\"#4a4d55\"/><rect x=\"306\" y=\"20\" width=\"138\" height=\"80\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"375.0\" y=\"52\" font-size=\"12\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Нитрит</text><text x=\"375.0\" y=\"78\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">токсичен</text><line x1=\"445\" y1=\"60\" x2=\"454\" y2=\"60\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"454,60 445.9,63.9 445.9,56.1\" fill=\"#4a4d55\"/><rect x=\"456\" y=\"20\" width=\"138\" height=\"80\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"525.0\" y=\"52\" font-size=\"12\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Нитрат</text><text x=\"525.0\" y=\"78\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">почти безопасен</text><line x1=\"595\" y1=\"60\" x2=\"604\" y2=\"60\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"604,60 595.9,63.9 595.9,56.1\" fill=\"#4a4d55\"/><rect x=\"606\" y=\"20\" width=\"138\" height=\"80\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"675.0\" y=\"52\" font-size=\"12\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Растения</text><text x=\"675.0\" y=\"78\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">забирают нитрат</text><text x=\"6\" y=\"128\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Бактерии биофильтра: аммоний → нитрит → нитрат. Растения: нитрат → рост.</text><text x=\"6\" y=\"148\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Красные звенья опасны для рыбы только до созревания биофильтра (первые 4–6 недель).</text></svg><figcaption>Цепочка азота: корм и органика дают аммоний, бактерии переводят его в нитрит и затем в нитрат, нитрат забирают растения. Оборудование ускоряет цикл, но не заменяет его.</figcaption></figure><div class=\"e-basis\"><b>Главный принцип</b><p>Баланс важнее бренда: рыба, корм, растения, бактерии и оборудование должны сходиться в одном уравнении азота. Перекормленные кои при слабом биофильтре погубят пруд дороже любой мембраны, а недобор растений превратит купальный пруд в болото за пару сезонов.</p></div><div class=\"e-art\" id=\"art0\"><div class=\"e-sech\"><small>0</small><h3>Суть: пруд это экосистема, а не ёмкость с водой</h3></div><p class=\"e-lead2\">Пруд держится на азотном цикле: корм, листва и отходы рыбы дают аммоний, бактерии переводят его в нитрит и затем в нитрат, а нитрат забирают растения. Оборудование (насос, скиммер, биофильтр, УФ, аэрация) ускоряет и страхует этот цикл, но не заменяет его. Пока бактерии не заселили фильтр, аммоний и нитрит опасны для рыбы, поэтому первые недели вода мутная или зелёная, рыбу не торопятся пускать, а корм дают минимально.</p><ul class=\"e-ul\"><li><b>Назначение первично.</b> Декоративный пруд, кой-пруд и пруд для купания это три разные задачи с разной глубиной, потоком и фильтром.</li><li><b>Профиль закладывают котлованом.</b> Террасы для растений и зимовальную яму потом не «докупить».</li><li><b>Зима закладывается заранее.</b> Глубина ямы, аэрация и сервис решаются на стадии проекта.</li></ul></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Типы прудов</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Тип</th><th>Глубина и зоны</th><th>Оборудование (ориентир практики)</th><th>Особенности</th></tr></thead><tbody><tr><td>Декоративный биопруд</td><td>1,2–2,0 м с террасами; зимовальная яма от 1,5–1,8 м, если зимует рыба</td><td>Оборот 0,5–1 об/ч, скиммер, биофильтр около 10–15 % объёма, аэрация</td><td>Основа частного сада; растения главный фильтр</td></tr><tr><td>Кой-пруд</td><td>От 1,8 м, без мелководных зарослей в чаше</td><td>Оборот 2–4 об/ч, донный сток, барабанный фильтр и биофильтр около 30–40 %, УФ, сильная аэрация</td><td>Рыба доминирует: оборудования заметно больше, чем у декоративного</td></tr><tr><td>Пруд для купания (биопул)</td><td>Плавательная зона 1,4–2 м и зона регенерации 30–50 % площади</td><td>Оборот 1–2 об/ч, скиммеры, болотный (bog) фильтр, движение воды в регенерации</td><td>Без хлора: чистоту дают растения и медленная фильтрация</td></tr><tr><td>Болотный фильтр как модуль</td><td>Слой щебня 0,2–0,4 м с перфорированной раздачей</td><td>Отдельный насос или самотёк после биофильтра</td><td>Доводка нитратов и фосфатов; ставится и к готовому пруду</td></tr><tr><td>Бентонит или глиняный замок</td><td>Профиль любой</td><td>Без плёнки: бентонитовый мат или уплотнённая глина</td><td>Большие водоёмы; риск пересыхания и прорастания корней</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Материал чаши.</b> Каучуковая EPDM и бутил наиболее эластичны и ремонтопригодны; ПВХ дешевле, но на УФ в местах складок стареет быстрее; бетонная чаша требует эластичной гидроизоляции и трескается по осадке. Срок службы зависит от материала, толщины (для EPDM обычно 1,0–1,5 мм) и качества монтажа, обещанный срок смотрите в гарантии производителя.</p><p class=\"e-note\">Тенденции последних лет: купальные пруды вместо хлорных бассейнов (зона регенерации и bog-фильтр стали отраслевой схемой), насосы с переменной частотой вращения (меньше электричества в межсезонье), датчики кислорода и pH с автоматикой, пруд как запас воды для полива. В Беларуси это пока единичные проекты, но схема воспроизводима.</p></div><div class=\"e-basis\"><b>Что говорит закон о прудах на участке</b><p>Водный кодекс (<a href=\"https://pravo.by/document/?guid=12551&p0=H12600148\">Закон № 148-З</a>, нормы применяются с 01.01.2027) разрешает садовый пруд-копань без проектной документации. По публикациям о кодексе: один пруд на участок, зеркало не более 0,01 га (1 сотка), глубина не более 2 м, не более 5 % площади участка, для личных нужд, не ближе 3 м от границы соседнего участка (от береговой линии); уже существующие законные пруды засыпать не требуют. «20 соток» из ранних публикаций относится к существующим непроточным водоёмам, а не к новому пруду. Всё, что крупнее или глубже, идёт по общему порядку: согласования и проект. Сверьте цифры с текстом закона и с местным райисполкомом до начала земляных работ. Для кой-пруда глубиной 1,8–2,5 м и для купального пруда площадью более сотки действуют не эти упрощения, а общий порядок.</p></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Геометрия: террасы, глубины, количество плёнки</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"Профиль чаши пруда\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"10\" y=\"10\" width=\"740\" height=\"270\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"70\" x2=\"750\" y2=\"70\" stroke=\"#4a4d55\" stroke-width=\"2\"/><text x=\"740\" y=\"62\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">уровень земли и воды</text><line x1=\"10\" y1=\"164\" x2=\"750\" y2=\"164\" stroke=\"#e3000f\" stroke-width=\"2\" stroke-dasharray=\"8 6\"/><text x=\"740\" y=\"158\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"end\" font-weight=\"700\">промерзание ≈ 1 м</text><polyline points=\"40,70 110,84 170,84 200,110 270,110 320,140 380,230 470,230 520,140 570,110 640,84 710,70\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\" stroke-linejoin=\"round\"/><text x=\"75\" y=\"102\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">болотная 0–10 см</text><text x=\"185\" y=\"132\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">мелководье 10–40 см</text><text x=\"250\" y=\"154\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">глубоководная 40–80 см</text><text x=\"425\" y=\"258\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">зимовальная яма ≥ 1,5–1,8 м</text><circle cx=\"425\" cy=\"222\" r=\"6\" fill=\"#1d1f23\"/><text x=\"425\" y=\"210\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">донный сток</text><rect x=\"24\" y=\"48\" width=\"22\" height=\"22\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"35\" y=\"63\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">С</text><text x=\"52\" y=\"44\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">скиммер</text></svg><figcaption>Террасы для растений и зимовальная яма ниже промерзания закладываются котлованом. Скиммер собирает плёнку с поверхности, донный сток уносит грязь к фильтру.</figcaption></figure><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Параметр</th><th>Ориентир практики</th><th>Зачем</th></tr></thead><tbody><tr><td>Зимовальная яма</td><td>От 1,5–1,8 м и глубже промерзания (около 1 м, по проекту)</td><td>Рыба и мембрана переживают лёд; летом прохладное убежище</td></tr><tr><td>Болотная терраса 0–10 см</td><td>10–20 % площади зеркала</td><td>Ирис, калужница, осоки: быстрый старт биоплёнки</td></tr><tr><td>Мелководье 10–40 см</td><td>15–25 % площади</td><td>Камыш, сусак, мята водная; нерест и прогрев</td></tr><tr><td>Глубоководная зона 40–80 см</td><td>Остальная часть до ямы</td><td>Кувшинки (1 шт на 1–2 м²), стабильная температура</td></tr><tr><td>Откосы</td><td>Террасы до 30–35°, яма круче, до 60°</td><td>Плёнка и камень не ползут; безопасный выход</td></tr><tr><td>Бортик</td><td>Плёнка выше уровня земли на 10–15 см и обсыпана</td><td>Дождевая вода с удобрениями не стекает в пруд</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Пример расчёта плёнки и геотекстиля</b> для пруда 6×4 м глубиной 1,8 м со свесами по 0,5 м. Длина полотна 6 + 2×1,8 + 2×0,5 = 10,6 м, ширина 4 + 2×1,8 + 2×0,5 = 8,6 м, площадь около 91 м², с нахлёстами и подрезкой около 100 м². Геотекстиль 300 г/м² идёт на то же ложе, и ещё по камню в местах нагрузки. Объём воды при среднем заглублении 1,1 м около 26 м³: от него считают насос и фильтр. Это минимальный расчёт для простого ложа с прямыми стенками. Террасы и пологие откосы увеличивают площадь, поэтому запас берут по раскрою, а не по формуле.</p><div class=\"e-basis\"><b>Запоминалка</b><p>Террасы держат пруд, яма держит зиму. Без террас растениям негде жить, а плёнке не на чем лежать; без ямы ниже промерзания рыба не переживёт ледостав.</p></div></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Оборудование: насос, биофильтр, УФ, аэрация</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 210\" role=\"img\" aria-label=\"Оборот воды и размер биофильтра по типу пруда\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"150\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Оборот воды, объёмов в час</text><text x=\"140\" y=\"62\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Декоративный биопруд</text><rect x=\"177.5\" y=\"40\" width=\"27.5\" height=\"30\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"213.0\" y=\"61\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">0,5–1,0</text><text x=\"140\" y=\"106\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Пруд для купания</text><rect x=\"205.0\" y=\"84\" width=\"55.0\" height=\"30\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"268.0\" y=\"105\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">1,0–2,0</text><text x=\"140\" y=\"150\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Кой-пруд</text><rect x=\"260.0\" y=\"128\" width=\"110.0\" height=\"30\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"378.0\" y=\"149\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">2,0–4,0</text><line x1=\"150.0\" y1=\"174\" x2=\"150.0\" y2=\"180\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"150.0\" y=\"194\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><line x1=\"205.0\" y1=\"174\" x2=\"205.0\" y2=\"180\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"205.0\" y=\"194\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">1</text><line x1=\"260.0\" y1=\"174\" x2=\"260.0\" y2=\"180\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"260.0\" y=\"194\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">2</text><line x1=\"315.0\" y1=\"174\" x2=\"315.0\" y2=\"180\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"315.0\" y=\"194\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">3</text><line x1=\"370.0\" y1=\"174\" x2=\"370.0\" y2=\"180\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"370.0\" y=\"194\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">4</text><text x=\"480\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Объём биофильтра, % объёма пруда</text><text x=\"570\" y=\"62\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Декоративный</text><rect x=\"610\" y=\"40\" width=\"15\" height=\"30\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"633\" y=\"61\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">10–15 %</text><text x=\"570\" y=\"106\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Кой-пруд</text><rect x=\"670\" y=\"84\" width=\"30\" height=\"30\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"708\" y=\"105\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">30–40 %</text><text x=\"480\" y=\"152\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">У купального пруда фильтр это зона регенерации</text><text x=\"480\" y=\"168\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">30–50 % площади.</text></svg><figcaption>Кой-пруду нужен примерно вчетверо больший поток и втрое больший фильтр, чем декоративному. Диапазоны ориентировочные, по практике.</figcaption></figure><ul class=\"e-ul\"><li><b>Насос.</b> Расход Q = V × оборот. Для 26 м³ декоративного пруда Q = 13–26 м³/ч; напор складывается из подъёма воды до фильтра (около 1,0–1,5 м) и потерь трассы, итог часто 2,5–3 м. Хорошо работает насос с регулируемой скоростью: на лето 100 %, весной и осенью 40–60 %. Для кой-пруда считают от 2 об/ч и добавляют донный сток, чтобы грязь уходила в фильтр.</li><li><b>Биофильтр.</b> Объём загрузки 10–15 % объёма пруда для декоративного, 30–40 % для кой. Поток через фильтр равен расходу насоса. Фильтр ставят выше уровня воды, возврат самотёком: при отключении питания пруд не должен сифонить.</li><li><b>УФ-стерилизатор.</b> Практика 1–3 Вт на 1 м³ против «зелёной воды». Это косметика: аммоний и нитрит УФ не убирает.</li><li><b>Аэрация.</b> Мембранный компрессор около 60–100 л/мин на 10 м³ держит кислород и полынью зимой, летом страхует биофильтр в жару.</li><li><b>Структура затрат.</b> У кой-пруда заметную долю занимает оборудование, у купального пруда земляные работы и зона регенерации с растениями; первый сезон закладывает сервис. Цены на оборудование и работы здесь не приводятся: они меняются, запрашивайте расчёт по вашей чаше.</li></ul></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Растения-биофильтры: зоны, виды, плотность</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Зона</th><th>Зимостойкие виды для Беларуси</th><th>Плотность (ориентир)</th><th>Роль</th></tr></thead><tbody><tr><td>Болотная, 0–10 см</td><td>Ирис аировидный, калужница, осока, ситник</td><td>5–7 шт/м²</td><td>Старт биоплёнки, вынос азота и фосфора</td></tr><tr><td>Мелководье, 10–40 см</td><td>Камыш озёрный, сусак, мята водная, рогоз узколистный (в контейнере)</td><td>3–5 шт/м²</td><td>Корневая доочистка, приют для зоопланктона</td></tr><tr><td>Глубоководная, 40–80 см</td><td>Кувшинка белая и четырёхгранная, кубышка</td><td>1 шт на 1–2 м²</td><td>Тень против нагрева и водорослей</td></tr><tr><td>Плавающие</td><td>Водокрас, рдесты (дозированно)</td><td>1–2 шт/м²</td><td>Потребляют нитрат из толщи воды</td></tr><tr><td>Зона регенерации биопула</td><td>Ирис, камыш, рогоз узколистный, сусак на щебне bog-фильтра</td><td>7–9 шт/м²</td><td>Замыкают цикл: нитрат и фосфат купальной зоны</td></tr></tbody></table></div><ul class=\"e-ul\"><li><b>Агрессоры в контейнеры.</b> Рогоз широколистный, ежеголовник и тростник за несколько сезонов вытесняют остальное и рвут плёнку корнями; допускаются только в корзинах.</li><li><b>Правило площади.</b> Растения занимают порядка 30–50 % зеркала декоративного пруда (в купальном 30–50 % общей площади составляет зона регенерации), иначе нитрат копится и вода цветёт каждое лето.</li><li><b>Откуда растения.</b> Из питомников, а не из природных водоёмов: так не занесёте болезни и инвазивные виды и не нарушите закон об охране растений.</li><li><b>Старт сезона.</b> Посадки весной при прогреве воды выше примерно 10 °C; первые 4–6 недель минимум корма и рыбы.</li></ul><p class=\"e-lead2\"><b>Пример посадки</b> для пруда 26 м³ с зеркалом 24 м²: болотная терраса 4 м² (около 24–28 растений), мелководье 5 м² (18–22), 4–6 кувшинок, 3–4 плавающих. Всего порядка 50–60 растений. Это дешёвый и долговечный фильтр, но его нужно прореживать и ухаживать раз в сезон.</p></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Монтаж и зимовка: десять правил</h3></div><ul class=\"e-ul\"><li><b>Котлован.</b> От центра к краям: террасы выводят по уровню, яму делают последней; грунт из ямы не подсыпают под террасы, осадка порвёт плёнку.</li><li><b>Геотекстиль</b> 300 г/м² под плёнкой по всему ложу и сверху в местах камня и ступеней. Корни и камни главные враги чаши.</li><li><b>Плёнка со складками.</b> Укладывают в тёплую погоду, не «в струну», расправляют под наливом воды: натянутая плёнка рвётся на углах при осадке.</li><li><b>Анкерная траншея и бортик.</b> Край плёнки заводят в траншею за береговую линию и поднимают бортик над землёй, чтобы дождь не нёс удобрения с газона.</li><li><b>Скиммер и донный сток</b> монтируют до засыпки, с фланцами и герметиком; трассы идут с уклоном, без петель «против течения».</li><li><b>Биофильтр выше уровня воды,</b> возврат самотёком или с обратным клапаном, чтобы авария не сифонила пруд.</li><li><b>Электрика у воды.</b> УЗО 30 мА (дифференциальный автомат) на всё водное оборудование, кабель в трубе вне чаши, оборудование под навесом с вентиляцией; схема и сечения по ПУЭ и проекту. ИБП на компрессор зимней аэрации.</li><li><b>Пуск.</b> Заполнение, проверка уровней, внесение бактерий, посадка растений, рыба через 4–6 недель; первый месяц аммоний и нитрит измеряют тестами, а не «на глаз».</li><li><b>Зима.</b> Пруд не сливают (пустую чашу выдавит грунт); насос убирают или опускают ниже примерно 80 см, аэратор держит полынью над ямой; лёд не долбят, ударная волна вредит рыбе и мембране.</li><li><b>Сервисный доступ.</b> Люк или площадка у фильтра и насоса, розетка и свет в техзоне, иначе обслуживание превращается в раскопки и пруд забрасывают.</li></ul><div class=\"e-basis\"><b>Безопасность и вода</b><p>Если на участке бывают дети, продумайте ограждение или мелководный выход, знаки и спасательные средства: ответственность за безопасность лежит на владельце. Купание в пруду регулируют отдельные санитарные требования к воде, они не равны требованиям к декоративному водоёму. Стоячая вода привлекает комаров: движение воды, рыба и растения решают это без химии.</p></div><p class=\"e-note\">Водяные потребители и зимнее содержание зависят от вашей чаши, климата зимы и рыбы: перед запуском составьте письменный регламент сезонов.</p></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Типичные ошибки: 12 способов получить болото вместо пруда</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. Плоская яма без террас</h4><p class=\"x\">✗ Растениям негде жить, плёнка ползёт, пруд стареет за сезон.</p><p class=\"v\">✓ Террасы по уровню на этапе котлована.</p></div><div class=\"e-err\"><h4>2. Глубина 1 м «для экономии»</h4><p class=\"x\">✗ Промерзает до дна зимой, перегревается летом, цветут водоросли.</p><p class=\"v\">✓ Зимовальная яма ниже промерзания, если зимует рыба.</p></div><div class=\"e-err\"><h4>3. ПВХ по щебню без геотекстиля</h4><p class=\"x\">✗ Прокол в первый сезон, ремонт с осушением.</p><p class=\"v\">✓ Геотекстиль под плёнкой и под камнем.</p></div><div class=\"e-err\"><h4>4. Плёнка «в струну»</h4><p class=\"x\">✗ Трещины по складкам при осадке грунта и наливе.</p><p class=\"v\">✓ Свободная укладка, расправка под водой.</p></div><div class=\"e-err\"><h4>5. Нет бортика и анкерной траншеи</h4><p class=\"x\">✗ Ливень с газона несёт удобрения: цветение каждое лето.</p><p class=\"v\">✓ Бортик, траншея, отсыпка камнем.</p></div><div class=\"e-err\"><h4>6. Насос «помощнее»</h4><p class=\"x\">✗ Размыв террас, вымывание биоплёнки, счёт за электричество.</p><p class=\"v\">✓ Расход по обороту типа пруда, регулируемый насос.</p></div><div class=\"e-err\"><h4>7. УФ вместо биофильтра</h4><p class=\"x\">✗ Вода прозрачная, но аммоний и нитрит остаются, рыба болеет.</p><p class=\"v\">✓ Биофильтр по объёму и типу, УФ как добавка.</p></div><div class=\"e-err\"><h4>8. Перенаселение и перекорм</h4><p class=\"x\">✗ Азота больше мощности фильтра: замор и водоросли.</p><p class=\"v\">✓ Ориентир 1 см рыбы на 50 л, корм за 5 минут.</p></div><div class=\"e-err\"><h4>9. Растений «пара кустов»</h4><p class=\"x\">✗ Нитрат некому забирать, зелёная вода к июлю.</p><p class=\"v\">✓ Растения по зонам, 30–50 % зеркала.</p></div><div class=\"e-err\"><h4>10. Фильтр ниже уровня без защиты</h4><p class=\"x\">✗ Отключили свет, сифон осушил пруд за часы.</p><p class=\"v\">✓ Фильтр выше воды, самотёк или обратный клапан.</p></div><div class=\"e-err\"><h4>11. Слив на зиму или долблёный лёд</h4><p class=\"x\">✗ Чашу выдавливает грунт, рыба гибнет от ударной волны.</p><p class=\"v\">✓ Не сливать, аэратор, никакой долбёжки.</p></div><div class=\"e-err\"><h4>12. Техзона без доступа</h4><p class=\"x\">✗ Обслуживание это раскопки, пруд бросают на третий сезон.</p><p class=\"v\">✓ Площадка, свет, розетка и люк у фильтра в проекте.</p></div></div></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Приоритеты и чек-лист заказчика</h3></div><p class=\"e-lead2\">Вопросы подрядчику до договора.</p><ul class=\"e-ul\"><li>Есть ли профиль чаши в разрезе, с террасами, зимовальной ямой, отметками и уровнем воды?</li><li>Как посчитан оборот: насос, напор, объём биофильтра, ваши цифры для вашего пруда?</li><li>Какие растения и сколько по зонам, что делаете с агрессорами?</li><li>Как прописана зима: аэрация, насос, полынья, лёд, регламент?</li><li>Электрика у воды: УЗО, трассы, ИБП компрессора в смете?</li><li>Гарантия на чашу и оборудование, входит ли сервис первого сезона?</li><li>Подходит ли пруд под упрощённый порядок закона по размерам, или нужны согласования?</li></ul><div class=\"e-basis\"><b>Красные флаги</b><p>«Пруд без растений, чистая вода из фильтра»; плёнка без геотекстиля «и так будет»; глубина «метр с лихвой» при зимующей рыбе; насос вдвое мощнее расчёта «про запас»; нет зимнего сценария и сервиса; пруд крупнее допустимого без согласований или ближе 3 м к границе. Любого пункта достаточно, чтобы остановиться.</p></div><p class=\"e-lead2\">Пять тезисов, с которыми можно принимать решение.</p><ul class=\"e-ul\"><li>Пруд это экосистема: азотный цикл держат бактерии и растения, оборудование лишь страхует.</li><li>Профиль решает всё: террасы и зимовальная яма закладываются котлованом.</li><li>Оборудование считают по обороту: 0,5–1 об/ч декор, 1–2 купальный, 2–4 кой; УФ косметика, биофильтр обязателен.</li><li>Растения это постоянный фильтр: 30–50 % зеркала по зонам, агрессоры только в контейнерах.</li><li>До земляных работ проверьте размеры по закону, электрику у воды и зимний регламент.</li></ul><p class=\"e-note\">Источники: Закон Республики Беларусь № 148-З (Водный кодекс) по публикациям, текст сверьте на pravo.by; СН 3.01.03-2020; паспорта оборудования. Цифры оборота, фильтра, УФ и плотности посадки это ориентиры практики, а не нормативы. Оценки не оферта.</p></div></section><section class=\"e-panel\" id=\"pdgeo\" data-panel=\"pdgeo\"><div class=\"e-sech\"><small>02</small><h2>Параметры и паспорт пруда</h2></div><p class=\"e-lead2\">Выберите тип и размеры: расчёт даст объём, оборот и предупреждения по глубине, расстоянию до границы и размерам пруда на участке.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f wide\"><label for=\"pd-preset\">Готовый пример</label><div class=\"e-in\"><select id=\"pd-preset\"><option value=\"\" selected>Свои данные</option><option value=\"decor\">Декоративный биопруд 6×4 м, 26 м³</option><option value=\"koi\">Кой-пруд 7×5 м, 56 м³</option><option value=\"bath\">Пруд для купания 10×5 м, 70 м³</option></select></div></div><div class=\"e-f wide\"><label for=\"pd-type\">Тип пруда</label><div class=\"e-in\"><select id=\"pd-type\"><option value=\"decor\" selected>Декоративный биопруд</option><option value=\"koi\">Кой-пруд</option><option value=\"bath\">Пруд для купания (биопул)</option></select></div></div><div class=\"e-f\"><label for=\"pd-L\">Длина</label><div class=\"e-in\"><input id=\"pd-L\" inputmode=\"decimal\" autocomplete=\"off\" value=\"6\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pd-W\">Ширина</label><div class=\"e-in\"><input id=\"pd-W\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pd-da\">Средняя глубина</label><div class=\"e-in\"><input id=\"pd-da\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,1\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pd-dp\">Глубина зимовальной ямы</label><div class=\"e-in\"><input id=\"pd-dp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,8\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pd-fish\">Рыба</label><div class=\"e-in\"><select id=\"pd-fish\"><option value=\"mod\" selected>Умеренно (декоративная)</option><option value=\"none\">Нет</option><option value=\"koi\">Кои</option></select></div></div><div class=\"e-f\"><label for=\"pd-win\">Зимовка рыбы в пруду</label><div class=\"e-in\"><select id=\"pd-win\"><option value=\"1\" selected>Да</option><option value=\"0\">Нет</option></select></div></div><div class=\"e-f\"><label for=\"pd-pw\">Электричество у пруда</label><div class=\"e-in\"><select id=\"pd-pw\"><option value=\"1\" selected>Есть</option><option value=\"0\">Нет</option></select></div></div><div class=\"e-f\"><label for=\"pd-gr\">Грунт основания</label><div class=\"e-in\"><select id=\"pd-gr\"><option value=\"loam\" selected>Суглинок</option><option value=\"sand\">Песок</option><option value=\"clay\">Глина</option><option value=\"quick\">Плывун</option></select></div></div><div class=\"e-f\"><label for=\"pd-bud\">Класс оборудования</label><div class=\"e-in\"><select id=\"pd-bud\"><option value=\"std\" selected>Стандарт</option><option value=\"eco\">Эконом</option><option value=\"prem\">Премиум (регулируемый насос)</option></select></div></div><div class=\"e-f\"><label for=\"pd-plot\">Площадь участка</label><div class=\"e-in\"><input id=\"pd-plot\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">соток</span></div></div><div class=\"e-f\"><label for=\"pd-bd\">Расстояние до границы соседа</label><div class=\"e-in\"><input id=\"pd-bd\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pd-reg\">Зона регенерации (для купального)</label><div class=\"e-in\"><input id=\"pd-reg\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">% площади</span></div></div><div class=\"e-formula\">S = L · W, V = S · средняя глубина<br>Предупреждения: яма ниже промерзания, оборот кой-пруда, доля регенерации, размеры и отступ по Закону № 148-З</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Паспорт</span><div class=\"kv\"><span>Зеркало</span><b id=\"pd-s\">—</b></div><div class=\"kv\"><span>Объём воды</span><b id=\"pd-v\">—</b></div><div class=\"kv\"><span>Тип и оборот</span><b id=\"pd-k\">—</b></div><div class=\"kv\"><span>Зоны, м²</span><b id=\"pd-zones\">—</b></div><div class=\"verdict\" id=\"pd-verdict\" role=\"status\"></div></div></div></div><figure class=\"e-fig\"><div id=\"pd-ch\"></div><figcaption id=\"pd-chn\"></figcaption></figure></section><section class=\"e-panel\" id=\"pdeq\" data-panel=\"pdeq\"><div class=\"e-sech\"><small>03</small><h2>Чаша и оборудование</h2></div><p class=\"e-lead2\">Расход насоса по обороту, напор по трассе, биофильтр, УФ, скиммеры, аэрация, плёнка и электричество. Классы насосов и компрессоров ориентировочные, точную модель подбирают по паспорту.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f\"><label for=\"pd-turn\">Оборот воды (пусто: по типу пруда)</label><div class=\"e-in\"><input id=\"pd-turn\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">об/ч</span></div></div><div class=\"e-f\"><label for=\"pd-lift\">Подъём воды до фильтра</label><div class=\"e-in\"><input id=\"pd-lift\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,2\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pd-tr\">Длина трассы</label><div class=\"e-in\"><input id=\"pd-tr\" inputmode=\"decimal\" autocomplete=\"off\" value=\"8\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pd-tn\">Поворотов на трассе</label><div class=\"e-in\"><input id=\"pd-tn\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2\"><span class=\"u\">шт</span></div></div><div class=\"e-f\"><label for=\"pd-tar\">Тариф</label><div class=\"e-in\"><input id=\"pd-tar\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,3037\"><span class=\"u\">BYN/кВт·ч</span></div></div><div class=\"e-formula\">Q = V · оборот, H = подъём + 0,15 · трасса + 0,5 · повороты<br>P = Q · H / (367 · КПД), плёнка = (L + 2D + 1)(W + 2D + 1) · 1,1</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Расход насоса</span><b id=\"pd-q\">—</b></div><div class=\"kv\"><span>Напор</span><b id=\"pd-h\">—</b></div><div class=\"kv\"><span>Насос</span><b id=\"pd-pump\">—</b></div><div class=\"kv\"><span>Биофильтр</span><b id=\"pd-filt\">—</b></div><div class=\"kv\"><span>УФ</span><b id=\"pd-uv\">—</b></div><div class=\"kv\"><span>Скиммеры</span><b id=\"pd-skim\">—</b></div><div class=\"kv\"><span>Донный сток</span><b id=\"pd-drain\">—</b></div><div class=\"kv\"><span>Аэрация</span><b id=\"pd-air\">—</b></div><div class=\"kv\"><span>Плёнка</span><b id=\"pd-film\">—</b></div><div class=\"kv\"><span>Геотекстиль</span><b id=\"pd-geo\">—</b></div><div class=\"kv\"><span>Котлован</span><b id=\"pd-ex\">—</b></div><div class=\"kv\"><span>Электричество летом</span><b id=\"pd-kw1\">—</b></div><div class=\"kv\"><span>Электричество зимой</span><b id=\"pd-kw2\">—</b></div><div class=\"kv\"><span>Стоимость электричества</span><b id=\"pd-cost\">—</b></div><div class=\"verdict\" id=\"pd-eq-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"pdpl\" data-panel=\"pdpl\" data-xtbl=\"1\"><div class=\"e-sech\"><small>04</small><h2>Растения-биофильтры</h2></div><p class=\"e-lead2\">Площади зон по долям зеркала и посадочная ведомость. Для купального пруда считается зона регенерации. Берутся только зимостойкие виды для Беларуси.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f\"><label for=\"pd-zb\">Болотная терраса</label><div class=\"e-in\"><input id=\"pd-zb\" inputmode=\"decimal\" autocomplete=\"off\" value=\"15\"><span class=\"u\">% зеркала</span></div></div><div class=\"e-f\"><label for=\"pd-zs\">Мелководье</label><div class=\"e-in\"><input id=\"pd-zs\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">% зеркала</span></div></div><div class=\"e-f\"><label for=\"pd-zd\">Глубоководная зона</label><div class=\"e-in\"><input id=\"pd-zd\" inputmode=\"decimal\" autocomplete=\"off\" value=\"40\"><span class=\"u\">% зеркала</span></div></div><div class=\"e-f\"><label for=\"pd-zf\">Плавающие</label><div class=\"e-in\"><input id=\"pd-zf\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">% зеркала</span></div></div><div class=\"e-f wide\"><label for=\"pd-sp\">Набор видов</label><div class=\"e-in\"><select id=\"pd-sp\"><option value=\"base\" selected>Основной, без агрессивных</option><option value=\"ext\">Расширенный (мята, рогоз и кубышка в контейнерах)</option></select></div></div><div class=\"e-formula\">Штук = площадь зоны · плотность (болото 6, мелководье 4, кувшинки 0,5, плавающие 2 шт/м², регенерация 8 шт/м²)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Растений</span><b id=\"pd-pl-n\">—</b></div><div class=\"kv\"><span>К покупке</span><b id=\"pd-pl-buy\">—</b></div><div class=\"kv\"><span>Доля под растениями</span><b id=\"pd-pl-share\">—</b></div><div class=\"kv\"><span>Нужно</span><b id=\"pd-pl-need\">—</b></div><div class=\"verdict\" id=\"pd-pl-verdict\" role=\"status\"></div></div></div></div><h4 class=\"e-h4\">Посадочная ведомость</h4><div id=\"pd-pt\"></div></section><section class=\"e-panel\" id=\"pdbud\" data-panel=\"pdbud\" data-xtbl=\"1\"><div class=\"e-sech\"><small>05</small><h2>Смета-ведомость</h2></div><p class=\"e-lead2\">Количества берутся из расчёта выше. Цены здесь не заложены: введите цены из ваших предложений, и сумма пересчитается.</p><div class=\"e-calc\"><div class=\"e-form\"><p class=\"e-note\"><b>Ваши цены за единицу</b></p><div class=\"e-f\"><label for=\"pd-p-ex\">Котлован и вывоз, за м³</label><div class=\"e-in\"><input id=\"pd-p-ex\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-geo\">Геотекстиль, за м²</label><div class=\"e-in\"><input id=\"pd-p-geo\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-mem\">Мембрана с монтажом, за м²</label><div class=\"e-in\"><input id=\"pd-p-mem\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-pump\">Насос, за шт</label><div class=\"e-in\"><input id=\"pd-p-pump\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-filt\">Биофильтр, за комплект</label><div class=\"e-in\"><input id=\"pd-p-filt\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-grav\">Щебень bog-фильтра, за м³</label><div class=\"e-in\"><input id=\"pd-p-grav\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-uv\">УФ-стерилизатор, за шт</label><div class=\"e-in\"><input id=\"pd-p-uv\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-skim\">Скиммер, за шт</label><div class=\"e-in\"><input id=\"pd-p-skim\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-drain\">Донный сток, за шт</label><div class=\"e-in\"><input id=\"pd-p-drain\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-comp\">Компрессор, за шт</label><div class=\"e-in\"><input id=\"pd-p-comp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-deic\">Де-айсер, за шт</label><div class=\"e-in\"><input id=\"pd-p-deic\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pd-p-plant\">Растение, за шт (средняя)</label><div class=\"e-in\"><input id=\"pd-p-plant\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><button class=\"e-btn sm\" id=\"pd-p-reset\" type=\"button\">Очистить цены</button><div class=\"e-formula\">Сумма = Σ (количество · ваша цена за единицу)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Позиций с ценой</span><b id=\"pd-b-n\">—</b></div><div class=\"kv\"><span>Итого</span><b id=\"pd-b-sum\">—</b></div><div class=\"verdict\" id=\"pd-b-verdict\" role=\"status\"></div></div></div></div><h4 class=\"e-h4\">Ведомость</h4><div id=\"pd-bt\"></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Это ориентировочный расчёт для разговора с подрядчиком, а не проект. Размеры, оборот воды, объём фильтра, мощность УФ и плотность посадки это ориентиры практики. Классы насосов и компрессоров даны по расходу, модель подбирают по паспорту. Допустимые размеры пруда на участке даны по публикациям о Законе № 148-З: проверьте их по тексту закона и в местной администрации до начала работ.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/pond-model.js?v=1\"></script><script src=\"/static/pond.js?v=1\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstPoolTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Бассейны</div><h1>Бассейны и биопулы: расчёт и статья</h1><p class=\"e-lead\">Оборот и насос, фильтр, трубы, нагрев и энергия сезона, обеззараживание, зона регенерации биопула и ведомость.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\" class=\"on\" aria-current=\"page\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Бассейны\"><a href=\"#pbart\" data-sub=\"pbart\" class=\"art\">Статья</a><a href=\"#pbgeo\" data-sub=\"pbgeo\">Параметры</a><a href=\"#pbcirc\" data-sub=\"pbcirc\">Вода</a><a href=\"#pbheat\" data-sub=\"pbheat\">Нагрев</a><a href=\"#pbbio\" data-sub=\"pbbio\">Биопул</a><a href=\"#pbbud\" data-sub=\"pbbud\">Смета</a></div><div class=\"e-elec\" id=\"e-pb\"><section class=\"e-panel\" id=\"pbart\" data-panel=\"pbart\"><div class=\"e-sech\"><small>01</small><h2>Бассейны: чаши, вода, энергия, зима</h2></div><p class=\"e-lead2\">Четыре контура, типы чаш, водоподготовка, тепло и энергия сезона, монтаж и зимовка, нормативный контур.</p><div class=\"e-kpis\"><div class=\"e-kpi\"><b>4–6 ч</b><span>полный оборот воды химического бассейна, ориентир практики</span></div><div class=\"e-kpi\"><b>до 70 %</b><span>потерь тепла открытой воды по оценкам уходит с испарением</span></div><div class=\"e-kpi\"><b>COP 4–5</b><span>среднесезонный тепловой насос в нашем климате, ориентир практики</span></div><div class=\"e-kpi\"><b>pH 7,2–7,6</b><span>рабочий коридор: при 8,0 хлор почти не дезинфицирует</span></div></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 156\" role=\"img\" aria-label=\"Четыре контура бассейна\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"6\" y=\"18\" width=\"175\" height=\"96\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"93\" y=\"48\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Циркуляция</text><text x=\"93\" y=\"78\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">скиммеры, насос,</text><text x=\"93\" y=\"94\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">фильтр, форсунки</text><rect x=\"193\" y=\"18\" width=\"175\" height=\"96\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"280\" y=\"48\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Водоподготовка</text><text x=\"280\" y=\"78\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">обеззараживание, pH,</text><text x=\"280\" y=\"94\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">прозрачность</text><rect x=\"380\" y=\"18\" width=\"175\" height=\"96\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"467\" y=\"48\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Тепло</text><text x=\"467\" y=\"78\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">нагрев, покрытие,</text><text x=\"467\" y=\"94\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">изоляция чаши</text><rect x=\"567\" y=\"18\" width=\"175\" height=\"96\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"654\" y=\"48\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Безопасность</text><text x=\"654\" y=\"78\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">покрытие, ограждение,</text><text x=\"654\" y=\"94\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">сигнализация</text><text x=\"6\" y=\"140\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Слабейший контур задаёт впечатление и счёт: мутная вода, электричество, конденсат или беда с детьми.</text></svg><figcaption>Тип чаши и бюджет вторичны: сначала циркуляция, вода, тепло и безопасность.</figcaption></figure><div class=\"e-basis\"><b>Главный принцип</b><p>Сначала тепло и вода, потом отделка. Основные потери тепла уходят с испарения, поэтому покрытие и тепловой насос выбирают до мозаики, а водоподготовку считают по объёму и обороту, а не «по мощности фильтра на ценнике». Мозаика переживёт любые моды, ошибки изоляции и гидравлики не переживёт.</p></div><div class=\"e-art\" id=\"art0\"><div class=\"e-sech\"><small>0</small><h3>Суть: бассейн это четыре замкнутых контура</h3></div><p class=\"e-lead2\">Любой бассейн, химический или природный, держится на четырёх контурах: циркуляция (скиммеры или перелив, насос, фильтр, форсунки), водоподготовка (обеззараживание, pH, прозрачность), тепло (нагрев, изоляция, покрытие) и безопасность (покрытие, ограждение, видимость дна). Просадка в любом контуре заметна сразу: мутная вода, счёт за электричество, конденсат в помещении или беда с детьми.</p><p class=\"e-lead2\">Главное различие философий. Химический бассейн промывает воду медленно и постоянно (полный оборот за 4–6 часов), а хлор, электролиз и УФ поддерживают стерильность. Биопул гонит весь объём через зону регенерации и bog-фильтр примерно каждые 40 минут, а прозрачность дают растения и биоплёнка без хлора. Обе схемы рабочие: выбор про эстетику, сервис и готовность ухаживать за экосистемой.</p></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Типы бассейнов</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Тип</th><th>Чаша и отделка</th><th>Вода и сервис</th><th>Особенности</th></tr></thead><tbody><tr><td>Химический скиммерный</td><td>Бетон с мозаикой или плёнкой ПВХ, полипропилен, композит</td><td>Хлор или электролиз, УФ, дозаторы pH и ORP; оборот 4–6 ч</td><td>База частного дома; чаша служит десятилетиями</td></tr><tr><td>Переливной</td><td>Бетон с мозаикой, переливной лоток и балансировочный бак</td><td>Та же химия, оборот 3–4 ч; зеркало вровень с бортом</td><td>Дороже скиммерного (по практике на пятую часть и больше); общественные и премиум-проекты</td></tr><tr><td>Биопул</td><td>Плёнка или полипропилен и зона регенерации 30–50 % площади</td><td>Без хлора: растения, биоплёнка, УФ как опция; оборот 1–2 об/ч</td><td>Дешевле химии в обслуживании, дороже по площади (участок в 1,4–1,5 раза больше зеркала купания)</td></tr><tr><td>Каркасный сезонный</td><td>Плёнка на каркасе</td><td>Хлор в таблетках, картриджный фильтр</td><td>Дача на сезон; не зимует в грунте</td></tr><tr><td>Купель, спа с противотоком</td><td>Акрил, полипропилен, композит</td><td>Компактная водоподготовка, нагрев до 36–38 °C</td><td>Всесезонно в павильоне или на террасе</td></tr></tbody></table></div><p class=\"e-note\">Тенденции последних лет: насосы с регулируемой скоростью, дозаторы pH и ORP с удалённым контролем, связка электролиз + УФ с низкой дозой хлора, тепловые насосы вместо ТЭНов, биопулы в частных садах, автоматические покрытия и датчики падения в воду. Данные по объёмам рынка и конкретным производителям здесь не приводятся: наличие и поддержка в Беларуси меняются.</p></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Чаши и материалы</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Материал чаши</th><th>Срок службы (по практике)</th><th>Плюсы</th><th>Риски</th><th>Когда выбирать</th></tr></thead><tbody><tr><td>Бетон с эластичной гидроизоляцией и мозаикой</td><td>Десятилетия при верном монтаже</td><td>Любая форма и глубина, перелив</td><td>Долгий цикл (недели), цена, трещины при осадке без деформационных швов</td><td>Стационарные премиум-проекты, переливные схемы</td></tr><tr><td>Полипропилен 5–8 мм</td><td>Десятилетия</td><td>Заводской шов, быстрый монтаж, встроенные закладные</td><td>Габариты транспорта, обсыпка и рёбра жёсткости обязательны, форма ограничена</td><td>Частные скиммерные бассейны под ключ</td></tr><tr><td>Композит (стеклопластик)</td><td>Десятилетия</td><td>Одна чаша за день, гладкая поверхность</td><td>Габариты чаши ограничены, осадка грунта даёт трещины гелькоута</td><td>Сезонные и дачные проекты</td></tr><tr><td>Плёнка ПВХ около 1,5 мм по любой чаше</td><td>10–15 лет с ремонтом</td><td>Дешевле мозаики, гидроизоляция и отделка за один слой</td><td>Швы варят на месте, боится абразива и льда</td><td>Реновация старых чаш, бюджетные проекты</td></tr><tr><td>Биопул: плёнка или полипропилен и зона регенерации</td><td>Как у плёнки или полипропилена</td><td>Без хлора, эстетика природного пруда</td><td>Площадь в 1,4–1,5 раза больше зеркала, уход за растениями</td><td>Эко-сценарий, ландшафтные сады</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Глубины под задачи.</b> Купание и игры 1,2–1,5 м; дорожка для плавания и противоток 1,4–1,6 м при длине от 8 м; детская зона 0,6–0,8 м с видимой границей дна. Прыжки с тумбы возможны только на глубине от 2,4 м, самодельные тумбы на меньшей глубине опасны. Глубже 1,6 м для семейного купания избыточно: больше воды и нагрева.</p><p class=\"e-lead2\"><b>Закладные до бетона.</b> Скиммеры, форсунки, свет и противоток ставят до бетонирования или обсыпки: алмазное сверление потом ослабляет чашу и портит гидроизоляцию.</p><p class=\"e-note\">Утепление чаши в грунте (плиты XPS по бортам и дну, по практике 50–100 мм) и эластичная гидроизоляция нужны в любой схеме: неутеплённая чаша отдаёт в грунт заметную часть тепла сезона (по практике 10–15 %), а в помещении конденсирует.</p></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Вода: циркуляция, фильтрация, обеззараживание, баланс</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 186\" role=\"img\" aria-label=\"Контур водоподготовки химического бассейна\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"6\" y=\"30\" width=\"82\" height=\"54\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"47.0\" y=\"55\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Скиммер/</text><text x=\"47.0\" y=\"71\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">перелив</text><line x1=\"89\" y1=\"57\" x2=\"101\" y2=\"57\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"101,57 92.9,60.9 92.9,53.1\" fill=\"#4a4d55\"/><rect x=\"102\" y=\"30\" width=\"82\" height=\"54\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"143.0\" y=\"62\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Префильтр</text><line x1=\"185\" y1=\"57\" x2=\"197\" y2=\"57\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"197,57 188.9,60.9 188.9,53.1\" fill=\"#4a4d55\"/><rect x=\"198\" y=\"30\" width=\"82\" height=\"54\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"239.0\" y=\"62\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Насос</text><line x1=\"281\" y1=\"57\" x2=\"293\" y2=\"57\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"293,57 284.9,60.9 284.9,53.1\" fill=\"#4a4d55\"/><rect x=\"294\" y=\"30\" width=\"82\" height=\"54\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"335.0\" y=\"62\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Фильтр</text><line x1=\"377\" y1=\"57\" x2=\"389\" y2=\"57\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"389,57 380.9,60.9 380.9,53.1\" fill=\"#4a4d55\"/><rect x=\"390\" y=\"30\" width=\"82\" height=\"54\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"431.0\" y=\"62\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Нагрев</text><line x1=\"473\" y1=\"57\" x2=\"485\" y2=\"57\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"485,57 476.9,60.9 476.9,53.1\" fill=\"#4a4d55\"/><rect x=\"486\" y=\"30\" width=\"82\" height=\"54\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"527.0\" y=\"55\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">УФ/</text><text x=\"527.0\" y=\"71\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">электролиз</text><line x1=\"569\" y1=\"57\" x2=\"581\" y2=\"57\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"581,57 572.9,60.9 572.9,53.1\" fill=\"#4a4d55\"/><rect x=\"582\" y=\"30\" width=\"82\" height=\"54\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"623.0\" y=\"55\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Дозатор pH</text><text x=\"623.0\" y=\"71\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">и ORP</text><line x1=\"665\" y1=\"57\" x2=\"677\" y2=\"57\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"677,57 668.9,60.9 668.9,53.1\" fill=\"#4a4d55\"/><rect x=\"678\" y=\"30\" width=\"82\" height=\"54\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"719.0\" y=\"62\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Форсунки</text><line x1=\"335.0\" y1=\"84\" x2=\"335.0\" y2=\"116\" stroke=\"#7d8089\" stroke-width=\"2\" stroke-dasharray=\"6 4\"/><rect x=\"274\" y=\"116\" width=\"122\" height=\"30\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#9a9ca3\" stroke-width=\"1\"/><text x=\"335.0\" y=\"135\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Промывка в дренаж</text><text x=\"6\" y=\"172\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Промывка фильтра идёт мимо чаши, в свой дренаж или канализацию. Нагрев ставят после фильтра, дозирование после нагрева.</text></svg><figcaption>Порядок узлов: префильтр защищает насос, фильтр защищает нагрев, нагрев и дезинфекция стоят после фильтра.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Узел</th><th>Правило подбора</th><th>Ориентир практики</th></tr></thead><tbody><tr><td>Насос</td><td>Q = V / t, t = 4–6 ч для скиммерного и 3–4 ч для переливного; напор системы 8–12 м с фильтром</td><td>30 м³: около 5–7,5 м³/ч; регулируемый насос с ночным профилем 40–60 %</td></tr><tr><td>Фильтр</td><td>Песок или AFM: нагрузка 30–50 м³/ч на 1 м² площади; промывка при росте давления на 0,3–0,5 бар</td><td>30 м³: диаметр 600–700 мм; картридж только для малых объёмов до 20 м³</td></tr><tr><td>Обеззараживание</td><td>Хлор 0,3–0,6 мг/л свободного; электролиз около 8–16 г/ч на 30 м³; УФ 1–2 Вт/м³ в байпасе</td><td>Электролиз с УФ позволяет снизить дозу хлора, режим по паспорту</td></tr><tr><td>Баланс</td><td>pH 7,2–7,6, щёлочность 80–120 мг/л, кальций по типу чаши</td><td>Дозаторы pH и ORP держат коридор без участия человека</td></tr><tr><td>Биопул</td><td>Без хлора: зона регенерации 30–50 % площади, bog-фильтр, растения около 8 шт/м², УФ по желанию</td><td>Прозрачность: дно видно по всей глубине, ориентир по диску Секки не менее 1,5 м</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Почему pH первичен.</b> От pH зависит, какая часть хлора находится в активной форме (хлорноватистая кислота): при 7,2 это примерно две трети, при 7,5 около половины, при 8,0 лишь около пятой части. Вода при этом пахнет хлором, но почти не дезинфицирует, а ударная доза раздражает кожу и глаза. Поправить pH дешевле любой ударной дозы.</p><p class=\"e-lead2\"><b>Гидравлика по скоростям.</b> Скорость воды на всасе не более 1,5 м/с, на напоре не более 2 м/с. Для потока 9,6 м³/ч это трубы Ø63 на всасе и Ø50 на напоре, для биопула с потоком 100 м³/ч нужны трубы Ø160–200 или несколько линий. Колена по 45°, никаких острых колен у насоса: кавитация и шум.</p><p class=\"e-note\">Вода для купания должна отвечать санитарным требованиям. Они отдельные от требований к декоративному водоёму, их уточняют по санитарным нормам и рекомендациям производителей химии.</p></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Тепло и энергия сезона: где живут деньги</h3></div><ul class=\"e-ul\"><li><b>Структура потерь открытой воды.</b> Главная часть уходит с испарения (по оценкам из литературы до 70 %), остальное на излучение и конвекцию, в грунт через чашу и брызги.</li><li><b>Первичный нагрев.</b> P = V × 1,163 × ΔT / t. Для 30 м³ при подъёме с +15 до +26 °C за сутки это около 16 кВт. Тепловой насос теряет мощность при воздухе ниже +10 °C, поэтому на старт сезона оставляют ТЭН или котёл.</li><li><b>Потери сезона.</b> Для открытой воды ориентир 0,25 кВт на 1 м² зеркала, с ламельным покрытием около 45 % от этого, с пузырьковой плёнкой около 55 %, в павильоне около 35 %, в помещении около 20 %. Сезон по умолчанию 4 месяца.</li><li><b>Тепловой насос.</b> Паспортный COP 5–7 даётся при тёплом воздухе. Для мая–сентября в Беларуси реалистичен среднесезонный COP около 4–5 (в калькуляторе 4,5), экономия против ТЭНа в 4–5 раз, а не в 5–7.</li><li><b>Изоляция чаши и труб.</b> XPS 50–100 мм по бортам и дну, скорлупы на трассах: по практике ещё 10–15 % сезона.</li><li><b>Павильон.</b> Телескопическое укрытие заметно удлиняет сезон (по практике до 5–6 месяцев вместо 3–4) и почти убирает ветровое испарение.</li></ul><figure class=\"e-fig\"><svg viewBox=\"0 0 760 248\" role=\"img\" aria-label=\"Сезонная энергия по вариантам нагрева\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"6\" y=\"20\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Электричество на нагрев за сезон (30 м³, 20 м², +26 °C, 4 месяца)</text><text x=\"240\" y=\"56\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">ТЭН без покрытия</text><rect x=\"250\" y=\"34\" width=\"220.0\" height=\"30\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"478.0\" y=\"55\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">14 780 кВт·ч, ≈ 4 490 BYN</text><text x=\"240\" y=\"102\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">ТЭН, ламельное покрытие</text><rect x=\"250\" y=\"80\" width=\"102.141183011934\" height=\"30\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"360.141183011934\" y=\"101\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">6 860 кВт·ч, ≈ 2 080 BYN</text><text x=\"240\" y=\"148\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Тепловой насос, ламельное покрытие</text><rect x=\"250\" y=\"126\" width=\"22.69804066931867\" height=\"30\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"280.6980406693187\" y=\"147\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">1 530 кВт·ч, ≈ 460 BYN</text><text x=\"240\" y=\"194\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Тепловой насос, павильон и покрытие</text><rect x=\"250\" y=\"172\" width=\"8.769271388910871\" height=\"30\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"266.76927138891085\" y=\"193\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">590 кВт·ч, ≈ 180 BYN</text><text x=\"6\" y=\"226\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">COP теплового насоса 4,5 за сезон, тариф 0,3037 BYN/кВт·ч, потери открытой воды 0,25 кВт/м².</text></svg><figcaption>Покрытие и тепловой насос дают порядок экономии против ТЭНа без покрытия. Оценка модели, а не замер: считайте свой бассейн в калькуляторе.</figcaption></figure><div class=\"e-basis\"><b>Запоминалка «Три рычага счёта»</b><p>Покрытие, насос, экран. Покрытие снимает испарение, регулируемый насос и тепловой насос экономят электричество, павильон и посадка чаши в ландшафте защищают от ветра и солнца.</p></div></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Монтаж: котлован, закладные, техпомещение, зима</h3></div><ul class=\"e-ul\"><li><b>Котлован</b> с запасом 50–70 см по бортам под обсыпку и изоляцию. При высоком уровне грунтовых вод нужен дренаж по периметру: пустую чашу выдавливает, как септик.</li><li><b>Закладные до бетона и обсыпки.</b> Скиммеры на 5–10 см ниже зеркала, форсунки напротив по диагонали (мёртвые зоны в углах убирает схема подачи), свет в нишах с герметичными вводами.</li><li><b>Техпомещение</b> не дальше 10–15 м от чаши (иначе насос не поднимет трассу), с трапом и приямком для промывочных вод, вентиляцией (по практике 3–4 крата), розетками с УЗО 30 мА и местом под дозаторы; шум насоса не за стеной спальни.</li><li><b>Испытания до отделки.</b> Чаша наливом на 72 часа с отметкой уровня (утечка по практике не более 2 мм в сутки с учётом испарения), трассы давлением в 1,5 раза выше рабочего. Только потом мозаика и обсыпка.</li><li><b>Зима в Беларуси.</b> Химический бассейн по умолчанию не сливают: уровень ниже скиммера, компенсаторы объёма (демпферы или поплавки), заглушки в закладные, зимний консервант; решение по проекту и паспорту. Биопул зимует как пруд: аэратор над ямой и работающий bog. Каркасные бассейны демонтируют по паспорту.</li></ul><div class=\"e-basis\"><b>Нормативный контур Беларуси</b><p>Стационарный бассейн это капитальное сооружение, порядок его оформления уточняйте в отделе архитектуры и строительства. Указ Президента № 202 от 13.06.2022 даёт упрощённый порядок для одноквартирных домов и нежилых капитальных построек пятого класса сложности, бассейн в его тексте не назван. Отступы от границы: по публикациям об Изменении № 4 к СН 3.01.03-2020 (с 01.12.2026) нормативные расстояния для жилого дома 3 м, для хозяйственных построек 2 м, нотариальное согласие соседа их больше не заменяет; отдельная норма для бассейна не подтверждена, поэтому берите ориентир не ближе 3 м и подтверждайте письменно. Промывочные и дренажные воды нельзя отводить на соседний участок и на рельеф: их направляют в свой дренаж или канализацию. Безопасность детей ответственность владельца: покрытие, ограждение или датчик падения в воду.</p></div></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Типичные ошибки: 12 способов утопить бюджет</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. Чаша без утепления в грунте</h4><p class=\"x\">✗ Тепло уходит в землю, в помещении выпадает конденсат.</p><p class=\"v\">✓ XPS по бортам и дну, скорлупы на трассах.</p></div><div class=\"e-err\"><h4>2. Без покрытия</h4><p class=\"x\">✗ Испарение съедает основную часть нагрева, влага рушит помещение.</p><p class=\"v\">✓ Ламели или пузырьковая плёнка; в павильоне автоматика закрытия.</p></div><div class=\"e-err\"><h4>3. Насос «с запасом» без регулировки</h4><p class=\"x\">✗ Шум, размыв загрузки фильтра, лишние киловатт-часы.</p><p class=\"v\">✓ Q по обороту, регулируемый насос с сезонными профилями.</p></div><div class=\"e-err\"><h4>4. Диаметры «как у всех»</h4><p class=\"x\">✗ Кавитация на всасе, мёртвые зоны у форсунок.</p><p class=\"v\">✓ Скорости не более 1,5 и 2 м/с, диагональная схема подачи.</p></div><div class=\"e-err\"><h4>5. Гидроизоляция без испытаний</h4><p class=\"x\">✗ Течь после мозаики: вскрытие чаши.</p><p class=\"v\">✓ Налив на 72 часа с отметкой уровня до отделки, трассы под давлением.</p></div><div class=\"e-err\"><h4>6. Закладные после бетона</h4><p class=\"x\">✗ Алмазные керны ослабляют чашу и портят гидроизоляцию.</p><p class=\"v\">✓ Скиммеры, форсунки, свет до бетонирования.</p></div><div class=\"e-err\"><h4>7. Техпомещение без трапа</h4><p class=\"x\">✗ Промывка и аварии топят подвал, обслуживание невозможно.</p><p class=\"v\">✓ Трап, приямок, вентиляция, УЗО, доступ к фильтру.</p></div><div class=\"e-err\"><h4>8. Хлор без контроля pH</h4><p class=\"x\">✗ При pH 8 активна лишь пятая часть дозы: раздражение и запах при слабой дезинфекции.</p><p class=\"v\">✓ Дозаторы pH и ORP, тест-полоски как резерв.</p></div><div class=\"e-err\"><h4>9. Электролиз без совместимости металлов</h4><p class=\"x\">✗ Нержавеющие закладные и лестницы разъедает соль.</p><p class=\"v\">✓ Комплектующие с допуском под солёную воду, контроль солёности.</p></div><div class=\"e-err\"><h4>10. Биопул с хлором или регенерацией 20 %</h4><p class=\"x\">✗ Растения гибнут, прозрачность падает, система мертва.</p><p class=\"v\">✓ Без хлора, регенерация 30–50 %, приёмка по прозрачности.</p></div><div class=\"e-err\"><h4>11. Зима сливом «под ноль»</h4><p class=\"x\">✗ Грунт выдавливает пустую чашу, трещины по борту.</p><p class=\"v\">✓ Консервация с водой ниже скиммера, демпферы, заглушки, зимняя химия.</p></div><div class=\"e-err\"><h4>12. Без защиты детей</h4><p class=\"x\">✗ Открытая вода без покрытия, ограждения и сигнализации.</p><p class=\"v\">✓ Покрытие, ограждение около 1,2 м или датчик падения в воду.</p></div></div></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Приоритеты и чек-лист заказчика</h3></div><p class=\"e-lead2\">Вопросы подрядчику до договора.</p><ul class=\"e-ul\"><li>Расчёт циркуляции: расход, напор, диаметры труб и схема подачи, покажите цифры, а не «стандартный комплект»?</li><li>Чем утеплена чаша и трассы, какие испытания гидроизоляции и трасс входят в сдачу?</li><li>Техпомещение: трап, вентиляция, доступ к фильтру, всё ли на плане?</li><li>Зимний сценарий: консервация или всесезонный режим, что с покрытием и павильоном?</li><li>Безопасность: покрытие, ограждение и сигнализация в спецификации?</li><li>Куда уходят промывочные воды и как оформляется бассейн (порядок, согласования, отступы)?</li></ul><div class=\"e-basis\"><b>Красные флаги</b><p>«Чаша за неделю под ключ» без испытаний наливом; комплект без регулируемого насоса и покрытия «для экономии»; биопул с хлоратором «на всякий случай»; техпомещение без трапа; закладные после бетона; нет зимнего сценария в договоре; промывочные воды «на соседа». Любого пункта достаточно, чтобы остановиться.</p></div><p class=\"e-lead2\">Пять тезисов, с которыми можно принимать решение.</p><ul class=\"e-ul\"><li>Бассейн это четыре контура: циркуляция, водоподготовка, тепло, безопасность. Слабейший задаёт впечатление и счёт.</li><li>Тепло стоит дороже чаши: покрытие и тепловой насос дают порядок экономии, считайте по своему сезону и тарифу.</li><li>Химия или биопул это философия: хлор при дисциплине дозирования либо эстетика без реагентов при большей площади.</li><li>Закладные, изоляция и техпомещение решаются до бетона, потом только алмазное сверление и компромиссы.</li><li>Зима часть проекта: не сливать без решения проектировщика, у биопула аэратор и работающий bog; дети: покрытие, ограждение, датчик.</li></ul><p class=\"e-note\">Источники: Указ Президента Республики Беларусь № 202 от 13.06.2022; СН 3.01.03-2020 с Изменением № 4 (по публикациям, текст сверьте); паспорта оборудования. Цифры оборота, нагрузки на фильтр, УФ, электролиза, потерь и COP это ориентиры практики, а не нормативы. Оценки энергии для климата Минска, не оферта.</p></div></section><section class=\"e-panel\" id=\"pbgeo\" data-panel=\"pbgeo\"><div class=\"e-sech\"><small>02</small><h2>Параметры и паспорт бассейна</h2></div><p class=\"e-lead2\">Выберите тип и размеры: расчёт даст объём, режим оборота и предупреждения по обеззараживанию, покрытию, воде, зиме и отступам.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f wide\"><label for=\"pb-preset\">Готовый пример</label><div class=\"e-in\"><select id=\"pb-preset\"><option value=\"\" selected>Свои данные</option><option value=\"skim\">Скиммерный 8×4 м, 48 м³</option><option value=\"bio\">Биопул 10×5 м, 70 м³</option><option value=\"poly\">Полипропилен 6×3 м, 25 м³</option><option value=\"frame\">Каркасный 5×3 м, 15 м³</option></select></div></div><div class=\"e-f wide\"><label for=\"pb-type\">Тип</label><div class=\"e-in\"><select id=\"pb-type\"><option value=\"skim\" selected>Скиммерный химический</option><option value=\"over\">Переливной</option><option value=\"bio\">Биопул</option><option value=\"frame\">Каркасный сезонный</option></select></div></div><div class=\"e-f\"><label for=\"pb-L\">Длина</label><div class=\"e-in\"><input id=\"pb-L\" inputmode=\"decimal\" autocomplete=\"off\" value=\"8\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pb-W\">Ширина</label><div class=\"e-in\"><input id=\"pb-W\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pb-d\">Средняя глубина</label><div class=\"e-in\"><input id=\"pb-d\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,5\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pb-place\">Расположение</label><div class=\"e-in\"><select id=\"pb-place\"><option value=\"out\" selected>На улице</option><option value=\"pav\">Под павильоном</option><option value=\"in\">В помещении</option></select></div></div><div class=\"e-f\"><label for=\"pb-months\">Сезон</label><div class=\"e-in\"><input id=\"pb-months\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4\"><span class=\"u\">мес</span></div></div><div class=\"e-f\"><label for=\"pb-tt\">Температура воды</label><div class=\"e-in\"><input id=\"pb-tt\" inputmode=\"decimal\" autocomplete=\"off\" value=\"26\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"pb-src\">Источник воды</label><div class=\"e-in\"><select id=\"pb-src\"><option value=\"tap\" selected>Водопровод</option><option value=\"well\">Скважина</option></select></div></div><div class=\"e-f\"><label for=\"pb-cover\">Покрытие</label><div class=\"e-in\"><select id=\"pb-cover\"><option value=\"slat\" selected>Ламельное</option><option value=\"bubble\">Пузырьковая плёнка</option><option value=\"none\">Нет</option></select></div></div><div class=\"e-f\"><label for=\"pb-heat\">Нагрев</label><div class=\"e-in\"><select id=\"pb-heat\"><option value=\"hp\" selected>Тепловой насос</option><option value=\"el\">ТЭН</option><option value=\"boiler\">Котёл с теплообменником</option><option value=\"none\">Без нагрева</option></select></div></div><div class=\"e-f wide\"><label for=\"pb-dis\">Обеззараживание</label><div class=\"e-in\"><select id=\"pb-dis\"><option value=\"elecuv\" selected>Электролиз и УФ</option><option value=\"elec\">Электролиз с дозаторами</option><option value=\"dose\">Хлор с дозаторами pH/ORP</option><option value=\"chl\">Хлор вручную</option><option value=\"uv\">Только УФ (биопул)</option><option value=\"none\">Без обеззараживания (биопул)</option></select></div></div><div class=\"e-f\"><label for=\"pb-bath\">Купающихся одновременно</label><div class=\"e-in\"><input id=\"pb-bath\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4\"><span class=\"u\">чел</span></div></div><div class=\"e-f\"><label for=\"pb-bud\">Класс оборудования</label><div class=\"e-in\"><select id=\"pb-bud\"><option value=\"std\" selected>Стандарт</option><option value=\"eco\">Эконом (нерегулируемый насос)</option><option value=\"prem\">Премиум</option></select></div></div><div class=\"e-f\"><label for=\"pb-bd\">Расстояние до границы соседа</label><div class=\"e-in\"><input id=\"pb-bd\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pb-reg\">Зона регенерации (биопул)</label><div class=\"e-in\"><input id=\"pb-reg\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">% площади</span></div></div><div class=\"e-f wide\"><label for=\"pb-drain\">Куда уходят промывочные воды</label><div class=\"e-in\"><select id=\"pb-drain\"><option value=\"own\" selected>В свой дренаж или канализацию</option><option value=\"relief\">На рельеф своего участка</option><option value=\"neighbor\">На соседний участок или за границу</option></select></div></div><div class=\"e-f wide\"><label for=\"pb-win\">Зима</label><div class=\"e-in\"><select id=\"pb-win\"><option value=\"cons\" selected>Консервация с водой ниже скиммера</option><option value=\"drain\">Слив чаши</option><option value=\"dis\">Демонтаж (каркасный)</option><option value=\"none\">Не выбрано</option></select></div></div><div class=\"e-f\"><label for=\"pb-safe\">Защита детей</label><div class=\"e-in\"><select id=\"pb-safe\"><option value=\"cover\" selected>Покрытие</option><option value=\"fence\">Ограждение 1,2 м</option><option value=\"alarm\">Датчик падения в воду</option><option value=\"none\">Нет</option></select></div></div><div class=\"e-formula\">S = L · W, V = S · глубина<br>Предупреждения: обеззараживание, покрытие, зона регенерации, отступ, вода, зима, дети</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Паспорт</span><div class=\"kv\"><span>Зеркало</span><b id=\"pb-s\">—</b></div><div class=\"kv\"><span>Объём воды</span><b id=\"pb-v\">—</b></div><div class=\"kv\"><span>Тип и оборот</span><b id=\"pb-k\">—</b></div><div class=\"verdict\" id=\"pb-verdict\" role=\"status\"></div></div></div></div><figure class=\"e-fig\"><div id=\"pb-ch\"></div><figcaption id=\"pb-chn\"></figcaption></figure></section><section class=\"e-panel\" id=\"pbcirc\" data-panel=\"pbcirc\"><div class=\"e-sech\"><small>03</small><h2>Циркуляция и водоподготовка</h2></div><p class=\"e-lead2\">Расход и класс насоса, фильтр, диаметры труб по скоростям, закладные, обеззараживание и вода на промывку. Диапазоны это ориентиры практики, модель подбирают по паспорту.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f\"><label for=\"pb-H\">Напор системы</label><div class=\"e-in\"><input id=\"pb-H\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pb-ph\">Часов работы насоса в сутки</label><div class=\"e-in\"><input id=\"pb-ph\" inputmode=\"decimal\" autocomplete=\"off\" value=\"12\"><span class=\"u\">ч</span></div></div><div class=\"e-formula\">Q = V / t оборота, P = Q · H / (367 · КПД)<br>Фильтр: площадь = Q / 40 м³/ч·м², трубы по скорости не более 1,5 м/с на всасе и 2 м/с на напоре</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Расход и напор</span><b id=\"pb-q\">—</b></div><div class=\"kv\"><span>Насос</span><b id=\"pb-pump\">—</b></div><div class=\"kv\"><span>Фильтр</span><b id=\"pb-filt\">—</b></div><div class=\"kv\"><span>Трубы</span><b id=\"pb-pipes\">—</b></div><div class=\"kv\"><span>Закладные</span><b id=\"pb-emb\">—</b></div><div class=\"kv\"><span>Обеззараживание</span><b id=\"pb-dis-o\">—</b></div><div class=\"kv\"><span>Промывка</span><b id=\"pb-wash\">—</b></div><div class=\"kv\"><span>Свежая вода</span><b id=\"pb-fresh\">—</b></div><div class=\"verdict\" id=\"pb-v1\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"pbheat\" data-panel=\"pbheat\"><div class=\"e-sech\"><small>04</small><h2>Нагрев и энергия сезона</h2></div><p class=\"e-lead2\">Потери по площади зеркала, место и покрытие, первичный нагрев, подбор теплового насоса и электричество за сезон. Допущения вы задаёте сами.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f\"><label for=\"pb-ts\">Температура воды в начале сезона</label><div class=\"e-in\"><input id=\"pb-ts\" inputmode=\"decimal\" autocomplete=\"off\" value=\"15\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"pb-t0\">Время первичного нагрева</label><div class=\"e-in\"><input id=\"pb-t0\" inputmode=\"decimal\" autocomplete=\"off\" value=\"24\"><span class=\"u\">ч</span></div></div><div class=\"e-f\"><label for=\"pb-cop\">COP теплового насоса за сезон</label><div class=\"e-in\"><input id=\"pb-cop\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4,5\"></div></div><div class=\"e-f\"><label for=\"pb-tar\">Тариф</label><div class=\"e-in\"><input id=\"pb-tar\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,3037\"><span class=\"u\">BYN/кВт·ч</span></div></div><div class=\"e-formula\">Потери = S · 0,25 кВт/м² · k<sub>места</sub> · k<sub>покрытия</sub>; E = Потери · часы + V · 1,163 · ΔT; E<sub>эл</sub> = E / COP</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Потери</span><b id=\"pb-loss\">—</b></div><div class=\"kv\"><span>Первичный нагрев</span><b id=\"pb-p0\">—</b></div><div class=\"kv\"><span>Тепловой насос</span><b id=\"pb-hp\">—</b></div><div class=\"kv\"><span>Тепло за сезон</span><b id=\"pb-eh\">—</b></div><div class=\"kv\"><span>Электричество на нагрев</span><b id=\"pb-ee\">—</b></div><div class=\"kv\"><span>Стоимость нагрева</span><b id=\"pb-cost\">—</b></div><div class=\"kv\"><span>С покрытием и без</span><b id=\"pb-cmp\">—</b></div><div class=\"kv\"><span>Электричество в сутки</span><b id=\"pb-day\">—</b></div><div class=\"kv\"><span>Всего за сезон</span><b id=\"pb-seas\">—</b></div><div class=\"verdict\" id=\"pb-v2\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"pbbio\" data-panel=\"pbbio\" data-xtbl=\"1\"><div class=\"e-sech\"><small>05</small><h2>Биопул и растения</h2></div><p class=\"e-lead2\">Зона регенерации, bog-фильтр и посадочная ведомость. Работает для типа «Биопул», каталог растений общий с калькулятором пруда.</p><div class=\"e-calc\"><div class=\"e-form\"><p class=\"e-note\">Параметры берутся с первой вкладки: размеры, глубина и доля зоны регенерации.</p><div class=\"e-formula\">Растений = площадь регенерации · 8 шт/м²; щебень = площадь · 0,3 м</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Зона регенерации</span><b id=\"pb-bio-r\">—</b></div><div class=\"kv\"><span>Bog-фильтр</span><b id=\"pb-bio-g\">—</b></div><div class=\"kv\"><span>Насос</span><b id=\"pb-bio-p\">—</b></div><div class=\"kv\"><span>Растений</span><b id=\"pb-bio-n\">—</b></div><div class=\"verdict\" id=\"pb-v3\" role=\"status\"></div></div></div></div><h4 class=\"e-h4\">Посадочная ведомость</h4><div id=\"pb-pt\"></div></section><section class=\"e-panel\" id=\"pbbud\" data-panel=\"pbbud\" data-xtbl=\"1\"><div class=\"e-sech\"><small>06</small><h2>Смета-ведомость</h2></div><p class=\"e-lead2\">Количества берутся из расчёта. Цены не заложены: введите цены из ваших предложений, сумма пересчитается.</p><div class=\"e-calc\"><div class=\"e-form\"><p class=\"e-note\"><b>Ваши цены за единицу</b></p><div class=\"e-f\"><label for=\"pb-p-bowl\">Чаша, за м³ объёма</label><div class=\"e-in\"><input id=\"pb-p-bowl\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-fin\">Отделка, за м²</label><div class=\"e-in\"><input id=\"pb-p-fin\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-pump\">Насос, за шт</label><div class=\"e-in\"><input id=\"pb-p-pump\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-filt\">Фильтр, за шт</label><div class=\"e-in\"><input id=\"pb-p-filt\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-grav\">Щебень bog-фильтра, за м³</label><div class=\"e-in\"><input id=\"pb-p-grav\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-skim\">Скиммер, за шт</label><div class=\"e-in\"><input id=\"pb-p-skim\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-noz\">Форсунка, за шт</label><div class=\"e-in\"><input id=\"pb-p-noz\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-cell\">Ячейка электролиза, за шт</label><div class=\"e-in\"><input id=\"pb-p-cell\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-uv\">УФ-установка, за шт</label><div class=\"e-in\"><input id=\"pb-p-uv\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-dos\">Дозатор pH и ORP, за комплект</label><div class=\"e-in\"><input id=\"pb-p-dos\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-hp\">Тепловой насос, за шт</label><div class=\"e-in\"><input id=\"pb-p-hp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-cov\">Покрытие, за м²</label><div class=\"e-in\"><input id=\"pb-p-cov\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-fence\">Ограждение, за м</label><div class=\"e-in\"><input id=\"pb-p-fence\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-alarm\">Датчик падения в воду, за шт</label><div class=\"e-in\"><input id=\"pb-p-alarm\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"pb-p-plant\">Растение, за шт (средняя)</label><div class=\"e-in\"><input id=\"pb-p-plant\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><button class=\"e-btn sm\" id=\"pb-p-reset\" type=\"button\">Очистить цены</button><div class=\"e-formula\">Сумма = Σ (количество · ваша цена за единицу)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Позиций с ценой</span><b id=\"pb-b-n\">—</b></div><div class=\"kv\"><span>Итого</span><b id=\"pb-b-sum\">—</b></div><div class=\"verdict\" id=\"pb-b-verdict\" role=\"status\"></div></div></div></div><h4 class=\"e-h4\">Ведомость</h4><div id=\"pb-bt\"></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Это ориентировочный расчёт для разговора с подрядчиком, а не проект. Оборот, нагрузка на фильтр, УФ, электролиз, потери тепла и COP это ориентиры практики, зимой потери больше, чем в летней модели. Модель оборудования подбирают по паспорту. Порядок оформления стационарного бассейна, отступы от границы и санитарные требования к воде проверяйте по действующим актам и в местной администрации до начала работ.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/pond-model.js?v=1\"></script><script src=\"/static/pool-model.js?v=1\"></script><script src=\"/static/pool.js?v=1\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstBathTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Бани и сауны</div><h1>Бани и сауны: расчёт и статья</h1><p class=\"e-lead\">Печь или парогенератор, линия питания, вентиляция, погонаж материалов, хамам, камни, энергия за процедуру и ведомость.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\" class=\"on\" aria-current=\"page\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Бани и сауны\"><a href=\"#btart\" data-sub=\"btart\" class=\"art\">Статья</a><a href=\"#bageo\" data-sub=\"bageo\">Параметры</a><a href=\"#baheat\" data-sub=\"baheat\">Печь и электрика</a><a href=\"#baenc\" data-sub=\"baenc\">Ограждения</a><a href=\"#baham\" data-sub=\"baham\">Хамам</a><a href=\"#babud\" data-sub=\"babud\">Смета</a></div><div class=\"e-elec\" id=\"e-ba\"><section class=\"e-panel\" id=\"btart\" data-panel=\"btart\"><div class=\"e-sech\"><small>01</small><h2>Бани и сауны: режимы, ограждения, печи, безопасность</h2></div><p class=\"e-lead2\">Режим как точка на карте, пирог стен, печи и камни, электрика, пожар и угарный газ, хамам, монтаж и типовые ошибки.</p><div class=\"e-kpis\"><div class=\"e-kpi\"><b>80–100 °C</b><span>финская сауна при 10–20 % влажности; хамам 40–50 °C при 90–100 %</span></div><div class=\"e-kpi\"><b>1,1 кВт/м³</b><span>печь сауны: объём × 1,1 плюс 0,5 кВт на каждый м² стекла и неутеплённых стен</span></div><div class=\"e-kpi\"><b>3–6 об/ч</b><span>вентиляция парной: без неё CO₂ и сырость</span></div><div class=\"e-kpi\"><b>1–2 %</b><span>уклон пола хамама к трапу</span></div></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 150\" role=\"img\" aria-label=\"Шесть шагов проектирования бани\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"6\" y=\"14\" width=\"115\" height=\"96\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"18\" y=\"42\" font-size=\"22\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">1</text><text x=\"18\" y=\"66\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Режим</text><text x=\"18\" y=\"84\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">температура</text><text x=\"18\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">и влажность</text><line x1=\"122\" y1=\"62\" x2=\"130\" y2=\"62\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"130,62 121.9,65.9 121.9,58.1\" fill=\"#4a4d55\"/><rect x=\"131\" y=\"14\" width=\"115\" height=\"96\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"143\" y=\"42\" font-size=\"22\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">2</text><text x=\"143\" y=\"66\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Объём</text><text x=\"143\" y=\"84\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">размеры</text><text x=\"143\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">парной</text><line x1=\"247\" y1=\"62\" x2=\"255\" y2=\"62\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"255,62 246.9,65.9 246.9,58.1\" fill=\"#4a4d55\"/><rect x=\"256\" y=\"14\" width=\"115\" height=\"96\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"268\" y=\"42\" font-size=\"22\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">3</text><text x=\"268\" y=\"66\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Ограждения</text><text x=\"268\" y=\"84\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">пирог и</text><text x=\"268\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">вентиляция</text><line x1=\"372\" y1=\"62\" x2=\"380\" y2=\"62\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"380,62 371.9,65.9 371.9,58.1\" fill=\"#4a4d55\"/><rect x=\"381\" y=\"14\" width=\"115\" height=\"96\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"393\" y=\"42\" font-size=\"22\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">4</text><text x=\"393\" y=\"66\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Печь</text><text x=\"393\" y=\"84\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">мощность</text><text x=\"393\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">по объёму</text><line x1=\"497\" y1=\"62\" x2=\"505\" y2=\"62\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"505,62 496.9,65.9 496.9,58.1\" fill=\"#4a4d55\"/><rect x=\"506\" y=\"14\" width=\"115\" height=\"96\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"518\" y=\"42\" font-size=\"22\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">5</text><text x=\"518\" y=\"66\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Электрика</text><text x=\"518\" y=\"84\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">сечение, защита,</text><text x=\"518\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">пожар</text><line x1=\"622\" y1=\"62\" x2=\"630\" y2=\"62\" stroke=\"#4a4d55\" stroke-width=\"2\"/><polygon points=\"630,62 621.9,65.9 621.9,58.1\" fill=\"#4a4d55\"/><rect x=\"631\" y=\"14\" width=\"115\" height=\"96\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"643\" y=\"42\" font-size=\"22\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">6</text><text x=\"643\" y=\"66\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Отделка и пуск</text><text x=\"643\" y=\"84\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">тесты до</text><text x=\"643\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">облицовки</text><text x=\"6\" y=\"136\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Начинают с режима, а не с печи из каталога. Перестановка шагов даёт типичные переделки: недогрев, сырость, выбитый автомат.</text></svg><figcaption>Порядок решений: сначала режим, потом ограждения и печь, электрика и пожарные узлы, и только в конце отделка.</figcaption></figure><div class=\"e-basis\"><b>Главный принцип</b><p>Режим, ограждения, печь, электрика. Сначала выбирают точку «температура-влажность», под неё проектируют пирог стен и вентиляцию, затем считают мощность печи по объёму, и только потом сечения кабеля и защиту. Начало с «красивой печки из каталога» заканчивается недогревом, сыростью или выбитым вводным автоматом.</p></div><div class=\"e-art\" id=\"art0\"><div class=\"e-sech\"><small>0</small><h3>Суть: режим задаёт всё</h3></div><p class=\"e-lead2\">Баня начинается с точки на графике «температура-влажность». Финская сауна: 80–100 °C при 10–20 % влажности, жар сухой, нагрузка на ограждения и электрику максимальная. Русская баня: 60–70 °C при 40–60 %, характер даёт пар из закрытой каменки. Хамам: 40–50 °C при 90–100 %, здесь греют не воздух, а поверхности (пол, полки, стены), пар подаёт генератор. ИК-кабина: 45–60 °C локального прогрева излучением. От точки на карте следуют тип печи, пирог ограждений, вентиляция, электрика и даже порода дерева.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 330\" role=\"img\" aria-label=\"Карта температура-влажность для четырёх режимов\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"70\" y=\"20\" width=\"640\" height=\"270\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"70\" y1=\"260.0\" x2=\"710\" y2=\"260.0\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"62\" y=\"264.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">30</text><line x1=\"70\" y1=\"200.0\" x2=\"710\" y2=\"200.0\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"62\" y=\"204.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">50</text><line x1=\"70\" y1=\"140.0\" x2=\"710\" y2=\"140.0\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"62\" y=\"144.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">70</text><line x1=\"70\" y1=\"80.0\" x2=\"710\" y2=\"80.0\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"62\" y=\"84.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">90</text><line x1=\"70\" y1=\"20.0\" x2=\"710\" y2=\"20.0\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"62\" y=\"24.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">110</text><line x1=\"70.0\" y1=\"20\" x2=\"70.0\" y2=\"290\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"70.0\" y=\"306\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><line x1=\"198.0\" y1=\"20\" x2=\"198.0\" y2=\"290\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"198.0\" y=\"306\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><line x1=\"326.0\" y1=\"20\" x2=\"326.0\" y2=\"290\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"326.0\" y=\"306\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">40</text><line x1=\"454.0\" y1=\"20\" x2=\"454.0\" y2=\"290\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"454.0\" y=\"306\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">60</text><line x1=\"582.0\" y1=\"20\" x2=\"582.0\" y2=\"290\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"582.0\" y=\"306\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">80</text><line x1=\"710.0\" y1=\"20\" x2=\"710.0\" y2=\"290\" stroke=\"#c6c8cd\" stroke-width=\"1\" stroke-dasharray=\"3 4\"/><text x=\"710.0\" y=\"306\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">100</text><text x=\"34\" y=\"24\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">°C</text><text x=\"710\" y=\"322\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">относительная влажность, %</text><rect x=\"134.0\" y=\"50.0\" width=\"64.0\" height=\"60.0\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"326.0\" y=\"140.0\" width=\"128.0\" height=\"30.0\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"646.0\" y=\"200.0\" width=\"64.0\" height=\"30.0\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"134.0\" y=\"170.0\" width=\"128.0\" height=\"45.0\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"140.0\" y=\"42.0\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">Финская сауна: 80–100 °C, 10–20 %</text><text x=\"330.0\" y=\"132.0\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">Русская баня: 60–70 °C, 40–60 %</text><text x=\"710.0\" y=\"192.0\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"end\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">Хамам: 40–50 °C, 90–100 %</text><text x=\"134.0\" y=\"233.0\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">ИК-кабина: 45–60 °C, воздух сухой</text></svg><figcaption>Режим это точка и область на карте. От неё зависят тип печи, ограждения, вентиляция и электрика. Диапазоны ориентиры практики, не нормативы.</figcaption></figure><p class=\"e-note\">Гибридные кабины (сауна, пар и мягкий режим вроде 60 °C и 40 % в одном объёме) ходят по этой карте, но требуют усиленной изоляции и расчёта электрики на одновременную работу каменки и генератора.</p></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Типы бань: встроенные и отдельно стоящие</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Тип</th><th>Режим и сердце</th><th>Ограждения</th><th>Срок (по практике)</th></tr></thead><tbody><tr><td>Финская сауна встроенная</td><td>80–100 °C, 10–20 %; электрокаменка, 1,0–1,4 кВт/м³</td><td>Каркас с базальтовой ватой и фольгой внутри дома или цоколя</td><td>2–4 недели</td></tr><tr><td>Русская баня отдельно стоящая</td><td>60–70 °C, 40–60 %; дровяная печь с закрытой каменкой</td><td>Бревно, брус или каркас; парная, моечная, предбанник</td><td>1–2 сезона с усадкой сруба</td></tr><tr><td>Хамам</td><td>40–50 °C, 90–100 %; парогенератор и греющие поверхности</td><td>Гидроизоляция «корытом», XPS, мозаика, уклоны и трап</td><td>4–8 недель</td></tr><tr><td>ИК-кабина</td><td>45–60 °C, излучение; панели около 1 кВт/м³ объёма</td><td>Готовая кабина или ниша</td><td>день монтажа</td></tr><tr><td>Гибрид</td><td>Профили вроде 90/10, 70/40, 60/60 в одной кабине</td><td>Усиленная изоляция, парогенератор и каменка</td><td>по проекту и паспорту</td></tr></tbody></table></div><p class=\"e-note\">Тенденции последних лет: гибридные кабины, умное управление с отложенным прогревом и датчиками, баррель-сауны и уличные модули, термомодифицированная древесина, утеплённые двери с магнитным притвором. Данные по объёмам рынка и производителям здесь не приводятся: наличие и поддержка в Беларуси меняются, сверяйтесь с поставщиком.</p></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Ограждения и материалы: пирог, который держит режим</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 224\" role=\"img\" aria-label=\"Пирог стены сауны\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"40\" y=\"24\" width=\"120\" height=\"120\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><rect x=\"160\" y=\"24\" width=\"100\" height=\"120\" rx=\"0\" fill=\"#e8d9a8\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><rect x=\"260\" y=\"24\" width=\"8\" height=\"120\" rx=\"0\" fill=\"#7d8089\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><rect x=\"268\" y=\"24\" width=\"40\" height=\"120\" rx=\"0\" fill=\"#ffffff\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><rect x=\"308\" y=\"24\" width=\"50\" height=\"120\" rx=\"0\" fill=\"#c9a56b\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"404\" y1=\"86\" x2=\"366\" y2=\"86\" stroke=\"#e3000f\" stroke-width=\"2\"/><polygon points=\"366,86 374.1,82.1 374.1,89.9\" fill=\"#e3000f\"/><text x=\"366\" y=\"74\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"700\">парная</text><line x1=\"100.0\" y1=\"144\" x2=\"100.0\" y2=\"156\" stroke=\"#7d8089\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"100.0\" y=\"170\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Стена</text><line x1=\"210.0\" y1=\"144\" x2=\"210.0\" y2=\"180\" stroke=\"#7d8089\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"210.0\" y=\"194\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Базальтовая вата</text><line x1=\"264.0\" y1=\"144\" x2=\"264.0\" y2=\"204\" stroke=\"#7d8089\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"264.0\" y=\"218\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Алюминиевая фольга</text><line x1=\"288.0\" y1=\"144\" x2=\"288.0\" y2=\"156\" stroke=\"#7d8089\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"288.0\" y=\"170\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Вентзазор</text><line x1=\"333.0\" y1=\"144\" x2=\"333.0\" y2=\"180\" stroke=\"#7d8089\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"333.0\" y=\"194\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Вагонка</text><text x=\"440\" y=\"44\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Разрез стены сауны</text><text x=\"440\" y=\"68\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">слои слева направо: стена, парная справа</text><text x=\"440\" y=\"96\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Фольга одна и непрерывная: это и</text><text x=\"440\" y=\"114\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">пароизоляция, и отражатель тепла.</text><text x=\"440\" y=\"132\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Без неё вата отсыревает.</text><text x=\"440\" y=\"160\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Потолок: вата 100 мм, тот же порядок слоёв.</text></svg><figcaption>Порядок слоёв и зазор важнее толщины ваты. Пенопласт в парной не применяют: только базальтовая вата.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Порода</th><th>Плюсы</th><th>Минусы</th><th>Куда</th></tr></thead><tbody><tr><td>Липа</td><td>Не смолит, мягкий жар, светлый тон</td><td>Цена выше осины</td><td>Потолок и полки</td></tr><tr><td>Ольха</td><td>Аромат, стойкость к влаге</td><td>Тон темнеет</td><td>Парная и моечная</td></tr><tr><td>Осина</td><td>Недорого, почти не греется</td><td>Сереет без масла</td><td>Бюджетные парные</td></tr><tr><td>Абаш (обече)</td><td>Мягкая малотеплопроводная порода, не обжигает</td><td>Цена, поставка под заказ</td><td>Полки</td></tr><tr><td>Термомодифицированная сосна, ясень</td><td>Стабильна геометрия, не смолит</td><td>Хрупче на излом</td><td>Стены, террасы, баррели</td></tr><tr><td>Кедр</td><td>Аромат, цвет</td><td>Сибирский смолист; красный канадский почти без смолы, дороже</td><td>Акцентные вставки</td></tr></tbody></table></div><ul class=\"e-ul\"><li><b>Фольга обязательна и непрерывна.</b> Стыки проклеены алюмоскотчем, выводы кабелей и труб идут через термовтулки. Без фольги утеплитель отсыревает и теряет теплозащитные свойства.</li><li><b>Вентзазор около 20 мм</b> между фольгой и вагонкой: конденсат с вагонки стекает, древесина просыхает равномерно. Вагонка на кляймерах, без гвоздей в лицо.</li><li><b>Потолок</b> самое горячее место: вата 100 мм вместо 50 на стенах, проход дымохода отдельный узел с разделкой.</li><li><b>Запрещены в сауне и русской парной:</b> пенопласт и XPS (плавятся и выделяют вредные вещества при нагреве), ПВХ и линолеум, хвойная вагонка с выходом смолы на полках, металл без деревянных накладок (ожоги).</li><li><b>Пол:</b> керамогранит с шероховатой поверхностью и уклоном к трапу в моечной и хамаме; в парной сверху деревянные решётки (тёплый ход и безопасность).</li></ul></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Печи, парогенераторы и камни</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Сердце</th><th>Подбор</th><th>Камни и пар</th><th>Нюансы</th></tr></thead><tbody><tr><td>Электрокаменка (сауна)</td><td>Объём × 1,1 кВт + 0,5 кВт на каждый м² стекла и неутеплённых стен; коридор 1,0–1,4 кВт/м³</td><td>Открытая каменка, масса камней по паспорту (ориентир в калькуляторе 8 кг на м³)</td><td>Ряд мощностей 4,5, 6, 8, 9, 10,5, 12, 13,5 кВт; защита от перегрева, ТЭНы расходник</td></tr><tr><td>Дровяная печь (русская)</td><td>По паспорту на объём парной с запасом около 20 %; закрытая каменка</td><td>Камни около 10–15 кг на м³, не менее 100 кг (в калькуляторе 12 кг/м³)</td><td>Дымоход с разделкой, зольник вне парной, датчик CO</td></tr><tr><td>Парогенератор (хамам)</td><td>1,5–2,0 кВт/м³; в калькуляторе 1,8</td><td>Греют поверхности, а не воздух</td><td>Умягчение воды и автодренаж; накипь без них за сезон</td></tr><tr><td>ИК-панели</td><td>Около 1 кВт/м³, зоны: спина, ноги, грудь</td><td>Без пара</td><td>Низкое потребление; нет банного ритуала</td></tr><tr><td>Гибрид</td><td>Каменка по формуле сауны плюс парогенератор</td><td>Профили влажности</td><td>Паспорт кабины задаёт режимы</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Стекло и неутеплённые поверхности.</b> Паспорта электрокаменок обычно требуют считать каждый квадратный метр стекла или кирпичной стены как добавку к объёму (типичная формулировка около 1,2 м³ на м²). Калькулятор берёт упрощённо 0,5 кВт на м², для панорамных стен сверьтесь с паспортом выбранной печи.</p><p class=\"e-lead2\"><b>Камни.</b> Подходят плотные магматические породы (габбро-диабаз, жадеит, малиновый кварцит). Речную гальку, пористые и слоистые камни не берут: влага внутри раскалывает их при нагреве. Камни перебирают и моют раз в 1–2 сезона, заменяют в среднем раз в 3–5 лет (по практике). Масса камней электрокаменки определяется ёмкостью корпуса по паспорту, цифра в калькуляторе только для заказа комплектов по 20 кг.</p><p class=\"e-note\">Хамам: критична не масса камней, а вода. Парогенератор без умягчителя обрастает накипью за сезон, поэтому умягчитель и автодренаж закладывают в смету сразу.</p></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Электрика: от мощности к сечению</h3></div><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Мощность прибора</th><th>Ввод</th><th>Кабель</th><th>Автомат</th><th>Ток</th></tr></thead><tbody><tr><td>до 3,5 кВт</td><td>220 В</td><td>3×2,5 мм²</td><td>16 А</td><td>до 15,9 А</td></tr><tr><td>3,5–7 кВт</td><td>220 В</td><td>3×6 мм²</td><td>32 А</td><td>до 31,8 А</td></tr><tr><td>7–9 кВт</td><td>380 В</td><td>5×2,5 мм²</td><td>16 А</td><td>до 13,7 А</td></tr><tr><td>9–12 кВт</td><td>380 В</td><td>5×4 мм²</td><td>20 А</td><td>до 18,2 А</td></tr><tr><td>12–16 кВт</td><td>380 В</td><td>5×6 мм²</td><td>25 А</td><td>до 24,3 А</td></tr><tr><td>16–20 кВт</td><td>380 В</td><td>5×6 мм²</td><td>32 А</td><td>до 30,4 А</td></tr><tr><td>20–24 кВт</td><td>380 В</td><td>5×10 мм²</td><td>40 А</td><td>до 36,5 А</td></tr></tbody></table></div><ul class=\"e-ul\"><li>Таблица это ориентир практики для ТЭНов (cos φ = 1) и медного кабеля; окончательно линию и автомат выбирает электрик по способу прокладки и длине (см. раздел «Электрика»). Ток трёхфазной линии равен P / (√3 · 380).</li><li><b>Граница 380 В.</b> Печь 8 кВт и больше в практике ставят на трёхфазный ввод: на одну фазу это более 36 А. Это не абсолютный запрет, а вопрос возможностей ввода и технических условий энергоснабжения, паспорт печи указывает схему подключения.</li><li>Участок от автомата до печи: термостойкий кабель (силикон, РКГМ) в негорючей гофре или металлорукаве, без розеток и скруток; УЗО на 30 мА на линию.</li><li>Выключатель и панель управления вне парной. Светильники в парной с высоким IP и термостойкие по паспорту, провода внутри парной только термостойкие.</li><li>Хамам: парогенератор и обогрев поверхностей это две линии. Греющие маты пола и полок включают и проверяют до мозаики.</li></ul><figure class=\"e-fig\"><svg viewBox=\"0 0 760 236\" role=\"img\" aria-label=\"Схема вентиляции парной\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"60\" y=\"20\" width=\"380\" height=\"180\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"3\"/><line x1=\"60\" y1=\"178\" x2=\"440\" y2=\"178\" stroke=\"#7d8089\" stroke-width=\"1\" stroke-dasharray=\"4 4\"/><rect x=\"290\" y=\"80\" width=\"150\" height=\"10\" rx=\"0\" fill=\"#c9a56b\" stroke=\"#1d1f23\" stroke-width=\"1\"/><rect x=\"350\" y=\"130\" width=\"90\" height=\"10\" rx=\"0\" fill=\"#c9a56b\" stroke=\"#1d1f23\" stroke-width=\"1\"/><rect x=\"82\" y=\"122\" width=\"50\" height=\"56\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"107\" y=\"156\" font-size=\"11\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">печь</text><line x1=\"24\" y1=\"184\" x2=\"70\" y2=\"184\" stroke=\"#e3000f\" stroke-width=\"3\"/><polygon points=\"70,184 61.9,187.9 61.9,180.1\" fill=\"#e3000f\"/><text x=\"6\" y=\"176\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"700\">приток</text><line x1=\"434\" y1=\"158\" x2=\"480\" y2=\"158\" stroke=\"#1d1f23\" stroke-width=\"3\"/><polygon points=\"480,158 471.9,161.9 471.9,154.1\" fill=\"#1d1f23\"/><text x=\"486\" y=\"162\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">вытяжка (сушка)</text><line x1=\"370\" y1=\"26\" x2=\"370\" y2=\"8\" stroke=\"#1d1f23\" stroke-width=\"3\"/><polygon points=\"370,8 373.9,16.1 366.1,16.1\" fill=\"#1d1f23\"/><text x=\"378\" y=\"18\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">верхний клапан (залп)</text><polyline points=\"107,116 190,110 370,110 434,158\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"2\" stroke-dasharray=\"5 4\" stroke-linejoin=\"round\"/><text x=\"486\" y=\"60\" font-size=\"16\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">3–6 об/ч</text><text x=\"486\" y=\"80\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">приток под печь,</text><text x=\"486\" y=\"96\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">вытяжка по диагонали</text><text x=\"486\" y=\"116\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">на улицу, не в общую</text><text x=\"486\" y=\"132\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">вентиляцию дома</text></svg><figcaption>Классика: приток под печь, вытяжка диагонально с двумя клапанами, нижний для сушки и верхний для залпового проветривания после процедуры.</figcaption></figure><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Расход воздуха Q = V × кратность</th><th>Воздуховод</th><th>Клапаны</th></tr></thead><tbody><tr><td>до 100 м³/ч</td><td>Ø100 мм</td><td>Приток под печь, вытяжка диагонально</td></tr><tr><td>100–160 м³/ч</td><td>Ø125 мм</td><td>Нижний для сушки и верхний для залпа</td></tr><tr><td>160–250 м³/ч</td><td>Ø150 мм</td><td>Вытяжка на улицу, не в общую вентиляцию дома</td></tr></tbody></table></div><p class=\"e-note\">Кратность 3–6 об/ч это ориентир практики; в калькуляторе 5 для сауны и русской бани, 3 для хамама, где вытяжку используют для просушки вне процедуры.</p></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Пожар и угарный газ</h3></div><ul class=\"e-ul\"><li><b>Отступки и разделки.</b> Расстояния от печи до стен и перекрытия задаёт паспорт, ориентир практики для дровяной печи не менее 500 мм до защищённой стены (металл по базальту) и около 1 м до незащищённой. Проход перекрытия через разделку, перед топкой предтопочный лист (в калькуляторе 500×700 мм).</li><li><b>Дымоход.</b> Сэндвич-труба, горизонтальные участки сводят к минимуму, ход дыма всегда вверх, конденсатоотвод и ревизия. По практике не менее 5 м от колосника до оголовка, оголовок выше конька. В срубе на проходе нужен осадочный компенсатор. Чистка и ревизия два раза в год.</li><li><b>Угарный газ</b> без запаха. Правило №1 инструктажа: заслонку закрывают только после полного прогорания углей. Датчик CO с сиреной дублирует дисциплину. Нормативное требование для частной бани не подтверждено, но датчик ставят всегда.</li><li><b>Дверь парной открывается наружу</b> и закрывается без защёлок и замков, стекло закалённое 8 мм с магнитным притвором.</li><li>Дрова не складывают вплотную к печи и стене парной. Золу хранят в металлической ёмкости с крышкой вне построек до полного остывания.</li></ul><div class=\"e-basis\"><b>Запоминалка «Пар любит порядок»</b><p>Фольга, зазор, приток. Непрерывная фольга, вентзазор около 20 мм и вентиляция 3–6 об/ч. Без любого из трёх парная либо гниёт, либо душит, либо не держит жар.</p></div></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Хамам: гидроизоляция, уклон и обогрев поверхностей</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 226\" role=\"img\" aria-label=\"Разрез хамама: гидроизоляция корытом и уклон к трапу\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"36\" y=\"28\" width=\"14\" height=\"150\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><rect x=\"470\" y=\"28\" width=\"14\" height=\"150\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><polyline points=\"50,34 50,164 470,154 470,34\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"4\" stroke-linejoin=\"round\"/><polyline points=\"50,170 430,160 430,178\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"2\" stroke-linejoin=\"round\"/><rect x=\"400\" y=\"160\" width=\"40\" height=\"10\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"420\" y=\"196\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">трап</text><text x=\"62\" y=\"54\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">облицовка: мозаика на клее</text><text x=\"62\" y=\"72\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">по гидроизоляции и XPS</text><rect x=\"90\" y=\"108\" width=\"160\" height=\"12\" rx=\"0\" fill=\"#c9a56b\" stroke=\"#1d1f23\" stroke-width=\"1\"/><text x=\"170\" y=\"104\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">полка с греющим матом</text><text x=\"62\" y=\"196\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"700\">уклон 1–2 %</text><line x1=\"180\" y1=\"158\" x2=\"380\" y2=\"152\" stroke=\"#e3000f\" stroke-width=\"2\"/><polygon points=\"380,152 372.0,156.2 371.8,148.3\" fill=\"#e3000f\"/><text x=\"510\" y=\"58\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Гидроизоляция корытом:</text><text x=\"510\" y=\"78\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">красная линия идёт по полу и</text><text x=\"510\" y=\"94\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">заходит на стены выше пола,</text><text x=\"510\" y=\"110\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">высоту задаёт система</text><text x=\"510\" y=\"136\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Мат полок и пола включают</text><text x=\"510\" y=\"152\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">и проверяют до мозаики.</text></svg><figcaption>Вода из хамама должна уйти в трап, а не в перекрытие. Высоту захода на стены и узлы проекта задаёт гидроизоляционная система производителя.</figcaption></figure><ul class=\"e-ul\"><li><b>Порядок слоёв:</b> основание, плотный XPS 30–50 мм, гидроизоляция «корытом» с заходом на стены, клей, мозаика или плитка. Вата в хамаме намокает, ППС впитывает воду.</li><li><b>Уклон 1–2 %</b> к трапу: на каждый метр 10–20 мм. Трап с гидрозатвором и подогревом.</li><li><b>Обогрев поверхностей:</b> ориентир практики 160 Вт/м² пол, 120 Вт/м² полки, 90 Вт/м² стены. Тест нагрева поверхностей до 40–45 °C проводят до мозаики и сдают протоколом.</li><li><b>Парогенератор:</b> 1,5–2,0 кВт/м³ парной. Для тяжёлой облицовки камнем и большого стекла берут верхнюю границу. Вода с умягчением, автодренаж, паропровод с уклоном.</li><li><b>Вытяжка</b> нужна для просушки после процедуры, во время сеанса она закрыта; приток не подают в зону сидения.</li></ul><p class=\"e-note\">Сточные воды хамама и моечной не отводят на соседний участок и на рельеф: в канализацию, септик или дренаж по проекту.</p></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Монтаж: встроенная и отдельно стоящая</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Встроенная сауна или хамам в доме</th><th>Отдельно стоящая баня</th></tr></thead><tbody><tr><td>Место: цоколь, санузел-блок или угол с внешней стеной, вентиляция и дренаж короче; несущие конструкции без проекта не сверлят</td><td>Фундамент и вентилируемое подполье, лаги не лежат в сырости; обвязка и нижний венец из лиственницы или термососны</td></tr><tr><td>Пароизоляция парной проклеена с плёнкой тёплого контура дома, иначе влага уйдёт в перекрытие</td><td>Сруб из бревна естественной влажности даёт усадку порядка 5–8 % высоты (клееный брус и камерной сушки заметно меньше): осадочные зазоры в проёмах, компенсатор на дымоходе</td></tr><tr><td>Вытяжка парной только на улицу, не в общедомовую вентиляцию</td><td>Отступ до границы смежного участка как для хозяйственной постройки не менее 2 м (Изменение № 4 к СН 3.01.03-2020, по публикациям, с 01.12.2026), сверьте с текстом; противопожарные разрывы до соседних зданий по огнестойкости берут в проекте</td></tr><tr><td>Порог-бортик парной 20–30 мм, трап моечной с гидрозатвором и подогревом</td><td>Зимний водозабор и слив: незамерзающий кран или слив в дренаж внутри контура</td></tr></tbody></table></div><p class=\"e-note\">Нормативный контур Беларуси. Отдельно стоящая баня это хозяйственная постройка, порядок оформления и отступы уточняйте в отделе архитектуры и строительства. Указ Президента № 202 от 13.06.2022 даёт упрощённый порядок для одноквартирных домов и нежилых капитальных построек 5-го класса сложности, баня в его тексте не названа. По публикациям об Изменении № 4 к СН 3.01.03-2020 (с 01.12.2026) для хозяйственных построек 2 м, для жилого дома 3 м; нотариальное согласие соседа их больше не заменяет.</p></div><div class=\"e-art\" id=\"art8\"><div class=\"e-sech\"><small>8</small><h3>Эксплуатация: сколько электричества на процедуру</h3></div><p class=\"e-lead2\">Электроэнергия за процедуру: E = P × t разгона + P × t сеанса × 0,4. Разгон 0,75 ч для сауны, 0,6 ч для хамама, 0,25 ч для ИК-кабины; коэффициент 0,4 учитывает поддержание режима. Дрова считают по запасу и теплотворности, в калькуляторе не учитываются.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Пример</th><th>Мощность</th><th>Сеанс</th><th>Энергия</th><th>По тарифу 0,3037 BYN/кВт·ч</th></tr></thead><tbody><tr><td>Финская сауна 10,6 м³, печь 13,5 кВт</td><td>13,5 кВт</td><td>1,5 ч</td><td>18,2 кВт·ч</td><td>≈ 5,5 BYN</td></tr><tr><td>Хамам 8,8 м³, генератор 15 кВт и обогрев 2,2 кВт</td><td>17,2 кВт</td><td>1,5 ч</td><td>20,6 кВт·ч</td><td>≈ 6,3 BYN</td></tr></tbody></table></div><p class=\"e-note\">Тариф и режим вы задаёте в калькуляторе. Оценка модели, а не замер: реальный расход зависит от утепления, частоты открывания двери и массы камней.</p></div><div class=\"e-art\" id=\"art9\"><div class=\"e-sech\"><small>9</small><h3>Типичные ошибки: 12 способов испортить пар и дом</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. Печь «×2 про запас»</h4><p class=\"x\">✗ Парная пересушена, печь тактует, камни перегорают за сезон.</p><p class=\"v\">✓ Объём × 1,1 кВт плюс поправка на стекло, коридор 1,0–1,4 кВт/м³.</p></div><div class=\"e-err\"><h4>2. Нет вентиляции, «форточка»</h4><p class=\"x\">✗ CO₂ и сырость: болит голова, дерево гниёт неравномерно.</p><p class=\"v\">✓ Приток под печь, вытяжка диагонально, 3–6 об/ч, залповый клапан.</p></div><div class=\"e-err\"><h4>3. Фольга с дырами, без зазора</h4><p class=\"x\">✗ Утеплитель отсыревает, конденсат на вагонке.</p><p class=\"v\">✓ Непрерывная фольга, стыки алюмоскотчем, зазор около 20 мм.</p></div><div class=\"e-err\"><h4>4. Хвоя и ПВХ в жаровой зоне</h4><p class=\"x\">✗ Смола капает с полка, пластик выделяет вредные вещества.</p><p class=\"v\">✓ Липа, ольха, осина, абаш; никаких пластиков.</p></div><div class=\"e-err\"><h4>5. Пенопласт как утеплитель</h4><p class=\"x\">✗ Запах, токсичность, плавление при нагреве.</p><p class=\"v\">✓ Только базальтовая вата плитная 50–100 мм.</p></div><div class=\"e-err\"><h4>6. Дверь внутрь и с защёлкой</h4><p class=\"x\">✗ При плохом самочувствии человек не откроет её и не выйдет.</p><p class=\"v\">✓ Дверь наружу, без запоров, стекло 8 мм с магнитным притвором.</p></div><div class=\"e-err\"><h4>7. Кабель 2,5 мм² под 10 кВт</h4><p class=\"x\">✗ Перегрев линии и пожар в стене.</p><p class=\"v\">✓ От 8 кВт обычно 380 В, сечение и автомат по расчёту, термостойкий кабель до печи.</p></div><div class=\"e-err\"><h4>8. Без отступок и разделки</h4><p class=\"x\">✗ Горючая стена у печи главная причина банных пожаров.</p><p class=\"v\">✓ Отступки по паспорту (ориентир 500 мм до защищённой стены), разделка перекрытия, предтопочный лист.</p></div><div class=\"e-err\"><h4>9. Заслонка закрыта «чтобы не остывало»</h4><p class=\"x\">✗ Угарный газ без запаха и шанса.</p><p class=\"v\">✓ Закрывают только после полного прогорания, датчик CO с сиреной.</p></div><div class=\"e-err\"><h4>10. Хамам без уклонов и корыта</h4><p class=\"x\">✗ Протечка в перекрытие и к соседям, грибок за мозаикой.</p><p class=\"v\">✓ Гидроизоляция корытом с заходом на стены, уклон 1–2 % к трапу.</p></div><div class=\"e-err\"><h4>11. Обогрев полок после плитки</h4><p class=\"x\">✗ Ремонт невозможен без вскрытия мозаики.</p><p class=\"v\">✓ Маты и тест нагрева до отделки, протокол в сдачу.</p></div><div class=\"e-err\"><h4>12. Камни и генератор без обслуживания</h4><p class=\"x\">✗ Накипь, трещины камней, слабый пар, перерасход.</p><p class=\"v\">✓ Переборка камней раз в 1–2 сезона, умягчение воды, автодренаж.</p></div></div></div><div class=\"e-art\" id=\"art10\"><div class=\"e-sech\"><small>10</small><h3>Чек-лист заказчика</h3></div><p class=\"e-lead2\">Вопросы подрядчику до договора.</p><ul class=\"e-ul\"><li>Пирог ограждений по слоям и узлы примыкания фольги, на разрезе?</li><li>Мощность печи по объёму с поправкой на стекло; ввод 220 или 380 В, сечение и автомат?</li><li>Схема вентиляции с кратностью и залповым клапаном в проекте?</li><li>Отступки, разделки, предтопочный лист и датчик CO в спецификации?</li><li>Для хамама: уклоны, гидроизоляция корытом, тест обогрева до мозаики?</li><li>Что входит в пуск: прогрев на режим, замер температур и влажности, инструктаж по заслонке и камням?</li></ul><div class=\"e-basis\"><b>Красные флаги</b><p>«Печь мощнее значит лучше»; фольга внахлёст без скотча; вентиляция через щель под дверью; кабель «как на розетки»; дровяная печь без датчика CO; хамам без уклонов и трапа; пусконаладка «сами попробуете». Любой пункт повод остановиться.</p></div><p class=\"e-lead2\">Пять тезисов, с которыми можно принимать решение.</p><ul class=\"e-ul\"><li>Режим первичен: точка «температура-влажность» определяет пирог, печь, вентиляцию и электрику.</li><li>Три кита парной: непрерывная фольга, вентзазор около 20 мм и вентиляция 3–6 об/ч.</li><li>Мощность считают по объёму с поправкой: около 1,1 кВт/м³ сауна плюс 0,5 кВт на м² стекла, 1,5–2,0 кВт/м³ хамам; от 8 кВт обычно 380 В.</li><li>Пожар и угарный газ главные риски: отступки, разделки, предтопочный лист, датчик CO и правило заслонки.</li><li>Хамам это гидроизоляция и обогрев поверхностей, сауна это изоляция и вентиляция: тесты до отделки, а не после.</li></ul><p class=\"e-note\">Источники: Указ Президента Республики Беларусь № 202 от 13.06.2022; СН 3.01.03-2020 с Изменением № 4 (по публикациям, текст сверьте); паспорта печей, парогенераторов и панелей. Цифры мощности, вентиляции, массы камней и отступок это ориентиры практики, а не нормативы. Оценки для условий Минска, не оферта.</p></div></section><section class=\"e-panel\" id=\"bageo\" data-panel=\"bageo\"><div class=\"e-sech\"><small>02</small><h2>Параметры парной</h2></div><p class=\"e-lead2\">Выберите тип и размеры: расчёт даст объём, поверхности, печь, электрику, вентиляцию и предупреждения по безопасности.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f wide\"><label for=\"ba-preset\">Готовый пример</label><div class=\"e-in\"><select id=\"ba-preset\"><option value=\"\" selected>Свои данные</option><option value=\"fin\">Сауна 10 м³ в цоколе</option><option value=\"rus\">Русская баня 17 м³, дрова</option><option value=\"ham\">Хамам 9 м³</option><option value=\"ir\">ИК-кабина 1,2×1,2×1,9 м</option></select></div></div><div class=\"e-f wide\"><label for=\"ba-type\">Тип</label><div class=\"e-in\"><select id=\"ba-type\"><option value=\"fin\" selected>Финская сауна (электрокаменка)</option><option value=\"rus\">Русская баня (дровяная печь)</option><option value=\"ham\">Хамам (парогенератор)</option><option value=\"ir\">ИК-кабина</option><option value=\"hyb\">Гибрид (каменка и парогенератор)</option></select></div></div><div class=\"e-f\"><label for=\"ba-L\">Длина</label><div class=\"e-in\"><input id=\"ba-L\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,4\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ba-W\">Ширина</label><div class=\"e-in\"><input id=\"ba-W\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,0\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ba-H\">Высота</label><div class=\"e-in\"><input id=\"ba-H\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,2\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ba-u\">Стекло и неутеплённые поверхности</label><div class=\"e-in\"><input id=\"ba-u\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,8\"><span class=\"u\">м²</span></div></div><div class=\"e-f\"><label for=\"ba-place\">Расположение</label><div class=\"e-in\"><select id=\"ba-place\"><option value=\"built\" selected>Встроена в дом</option><option value=\"sep\">Отдельно стоящая</option></select></div></div><div class=\"e-f\"><label for=\"ba-bd\">Расстояние до границы соседа</label><div class=\"e-in\"><input id=\"ba-bd\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ba-sup\">Электропитание</label><div class=\"e-in\"><select id=\"ba-sup\"><option value=\"380\" selected>380 В, 5 жил</option><option value=\"220\">220 В</option></select></div></div><div class=\"e-f\"><label for=\"ba-lim\">Лимит мощности на баню (необязательно)</label><div class=\"e-in\"><input id=\"ba-lim\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">кВт</span></div></div><div class=\"e-f\"><label for=\"ba-door\">Дверь</label><div class=\"e-in\"><select id=\"ba-door\"><option value=\"out\" selected>Наружу, без запоров</option><option value=\"lock\">Наружу, с защёлкой</option><option value=\"in\">Внутрь</option></select></div></div><div class=\"e-f wide\"><label for=\"ba-vent\">Вентиляция</label><div class=\"e-in\"><select id=\"ba-vent\"><option value=\"yes\" selected>Приток под печь и вытяжка диагонально</option><option value=\"gap\">Форточка или щель под дверью</option><option value=\"no\">Нет</option></select></div></div><div class=\"e-f\"><label for=\"ba-ins\">Утеплитель</label><div class=\"e-in\"><select id=\"ba-ins\"><option value=\"wool\" selected>Базальтовая вата</option><option value=\"pps\">Пенопласт ППС</option><option value=\"xps\">XPS</option></select></div></div><div class=\"e-f wide\"><label for=\"ba-bud\">Комплектация</label><div class=\"e-in\"><select id=\"ba-bud\"><option value=\"std\" selected>Стандарт (липа, ольха)</option><option value=\"eco\">Эконом (осина)</option><option value=\"prem\">Премиум (термодерево, абаш на полках)</option></select></div></div><div class=\"e-f wide\"><label for=\"ba-chim\">Дымоход, разделка, отступки и датчик CO (русская)</label><div class=\"e-in\"><select id=\"ba-chim\"><option value=\"yes\" selected>Заложены в проекте</option><option value=\"no\">Пока нет</option></select></div></div><div class=\"e-f\"><label for=\"ba-drain\">Трап и уклон пола 1–2 % (хамам)</label><div class=\"e-in\"><select id=\"ba-drain\"><option value=\"yes\" selected>Есть</option><option value=\"no\">Нет</option></select></div></div><div class=\"e-f\"><label for=\"ba-soft\">Умягчитель и автодренаж (хамам)</label><div class=\"e-in\"><select id=\"ba-soft\"><option value=\"yes\" selected>Есть</option><option value=\"no\">Нет</option></select></div></div><div class=\"e-f\"><label for=\"ba-stone\">Камни</label><div class=\"e-in\"><select id=\"ba-stone\"><option value=\"gab\" selected>Габбро-диабаз</option><option value=\"jad\">Жадеит</option><option value=\"qrz\">Малиновый кварцит</option></select></div></div><div class=\"e-f wide\"><div class=\"e-in\"><label class=\"o-chk\"><input type=\"checkbox\" id=\"ba-o-barrel\"><span>Бочка или уличный модуль</span></label></div></div><div class=\"e-f wide\"><div class=\"e-in\"><label class=\"o-chk\"><input type=\"checkbox\" id=\"ba-o-pano\"><span>Панорамное стекло (добавляет 2 м² неутеплённой поверхности)</span></label></div></div><div class=\"e-f wide\"><div class=\"e-in\"><label class=\"o-chk\"><input type=\"checkbox\" id=\"ba-o-salt\"><span>Солевые панели</span></label></div></div><div class=\"e-f wide\"><div class=\"e-in\"><label class=\"o-chk\"><input type=\"checkbox\" id=\"ba-o-gun\"><span>Паровая пушка</span></label></div></div><div class=\"e-formula\">V = L · W · H, S<sub>стен</sub> = 2 (L + W) · H, S<sub>обшивки</sub> = S<sub>стен</sub> + L · W − 1,6 м² двери<br>Предупреждения: ввод, лимит, дверь, вентиляция, утеплитель, хамам, дымоход, отступ</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Паспорт парной</span><div class=\"kv\"><span>Тип и режим</span><b id=\"ba-k\">—</b></div><div class=\"kv\"><span>Объём</span><b id=\"ba-v\">—</b></div><div class=\"kv\"><span>Поверхности</span><b id=\"ba-s\">—</b></div><div class=\"verdict\" id=\"ba-verdict\" role=\"status\"></div></div></div></div><figure class=\"e-fig\"><div id=\"ba-ch\"></div><figcaption id=\"ba-chn\"></figcaption></figure></section><section class=\"e-panel\" id=\"baheat\" data-panel=\"baheat\"><div class=\"e-sech\"><small>03</small><h2>Печь и электрика</h2></div><p class=\"e-lead2\">Мощность печи или парогенератора по объёму, линия питания, вентиляция и энергия за процедуру. Тариф и длительность сеанса вы задаёте сами.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f\"><label for=\"ba-tar\">Тариф</label><div class=\"e-in\"><input id=\"ba-tar\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,3037\"><span class=\"u\">BYN/кВт·ч</span></div></div><div class=\"e-f\"><label for=\"ba-ses\">Длительность сеанса</label><div class=\"e-in\"><input id=\"ba-ses\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,5\"><span class=\"u\">ч</span></div></div><div class=\"e-f\"><label for=\"ba-cab\">Длина кабеля от щита</label><div class=\"e-in\"><input id=\"ba-cab\" inputmode=\"decimal\" autocomplete=\"off\" value=\"15\"><span class=\"u\">м</span></div></div><div class=\"e-formula\">Сауна: P = V · 1,1 + 0,5 · S<sub>неутепл</sub>; хамам: P = V · 1,8 (1,5–2,0); ИК: P = V · 1,0; дрова: паспорт = V · 1,2<br>I = P / (√3 · 380); Q = V · кратность; E = P · t<sub>разгона</sub> + P · t<sub>сеанса</sub> · 0,4</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Прибор</span><b id=\"ba-h\">—</b></div><div class=\"kv\"><span>Подбор по объёму</span><b id=\"ba-hp\">—</b></div><div class=\"kv\"><span>Линия питания</span><b id=\"ba-ln\">—</b></div><div class=\"kv\"><span>Обогрев поверхностей</span><b id=\"ba-sf\">—</b></div><div class=\"kv\"><span>Дровяная печь</span><b id=\"ba-w\">—</b></div><div class=\"kv\"><span>Вентиляция</span><b id=\"ba-vn\">—</b></div><div class=\"kv\"><span>Энергия за процедуру</span><b id=\"ba-e\">—</b></div><div class=\"kv\"><span>Стоимость процедуры</span><b id=\"ba-ec\">—</b></div><div class=\"verdict\" id=\"ba-v1\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"baenc\" data-panel=\"baenc\"><div class=\"e-sech\"><small>04</small><h2>Ограждения и материалы</h2></div><p class=\"e-lead2\">Ведомость для сауны, русской бани и гибрида: вата, фольга, обрешётка, вагонка, полки, камни. Количества с запасом на раскрой.</p><div class=\"e-calc\"><div class=\"e-form\"><p class=\"e-note\">Параметры берутся с первой вкладки: размеры, тип и комплектация.</p><div class=\"e-formula\">Фольга = S<sub>обшивки</sub> · 1,1; обрешётка 20×40 = S<sub>обшивки</sub> / 0,6; вагонка = S<sub>обшивки</sub> · 1,05<br>Камни: открытая каменка V · 8 кг (не менее 40), закрытая V · 12 кг (не менее 100)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Вата на стены</span><b id=\"ba-m-w\">—</b></div><div class=\"kv\"><span>Вата на потолок</span><b id=\"ba-m-c\">—</b></div><div class=\"kv\"><span>Фольга</span><b id=\"ba-m-f\">—</b></div><div class=\"kv\"><span>Обрешётка</span><b id=\"ba-m-b\">—</b></div><div class=\"kv\"><span>Вагонка</span><b id=\"ba-m-v\">—</b></div><div class=\"kv\"><span>Полки</span><b id=\"ba-m-s\">—</b></div><div class=\"kv\"><span>Камни</span><b id=\"ba-m-k\">—</b></div><div class=\"kv\"><span>Дверь и стекло</span><b id=\"ba-m-d\">—</b></div><div class=\"kv\"><span>Порода дерева</span><b id=\"ba-m-t\">—</b></div><div class=\"verdict\" id=\"ba-v2\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"baham\" data-panel=\"baham\"><div class=\"e-sech\"><small>05</small><h2>Хамам</h2></div><p class=\"e-lead2\">Гидроизоляция корытом, XPS, облицовка, обогрев поверхностей и уклон к трапу. Работает для типа «Хамам».</p><div class=\"e-calc\"><div class=\"e-form\"><p class=\"e-note\">Параметры берутся с первой вкладки: размеры, трап и умягчитель.</p><div class=\"e-formula\">Гидроизоляция = (S<sub>стен</sub> − 1,6 + S<sub>потолка</sub> + S<sub>пола</sub>) · 1,15; XPS = (S<sub>стен</sub> + S<sub>потолка</sub>) · 1,05<br>Обогрев: пол 160, полки 120, стены 90 Вт/м²; уклон 10–20 мм на метр</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Гидроизоляция</span><b id=\"ba-h-w\">—</b></div><div class=\"kv\"><span>XPS</span><b id=\"ba-h-x\">—</b></div><div class=\"kv\"><span>Мозаика на стены и потолок</span><b id=\"ba-h-m\">—</b></div><div class=\"kv\"><span>Плитка пола</span><b id=\"ba-h-t\">—</b></div><div class=\"kv\"><span>Обогрев</span><b id=\"ba-h-h\">—</b></div><div class=\"kv\"><span>Уклон пола</span><b id=\"ba-h-s\">—</b></div><div class=\"verdict\" id=\"ba-v3\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"babud\" data-panel=\"babud\" data-xtbl=\"1\"><div class=\"e-sech\"><small>06</small><h2>Смета-ведомость</h2></div><p class=\"e-lead2\">Количества берутся из расчёта. Цены не заложены: введите цены из ваших предложений, сумма пересчитается.</p><div class=\"e-calc\"><div class=\"e-form\"><p class=\"e-note\"><b>Ваши цены за единицу</b></p><div class=\"e-f\"><label for=\"ba-p-wool50\">Вата 50 мм, за м²</label><div class=\"e-in\"><input id=\"ba-p-wool50\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-wool100\">Вата 100 мм, за м²</label><div class=\"e-in\"><input id=\"ba-p-wool100\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-foil\">Фольга, за м²</label><div class=\"e-in\"><input id=\"ba-p-foil\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-batt\">Обрешётка 20×40, за м.п.</label><div class=\"e-in\"><input id=\"ba-p-batt\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-board\">Вагонка, за м²</label><div class=\"e-in\"><input id=\"ba-p-board\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-slat\">Планка полок, за м.п.</label><div class=\"e-in\"><input id=\"ba-p-slat\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-wp\">Гидроизоляция хамама, за м²</label><div class=\"e-in\"><input id=\"ba-p-wp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-xps\">XPS, за м²</label><div class=\"e-in\"><input id=\"ba-p-xps\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-mos\">Мозаика, за м²</label><div class=\"e-in\"><input id=\"ba-p-mos\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-tile\">Плитка пола, за м²</label><div class=\"e-in\"><input id=\"ba-p-tile\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-heater\">Печь или генератор, за шт</label><div class=\"e-in\"><input id=\"ba-p-heater\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-brk\">Автомат, за шт</label><div class=\"e-in\"><input id=\"ba-p-brk\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-rcd\">УЗО 30 мА, за шт</label><div class=\"e-in\"><input id=\"ba-p-rcd\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-cable\">Кабель, за м.п.</label><div class=\"e-in\"><input id=\"ba-p-cable\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-chim\">Дымоход с разделкой, за комплект</label><div class=\"e-in\"><input id=\"ba-p-chim\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-co\">Датчик CO, за шт</label><div class=\"e-in\"><input id=\"ba-p-co\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-stone\">Камни, за комплект 20 кг</label><div class=\"e-in\"><input id=\"ba-p-stone\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-vent\">Вентиляционный клапан, за шт</label><div class=\"e-in\"><input id=\"ba-p-vent\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-mat\">Греющий мат или кабель, за м²</label><div class=\"e-in\"><input id=\"ba-p-mat\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-drain\">Трап, за шт</label><div class=\"e-in\"><input id=\"ba-p-drain\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-soft\">Умягчитель с автодренажом, за комплект</label><div class=\"e-in\"><input id=\"ba-p-soft\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-door\">Дверь, за шт</label><div class=\"e-in\"><input id=\"ba-p-door\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-glass\">Стекло, за м²</label><div class=\"e-in\"><input id=\"ba-p-glass\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><div class=\"e-f\"><label for=\"ba-p-start\">Пусконаладка, за комплект</label><div class=\"e-in\"><input id=\"ba-p-start\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN</span></div></div><button class=\"e-btn sm\" id=\"ba-p-reset\" type=\"button\">Очистить цены</button><div class=\"e-formula\">Сумма = Σ (количество · ваша цена за единицу)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Позиций с ценой</span><b id=\"ba-b-n\">—</b></div><div class=\"kv\"><span>Итого</span><b id=\"ba-b-sum\">—</b></div><div class=\"verdict\" id=\"ba-b-verdict\" role=\"status\"></div></div></div></div><h4 class=\"e-h4\">Ведомость</h4><div id=\"ba-bt\"></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Это ориентировочный расчёт для разговора с подрядчиком, а не проект. Мощность печи, вентиляция, масса камней, отступки и обогрев поверхностей это ориентиры практики, модель печи и условия установки задаёт паспорт. Линию питания окончательно выбирает электрик, дровяную печь, дымоход и отступки проверяют по паспорту и требованиям пожарной безопасности. Порядок оформления постройки и отступы от границы уточняйте в местной администрации до начала работ.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/bath-model.js?v=1\"></script><script src=\"/static/bath.js?v=1\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstFinTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет · Отделка помещений</div><h1>Смета отделки помещений</h1><p class=\"e-lead\">Размеры помещений, ведомость отделки, смета, цена и печатные формы. Предварительный укрупнённый расчёт: данные хранятся только в вашем браузере.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/otdelka\" class=\"on\" aria-current=\"page\">{{ t.est_tab_fin }}</a><a href=\"{{ p }}/raschet-smet/formy\">{{ t.est_tab_forms }}</a><a href=\"{{ p }}/raschet-smet/cenoobrazovanie\">{{ t.est_tab_price }}</a></nav><div id=\"otd\" class=\"o-app\"></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><div class=\"e-basis\"><b>Важно знать</b><p>Расчёт предварительный и укрупнённый, он не учитывает детали объекта и проектные решения. Нормы трудозатрат и цены материалов в калькуляторе ориентировочные: окончательные значения берутся из нормативов и прайсов. Точная стоимость определяется после осмотра объекта.</p></div><script src=\"/static/otdelka.js?v=1\"></script><script src=\"/static/otdelka-ui.js?v=6\"></script>"
}

pattern EstFormsTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет · Образцы форм</div><h1>Формы отчётов</h1><p class=\"e-lead\">Шесть печатных форм по примеру расчёта: общая смета, смета по помещениям, спецификации материалов, заявка поставщику и ведомость состава работ.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/otdelka\">{{ t.est_tab_fin }}</a><a href=\"{{ p }}/raschet-smet/formy\" class=\"on\" aria-current=\"page\">{{ t.est_tab_forms }}</a><a href=\"{{ p }}/raschet-smet/cenoobrazovanie\">{{ t.est_tab_price }}</a></nav><div class=\"f-grid\"><div class=\"e-card f-card\"><img class=\"f-img\" src=\"/static/forms/forma-1.png\" alt=\"Форма 1: Общая смета\" loading=\"lazy\" width=\"397\" height=\"562\"><span class=\"e-tag\">Форма 1</span><h3>Общая смета</h3><p>Статьи затрат в двух вариантах цены: бригада заказчика и организация.</p><div class=\"f-links\"><a href=\"/static/forms/forma-1.pdf\" target=\"_blank\" rel=\"noopener\">PDF</a><a href=\"/static/forms/forma-1.png\" target=\"_blank\" rel=\"noopener\">PNG</a></div></div><div class=\"e-card f-card\"><img class=\"f-img\" src=\"/static/forms/forma-2.png\" alt=\"Форма 2: Общая смета по помещениям\" loading=\"lazy\" width=\"397\" height=\"562\"><span class=\"e-tag\">Форма 2</span><h3>Общая смета по помещениям</h3><p>Оплата труда, отчисления, ОХР, материалы и прибыль по каждому помещению.</p><div class=\"f-links\"><a href=\"/static/forms/forma-2.pdf\" target=\"_blank\" rel=\"noopener\">PDF</a><a href=\"/static/forms/forma-2.png\" target=\"_blank\" rel=\"noopener\">PNG</a></div></div><div class=\"e-card f-card\"><img class=\"f-img\" src=\"/static/forms/forma-3.png\" alt=\"Форма 3: Спецификация материалов (общая)\" loading=\"lazy\" width=\"397\" height=\"562\"><span class=\"e-tag\">Форма 3</span><h3>Спецификация материалов (общая)</h3><p>Материалы по объекту: количество с запасом, фасовка, число упаковок, сумма.</p><div class=\"f-links\"><a href=\"/static/forms/forma-3.pdf\" target=\"_blank\" rel=\"noopener\">PDF</a><a href=\"/static/forms/forma-3.png\" target=\"_blank\" rel=\"noopener\">PNG</a></div></div><div class=\"e-card f-card\"><img class=\"f-img\" src=\"/static/forms/forma-4.png\" alt=\"Форма 4: Спецификация материалов по помещениям\" loading=\"lazy\" width=\"397\" height=\"562\"><span class=\"e-tag\">Форма 4</span><h3>Спецификация материалов по помещениям</h3><p>Потребность в материалах в каждом помещении до округления до упаковок.</p><div class=\"f-links\"><a href=\"/static/forms/forma-4.pdf\" target=\"_blank\" rel=\"noopener\">PDF</a><a href=\"/static/forms/forma-4.png\" target=\"_blank\" rel=\"noopener\">PNG</a></div></div><div class=\"e-card f-card\"><img class=\"f-img\" src=\"/static/forms/forma-5.png\" alt=\"Форма 5: Заявка на материалы\" loading=\"lazy\" width=\"397\" height=\"562\"><span class=\"e-tag\">Форма 5</span><h3>Заявка на материалы</h3><p>Бланк для поставщика: список в упаковках, адрес доставки, подписи.</p><div class=\"f-links\"><a href=\"/static/forms/forma-5.pdf\" target=\"_blank\" rel=\"noopener\">PDF</a><a href=\"/static/forms/forma-5.png\" target=\"_blank\" rel=\"noopener\">PNG</a></div></div><div class=\"e-card f-card\"><img class=\"f-img\" src=\"/static/forms/forma-6.png\" alt=\"Форма 6: Ведомость состава работ\" loading=\"lazy\" width=\"397\" height=\"562\"><span class=\"e-tag\">Форма 6</span><h3>Ведомость состава работ</h3><p>Операции по каждому виду работ с объёмом, нормой и трудозатратами.</p><div class=\"f-links\"><a href=\"/static/forms/forma-6.pdf\" target=\"_blank\" rel=\"noopener\">PDF</a><a href=\"/static/forms/forma-6.png\" target=\"_blank\" rel=\"noopener\">PNG</a></div></div></div><div class=\"e-basis\"><b>Для проверки макета</b><p>Данные в формах условные. Это предварительный укрупнённый расчёт: он не учитывает детали объекта и проектные решения. Нормы трудозатрат в форме 6 взяты для примера, в расчёте применяются нормы НРР-2022.</p></div>"
}

pattern EstCalcTabs(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/otdelka\">{{ t.est_tab_fin }}</a><a href=\"{{ p }}/raschet-smet/formy\">{{ t.est_tab_forms }}</a><a href=\"{{ p }}/raschet-smet/cenoobrazovanie\">{{ t.est_tab_price }}</a></nav>"
}

