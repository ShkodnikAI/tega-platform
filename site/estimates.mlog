// Страницы раздела «Расчёт смет». Файл создаётся скриптом tools/estimates/build.py, правьте текст там.

pattern EstHubTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет</div><h1>Расчёт стоимости работ и материалов</h1><p class=\"e-lead\">Предварительный расчёт стоимости ремонта и отделки. Точную смету составим после осмотра объекта.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\" class=\"on\" aria-current=\"page\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/otdelka\">{{ t.est_tab_fin }}</a><a href=\"{{ p }}/raschet-smet/formy\">{{ t.est_tab_forms }}</a><a href=\"{{ p }}/raschet-smet/cenoobrazovanie\">{{ t.est_tab_price }}</a></nav><section class=\"e-sec\"><h2>Рассчитать стоимость</h2><p class=\"e-lead2\">Для заказчика: введите размеры помещений и получите состав работ, материалы и предварительную цену.</p><div class=\"e-cards\"><a class=\"e-card hot\" href=\"{{ p }}/raschet-smet/otdelka\"><span class=\"e-tag ok\">Готово к проверке</span><h3>Отделка помещений</h3><p>Помещения, ведомость отделки, смета, цена и шесть печатных форм. Стены, откосы, потолки и полы.</p></a><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Демонтаж и черновые работы</h3><p>Перегородки, стяжка, штукатурка, выравнивание.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Инженерные системы</h3><p>Электрика, водоснабжение, отопление, вентиляция. Расчёт стоимости по объёму работ.</p></div><a class=\"e-card hot\" href=\"{{ p }}/raschet-smet/formy\"><span class=\"e-tag ok\">Образцы</span><h3>Образцы форм</h3><p>Шесть печатных форм сметы: смета, смета по помещениям, спецификации, заявка на материалы, ведомость состава работ. PDF и PNG с водяным знаком.</p></a><a class=\"e-card hot\" href=\"{{ p }}/raschet-smet/cenoobrazovanie\"><span class=\"e-tag ok\">Статья</span><h3>Из чего состоит цена</h3><p>ОХР и ОПР, плановая прибыль, структура затрат и граница конкурсного коэффициента.</p></a><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Общая смета по объекту</h3><p>Собирает выбранные расчёты в одну смету с итогами по помещениям и разделам.</p></div></div></section><section class=\"e-sec\"><div class=\"e-mores\"><a class=\"e-more\" href=\"{{ p }}/spravochniki\"><small>→</small><h3>Справочники для специалистов</h3><p>Правила обмера, нормы качества и приёмки, инженерные калькуляторы для проектировщиков и монтажников.</p><span class=\"e-cta\">Открыть справочники →</span></a></div></section>"
}

pattern EstRefTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники</div><h1>Справочники и инженерные расчёты</h1><p class=\"e-lead\">Нормативные правила, нормы качества и калькуляторы для специалистов. Числа ориентировочные: окончательные значения берите из действующих документов.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\" class=\"on\" aria-current=\"page\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><section class=\"e-sec\"><h2>Правила и нормы</h2><p class=\"e-lead2\">Как считаются объёмы и как проверяется качество: для сметчиков, прорабов и технадзора.</p><div class=\"e-cards\"><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/obyemy\"><span class=\"e-tag ok\">Справочник</span><h3>Объёмы работ</h3><p>По каким правилам считаются площади: что вычитается, что добавляется, какие коэффициенты.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/kachestvo\"><span class=\"e-tag ok\">Справочник</span><h3>Качество работ</h3><p>Нормы приёмки по видам работ: отделка, бетон, кладка, дерево, электрика, трубопроводы и испытания.</p></a></div></section><section class=\"e-sec\"><h2>Инженерные расчёты</h2><p class=\"e-lead2\">Калькуляторы для проектировщиков и монтажников с проверкой по нормам.</p><div class=\"e-cards\"><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/elektrika\"><span class=\"e-tag ok\">Калькуляторы готовы</span><h3>Электрика</h3><p>Сечение кабеля, ток короткого замыкания, заземление, освещение, подбор автомата и УЗО, справка по аппаратам.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/vodosnabzhenie\"><span class=\"e-tag ok\">Калькуляторы готовы</span><h3>Водоснабжение</h3><p>Диаметр водопровода, потери давления, нагрев воды, бойлер и проточный нагреватель.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/kanalizaciya\"><span class=\"e-tag ok\">Калькуляторы готовы</span><h3>Канализация</h3><p>Диаметр отвода по приборам, уклон, септик для коттеджа и статья о септиках и станциях биоочистки.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/otoplenie\"><span class=\"e-tag ok\">Калькуляторы готовы</span><h3>Отопление</h3><p>Теплопотери помещения, секции радиаторов, трубы, тёплый пол, расширительный бак.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/ventilyaciya\"><span class=\"e-tag ok\">Калькуляторы готовы</span><h3>Вентиляция</h3><p>Воздухообмен, воздуховоды, решётки, мощность калорифера с рекуператором.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/solnechnaya-generaciya\"><span class=\"e-tag ok\">Калькулятор готов</span><h3>Солнечные системы</h3><p>Выработка по часам для Беларуси, кровля и забор, инвертор и батарея, спецификация и окупаемость.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/konditsionirovanie\"><span class=\"e-tag ok\">Калькулятор готов</span><h3>Кондиционирование</h3><p>Мощность по часам жаркого дня, расход электричества, трасса и шум наружного блока, статья о выборе.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/umnyj-dom\"><span class=\"e-tag ok\">Статья</span><h3>Умный дом</h3><p>Архитектуры и протоколы, управление, монтаж, чек-лист приёмки и типичные ошибки.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/basseyny\"><span class=\"e-tag ok\">Калькулятор готов</span><h3>Бассейны и биопулы</h3><p>Калькулятор: оборот, насос, фильтр, нагрев и энергия сезона, обеззараживание, биопул. Статья о чашах, воде и зиме.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/bani\"><span class=\"e-tag ok\">Калькулятор готов</span><h3>Бани и сауны</h3><p>Калькулятор парной: печь или парогенератор, электрика, вентиляция, погонаж материалов, хамам, камни и энергия. Статья о режимах, пироге стен и безопасности.</p></a><a class=\"e-card hot\" href=\"{{ p }}/spravochniki/prudy\"><span class=\"e-tag ok\">Калькулятор готов</span><h3>Пруды и биопруды</h3><p>Калькулятор: объём, оборот, насос, биофильтр, плёнка, растения и электричество. Статья об экосистеме и зимовке.</p></a></div></section><section class=\"e-sec\"><div class=\"e-mores\"><a class=\"e-more\" href=\"{{ p }}/raschet-smet\"><small>→</small><h3>Рассчитать стоимость</h3><p>Если нужна цена ремонта, а не нормы: калькулятор стоимости работ и материалов.</p><span class=\"e-cta\">Перейти к расчёту →</span></a></div></section>"
}

pattern EstVolTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Объёмы работ</div><h1>Как определяются объёмы работ</h1><p class=\"e-lead\">Правила обмера для отделочных работ и полов: что вычитается, что добавляется и какие коэффициенты применяются. Правила изложены по сборникам норм НРР-2022 своими словами, все числа сохранены.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\" class=\"on\" aria-current=\"page\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-ref\"><div class=\"sub\">Общие правила</div>
<details open><summary>Общие правила измерения</summary><div class=\"ans\"><p><span class=\"k\">Высота стены:</span> от чистого пола до потолка. У перегородки — до потолка или до верха самой перегородки.</p><p><span class=\"k\">Размер окна и двери:</span> «по наружному обводу коробки» значит: размер проёма вместе с коробкой, а не размер стекла или полотна. Если в проёме две коробки, берётся наружная.</p><p><span class=\"k\">Размеры помещения:</span> берутся между внутренними гранями стен или перегородок.</p><p><span class=\"k\">Деление по помещениям:</span> объём считается отдельно для каждого помещения в зависимости от вида отделки (простая, улучшенная, высококачественная). Если во всех помещениях квартиры, этажа или секции отделка одинаковая, можно считать их целиком.</p><p><span class=\"k\">Высота помещения:</span> нормы по облицовке, штукатурке, окраске и обоям рассчитаны на работу с инвентарных столиков, стремянок и приставных лестниц в помещениях высотой до 4 м. При окраске помещений выше 4 м к расходам применяются повышающие коэффициенты из раздела 3 технической части. Установка лепных изделий и остекление рассчитаны на высоту до 8 м.</p><p><span class=\"k\">Малые помещения:</span> штукатурные нормы рассчитаны на помещения с площадью пола более 5 м². В стекольных, обойных и облицовочных работах при площади пола менее 5 м² затраты труда по таблице 63-13 умножаются на 1,15.</p><div class=\"src\">Источник: Сборник 15, п. 1.2, 2.10, 2.25; Сборник 61, п. 1.4, 2.2; Сборник 63, п. 1.6; Сборник 55, п. 2.1; Сборник 56, п. 2.1</div></div></details>
<div class=\"sub\">Штукатурные работы</div>
<details><summary>Штукатурка внутренних стен</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> периметр помещения × высота стены.</p><p><span class=\"k\">Вычитаем:</span> окна и двери (по наружному обводу коробок) и площадь, занятую тянутыми наличниками.</p><p><span class=\"k\">Добавляем:</span> боковые стороны пилястр.</p><p><span class=\"k\">Откосы:</span> считаются отдельно, см. следующую карточку.</p><p><span class=\"k\">Ремонт штукатурки:</span> считается по площади фактически отремонтированных поверхностей. Для стен криволинейного очертания к затратам труда и работе машин применяется коэффициент 1,1.</p><div class=\"src\">Источник: Сборник 15, п. 2.11; Сборник 61, п. 2.1, 2.2, 2.10</div></div></details>
<details><summary>Откосы окон и дверей внутри здания</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> отдельно, по площади самих откосов. Площадь откосов не входит в площадь стен, её нужно добавить дополнительной строкой.</p><p><span class=\"k\">Уже учтено в норме:</span> боковые и верхние оконные заглушины и откосы ниш отопления входят в нормативы, отдельно их считать не нужно.</p><p><span class=\"k\">Считается отдельно:</span> нижние оконные заглушины, по их площади.</p><div class=\"src\">Источник: Сборник 15, п. 2.13, 2.14</div></div></details>
<details><summary>Штукатурка потолков</summary><div class=\"ans\"><p><span class=\"k\">Обычный потолок:</span> площадь между внутренними гранями стен или перегородок. Кессонный потолок с площадью по плану (горизонтальной проекции) до 12 м² считается так же.</p><p><span class=\"k\">Ребристые перекрытия и кессонные потолки больше 12 м²:</span> считаются по развёрнутой поверхности (по всем плоскостям рёбер и кессонов).</p><p><span class=\"k\">Как получить развёрнутую поверхность при ремонте:</span> площадь по плану умножается на коэффициент: 1,6 для ребристых перекрытий, 1,75 для кессонных потолков.</p><div class=\"src\">Источник: Сборник 15, п. 2.12; Сборник 61, п. 2.3</div></div></details>
<details><summary>Колонны, пилястры, лепные детали, мрамор</summary><div class=\"ans\"><p><span class=\"k\">Колонны и пилястры:</span> площадь развёрнутой поверхности, то есть всех видимых сторон. Это относится и к колоннам, примыкающим к стене, и к отдельно стоящим.</p><p><span class=\"k\">Лепные детали на оштукатуренной поверхности:</span> площадь под ними из площади штукатурки не вычитается.</p><p><span class=\"k\">Основание под искусственный мрамор:</span> в штукатурные работы не входит, оно считается как облицовка.</p><div class=\"src\">Источник: Сборник 15, п. 2.7, 2.9, 2.18; Сборник 61, п. 2.4, 2.5</div></div></details>
<details><summary>Карнизы, тяги, наличники, лестницы</summary><div class=\"ans\"><p><span class=\"k\">Штукатурка карнизов и тяг:</span> длина тяги × (вынос + высота). Внутри здания считается отдельно.</p><p><span class=\"k\">Внутренние тянутые наличники:</span> площадь, которую они занимают на стене (по проекции на стену).</p><p><span class=\"k\">Лестничные марши и площадки:</span> по площади горизонтальной проекции, отдельно для каждого этажа.</p><div class=\"src\">Источник: Сборник 15, п. 2.15–2.17; Сборник 61, п. 2.6, 2.7</div></div></details>
<details><summary>Штукатурка фасадов</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь стен за вычетом проёмов по наружному обводу коробок.</p><p><span class=\"k\">Улучшенная и высококачественная штукатурка:</span> карнизы, пояски, наличники, другие тянутые детали, а также примыкающие к зданию колонны и пилястры в площадь стен не входят и считаются отдельно. Тянутые детали считаются по площади, которую они занимают на фасаде (по проекции на стену). Если карниз имеет вынос больше своей высоты, он считается по площади горизонтальной проекции.</p><p><span class=\"k\">Откосы, отливы и боковые поверхности выступающих или заглублённых деталей:</span> считаются отдельно в двух группах: шириной до 200 мм и шириной более 200 мм.</p><div class=\"src\">Источник: Сборник 15, п. 2.5, 2.6, 2.8; Сборник 61, п. 2.8, 2.9</div></div></details>
<div class=\"sub\">Облицовочные работы</div>
<details><summary>Облицовка природным камнем</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> по площади облицованной поверхности. Размеры стен и колонн берутся с учётом изломов в плане по наружному обводу, то есть по сечению вместе с плитами.</p><p><span class=\"k\">Профилированные камни и детали:</span> площадь без учёта рельефа, по проекции большей стороны.</p><p><span class=\"k\">Выносная тяга (карниз, наличник):</span> если вынос больше высоты, берётся размер тяги по большей стороне.</p><p><span class=\"k\">Ступени и подоконные доски:</span> длина считается вместе с концами плит, заделанными в кладку или штукатурку. Для подоконных досок учитывается заделка в стену и в четверть коробки.</p><div class=\"src\">Источник: Сборник 15, п. 2.1, 2.2; Сборник 56, п. 2.2; Сборник 63, п. 2.4</div></div></details>
<details><summary>Облицовка плитами, мрамором и керамической плиткой</summary><div class=\"ans\"><p><span class=\"k\">Искусственные плиты:</span> по площади облицовки, без учёта рельефа.</p><p><span class=\"k\">Искусственный мрамор:</span> по развёрнутой поверхности облицовки.</p><p><span class=\"k\">Глазурованная керамическая плитка (ремонт):</span> по площади вертикальной проекции облицовываемой поверхности. Дверцы при облицовке ванн кирпичом из площади не вычитаются.</p><p><span class=\"k\">Облицовка откосов проёмов (деревянные стены):</span> по площади тех откосов, которые облицовываются.</p><div class=\"src\">Источник: Сборник 15, п. 2.3, 2.4; Сборник 63, п. 2.5, 2.6; Сборник 53, п. 2.9</div></div></details>
<div class=\"sub\">Малярные работы</div>
<details><summary>Окраска внутренних стен водными составами</summary><div class=\"ans\"><p>К водным составам этого правила относятся клеевые, казеиновые, известковые и силикатные краски. Водоэмульсионные, ПВА и акриловые краски считаются по правилу следующей карточки.</p><p><span class=\"k\">Как считаем:</span> площадь стен целиком, без вычета окон и дверей.</p><p><span class=\"k\">Не добавляем:</span> откосы окон и дверей и боковые поверхности ниш.</p><p><span class=\"k\">Добавляем:</span> площадь столбов и боковых сторон пилястр.</p><p><span class=\"k\">Исключение:</span> если проёмы занимают более 50 % площади отдельной стены, эта стена считается по фактически окрашиваемой поверхности: проёмы вычитаются, откосы окон и дверей и боковые поверхности ниш добавляются.</p><div class=\"src\">Источник: Сборник 15, п. 2.23 и таблица 4; Сборник 62, п. 2.3</div></div></details>
<details><summary>Окраска внутренних стен масляными, ПВА, акриловыми и водоэмульсионными составами</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> периметр × высота стены.</p><p><span class=\"k\">Вычитаем:</span> окна и двери (по наружному обводу коробок).</p><p><span class=\"k\">Добавляем:</span> столбы, пилястры, ниши, откосы окон и дверей.</p><div class=\"src\">Источник: Сборник 15, п. 2.24, 2.25; Сборник 62, п. 2.4</div></div></details>
<details><summary>Окраска потолков</summary><div class=\"ans\"><p><span class=\"k\">Обычный потолок:</span> площадь между внутренними гранями стен.</p><p><span class=\"k\">Ребристые перекрытия:</span> площадь по плану × 1,6.</p><p><span class=\"k\">Кессонные потолки:</span> площадь по плану × 1,75.</p><p><span class=\"k\">Потолки с лепниной:</span> площадь потолка × коэффициент по доле лепки. Доля лепки — это площадь изделий по плану в процентах от площади потолка:</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Доля лепки от площади потолка</th><th>до 2 %</th><th>2,1–10 %</th><th>10,1–40 %</th><th>40,1–70 %</th><th>более 70 %</th></tr></thead><tbody><tr><td>Коэффициент</td><td class=\"m\">1,0</td><td class=\"m\">1,1</td><td class=\"m\">1,5</td><td class=\"m\">2,1</td><td class=\"m\">2,8</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 15, п. 2.26, 2.27; Сборник 62, п. 2.5</div></div></details>
<details><summary>Окраска лепных изделий на стенах и фасадах</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь основания изделия × коэффициент по высоте рельефа и густоте рисунка.</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Высота рельефа</th><th>Редкий рисунок</th><th>Густой рисунок</th></tr></thead><tbody><tr><td>до 30 мм</td><td class=\"m\">1,5</td><td class=\"m\">3,0</td></tr><tr><td>более 30 мм</td><td class=\"m\">3,0</td><td class=\"m\">5,0</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 62, п. 2.11</div></div></details>
<details><summary>Окраска окон и дверей (заполнения проёмов)</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь проёма по наружному обводу коробки × коэффициент из таблицы. Коэффициент зависит от типа заполнения, материала стены и числа переплётов.</p><p>Колонки: «1» и «2» — число переплётов; «проолифленные» — часть площади, у которой детали поступили проолифленными.</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Заполнение</th><th>Стены</th><th>Состав</th><th>1 перепл.</th><th>2 перепл.</th><th>Пролиф. 1</th><th>Пролиф. 2</th></tr></thead><tbody><tr><td>Окно, раздельные переплёты, с подоконной доской</td><td>каменные</td><td>коробка, переплёт, подоконная доска</td><td class=\"m\">1,5</td><td class=\"m\">2,8</td><td class=\"m\">0,3</td><td class=\"m\">0,3</td></tr><tr><td>То же</td><td>деревянные</td><td>коробка, переплёт с наличниками с двух сторон, подоконная доска</td><td class=\"m\">2,2</td><td class=\"m\">3,5</td><td class=\"m\">0,6</td><td class=\"m\">0,6</td></tr><tr><td>Окно, раздельные, без подоконной доски</td><td>каменные</td><td>коробка, переплёт</td><td class=\"m\">1,2</td><td class=\"m\">2,5</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Окно, спаренные, с подоконной доской</td><td>каменные</td><td>коробка, переплёт, подоконная доска</td><td class=\"m\">-</td><td class=\"m\">2,5</td><td class=\"m\">-</td><td class=\"m\">0,3</td></tr><tr><td>Окно, спаренные, без подоконной доски</td><td>каменные</td><td>коробка, переплёт</td><td class=\"m\">-</td><td class=\"m\">2,2</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Фрамуги</td><td>перегородки</td><td>переплёт, наличники с двух сторон</td><td class=\"m\">1,6</td><td class=\"m\">-</td><td class=\"m\">0,7</td><td class=\"m\">-</td></tr><tr><td>Витрина деревянная</td><td>каменные</td><td>коробка, переплёт</td><td class=\"m\">1,75</td><td class=\"m\">3,5</td><td class=\"m\">0,45</td><td class=\"m\">0,9</td></tr><tr><td>Окно промзданий до 4 м², раздельные</td><td>каменные</td><td>коробка, переплёт, раскладки, монтажные подоконные доски</td><td class=\"m\">2,1</td><td class=\"m\">3,2</td><td class=\"m\">0,3</td><td class=\"m\">0,3</td></tr><tr><td>То же, более 4 м²</td><td>каменные</td><td>то же</td><td class=\"m\">1,7</td><td class=\"m\">2,6</td><td class=\"m\">0,2</td><td class=\"m\">0,2</td></tr><tr><td>Балконная дверь, раздельные полотна</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">2,1</td><td class=\"m\">3,5</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Балконная дверь, спаренные полотна</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">-</td><td class=\"m\">2,6</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Дверь глухая</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">2,4</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Дверь глухая</td><td>деревянные</td><td>коробка, полотна, наличники с двух сторон</td><td class=\"m\">2,7</td><td class=\"m\">-</td><td class=\"m\">0,3</td><td class=\"m\">-</td></tr><tr><td>Дверь глухая</td><td>перегородки</td><td>коробка, полотна, наличники с двух сторон</td><td class=\"m\">2,7</td><td class=\"m\">-</td><td class=\"m\">0,3</td><td class=\"m\">-</td></tr><tr><td>Дверь остеклённая</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">1,8</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Дверь остеклённая</td><td>перегородки</td><td>коробка, полотна, наличники с двух сторон</td><td class=\"m\">2,1</td><td class=\"m\">-</td><td class=\"m\">0,3</td><td class=\"m\">-</td></tr><tr><td>Шкафная дверь</td><td>перегородки</td><td>коробка, полотна, наличники с одной стороны</td><td class=\"m\">2,7</td><td class=\"m\">-</td><td class=\"m\">0,2</td><td class=\"m\">-</td></tr><tr><td>Открытый проём</td><td>перегородки</td><td>коробка, наличники с двух сторон</td><td class=\"m\">0,9</td><td class=\"m\">-</td><td class=\"m\">0,4</td><td class=\"m\">-</td></tr></tbody></table></div><ul><li>Фрамуги в наружных стенах считаются как окна соответствующего типа.</li><li>Для дверей в каменных стенах (глухих и остеклённых) коэффициенты даны без наличников. Если наличники есть с одной стороны проёма, коэффициент увеличивается на 0,2.</li><li>Для дверей в перегородках толщиной 140–160 мм с коробками на всю ширину перегородки коэффициент увеличивается на 0,2.</li><li>Окна и балконные двери с тройным остеклением: берутся данные для спаренных переплётов, результат умножается на 1,5.</li><li>В Сборнике 62 (ремонт) таблица почти такая же, но отличается в трёх местах. Деревянные окна с подоконной доской: проолифленные детали при двух переплётах 0,6 и 0,5. Дверь глухая в перегородке: наличники не указаны. Открытый проём: наличники с одной стороны.</li><li>Только рельефные наличники (Сборник 62): площадь по проекции × 1,15.</li><li>Окна со стороны фасада (Сборник 62): раздельные переплёты — коэффициент 0,35 к данным окна «без подоконной доски», спаренные — 0,2 к данным фрамуги. К данным дверей (балконных, а также глухих и остеклённых в каменных стенах) со стороны фасада применяется множитель 0,4.</li></ul><div class=\"src\">Источник: Сборник 15, п. 2.29, таблица 3</div></div></details>
<details><summary>Окраска отдельных элементов окон и дверей (нетиповые заполнения)</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь проёма (м²) × коэффициент элемента. Коэффициент зависит от размера проёма.</p><p class=\"k\">Окна (деревянные)</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Элемент</th><th>до 1,0 м²</th><th>до 2,25 м²</th><th>более 2,25 м²</th></tr></thead><tbody><tr><td>Одинарная коробка</td><td class=\"m\">0,6</td><td class=\"m\">0,45</td><td class=\"m\">0,3</td></tr><tr><td>Двухсторонняя коробка</td><td class=\"m\">1,4</td><td class=\"m\">1,0</td><td class=\"m\">0,8</td></tr><tr><td>Подоконная доска</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td><td class=\"m\">0,2</td></tr><tr><td>Переплёт в 1–2 стекла</td><td class=\"m\">1,0</td><td class=\"m\">0,8</td><td class=\"m\">0,6</td></tr><tr><td>Переплёт в 3–5 стёкол</td><td class=\"m\">1,5</td><td class=\"m\">1,1</td><td class=\"m\">0,8</td></tr><tr><td>Переплёт в 6–11 стёкол</td><td class=\"m\">1,6</td><td class=\"m\">1,2</td><td class=\"m\">0,8</td></tr><tr><td>Переплёт в 12 и более стёкол</td><td class=\"m\">1,8</td><td class=\"m\">1,3</td><td class=\"m\">0,9</td></tr></tbody></table></div><p class=\"k\">Двери (деревянные), площадь проёма</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Элемент</th><th>Однопольная до 1</th><th>до 1,5</th><th>более 1,5</th><th>Двупольная до 2,5</th><th>до 3,5</th><th>более 3,5</th></tr></thead><tbody><tr><td>Коробка шириной 160–200 мм</td><td class=\"m\">0,8</td><td class=\"m\">0,7</td><td class=\"m\">0,6</td><td class=\"m\">0,4</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td></tr><tr><td>Наличники к коробке с двух сторон</td><td class=\"m\">1,0</td><td class=\"m\">0,9</td><td class=\"m\">0,8</td><td class=\"m\">0,6</td><td class=\"m\">0,5</td><td class=\"m\">0,4</td></tr><tr><td>Полотно полусветлое, остекление до 0,5 м²</td><td class=\"m\">-</td><td class=\"m\">2,1</td><td class=\"m\">1,9</td><td class=\"m\">-</td><td class=\"m\">2,1</td><td class=\"m\">1,9</td></tr><tr><td>Полотно полусветлое, остекление до 1,0 м²</td><td class=\"m\">-</td><td class=\"m\">1,3</td><td class=\"m\">1,5</td><td class=\"m\">-</td><td class=\"m\">1,3</td><td class=\"m\">1,5</td></tr><tr><td>Полотно полусветлое, остекление более 1,0 м²</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">1,2</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">1,2</td></tr><tr><td>Полотно филенчатое</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,1</td></tr><tr><td>Полотно гладкое</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td></tr></tbody></table></div><p class=\"k\">Витрины (деревянные)</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Элемент</th><th>до 4 м²</th><th>до 10 м²</th><th>более 10 м²</th></tr></thead><tbody><tr><td>Коробка</td><td class=\"m\">0,4</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td></tr><tr><td>Переплёт в 1 стекло</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td><td class=\"m\">0,3</td></tr><tr><td>Два переплёта в 1 стекло и 2 коробки</td><td class=\"m\">1,6</td><td class=\"m\">1,4</td><td class=\"m\">1,2</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 62, п. 2.6, таблицы 2-6.1, 2-6.2, 2-6.3</div></div></details>
<details><summary>Окраска полов и плинтусов</summary><div class=\"ans\"><p><span class=\"k\">Пол:</span> площадь пола без мест, занятых колоннами, печами, фундаментами и другими конструкциями, выступающими над полом.</p><p><span class=\"k\">Плинтус дощатого пола:</span> отдельно не считается, он уже входит в окраску пола.</p><p><span class=\"k\">Плинтус паркетного пола и пола из линолеума:</span> принимается как 10 % от площади пола. Расход определяется по нормам на улучшенную окраску дощатых полов.</p><div class=\"src\">Источник: Сборник 15, п. 1.20, 2.28; Сборник 62, п. 2.7</div></div></details>
<details><summary>Окраска фасадов</summary><div class=\"ans\"><p><span class=\"k\">Известковые, силикатные составы (в ремонте также цементные и казеиновые):</span> площадь стен с учётом изломов в плане, без вычета проёмов. Площади откосов, карнизов, тяг и других архитектурных деталей не учитываются.</p><p><span class=\"k\">Перхлорвиниловые, кремнийорганические, поливинилацетатные составы (в Сборнике 15 также акриловые):</span> площадь фактически окрашиваемой поверхности.</p><p><span class=\"k\">Фасадные работы по таблице 15-260:</span> площадь проёмов принята равной 30 % от площади фасада.</p><p><span class=\"k\">Водосточные трубы, пояски, сандрики, наружные подоконники:</span> по Сборнику 15: по площади фасада без вычета проёмов. По Сборнику 62 (ремонт): по площади фактически окрашиваемой поверхности.</p><p><span class=\"k\">Водосточные трубы диаметром 100–220 мм:</span> поверхность 100 м труб, включая ухваты, стыки и фальцы, принимается равной 3,5 м² на каждые 10 мм диаметра трубы. Воронка (с обеих сторон) считается как 1 м трубы того же диаметра.</p><div class=\"src\">Источник: Сборник 15, п. 2.21, 2.22, 2.32, 2.37; Сборник 62, п. 2.1, 2.2, 2.13</div></div></details>
<details><summary>Окраска древесины, вагонки, волнистых и рельефных поверхностей</summary><div class=\"ans\"><p><span class=\"k\">Вагонка:</span> площадь измеряется без огибания калёвок и отборок. Для учёта рельефа: по Сборнику 15 результат умножается на 1,1, по Сборнику 62 (ремонт) увеличивается на 20 %.</p><p><span class=\"k\">Бревенчатые стены:</span> обмер без огибания брёвен, результат увеличивается на 5 %, окна и двери вычитаются. Если есть обделки (карнизы, пилястры, откосы, наличники), проёмы не вычитаются и площадь обделок не прибавляется.</p><p><span class=\"k\">Волнистые асбоцементные листы и сталь:</span> площадь без учёта волны, результат × 1,2.</p><p><span class=\"k\">Рельефные стены (шагрень, шуба, линкруст и подобные):</span> объём работ увеличивается на 5 %.</p><p><span class=\"k\">Своды полуциркульные и эллиптические:</span> по развёрнутой поверхности.</p><p><span class=\"k\">Деревянные фермы:</span> площадь вертикальной проекции (с одной стороны), промежутки между элементами не вычитаются.</p><p><span class=\"k\">Металлическая кровля:</span> площадь кровли, без отдельного учёта фальцев, желобов, зонтов на дымовых трубах и покрытий слуховых окон.</p><div class=\"src\">Источник: Сборник 15, п. 2.30, 2.31, 2.33, 2.34; Сборник 62, п. 2.8–2.10, 2.12, 2.16</div></div></details>
<details><summary>Окраска решёток, сеток, мебели, труб и приборов</summary><div class=\"ans\"><p><span class=\"k\">Стальные решётки:</span> площадь вертикальной проекции с одной стороны, промежутки не вычитаются, затем коэффициент: простые решётки без рельефа с заполнением до 20 % (парапетные, пожарные лестницы, сетки с рамкой) — 0,5; средней сложности с заполнением до 30 % (лестничные, балконные) — 1; сложные с рельефом и заполнением более 30 % (жалюзийные, радиаторные, художественные) — 2,5.</p><p><span class=\"k\">Проволочная сетка:</span> площадь по контуру с обвязкой × 0,4. Обрамление из уголка считается отдельно.</p><p><span class=\"k\">Мебель:</span> шкафы, буфеты, гардеробы — по фактическому замеру. Табурет: площадь сиденья × 3,5. Скамья: × 2,75. Стул: × 4. Стол: площадь крышки × 2,5.</p><p><span class=\"k\">Раковины, мойки:</span> удвоенная площадь горизонтальной проекции.</p><p><span class=\"k\">Ванны:</span> утроенная площадь горизонтальной проекции.</p><p><span class=\"k\">Смывной бачок:</span> 0,7 м² (с учётом кронштейнов).</p><p><span class=\"k\">Радиаторы отопления:</span> площадь поверхности нагрева, со всех сторон. На один элемент (секцию): М-14А 0,254; М-14ОАО 0,299; М-90 0,2; МС-140 0,238; РД-90С 0,203; Стандарт-90 0,2 м². Панельный радиатор типа РСГ-1-1-3 — 0,73 м².</p><p><span class=\"k\">Большие металлические поверхности:</span> считаются площади более 5 м² в одном месте.</p><p>Окраска 1 погонного метра труб, м²:</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Диаметр, мм</th><th>15</th><th>20</th><th>25</th><th>32</th><th>40</th><th>50</th><th>63</th><th>75</th><th>100</th><th>125</th><th>150</th></tr></thead><tbody><tr><td>Стальные</td><td class=\"m\">0,11</td><td class=\"m\">0,13</td><td class=\"m\">0,16</td><td class=\"m\">0,18</td><td class=\"m\">0,21</td><td class=\"m\">0,26</td><td class=\"m\">0,31</td><td class=\"m\">0,36</td><td class=\"m\">0,46</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Чугунные</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">0,28</td><td class=\"m\">-</td><td class=\"m\">0,37</td><td class=\"m\">0,48</td><td class=\"m\">0,59</td><td class=\"m\">0,72</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 15, п. 2.35, 2.36; Сборник 62, п. 2.14, 2.15, 2.17–2.19</div></div></details>
<div class=\"sub\">Обойные и стекольные работы</div>
<details><summary>Оклейка обоями, обивка дверей, снятие старых обоев</summary><div class=\"ans\"><p><span class=\"k\">Оклейка стен:</span> площадь оклеиваемой поверхности. Окна и двери вычитаются, их площадь берётся по наружному обводу коробок.</p><p><span class=\"k\">Обивка дверей:</span> площадь фактически обиваемой поверхности.</p><p><span class=\"k\">Снятие старых обоев и линкруста:</span> площадь очищенной от обоев поверхности.</p><div class=\"src\">Источник: Сборник 15, п. 2.46, 2.47; Сборник 63, п. 2.2, 2.3</div></div></details>
<details><summary>Остекление</summary><div class=\"ans\"><p><span class=\"k\">Деревянные переплёты и балконные двери (жилые и общественные здания):</span> площадь проёма по наружному обводу коробок.</p><p><span class=\"k\">Двери (кроме балконных) и витрины:</span> по размеру стёкол.</p><p><span class=\"k\">Деревянная перегородка:</span> по наружному обводу её обвязки.</p><p><span class=\"k\">Стеновые и фонарные переплёты промзданий:</span> стальные: по наружному обводу обвязки. Деревянные в коробке: по наружному обводу коробки. Деревянные без коробки: по наружному обводу обвязки.</p><p><span class=\"k\">Стеновые панели из профильного стекла:</span> по наружному обводу стальных рам (проёмов в панелях нет).</p><p><span class=\"k\">Окно из профильного стекла:</span> по наружному обводу металлического обрамления или деревянной обвязки.</p><p><span class=\"k\">Зенитный фонарь из профильного стекла:</span> по внутреннему обводу низа его стакана (по световому проёму).</p><p><span class=\"k\">Перегородки из профильного стекла или стеклянных блоков:</span> по наружному обводу коробок за вычетом площади проёмов.</p><p><span class=\"k\">Остекление при ремонте:</span> по площади остекления, то есть по размеру стёкол.</p><div class=\"src\">Источник: Сборник 15, п. 2.38–2.45; Сборник 63, п. 2.1</div></div></details>
<div class=\"sub\">Полы</div>
<details><summary>Покрытие пола и подготовка под него</summary><div class=\"ans\"><p><span class=\"k\">Покрытие:</span> площадь между внутренними гранями стен или перегородок с учётом толщины отделки.</p><p><span class=\"k\">Добавляем:</span> покрытие в подоконных нишах и дверных проёмах.</p><p><span class=\"k\">Вычитаем:</span> перегородки, колонны, печи, выступающие фундаменты и другие подобные конструкции. При ремонте чистые перегородки не вычитаются.</p><p><span class=\"k\">Подстилающий слой (подготовка):</span> объём считается без мест, занятых печами, колоннами, выступающими фундаментами и подобными конструкциями.</p><p><span class=\"k\">Плитки ПВХ типа Colorex:</span> из площади покрытия вычитается площадь горизонтальной проекции устанавливаемого плинтуса.</p><p><span class=\"k\">Лаги:</span> разборка и смена — по площади пола.</p><div class=\"src\">Источник: Сборник 11, п. 2.1, 2.2, 2.4; Сборник 57, п. 2.1–2.3</div></div></details>
<div class=\"sub\">Перегородки, потолки, стены (ремонт)</div>
<details><summary>Перегородки</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь ремонтируемых перегородок за вычетом проёмов (по наружному обводу коробок). Высота — от чистого пола до потолка или до верха перегородки.</p><p><span class=\"k\">Смена отдельных участков:</span> по площади сменяемых участков.</p><p><span class=\"k\">Заделка проёмов:</span> по площади проёма.</p><div class=\"src\">Источник: Сборник 55, п. 2.1–2.3</div></div></details>
<details><summary>Перекрытия и подшивка потолков</summary><div class=\"ans\"><p><span class=\"k\">Ремонтируемые перекрытия:</span> площадь в пределах капитальных стен, без вычета мест, занятых печами и трубами.</p><p><span class=\"k\">Частичная смена перекрытий:</span> площадь между осями балок и капитальными стенами.</p><p><span class=\"k\">Подшивка потолков (разборка, устройство):</span> по площади подшивки.</p><p><span class=\"k\">Смена подборов перекрытий:</span> расстояние между осями балок × длина сменяемого участка.</p><div class=\"src\">Источник: Сборник 54, п. 2.1–2.3</div></div></details>
<details><summary>Стены (кирпичная кладка и деревянные)</summary><div class=\"ans\"><p><span class=\"k\">Кирпичная кладка:</span> объём за вычетом проёмов (по наружному обводу коробок). Архитектурные детали (пилястры, полуколонны, карнизы, парапеты, эркеры, лоджии) включаются в объём. Мелкие детали высотой до 25 см (сандрики, пояски) уже учтены и отдельно не добавляются.</p><p><span class=\"k\">Ниши и борозды:</span> гнёзда и борозды для балок и плит, а также ниши для отопительных приборов, вентиляционных и дымовых каналов из объёма не вычитаются. Ниши для встроенного оборудования в объём не включаются.</p><p><span class=\"k\">Периметр деревянных стен:</span> наружных — по наружным размерам здания, внутренних — по размерам между внутренними гранями стен.</p><p><span class=\"k\">Высота деревянных стен:</span> рубленых и каркасных — от нижней грани нижнего венца (обвязки) до верхней грани верхнего венца (обвязки). Из готовых щитов — от нижней грани цокольной обвязки до верха чердачной балки.</p><p><span class=\"k\">Площадь стен:</span> за вычетом проёмов, которые измеряются по наружным размерам коробок.</p><div class=\"src\">Источник: Сборник 53, п. 2.1–2.7</div></div></details>
<details><summary>Окна, двери, подоконные доски</summary><div class=\"ans\"><p><span class=\"k\">Окна и двери:</span> площадь проёма по наружному обводу коробок.</p><p><span class=\"k\">Подоконные доски:</span> площадь с учётом заделки в стену и в четверть коробки.</p><div class=\"src\">Источник: Сборник 56, п. 2.1, 2.2</div></div></details>
<div class=\"sub\">Лепные работы и леса</div>
<details><summary>Лепные работы</summary><div class=\"ans\"><p><span class=\"k\">Объём:</span> принимается по проекту и по перечню изделий в сборнике.</p><p><span class=\"k\">Высота выпуклых погонных деталей:</span> по огибу поперечного сечения.</p><p><span class=\"k\">Галтели и карнизы (нормативы Е15-109-6 … Е15-109-10):</span> длина устраиваемого карниза без декоративных стыковочных элементов (в том числе угловых), результат × 1,05.</p><p><span class=\"k\">Базы и капители на пилястры и полуколонны:</span> как на колонны, с коэффициентом 0,5.</p><p><span class=\"k\">Угловые базы (четверть окружности или четырёхугольник):</span> по таблицам баз на пилястрах с коэффициентом 0,5.</p><div class=\"src\">Источник: Сборник 15, п. 1.11, 2.19, 2.20; Сборник 64, п. 2.1, 2.2</div></div></details>
<details><summary>Леса и подмости</summary><div class=\"ans\"><p><span class=\"k\">Наружные леса:</span> по площади их вертикальной проекции на фасад.</p><p><span class=\"k\">Внутренние леса со сплошным настилом:</span> по площади горизонтальной проекции на основание (для штукатурки потолков и стен — по горизонтальной проекции потолков).</p><p><span class=\"k\">Внутренние леса только вдоль стен:</span> по площади вертикальной проекции на стены. Расчёт ведётся по нормам на устройство наружных лесов для отделочных работ (таблица 69-20, норма 2).</p><p><span class=\"k\">Фасады при штукатурке:</span> по вертикальной проекции стен без вычета проёмов.</p><div class=\"src\">Источник: Сборник 69, п. 2.1; Сборник 61, п. 2.11</div></div></details></div><p class=\"e-note\">Справочник носит информационный характер. Перед использованием в договорной смете числа проверяет технический специалист по действующим нормам.</p>"
}

pattern EstQualTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Качество работ</div><h1>Как определяется качество работ</h1><p class=\"e-lead\">Качество отделки в сметных нормах определяется классом: простая, улучшенная или высококачественная. Класс задаёт, какие операции обязательны. Чем выше класс, тем больше слоёв и проходов, тем дороже и ровнее результат.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\" class=\"on\" aria-current=\"page\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><section class=\"e-sec\"><h2>Три класса отделки</h2><div class=\"e-cards three\"><div class=\"e-card\"><span class=\"e-tag\">Простая</span><h3>9 операций из 19</h3><p>Очистка, расшивка трещин, подмазка и два слоя краски. Без сплошной шпатлёвки: неровности основания остаются заметными. Подходит для подсобных и технических помещений.</p></div><div class=\"e-card\"><span class=\"e-tag\">Улучшенная</span><h3>17 операций из 19</h3><p>К простой добавляются сплошная шпатлёвка, шлифовка, огрунтовка и флейцевание (разглаживание краски мягкой кистью). Поверхность ровная, следов кисти нет. Обычный выбор для квартир и офисов.</p></div><div class=\"e-card\"><span class=\"e-tag ok\">Высококачественная</span><h3>19 операций из 19</h3><p>Две сплошные шпатлёвки с двумя шлифовками. Максимально ровная и гладкая поверхность, нужна под глянец и боковой свет, а также в представительных помещениях.</p></div></div></section><section class=\"e-sec\"><h2>Что входит в каждый класс</h2><p class=\"e-lead2\">Пример: окраска водоэмульсионными составами по штукатурке. Перечень операций изложен по технической части сборника 15 норм НРР-2022 (таблица 7) своими словами; число операций сохранено.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Операция</th><th>Простая</th><th>Улучшенная</th><th>Высококачественная</th></tr></thead><tbody><tr><td>Очистка поверхности</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Сглаживание торцом дерева</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Расшивка трещин</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Проолифка</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Частичная подмазка с проолифкой подмазанных мест</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка подмазанных мест</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Первая сплошная шпатлёвка</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после первой шпатлёвки</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Вторая сплошная шпатлёвка</td><td class=\"m no\">нет</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после второй шпатлёвки</td><td class=\"m no\">нет</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td></tr><tr><td>Огрунтовка</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Флейцевание после грунтовки</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после грунтовки</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Первая окраска</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Флейцевание после первой окраски</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после первой окраски</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Вторая окраска</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Флейцевание или торцевание после второй окраски</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Вытягивание филёнок</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr class=\"tot\"><td>Итого операций</td><td class=\"m\">9</td><td class=\"m\">17</td><td class=\"m\">19</td></tr></tbody></table></div><p class=\"e-note\">Для масляных составов и других оснований (дерево, металл, сборные конструкции) набор операций отличается. Эти таблицы добавим после сверки.</p></section><section class=\"e-sec\"><h2>Карточки по видам работ</h2><p class=\"e-lead2\">Для каждого вида работ: допустимые отклонения, условия приёмки и схема. Числа взяты из белорусских норм: СП 1.03.01-2019 «Отделочные работы» (отделка и полы), ТКП 339-2022 и СН 4.04.01-2019 (электрика). Пункты указаны рядом. Каждую карточку можно скачать картинкой или документом с водяным знаком.</p></section><div class=\"e-sub q-chips\"><a href=\"#sec-obshchie\">Общие условия<span class=\"q-n\">1</span></a><a href=\"#sec-shtukaturka\">Штукатурные работы<span class=\"q-n\">3</span></a><a href=\"#sec-oblitsovka\">Облицовка и потолки<span class=\"q-n\">2</span></a><a href=\"#sec-okraska\">Окраска, обои и стекло<span class=\"q-n\">3</span></a><a href=\"#sec-poly\">Полы<span class=\"q-n\">6</span></a><a href=\"#sec-beton\">Бетонные работы<span class=\"q-n\">4</span></a><a href=\"#sec-sbornye\">Сборные конструкции<span class=\"q-n\">2</span></a><a href=\"#sec-kamen\">Каменные работы<span class=\"q-n\">4</span></a><a href=\"#sec-derevo\">Деревянные конструкции<span class=\"q-n\">3</span></a><a href=\"#sec-elektrika\">Электрика<span class=\"q-n\">13</span></a><a href=\"#sec-vodokanal\">Водоснабжение и канализация<span class=\"q-n\">5</span></a><a href=\"#sec-otoplenie\">Отопление<span class=\"q-n\">4</span></a><a href=\"#sec-ventilyaciya\">Вентиляция<span class=\"q-n\">4</span></a><a href=\"#sec-inzh-obshchie\">Общее для инженерных систем<span class=\"q-n\">4</span></a><a href=\"#sec-ispytaniya\">Испытания трубопроводов<span class=\"q-n\">2</span></a></div><details class=\"q-sec\" id=\"sec-obshchie\"><summary><span class=\"q-sh\"><b>Общие условия</b><small>Температура, влажность и подготовка основания для любой отделки.</small></span><span class=\"q-n\">1</span></summary><div class=\"e-sub q-chips\"><a href=\"#usloviya\">Условия производства отделки</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"usloviya\"><header><h3>Условия производства отделки</h3><p>Что должно быть выполнено до начала работ и пока идут работы. Общие для штукатурки, окраски, плитки и обоев.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 3.3–3.19, 7.11</div></header><div class=\"q-facts\"><div><b>+10 °C</b><span>и выше: воздух и основание внутри здания</span></div><div><b>≤ 60 %</b><span>влажность воздуха внутри, без сквозняков</span></div><div><b>8 % / 12 %</b><span>предельная влажность основания: бетон, камень, штукатурка / дерево</span></div><div><b>2 + 12 сут</b><span>держать +10 °C до начала и после окончания работ</span></div></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Внутри здания: температура воздуха и основания не ниже +10 °C, влажность воздуха не более 60 %, сквозняков нет (п. 3.14).</li><li>Температуру не ниже +10 °C держат круглосуточно: не менее 2 суток до начала, во время работ и не менее 12 суток после. Для обоев: до сдачи объекта (п. 3.14).</li><li>Снаружи: температура воздуха и основания не ниже +5 °C (п. 3.12).</li><li>Влажность основания под штукатурку, окраску, облицовку и обои: бетон, камень, оштукатуренные и прошпатлёванные поверхности не более 8 %, дерево не более 12 % (п. 3.17).</li><li>Сушить помещение можно калориферами. Открытые жаровни и печи-времянки запрещены (п. 3.15).</li><li>Нельзя красить и клеить обои по основанию с высолами, жировыми и битумными пятнами, наплывами раствора, ржавчиной и побелкой (п. 3.18).</li><li>Перед каждым слоем покрытия поверхность обеспыливают (п. 3.19).</li><li>Материалы поступают с документом о качестве изготовителя, сертификатом или декларацией соответствия (п. 3.4). Работы ведут по проекту производства работ и технологическим картам (п. 3.3).</li><li>Фасады не красят по наледи, в дождь и по сырой стене, при ветре сильнее 10 м/с (п. 7.11).</li></ul></div><p class=\"e-note\">Порядок и методы контроля задают СТБ 1472–1475 и СТБ 1483 (п. 3.9).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/usloviya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/usloviya.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-shtukaturka\"><summary><span class=\"q-sh\"><b>Штукатурные работы</b><small>Геометрия, слои и декоративные покрытия.</small></span><span class=\"q-n\">3</span></summary><div class=\"e-sub q-chips\"><a href=\"#shtukaturka-geometriya\">Штукатурка внутри здания: геометрия</a><a href=\"#shtukaturka-sloi\">Штукатурка: слои, армирование, сцепление</a><a href=\"#dekor-lepnina\">Декоративные покрытия и лепные изделия</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"shtukaturka-geometriya\"><header><h3>Штукатурка внутри здания: геометрия</h3><p>Допустимые отклонения оштукатуренных поверхностей для трёх видов штукатурки. Вид указывает проект (п. 4.2).</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 2, п. 4.2</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Простое</th><th class=\"n\">Улучшенное</th><th class=\"n\">Высококачественное</th></tr></thead><tbody><tr><td>Вертикальность на всю высоту помещения</td><td class=\"n m\">15</td><td class=\"n m\">10</td><td class=\"n m\">5</td></tr><tr><td>Вертикальность на 1 м высоты</td><td class=\"n m\">3</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>Горизонтальность на 1 м</td><td class=\"n m\">3</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>Неровности на участке 4 м²: число, не более (шт.)</td><td class=\"n m\">3</td><td class=\"n m\">2</td><td class=\"n m\">2</td></tr><tr><td>Неровности: глубина (высота), не более</td><td class=\"n m\">5</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>Откосы, пилястры, столбы, лузги: вертикальность на высоту</td><td class=\"n m\">10</td><td class=\"n m\">5</td><td class=\"n m\">3</td></tr><tr><td>Откосы, пилястры, столбы, лузги: на 1 м</td><td class=\"n m\">4</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>Криволинейные поверхности: отклонение от радиуса</td><td class=\"n m\">10</td><td class=\"n m\">7</td><td class=\"n m\">5</td></tr><tr><td>Откосы: отклонение ширины</td><td class=\"n m\">5</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>Тяги: прямолинейность между углами</td><td class=\"n m\">6</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 266\" role=\"img\" aria-label=\"Допуски по классам\" class=\"e-svg\"><rect x=\"190\" y=\"12\" width=\"12\" height=\"12\" fill=\"#c6c8cd\"/><text x=\"208\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Простое</text><rect x=\"281\" y=\"12\" width=\"12\" height=\"12\" fill=\"#6a6d75\"/><text x=\"299\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Улучшенное</text><rect x=\"393\" y=\"12\" width=\"12\" height=\"12\" fill=\"#1d1f23\"/><text x=\"411\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Высококачественное</text><text x=\"0\" y=\"58\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">На всю высоту</text><rect x=\"190\" y=\"34\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"44\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">15 мм</text><rect x=\"190\" y=\"49\" width=\"253.3\" height=\"11\" fill=\"#6a6d75\"/><text x=\"451.33333333333337\" y=\"59\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><rect x=\"190\" y=\"64\" width=\"126.7\" height=\"11\" fill=\"#1d1f23\"/><text x=\"324.6666666666667\" y=\"74\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"116\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">На 1 м высоты</text><rect x=\"190\" y=\"92\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"102\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"107\" width=\"253.3\" height=\"11\" fill=\"#6a6d75\"/><text x=\"451.33333333333337\" y=\"117\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><rect x=\"190\" y=\"122\" width=\"126.7\" height=\"11\" fill=\"#1d1f23\"/><text x=\"324.6666666666667\" y=\"132\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><text x=\"0\" y=\"174\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Глубина неровностей</text><rect x=\"190\" y=\"150\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"160\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><rect x=\"190\" y=\"165\" width=\"228.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"426.0\" y=\"175\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"180\" width=\"152.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"350.0\" y=\"190\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"232\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Откосы, столбы: на высоту</text><rect x=\"190\" y=\"208\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"218\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><rect x=\"190\" y=\"223\" width=\"190.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"388.0\" y=\"233\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><rect x=\"190\" y=\"238\" width=\"114.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"312.0\" y=\"248\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text></svg></div><div class=\"q-viz\"><svg viewBox=\"0 0 620 214\" role=\"img\" aria-label=\"Схема проверки ровности рейкой\" class=\"e-svg\"><g transform=\"translate(0,-68)\"><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170 L600 225 L20 225 Z\" fill=\"#f6f6f7\" opacity=\"0.7\"/><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\"/><rect x=\"50\" y=\"118\" width=\"520\" height=\"10\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"470\" y1=\"128\" x2=\"470\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"458\" y1=\"128\" x2=\"482\" y2=\"128\" stroke=\"#e3000f\" stroke-width=\"2\"/><line x1=\"458\" y1=\"170\" x2=\"482\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"494\" y=\"145\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">размер</text><text x=\"494\" y=\"163\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">неровности</text><text x=\"50\" y=\"108\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">рейка 2 м</text><text x=\"300\" y=\"196\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"middle\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">выпуклость</text><text x=\"24\" y=\"246\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">поверхность</text><text x=\"20\" y=\"272\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"500\" font-family=\"Nunito, Arial, sans-serif\">Допуск глубины неровности: 5 мм (простое), 3 мм (улучшенное), 2 мм (высококачественное)</text></g></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Поверхность гладкая и однородная, без пузырей, включений и трещин. Допускаются только усадочные трещины шириной не более 0,2 мм (п. 4.8).</li><li>Отклонения не выходят за пределы строки таблицы для вида штукатурки из проекта (табл. 2).</li><li>Малярные и обойные работы начинают по основанию, соответствующему табл. 2 (п. 7.1, 8.1).</li></ul></div><p class=\"e-note\">Метод измерений (рейка, отвес, уровень) задают СТБ 1472–1475. Схема проверки ровности показана ниже.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-geometriya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-geometriya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"shtukaturka-sloi\"><header><h3>Штукатурка: слои, армирование, сцепление</h3><p>Сколько слоёв и какой толщины, когда нужна сетка и какую прочность сцепления проверяют.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 1, п. 4.5–4.15</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Однослойное покрытие из гипсовых смесей, не более</td><td class=\"n m\">15</td></tr><tr><td>Однослойное покрытие из других смесей, не более</td><td class=\"n m\">20</td></tr><tr><td>Первый слой (обрызг) по камню и бетону</td><td class=\"n m\">5</td></tr><tr><td>Первый слой (обрызг) по дереву с дранкой</td><td class=\"n m\">9</td></tr><tr><td>Второй слой (грунт): известковый и известково-гипсовый</td><td class=\"n m\">7</td></tr><tr><td>Второй слой (грунт): цементный</td><td class=\"n m\">5</td></tr><tr><td>Третий слой: накрывочный</td><td class=\"n m\">2</td></tr><tr><td>Третий слой: декоративный накрывочный</td><td class=\"n m\">7</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 320\" role=\"img\" aria-label=\"Слои штукатурки\" class=\"e-svg\"><text x=\"0\" y=\"16\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Слои штукатурки по камню и бетону (масштаб 10:1)</text><rect x=\"10\" y=\"36\" width=\"150\" height=\"230\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><line x1=\"10\" y1=\"60\" x2=\"34\" y2=\"36\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"60\" x2=\"104\" y2=\"36\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"84\" x2=\"34\" y2=\"60\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"84\" x2=\"104\" y2=\"60\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"108\" x2=\"34\" y2=\"84\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"108\" x2=\"104\" y2=\"84\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"132\" x2=\"34\" y2=\"108\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"132\" x2=\"104\" y2=\"108\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"156\" x2=\"34\" y2=\"132\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"156\" x2=\"104\" y2=\"132\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"180\" x2=\"34\" y2=\"156\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"180\" x2=\"104\" y2=\"156\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"204\" x2=\"34\" y2=\"180\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"204\" x2=\"104\" y2=\"180\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"228\" x2=\"34\" y2=\"204\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"228\" x2=\"104\" y2=\"204\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"252\" x2=\"34\" y2=\"228\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"252\" x2=\"104\" y2=\"228\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"276\" x2=\"34\" y2=\"252\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"276\" x2=\"104\" y2=\"252\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><text x=\"18\" y=\"286\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">основание</text><rect x=\"160\" y=\"36\" width=\"50\" height=\"230\" fill=\"#c6c8cd\"/><rect x=\"330\" y=\"46\" width=\"16\" height=\"16\" fill=\"#c6c8cd\"/><text x=\"356\" y=\"59\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Обрызг</text><text x=\"356\" y=\"79\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">5 мм (по дереву с дранкой 9 мм)</text><rect x=\"210\" y=\"36\" width=\"70\" height=\"230\" fill=\"#6a6d75\"/><rect x=\"330\" y=\"108\" width=\"16\" height=\"16\" fill=\"#6a6d75\"/><text x=\"356\" y=\"121\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Грунт</text><text x=\"356\" y=\"141\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">7 мм известковый, 5 мм цементный</text><rect x=\"280\" y=\"36\" width=\"20\" height=\"230\" fill=\"#e3000f\"/><rect x=\"330\" y=\"170\" width=\"16\" height=\"16\" fill=\"#e3000f\"/><text x=\"356\" y=\"183\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Накрывка</text><text x=\"356\" y=\"203\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">2 мм (декоративная 7 мм)</text><line x1=\"160\" y1=\"280\" x2=\"300\" y2=\"280\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"330\" y=\"252\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Три слоя вместе: 14 мм</text><text x=\"330\" y=\"272\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Однослойно: до 15 мм (гипс), до 20 мм (прочие)</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Прочность сцепления с основанием: внутри здания не менее 0,2 МПа, снаружи не менее 0,4 МПа, если проект не задаёт иное (п. 4.5).</li><li>Слой до 10 мм можно не армировать. От 10 до 15 мм: стеклянная штукатурная сетка. От 15 до 20 мм: стальная сетка. Больше 20 мм нельзя, кроме лёгких и теплоизоляционных штукатурок (п. 4.13).</li><li>Сетка лежит внутри слоя, не касается основания и не выходит на поверхность (п. 4.14).</li><li>Конструктивное армирование ставят в углах проёмов, под окнами, на выступающих углах, в стыках разных материалов (п. 4.15).</li><li>Нельзя нагревать штукатурку при высыхании выше +23 °C и сквозняком проветривать. При +23 °C и выше основание увлажняют (п. 4.6, 4.7).</li><li>Гипсовое основание штукатурят только гипсовыми смесями по огрунтованной поверхности (п. 4.17).</li></ul></div><p class=\"e-note\">Ячеистый бетон: трещины шире 0,2 мм, раковины глубиной 12 мм и больше и «зуб» выше 1,5 мм в основании недопустимы, первый слой не тоньше 10 мм, водоудерживающая способность смеси не менее 95 % (п. 4.10–4.12).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-sloi.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-sloi.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"dekor-lepnina\"><header><h3>Декоративные покрытия и лепные изделия</h3><p>Гладкие декоративные покрытия выполняют по требованиям к штукатурке. Для лепных изделий есть свои допуски.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 4.18, 4.19, 5.1–5.4</div></header><div class=\"q-facts\"><div><b>1 мм</b><span>на 1 м длины: отклонение лепной детали от вертикали и горизонтали</span></div><div><b>10 мм</b><span>наибольшее смещение осей крупных деталей</span></div></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Декоративное покрытие сплошное, без пропусков, с прочным сцеплением с основанием (п. 5.2).</li><li>Толщину и число слоёв задают проект, технические документы и рекомендации изготовителя смеси (п. 5.3, 5.4).</li><li>Лепные изделия: стыки без перепадов, швы незаметны, нет раковин, изломов, трещин и наплывов, рельеф чёткий (п. 4.19).</li><li>Лепные изделия ставят после схватывания и высыхания штукатурки, крепят к арматуре, защищённой от коррозии (п. 4.18).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/dekor-lepnina.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/dekor-lepnina.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-oblitsovka\"><summary><span class=\"q-sh\"><b>Облицовка и потолки</b><small>Плитка, камень, листовые и панельные облицовки, подвесные потолки.</small></span><span class=\"q-n\">2</span></summary><div class=\"e-sub q-chips\"><a href=\"#oblitsovka-plitkoi\">Облицовка плиткой и камнем стен</a><a href=\"#listovye-potolki\">Листовые и панельные облицовки, подвесные потолки</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"oblitsovka-plitkoi\"><header><h3>Облицовка плиткой и камнем стен</h3><p>Допуски облицовки по виду поверхности и условия приёмки. Облицовку выполняют до устройства покрытия пола.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 3, п. 6.1–6.9</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Зеркальная, лощёная</th><th class=\"n\">Шлифованная и др.</th><th class=\"n\">Керамика</th></tr></thead><tbody><tr><td>Вертикальность на 1 м</td><td class=\"n m\">2</td><td class=\"n m\">3</td><td class=\"n m\">1,5</td></tr><tr><td>Вертикальность на этаж</td><td class=\"n m\">4</td><td class=\"n m\">8</td><td class=\"n m\">4</td></tr><tr><td>Положение швов от вертикали и горизонтали на 1 м</td><td class=\"n m\">1,5</td><td class=\"n m\">3</td><td class=\"n m\">1,5</td></tr><tr><td>Перепады на стыках</td><td class=\"n m\">1</td><td class=\"n m\">1</td><td class=\"n m\">1</td></tr><tr><td>Ровность на 1 м</td><td class=\"n m\">2</td><td class=\"n m\">4</td><td class=\"n m\">2</td></tr><tr><td>Ширина шва (плюс-минус)</td><td class=\"n m\">0,5</td><td class=\"n m\">1</td><td class=\"n m\">0,5</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 266\" role=\"img\" aria-label=\"Допуски облицовки\" class=\"e-svg\"><rect x=\"190\" y=\"12\" width=\"12\" height=\"12\" fill=\"#c6c8cd\"/><text x=\"208\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Зеркальная</text><rect x=\"302\" y=\"12\" width=\"12\" height=\"12\" fill=\"#6a6d75\"/><text x=\"320\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Шлифованная</text><rect x=\"421\" y=\"12\" width=\"12\" height=\"12\" fill=\"#1d1f23\"/><text x=\"439\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Керамика</text><text x=\"0\" y=\"58\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Вертикальность на 1 м</text><rect x=\"190\" y=\"34\" width=\"253.3\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"451.33333333333337\" y=\"44\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><rect x=\"190\" y=\"49\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"59\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"64\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"74\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"116\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Положение швов на 1 м</text><rect x=\"190\" y=\"92\" width=\"190.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"388.0\" y=\"102\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><rect x=\"190\" y=\"107\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"117\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"122\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"132\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"174\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность на 1 м</text><rect x=\"190\" y=\"150\" width=\"190.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"388.0\" y=\"160\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><rect x=\"190\" y=\"165\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"175\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><rect x=\"190\" y=\"180\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"190\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"232\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ширина шва, ±</text><rect x=\"190\" y=\"208\" width=\"190.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"388.0\" y=\"218\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text><rect x=\"190\" y=\"223\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"233\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><rect x=\"190\" y=\"238\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"248\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Прочность сцепления облицовки с основанием не менее 0,4 МПа (п. 6.2).</li><li>Клеевой слой на растворе 7–15 мм. Полимерминеральный клей: 2–3 мм для плитки до 100×100 мм, 3–4 мм для плитки свыше 100×100 до 300×300 мм; клей наносят ровно, без потёков (п. 6.3).</li><li>Поверхность ровная, без провесов в стыках, вибрации и отслоений (п. 6.7).</li><li>Плиты толще 10 мм крепят на растворе с дополнительными креплениями или на относе с вентилируемым зазором. Природный камень на растворе не толще 10 мм (п. 6.9).</li><li>Другие допуски табл. 3: гранит и искусственный камень, мрамор: ширина шва ±1,0; «скала»: вертикальность 3,0 на 1 м, швы 3,0, перепады 2,0, шов ±2,0.</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/oblitsovka-plitkoi.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/oblitsovka-plitkoi.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"listovye-potolki\"><header><h3>Листовые и панельные облицовки, подвесные потолки</h3><p>Гипсокартон, панели, рейки, подвесные потолки: допуски каркаса и поверхности.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 4, п. 6.6–6.8, 7.6</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Перепад между плитами, панелями, рейками, листами</td><td class=\"n m\">2</td></tr><tr><td>Вертикаль и горизонталь каркаса и облицовки на 1 м</td><td class=\"n m\">1,5</td></tr><tr><td>Вертикаль и горизонталь на всю длину</td><td class=\"n m\">7</td></tr><tr><td>Ровность (прямолинейность)</td><td class=\"n m\">1,5</td></tr><tr><td>Вертикальность стыков на 1 м</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Перепад между листами</text><rect x=\"220\" y=\"6\" width=\"97.1\" height=\"22\" fill=\"#1d1f23\"/><text x=\"325.1428571428571\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">На 1 м</text><rect x=\"220\" y=\"40\" width=\"72.9\" height=\"22\" fill=\"#1d1f23\"/><text x=\"300.8571428571429\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность</text><rect x=\"220\" y=\"74\" width=\"72.9\" height=\"22\" fill=\"#1d1f23\"/><text x=\"300.8571428571429\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стыки на 1 м</text><rect x=\"220\" y=\"108\" width=\"48.6\" height=\"22\" fill=\"#1d1f23\"/><text x=\"276.57142857142856\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">На всю длину</text><rect x=\"220\" y=\"142\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">7 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Шаг горизонтальных направляющих каркаса не более 450 мм (п. 6.6).</li><li>Металлический каркас защищён от коррозии, деревянный обработан антисептиком и огнезащитой (п. 6.8).</li><li>Швы гипсокартона проклеены, зашпатлёваны и зашлифованы заподлицо (п. 7.6).</li><li>Конструкции на относе и подвесные потолки выполняют по проектной конструкции (п. 6.6).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/listovye-potolki.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/listovye-potolki.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-okraska\"><summary><span class=\"q-sh\"><b>Окраска, обои и стекло</b><small>Малярные работы, оклейка обоями, остекление.</small></span><span class=\"q-n\">3</span></summary><div class=\"e-sub q-chips\"><a href=\"#okraska\">Окраска и малярные работы</a><a href=\"#oboi\">Оклейка обоями</a><a href=\"#steklo\">Стекольные работы</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"okraska\"><header><h3>Окраска и малярные работы</h3><p>Основание готовят по допускам штукатурки. Вид покрытия (простое, улучшенное, высококачественное) указывает проект.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 5, п. 7.1–7.12 · Сборник 15 НРР-2022, табл. 7</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Простое</th><th class=\"n\">Улучшенное</th><th class=\"n\">Высококачественное</th></tr></thead><tbody><tr><td>Искривление линий в местах сопряжения цветов на 1 м</td><td class=\"n m\">5</td><td class=\"n m\">2</td><td class=\"n m\">не допускается</td></tr><tr><td>Отклонение ширины бордюров, фризов, филёнок при разных колерах на 1 м</td><td class=\"n m\">1</td><td class=\"n m\">1</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 152\" role=\"img\" aria-label=\"Число операций по классам\" class=\"e-svg\"><text x=\"0\" y=\"16\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Число операций из 19 (водоэмульсионная окраска по штукатурке)</text><text x=\"0\" y=\"52\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Простое</text><rect x=\"190\" y=\"34\" width=\"171\" height=\"26\" fill=\"#c6c8cd\"/><text x=\"368.52631578947364\" y=\"53\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">9 из 19</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Улучшенное</text><rect x=\"190\" y=\"72\" width=\"322\" height=\"26\" fill=\"#6a6d75\"/><text x=\"520.1052631578948\" y=\"91\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">17 из 19</text><text x=\"0\" y=\"128\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Высококачественное</text><rect x=\"190\" y=\"110\" width=\"360\" height=\"26\" fill=\"#1d1f23\"/><text x=\"558.0\" y=\"129\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">19 из 19</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Основание соответствует табл. 2 для вида покрытия (п. 7.1).</li><li>Деревянные поверхности строганые, без ворса и заусенцев, при необходимости зашлифованы (п. 7.4).</li><li>Трещины расшивают, грунтуют и заделывают шпатлёвкой на глубину не менее 2 мм (п. 7.6).</li><li>Грунтуют после шлифования каждого слоя шпатлёвки и перед первым слоем краски. Шлифуют после каждого слоя шпатлёвки (п. 7.7, 7.8).</li><li>Число слоёв шпатлёвки зависит от вида покрытия: больше слоёв у высококачественного (п. 7.8).</li><li>Фасады: см. условия производства (наледь, дождь, ветер сильнее 10 м/с).</li></ul></div><p class=\"e-note\">Состав операций: простое 9, улучшенное 17, высококачественное 19 из 19 (водоэмульсионная окраска по штукатурке).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/okraska.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/okraska.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"oboi\"><header><h3>Оклейка обоями</h3><p>Допуски стыков и условия оклейки.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 8.1–8.5</div></header><div class=\"q-facts\"><div><b>2 мм</b><span>наибольшее отклонение стыков от вертикали на всю высоту помещения</span></div><div><b>4 мм</b><span>наибольший нахлёст полотен</span></div><div><b>0,5 мм</b><span>наибольший зазор при стыковке встык</span></div><div><b>≤ 23 °C</b><span>температура воздуха, пока обои сохнут</span></div></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Основание соответствует табл. 2 и требованиям п. 7.6 (п. 8.1).</li><li>До оклейки закончены скрытая электро- и слаботочная проводка (кроме розеток и выключателей), сантехника, окраска потолков и основные малярные работы (п. 8.2).</li><li>Полотна одного цвета и оттенка, кромки нахлёстов обращены к световым проёмам (п. 8.3).</li><li>Нет пузырей, пятен, пропусков, отслоений. Плинтусы, наличники, розетки и выключатели не заклеены (п. 8.3).</li><li>Пока обои сохнут, их защищают от сквозняков и прямого солнца, влажность поддерживают стабильной (п. 8.4).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/oboi.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/oboi.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"steklo\"><header><h3>Стекольные работы</h3><p>Листовое стекло, стеклопакеты и стеклоблоки.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 9.1–9.3</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Стеклоблоки: отклонение положения швов, не более</td><td class=\"n m\">3</td></tr><tr><td>Стеклоблоки: отклонение от вертикали на 1 м</td><td class=\"n m\">2</td></tr><tr><td>Стеклоблоки: отклонение от вертикали на всю высоту</td><td class=\"n m\">10</td></tr><tr><td>Стеклоблоки: видимая толщина шва на растворе</td><td class=\"n m\">8–10</td></tr><tr><td>Стеклоблоки: видимая толщина шва на клее, не более</td><td class=\"n m\">3</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Положение швов</text><rect x=\"220\" y=\"6\" width=\"102.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"330.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Вертикаль на 1 м</text><rect x=\"220\" y=\"40\" width=\"68.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"296.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Вертикаль на всю высоту</text><rect x=\"220\" y=\"74\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Стекло не дребезжит, замазка без трещин, штапики прилегают плотно (п. 9.1.2).</li><li>Нельзя ставить стекла со сколами более 10 мм и грязные, нельзя делать стыки стёкол в жилых и общественных зданиях (п. 9.1.3).</li><li>Стеклопакеты на площадке не дорабатывают. Трещины, сколы, отслоения клеевых швов и повреждённые рамки недопустимы (п. 9.3.1, 9.3.2).</li><li>Стеклопакет ставят на опорные и фиксирующие колодки, зазоры заполняют нетвердеющим герметиком (п. 9.3.3).</li><li>Стеклоблоки: два стержня диаметром 4–6 мм в швах на растворе или две стальные полосы 2×30–40 мм на клее. Крепление к стенам через каждые 3 ряда (блок 60 мм) или 5 рядов (блок 98 мм) (п. 9.2.2, 9.2.3).</li><li>Трещины, выколы, пробоины и загрязнения стеклоблоков недопустимы (п. 9.2.4).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/steklo.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/steklo.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-poly\"><summary><span class=\"q-sh\"><b>Полы</b><small>Основание, стяжка и покрытия: наливные, паркет, ламинат, линолеум, плитка.</small></span><span class=\"q-n\">6</span></summary><div class=\"e-sub q-chips\"><a href=\"#osnovanie-pola\">Основание под полы</a><a href=\"#styazhka\">Стяжка под покрытие</a><a href=\"#nalivnye-polimery\">Наливные и монолитные полы</a><a href=\"#parket-laminat\">Паркет, доска и ламинат</a><a href=\"#linoleum\">Линолеум и рулонные покрытия</a><a href=\"#plitka-pola\">Плиточные полы</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"osnovanie-pola\"><header><h3>Основание под полы</h3><p>Грунт, подсыпка из песка и щебня и бетонный подстилающий слой.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.1–10.4</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Грунт: отклонение от ровности, не более</td><td class=\"n m\">20</td></tr><tr><td>Песок, щебень, гравий: ровность поверхности, не более</td><td class=\"n m\">15</td></tr><tr><td>Бетонный слой под бесшовные покрытия: ровность, не более</td><td class=\"n m\">4</td></tr><tr><td>Бетонный слой под оклеечную гидроизоляцию и мастики: ровность, не более</td><td class=\"n m\">5</td></tr><tr><td>Бетонный слой под прочие покрытия: ровность, не более</td><td class=\"n m\">10</td></tr><tr><td>Бетонный слой: толщина, не менее (жилые и общественные здания)</td><td class=\"n m\">80</td></tr><tr><td>Подсыпка: толщина, не менее (песок / щебень, гравий, шлак)</td><td class=\"n m\">60 / 80</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Грунт</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">20 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Песок, щебень</text><rect x=\"220\" y=\"40\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">15 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Бетон: прочие</text><rect x=\"220\" y=\"74\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Бетон: гидроизоляция</text><rect x=\"220\" y=\"108\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Бетон: бесшовные</text><rect x=\"220\" y=\"142\" width=\"68.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"296.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Класс бетона подстилающего слоя не ниже C8/10, толщина не меньше 80 мм в жилых и общественных зданиях и 100 мм в производственных (п. 10.3.1, 10.3.2).</li><li>Пылевидных и глинистых примесей в подсыпке не более 3 % по массе (п. 10.4.1).</li><li>Растительный грунт, ил, торф и насыпь с мусором под полы не годятся. Мёрзлый грунт в подсыпке недопустим (п. 10.2.3, 10.1.3).</li><li>Уклон и горизонтальность: 0,2 % от размера помещения, а для помещений 25 м и больше не более 50 мм (п. 10.1.8).</li><li>Толщина слоёв по проекту, превышение не более чем на 10 % (п. 10.1.9).</li><li>Полы устраивают после монтажа и испытаний инженерных систем, штукатурки, облицовки и окраски стен и потолков (п. 10.1.1, 3.21).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/osnovanie-pola.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/osnovanie-pola.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"styazhka\"><header><h3>Стяжка под покрытие</h3><p>Допуск на ровность зависит от того, какое покрытие будет сверху.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.5, 10.9.2, 10.1.6, 10.1.7</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Под линолеум, рулонные синтетические, паркет, ламинат, ПВХ-плитку, ПВА-покрытия</td><td class=\"n m\">2</td></tr><tr><td>Под керамическую плитку, бесшовные покрытия, «тёплые полы», плиты других видов</td><td class=\"n m\">4</td></tr><tr><td>Под прочие покрытия</td><td class=\"n m\">6</td></tr><tr><td>Толщина по бетонному основанию и плитам перекрытия, не менее</td><td class=\"n m\">20</td></tr><tr><td>Толщина по тепло- или звукоизоляции, не менее</td><td class=\"n m\">40</td></tr><tr><td>Зазор у стен, заполняется звукоизоляцией</td><td class=\"n m\">10–25</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Под линолеум, паркет, ламинат</text><rect x=\"220\" y=\"6\" width=\"113.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"341.3333333333333\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Под плитку, наливные, «тёплые полы»</text><rect x=\"220\" y=\"40\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Под прочие покрытия</text><rect x=\"220\" y=\"74\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">6 мм</text></svg></div><div class=\"q-viz\"><svg viewBox=\"0 0 620 214\" role=\"img\" aria-label=\"Схема проверки ровности рейкой\" class=\"e-svg\"><g transform=\"translate(0,-68)\"><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170 L600 225 L20 225 Z\" fill=\"#f6f6f7\" opacity=\"0.7\"/><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\"/><rect x=\"50\" y=\"118\" width=\"520\" height=\"10\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"470\" y1=\"128\" x2=\"470\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"458\" y1=\"128\" x2=\"482\" y2=\"128\" stroke=\"#e3000f\" stroke-width=\"2\"/><line x1=\"458\" y1=\"170\" x2=\"482\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"494\" y=\"145\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">размер</text><text x=\"494\" y=\"163\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">неровности</text><text x=\"50\" y=\"108\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">рейка 2 м</text><text x=\"300\" y=\"196\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"middle\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">выпуклость</text><text x=\"24\" y=\"246\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">поверхность</text><text x=\"20\" y=\"272\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"500\" font-family=\"Nunito, Arial, sans-serif\">Допуск просвета под рейкой зависит от покрытия: 2, 4 или 6 мм</text></g></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Бетон стяжки не ниже B7,5, раствор не ниже M100 (п. 10.5.1).</li><li>Цементные слои выдерживают под постоянно влажным материалом не менее 7 суток (п. 10.1.6).</li><li>Ходить по раствору под штучные материалы можно после набора прочности 2,5 МПа, по монолитному покрытию после 5,0 МПа (п. 10.1.7).</li><li>Влажность основания под покрытия из древесины: не более 4 % для панелей перекрытий, 5 % для цементных и полимерцементных стяжек (п. 10.9.2).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/styazhka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/styazhka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"nalivnye-polimery\"><header><h3>Наливные и монолитные полы</h3><p>Бесшовные полимерные, самонивелирующиеся и монолитные покрытия.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.8, 10.12</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ровность: ПВА-покрытия</td><td class=\"n m\">2</td></tr><tr><td>Ровность: полиминеральные покрытия</td><td class=\"n m\">4</td></tr><tr><td>Ровность: асфальтобетон</td><td class=\"n m\">6</td></tr><tr><td>Ровность: цементно-бетонное монолитное покрытие</td><td class=\"n m\">4</td></tr><tr><td>Толщина наливного слоя, не менее</td><td class=\"n m\">3</td></tr><tr><td>Грунтовка, не тоньше</td><td class=\"n m\">0,1</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">ПВА-покрытия</text><rect x=\"220\" y=\"6\" width=\"113.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"341.3333333333333\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Полиминеральные</text><rect x=\"220\" y=\"40\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Цементно-бетонные</text><rect x=\"220\" y=\"74\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Асфальтобетон</text><rect x=\"220\" y=\"108\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">6 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность основания 4–6 %. Укладка при температуре основания 5–25 °C и относительной влажности воздуха около 60 % (п. 10.12.4, 10.12.5).</li><li>Защищать слой от жары, прямого солнца и сквозняков (п. 10.12.7).</li><li>Покрытие сцеплено со всем основанием, без трещин, бугорков и наплывов (п. 10.12.9).</li><li>Монолитные покрытия: бетон не ниже C12/15, раствор не ниже M200, воду на месте укладки не добавляют (п. 10.8.2, 10.8.3).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/nalivnye-polimery.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/nalivnye-polimery.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"parket-laminat\"><header><h3>Паркет, доска и ламинат</h3><p>Влажность материалов, лаги, зазоры и допуски.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.9</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ровность покрытия, не более</td><td class=\"n m\">2</td></tr><tr><td>Зазор между досками, не более</td><td class=\"n m\">1</td></tr><tr><td>Зазор у паркетных досок, щитов и ДВП, не более</td><td class=\"n m\">0,5</td></tr><tr><td>Зазор у штучного паркета, не более</td><td class=\"n m\">0,3</td></tr><tr><td>Клеевой слой, не толще</td><td class=\"n m\">1</td></tr><tr><td>Зазор плинтуса до покрытия или стены, не более</td><td class=\"n m\">1</td></tr><tr><td>Зазор ламината у стен</td><td class=\"n m\">8–10</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Зазор между досками</text><rect x=\"220\" y=\"40\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Паркетные доски, щиты</text><rect x=\"220\" y=\"74\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Штучный паркет</text><rect x=\"220\" y=\"108\" width=\"51.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"279.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность материалов: лаги и прокладки не более 18 %, доски покрытия 12 ± 3 %, штучный паркет, паркетные щиты и ДВП 10 %, ДСП 12 % (п. 10.9.1).</li><li>Шаг лаг 0,4–0,5 м на плитах и балках. Зазор между лагами и стенами 20–30 мм, стыки лаг вразбежку не менее 0,5 м (п. 10.9.6, 10.9.8).</li><li>Паркетная планка приклеена не менее чем на 80 % площади, ДВП не менее чем на 40 % (п. 10.9.14).</li><li>Уступы между элементами недопустимы (п. 10.9.16).</li><li>Ламинат лежит без сцепления с основанием на подложке. Компенсационные швы нужны, если длина или ширина больше 8 м (п. 10.9.19–10.9.21).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/parket-laminat.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/parket-laminat.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"linoleum\"><header><h3>Линолеум и рулонные покрытия</h3><p>Основание, клей, швы и допуски.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.10</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ровность основания, не более</td><td class=\"n m\">2</td></tr><tr><td>Зазор у стен, не более</td><td class=\"n m\">5</td></tr><tr><td>Уступы и зазоры в стыках, не более</td><td class=\"n m\">0,3</td></tr><tr><td>Наплыв сварного шва по высоте, не более</td><td class=\"n m\">0,5</td></tr><tr><td>Клеевой слой, не толще</td><td class=\"n m\">0,8</td></tr><tr><td>Грунт, не тоньше</td><td class=\"n m\">0,3</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Зазор у стен</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность основания</text><rect x=\"220\" y=\"40\" width=\"136.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"364.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Клей</text><rect x=\"220\" y=\"74\" width=\"54.4\" height=\"22\" fill=\"#1d1f23\"/><text x=\"282.4\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,8 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Наплыв шва</text><rect x=\"220\" y=\"108\" width=\"34.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"262.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Уступы, зазоры</text><rect x=\"220\" y=\"142\" width=\"20.4\" height=\"22\" fill=\"#1d1f23\"/><text x=\"248.4\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность основания не более 4–5 % (п. 10.10.1).</li><li>Рулоны выдерживают при температуре не ниже 15 °C, пока не исчезнет волнистость (п. 10.10.3).</li><li>Поперечных швов в зонах интенсивного движения нет. Продольных швов не больше двух на кухнях и в жилых комнатах, трёх в общественных зданиях (п. 10.10.11, 10.10.12).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/linoleum.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/linoleum.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"plitka-pola\"><header><h3>Плиточные полы</h3><p>Прослойка, швы, ровность.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.11</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ширина и прямолинейность швов (плюс-минус)</td><td class=\"n m\">1,5</td></tr><tr><td>Ровность покрытия, не более</td><td class=\"n m\">2</td></tr><tr><td>Уступ между плитками, не более</td><td class=\"n m\">1</td></tr><tr><td>Раствор прослойки, толщина</td><td class=\"n m\">10–15</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Швы, ±</text><rect x=\"220\" y=\"6\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ровность</text><rect x=\"220\" y=\"40\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Уступ между плитками</text><rect x=\"220\" y=\"74\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text></svg></div><div class=\"q-viz\"><svg viewBox=\"0 0 620 214\" role=\"img\" aria-label=\"Схема проверки ровности рейкой\" class=\"e-svg\"><g transform=\"translate(0,-68)\"><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170 L600 225 L20 225 Z\" fill=\"#f6f6f7\" opacity=\"0.7\"/><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\"/><rect x=\"50\" y=\"118\" width=\"520\" height=\"10\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"470\" y1=\"128\" x2=\"470\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"458\" y1=\"128\" x2=\"482\" y2=\"128\" stroke=\"#e3000f\" stroke-width=\"2\"/><line x1=\"458\" y1=\"170\" x2=\"482\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"494\" y=\"145\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">размер</text><text x=\"494\" y=\"163\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">неровности</text><text x=\"50\" y=\"108\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">рейка 2 м</text><text x=\"300\" y=\"196\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"middle\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">выпуклость</text><text x=\"24\" y=\"246\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">поверхность</text><text x=\"20\" y=\"272\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"500\" font-family=\"Nunito, Arial, sans-serif\">Ровность плиточного покрытия: не более 2 мм</text></g></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность основания не более 4 % для панелей перекрытий и 5 % для стяжек (п. 10.11.3).</li><li>Плитка приклеена всей поверхностью (п. 10.11.8).</li><li>Излишки раствора и клея из швов удаляют на глубину не менее половины толщины плитки (п. 10.11.5).</li><li>Прослойка из клея и мастик: по технической документации и инструкции изготовителя (п. 10.11.2).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/plitka-pola.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/plitka-pola.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-beton\"><summary><span class=\"q-sh\"><b>Бетонные работы</b><small>Опалубка, арматура и защитный слой, классы поверхностей, допуски готовых монолитных конструкций.</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#bt-opalubka\">Опалубка</a><a href=\"#bt-armatura\">Арматура и защитный слой</a><a href=\"#bt-klassy\">Классы бетонных поверхностей</a><a href=\"#bt-konstrukcii\">Готовые монолитные конструкции</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"bt-opalubka\"><header><h3>Опалубка</h3><p>Точность установки опалубки под разную отделку и прочность бетона, при которой опалубку снимают.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 7.2.1–7.2.12, табл. 7.1</div></header><div class=\"q-facts\"><div><b>2 мм</b><span>перепад лицевых поверхностей палубы под шпатлёвку (классы А, Б)</span></div><div><b>1 мм</b><span>перепад палубы под оклейку обоями (класс А)</span></div><div><b>0,2–0,3 МПа</b><span>наименьшая прочность бетона вертикальных конструкций при распалубке</span></div><div><b>15 м/с</b><span>при ветре сильнее опалубку не монтируют и не разбирают</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Перепад лицевых поверхностей палубы под шпатлёвку (классы А, Б), не более, мм</td><td class=\"n m\">2</td></tr><tr><td>Зазор в стыках палубы под шпатлёвку, не более, мм</td><td class=\"n m\">2</td></tr><tr><td>Перепад лицевых поверхностей палубы под обои (класс А), не более, мм</td><td class=\"n m\">1</td></tr><tr><td>Зазор в стыках палубы под обои, не более, мм</td><td class=\"n m\">2</td></tr><tr><td>Отклонение щитов от вертикали на всю высоту: фундаменты, мм</td><td class=\"n m\">12</td></tr><tr><td>То же для стен и колонн, мм</td><td class=\"n m\">10</td></tr><tr><td>Отклонение опалубки перекрытий и балок от горизонтали на всю длину, мм</td><td class=\"n m\">10</td></tr><tr><td>Расстояния между опорами изгибаемых элементов: на 1 м пролёта, мм</td><td class=\"n m\">25</td></tr><tr><td>То же на весь пролёт, не более, мм</td><td class=\"n m\">50</td></tr><tr><td>Расстояние между тяжами, мм</td><td class=\"n m\">20</td></tr><tr><td>Внутренний размер сечения собранной опалубки, мм</td><td class=\"n m\">+5 / −3</td></tr><tr><td>Длина, пролёт или высота опалубки до 6 м, мм</td><td class=\"n m\">±12</td></tr><tr><td>То же более 6 м, мм</td><td class=\"n m\">±20</td></tr><tr><td>Размеры опалубки дверных и оконных проёмов, мм</td><td class=\"n m\">+15 / −12</td></tr><tr><td>Фиксаторы арматуры по сечению колонн и стен, мм</td><td class=\"n m\">+4 / −3</td></tr><tr><td>Фиксаторы арматуры по высоте стены или колонны, мм</td><td class=\"n m\">±20</td></tr><tr><td>Фиксаторы арматуры по длине стены, мм</td><td class=\"n m\">±40</td></tr><tr><td>Телескопические стойки и башни в плоскости опирания, мм</td><td class=\"n m\">±50</td></tr><tr><td>Совмещение рисок осей опалубки с разбивочными осями, мм</td><td class=\"n m\">±8</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Распалубка: пролёт до 2 м</text><rect x=\"220\" y=\"6\" width=\"212.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"440.5\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">50 % проектной прочности</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Пролёт 2–6 м</text><rect x=\"220\" y=\"40\" width=\"297.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"525.5\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">70 % проектной прочности</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Пролёт более 6 м</text><rect x=\"220\" y=\"74\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">80 % проектной прочности</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Опалубка по СТБ 1110 даёт проектную форму, размеры и качество поверхности в пределах допусков. Она прочная, жёсткая, устойчивая, геометрически неизменяемая и достаточно герметичная при бетонировании (п. 7.1.2, 7.2.1).</li><li>Горизонтальные и наклонные конструкции без нагрузки распалубливают при прочности бетона: пролёт до 2 м — 50 % проектной, от 2 до 6 м — 70 %, свыше 6 м — 80 %. Со страховочными стойками при пролёте до 6 м — 50–60 % по проекту (табл. 7.1).</li><li>Загруженные конструкции, в том числе нагруженные вышележащим бетоном, распалубливают по решению ППР, согласованному с проектной организацией (табл. 7.1).</li><li>Решение о распалубке принимают по испытаниям контрольных образцов или по прочности бетона в конструкции неразрушающими методами (п. 7.9.1). Разбирают в порядке, обратном монтажу (п. 7.9.4).</li><li>Опорные элементы опалубки (башни, телескопические стойки, раскосы) без паспортных данных по несущей способности и устойчивости не применяют. При высоте опорной системы более 5 м к ППР прикладывают статические расчёты (п. 7.2.3).</li><li>Опалубку перекрытия на телескопических стойках без временного раскрепления треногами или другими элементами не монтируют (п. 7.2.5).</li><li>Скорость бетонирования выбирают по несущей способности опалубки и боковому давлению смеси (п. 7.2.6).</li><li>Установку опалубки сопровождает геодезический контроль, принимают её по акту (п. 7.2.10).</li></ul></div><p class=\"e-note\">Допуски таблицы 7.1 в ППР можно изменить при обосновании, но готовая конструкция должна укладываться в табл. 7.13 (п. 7.2.9).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-opalubka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-opalubka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"bt-armatura\"><header><h3>Арматура и защитный слой</h3><p>Шаг стержней, расстояния между рядами и допуск толщины защитного слоя бетона.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 7.3.1–7.3.9, табл. 7.2 · СН 1.03.01-2019, п. 7.4.3, 7.4.4</div></header><div class=\"q-facts\"><div><b>±10 мм</b><span>шаг рабочих стержней колонн и балок</span></div><div><b>±20 мм</b><span>шаг стержней плит и стен фундаментов</span></div><div><b>пластик</b><span>материал фиксаторов защитного слоя (по умолчанию)</span></div><div><b>±10 мм</b><span>расстояние между рядами арматуры плит и балок толщиной до 1 м</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Расстояние между рабочими стержнями: колонны и балки</td><td class=\"n m\">±10</td></tr><tr><td>То же плиты и стены фундаментов</td><td class=\"n m\">±20</td></tr><tr><td>То же массивные конструкции</td><td class=\"n m\">±30</td></tr><tr><td>Расстояние между рядами: плиты и балки толщиной до 1 м включительно</td><td class=\"n m\">±10</td></tr><tr><td>То же конструкции толщиной более 1 м</td><td class=\"n m\">±20</td></tr><tr><td>Защитный слой до 15 мм, сечение конструкции до 100 мм</td><td class=\"n m\">+4</td></tr><tr><td>Защитный слой до 15 мм, сечение 101–200 мм</td><td class=\"n m\">+5</td></tr><tr><td>Защитный слой 15–20 мм, сечение до 100 мм</td><td class=\"n m\">+4 / −3</td></tr><tr><td>Защитный слой 15–20 мм, сечение 101–200 мм</td><td class=\"n m\">+8 / −3</td></tr><tr><td>Защитный слой 15–20 мм, сечение 201–300 мм</td><td class=\"n m\">+10 / −3</td></tr><tr><td>Защитный слой 15–20 мм, сечение более 300 мм</td><td class=\"n m\">+15 / −5</td></tr><tr><td>Защитный слой более 20 мм, сечение до 100 мм</td><td class=\"n m\">+4 / −5</td></tr><tr><td>Защитный слой более 20 мм, сечение 101–200 мм</td><td class=\"n m\">+8 / −5</td></tr><tr><td>Защитный слой более 20 мм, сечение 201–300 мм</td><td class=\"n m\">+10 / −5</td></tr><tr><td>Защитный слой более 20 мм, сечение более 300 мм</td><td class=\"n m\">+15 / −5</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Арматурная сталь, изделия и закладные элементы соответствуют проекту и ТНПА. Установка в опалубку, соединения (сварные и бессварочные) — по проекту, разработанному с учётом СП 5.03.01 и ТКП EN 1992-1-1 (п. 7.3.1–7.3.5).</li><li>При вязке крестообразных соединений стержни располагают взаимно перпендикулярно. Допускаются промышленные пружинные фиксаторы и скрепки (п. 7.3.6).</li><li>Проектную толщину защитного слоя обеспечивают пластмассовыми фиксаторами. Деревянные бруски и куски бетона не допускаются. Специально изготовленные бетонные фиксаторы допускаются, если надёжно крепятся к рабочей арматуре и соответствуют технологической документации (п. 7.3.7).</li><li>Арматурные стержни и закладные детали очищают от ржавчины и загрязнений до укладки в опалубку (п. 7.3.9).</li><li>Перед бетонированием по акту скрытых работ принимают основания, установку опалубки и проёмообразователей, арматуру, закладные детали и фиксаторы, электрические коробки и пластмассовые трубки. Подсоединение трубок к опалубке герметичное, чтобы смесь не попала внутрь (п. 7.4.3).</li><li>Арматуру, опалубку и рабочие швы очищают от мусора, грязи, масла, снега и льда, цементной плёнки и ржавчины. Прямо перед укладкой промывают водой и просушивают струёй воздуха (п. 7.4.4).</li><li>Воду в смесь на месте укладки для подвижности не добавляют (п. 7.4.7).</li><li>Сварочные работы вблизи опалубки на стройплощадке допускаются при необходимости и с сохранением опалубки (п. 7.3.7).</li></ul></div><p class=\"e-note\">Допуски защитного слоя применяют при сохранении проектной толщины слоя (табл. 7.11, прим. 2). Значения «+» — в сторону увеличения слоя.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-armatura.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-armatura.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"bt-klassy\"><header><h3>Классы бетонных поверхностей</h3><p>Четыре класса монолитных поверхностей по прямолинейности: где какой нужен, допуск на 0,1 м, 1 м, 2 м, 4 м, 10 м и допустимые дефекты.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 7.10.1–7.10.14, табл. 7.11, 7.12, рис. 7.4</div></header><div class=\"q-facts\"><div><b>3 мм</b><span>допуск класса А на 1 м</span></div><div><b>5 мм</b><span>допуск класса Б на 1 м</span></div><div><b>10 мм</b><span>допуск класса В на 1 м</span></div><div><b>1 мм</b><span>наплыв или впадина под обои</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Класс А</th><th class=\"n\">Класс Б</th><th class=\"n\">Класс В</th><th class=\"n\">Класс Г</th></tr></thead><tbody><tr><td>На измеряемом расстоянии 0,1 м</td><td class=\"n m\">2</td><td class=\"n m\">3</td><td class=\"n m\">5</td><td class=\"n m\">10</td></tr><tr><td>На 1 м</td><td class=\"n m\">3</td><td class=\"n m\">5</td><td class=\"n m\">10</td><td class=\"n m\">20</td></tr><tr><td>На 2 м</td><td class=\"n m\">5</td><td class=\"n m\">7</td><td class=\"n m\">12</td><td class=\"n m\">25</td></tr><tr><td>На 4 м</td><td class=\"n m\">8</td><td class=\"n m\">10</td><td class=\"n m\">15</td><td class=\"n m\">35</td></tr><tr><td>На 10 м</td><td class=\"n m\">15</td><td class=\"n m\">20</td><td class=\"n m\">25</td><td class=\"n m\">—</td></tr><tr><td>Ширина усадочных трещин, не более</td><td class=\"n m\">0,1</td><td class=\"n m\">0,2</td><td class=\"n m\">0,2</td><td class=\"n m\">0,2</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Класс А, на 2 м</text><rect x=\"220\" y=\"6\" width=\"68.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"296.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Класс Б, на 2 м</text><rect x=\"220\" y=\"40\" width=\"95.2\" height=\"22\" fill=\"#1d1f23\"/><text x=\"323.2\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">7 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Класс В, на 2 м</text><rect x=\"220\" y=\"74\" width=\"163.2\" height=\"22\" fill=\"#1d1f23\"/><text x=\"391.2\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">12 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Класс Г, на 2 м</text><rect x=\"220\" y=\"108\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">25 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Класс А — лицевые поверхности стен, колонн и нижние поверхности перекрытий с повышенными требованиями к внешнему виду. Класс Б — те же без повышенных требований. Класс В — лицевые поверхности стен и колонн, нижние и верхние поверхности перекрытий, требующие отделки. Класс Г — минимальные требования, как правило скрытые поверхности (табл. 7.12).</li><li>Класс поверхности указывают в проекте. Для классов В и Г вид опалубки выбирает подрядчик (п. 7.10.1, 7.10.2).</li><li>Промежуточные значения допусков определяют по графику (рис. 7.4) и округляют (табл. 7.11, прим. 1). Местные выступы и впадины оценивают по допуску на 0,1 м (п. 7.10.9).</li><li>На поверхностях всех классов не допускаются участки неуплотнённого бетона. На классах А–В не допускаются жировые пятна и пятна ржавчины (п. 7.10.6, 7.10.7).</li><li>Арматура не обнажена, кроме рабочих выпусков и монтажных крепежных элементов опалубки, и кроме открытых поверхностей стальных закладных (п. 7.10.8).</li><li>Трещины не допускаются, кроме усадочных и других поверхностных технологических трещин: раскрытие не более 0,1 мм для класса А, 0,2 мм для остальных (п. 7.10.10).</li><li>Класс А: раковины и околы рёбер глубиной более 2 мм и длиной более 20 мм на 1 м ребра не допускаются. Классы Б и В: раковины диаметром более 4 и 10 мм соответственно, околы глубиной более 5 мм и длиной более 50 мм на 1 м ребра. Класс Г: раковины диаметром более 20 мм и околы глубиной более 20 мм (п. 7.10.11).</li><li>Под оклейку обоями наплывы и впадины более 1 мм не допускаются. Для классов А и Б местные выступы шлифуют, впадины шпатлюют (п. 7.10.13).</li><li>Допускаются отверстия под тяжи с защитными трубками и под анкеры, отпечатки щитов и элементов опалубки, обнажение арматурных фиксаторов в нижней зоне, оговорённое технологией, на потолке — следы палубы и крепления электроразводки (п. 7.10.12).</li></ul></div><p class=\"e-note\">Допуски прямолинейности действуют при условии сохранения проектной толщины защитного слоя (табл. 7.11, прим. 2). Для торкретированных поверхностей классы не применяют.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-klassy.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-klassy.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"bt-konstrukcii\"><header><h3>Готовые монолитные конструкции</h3><p>Допуски на вертикаль, горизонталь, размеры, проёмы, отметки опор и закладные болты после распалубки.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 7.10.14, 7.10.15, табл. 7.13</div></header><div class=\"q-facts\"><div><b>20 мм</b><span>отклонение фундаментов от вертикали на всю высоту</span></div><div><b>15 мм</b><span>стены и колонны, поддерживающие монолитные перекрытия</span></div><div><b>10 мм</b><span>стены и колонны, поддерживающие сборные балочные конструкции</span></div><div><b>5 мм</b><span>перепад в стыке двух смежных поверхностей</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Вертикаль и проектный наклон на всю высоту: фундаменты, мм</td><td class=\"n m\">20</td></tr><tr><td>То же стены и колонны под монолитные перекрытия, мм</td><td class=\"n m\">15</td></tr><tr><td>То же стены и колонны под сборные балочные конструкции, мм</td><td class=\"n m\">10</td></tr><tr><td>Скользящая опалубка без перекрытий: не более 1/500 высоты и</td><td class=\"n m\">100 мм</td></tr><tr><td>Скользящая опалубка с перекрытиями: не более 1/1000 высоты и</td><td class=\"n m\">50 мм</td></tr><tr><td>Горизонталь плоскостей на длину участка до 6 м, мм</td><td class=\"n m\">10</td></tr><tr><td>То же более 6 м, мм</td><td class=\"n m\">20</td></tr><tr><td>Длина, пролёт, размер в свету или высота до 6 м, мм</td><td class=\"n m\">±10</td></tr><tr><td>То же более 6 м, мм</td><td class=\"n m\">±20</td></tr><tr><td>Размеры оконных, дверных и других проёмов, мм</td><td class=\"n m\">20</td></tr><tr><td>Размер поперечного сечения элементов, мм</td><td class=\"n m\">+10 / −3</td></tr><tr><td>Отметки поверхностей и закладных под стальные или сборные элементы, мм</td><td class=\"n m\">−5</td></tr><tr><td>Уклон опорных поверхностей фундаментов под стальные колонны без подливки</td><td class=\"n m\">0,0007</td></tr><tr><td>Фундаментные и анкерные болты в плане внутри контура опоры, мм</td><td class=\"n m\">5</td></tr><tr><td>То же вне контура опоры, мм</td><td class=\"n m\">10</td></tr><tr><td>Фундаментные и анкерные болты по высоте, мм</td><td class=\"n m\">20</td></tr><tr><td>Перепад в стыке двух смежных поверхностей, мм</td><td class=\"n m\">5</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Требования к монолитным конструкциям лифтовых шахт, лестниц, фундаментов под технологическое оборудование и к криволинейным поверхностям задаёт проект (п. 7.10.15).</li><li>Перепады в швах сопряжений сборных и монолитных конструкций не допускаются, если проект не предусматривает иное (п. 4.12).</li><li>В ходе возведения ведут геодезическую съёмку и составляют исполнительные схемы, акты скрытых работ и промежуточной приёмки ответственных конструкций (п. 7.1.3).</li><li>За состоянием монолитных конструкций, узлов и сопряжений следят внешним осмотром в течение всего строительства, за перемещениями и деформациями — геодезическим контролем (п. 7.1.4).</li><li>Размещение материалов на монолитных перекрытиях определяет ППР с учётом их несущей способности (п. 7.1.6).</li></ul></div><p class=\"e-note\">Поверхность оценивают по классу (табл. 7.11), геометрию конструкции — по этой таблице (табл. 7.13).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-konstrukcii.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/bt-konstrukcii.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-sbornye\"><summary><span class=\"q-sh\"><b>Сборные конструкции</b><small>Фундаментные блоки, колонны, ригели и плиты перекрытий.</small></span><span class=\"q-n\">2</span></summary><div class=\"e-sub q-chips\"><a href=\"#sb-fundament\">Блоки фундаментов и стен подвала</a><a href=\"#sb-karkas\">Колонны, ригели и плиты перекрытий</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"sb-fundament\"><header><h3>Блоки фундаментов и стен подвала</h3><p>Монтаж фундаментных блоков и стен подземной части: основание, швы, допуски.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 6.2.1–6.2.6, табл. 6.1</div></header><div class=\"q-facts\"><div><b>−15 мм</b><span>отклонение отметки песчаного выравнивающего слоя</span></div><div><b>20 мм</b><span>толщина швов между блоками</span></div><div><b>±5 мм</b><span>допуск толщины шва</span></div><div><b>±15 мм</b><span>горизонталь рядов блоков на 10 м</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Совмещение рисок блоков и стаканов с рисками разбивочных осей</td><td class=\"n m\">12</td></tr><tr><td>Совмещение рисок фундаментных блоков с осями</td><td class=\"n m\">10</td></tr><tr><td>Отметка дна стакана до выравнивающего слоя</td><td class=\"n m\">−20</td></tr><tr><td>Отметка дна стакана после выравнивающего слоя</td><td class=\"n m\">±5</td></tr><tr><td>Отклонение плоскостей блоков стен от вертикали</td><td class=\"n m\">12</td></tr><tr><td>Толщина швов между блоками</td><td class=\"n m\">20</td></tr><tr><td>Отклонение толщины шва</td><td class=\"n m\">±5</td></tr><tr><td>Отклонение рядов блоков стены от горизонтали на 10 м длины</td><td class=\"n m\">±15</td></tr><tr><td>Перепад между смежными блоками</td><td class=\"n m\">±10</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Блоки устанавливают на слой песка, выровненный до проектной отметки. Отклонение отметки песка не более минус 15 мм (п. 6.2.1).</li><li>Установка на основание, покрытое водой или снегом, не допускается (п. 6.2.2).</li><li>Блоки стен монтируют с перевязкой в смежных рядах. Минимальная перевязка равна ширине блока, если проект не задаёт иное (п. 6.2.3).</li><li>Вертикальные и горизонтальные швы заполняют раствором и расшивают с двух сторон (п. 6.2.3).</li><li>Блоки фундаментов ставят на цементно-песчаный раствор, вертикальные шпонки между торцами замоноличивают бетоном. Марку раствора и класс бетона берут из проекта (п. 6.2.4).</li><li>В местах примыкания внутренних стен к наружным горизонтальные швы армируют по проекту (п. 6.2.5).</li><li>Надземную часть возводят после подземной части, анкеровки стен, заделки швов между плитами перекрытия и обратной засыпки пазух с уплотнением (п. 4.10).</li></ul></div><p class=\"e-note\">Допуски — предельно допустимые значения при монтаже, односторонняя направленность и суммирование отклонений не допускаются.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/sb-fundament.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/sb-fundament.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"sb-karkas\"><header><h3>Колонны, ригели и плиты перекрытий</h3><p>Допуски монтажа каркаса, укладка плит на раствор, швы между плитами и замоноличивание.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 6.3.1–6.3.6, 6.4.1–6.4.11, табл. 6.2, 6.3 · СН 1.03.01-2019, п. 6.8.1–6.8.6</div></header><div class=\"q-facts\"><div><b>≤ 20 мм</b><span>слой раствора под плитой перекрытия</span></div><div><b>0,2 %</b><span>наибольшее отклонение лицевой поверхности плит от горизонтали по длине</span></div><div><b>М150</b><span>наименьшая марка раствора для замоноличивания стыков</span></div><div><b>С8/10</b><span>наименьший класс бетона для замоноличивания стыков</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Совмещение рисок осей в нижнем сечении колонн, рам, полурам</td><td class=\"n m\">8</td></tr><tr><td>Разность отметок верха колонн каждого яруса многоэтажного здания: установка по маякам</td><td class=\"n m\">10</td></tr><tr><td>То же при контактной установке (n — номер яруса)</td><td class=\"n m\">12 + 2n</td></tr><tr><td>Вертикаль плоскостей диафрагм жёсткости</td><td class=\"n m\">5</td></tr><tr><td>Совмещение осей в верхнем сечении диафрагм с осями колонн</td><td class=\"n m\">10</td></tr><tr><td>Симметричность положения диафрагм между колоннами</td><td class=\"n m\">5</td></tr><tr><td>Отклонение ширины горизонтального стыка между диафрагмами</td><td class=\"n m\">10</td></tr><tr><td>Совмещение рисок в нижнем сечении ригелей, балок, плит</td><td class=\"n m\">8</td></tr></tbody></table></div><h4 class=\"q-h4\">Допуски по длине элемента</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">до 4 м</th><th class=\"n\">4–8 м</th><th class=\"n\">8–16 м</th><th class=\"n\">16–25 м</th></tr></thead><tbody><tr><td>Вертикаль осей колонн одноэтажного здания</td><td class=\"n m\">20</td><td class=\"n m\">25</td><td class=\"n m\">30</td><td class=\"n m\">40</td></tr><tr><td>Разность отметок верха колонн или опорных площадок</td><td class=\"n m\">14</td><td class=\"n m\">16</td><td class=\"n m\">20</td><td class=\"n m\">24</td></tr><tr><td>Совмещение осей в верхнем сечении колонн многоэтажного здания</td><td class=\"n m\">12</td><td class=\"n m\">15</td><td class=\"n m\">20</td><td class=\"n m\">25</td></tr><tr><td>Симметричность опирания концов элемента в направлении пролёта</td><td class=\"n m\">5</td><td class=\"n m\">6</td><td class=\"n m\">8</td><td class=\"n m\">10</td></tr><tr><td>Перепад лицевых поверхностей смежных плит перекрытий в шве</td><td class=\"n m\">5</td><td class=\"n m\">7</td><td class=\"n m\">10</td><td class=\"n m\">—</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Плоские плиты перекрытий укладывают на слой раствора толщиной по проекту, не более 20 мм, совмещая поверхности смежных плит со стороны потолка. Укладка без раствора не допускается (п. 6.4.7).</li><li>Перепад отметок двух смежных опорных граней по ширине плиты не более 0,15 %. Отклонение лицевой поверхности плит от горизонтали или заданного уклона не более 0,2 % по длине (п. 6.4.7).</li><li>Ригели, связевые плиты, фермы и плиты покрытий укладывают насухо на опорные поверхности. Полки ригелей горизонтальны, торцы вплотную к колоннам не примыкают (п. 6.4.3, 6.4.6).</li><li>Диафрагмы жёсткости ставят на слой раствора с обжатием в горизонтальном стыке. На подкладки, петли и клинья с последующим заполнением раствором не ставят. Вплотную к колоннам и друг к другу не примыкают (п. 6.3.4, 6.3.5).</li><li>В жилых домах без отделки требования к лицевой поверхности перекрытий в границах помещений указывает проект, они не ниже категории А6 по ГОСТ 13015.0. Проект же задаёт обработку: заделку отверстий и швов, выравнивающие стяжки, шлифование, затирку (п. 6.4.8).</li><li>Стыки между плитами замоноличивают раствором не ниже М150 или бетоном не ниже С8/10 (п. 6.4.9, 6.8.3).</li><li>Если в распалубленном стыке видны усадка, щели, пустоты или неуплотнённый бетон, стык замоноличивают повторно. Ремонт и заделка дефектов не допускаются (п. 6.8.6).</li><li>Прочность бетона или раствора в стыке при распалубке по проекту, а без указания — не менее 50 % проектной прочности на сжатие (п. 6.8.5).</li><li>Вышележащий этаж монтируют после проектного закрепления нижележащего и набора бетоном замоноличенных стыков прочности по проекту (п. 6.1.3).</li></ul></div><p class=\"e-note\">Односторонняя направленность и суммирование отклонений не допускаются (табл. 6.2, прим. 2). Глубину опирания задаёт расчёт и проект (п. 6.4.2).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/sb-karkas.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/sb-karkas.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-kamen\"><summary><span class=\"q-sh\"><b>Каменные работы</b><small>Швы и армирование, допуски кладки, высота стен и опирание плит, кладка в мороз и жару.</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#kl-shvy\">Кладка: швы, перевязка, армирование</a><a href=\"#kl-dopuski\">Допуски каменной кладки</a><a href=\"#kl-vysota\">Высота стен и перегородок, опирание плит</a><a href=\"#kl-pogoda\">Кладка в мороз и в жару</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"kl-shvy\"><header><h3>Кладка: швы, перевязка, армирование</h3><p>Толщина швов, заполнение раствором, тычковые ряды, армокаменная кладка и клеевая кладка блоков.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 5.2.1–5.2.13, 5.4.1, 5.4.4</div></header><div class=\"q-facts\"><div><b>10 мм</b><span>горизонтальный шов кладки из одинарного кирпича</span></div><div><b>12 мм</b><span>горизонтальный шов кладки из утолщённого кирпича и камней</span></div><div><b>10 мм</b><span>вертикальный шов</span></div><div><b>2–3 мм</b><span>шов на клеевой смеси (блоки)</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Горизонтальный шов, одинарный кирпич, мм</td><td class=\"n m\">10</td></tr><tr><td>Горизонтальный шов, утолщённый кирпич и камни правильной формы, мм</td><td class=\"n m\">12</td></tr><tr><td>Вертикальный шов, мм</td><td class=\"n m\">10</td></tr><tr><td>Шов между блоками на клеевой смеси, мм</td><td class=\"n m\">2–3</td></tr><tr><td>Незаполненная часть шва с лицевой стороны: стены, не более, мм</td><td class=\"n m\">15</td></tr><tr><td>То же столбы, не более, мм</td><td class=\"n m\">10</td></tr><tr><td>Тычковый ряд при кирпиче толщиной 65 мм: один ряд на</td><td class=\"n m\">6 рядов</td></tr><tr><td>То же при кирпиче толщиной 88 мм: один ряд на</td><td class=\"n m\">4 ряда</td></tr><tr><td>Кирпич-половняк, не более, % объёма кладки</td><td class=\"n m\">10</td></tr><tr><td>Сетки через: обычный кирпич</td><td class=\"n m\">5 рядов</td></tr><tr><td>То же утолщённый кирпич</td><td class=\"n m\">4 ряда</td></tr><tr><td>То же керамические камни</td><td class=\"n m\">3 ряда</td></tr><tr><td>Диаметр арматуры сеток, не менее, мм</td><td class=\"n m\">3</td></tr><tr><td>Диаметр арматуры в шве: при пересечении стержней, не более, мм</td><td class=\"n m\">6</td></tr><tr><td>То же без пересечения, не более, мм</td><td class=\"n m\">8</td></tr><tr><td>Расстояние между стержнями сетки, мм</td><td class=\"n m\">30–120</td></tr><tr><td>Шов в армированной кладке: больше суммы диаметров пересекающихся стержней не менее чем на, мм</td><td class=\"n m\">4</td></tr><tr><td>То же толщина шва не более, мм</td><td class=\"n m\">16</td></tr><tr><td>Перехлёст стержней периодического профиля, не менее, мм</td><td class=\"n m\">250</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Шов горизонтальный, одинарный кирпич</text><rect x=\"220\" y=\"6\" width=\"283.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"511.3333333333333\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Шов горизонтальный, утолщённый кирпич</text><rect x=\"220\" y=\"40\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">12 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Шов вертикальный</text><rect x=\"220\" y=\"74\" width=\"283.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"511.3333333333333\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Клеевой шов, верхний предел</text><rect x=\"220\" y=\"108\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Кладку ведут с перевязкой швов по проекту. Тычковые ряды из целых кирпичей обязательны в первом и последнем рядах, на уровне горизонтальных обрезов стен и столбов, в выступающих рядах и под опорами балок, прогонов, перекрытий (п. 5.2.1–5.2.3).</li><li>Горизонтальные и вертикальные швы в стенах, перемычках, простенках и столбах заполняют раствором полностью (п. 5.2.9). Допускаемая глубина незаполненной части шва с лица указана в таблице.</li><li>Кирпичные цоколи делают из полнотелого керамического кирпича. Пустотелый керамический и силикатный кирпич для цоколя не применяют (п. 5.2.5).</li><li>Столбы, пилястры и простенки шириной в два с половиной кирпича и менее, рядовые перемычки и карнизы выкладывают из целого кирпича (п. 5.2.6).</li><li>Раствор используют до начала схватывания и периодически перемешивают. Обезвоженную смесь и разбавление водой после начала схватывания не применяют (п. 5.1.3).</li><li>Стены из мелких блоков: кладка на цементно-песчаном растворе, клеевых смесях или пастах с полным заполнением швов. Заполнение вертикальных швов пазогребневых блоков определяет проект. Однорядная перевязка, в углах и примыканиях перевязка блоков (п. 5.4.1, 5.4.3).</li><li>Под блоки в местах примыкания к цоколю, полу первого этажа и подвалу делают горизонтальную гидроизоляцию из неподверженных гниению рулонных материалов. Первый ряд рекомендуется уложить на пояс из железобетонных перемычек или керамического кирпича, свес стены относительно цоколя не более 50 мм (п. 5.4.2).</li><li>Армокаменные конструкции: сетки выступают не менее чем двумя стержнями на 2–3 мм на поверхность. Продольные стержни соединяют сваркой. Стык без сварки: гладкие стержни с крюками и перехлёстом 20 диаметров (п. 5.2.13).</li><li>Выступающие части кладки защищают от осадков сливами из раствора не ниже М100 по прочности и F50 по морозостойкости, с уклоном для стока воды, если проект не требует иного (п. 5.2.18).</li><li>Швы фасада облегчённой кирпичной стены расшиты, внутренняя отделка выполнена штукатурным покрытием, плитный утеплитель плотно примыкает к кладке, металлические связи имеют антикоррозионное покрытие (п. 5.2.14).</li></ul></div><p class=\"e-note\">Сетки, диаметры и шаг армирования по проекту, значения таблицы действуют, если проект не предусматривает иное (п. 5.2.13).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-shvy.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-shvy.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"kl-dopuski\"><header><h3>Допуски каменной кладки</h3><p>Предельные отклонения толщины, отметок, осей, вертикали, швов и неровностей кладки стен и столбов.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 5.1.12, 5.2.11, 5.2.12, табл. 5.2</div></header><div class=\"q-facts\"><div><b>±15 мм</b><span>толщина стен из кирпича и блоков</span></div><div><b>10 мм</b><span>вертикаль на этаж и смещение осей стен</span></div><div><b>15 мм</b><span>ряды кладки от горизонтали на 10 м стены</span></div><div><b>10 мм</b><span>неровности вертикальной поверхности стены</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Стены</th><th class=\"n\">Столбы</th><th class=\"n\">Фундаменты</th><th class=\"n\">Бут: стены</th><th class=\"n\">Бут: столбы</th></tr></thead><tbody><tr><td>Отклонение толщины конструкций</td><td class=\"n m\">±15</td><td class=\"n m\">±10</td><td class=\"n m\">±30</td><td class=\"n m\">±20</td><td class=\"n m\">±20</td></tr><tr><td>Отклонение отметок опорных поверхностей</td><td class=\"n m\">−10</td><td class=\"n m\">−10</td><td class=\"n m\">−25</td><td class=\"n m\">−15</td><td class=\"n m\">−15</td></tr><tr><td>Отклонение ширины простенков</td><td class=\"n m\">−15</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Отклонение ширины проёмов</td><td class=\"n m\">15</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Центр оконных проёмов на одной вертикальной оси</td><td class=\"n m\">не допускается</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Смещение осей от разбивочных осей</td><td class=\"n m\">10</td><td class=\"n m\">10</td><td class=\"n m\">20</td><td class=\"n m\">15</td><td class=\"n m\">10</td></tr><tr><td>Отклонение граней и углов от вертикали на один этаж</td><td class=\"n m\">10</td><td class=\"n m\">10</td><td class=\"n m\">—</td><td class=\"n m\">20</td><td class=\"n m\">15</td></tr><tr><td>То же на здание выше двух этажей</td><td class=\"n m\">30</td><td class=\"n m\">30</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Ширина горизонтальных швов</td><td class=\"n m\">−2 / +3</td><td class=\"n m\">−2 / +3</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Ширина вертикальных швов</td><td class=\"n m\">−2 / +2</td><td class=\"n m\">−2 / +2</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Отклонение рядов кладки от горизонтали на 10 м стены</td><td class=\"n m\">15</td><td class=\"n m\">—</td><td class=\"n m\">30</td><td class=\"n m\">20</td><td class=\"n m\">—</td></tr><tr><td>Неровности на вертикальной поверхности кладки</td><td class=\"n m\">10</td><td class=\"n m\">5</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Размеры сечения вентиляционных каналов</td><td class=\"n m\">±5</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Колонки «Стены» и «Столбы» относятся к кладке из кирпича и камней правильной формы и мелких блоков. Колонки «Бут» — к кладке из бута и бутобетона (табл. 5.2).</li><li>Вертикальность граней и углов, горизонтальность кладки каждого этажа и отметку верха проверяют инструментально. После кладки каждого этажа проверяют горизонтальность и отметки верха независимо от промежуточных проверок рядов (п. 5.2.11, 5.2.12).</li><li>Разность высот кладки на смежных захватках не более высоты этажа, для стен подземной части — не более 1,2 м (п. 5.1.8).</li><li>Перед началом кладки выносят оси и высотные отметки по проекту и устраивают горизонтальную гидроизоляцию от увлажнения со стороны фундамента, тротуаров и отмосток (п. 5.1.1).</li><li>Скрываемые элементы принимают по актам: места опирания ферм, прогонов, балок и плит, закрепление консолей и анкеровка карнизов, закладные детали и их защита, арматура, осадочные и деформационные швы, гидро- и пароизоляция (п. 5.1.11).</li><li>Номенклатура контролируемых показателей и порядок контроля — с учётом положений СП 1.03.13 (п. 5.1.20).</li></ul></div><p class=\"e-note\">Числа таблицы 5.2 — предельно допустимые отклонения при возведении каменных и армокаменных конструкций.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-dopuski.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-dopuski.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"kl-vysota\"><header><h3>Высота стен и перегородок, опирание плит</h3><p>Предельная высота свободно стоящих стен, высота перегородок, борозды, анкеры и опирание перекрытий.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 5.1.5–5.1.10, 5.1.13–5.1.17, табл. 5.1</div></header><div class=\"q-facts\"><div><b>1,5 м</b><span>наибольшая высота неармированной нераскреплённой перегородки толщиной 9 см</span></div><div><b>1,8 м</b><span>то же для перегородки толщиной 12 см</span></div><div><b>≥ 90 мм</b><span>наименьшая глубина опирания плит на кладку</span></div><div><b>10–15 мм</b><span>слой раствора под опиранием железобетонных и стальных конструкций</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(м)</span></th><th class=\"n\">до 150 Н/м² (15 м/с)</th><th class=\"n\">270 (21)</th><th class=\"n\">450 (27)</th><th class=\"n\">1000 (40)</th></tr></thead><tbody><tr><td>25 см, плотность 1000–1300 кг/м³</td><td class=\"n m\">2,3</td><td class=\"n m\">1,6</td><td class=\"n m\">1,3</td><td class=\"n m\">—</td></tr><tr><td>25 см, 1300–1600 кг/м³</td><td class=\"n m\">3</td><td class=\"n m\">2,1</td><td class=\"n m\">1,4</td><td class=\"n m\">—</td></tr><tr><td>25 см, свыше 1600 кг/м³</td><td class=\"n m\">3,8</td><td class=\"n m\">2,6</td><td class=\"n m\">1,6</td><td class=\"n m\">—</td></tr><tr><td>38 см, 1000–1300 кг/м³</td><td class=\"n m\">4,5</td><td class=\"n m\">4</td><td class=\"n m\">2,4</td><td class=\"n m\">1,3</td></tr><tr><td>38 см, 1300–1600 кг/м³</td><td class=\"n m\">4,8</td><td class=\"n m\">4,3</td><td class=\"n m\">3,1</td><td class=\"n m\">1,5</td></tr><tr><td>38 см, свыше 1600 кг/м³</td><td class=\"n m\">5,2</td><td class=\"n m\">4,7</td><td class=\"n m\">4</td><td class=\"n m\">1,7</td></tr><tr><td>51 см, 1000–1300 кг/м³</td><td class=\"n m\">6</td><td class=\"n m\">5,7</td><td class=\"n m\">4,3</td><td class=\"n m\">2</td></tr><tr><td>51 см, 1300–1600 кг/м³</td><td class=\"n m\">6,3</td><td class=\"n m\">6</td><td class=\"n m\">5,6</td><td class=\"n m\">2,5</td></tr><tr><td>51 см, свыше 1600 кг/м³</td><td class=\"n m\">6,5</td><td class=\"n m\">6,3</td><td class=\"n m\">6</td><td class=\"n m\">3,1</td></tr><tr><td>64 см, 1000–1300 кг/м³</td><td class=\"n m\">7</td><td class=\"n m\">6,6</td><td class=\"n m\">6</td><td class=\"n m\">2,7</td></tr><tr><td>64 см, 1300–1600 кг/м³</td><td class=\"n m\">7,4</td><td class=\"n m\">7</td><td class=\"n m\">6,5</td><td class=\"n m\">3,5</td></tr><tr><td>64 см, свыше 1600 кг/м³</td><td class=\"n m\">7,7</td><td class=\"n m\">7,4</td><td class=\"n m\">7</td><td class=\"n m\">4,3</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Таблица даёт наибольшую высоту свободно стоящих стен без перекрытий и покрытий при разном скоростном напоре ветра. Для промежуточных значений напора высоту находят интерполяцией. Выше этой высоты нужны временные крепления по проекту (п. 5.1.10).</li><li>Неармированные нераскреплённые каменные перегородки: толщиной 9 см — высотой не более 1,5 м, толщиной 12 см — не более 1,8 м (п. 5.1.9).</li><li>Ослаблять кладку отверстиями, бороздами, нишами и проёмами, не предусмотренными проектом, нельзя. В стенах и перегородках толщиной 120 мм и менее инженерные коммуникации не прокладывают, кроме штрабы глубиной до 1/3 толщины стены (п. 5.1.5).</li><li>Разрывы в кладке выполняют наклонной или вертикальной штрабой. При вертикальной штрабе в швы закладывают сетку из стержней диаметром не более 5 мм через 1,5 м по высоте и в уровне каждого перекрытия (п. 5.1.6, 5.1.7).</li><li>Опирание сборных железобетонных и стальных конструкций на кладку — через слой раствора 10–15 мм или на монолитные плиты толщиной, кратной кладке, не менее 140 мм, армированные двумя сетками. Глубина опирания не менее 90 мм (п. 5.1.13).</li><li>Пустотные плиты кладут усиленными торцами по стенам с большей нагрузкой. Установка плит в борозды, оставленные при кладке, не допускается. Кладку над плитами ведут сразу после их монтажа (п. 5.1.13, 5.1.14).</li><li>Опорные участки кладки армируют сетками из стержней диаметром не менее 3 мм с ячейкой не более 60 × 60 мм не менее чем в трёх верхних горизонтальных швах (п. 5.1.15).</li><li>Каменные стены и столбы крепят к перекрытиям и покрытиям анкерами сечением не менее 0,5 см² (п. 5.1.16). Самонесущие стены каркасных зданий соединяют с колоннами гибкими связями с шагом по высоте не более 1,2 м (п. 5.1.17).</li><li>Следующий этаж кладут только после укладки перекрытий нижележащего этажа, анкеровки стен и заделки швов между плитами (п. 5.1.4).</li><li>Перегородки из пустотелого кирпича выкладывают только с вертикальным направлением пустот. Зазоры между перегородками, перекрытиями и стенами берут из проекта (п. 5.1.19).</li></ul></div><p class=\"e-note\">Для промежуточных значений скоростного напора ветра высоту определяют интерполяцией (прим. к табл. 5.1).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-vysota.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-vysota.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"kl-pogoda\"><header><h3>Кладка в мороз и в жару</h3><p>Особые требования при отрицательных температурах и при высокой температуре и сухом воздухе.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 5.5.1–5.5.8, 5.6</div></header><div class=\"q-facts\"><div><b>25 °С и выше</b><span>жаркая погода для кладки при влажности наружного воздуха ниже 50 %</span></div><div><b>≥ 75 %</b><span>водоудерживающая способность раствора от установленной в лаборатории</span></div><div><b>≤ 25 см³</b><span>расслаиваемость смеси подвижностью 10–12 см</span></div><div><b>≤ 40 см³</b><span>то же при подвижности 12–14 см</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Жаркая погода: температура воздуха от, °С</td><td class=\"n m\">25</td></tr><tr><td>Жаркая погода: влажность наружного воздуха ниже, %</td><td class=\"n m\">50</td></tr><tr><td>Водоудерживающая способность раствора, не менее, % от лабораторной</td><td class=\"n m\">75</td></tr><tr><td>Проверка водоудерживающей способности, не реже раз в смену</td><td class=\"n m\">1</td></tr><tr><td>Расслаиваемость при подвижности 10–12 см, не более, см³</td><td class=\"n m\">25</td></tr><tr><td>То же при подвижности 12–14 см, не более, см³</td><td class=\"n m\">40</td></tr><tr><td>Проверка расслаиваемости при перевозке более 5 км, не реже раз в смену</td><td class=\"n m\">2</td></tr><tr><td>Раствор с противоморозными добавками не применяют при влажности воздуха эксплуатации более, %</td><td class=\"n m\">60</td></tr><tr><td>То же при эксплуатационной температуре более, °С</td><td class=\"n m\">40</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Мороз: состав растворов, подвижность и сроки её сохранения задают проект и ТНПА. На перерыв верх кладки накрывают от обледенения и снега и не оставляют на нём раствор (п. 5.5.1, 5.5.2).</li><li>Растворы с противоморозными добавками не применяют для зданий с влажностью воздуха эксплуатации более 60 %, температурой эксплуатации более 40 °С или агрессивной средой. Ёмкости с раствором укрывают и утепляют (п. 5.5.4).</li><li>Кладку способом замораживания допускают только по указаниям проекта. При оттаивании постоянно наблюдают за осадками стен и деформациями, дальнейшее возведение — после набора раствором прочности по расчёту, подтверждённой лабораторией (п. 5.5.5–5.5.7).</li><li>В журнале работ при отрицательных температурах записывают температуру воздуха, количество добавок и температуру раствора при укладке (п. 5.5.8).</li><li>Жара и сухость: кладку держат влажной в жаркое время суток, ёмкости с раствором укрывают от солнца. Керамический кирпич и изделия перед укладкой обильно смачивают (п. 5.6).</li><li>При перерывах верхний ряд раствором не прикрывают, перед возобновлением поливают водой (п. 5.6).</li></ul></div><p class=\"e-note\">Расслаиваемость проверяют непосредственно на стройплощадке, если смесь перевозили неспециализированным транспортом.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-pogoda.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/kl-pogoda.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-derevo\"><summary><span class=\"q-sh\"><b>Деревянные конструкции</b><small>Крепёж и сборка, допуски монтажа, опирание балок и ферм, перекрытия.</small></span><span class=\"q-n\">3</span></summary><div class=\"e-sub q-chips\"><a href=\"#dr-sborka\">Сборка деревянных конструкций: крепёж</a><a href=\"#dr-dopuski\">Деревянные конструкции: допуски монтажа</a><a href=\"#dr-perekrytiya\">Деревянные перекрытия, фермы и стеновые панели</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"dr-sborka\"><header><h3>Сборка деревянных конструкций: крепёж</h3><p>Отверстия, гвозди, шурупы, болты, нагели и зубчатые пластины в соединениях.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 9.1.1–9.1.8</div></header><div class=\"q-facts\"><div><b>0,7 d</b><span>диаметр отверстия под шуруп от диаметра резьбы</span></div><div><b>4 d</b><span>наименьшая длина защемления шурупа в древесине</span></div><div><b>15 d</b><span>наименьшее расстояние от крайнего гвоздя или шурупа до торца вдоль волокон</span></div><div><b>50 см²</b><span>наименьшая площадь, перекрываемая зубчатой пластиной на каждом элементе</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Отверстие под рабочие болты и нагели: не более диаметра стержня</td><td class=\"n m\">≤ 1 d</td></tr><tr><td>Отверстие под стяжные болты и шпильки: превышение над диаметром стержня не более, мм</td><td class=\"n m\">1</td></tr><tr><td>Отверстие под шуруп: доля диаметра резьбы</td><td class=\"n m\">0,7</td></tr><tr><td>Длина защемления шурупа в древесине, не менее, диаметров</td><td class=\"n m\">4</td></tr><tr><td>Диаметр гвоздя: не более доли толщины пробиваемого элемента</td><td class=\"n m\">0,25</td></tr><tr><td>Отверстие под гвозди диаметром 6 мм и более: не более доли диаметра гвоздя</td><td class=\"n m\">0,8</td></tr><tr><td>Число гвоздей или шурупов в соединении, не менее</td><td class=\"n m\">2</td></tr><tr><td>Расстояние от крайнего гвоздя или шурупа до торца вдоль волокон, не менее, диаметров</td><td class=\"n m\">15</td></tr><tr><td>Расстояние до кромки элемента поперёк волокон, не менее, диаметров</td><td class=\"n m\">4</td></tr><tr><td>Площадь зубчатой пластины на каждом соединяемом элементе, не менее, см²</td><td class=\"n m\">50</td></tr><tr><td>Расстояние от кромки и торца элемента до крайних зубьев пластины, не менее, мм</td><td class=\"n m\">10</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Отверстия под крепёж сверлят только в предварительно закреплённом пакете, места сверления размечают по шаблону (п. 9.1.1).</li><li>Шурупы заворачивают в древесину до отказа, забивать шурупы нельзя (п. 9.1.1).</li><li>Гвозди забивают по шаблону под прямым углом к древесине (кроме Т-образных соединений). При встречной забивке гвозди не пробивают пакет насквозь. При сквозной забивке выступающие концы загибают поперёк волокон. Шляпки заподлицо с поверхностью (п. 9.1.1).</li><li>Не допускается забивать гвозди и заворачивать шурупы в увлажнённую и мёрзлую древесину, в сучки и трещины (п. 9.1.1).</li><li>Количество гвоздей и шурупов определяет проект. Ослаблять кромки стыкуемых элементов смятием и другими повреждениями нельзя (п. 9.1.1).</li><li>Металлические зубчатые пластины ставят в узлах симметрично ко всем стыкуемым элементам. Зубья вдавлены на всю глубину, пластины плотно прилегают по всей площади (п. 9.1.1).</li><li>Соединения элементов в пакетах плотные по всей площади примыкания, зазоры не допускаются (п. 9.1.2).</li><li>Стальные изделия для сборки и крепления предварительно защищают от коррозии по всей поверхности по ТНПА. Гвозди и проволока оцинкованные (п. 9.1.5).</li><li>Зимой конструкции, элементы, опоры, сопряжения и стыки тщательно очищают от снега, инея и наледи. Особенности работ в холодный период указывают в проекте и ППР (п. 9.1.3, 9.1.4).</li><li>Способы и средства крепления (хомуты, болты, нагели, гвозди) принимают по проекту с учётом СП 5.05.01. При электросварке закладных деталей работают циклами не более 1,5 мин с полным охлаждением металла (п. 9.2.10–9.2.12).</li><li>Работы ежедневно вносят в журнал монтажа по СН 1.03.04, ведут исполнительную геодезическую съёмку, составляют акты скрытых работ и промежуточной приёмки ответственных конструкций (п. 9.1.6).</li><li>В процессе монтажа до окончания возведения следят за трещинами, влажностью древесины и состоянием защитных покрытий (п. 9.1.8).</li></ul></div><p class=\"e-note\">d — диаметр. Диаметры отверстий принимают также по СП 5.05.01 (п. 9.2.11).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-sborka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-sborka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"dr-dopuski\"><header><h3>Деревянные конструкции: допуски монтажа</h3><p>Отклонения балок, ферм, колонн, врубок, болтов и гвоздей, рубленых стен и перегородок.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 9.2.6–9.2.9, табл. 9.1</div></header><div class=\"q-facts\"><div><b>±2 мм</b><span>нижние грани балок перекрытий от горизонтали на 1 м длины</span></div><div><b>±10 мм</b><span>нижние грани балок на всю длину; прямолинейность поясов ферм и балок</span></div><div><b>1 мм</b><span>наибольший зазор в стыках элементов</span></div><div><b>±3 мм</b><span>грани венцов рубленых стен от горизонтали на 1 м</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Нижние грани балок перекрытий от горизонтали на 1 м длины</td><td class=\"n m\">±2</td></tr><tr><td>Нижние грани балок перекрытий от горизонтали на всю длину</td><td class=\"n m\">±10</td></tr><tr><td>Прямолинейность поясов ферм и балок</td><td class=\"n m\">±10</td></tr><tr><td>Расстояния между осями конструкций</td><td class=\"n m\">±20</td></tr><tr><td>Вертикальность несущих конструкций, % высоты конструкции</td><td class=\"n m\">±5</td></tr><tr><td>Оси колонн, стоек, полурам, полуарок от разбивочных осей в опорном сечении</td><td class=\"n m\">±10</td></tr><tr><td>Глубина врубок от указанной в проекте</td><td class=\"n m\">±2</td></tr><tr><td>Расстояния между центрами болтов, нагелей, шпонок: входные отверстия</td><td class=\"n m\">±2</td></tr><tr><td>То же поперёк волокон: 2 % толщины пакета, но не менее</td><td class=\"n m\">5</td></tr><tr><td>То же вдоль волокон: 4 % толщины пакета, но не более</td><td class=\"n m\">10</td></tr><tr><td>Расстояния между центрами гвоздей со стороны забивки</td><td class=\"n m\">±2</td></tr><tr><td>Грани венцов рубленых стен от горизонтали на 1 м длины</td><td class=\"n m\">±3</td></tr><tr><td>Стены и перегородки от вертикали на 1 м высоты</td><td class=\"n m\">±3</td></tr><tr><td>Зазор в стыках сопрягаемых элементов, не более</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>При установке колонн, стоек, стропильных конструкций, балок перекрытий и при стыковке элементов торцы плотно примыкают друг к другу. Зазор в стыках не более 1 мм, сквозные щели не допускаются (п. 9.2.8).</li><li>Допуски и отклонения, характеризующие точность монтажа, назначаются в проекте в зависимости от заданного класса точности. Монтаж ведут с соблюдением требований таблицы 9.1 (п. 9.2.6, 9.2.7).</li><li>Конструкции защищают от увлажнения, гниения, коррозии и возгорания составами, указанными в проекте (п. 9.2.9).</li><li>Монтаж начинают с пространственно устойчивой части (связевой ячейки). Монтаж ведут по захваткам, вышележащий этаж — после проектного закрепления всех монтажных элементов нижележащего (п. 9.2.1–9.2.3).</li><li>Смонтированные конструкции изолируют при контакте с грунтом основания, кирпичной кладкой, монолитным бетоном и т. п., как предусмотрено проектом (п. 9.2.5).</li><li>Несущие конструкции монтируют в максимально укрупнённом виде. Укрупнительную сборку с затяжкой выполняют только в вертикальном положении, без затяжки — в горизонтальном (п. 9.2.4).</li></ul></div><p class=\"e-note\">Значение вертикальности «±5 % высоты» приведено так, как оно напечатано в выборке; перед применением его сверяют с официальным текстом.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-dopuski.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-dopuski.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"dr-perekrytiya\"><header><h3>Деревянные перекрытия, фермы и стеновые панели</h3><p>Опирание балок и ферм на стены, зазоры, антисептирование, подъём ферм, плиты покрытия и стеновые панели.</p><div class=\"q-src\">Источник: СН 1.03.01-2019, п. 9.2.13–9.2.17</div></header><div class=\"q-facts\"><div><b>≥ 200 мм</b><span>наименьшая длина опирания балок и брусьев перекрытий</span></div><div><b>≥ 30 мм</b><span>расстояние от торцов балок и ферм до каменных и бетонных стен</span></div><div><b>≥ 750 мм</b><span>длина антисептирования концов балок на каменных стенах со всех сторон</span></div><div><b>≥ 1/200</b><span>строительный подъём нижнего пояса фермы от пролёта</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Длина опирания балок и брусьев перекрытий на стены, не менее, мм</td><td class=\"n m\">200</td></tr><tr><td>Расстояние от торцов балок, брусьев и ферм до каменных и бетонных стен, не менее, мм</td><td class=\"n m\">30</td></tr><tr><td>Длина антисептирования концов балок на каменных стенах, не менее, мм</td><td class=\"n m\">750</td></tr><tr><td>Строительный подъём нижнего пояса фермы, не менее, доли пролёта</td><td class=\"n m\">1/200</td></tr><tr><td>Глубина опирания плит покрытия по тексту нормы, мм</td><td class=\"n m\">55</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Балки и брусья перекрытий укладывают по стенам с опиранием по проекту и обязательной анкеровкой. Торцы отстоят от стен не менее чем на 30 мм и отделены от них теплоизоляционными вкладышами. Глухая заделка концов не допускается (п. 9.2.17).</li><li>Концы балок и брусьев на каменных стенах обрабатывают антисептиком на длину не менее 750 мм со всех сторон и оборачивают изоляционным материалом на негниющей основе (п. 9.2.17).</li><li>Перед монтажом балок разбивают оси на опорах и обеспечивают проектное положение опор в стенах. Настил кладут по балкам и брусьям после их выверки и закрепления (п. 9.2.17).</li><li>Стропильные фермы и балки монтируют только после проектного закрепления и обеспечения устойчивости колонн или приёмки мест опирания в стенах. На опорные части наносят изоляционные покрытия (п. 9.2.14).</li><li>Первую смонтированную ферму крепят в коньке расчалками, последующие — временными распорками. Расчалки и распорки снимают после монтажа проектных элементов жёсткости (п. 9.2.14).</li><li>Фермы собирают со строительным подъёмом нижнего пояса не менее 1/200 пролёта, значение указано в проекте. Фермы и балки сразу перекрывают плитами покрытия (п. 9.2.14).</li><li>Торцы ферм и балок отстоят от каменных и бетонных стен не менее чем на 30 мм и отделены теплоизоляционными вкладышами. Глухая заделка опорных частей в стены не допускается (п. 9.2.14).</li><li>Плиты покрытия монтируют в одном потоке со стропильными конструкциями. Расстроповка только после закрепления обоих концов на опорах. Зазоры между плитами по проекту, заполняют в процессе монтажа. Утеплитель не мнут, не загрязняют и не увлажняют (п. 9.2.15).</li><li>Стеновые панели устанавливают по отметкам на каркасе, наружные поверхности панелей в одной плоскости, перепады между панелями не допускаются (п. 9.2.16).</li><li>Колонны, стойки, рамы и арки монтируют после проверки положения фундаментов и нанесения изоляции на опорные части. Положение выверяют по осям здания и нивелировочным отметкам. Ригели полурам и концы полуарок временно опирают на передвижную вышку до закрепления рамы или арки (п. 9.2.13).</li></ul></div><p class=\"e-note\">Глубина опирания плит покрытия определяется проектом; значение 55 мм приведено так, как оно напечатано в выборке нормы.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-perekrytiya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/dr-perekrytiya.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-elektrika\"><summary><span class=\"q-sh\"><b>Электрика</b><small>Проводки, светильники, щитки, автоматы и УЗО, вводные устройства, учёт электроэнергии, заземление: сечения, прокладка, розетки, ванные, приёмка.</small></span><span class=\"q-n\">13</span></summary><div class=\"e-sub q-chips\"><a href=\"#el-gruppovye\">Групповые линии: жилы и сечения</a><a href=\"#el-prokladka\">Прокладка электропроводки</a><a href=\"#el-rozetki\">Розетки и выключатели</a><a href=\"#el-svetilniki\">Светильники</a><a href=\"#el-vannaya\">Ванные и душевые помещения</a><a href=\"#el-shchitki\">Щитки и электрощитовые</a><a href=\"#el-avtomaty\">Автоматические выключатели</a><a href=\"#el-uzo\">УЗО</a><a href=\"#el-priyemka\">Проверка электропроводки при приёмке</a><a href=\"#el-vru\">Вводные устройства: ВУ, ВРУ, ГРЩ</a><a href=\"#el-uchet\">Учёт электроэнергии</a><a href=\"#el-zazemlenie\">Заземление и уравнивание потенциалов</a><a href=\"#el-zaz-proverka\">Проверка заземляющего устройства</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"el-gruppovye\"><header><h3>Групповые линии: жилы и сечения</h3><p>Какими проводниками выполняют линии от щитка до светильников и розеток и какие сечения допустимы.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.4.4–8.4.6, 8.4.14, табл. 8.1 · СН 4.04.01-2019, п. 7.1.2, 7.1.3, 9.14, 10.8</div></header><div class=\"q-facts\"><div><b>3 жилы</b><span>L, N и PE в каждой групповой линии</span></div><div><b>1,5 мм²</b><span>наименьшее сечение меди в силовых и осветительных цепях</span></div><div><b>2,5 мм²</b><span>наименьшее сечение алюминия</span></div><div><b>≤ 3 %</b><span>потери напряжения от щита до самого дальнего светильника общего освещения</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Медь, силовые и осветительные цепи: наименьшее сечение, мм²</td><td class=\"n m\">1,5</td></tr><tr><td>Алюминий, силовые и осветительные цепи: наименьшее сечение, мм²</td><td class=\"n m\">2,5</td></tr><tr><td>Медь, цепи сигнализации и управления: наименьшее сечение, мм²</td><td class=\"n m\">0,5</td></tr><tr><td>Нулевой рабочий N при однофазных нагрузках</td><td class=\"n m\">= фазному</td></tr><tr><td>Защитный PE при фазных жилах до 16 мм²</td><td class=\"n m\">= фазному</td></tr><tr><td>PE при фазных жилах 16–35 мм², мм²</td><td class=\"n m\">16</td></tr><tr><td>PE при фазных жилах больше 35 мм²</td><td class=\"n m\">50 % фазного</td></tr><tr><td>PE вне кабеля: с механической защитой / без неё, мм²</td><td class=\"n m\">2,5 / 4</td></tr><tr><td>Потери напряжения от ГРЩ (ВРУ) до светильников общего освещения, не более, %</td><td class=\"n m\">3</td></tr><tr><td>То же до прочих электроприёмников, не более, %</td><td class=\"n m\">5</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Медь: сигнализация</text><rect x=\"220\" y=\"6\" width=\"10.6\" height=\"22\" fill=\"#1d1f23\"/><text x=\"238.625\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм²</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Медь: силовые, освещение</text><rect x=\"220\" y=\"40\" width=\"31.9\" height=\"22\" fill=\"#1d1f23\"/><text x=\"259.875\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм²</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Алюминий</text><rect x=\"220\" y=\"74\" width=\"53.1\" height=\"22\" fill=\"#1d1f23\"/><text x=\"281.125\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2,5 мм²</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Неизол. медь</text><rect x=\"220\" y=\"108\" width=\"212.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"440.5\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм²</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Неизол. алюминий</text><rect x=\"220\" y=\"142\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">16 мм²</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Линии от групповых щитков и щитков на этажах и в квартирах до светильников общего освещения, розеток и стационарных приёмников выполняют трёхпроводными: фазный L, нулевой рабочий N и нулевой защитный PE (ТКП 339-2022, п. 8.4.6; СН 4.04.01, п. 7.1.3).</li><li>Нулевые проводники разных групповых линий не объединяют. На щитке N и PE не подключают под один общий зажим (п. 8.4.6).</li><li>Групповые сети сечением до 16 мм² выполняют медными жилами. Групповые сети инженерного оборудования могут быть алюминиевыми (п. 8.4.4).</li><li>В жилых зданиях допускается до 12 проводов групповых сетей квартир в одном канале (п. 8.4.5).</li><li>Распределительные сети выполняют с возможностью замены проводов, групповые сети рекомендуется выполнять так же (п. 8.4.7).</li><li>Сечение выбирают по нагреву длительным расчётным током с учётом способа прокладки, затем проверяют по потере напряжения и по уставке аппарата защиты (СН 4.04.01, п. 10.8). Расчёт есть в калькуляторах раздела «Электрика».</li><li>Места соединения и ответвления проводов и кабелей доступны для осмотра и ремонта (СН 4.04.01, п. 11.32).</li></ul></div><p class=\"e-note\">Наименьшие сечения взяты из табл. 8.1 и п. 8.4.14 ТКП 339-2022. Для цепей электронного оборудования допускается меньшее сечение по табл. 8.1.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-gruppovye.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-gruppovye.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-prokladka\"><header><h3>Прокладка электропроводки</h3><p>Где и как вести проводку: скрыто и открыто, над потолками, через стены, на чердаке.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.4.7–8.4.10, 8.5.7, табл. 8.2 · СН 4.04.01-2019, п. 11.2–11.6, 11.13–11.16</div></header><div class=\"q-facts\"><div><b>2,5 м</b><span>наименьшая высота открытой прокладки голых проводов на изоляторах (чердак)</span></div><div><b>1 000 мм</b><span>наибольший шаг изоляторов на чердаке</span></div><div><b>50 мм</b><span>наименьшее расстояние между проводами на изоляторах</span></div><div><b>0,5 м</b><span>от выключателей, розеток и щитов до газопроводов</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Медь до 2,5 мм² (алюминий до 4 мм²)</td><td class=\"n m\">не нормируется</td></tr><tr><td>Алюминий 6 мм²</td><td class=\"n m\">2,5</td></tr><tr><td>Медь 4 мм² (алюминий 10 мм²)</td><td class=\"n m\">2,8</td></tr><tr><td>Медь 6 и 10 мм² (алюминий 16 и 25 мм²)</td><td class=\"n m\">3,2</td></tr><tr><td>Медь 16 мм² (алюминий 35 и 50 мм²)</td><td class=\"n m\">3,5</td></tr><tr><td>Медь 25 и 35 мм² (алюминий 70 мм²)</td><td class=\"n m\">4</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>В полостях над непроходными подвесными потолками и внутри пустотных перегородок проводку выполняют сменяемой. При каркасе из материалов горючести Г2–Г4 провода идут в стальных трубах со стенкой не тоньше значений таблицы. При негорючих материалах или Г1 допустимы поливинилхлоридные трубы и глухие короба или открытые кабели, не распространяющие горение, с пониженным дымо- и газовыделением (ТКП 339-2022, п. 8.4.8; СН 4.04.01, п. 11.3).</li><li>К светильникам, ответвительным и протяжным коробкам над потолками сохраняют доступ (СН 4.04.01, п. 11.3).</li><li>В ванных, санузлах, душевых и саунах, как правило, скрытая проводка. Открыто можно вести кабели, но не в металлических трубах и рукавах и не провода в металлической оболочке (п. 8.4.9; СН 4.04.01, п. 11.13).</li><li>Провода, закладываемые в стены или жёстко закрепляемые на них, идут горизонтально, вертикально или параллельно кромкам стен. В перекрытиях без крепления допускается кратчайший путь (СН 4.04.01, п. 11.14).</li><li>Проход через стены, перегородки и перекрытия выполняют в трубе, коробе или проёме так, чтобы проводку можно было заменить. Зазоры заполняют легкоудаляемым материалом (СН 4.04.01, п. 11.15). Пересечение температурных и осадочных швов: компенсирующие меры (п. 11.16).</li><li>В вентиляционных каналах и шахтах провода не прокладывают. Пересекать их можно одиночными линиями в стальных трубах (СН 4.04.01, п. 11.4).</li><li>Линии разных квартир не ведут в одном канале, трубе или коробе без сплошных металлических перегородок. Транзит групповых линий через квартиры других собственников не допускается (СН 4.04.01, п. 11.2, 11.6).</li><li>В панелях стен, перегородок и перекрытий заводского изготовления и в монтажных стыках панелей проводку без возможности замены не прокладывают (п. 8.4.7).</li><li>На чердаке: открыто в стальных трубах или в оболочке из негорючего материала. Неметаллические трубы запрещены. Голые одножильные провода на изоляторах только на высоте не менее 2,5 м. Открытая проводка на чердаке медная, алюминий допустим в стальных трубах или скрыто в несгораемых конструкциях (п. 8.4.10).</li></ul></div><p class=\"e-note\">Таблица: наименьшая толщина стенки стальных труб при прокладке над подвесными потолками и в пустотных перегородках (табл. 8.2). Способ монтажа по типу провода выбирают по ГОСТ 30331.15.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-prokladka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-prokladka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-rozetki\"><header><h3>Розетки и выключатели</h3><p>Номиналы, высота, расстояния и места, где ставить нельзя.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.5.6–8.5.9 · СН 4.04.01-2019, п. 7.1.4, 7.1.5, 7.4.3, 11.19–11.22, 11.25–11.27</div></header><div class=\"q-facts\"><div><b>10 А</b><span>наименьший ток розеток с защитным контактом</span></div><div><b>0,8–1,7 м</b><span>рекомендуемая высота выключателей от пола, со стороны дверной ручки</span></div><div><b>32 А</b><span>розетка и защита линии стационарной электроплиты</span></div><div><b>0,6 м</b><span>наименьшее расстояние от выключателей и розеток до дверного проёма душевой кабины</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Розетка с защитным контактом: ток, не менее, А</td><td class=\"n m\">10</td></tr><tr><td>Клеммные колодки светильников в жилых домах: ток, не менее, А</td><td class=\"n m\">10</td></tr><tr><td>Выключатель: рекомендуемая высота от пола, м</td><td class=\"n m\">0,8–1,7</td></tr><tr><td>Розетки в детских учреждениях: высота от пола, м</td><td class=\"n m\">1,8</td></tr><tr><td>Линия электроплиты: розетка и аппарат защиты, не менее, А</td><td class=\"n m\">32</td></tr><tr><td>До газопроводов и газовых счётчиков, не менее, м</td><td class=\"n m\">0,5</td></tr><tr><td>До дверного проёма душевой кабины, не менее, м</td><td class=\"n m\">0,6</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Там, где проложена трёхпроводная сеть, ставят розетки на ток не менее 10 А с защитным контактом (ТКП 339-2022, п. 8.5.8). В жилых домах розетки на 10 (16) А, клеммные колодки светильников не менее чем на 10 А (СН 4.04.01, п. 7.1.4).</li><li>Выключатели рекомендуется ставить на стене со стороны дверной ручки на высоте 0,8–1,7 м. Допускается под потолком с управлением шнуром (п. 8.5.9).</li><li>В квартирах и в помещениях для детей розетки с устройством, закрывающим гнёзда при вынутой вилке (СН 4.04.01, п. 11.21). В детских учреждениях розетки на высоте 1,8 м, кроме розеток на столах в кабинетах и в компьютерных классах (п. 8.5.9).</li><li>Для стационарной электроплиты отдельная групповая линия к розетке не менее чем на 32 А с аппаратом защиты не менее чем на 32 А (СН 4.04.01, п. 11.19). Розетки не ставят над и под мойками и в кухонных шкафах (п. 11.20).</li><li>В ванных комнатах квартир розетки допускаются только в зоне 3, через разделительный трансформатор или с УЗО до 30 мА (п. 8.5.6; СН 4.04.01, п. 11.26). Выключатели в ванных, душевых, саунах и кладовых не устанавливают (СН 4.04.01, п. 7.4.3).</li><li>В кладовых и гардеробных жилых и усадебных домов розетки запрещены (СН 4.04.01, п. 7.1.5).</li><li>Скрытая установка розеток и выключателей на одной оси в общих стенах разных квартир не допускается (СН 4.04.01, п. 11.22).</li><li>Розетки на разные напряжения в одном здании конструктивно отличаются. Розетки в сети аварийного освещения запрещены (СН 4.04.01, п. 11.25, 11.27).</li><li>От выключателей, розеток и щитов до газопроводов и газовых счётчиков не менее 0,5 м (п. 8.5.7; СН 4.04.01, п. 11.20).</li></ul></div><p class=\"e-note\">Высоту установки розеток в жилых помещениях просмотренные разделы норм не задают, её определяет проект.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-rozetki.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-rozetki.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-svetilniki\"><header><h3>Светильники</h3><p>Подключение, подвес, защита по зонам, потери напряжения в линиях освещения.</p><div class=\"q-src\">Источник: СН 4.04.01-2019, п. 7.1.2–7.1.4, 7.3.6, 7.3.9, 7.3.10, 7.4.3, 9.14 · ТКП 339-2022, п. 8.5.4, 8.5.5, 8.7.3</div></header><div class=\"q-facts\"><div><b>≥ 10 А</b><span>клеммные колодки для подключения светильников в жилых домах</span></div><div><b>5 × масса</b><span>нагрузка на подвес светильника, 10 мин</span></div><div><b>10 кг</b><span>масса светильника для проекта в жилых комнатах, кухнях и прихожих</span></div><div><b>≤ 3 %</b><span>потери напряжения до самого дальнего светильника общего освещения</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Нагрузка на подвес, держится 10 мин без остаточных деформаций</td><td class=\"n m\">5 × масса</td></tr><tr><td>Люстры массой 25 кг и более</td><td class=\"n m\">2 × масса + 80 кг</td></tr><tr><td>Масса светильника в проекте (жилые комнаты, кухни, прихожие), кг</td><td class=\"n m\">10</td></tr><tr><td>Клеммные колодки светильников в жилых домах, не менее, А</td><td class=\"n m\">10</td></tr><tr><td>Потери напряжения от ГРЩ (ВРУ) до светильников общего освещения, не более, %</td><td class=\"n m\">3</td></tr><tr><td>Светильники в ванной, зона 3: класс защиты</td><td class=\"n m\">II</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>В жилых комнатах, кухнях и прихожих квартир предусматривают закладные детали и клеммные колодки на 10 А. В кухнях и прихожих кроме того подвесные патроны, подключаемые к колодке, в санузлах и застеклённых лоджиях стенной патрон (СН 4.04.01, п. 7.1.3).</li><li>Приспособления для подвеса держат пятикратную массу светильника в течение 10 мин без повреждений и остаточных деформаций. Для люстр массой 25 кг и более нагрузка равна двойной массе плюс 80 кг (СН 4.04.01, п. 7.3.10).</li><li>Линии освещения трёхпроводные (L, N, PE). В двух- и трёхфазных линиях освещения не используют предохранители и однополюсные автоматы (СН 4.04.01, п. 7.1.2).</li><li>В ванных комнатах выбирают светильники по зонам по ГОСТ 30331.11. В зоне 3 класс защиты II (СН 4.04.01, п. 7.3.6; ТКП 339-2022, п. 8.5.5). Выключатели в ванных, душевых и саунах не устанавливают (СН 4.04.01, п. 7.4.3).</li><li>Подвесные светильники без зажима для PE допустимы в помещениях без повышенной опасности при изолированном крюке, но проводка при этом остаётся трёхпроводной (ТКП 339-2022, п. 8.7.3).</li><li>Светильники с люминесцентными и светодиодными лампами: коэффициент пульсации освещённости в пределах СН 2.04.03 (СН 4.04.01, п. 7.3.9).</li><li>Над рабочими местами в помещениях приготовления пищи (кроме квартир): светильники с лампами накаливания со стеклом снизу, люминесцентные с решётками, сетками или держателями ламп (ТКП 339-2022, п. 8.5.4).</li><li>Потери напряжения до самого дальнего светильника общего освещения не более 3 % номинального, до прочих приёмников не более 5 % (СН 4.04.01, п. 9.14).</li></ul></div><p class=\"e-note\">Нормы освещённости помещений даёт СН 2.04.03, в калькуляторе освещения использованы значения гигиенической нормы.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-svetilniki.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-svetilniki.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-vannaya\"><header><h3>Ванные и душевые помещения</h3><p>Степень защиты по зонам, что можно ставить и обязательное дополнительное уравнивание потенциалов.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.5.5, 8.5.6, 8.7.4, 8.7.20, 8.4.9 · СН 4.04.01-2019, п. 7.3.6, 7.4.3, 11.13, 11.26</div></header><div class=\"q-facts\"><div><b>IPX7</b><span>зона 0, внутри ванны или поддона</span></div><div><b>IPX5</b><span>зона 1</span></div><div><b>IPX4</b><span>зона 2</span></div><div><b>IPX1</b><span>зона 3</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>В ваннах общего пользования зоны 2 и 3: степень защиты, не ниже</td><td class=\"n m\">IPX5</td></tr><tr><td>Безопасное напряжение для расчёта уравнивания потенциалов, В</td><td class=\"n m\">12</td></tr><tr><td>Розетки и выключатели от проёма душевой кабины, не менее, м</td><td class=\"n m\">0,6</td></tr><tr><td>УЗО розеток в зоне 3: ток срабатывания, не более, мА</td><td class=\"n m\">30</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 228\" role=\"img\" aria-label=\"Зоны ванной комнаты\" class=\"e-svg\"><rect x=\"0\" y=\"8\" width=\"200\" height=\"44\" fill=\"#1d1f23\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"12\" y=\"28\" font-size=\"15\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Зона 0</text><text x=\"12\" y=\"45\" font-size=\"11\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">внутри ванны или поддона</text><text x=\"216\" y=\"37\" font-size=\"18\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">IPX7</text><text x=\"310\" y=\"36\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">приборы до 12 В</text><rect x=\"0\" y=\"62\" width=\"200\" height=\"44\" fill=\"#6a6d75\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"12\" y=\"82\" font-size=\"15\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Зона 1</text><text x=\"12\" y=\"99\" font-size=\"11\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">над ванной</text><text x=\"216\" y=\"91\" font-size=\"18\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">IPX5</text><text x=\"310\" y=\"90\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">только водонагреватели</text><rect x=\"0\" y=\"116\" width=\"200\" height=\"44\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"12\" y=\"136\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Зона 2</text><text x=\"12\" y=\"153\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">рядом с ванной</text><text x=\"216\" y=\"145\" font-size=\"18\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">IPX4</text><text x=\"310\" y=\"144\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">водонагреватели, светильники класса II</text><rect x=\"0\" y=\"170\" width=\"200\" height=\"44\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"12\" y=\"190\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Nunito, Arial, sans-serif\">Зона 3</text><text x=\"12\" y=\"207\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">дальше от ванны</text><text x=\"216\" y=\"199\" font-size=\"18\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">IPX1</text><text x=\"310\" y=\"198\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">розетки через трансформатор или УЗО 30 мА</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Электрооборудование выбирают из предназначенного для своей зоны по ГОСТ 30331.11 со степенью защиты по воде: зона 0 не ниже IPX7, зона 1 IPX5, зона 2 IPX4, зона 3 IPX1. В ваннах общего пользования в зонах 2 и 3 IPX5 (ТКП 339-2022, п. 8.5.5).</li><li>В зоне 0 допускаются только приборы напряжением до 12 В, источник питания вне зоны. В зоне 1 только водонагреватели. В зоне 2 водонагреватели и светильники класса защиты II (п. 8.5.5).</li><li>В зонах 0, 1 и 2 соединительные коробки, распределительные устройства и приборы управления не устанавливают (п. 8.5.5).</li><li>Розетки допускаются только в зоне 3, через разделительный трансформатор или с УЗО на ток не более 30 мА. Любые выключатели и розетки не ближе 0,6 м от дверного проёма душевой кабины (п. 8.5.6; СН 4.04.01, п. 11.26).</li><li>Проводка скрытая в негорючих неметаллических трубках или каналах конструкций. Открыто можно вести только кабели, не в металлических трубах и рукавах и не в металлической оболочке (СН 4.04.01, п. 11.13; ТКП 339-2022, п. 8.4.9).</li><li>УЗО обязательны в линиях, питающих стационарное оборудование и светильники в ванных и душевых (п. 8.7.4).</li><li>Дополнительное уравнивание потенциалов в ванных, душевых и саунах обязательно (п. 8.7.20). К нему подключают сторонние проводящие части и защитные проводники оборудования, включая розетки.</li><li>Сопротивление проводников дополнительного уравнивания между любыми двумя одновременно доступными частями не более R = U / Ia. Здесь U = 12 В, Ia — ток, обеспечивающий срабатывание защиты от сверхтока за время не более 5 с, а при дифференциальной защите — номинальный отключающий ток вводного аппарата (п. 8.7.20.4).</li><li>При металлопластовых трубах краны, смесители и полотенцесушители считают сторонними частями. Их подключают к уравниванию либо ставят токопроводящие вставки на подаче воды перед входным вентилем со стороны стояка (п. 8.7.20.1).</li><li>Для саун нужна проводка с изоляцией, рассчитанной не ниже чем на 170 °C (п. 8.4.9).</li></ul></div><p class=\"e-note\">Размеры зон 0–3 задаёт ГОСТ 30331.11, здесь схема условная.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-vannaya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-vannaya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-shchitki\"><header><h3>Щитки и электрощитовые</h3><p>Где ставят щитки и вводно-распределительные устройства, какая защита и какие расстояния.</p><div class=\"q-src\">Источник: СН 4.04.01-2019, п. 10.2, 11.18, 11.28, 13.1–13.4 · ТКП 339-2022, п. 8.3.6, 8.3.9, 8.5.3</div></header><div class=\"q-facts\"><div><b>IP31</b><span>наименьшая степень защиты ВУ, ВРУ и ГРЩ вне электрощитовой</span></div><div><b>1 м</b><span>наименьшее расстояние до щитка от труб, радиаторов, газопроводов и счётчиков</span></div><div><b>IP44</b><span>наименьшая степень защиты щитов и аппаратов на чердаке</span></div><div><b>0,5 м</b><span>до газопроводов от щитов, выключателей и розеток</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>ВУ, ВРУ, ГРЩ вне электрощитовой: степень защиты, не ниже</td><td class=\"n m\">IP31</td></tr><tr><td>От труб, радиаторов, газопроводов и газовых счётчиков до щитков, не менее, м</td><td class=\"n m\">1</td></tr><tr><td>От щитов, выключателей и розеток до газопроводов, не менее, м</td><td class=\"n m\">0,5</td></tr><tr><td>Щиты и аппараты в чердачных помещениях: степень защиты, не ниже</td><td class=\"n m\">IP44</td></tr><tr><td>Панели ВРУ и ГРЩ рядом со слаботочным оборудованием: степень защиты, не ниже</td><td class=\"n m\">IP2X</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>ВУ, ВРУ и ГРЩ размещают в отдельных запирающихся электрощитовых. Дверь электрощитовой не открывают внутрь. В электрощитовой есть аварийное освещение и естественная вентиляция (СН 4.04.01, п. 13.1).</li><li>Вне электрощитовой щиты ставят в удобных, доступных местах в металлическом шкафу или нише с запирающимися дверцами. Рукоятки аппаратов съёмные или запираются. В общественных зданиях групповые щитки допустимы с пластиковой негорючей оболочкой, встроенные в стены из материалов горючести не ниже Г2 (СН 4.04.01, п. 13.2).</li><li>До места установки щитков от труб водопровода, отопления, канализации и водостоков, приборов отопления, газопроводов и газовых счётчиков не менее 1 м (СН 4.04.01, п. 13.2).</li><li>Электрощитовые и щитки вне них не располагают под уборными, ванными, душевыми, моечными, парильными и другими помещениями с мокрыми процессами. В районах затопления ставят выше возможного уровня воды (СН 4.04.01, п. 13.3).</li><li>Через электрощитовую допускаются трубы водоснабжения и отопления без ответвлений, люков, задвижек, фланцев и вентилей. Газопроводы, канализация и водостоки запрещены (СН 4.04.01, п. 13.4).</li><li>Щитки и шкафы любого назначения не ставят в объёме незадымляемых лестничных клеток (СН 4.04.01, п. 11.28). ВУ и ВРУ нельзя размещать и в обычных лестничных клетках новых зданий (п. 13.2).</li><li>В обычных лестничных клетках реконструируемых и ремонтируемых зданий при обосновании разрешены ВУ, ВРУ, распределительные пункты и групповые щитки, выступающие из стены на высоте до 2,2 м над ступенями и площадками, если минимальная эвакуационная ширина проходов не уменьшается (СН 4.04.01, п. 13.2).</li><li>Групповой щиток, питающий квартиры, располагают на лестничной клетке, в холле или в коридоре на этаже (ТКП 339-2022, п. 8.3.6).</li><li>В квартирных щитках, расположенных вне квартир, предохранители не допускаются (СН 4.04.01, п. 10.2).</li><li>Предельная коммутационная способность автоматов выше расчётного максимального тока короткого замыкания в месте их установки (СН 4.04.01, п. 10.4).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-shchitki.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-shchitki.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-avtomaty\"><header><h3>Автоматические выключатели</h3><p>Какие автоматы применяют, как выбирают номиналы и добиваются селективности, как их проверяют при приёмке.</p><div class=\"q-src\">Источник: СН 4.04.01-2019, п. 7.1.2, 8.1.4, 10.2–10.6, 11.19 · ТКП 339-2022, п. 4.4.26.3, 4.4.26.4, 4.4.28.5</div></header><div class=\"q-facts\"><div><b>2 ступени</b><span>на столько выше номинал аппарата, ближайшего к источнику (допустима 1)</span></div><div><b>1,1</b><span>кратность верхнего значения тока срабатывания мгновенного расцепителя при проверке</span></div><div><b>1–2 %</b><span>доля групповых выключателей приёмников 1 и 2 категории, проверяемая выборочно</span></div><div><b>2×</b><span>число проверяемых выключателей при браке</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Вводные и секционные выключатели: доля проверки, %</td><td class=\"n m\">100</td></tr><tr><td>Выключатели цепей аварийного освещения, пожарной сигнализации, пожаротушения, %</td><td class=\"n m\">100</td></tr><tr><td>Прочие выключатели защиты приёмников 1 и 2 категории, не менее, %</td><td class=\"n m\">1–2</td></tr><tr><td>Мгновенный расцепитель срабатывает при токе не более, × верхнего значения</td><td class=\"n m\">1,1</td></tr><tr><td>Сопротивление изоляции выключателей на 400 А и более, не менее, МОм</td><td class=\"n m\">1</td></tr><tr><td>Номинал линии электроплиты, не менее, А</td><td class=\"n m\">32</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Для защиты распределительных и групповых линий применяют одно-, двух- и трёхполюсные автоматы с комбинированными расцепителями. Автоматы только с электромагнитным мгновенным расцепителем не применяют, кроме линий пожарной автоматики (СН 4.04.01, п. 10.2). В квартирных щитках вне квартир предохранители не допускаются.</li><li>Уставки выбирают как можно ближе к расчётному току линии, но так, чтобы аппарат не отключал при кратковременных перегрузках, например пусковых токах (п. 10.5).</li><li>Для селективности каждый аппарат, ближайший к источнику, имеет номинал на две ступени выше предыдущего, в обоснованных случаях на одну (п. 10.5).</li><li>Предельная коммутационная способность автомата выше расчётного максимального тока короткого замыкания в точке подключения (п. 10.4).</li><li>Защита надёжно отключает повреждённый участок при трёх-, двух- и однофазном коротком замыкании в конце линии. Осветительные сети и сети бытовых и переносных приёмников защищены от перегрузки (п. 10.6).</li><li>Аппараты управления одновременно отключают все фазные проводники (п. 8.1.4). В двух- и трёхфазных групповых линиях освещения однополюсные автоматы и предохранители запрещены (п. 7.1.2).</li><li>Линия стационарной электроплиты: розетка и аппарат защиты не менее чем на 32 А (п. 11.19).</li><li>Проверка при приёмке: срабатывание мгновенного расцепителя при токе не более 1,1 верхнего значения, указанного изготовителем. Проверяют все вводные и секционные выключатели и выключатели цепей аварийного освещения, пожарной сигнализации и пожаротушения, а также не менее 1 % (в части электроустановок 2 %) прочих, защищающих приёмники 1 и 2 категории. При браке проверяют удвоенное число (ТКП 339-2022, п. 4.4.26.4).</li><li>Цепь «фаза–нуль» проверяют измерением тока однофазного замыкания или измерением полного сопротивления цепи «фаза–нулевой защитный проводник» с расчётом тока. Ток должен надёжно вызывать срабатывание защиты (п. 4.4.26.3, 4.4.28.5).</li></ul></div><p class=\"e-note\">Номиналы под конкретную нагрузку подбирает калькулятор «Подбор кабеля» раздела «Электрика».</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-avtomaty.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-avtomaty.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-uzo\"><header><h3>УЗО</h3><p>Где УЗО обязательны, на какой ток их выбирают, как проверяют при приёмке.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.7.4–8.7.18, 4.4.26.7, табл. 4.4.47, 4.4.49 · СН 4.04.01-2019, п. 16.3.1–16.3.13</div></header><div class=\"q-facts\"><div><b>30 мА</b><span>ток срабатывания для розеток, ванных, стиральных, посудомоечных машин, плит, водонагревателей</span></div><div><b>300 мА</b><span>на вводе в квартиру или дом, защита от возгорания</span></div><div><b>1/3</b><span>наибольшая доля от номинального тока УЗО, которую составляет суммарная утечка</span></div><div><b>0,5–1</b><span>надёжное срабатывание в диапазоне от 0,5 до 1 номинального тока</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>УЗО на розеточных группах и мокрых помещениях: ток срабатывания, не более, мА</td><td class=\"n m\">30</td></tr><tr><td>УЗО на вводе для защиты от возгорания: ток срабатывания, не более, мА</td><td class=\"n m\">300</td></tr><tr><td>Суммарный ток утечки, не более, от номинального тока УЗО</td><td class=\"n m\">1/3</td></tr><tr><td>Утечка приёмника больше 32 А без данных, мА на 1 А тока нагрузки</td><td class=\"n m\">0,4</td></tr><tr><td>Утечка сети, мкА на 1 м фазного провода</td><td class=\"n m\">10</td></tr><tr><td>Электроплита с расчётным током больше 32 А: ток УЗО не более, мА / время не более, мс</td><td class=\"n m\">100 / 100</td></tr><tr><td>Селективность: уставка и время ближнего к источнику УЗО, не менее, ×</td><td class=\"n m\">3</td></tr><tr><td>УЗО сохраняет работоспособность при падении напряжения до 50 %, не менее, с</td><td class=\"n m\">5</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">при Iотк</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 с</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">при 2·Iотк</text><rect x=\"220\" y=\"40\" width=\"102.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"330.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,15 с</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">при 5·Iотк</text><rect x=\"220\" y=\"74\" width=\"27.2\" height=\"22\" fill=\"#1d1f23\"/><text x=\"255.2\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,04 с</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Обязательны: групповые линии розеток, стиральные и посудомоечные машины, электроплиты, электроводонагреватели, стационарное оборудование и светильники в ванных и душевых, электрообогрев поверхностей, световая реклама и архитектурное освещение, садовые домики, а также случаи, когда автомат не обеспечивает нормируемого времени отключения (ТКП 339-2022, п. 8.7.4; СН 4.04.01, п. 16.3.3, 16.3.4).</li><li>Действующая редакция: в линиях стационарного оборудования и светильников (кроме ванных) и в общих сетях освещения УЗО не обязательно (п. 8.7.11). Для приёмников, отключение которых опасно, например пожарной сигнализации, УЗО запрещено (п. 8.7.13).</li><li>Изменение № 2 к СН 4.04.01 (пост. от 17.09.2026 № 75, вступает через 60 дней после официального опубликования) вводит УЗО для светильников общего освещения (кроме аварийного), для приборов отопления и электроводонагревателей, зарядных станций электромобилей (кроме случаев, когда станция сама имеет УЗО). УЗО не может быть единственной мерой защиты от поражения током (п. 16.3.1, 16.3.3).</li><li>По Изм. № 2 ток УЗО в групповых линиях: до 30 мА при расчётном токе до 32 А; при токе свыше 32 А не более 100 мА и 100 мс; до 10 мА в помещениях с постоянным пребыванием детей и беременных женщин (п. 16.3.13).</li><li>Для защиты от поражения током УЗО ставят, как правило, в отдельных групповых линиях. К одному УЗО допускается несколько линий через отдельные автоматы (п. 8.7.11).</li><li>УЗО лучше применять совмещённым с автоматом. Без защиты от сверхтока УЗО в линии без дополнительного аппарата не допускается (п. 8.7.8).</li><li>Номинальный отключающий дифференциальный ток не менее чем втрое больше суммарного тока утечки сети и подключённых приёмников (п. 8.7.14). Фактический ток отключения по СТБ ГОСТ Р 50807 лежит в диапазоне от половины до целого номинального значения (п. 8.7.15).</li><li>В жилых зданиях УЗО не должно отключать нагрузку при исчезновении или падении напряжения. Оно сохраняет работу не менее 5 с при снижении до 50 % номинального (п. 8.7.9).</li><li>В зоне действия УЗО нулевой рабочий проводник не соединяют с заземлёнными элементами и нулевым защитным проводником (п. 8.7.6). УЗО, защищающее от возгорания, отключает фазный и нулевой проводники (п. 8.7.18).</li><li>Тип A реагирует на переменные и пульсирующие токи утечки (стиральные машины с регулятором скорости, регулируемые источники света, телевизоры, компьютеры), тип AC только на переменные (п. 8.7.10).</li><li>Приёмка: на каждый полюс серии по пять измерений. Ток отключения лежит между неотключаемым током и номинальным током отключения. Время отключения типа АС при Iотк больше 0,03 А для защиты при косвенном прикосновении не более 5 с при Iотк, 0,3 с при 2·Iотк, 0,15 с при 5·Iотк. При снятии напряжения без нагрузки УЗО не отключается, автоматического повторного включения нет (п. 4.4.26.7, табл. 4.4.47).</li></ul></div><p class=\"e-note\">На диаграмме номинальное время отключения по табл. 4.4.49: 0,5 с при Iотк, 0,15 с при 2·Iотк, 0,04 с при 5·Iотк.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-uzo.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-uzo.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-priyemka\"><header><h3>Проверка электропроводки при приёмке</h3><p>Сопротивление изоляции, цепь «фаза–нуль», выборочная проверка аппаратов защиты.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 4.4.26.1–4.4.26.4, 4.4.28.5–4.4.28.7, 4.4.29.2, табл. 4.4.46</div></header><div class=\"q-facts\"><div><b>0,5 МОм</b><span>наименьшее сопротивление изоляции силовых и осветительных сетей</span></div><div><b>1000 В</b><span>напряжение мегаомметра для силовых и осветительных сетей</span></div><div><b>500 В</b><span>мегаомметр для цепей до 60 В</span></div><div><b>2500 В</b><span>мегаомметр для силовых кабелей, изоляция не менее 0,5 МОм</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Силовые и осветительные сети: мегаомметр 1000 В, не менее, МОм</td><td class=\"n m\">0,5</td></tr><tr><td>Распределительные устройства (каждая секция), щиты, токопроводы: мегаомметр 500–1000 В, не менее, МОм</td><td class=\"n m\">0,5</td></tr><tr><td>Вторичные цепи до 60 В от отдельного источника или разделительного трансформатора: 500 В, не менее, МОм</td><td class=\"n m\">0,5</td></tr><tr><td>Вторичные цепи присоединений и питания приводов: 1000–2500 В, не менее, МОм</td><td class=\"n m\">1</td></tr><tr><td>Силовые кабели до 1 кВ: мегаомметр 2500 В, не менее, МОм</td><td class=\"n m\">0,5</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Сопротивление изоляции силовых и осветительных сетей измеряют между каждым проводом и землёй и между каждыми двумя проводами. Оно не менее значений таблицы (табл. 4.4.46, прим. 3).</li><li>При измерении изоляции вторичных цепей с подключёнными аппаратами принимают меры против повреждения микроэлектронных и полупроводниковых элементов (табл. 4.4.46, прим. 1, 2).</li><li>Цепь «фаза–нуль» силовых и осветительных сетей в сетях с системой TN проверяют: либо измеряют ток однофазного замыкания на корпус или нулевой защитный проводник специальными приборами, либо измеряют полное сопротивление цепи «фаза–нулевой защитный проводник» и вычисляют ток. Он должен надёжно вызывать срабатывание защиты (п. 4.4.26.3, 4.4.28.5).</li><li>Автоматические выключатели: проверка мгновенных расцепителей, объём выборки и удвоение при браке, подробности в карточке «Автоматические выключатели» (п. 4.4.26.4).</li><li>УЗО проверяют по СТБ ГОСТ Р 50807, подробности в карточке «УЗО» (п. 4.4.26.7).</li><li>Сопротивление заземляющих устройств и напряжение прикосновения, где оно нормируется, проверяют по п. 4.4.28.6 и 4.4.28.7. Средства измерений аттестованы или поверены (п. 4.4.26, в).</li></ul></div><p class=\"e-note\">Использована действующая редакция ТКП 339-2022. Редакция ТКП 339-2011 утратила силу.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-priyemka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-priyemka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-vru\"><header><h3>Вводные устройства: ВУ, ВРУ, ГРЩ</h3><p>Где и как размещают вводно-распределительные устройства, какая защита, расстояния и требования к электрощитовой.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.1.3, 8.2.8, 8.3.1–8.3.10 · СН 4.04.01-2019, п. 9.10–9.12, 12.1, 13.1–13.5</div></header><div class=\"q-facts\"><div><b>IP31</b><span>наименьшая степень защиты ВУ, ВРУ, ГРЩ вне электрощитовой</span></div><div><b>1 м</b><span>до труб водопровода, отопления, канализации, газопроводов и газовых счётчиков</span></div><div><b>+5 °С</b><span>наименьшая температура в помещении с ВРУ и ГРЩ</span></div><div><b>250 А</b><span>нагрузка линии от ВРУ в жилом доме, как правило, не более</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Степень защиты ВУ, ВРУ, ГРЩ вне электрощитовой, не ниже</td><td class=\"n m\">IP31</td></tr><tr><td>Расстояние от труб (вода, отопление, канализация, водостоки), приборов отопления, газопроводов и газовых счётчиков, не менее, м</td><td class=\"n m\">1</td></tr><tr><td>Температура в помещении с ВРУ и ГРЩ, не ниже, °С</td><td class=\"n m\">5</td></tr><tr><td>Огнестойкость перегородок сухого подвала с ВРУ, не менее</td><td class=\"n m\">EI45</td></tr><tr><td>Нагрузка распределительной линии от ВРУ в жилом доме, как правило, не более, А</td><td class=\"n m\">250</td></tr><tr><td>Нагрузка на вводе в квартиру, при которой нужен трёхфазный ввод, более, кВт</td><td class=\"n m\">12</td></tr><tr><td>Степень защиты панелей ВРУ и ГРЩ при слаботочных устройствах в помещении, не ниже</td><td class=\"n m\">IP2X</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>На вводе в здание ставят ГРЩ, ВУ или ВРУ. При нескольких обособленных потребителях каждому рекомендуется своё ВУ или ВРУ. Перед вводом в здание дополнительные кабельные ящики не ставят, кроме выносных щитков учёта (ТКП 339-2022, п. 8.3.1, 8.3.2).</li><li>Аппараты защиты устанавливают на вводе питающих линий и на всех отходящих линиях. На вводе нужны аппараты управления. Автоматический выключатель считают аппаратом защиты и управления (п. 8.3.3, 8.3.4; СН 4.04.01, п. 9.10).</li><li>Групповой щиток для питания квартир ставят на лестничной клетке, в холле или в коридоре на этаже (п. 8.3.6).</li><li>ВУ, ВРУ, ГРЩ размещают в запирающихся электрощитовых, доступных только персоналу. Дверь электрощитовой открывается наружу. Вход в электрощитовую во внутрь не предусматривают (п. 8.3.8, 8.3.9; СН 4.04.01, п. 13.1).</li><li>В электрощитовой делают естественную вентиляцию и электрическое освещение, по СН 4.04.01 — также аварийное освещение. Температура не ниже +5 °С (п. 8.3.10; СН 4.04.01, п. 13.1).</li><li>Допускается размещать устройства в сухом подвале, доступном персоналу, если он отделён перегородками не менее EI45. В районах возможного затопления устройства ставят выше уровня затопления (п. 8.3.8; СН 4.04.01, п. 13.3).</li><li>Вне электрощитовой: в шкафу или нише с запирающимися дверцами, степень защиты не ниже IP31, в удобном и доступном месте, на расстоянии не менее 1 м от труб, приборов отопления, газопроводов и счётчиков. Рукоятки аппаратов не выводят наружу, они съёмные или запираются (п. 8.3.8; СН 4.04.01, п. 13.2).</li><li>Не допускается размещать ВУ и ВРУ в незадымляемых лестничных клетках и в обычных лестничных клетках вновь строящихся зданий. При обосновании в реконструируемых зданиях допускаются устройства, выступающие до высоты 2,2 м от проступей и площадок, если не уменьшается эвакуационная ширина (СН 4.04.01, п. 13.2).</li><li>Электрощитовые и ВРУ не располагают под санузлами, ванными, душевыми, кухнями (кроме кухонь квартир), мойками, парильными и другими влажными помещениями (п. 8.3.9; СН 4.04.01, п. 13.3).</li><li>Через электрощитовую не рекомендуется прокладывать трубопроводы воды и отопления. Если проходят, то без ответвлений, люков, задвижек, фланцев и вентилей в пределах помещения. Газопроводы, трубопроводы с горючими жидкостями (а по СН 4.04.01 и канализация, водостоки) запрещены (п. 8.3.9; СН 4.04.01, п. 13.4).</li><li>На вводе во ВУ или ВРУ устанавливают ограничители импульсных перенапряжений. Устройства защиты от искрения рекомендуются (п. 8.1.3).</li><li>При питании однофазных потребителей от многофазной сети допускаются общие N и PE, проложенные от ВРУ. Объединять N и PE в четырёхпроводную сеть с PEN не допускается. В цепях PE и PEN нет коммутирующих элементов (п. 8.2.8).</li><li>ВУ, ВРУ и ГРЩ проверяют по режиму короткого замыкания (СН 4.04.01, п. 12.1).</li></ul></div><p class=\"e-note\">Ширину и высоту проходов у ВУ, ВРУ, ГРЩ берут из п. 6.1.6.1 ТКП 339-2022, в просмотренной выборке этот пункт не приведён.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-vru.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-vru.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-uchet\"><header><h3>Учёт электроэнергии</h3><p>Какие счётчики ставят, где размещают, что должно быть до и после счётчика, выносной щиток учёта.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 8.6.1–8.6.17 · СН 4.04.01-2019, п. 9.12</div></header><div class=\"q-facts\"><div><b>до 100 А</b><span>непосредственное включение счётчика, выше — через трансформаторы тока</span></div><div><b>4 тарифа</b><span>наименьшее число тарифов расчётного счётчика</span></div><div><b>1,0</b><span>наименьший класс точности расчётного счётчика</span></div><div><b>IP54</b><span>наименьшая степень защиты выносного щитка учёта</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Тарифов у многотарифного статического счётчика, не менее</td><td class=\"n m\">4</td></tr><tr><td>Класс точности расчётного счётчика, не ниже</td><td class=\"n m\">1</td></tr><tr><td>Класс точности трансформаторов тока для расчётных счётчиков, не ниже</td><td class=\"n m\">0,5 S</td></tr><tr><td>Нагрузка, до которой счётчик включают непосредственно, А</td><td class=\"n m\">100</td></tr><tr><td>Расчётных счётчиков на квартиру</td><td class=\"n m\">1</td></tr><tr><td>Дополнительный счётчик при электроотоплении и горячем водоснабжении суммарной мощностью более, кВт</td><td class=\"n m\">5</td></tr><tr><td>Объекты с расчётной мощностью до, кВт: допускается класс 1,0 без цифрового интерфейса</td><td class=\"n m\">15</td></tr><tr><td>Индукционные счётчики класса не ниже 2,0: индивидуальные дома до, кВт</td><td class=\"n m\">3,5</td></tr><tr><td>То же стройплощадки, сезонные объекты до, кВт</td><td class=\"n m\">40</td></tr><tr><td>Испытательные колодки под счётчиком с трансформаторами, не далее, м</td><td class=\"n m\">0,5</td></tr><tr><td>Степень защиты выносного щитка учёта, не ниже</td><td class=\"n m\">IP54</td></tr><tr><td>Балансных счётчиков на секцию ВРУ с квартирами</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Расчётные счётчики: статические многотарифные (не менее четырёх тарифов), класса точности не ниже 1,0, с цифровым интерфейсом. Непосредственное включение при нагрузках до 100 А, при больших нагрузках — трансформаторное, трансформаторы тока не ниже 0,5 S (п. 8.6.2).</li><li>Для объектов до 15 кВт (павильоны, киоски, малый бизнес в отдельных зданиях, дачные и гаражные кооперативы) допускаются статические счётчики класса 1,0 без цифрового интерфейса. Для индивидуальных домов с мощностью до 3,5 кВт, строительных площадок и сезонных объектов до 40 кВт допускаются индукционные счётчики класса не ниже 2,0 (п. 8.6.2).</li><li>Счётчики серийные, их типы внесены в Государственный реестр средств измерений. Для АСКУЭ нужен ещё и отраслевой перечень Министерства энергетики (п. 8.6.3).</li><li>На каждую квартиру один одно- или трёхфазный расчётный счётчик. При суммарной мощности электроотопления и горячего водоснабжения более 5 кВт ставят дополнительный счётчик (п. 8.6.4). Для двух однофазных вводов в квартиру с разными тарифами ставят отдельные счётчики (СН 4.04.01, п. 9.12).</li><li>В общественных зданиях счётчики ставят на ВРУ (ГРЩ) в точках балансового разграничения. Каждому обособленному потребителю (ателье, магазины, склады) свой расчётный счётчик (п. 8.6.5, 8.6.6).</li><li>В многоквартирных домах предусматривают раздельный учёт освещения вспомогательных помещений, лифтов и водоповысительных установок. Счётчики общедомовой нагрузки рекомендуется ставить в шкафах ВРУ или на панелях ГРЩ (п. 8.6.6, 8.6.7).</li><li>На каждой секции ВРУ, от которой питаются квартиры, ставят один балансный счётчик для сравнения с суммой показаний квартирных (п. 8.6.8).</li><li>Квартирные счётчики размещают в отдельном отсеке этажного щитка с врезным замком и окном для снятия показаний. Защитно-коммутационную аппаратуру в этом отсеке не размещают (п. 8.6.9).</li><li>Перед счётчиком прямого включения ставят коммутационный аппарат с возможностью опломбирования, снимающий напряжение со всех фаз. После счётчика ставят аппарат защиты. Если после счётчика несколько линий, снабжённых аппаратами защиты, общий аппарат не нужен, а при размещении аппаратов за пределами помещения счётчика нужен общий отключающий аппарат (п. 8.6.10, 8.6.11).</li><li>Под счётчиками с измерительными трансформаторами не далее 0,5 м ставят испытательные колодки с опломбированием (п. 8.6.12).</li><li>В одноквартирных и блокированных домах счётчик, как правило, в запираемом выносном щитке на границе земельного участка, с электроподогревом зимой при необходимости, или на опоре воздушной линии. Допускается сплит-счётчик (п. 8.6.13).</li><li>Выносной щиток: по ГОСТ IEC 61439-1, степень защиты не ниже IP54, исполнение У1 по ГОСТ 15150, со смотровым окном, антивандальный, доступ только персоналу энергоснабжающей организации. Коммутационная аппаратура до счётчика и защитная после него размещаются в этом же щитке (п. 8.6.14–8.6.16).</li><li>Дополнительные требования к щитку может задать энергоснабжающая организация в технических условиях (п. 8.6.17).</li></ul></div><p class=\"e-note\">Требования к учёту в разд. 8.6 дополняют раздел 15 основного ТКП (на него ссылается п. 8.6.1). Тип и место установки счётчика согласуют с энергоснабжающей организацией.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-uchet.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-uchet.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-zazemlenie\"><header><h3>Заземление и уравнивание потенциалов</h3><p>Система заземления, сечения защитных проводников и проводников уравнивания потенциалов, главная заземляющая шина.</p><div class=\"q-src\">Источник: СН 4.04.01-2019, п. 16.1.2–16.1.17 · ТКП 339-2022, п. 8.2.8, 8.7.1–8.7.3, 8.7.19, 8.7.20</div></header><div class=\"q-facts\"><div><b>TN-S, TN-C-S</b><span>системы заземления жилых и общественных зданий</span></div><div><b>6 мм²</b><span>наименьшее сечение главного проводника уравнивания по меди</span></div><div><b>25 мм²</b><span>сечение по меди, большее которого не требуется</span></div><div><b>12 В</b><span>безопасное напряжение для расчёта уравнивания в ванне и поддоне</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Защитный PE при фазных проводниках до 16 мм²</td><td class=\"n m\">= фазному</td></tr><tr><td>PE при фазных проводниках от 16 до 35 мм², мм²</td><td class=\"n m\">16</td></tr><tr><td>PE при фазных проводниках свыше 35 мм²</td><td class=\"n m\">50 % фазного</td></tr><tr><td>PEN или PEM, наименьшее сечение по меди, мм²</td><td class=\"n m\">10</td></tr><tr><td>PEN или PEM, наименьшее сечение по алюминию, мм²</td><td class=\"n m\">16</td></tr><tr><td>Главный проводник уравнивания: не менее половины PE питающей линии, но не менее по меди, мм²</td><td class=\"n m\">6</td></tr><tr><td>То же по алюминию, мм²</td><td class=\"n m\">16</td></tr><tr><td>То же по стали, мм²</td><td class=\"n m\">50</td></tr><tr><td>Главный проводник уравнивания: сечение больше не требуется по меди, мм²</td><td class=\"n m\">25</td></tr><tr><td>Уравнивание между двумя сторонними частями с механической защитой: медь, мм²</td><td class=\"n m\">2,5</td></tr><tr><td>То же без механической защиты: медь, мм²</td><td class=\"n m\">4</td></tr><tr><td>То же алюминий, мм²</td><td class=\"n m\">16</td></tr><tr><td>Отдельно стоящая ГЗШ в месте, доступном посторонним: оболочка не ниже</td><td class=\"n m\">IP21</td></tr><tr><td>Самостоятельное функциональное заземление: расстояние до других заземлителей, не менее, м</td><td class=\"n m\">15</td></tr><tr><td>То же сопротивление, не более, Ом</td><td class=\"n m\">4</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>В жилых и общественных зданиях применяют системы заземления TN-S или TN-C-S (СН 4.04.01, п. 16.1.2).</li><li>Открытые проводящие части светильников общего освещения и стационарных электроприёмников присоединяют к защитному проводнику. Корпуса переносных приборов класса I и настольной оргтехники подключают к PE трёхпроводной линии. К защитным проводникам присоединяют металлические каркасы перегородок, дверей, рам и подвесных потолков, используемых для прокладки кабелей (п. 16.1.3–16.1.5; ТКП 339-2022, п. 8.7.2).</li><li>Нулевой рабочий и нулевой защитный проводники под общий зажим не подключают (п. 16.1.9). PE прокладывают в общей оболочке или трубе с фазными проводниками либо рядом с ними (п. 16.1.8, 16.1.10).</li><li>Объединённые PEN и PEM применяют только в стационарных установках на участках, не защищённых УЗО. Металлические оболочки проводок и сторонние проводящие части в качестве PEN или PEM использовать нельзя (п. 16.1.11).</li><li>Подвесные светильники без зажима для PE допускаются в помещениях без повышенной опасности при изолированном крюке. Это не основание для двухпроводных проводок (ТКП 339-2022, п. 8.7.3).</li><li>Основная система уравнивания потенциалов обязательна в каждой электроустановке здания. Через ГЗШ соединяют PE и PEN питающей сети, повторное заземление на вводе, металлические трубы воды, канализации, отопления и газа (соединённые между собой на вводе), металлические части несущих конструкций и фундамента, металлические части централизованной вентиляции и кондиционирования, молниезащиту, оболочки телекоммуникационных кабелей (п. 16.1.13).</li><li>Все соединения с ГЗШ надёжные, с индивидуальным отсоединением инструментом для измерения сопротивления заземляющего устройства (п. 16.1.13).</li><li>При нескольких вводах или встроенных ТП делают ГЗШ для каждого ВУ, ВРУ и каждой ТП. ГЗШ соединяют между собой проводником сечением меньшей из соединяемых ГЗШ (п. 16.1.14). Отдельно стоящую ГЗШ ставят в доступном месте у вводного устройства (п. 16.1.15).</li><li>В ванных, душевых и саунах дополнительное уравнивание потенциалов обязательно. В прочих помещениях рекомендуется: к нему присоединяют доступные открытые проводящие части, сторонние проводящие части и защитные проводники, в том числе розеток (ТКП 339-2022, п. 8.7.19, 8.7.20; СН 4.04.01, п. 16.1.16).</li><li>Проводник доп. уравнивания между двумя открытыми частями не слабее наименьшего из присоединённых PE. Между открытой и сторонней частью — не слабее половины соответствующего PE (СН 4.04.01, п. 16.1.17).</li><li>Сопротивление проводников доп. уравнивания между доступными одновременному прикосновению частями не более R = U / Ia, где U = 12 В, Ia — ток срабатывания защиты за время не более 5 с в TN (при отсутствии данных — ток отсечки) (ТКП 339-2022, п. 8.7.20.4).</li><li>Металлопластовые трубы: краны, смесители, полотенцесушители считают сторонними частями, их подключают к доп. уравниванию. Либо ставят токопроводящие вставки на подаче воды перед входным вентилем, тогда отдельно арматуру подключать не нужно. При металлических стояках в коробе достаточно подключить проводник к трубам стояков (п. 8.7.20.1).</li><li>При изолирующих водопроводных трубах обеспечивают электрическую связь воды с основной системой уравнивания на вводе и внутри здания. В частных домах с автономной канализацией ставят токопроводящую вставку в фановой трубе и (или) подключают проводящие части накопителя стоков (п. 8.7.20.2, 8.7.20.3).</li></ul></div><p class=\"e-note\">Сечение защитных проводников при ином материале, чем у фазных, пересчитывают по проводимости (п. 16.1.7). Конструкция и сопротивление заземлителей, молниезащита задаются проектом по ТКП 339-2022 (подраздел 4.3) и СН 4.04.03, их в выборке нет.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-zazemlenie.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-zazemlenie.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"el-zaz-proverka\"><header><h3>Проверка заземляющего устройства</h3><p>Что проверяют при приёмке заземления: соединения, переходное сопротивление, цепь «фаза-нуль», напряжение прикосновения.</p><div class=\"q-src\">Источник: ТКП 339-2022, п. 4.4.28.1–4.4.28.7, табл. 4.4.56 · ТКП 339-2022, п. 8.7.20.4</div></header><div class=\"q-facts\"><div><b>0,05 Ом</b><span>переходное сопротивление исправного контактного соединения не превышает</span></div><div><b>60 В</b><span>допустимое напряжение прикосновения при длительности 1 с (до 1 кВ)</span></div><div><b>20 В</b><span>то же при длительности более 1 с</span></div><div><b>5 с</b><span>время срабатывания защиты для расчёта доп. уравнивания в TN</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, В</th></tr></thead><tbody><tr><td>Длительность воздействия 0,1 с</td><td class=\"n m\">340</td></tr><tr><td>Длительность воздействия 0,2 с</td><td class=\"n m\">160</td></tr><tr><td>Длительность воздействия 0,5 с</td><td class=\"n m\">105</td></tr><tr><td>Длительность воздействия 1,0 с</td><td class=\"n m\">60</td></tr><tr><td>Длительность воздействия более 1,0 с</td><td class=\"n m\">20</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">0,1 с</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">340 В</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">0,2 с</text><rect x=\"220\" y=\"40\" width=\"160.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">160 В</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">0,5 с</text><rect x=\"220\" y=\"74\" width=\"105.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"333.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">105 В</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">1,0 с</text><rect x=\"220\" y=\"108\" width=\"60.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"288.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">60 В</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Более 1,0 с</text><rect x=\"220\" y=\"142\" width=\"20.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"248.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">20 В</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Конструкцию заземляющего устройства проверяют после монтажа до засыпки грунта и присоединения естественных заземлителей и заземляемых элементов. Сечения и проводимости элементов должны соответствовать подразделу 4.3 (ТКП 339-2022, п. 4.4.28.1).</li><li>Цепи и контактные соединения между заземлителями и заземляемыми элементами, а также соединения естественных заземлителей осматривают на обрывы и другие дефекты. Надёжность сварки проверяют простукиванием молотком. Может измеряться переходное сопротивление: у исправного соединения оно не превышает 0,05 Ом (п. 4.4.28.2).</li><li>В электроустановках до 1 кВ с системой TN проверяют цепь «фаза-нуль»: измеряют ток однофазного замыкания на корпус или нулевой защитный проводник либо полное сопротивление цепи «фаза — нулевой защитный проводник» с расчётом тока. Ток должен обеспечивать надёжное срабатывание защиты (п. 4.4.28.5).</li><li>Пробивные предохранители в установках до 1 кВ должны быть исправны и соответствовать номинальному напряжению установки (п. 4.4.28.4).</li><li>Сопротивление заземляющих устройств с присоединёнными естественными заземлителями должно удовлетворять значениям, приведённым в соответствующих разделах кодекса (п. 4.4.28.6).</li><li>Напряжение прикосновения измеряют, если установка выполнена по нормам на напряжение прикосновения (табл. 4.4.56), при присоединённых естественных заземлителях, на рабочих местах и в контрольных точках, определённых расчётом при проектировании. Длительность воздействия — суммарное время действия релейной защиты и собственное время отключения выключателя (п. 4.4.28.7).</li><li>Сопротивление проводников дополнительного уравнивания потенциалов в ванных и душевых не более R = U / Ia при U = 12 В (п. 8.7.20.4).</li></ul></div><p class=\"e-note\">Таблица 4.4.56: значения для электроустановок до 1 кВ с любой нейтралью (и 1–35 кВ с изолированной нейтралью). Для 110–750 кВ нормы другие, их здесь нет.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/el-zaz-proverka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/el-zaz-proverka.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-vodokanal\"><summary><span class=\"q-sh\"><b>Водоснабжение и канализация</b><small>Монтаж ХВС и ГВС, внутренняя канализация, высоты приборов, водостоки. Монтажные числа даны по ТКП 45-1.03-85, который заменён СП 1.03.02-2020: сверяйте.</small></span><span class=\"q-n\">5</span></summary><div class=\"e-sub q-chips\"><a href=\"#ov-hvs\">Монтаж холодного и горячего водоснабжения</a><a href=\"#ov-kanalizaciya\">Внутренняя канализация: сети, трапы, вентиляция стояков</a><a href=\"#ov-kanal-montazh\">Монтаж канализации и водостоков</a><a href=\"#ov-vysoty\">Высота установки санитарных приборов</a><a href=\"#ov-vodostok\">Внутренние водостоки</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"ov-hvs\"><header><h3>Монтаж холодного и горячего водоснабжения</h3><p>Уклоны, вертикаль, расстояния до стены, гильзы, температура монтажа и испытания труб ХВС и ГВС.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 4.3–4.8, 6.1.2–6.1.18</div></header><div class=\"q-facts\"><div><b>0,002</b><span>наименьший уклон труб холодной и горячей воды и отопления</span></div><div><b>2 мм</b><span>наибольшее отклонение трубы от вертикали на 1 м</span></div><div><b>≥ 30 мм</b><span>выступ гильзы над чистым полом</span></div><div><b>≥ 25 мм</b><span>расстояние между полимерными трубами горячей и холодной воды</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Отклонение трубы от вертикали, не более, мм на 1 м</td><td class=\"n m\">2</td></tr><tr><td>Уклон труб ХВС, ГВС и отопления, не менее</td><td class=\"n m\">0,002</td></tr><tr><td>Допустимое отклонение уклона, не более, % от проектного</td><td class=\"n m\">10</td></tr><tr><td>Расстояние от штукатурки до оси неизолированной трубы Dу до 32 мм, мм</td><td class=\"n m\">35–55</td></tr><tr><td>То же для труб Dу 40–50 мм, мм</td><td class=\"n m\">50–60</td></tr><tr><td>Выступ гильзы над чистым полом, не менее, мм</td><td class=\"n m\">30</td></tr><tr><td>Зазор между трубой и гильзой Dу до 32 мм, не менее, мм</td><td class=\"n m\">5</td></tr><tr><td>Зазор между трубой и гильзой больших диаметров, не менее, мм</td><td class=\"n m\">10</td></tr><tr><td>Расстояние между полимерными трубами горячей и холодной воды, не менее, мм</td><td class=\"n m\">25</td></tr><tr><td>Температура воздуха при монтаже полимерных труб, не ниже, °С</td><td class=\"n m\">5</td></tr><tr><td>Лючок для доступа в санузле, не менее, мм</td><td class=\"n m\">300 × 300</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Вертикаль трубы, на 1 м</text><rect x=\"220\" y=\"6\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Горизонталь отопительного прибора, на 1 м</text><rect x=\"220\" y=\"40\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Горизонталь санитарного прибора, на 1 м</text><rect x=\"220\" y=\"74\" width=\"147.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"375.33333333333337\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Холодную воду прокладывают ниже горячей и ниже отопления, расстояние между осями труб — 80 мм (п. 6.1.12).</li><li>Зазор между трубой и гильзой заполняют негорючим материалом. Гильзы ставят там, где труба проходит через перекрытия и стены (п. 6.1.8).</li><li>Санитарные приборы устанавливают горизонтально: отклонение не более 1,3 мм на 1 м. Отопительные приборы — не более 3 мм на 1 м (п. 6.1.6).</li><li>Системы испытывают до закрытия борозд и отделки, затем промывают (п. 6.1.17, 6.1.18).</li><li>Люки в санузлах для доступа к арматуре и ревизиям — не менее 300 × 300 мм. От креплений до фасонных частей полимерных труб — не менее 50 мм (п. 4.3–4.8).</li><li>Счётчики воды с фильтром устанавливают на высоте 900–1500 мм (п. 6.2.5).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. Числа даны по выборке из ТКП 45-1.03-85, раздел 6. Порядок работ в санузлах и перечень испытаний уточняют по полному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-hvs.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-hvs.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-kanalizaciya\"><header><h3>Внутренняя канализация: сети, трапы, вентиляция стояков</h3><p>Уклоны, скорость стоков, трапы, ревизии и вывод вентиляционной части стояка над кровлей.</p><div class=\"q-src\">Источник: СН 4.01.03-2019, п. 16.3, 16.4, 17.1, 17.2, 18.2, 18.3</div></header><div class=\"q-facts\"><div><b>≥ 0,7 м/с</b><span>наименьшая скорость движения стоков</span></div><div><b>0,03 / 0,02</b><span>уклон нерассчитываемых участков Ø до 50 мм / свыше 50 мм</span></div><div><b>≥ 25 мм</b><span>разрыв струи при присоединении к сети</span></div><div><b>0,01–0,02</b><span>уклон пола душевых и санузлов</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Скорость стоков, не менее, м/с</td><td class=\"n m\">0,7</td></tr><tr><td>Наполнение трубы при расчёте, не менее</td><td class=\"n m\">0,3</td></tr><tr><td>Уклон нерассчитываемых участков Ø до 50 мм</td><td class=\"n m\">0,03</td></tr><tr><td>Уклон нерассчитываемых участков Ø свыше 50 мм</td><td class=\"n m\">0,02</td></tr><tr><td>Наибольший уклон трубопровода (кроме ответвлений от приборов длиной до 1,5 м)</td><td class=\"n m\">0,15</td></tr><tr><td>Уклон пола душевых и санузлов</td><td class=\"n m\">0,01–0,02</td></tr><tr><td>Уклон выпусков подземных этажей, не менее</td><td class=\"n m\">0,02</td></tr><tr><td>Разрыв струи при присоединении, не менее, мм</td><td class=\"n m\">25</td></tr><tr><td>Горизонтальное расстояние от вытяжной части стояка до окон и балконов, не менее, м</td><td class=\"n m\">4</td></tr></tbody></table></div><h4 class=\"q-h4\">Вытяжная часть стояка выше кровли</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, м</th></tr></thead><tbody><tr><td>Над сборной вентиляционной шахтой</td><td class=\"n m\">0,1</td></tr><tr><td>Над плоской неэксплуатируемой кровлей</td><td class=\"n m\">0,3</td></tr><tr><td>Над скатной кровлей</td><td class=\"n m\">0,5</td></tr><tr><td>Над эксплуатируемой кровлей</td><td class=\"n m\">3</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Трапы Ø50 мм ставят в душевых на 1–2 душа, в полах санузлов гостиничных номеров, в умывальных с пятью и более умывальниками (п. 16.3).</li><li>Трапы Ø100 мм ставят в душевых на 3–4 душа, в общественных туалетах с тремя и более унитазами или писсуарами, в мусоросборных камерах, производственных помещениях (п. 16.3).</li><li>Ванны с двусторонним присоединением подключают только косой крестовиной. Приборы разных квартир к одному отводу не присоединяют. Прямые крестовины на горизонтальных сборных линиях не применяют (п. 17.1).</li><li>Не прокладывают канализацию в электрощитовых и над жилыми комнатами (кроме студий). Ревизии ставят на нижнем и верхнем этажах, а при пяти этажах и более — не реже чем через три этажа (п. 17.1).</li><li>Диаметр вытяжной части равен диаметру стояка. Её нельзя соединять с вентиляцией и дымоходами. Дефлекторы не применяют. Невентилируемые стояки допускаются только в одноэтажных усадебных домах (п. 17.2).</li></ul></div><p class=\"e-note\">Значение «V·√(h/d) ≥ K» (K = 0,5 для полимерных, 0,6 для прочих труб) в выборке читается неоднозначно, его проверяют по полному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kanalizaciya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kanalizaciya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-kanal-montazh\"><header><h3>Монтаж канализации и водостоков</h3><p>Шаг креплений, ревизии, раструбы, трапы, унитаз и уклоны отводов водостоков.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 6.1.5, 6.3 · СН 4.01.03-2019, п. 20.11</div></header><div class=\"q-facts\"><div><b>0,005</b><span>уклон отводных трубопроводов водостоков</span></div><div><b>1 м</b><span>высота ревизии водосточного стояка над полом</span></div><div><b>≤ 2 м</b><span>шаг креплений горизонтальной чугунной канализации</span></div><div><b>≥ 5 °С</b><span>температура при монтаже унитаза на клей</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Уклон подвесных отводных трубопроводов водостоков, не менее</td><td class=\"n m\">0,005</td></tr><tr><td>Высота ревизии водосточного стояка над полом, м</td><td class=\"n m\">1</td></tr><tr><td>Шаг креплений горизонтальной чугунной канализации, не более, м</td><td class=\"n m\">2</td></tr><tr><td>Шаг креплений вертикальных полимерных труб диаметром до 32 мм, не более, мм</td><td class=\"n m\">1000</td></tr><tr><td>То же для труб большего диаметра, не более, мм</td><td class=\"n m\">1500</td></tr><tr><td>Длина подводки, при которой её крепят посередине, свыше, мм</td><td class=\"n m\">1500</td></tr><tr><td>Температура при монтаже унитаза на клей, не ниже, °С</td><td class=\"n m\">5</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Раструбы труб направляют против движения стоков. Отверстия незаглушённых труб на время работ закрывают заглушками (п. 6.3).</li><li>Трапы устанавливают заподлицо с чистым полом (п. 6.3).</li><li>Унитаз закрепляют к полу шурупами или на клей. Клей применяют при температуре не ниже 5 °С (п. 6.3).</li><li>Горизонтальные отводные трубопроводы гравитационно-сифонной системы водостоков прокладывают без уклона (п. 20.11).</li><li>Вертикальные стальные трубы при высоте этажа более 3 м крепят на половине высоты этажа (п. 6.1.5).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. Карточка собрана из выборки ТКП 45-1.03-85 (разд. 6.1 и 6.3). Остальные пункты монтажа сетей смотрят в полном тексте.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kanal-montazh.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kanal-montazh.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vysoty\"><header><h3>Высота установки санитарных приборов</h3><p>Высота от чистого пола до верха прибора по назначению здания, расстояния между приборами.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, прил. В, табл. В.1, п. 6.2.2</div></header><div class=\"q-facts\"><div><b>800 мм</b><span>умывальник в жилых и общественных зданиях</span></div><div><b>850 мм</b><span>раковина и мойка</span></div><div><b>400 мм</b><span>унитаз в жилых и общественных зданиях</span></div><div><b>±10 мм</b><span>допуск положения отдельного прибора</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Жилые, общественные, производственные</th><th class=\"n\">Школы, дошкольные, лечебные</th><th class=\"n\">Дошкольные</th><th class=\"n\">Для инвалидов</th></tr></thead><tbody><tr><td>Умывальники</td><td class=\"n m\">800</td><td class=\"n m\">700</td><td class=\"n m\">400 (500)</td><td class=\"n m\">750</td></tr><tr><td>Раковины и мойки</td><td class=\"n m\">850</td><td class=\"n m\">850</td><td class=\"n m\">850</td><td class=\"n m\">800</td></tr><tr><td>Писсуары настенные</td><td class=\"n m\">650</td><td class=\"n m\">500</td><td class=\"n m\">—</td><td class=\"n m\">650</td></tr><tr><td>Питьевые фонтанчики</td><td class=\"n m\">900</td><td class=\"n m\">750</td><td class=\"n m\">—</td><td class=\"n m\">700</td></tr><tr><td>Унитаз</td><td class=\"n m\">400</td><td class=\"n m\">400 (340 для младших классов)</td><td class=\"n m\">340</td><td class=\"n m\">400</td></tr><tr><td>Напольная чаша</td><td class=\"n m\">300</td><td class=\"n m\">300</td><td class=\"n m\">—</td><td class=\"n m\">—</td></tr><tr><td>Гигиенический душ</td><td class=\"n m\">400</td><td class=\"n m\">400</td><td class=\"n m\">400</td><td class=\"n m\">400</td></tr></tbody></table></div><h4 class=\"q-h4\">Расстояния между приборами</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Обычные</th><th class=\"n\">Для инвалидов</th></tr></thead><tbody><tr><td>Между осями умывальников, не менее</td><td class=\"n m\">650</td><td class=\"n m\">800</td></tr><tr><td>Между осями ванн и писсуаров, не менее</td><td class=\"n m\">700</td><td class=\"n m\">850</td></tr><tr><td>От оси прибора до боковой стены, не менее</td><td class=\"n m\">—</td><td class=\"n m\">400</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Допуск положения: ±10 мм для отдельных приборов, ±5 мм для однотипных приборов в ряд (прил. В).</li><li>Если умывальник и ванна работают на общий смеситель, смеситель ставят на высоте 850 мм (прим. к табл. В.1).</li><li>В общественных уборных с двумя и более писсуарами один из них устанавливают на высоте не более 400 мм (прим. к табл. В.1).</li><li>Смывные трубы к лотковым писсуарам — 1500 мм. В дошкольных учреждениях умывальники для яслей — 400 мм, для дошкольных групп — 500 мм (прим. к табл. В.1).</li><li>Душевая сетка: 2100–2250 мм; в дошкольных учреждениях 1500 мм; для инвалидов 1500–1900 мм (п. 6.2.2).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. В столбце «Дошкольные» значение в скобках и в столбце школ значение для младших классов даны так, как приведены в выборке. Сноски таблицы В.1 проверяют по официальному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vysoty.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vysoty.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vodostok\"><header><h3>Внутренние водостоки</h3><p>Допустимый расход на водосточный стояк, расчётная площадь кровли, скорость и уклоны отводов.</p><div class=\"q-src\">Источник: СН 4.01.03-2019, п. 20.2, 20.5, 20.8, 20.10, 20.11, табл. 20.1 · ТКП 45-1.03-85-2007, п. 6.3.9</div></header><div class=\"q-facts\"><div><b>80 л/с</b><span>наибольший расчётный расход на стояк Ø200 мм</span></div><div><b>+ 30 %</b><span>площади примыкающих стен добавляют к площади кровли</span></div><div><b>≥ 0,7 м/с</b><span>наименьшая скорость в гравитационно-сифонной системе</span></div><div><b>≤ 2,5 м/с</b><span>наибольшая скорость в точке выпуска</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, л/с</th></tr></thead><tbody><tr><td>Стояк Ø85 мм</td><td class=\"n m\">10</td></tr><tr><td>Стояк Ø100 мм</td><td class=\"n m\">20</td></tr><tr><td>Стояк Ø150 мм</td><td class=\"n m\">50</td></tr><tr><td>Стояк Ø200 мм</td><td class=\"n m\">80</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стояк Ø85 мм</text><rect x=\"220\" y=\"6\" width=\"42.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"270.5\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 л/с</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стояк Ø100 мм</text><rect x=\"220\" y=\"40\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">20 л/с</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стояк Ø150 мм</text><rect x=\"220\" y=\"74\" width=\"212.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"440.5\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">50 л/с</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Стояк Ø200 мм</text><rect x=\"220\" y=\"108\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">80 л/с</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Воду из внутренних водостоков отводят в наружную дождевую или общесплавную канализацию. В бытовую канализацию отвод запрещён, как и присоединение санитарных приборов к водостоку (п. 20.2).</li><li>К одному стояку самотечной системы подключают воронки разных уровней, если общий расчётный расход не превышает значений таблицы 20.1 (п. 20.5).</li><li>К расчётной водосборной площади добавляют 30 % суммарной площади вертикальных стен, примыкающих к кровле и возвышающихся над ней (п. 20.8).</li><li>Гравитационно-сифонная система: скорость не менее 0,7 м/с для самоочищения, в точке выпуска не более 2,5 м/с (п. 20.10).</li><li>Подвесные отводные трубопроводы — с уклоном не менее 0,005. Горизонтальные отводы гравитационно-сифонной системы — без уклона (п. 20.11).</li><li>На водосточном стояке ревизию ставят на высоте 1 м от пола (п. 6.3.9 ТКП).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. Таблица 20.1 даёт расчётный расход дождевых вод на стояк, значения не заменяют гидравлический расчёт.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vodostok.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vodostok.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-otoplenie\"><summary><span class=\"q-sh\"><b>Отопление</b><small>Системы и температуры, скорость воды, приборы и кронштейны, монтаж и тёплый пол. Монтажные числа даны по ТКП 45-1.03-85 (заменён СП 1.03.02-2020).</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#ov-ot-sistemy\">Системы отопления по назначению помещений</a><a href=\"#ov-ot-truby\">Трубопроводы отопления: скорость воды и температуры</a><a href=\"#ov-ot-pribory\">Отопительные приборы и арматура: установка и крепление</a><a href=\"#ov-ot-montazh\">Монтаж отопления и тёплого пола</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"ov-ot-sistemy\"><header><h3>Системы отопления по назначению помещений</h3><p>Предельная температура водяного теплоносителя и допустимые виды отопления для помещений разного назначения.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, прил. Ж, табл. Ж.1, п. 7.1.10</div></header><div class=\"q-facts\"><div><b>95 °С</b><span>жилые, общественные, детские, спортзалы, бани, торговые залы, киоски</span></div><div><b>85 °С</b><span>палаты и операционные в больницах (кроме психиатрических)</span></div><div><b>120 °С</b><span>производственные Г1, Г2, Д; лестничные клетки; тепловые пункты</span></div><div><b>150 °С</b><span>пассажирские залы вокзалов</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, °С</th></tr></thead><tbody><tr><td>Жилые, общественные, административные, бытовые</td><td class=\"n m\">95</td></tr><tr><td>Детские дошкольные учреждения, их лестничные клетки и вестибюли</td><td class=\"n m\">95</td></tr><tr><td>Палаты, операционные, лечебные помещения в больницах (кроме психиатрических и наркологических)</td><td class=\"n m\">85</td></tr><tr><td>Лечебные помещения в психиатрических и наркологических больницах</td><td class=\"n m\">95</td></tr><tr><td>Спортивные залы</td><td class=\"n m\">95</td></tr><tr><td>Бани, прачечные, душевые</td><td class=\"n m\">95</td></tr><tr><td>Общественное питание (кроме ресторанов), торговые залы</td><td class=\"n m\">95</td></tr><tr><td>Пассажирские залы вокзалов</td><td class=\"n m\">150</td></tr><tr><td>Зрительные залы и залы ресторанов</td><td class=\"n m\">95</td></tr><tr><td>Производственные А, Б и В1–В4 без горючей пыли и аэрозолей</td><td class=\"n m\">120</td></tr><tr><td>Производственные А, Б с горючей пылью и аэрозолями</td><td class=\"n m\">110</td></tr><tr><td>Производственные В2–В4 с горючей пылью и аэрозолями</td><td class=\"n m\">120</td></tr><tr><td>Производственные Г1, Г2, Д</td><td class=\"n m\">120</td></tr><tr><td>Лестничные клетки, пешеходные переходы, вестибюли</td><td class=\"n m\">120</td></tr><tr><td>Тепловые пункты</td><td class=\"n m\">120</td></tr><tr><td>Киоски и павильоны</td><td class=\"n m\">95</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Для жилых, общественных, административных и бытовых помещений допускаются водяное отопление приборами, встроенные нагревательные элементы в стенах, перекрытиях и полах, воздушное и квартирное отопление, электрическое и газовое с температурой поверхности не более 95 °С (поз. 1).</li><li>Газовое отопление в зданиях III–V степеней огнестойкости не допускается (прим. 2 к табл. Ж.1).</li><li>В детских учреждениях образования, в помещениях с постоянным пребыванием детей, приборы с прямым превращением электроэнергии в тепло не применяют. Допускаются электрообогрев бетонного пола по СП 4.04.04 и водяное отопление с электрокотлом (прим. 3).</li><li>Температура воздуха в системах воздушного отопления рассчитывается по п. 7.1.10. Её принимают не менее чем на 20 % ниже температуры самовоспламенения веществ, выделяющихся в помещении.</li><li>Для торговых залов и помещений с легковоспламеняющимися жидкостями принимают позицию 11, перечисление а) или б) (поз. 8).</li></ul></div><p class=\"e-note\">Показана предельная температура воды. Для электрических приборов она зависит от помещения: 95, 115, 130 или 150 °С по таблице Ж.1.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-sistemy.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-sistemy.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-ot-truby\"><header><h3>Трубопроводы отопления: скорость воды и температуры</h3><p>Допустимая скорость воды по уровню шума и температура поверхности встроенных нагревательных элементов.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, п. 6.2.5, 6.2.8, 6.3.4, прил. М, табл. М.1</div></header><div class=\"q-facts\"><div><b>95 °С</b><span>теплоноситель отопления жилых и общественных зданий</span></div><div><b>120 °С</b><span>теплоноситель систем теплоснабжения</span></div><div><b>1,5 м/с</b><span>наибольшая скорость при шуме более 40 дБА в общественных зданиях</span></div><div><b>29 °С</b><span>пол при постоянном пребывании людей</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(м/с)</span></th><th class=\"n\">До 5</th><th class=\"n\">10</th><th class=\"n\">15</th><th class=\"n\">20</th><th class=\"n\">30</th></tr></thead><tbody><tr><td>Эквивалентный уровень шума 25 дБ</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,1 / 0,7</td><td class=\"n m\">0,9 / 0,55</td><td class=\"n m\">0,75 / 0,50</td><td class=\"n m\">0,60 / 0,40</td></tr><tr><td>Эквивалентный уровень шума 30 дБ</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,2</td><td class=\"n m\">1,2 / 1,00</td><td class=\"n m\">1,00 / 0,80</td><td class=\"n m\">0,85 / 0,65</td></tr><tr><td>Эквивалентный уровень шума 35 дБ</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,10</td><td class=\"n m\">1,20 / 0,95</td><td class=\"n m\">1,00 / 0,80</td></tr><tr><td>Эквивалентный уровень шума 40 дБ</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,5</td><td class=\"n m\">1,5 / 1,50</td><td class=\"n m\">1,50 / 1,50</td><td class=\"n m\">1,30 / 1,20</td></tr></tbody></table></div><h4 class=\"q-h4\">Температура поверхности встроенных нагревательных элементов</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, °С</th></tr></thead><tbody><tr><td>Пол: постоянное пребывание людей</td><td class=\"n m\">29</td></tr><tr><td>Пол: временное пребывание</td><td class=\"n m\">33</td></tr><tr><td>Пол в детских и лечебных помещениях: постоянное / временное пребывание</td><td class=\"n m\">26 / 31</td></tr><tr><td>Пол по оси элемента: жилые помещения и бассейны, не более</td><td class=\"n m\">37</td></tr><tr><td>Пол по оси элемента: детские помещения, не более</td><td class=\"n m\">35</td></tr><tr><td>Потолок высотой 2,5–2,8 м</td><td class=\"n m\">28</td></tr><tr><td>Потолок высотой 2,8–3,0 м</td><td class=\"n m\">30</td></tr><tr><td>Потолок высотой 3,0–3,5 м</td><td class=\"n m\">33</td></tr><tr><td>Потолок высотой 3,5–4,0 м</td><td class=\"n m\">36</td></tr><tr><td>Потолок высотой 4,0–6,0 м</td><td class=\"n m\">38</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Верхнее значение скорости — для кранов пробочных, трёхходовых и двойной регулировки, нижнее — для вентилей. В столбцах указан коэффициент местных сопротивлений узла прибора или стояка (прим. 1 к табл. М.1).</li><li>Для трубы, идущей через несколько помещений, скорость определяют по помещению с наименьшим допустимым уровнем шума и по арматуре с наибольшим сопротивлением на участке длиной 30 м в обе стороны от помещения (прим. 2).</li><li>При уровне шума выше 40 дБА скорость воды ограничена: 1,5 м/с в общественных зданиях, 2,0 м/с в административных и бытовых, 3,0 м/с в производственных (п. 6.3.4).</li><li>Температура теплоносителя: до 95 °С для отопления жилых и общественных зданий, до 120 °С для теплоснабжения (п. 6.2.8).</li><li>Полимерные трубы скрыто прокладывают в помещениях категорий А, Б и В1–В3 по условиям п. 6.3.13. Транзит труб через убежища и электротехнические помещения запрещён (п. 6.3.14).</li><li>При температуре теплоносителя выше 105 °С до горючих конструкций Г3 и Г4 оставляют не менее 100 мм (п. 6.3.18).</li></ul></div><p class=\"e-note\">Температуры поверхности взяты из п. 6.2.5. Значение «наружные стены до 1,0 м — 95 °С» в выборке читается неоднозначно, его проверяют по полному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-truby.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-truby.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-ot-pribory\"><header><h3>Отопительные приборы и арматура: установка и крепление</h3><p>Расстояния от радиаторов и конвекторов до пола, подоконника и стены, число кронштейнов, арматура и контроль.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 6.4.3–6.4.15, табл. 2</div></header><div class=\"q-facts\"><div><b>≥ 60 мм</b><span>расстояние от радиатора до пола</span></div><div><b>≥ 50 мм</b><span>расстояние от радиатора до подоконника</span></div><div><b>≥ 25 мм</b><span>расстояние от радиатора до стены</span></div><div><b>≥ 100 мм</b><span>заглубление дюбеля в основание</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Радиатор: от пола, не менее, мм</td><td class=\"n m\">60</td></tr><tr><td>Радиатор: от подоконника, не менее, мм</td><td class=\"n m\">50</td></tr><tr><td>Радиатор: от стены, не менее, мм</td><td class=\"n m\">25</td></tr><tr><td>Гладкие и ребристые трубы: от пола и подоконника, не менее, мм</td><td class=\"n m\">200</td></tr><tr><td>Гладкие и ребристые трубы: от стены, мм</td><td class=\"n m\">25</td></tr><tr><td>Гладкие и ребристые трубы: между осями, не менее, мм</td><td class=\"n m\">200</td></tr><tr><td>Стояк от края окна, мм</td><td class=\"n m\">150 ± 50</td></tr><tr><td>Заглубление дюбеля в основание, не менее, мм</td><td class=\"n m\">100</td></tr><tr><td>Кронштейнов на 1 м² нагревательной поверхности радиатора</td><td class=\"n m\">1</td></tr><tr><td>Кронштейнов на один радиатор, не менее</td><td class=\"n m\">3</td></tr></tbody></table></div><h4 class=\"q-h4\">Число кронштейнов на секционный радиатор (табл. 2)</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Одиночных</th><th class=\"n\">или двойных</th></tr></thead><tbody><tr><td>2 секции</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>3–7 секций</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>8–16 секций</td><td class=\"n m\">4</td><td class=\"n m\">3</td></tr><tr><td>17–19 секций</td><td class=\"n m\">5</td><td class=\"n m\">3</td></tr><tr><td>20–28 секций</td><td class=\"n m\">8</td><td class=\"n m\">4</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Подставки: два при установке до 10 секций, три при большем числе секций. Конвекторы крепят в двух или трёх точках (п. 6.4.9, 6.4.10).</li><li>Конвекторы ставят на расстоянии не менее 20 мм до стены. Кожух отступает от стены до 3 мм (п. 6.4.4).</li><li>На гладких и ребристых трубах не допускается отклонение более 5 мм в меньшую сторону от проектного расстояния (п. 6.4.6).</li><li>Манометры устанавливают через трёхходовой кран при температуре воды до 105 °С (п. 6.4.14).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. В таблице 2 одиночные кронштейны и двойной кронштейн взаимозаменяемы: указано число тех или других на радиатор. Значения прочитаны по выборке, их проверяют по официальному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-pribory.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-pribory.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-ot-montazh\"><header><h3>Монтаж отопления и тёплого пола</h3><p>Уклоны подводок, опрессовка, пуск тёплого пола, пробное давление радиаторов.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 6.4.1, 6.4.8, 6.4.17–6.4.19</div></header><div class=\"q-facts\"><div><b>0,002</b><span>наименьший уклон труб отопления</span></div><div><b>0,3 МПа</b><span>давление в трубах тёплого пола при замоноличивании</span></div><div><b>≥ 20 сут</b><span>срок до пуска тёплого пола после замоноличивания</span></div><div><b>3 сут</b><span>выдержка при начальной температуре</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Подводка длиной до 500 мм: уклон</td><td class=\"n m\">не требуется</td></tr><tr><td>Подводка длиной 500–600 мм: перепад на длину, мм</td><td class=\"n m\">5</td></tr><tr><td>Подводка длиной более 600 мм: перепад на длину, мм</td><td class=\"n m\">10</td></tr><tr><td>Наименьший уклон труб отопления</td><td class=\"n m\">0,002</td></tr><tr><td>Давление в трубах тёплого пола при замоноличивании, МПа</td><td class=\"n m\">0,3</td></tr><tr><td>Срок до пуска тёплого пола после замоноличивания, не менее, сут</td><td class=\"n m\">20</td></tr><tr><td>Начальная температура воды при пуске тёплого пола, °С</td><td class=\"n m\">25</td></tr><tr><td>Подъём температуры воды, °С в сутки</td><td class=\"n m\">5</td></tr><tr><td>Выдержка при начальной температуре, сут</td><td class=\"n m\">3</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Тёплый пол пускают не ранее чем через 20 суток после замоноличивания: сначала подают воду 25 °С и выдерживают 3 суток, затем повышают температуру на 5 °С в сутки (п. 6.4.17).</li><li>Радиаторы перед установкой испытывают пробным давлением 1,5 МПа гидравлически или 0,1 МПа пузырьковым способом (п. 5.2 ТКП).</li><li>Подводки длиной до 500 мм ставят без уклона, при 500–600 мм перепад 5 мм, при большей длине 10 мм (п. 6.4.1).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. Пункты 6.4.17 и 6.4.19 (уклоны 0,002 и 0,006) прочитаны по выборке; к какой трубе относится каждое значение, проверяют по полному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-montazh.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-ot-montazh.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-ventilyaciya\"><summary><span class=\"q-sh\"><b>Вентиляция</b><small>Воздухообмен, оборудование и венткамеры, воздуховоды, монтаж.</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#ov-vent-vozdukh\">Воздухообмен и расход наружного воздуха</a><a href=\"#ov-vent-sistemy\">Системы вентиляции: оборудование и помещения для него</a><a href=\"#ov-vent-vozdukhovody\">Воздуховоды: материалы, герметичность, противопожарные клапаны</a><a href=\"#ov-vent-montazh\">Монтаж вентиляции и кондиционирования</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"ov-vent-vozdukh\"><header><h3>Воздухообмен и расход наружного воздуха</h3><p>Минимальный расход наружного воздуха по назначению помещений, избыточное давление в тамбурах-шлюзах, места удаления воздуха.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, п. 7.4.2, 7.4.3, 7.5.3, 7.5.10, 7.5.11, прил. П, табл. П.1</div></header><div class=\"q-facts\"><div><b>3 м³/ч</b><span>наружный воздух на 1 м² жилых помещений</span></div><div><b>30 / 20 м³/ч</b><span>на человека в производственных помещениях с проветриванием</span></div><div><b>60 м³/ч</b><span>на человека без проветривания</span></div><div><b>20 Па</b><span>избыточное давление в тамбуре-шлюзе</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Жилые помещения: на 1 м² жилых помещений, м³/ч</td><td class=\"n m\">3</td></tr><tr><td>Жилые помещения без людей: общий обмен, не менее, раз в час</td><td class=\"n m\">0,5</td></tr><tr><td>Производственные с проветриванием: объём на человека менее 20 м³, м³/ч на человека</td><td class=\"n m\">30</td></tr><tr><td>То же при объёме 20 м³ на человека и более, м³/ч на человека</td><td class=\"n m\">20</td></tr><tr><td>Производственные без проветривания, м³/ч на человека</td><td class=\"n m\">60</td></tr><tr><td>Общественные, административные, бытовые без проветривания, м³/ч на человека</td><td class=\"n m\">60</td></tr><tr><td>Залы, где люди находятся до 3 ч непрерывно, м³/ч на человека</td><td class=\"n m\">20</td></tr><tr><td>Подача воздуха в тамбур-шлюз, не менее, м³/ч</td><td class=\"n m\">250</td></tr><tr><td>Избыточное давление в тамбуре-шлюзе при закрытых дверях, Па</td><td class=\"n m\">20</td></tr><tr><td>Разность давления тамбура-шлюза и помещения, не более, Па</td><td class=\"n m\">50</td></tr><tr><td>Дисбаланс без тамбура-шлюза: избыточное давление, не менее, Па</td><td class=\"n m\">10</td></tr><tr><td>То же, не менее на каждую дверь, м³/ч</td><td class=\"n m\">100</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Расход наружного воздуха определяют по воздуху, удаляемому вытяжкой и технологическим оборудованием, с учётом нормируемого дисбаланса, но не меньше значений прил. П (п. 7.4.2).</li><li>Вытяжные отверстия для удаления тепла, влаги и вредных газов из верхней зоны размещают под потолком, но не ниже 2 м от пола до низа отверстий (п. 7.5.10 а).</li><li>Из нижней зоны воздух удаляют на уровне до 0,3 м от пола до низа отверстий (п. 7.5.11).</li><li>Для кондиционируемых помещений без вредных и взрывоопасных выделений предусматривают положительный дисбаланс (п. 7.5.3).</li><li>Рециркуляция ограничивается пределами одной квартиры, номера гостиницы или дома одной семьи (п. 7.4.7). Не допускается из помещений категорий А и Б, из тамбуров-шлюзов и из систем местных отсосов вредных веществ (п. 7.4.6).</li><li>Производственные помещения, приточные системы с рециркуляцией при кратности менее 10 обменов в час: наружный воздух не менее 20 % общего воздухообмена при 60 м³/ч на человека, 15 % при 90 м³/ч, 10 % при 120 м³/ч (табл. П.1).</li><li>Для общественных, административных и бытовых зданий расход определяют по требованиям соответствующих технических нормативных правовых актов (табл. П.1).</li></ul></div><p class=\"e-note\">Строки таблицы П.1 про рециркуляцию в выборке читаются неоднозначно, порядок значений проверяют по официальному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-vozdukh.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-vozdukh.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vent-sistemy\"><header><h3>Системы вентиляции: оборудование и помещения для него</h3><p>Резервирование установок, объединение систем, высота и проходы в венткамерах, воздухообмен в них.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, п. 7.2.5, 7.2.13, 7.3.4, 7.8.2, 7.8.5, 7.8.8, 7.10.7–7.10.11</div></header><div class=\"q-facts\"><div><b>50 %</b><span>расход каждой из двух установок от требуемого воздухообмена</span></div><div><b>200 м²</b><span>наибольшая площадь присоединяемой группы помещений</span></div><div><b>≥ 1,8 м</b><span>высота венткамеры до низа выступающих конструкций</span></div><div><b>≥ 0,7 м</b><span>ширина прохода между оборудованием и конструкциями</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Расход каждой из двух приточных и двух вытяжных установок, не менее, % требуемого воздухообмена</td><td class=\"n m\">50</td></tr><tr><td>Площадь присоединяемой к системе группы помещений другого назначения, не более, м²</td><td class=\"n m\">200</td></tr><tr><td>Расстояние между приёмными устройствами наружного воздуха смежных пожарных отсеков, не менее, м</td><td class=\"n m\">3</td></tr><tr><td>Скорость воды в трубках воздухонагревателя без смесительных насосов, не менее, м/с</td><td class=\"n m\">0,12</td></tr><tr><td>Превышение теплового потока воздухонагревателя над расчётным, не более, %</td><td class=\"n m\">10</td></tr><tr><td>Конденсатоотводчики ниже патрубков воздухонагревателя, не менее, мм</td><td class=\"n m\">300</td></tr><tr><td>Высота венткамеры больше высоты оборудования, как правило, на, м</td><td class=\"n m\">0,8</td></tr><tr><td>Высота венткамеры до низа выступающих конструкций, не менее, м</td><td class=\"n m\">1,8</td></tr><tr><td>Проход между оборудованием и конструкциями, не менее, м</td><td class=\"n m\">0,7</td></tr><tr><td>То же с необслуживаемой стороны, не менее, м</td><td class=\"n m\">0,5</td></tr><tr><td>Воздухообмен в венткамере вытяжных систем, не менее, раз в час</td><td class=\"n m\">1</td></tr><tr><td>Воздухообмен в венткамере приточных систем, не менее, раз в час</td><td class=\"n m\">2</td></tr><tr><td>Грузоподъёмные машины для оборудования массой единицы более, кг</td><td class=\"n m\">50</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Системы кондиционирования и общеобменной вентиляции для помещений с постоянным пребыванием людей без естественного проветривания выполняют с резервными вентиляторами или двигателями либо двумя приточными и двумя вытяжными установками (п. 7.2.5).</li><li>Системы вентиляции жилых помещений выполняют отдельными от систем других групп помещений (п. 7.2.12).</li><li>Системы воздушного отопления без других систем отопления предусматривают с резервом: вентиляторы, насосы воздухонагревателей или не менее двух агрегатов на помещение (п. 7.2.4).</li><li>Через венткамеру не прокладывают трубы с легковоспламеняющимися и горючими жидкостями и газами. Канализационные трубы через камеры приточных систем не прокладывают, кроме ливневых и труб сбора воды из вышележащих венткамер (п. 7.10.10).</li><li>Защитные ограждения ставят на всасывающих и нагнетательных отверстиях вентиляторов, не присоединённых к воздуховодам. На вытяжке в помещениях с газовыми приборами ставят решётки, которые нельзя закрыть полностью (п. 7.8.5, 7.8.8).</li><li>Помещения для вентиляционного оборудования размещают в пределах пожарного отсека обслуживаемых помещений (п. 7.10.5).</li></ul></div><p class=\"e-note\">Для помещений категорий А и Б и производственных зданий действуют дополнительные требования раздела 7. Карточка охватывает общие условия.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-sistemy.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-sistemy.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vent-vozdukhovody\"><header><h3>Воздуховоды: материалы, герметичность, противопожарные клапаны</h3><p>Класс герметичности, негорючие воздуховоды, гибкие вставки, клапаны на перекрытиях и шахты для транзита.</p><div class=\"q-src\">Источник: СН 4.02.03-2019, п. 7.11.1–7.11.11, табл. 7.1 (с изм. № 2)</div></header><div class=\"q-facts\"><div><b>класс В</b><span>герметичность транзитных воздуховодов и коллекторов</span></div><div><b>класс А</b><span>герметичность остальных воздуховодов</span></div><div><b>80 °С</b><span>от этой температуры воздуха воздуховоды только из негорючих материалов</span></div><div><b>EI 30</b><span>предел огнестойкости шахты, кожуха или гильзы для транзита</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Транзитные участки, коллекторы, шахты: класс герметичности</td><td class=\"n m\">В</td></tr><tr><td>Прочие воздуховоды: класс герметичности</td><td class=\"n m\">А</td></tr><tr><td>Перепад давления воздуховод/помещение 1000–2000 Па: класс герметичности</td><td class=\"n m\">С</td></tr><tr><td>Температура воздуха, от которой воздуховоды только из негорючих материалов, °С</td><td class=\"n m\">80</td></tr><tr><td>Окраска или плёнка для защиты от коррозии: толщина не более, мм</td><td class=\"n m\">0,5</td></tr><tr><td>Гибкие вставки и отводы Г2 в помещениях категории Д: доля длины воздуховодов группы Г1, не более, %</td><td class=\"n m\">10</td></tr><tr><td>То же, доля длины негорючих воздуховодов, не более, %</td><td class=\"n m\">5</td></tr><tr><td>Шахта, кожух или гильза для транзита из горючих материалов: предел огнестойкости не менее</td><td class=\"n m\">EI 30</td></tr><tr><td>Общая шахта для стальных транзитных воздуховодов толщиной 1 мм: предел огнестойкости не менее</td><td class=\"n m\">EI 30</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Противопожарные клапаны ставят там, где коллектор пересекает междуэтажные перекрытия, и где воздуховоды пересекают противопожарные преграды. Исключения: кухни в жилых зданиях, санузлы, умывальные и душевые (п. 7.11.1).</li><li>Воздушные затворы на поэтажных воздуховодах ставят в жилых и общественных зданиях при присоединении к коллектору. В санузлах, умывальных и душевых воздушные затворы не предусматривают (п. 7.11.1).</li><li>Воздуховоды только из негорючих материалов: местные отсосы взрывоопасных и пожароопасных смесей, аварийная вентиляция, транзитные участки и коллекторы, венткамеры, технические этажи, чердаки и подвалы (п. 7.11.4).</li><li>Воздуховоды из материалов группы Г1 допускаются в одноэтажных зданиях, за исключением помещений категорий А, Б, В1–В3, с пожарной нагрузкой более 2000 МДж и с массовым пребыванием людей (п. 7.11.5).</li><li>Предел огнестойкости транзитных воздуховодов за пределами обслуживаемого этажа и в разных помещениях принимают по таблице 7.1. Через жилые комнаты транзит запрещён (табл. 7.1, сноска).</li><li>Изменение № 2 распространяет п. 7.11.9 на здания I–IV степеней огнестойкости, а п. 7.11.10 — на категории Г1 и Г2.</li></ul></div><p class=\"e-note\">Сама таблица 7.1 в выборке читается неоднозначно (числитель и знаменатель по этажам, значения НД и НН), поэтому цифры предела огнестойкости здесь не приводятся. Их берут из официального текста.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-vozdukhovody.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-vozdukhovody.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-vent-montazh\"><header><h3>Монтаж вентиляции и кондиционирования</h3><p>Изготовление воздуховодов, шаг креплений, прокладки, вентиляторы и клапаны.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 5.3, 6.5</div></header><div class=\"q-facts\"><div><b>4 м / 3 м</b><span>шаг креплений бесфланцевых воздуховодов размером до 400 мм / от 400 мм</span></div><div><b>6 м</b><span>шаг креплений фланцевых воздуховодов размером до 2000 мм</span></div><div><b>≤ 1 %</b><span>зазор между колесом и корпусом вентилятора от диаметра колеса</span></div><div><b>± 0,5 мм/м</b><span>горизонтальность вала вентилятора</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Шаг креплений бесфланцевых воздуховодов размером до 400 мм, не более, м</td><td class=\"n m\">4</td></tr><tr><td>То же размером 400 мм и более, не более, м</td><td class=\"n m\">3</td></tr><tr><td>Шаг креплений фланцевых воздуховодов размером до 2000 мм, не более, м</td><td class=\"n m\">6</td></tr><tr><td>Шаг креплений вертикальных воздуховодов, не более, м</td><td class=\"n m\">4</td></tr><tr><td>Полимерные воздуховоды: подвески горизонтальных, не более, м</td><td class=\"n m\">2,5</td></tr><tr><td>Полимерные воздуховоды: подвески вертикальных, не более, м</td><td class=\"n m\">3</td></tr><tr><td>Прокладки между фланцами полимерных воздуховодов, мм</td><td class=\"n m\">3–5</td></tr><tr><td>Уплотнитель фланцев из резины при температуре воздуха до 70 °С, мм</td><td class=\"n m\">4–5</td></tr><tr><td>Зазор между колесом и корпусом вентилятора, не более, % диаметра колеса</td><td class=\"n m\">1</td></tr><tr><td>Отклонение вала вентилятора, мм на 1 м</td><td class=\"n m\">±0,5</td></tr><tr><td>Шаг зигов при стороне воздуховода более 400 мм, мм</td><td class=\"n m\">200–300</td></tr><tr><td>Рамки жёсткости при стороне воздуховода более, мм</td><td class=\"n m\">1000</td></tr><tr><td>Заклёпки Ø4–5 мм: шаг, мм</td><td class=\"n m\">200–250</td></tr><tr><td>Заклёпок на соединение, не менее</td><td class=\"n m\">4</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Запорно-регулирующие устройства после монтажа оставляют в положении «Открыто» (п. 6.5.24).</li><li>Горизонтальные бесфланцевые воздуховоды размером до 400 мм крепят не реже чем через 4 м, размером 400 мм и более — через 3 м. Вертикальные — не реже чем через 4 м (п. 6.5).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. Карточка собрана из выборок п. 5.3 и 6.5. Подробный порядок монтажа вентиляторов, клапанов и приёмки систем смотрят в полном тексте.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-montazh.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-vent-montazh.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-inzh-obshchie\"><summary><span class=\"q-sh\"><b>Общее для инженерных систем</b><small>Шаг креплений труб, отверстия и борозды, заготовка труб. Числа по ТКП 45-1.03-85 (заменён СП 1.03.02-2020).</small></span><span class=\"q-n\">4</span></summary><div class=\"e-sub q-chips\"><a href=\"#ov-kreplenie-stal\">Шаг креплений стальных труб и расстояния до конструкций</a><a href=\"#ov-kreplenie-polimer\">Шаг креплений полимерных и металлополимерных труб</a><a href=\"#ov-otverstiya\">Отверстия и борозды для прокладки труб и воздуховодов</a><a href=\"#ov-zagotovka\">Заготовка труб, гибка, сварка полимерных труб и испытания узлов</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"ov-kreplenie-stal\"><header><h3>Шаг креплений стальных труб и расстояния до конструкций</h3><p>Наибольшее расстояние между опорами металлических труб по диаметру и расстояния в свету от изоляции до стен, пола и перекрытий.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, прил. Б, табл. Б.1, Б.4</div></header><div class=\"q-facts\"><div><b>2,5 м</b><span>труба Dу 15 неизолированная</span></div><div><b>6,0 м</b><span>труба Dу 70–100 неизолированная</span></div><div><b>8,0 м</b><span>труба Dу 150 неизолированная</span></div><div><b>± 20 мм</b><span>допуск расстояний по табл. Б.4</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(м)</span></th><th class=\"n\">Неизолированные</th><th class=\"n\">Изолированные</th></tr></thead><tbody><tr><td>Dу 15</td><td class=\"n m\">2,5</td><td class=\"n m\">1,5</td></tr><tr><td>Dу 20</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>Dу 25</td><td class=\"n m\">3,5</td><td class=\"n m\">2</td></tr><tr><td>Dу 32</td><td class=\"n m\">4</td><td class=\"n m\">2,5</td></tr><tr><td>Dу 40</td><td class=\"n m\">4,5</td><td class=\"n m\">3</td></tr><tr><td>Dу 50</td><td class=\"n m\">5</td><td class=\"n m\">3</td></tr><tr><td>Dу 70</td><td class=\"n m\">6</td><td class=\"n m\">4</td></tr><tr><td>Dу 80</td><td class=\"n m\">6</td><td class=\"n m\">4</td></tr><tr><td>Dу 100</td><td class=\"n m\">6</td><td class=\"n m\">4,5</td></tr><tr><td>Dу 125</td><td class=\"n m\">7</td><td class=\"n m\">5</td></tr><tr><td>Dу 150</td><td class=\"n m\">8</td><td class=\"n m\">6</td></tr></tbody></table></div><h4 class=\"q-h4\">Расстояние в свету от поверхности изоляции, мм (табл. Б.4)</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">До стены</th><th class=\"n\">До пола</th><th class=\"n\">До перекрытия</th><th class=\"n\">Между смежными по вертикали</th><th class=\"n\">Между смежными по горизонтали</th></tr></thead><tbody><tr><td>Dу 25–80</td><td class=\"n m\">150</td><td class=\"n m\">100</td><td class=\"n m\">150</td><td class=\"n m\">100</td><td class=\"n m\">100</td></tr><tr><td>Dу 100–250</td><td class=\"n m\">170</td><td class=\"n m\">100</td><td class=\"n m\">200</td><td class=\"n m\">140</td><td class=\"n m\">140</td></tr><tr><td>Dу 300–350</td><td class=\"n m\">200</td><td class=\"n m\">120</td><td class=\"n m\">200</td><td class=\"n m\">160</td><td class=\"n m\">160</td></tr><tr><td>Dу 400–450</td><td class=\"n m\">200</td><td class=\"n m\">120</td><td class=\"n m\">200</td><td class=\"n m\">160</td><td class=\"n m\">200</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 15</text><rect x=\"220\" y=\"6\" width=\"106.2\" height=\"22\" fill=\"#1d1f23\"/><text x=\"334.25\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2,5 м</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 25</text><rect x=\"220\" y=\"40\" width=\"148.8\" height=\"22\" fill=\"#1d1f23\"/><text x=\"376.75\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3,5 м</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 50</text><rect x=\"220\" y=\"74\" width=\"212.5\" height=\"22\" fill=\"#1d1f23\"/><text x=\"440.5\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 м</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 100</text><rect x=\"220\" y=\"108\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">6 м</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Dу 150</text><rect x=\"220\" y=\"142\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">8 м</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Расстояния Б.1 — наибольшие между опорами металлических труб. Для вертикальных стальных труб при высоте этажа более 3 м добавляют крепление на половине этажа (п. 6.1.5).</li><li>Допускаемое отклонение расстояний по таблице Б.4 — ±20 мм (прил. Б).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. Таблица Б.1 относится к металлическим трубам, значения даны по выборке и сверяются с официальным текстом.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kreplenie-stal.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kreplenie-stal.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-kreplenie-polimer\"><header><h3>Шаг креплений полимерных и металлополимерных труб</h3><p>Наибольшее расстояние между опорами по наружному диаметру, горизонтальные и вертикальные участки.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, прил. Б, табл. Б.2, Б.3</div></header><div class=\"q-facts\"><div><b>500 мм</b><span>труба 16–20 мм неизолированная полимерная</span></div><div><b>1200 мм</b><span>металлополимерная 25 мм, вертикально</span></div><div><b>3000 мм</b><span>металлополимерная 50 мм, вертикально</span></div><div><b>1200 мм</b><span>полимерная 90 мм, неизолированная</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Диаметр 16 и 20 мм</td><td class=\"n m\">500</td></tr><tr><td>Диаметр 25 и 32 мм</td><td class=\"n m\">600</td></tr><tr><td>Диаметр 40 мм</td><td class=\"n m\">750</td></tr><tr><td>Диаметр 50 мм</td><td class=\"n m\">900</td></tr><tr><td>Диаметр 63 мм</td><td class=\"n m\">1000</td></tr><tr><td>Диаметр 75 мм</td><td class=\"n m\">1100</td></tr><tr><td>Диаметр 90 мм</td><td class=\"n m\">1200</td></tr></tbody></table></div><h4 class=\"q-h4\">Металлополимерные трубы (табл. Б.3)</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Горизонтальные</th><th class=\"n\">Вертикальные</th></tr></thead><tbody><tr><td>До 16 мм</td><td class=\"n m\">500</td><td class=\"n m\">1000</td></tr><tr><td>20 мм</td><td class=\"n m\">500</td><td class=\"n m\">1000</td></tr><tr><td>25 мм</td><td class=\"n m\">750</td><td class=\"n m\">1200</td></tr><tr><td>32 мм</td><td class=\"n m\">1000</td><td class=\"n m\">2400</td></tr><tr><td>40 мм</td><td class=\"n m\">1000</td><td class=\"n m\">2400</td></tr><tr><td>50 мм</td><td class=\"n m\">1000</td><td class=\"n m\">3000</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ø16–20 мм</text><rect x=\"220\" y=\"6\" width=\"141.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"369.66666666666663\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">500 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ø25–32 мм</text><rect x=\"220\" y=\"40\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">600 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ø50 мм</text><rect x=\"220\" y=\"74\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">900 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Nunito, Arial, sans-serif\">Ø90 мм</text><rect x=\"220\" y=\"108\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1200 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Таблица Б.2 относится к неизолированным полимерным трубам, таблица Б.3 — к металлополимерным (прил. Б).</li><li>Шаг креплений вертикальных полимерных канализационных труб: до 1000 мм при диаметре до 32 мм и до 1500 мм при большем диаметре (п. 6.1.5).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. Расстояния приведены по прил. Б ТКП 45-1.03-85. Для изолированных и тёплых трубопроводов шаг может быть меньше, его принимают по проекту и данным изготовителя.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kreplenie-polimer.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-kreplenie-polimer.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-otverstiya\"><header><h3>Отверстия и борозды для прокладки труб и воздуховодов</h3><p>Размеры отверстий в стенах и перекрытиях и борозд в стенах под стояки, подводки, магистрали.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, прил. А, табл. А.1</div></header><div class=\"q-facts\"><div><b>100 × 100</b><span>отверстие под один стояк отопления или водопровода</span></div><div><b>130 × 130</b><span>борозда под один стояк</span></div><div><b>D + 150</b><span>отверстие под воздуховод</span></div><div><b>≥ 400 × 400</b><span>ввод и выпуск</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Отверстие</th><th class=\"n\">Борозда</th></tr></thead><tbody><tr><td>Стояк однотрубной системы отопления</td><td class=\"n m\">100 × 100</td><td class=\"n m\">130 × 130</td></tr><tr><td>Два стояка двухтрубной системы отопления</td><td class=\"n m\">150 × 100</td><td class=\"n m\">200 × 130</td></tr><tr><td>Подводка к отопительным приборам</td><td class=\"n m\">100 × 100</td><td class=\"n m\">60 × 60</td></tr><tr><td>Главный стояк</td><td class=\"n m\">200 × 200</td><td class=\"n m\">200 × 200</td></tr><tr><td>Один водопроводный стояк</td><td class=\"n m\">100 × 100</td><td class=\"n m\">130 × 130</td></tr><tr><td>Два водопроводных стояка</td><td class=\"n m\">200 × 100</td><td class=\"n m\">200 × 130</td></tr><tr><td>Водопроводный стояк и канализационный Ø50</td><td class=\"n m\">250 × 150</td><td class=\"n m\">250 × 130</td></tr><tr><td>Водопроводный стояк и канализационный Ø100–150</td><td class=\"n m\">350 × 200</td><td class=\"n m\">350 × 200</td></tr><tr><td>Канализационный стояк Ø50</td><td class=\"n m\">150 × 150</td><td class=\"n m\">200 × 130</td></tr><tr><td>Канализационный стояк Ø100–150</td><td class=\"n m\">200 × 200</td><td class=\"n m\">250 × 250</td></tr><tr><td>Два водопроводных и канализационный Ø50</td><td class=\"n m\">320 × 150</td><td class=\"n m\">300 × 130</td></tr><tr><td>Два водопроводных и канализационный Ø100–150</td><td class=\"n m\">350 × 200</td><td class=\"n m\">380 × 250</td></tr><tr><td>Три водопроводных и канализационный Ø50</td><td class=\"n m\">450 × 150</td><td class=\"n m\">350 × 130</td></tr><tr><td>Три водопроводных и канализационный Ø100–150</td><td class=\"n m\">500 × 200</td><td class=\"n m\">480 × 250</td></tr><tr><td>Водопроводная подводка</td><td class=\"n m\">100 × 100</td><td class=\"n m\">60 × 60</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Отверстие под воздуховод — размер воздуховода плюс 150 мм (D + 150).</li><li>Отверстия для ввода и выпуска — не менее 400 × 400 мм.</li><li>Для двух подводок водопровода размеры отверстия увеличены до 100 × 200 мм.</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. Размеры даны в мм, порядок «ширина × высота» принят по выборке. Значения в скобках из таблицы (например, «300» у позиции с двумя водопроводными стояками) в карточку не вынесены, их сверяют по официальному тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-otverstiya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-otverstiya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-zagotovka\"><header><h3>Заготовка труб, гибка, сварка полимерных труб и испытания узлов</h3><p>Допуски на заготовку стальных труб, радиус гиба, сварка полимерных труб, пробное давление.</p><div class=\"q-src\">Источник: ТКП 45-1.03-85-2007, п. 5.2, табл. 1</div></header><div class=\"q-facts\"><div><b>± 2 мм</b><span>длина заготовки до 1 м</span></div><div><b>2,5 Dн / 3,5 Dн</b><span>наименьший радиус гиба стальной трубы Dу до 40 / от 50</span></div><div><b>≤ 10 %</b><span>овальность гиба и смещение кромок при сварке</span></div><div><b>1,5 Ру</b><span>пробное давление узла</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Перпендикулярность торцов к оси, не более, градусов</td><td class=\"n m\">2</td></tr><tr><td>Длина заготовки до 1 м, мм</td><td class=\"n m\">±2</td></tr><tr><td>Добавка на каждый следующий метр, мм</td><td class=\"n m\">±1</td></tr><tr><td>Овальность гиба, не более, %</td><td class=\"n m\">10</td></tr><tr><td>Радиус гиба стальных труб Dу до 40 мм, не менее, Dн</td><td class=\"n m\">2,5</td></tr><tr><td>Радиус гиба стальных труб Dу 50 мм и более, не менее, Dн</td><td class=\"n m\">3,5</td></tr><tr><td>Нитки с неполной резьбой, не более, %</td><td class=\"n m\">10</td></tr><tr><td>Заусенцы, не более, мм</td><td class=\"n m\">0,1</td></tr><tr><td>Радиус гиба полиэтиленовых труб, не менее, диаметров</td><td class=\"n m\">5</td></tr><tr><td>Радиус гиба полипропиленовых труб, не менее, диаметров</td><td class=\"n m\">8</td></tr><tr><td>Смещение кромок при сварке полимерных труб, не более, % толщины стенки</td><td class=\"n m\">10</td></tr><tr><td>Усиление шва при стенке менее 10 мм, не более, мм</td><td class=\"n m\">2,5</td></tr><tr><td>Усиление шва при большей стенке, мм</td><td class=\"n m\">3–4</td></tr></tbody></table></div><h4 class=\"q-h4\">Испытания</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Узлы водо- и теплоснабжения, гидравлически: давление / выдержка</td><td class=\"n m\">1,5 Ру / 3 мин</td></tr><tr><td>Узлы, пузырьковым способом: давление / выдержка</td><td class=\"n m\">0,15 МПа / 30 с</td></tr><tr><td>Стальная канализация: давление / выдержка</td><td class=\"n m\">0,2 МПа / 3 мин</td></tr><tr><td>Радиаторы: гидравлически</td><td class=\"n m\">1,5 МПа</td></tr><tr><td>Радиаторы: пузырьковым способом</td><td class=\"n m\">0,1 МПа</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Длина резьбы: короткой допускается на 10 % меньше, длинной — на 5 мм больше (табл. 1).</li><li>Чугунные канализационные трубы: перпендикулярность торцов 5°, трещины длиной не более 15 мм, волнистость не более 10 мм, размеры узлов ±10 мм (п. 5.2).</li><li>Воздуховоды: зиги шагом 200–300 мм при стороне более 400 мм, рамки жёсткости при стороне более 1000 мм (п. 5.3).</li></ul></div><p class=\"e-note\">Внимание: ТКП 45-1.03-85-2007 не применяется с 23.08.2020, его заменил СП 1.03.02-2020 «Монтаж внутренних инженерных систем зданий и сооружений». Текст СП платный, в материалах сайта его нет. Числа взяты из прежнего ТКП и перед использованием сверяются с СП 1.03.02-2020. Проект Изменения № 1 к СП меняет только формулировки («следует выполнять» на «выполняют») и ссылки, значения в рассмотренных пунктах не меняет. Dн — наружный диаметр, Dу — условный проход, Ру — условное давление. Значения ТКП 45-1.03-85 (табл. 1) сверяют по официальному тексту, особенно допуск резьбы.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-zagotovka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-zagotovka.pdf\" download>Документ PDF</a></div></article></div></details><details class=\"q-sec\" id=\"sec-ispytaniya\"><summary><span class=\"q-sh\"><b>Испытания трубопроводов</b><small>Гидравлический и манометрический методы для систем целиком: давление, выдержка, критерии годности (по проектам СП 4.01.08 и СП 4.02.08).</small></span><span class=\"q-n\">2</span></summary><div class=\"e-sub q-chips\"><a href=\"#ov-isp-gidro\">Гидравлическое испытание систем: давление, выдержка, критерии</a><a href=\"#ov-isp-manometr\">Манометрическое (воздушное) испытание систем: давление, выдержка, критерии</a></div><div class=\"q-list\"><article class=\"q-card\" id=\"ov-isp-gidro\"><header><h3>Гидравлическое испытание систем: давление, выдержка, критерии</h3><p>Испытание водой систем ХВС, ГВС, отопления, канализации и водостоков: условия, давление, выдержка, годность.</p><div class=\"q-src\">Источник: СП 4.01.08-2024 (проект, 1-я ред.), прил. Г, К, Л · СП 4.02.08-2024 (проект, 1-я ред.), прил. В · ТКП 45-1.03-85-2007, п. 5.2.1.10–5.2.1.14 (узлы)</div></header><div class=\"q-facts\"><div><b>1,5 раб.</b><span>пробное давление ХВС и ГВС, выдержка не менее 10 мин</span></div><div><b>0,20 МПа</b><span>водяное отопление в нижней точке системы</span></div><div><b>≥ 1 МПа</b><span>панельное отопление и обогрев пола</span></div><div><b>≥ 5 °С</b><span>температура воздуха и воды при испытании</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>ХВС и ГВС: пробное избыточное давление воды, не менее</td><td class=\"n m\">1,5 раб.</td></tr><tr><td>ХВС и ГВС: выдержка под давлением, не менее, мин</td><td class=\"n m\">10</td></tr><tr><td>Отопление водяное: избыточное давление в нижней точке, МПа</td><td class=\"n m\">0,2</td></tr><tr><td>Отопление панельное и обогрев пола: избыточное давление, не менее, МПа</td><td class=\"n m\">1</td></tr><tr><td>Отопление паровое с рабочим давлением до 0,07 МПа: давление, не менее, МПа</td><td class=\"n m\">0,25</td></tr><tr><td>Отопление: выдержка под давлением, не менее, мин</td><td class=\"n m\">10</td></tr><tr><td>Полимерные трубы: предварительное испытание (набор давления), не менее, мин</td><td class=\"n m\">30</td></tr><tr><td>Полимерные трубы: окончательное испытание, ч</td><td class=\"n m\">2</td></tr><tr><td>Полимерные трубы: начало испытания после последнего клеевого соединения, не ранее, ч</td><td class=\"n m\">24</td></tr><tr><td>Полимерные трубы: начало испытания после последнего сварного соединения, не ранее, ч</td><td class=\"n m\">2</td></tr><tr><td>Температура воздуха и воды, не ниже, °С</td><td class=\"n m\">5</td></tr><tr><td>Канализация (пролив): одновременно открыто водоразборной арматуры, %</td><td class=\"n m\">75</td></tr><tr><td>Водостоки и отводные трубопроводы канализации: выдержка, не менее, мин</td><td class=\"n m\">10</td></tr><tr><td>Класс точности манометра, не хуже</td><td class=\"n m\">1,5</td></tr></tbody></table></div><h4 class=\"q-h4\">Узлы и приборы на заготовке (ТКП 45-1.03-85-2007, не применяется)</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Пробное давление узлов отопления, ХВС и ГВС</td><td class=\"n m\">1,5 Ру</td></tr><tr><td>Выдержка узла под давлением, не менее, мин</td><td class=\"n m\">3</td></tr><tr><td>Стальные узлы канализации и водостоков, МПа</td><td class=\"n m\">0,2</td></tr><tr><td>Чугунные радиаторы, блоки ребристых труб, блоки конвекторов, МПа</td><td class=\"n m\">1,5</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Гидравлическое испытание проводят после сварки стыков, монтажа запорной и регулирующей арматуры, промывки или продувки трубопроводов и (для водоснабжения) выполнения тепловой изоляции (п. 4.8–4.9 проектов СП 4.02.08 и 4.01.08).</li><li>Система должна быть без воздуха: при заполнении воздух удаляют через воздуховыпускные устройства. Водоснабжение заполняют питьевой водой, отопление — водой из внутреннего водопровода.</li><li>Водоснабжение: вместо водоразборной арматуры ставят заглушки, вместо счётчиков и фильтров — инвентарные вставки (прил. Г, п. Г.5.2). Отопление отключают от тепловых сетей, котлов и расширительных сосудов стальными заглушками на фланцах (прил. В, п. В.5.2).</li><li>Давление создают в нижней точке системы, где установлен манометр. Допустимое давление не должно превышать испытательное по паспортам приборов, арматуры, счётчиков и труб (п. В.5.1).</li><li>Система выдержала испытание, если за время выдержки давление не падает, а в сварных швах, трубах, резьбовых соединениях и арматуре нет следов воды. Падение считают как разность давления в начале и в конце испытания с точностью 0,01 МПа (п. Г.8, В.8).</li><li>Канализацию проверяют проливом воды: открывают 75 % водоразборной арматуры, осматривают трубы и стыки, течи быть не должно (прил. К). Водостоки наполняют до уровня высшей воронки, отводные трубопроводы в земле и каналах — до уровня пола первого этажа. Выдержка 10 мин, уровень в стояках не понижается (прил. Л).</li><li>Скрытые трубопроводы испытывают до заделки в конструкции, с актом освидетельствования скрытых работ. Результат оформляют актом гидростатического (манометрического) испытания по прил. Ж.</li><li>Отопление перед сдачей промывают водой до отсутствия механических примесей в пробах: пробы объёмом 1 л берут через каждые 15 мин из дренажа на стояках (прил. Б проекта СП 4.02.08).</li></ul></div><p class=\"e-note\">Источник: проекты СП «Контроль качества работ», первая редакция, с пометкой «не подлежит применению до утверждения». Сами СП введены в действие (2024), но утверждённый текст в материалах сайта отсутствует, значения сверяются с ним. В проекте СП 4.02.08 для водяного отопления указаны и 0,20 МПа в нижней точке (п. В.7.1), и 1,5 рабочего давления (п. В.5.1): окончательное значение берут по утверждённому тексту.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-isp-gidro.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-isp-gidro.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"ov-isp-manometr\"><header><h3>Манометрическое (воздушное) испытание систем: давление, выдержка, критерии</h3><p>Испытание воздухом систем ХВС, ГВС и отопления: давление, выдержка 5 мин, допустимое падение, проверка мыльной пеной.</p><div class=\"q-src\">Источник: СП 4.01.08-2024 (проект, 1-я ред.), прил. Д · СП 4.02.08-2024 (проект, 1-я ред.), прил. Г · ТКП 45-1.03-85-2007, п. 5.2.1.10, 5.2.1.12, 5.2.1.14 (узлы)</div></header><div class=\"q-facts\"><div><b>0,1 МПа</b><span>давление воздуха в системе отопления</span></div><div><b>0,15 МПа</b><span>первичное давление воздуха в водоснабжении</span></div><div><b>5 мин</b><span>выдержка под давлением</span></div><div><b>0,01 МПа</b><span>наибольшее допустимое падение давления</span></div></div><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Отопление: избыточное давление воздуха, МПа</td><td class=\"n m\">0,1</td></tr><tr><td>Отопление: выдержка под давлением, не менее, мин</td><td class=\"n m\">5</td></tr><tr><td>Отопление: допустимое падение давления, не более, МПа</td><td class=\"n m\">0,01</td></tr><tr><td>ХВС и ГВС: первичное пробное давление воздуха, МПа</td><td class=\"n m\">0,15</td></tr><tr><td>ХВС и ГВС: повторное пробное давление воздуха, МПа</td><td class=\"n m\">0,1</td></tr><tr><td>ХВС и ГВС: выдержка под давлением, не менее, мин</td><td class=\"n m\">5</td></tr><tr><td>ХВС и ГВС: допустимое падение давления, не более, МПа</td><td class=\"n m\">0,01</td></tr><tr><td>Полимерные трубы: начало испытания после клеевого соединения, не ранее, ч</td><td class=\"n m\">24</td></tr><tr><td>Полимерные трубы: начало испытания после сварного соединения, не ранее, ч</td><td class=\"n m\">2</td></tr><tr><td>Класс точности манометра, не хуже</td><td class=\"n m\">1,5</td></tr></tbody></table></div><h4 class=\"q-h4\">Узлы и приборы на заготовке (ТКП 45-1.03-85-2007, не применяется)</h4><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение</th></tr></thead><tbody><tr><td>Узлы: давление воздуха, в ванне с водой, МПа</td><td class=\"n m\">0,15</td></tr><tr><td>Узлы: выдержка, не менее, с</td><td class=\"n m\">30</td></tr><tr><td>Чугунные радиаторы, блоки ребристых труб и стальных радиаторов, МПа</td><td class=\"n m\">0,1</td></tr><tr><td>Блоки конвекторов, МПа</td><td class=\"n m\">0,15</td></tr></tbody></table></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>В системе создают избыточное давление воздуха в нижней точке, где установлен манометр. Систему отопления отключают от сетей, котлов и расширительных сосудов стальными заглушками, в системе водоснабжения ставят заглушки вместо водоразборной арматуры.</li><li>Резьбовые и сварные соединения покрывают мыльной (пенящейся) массой. Пузырьки воздуха означают негерметичность: давление снижают до атмосферного, дефект устраняют, испытание повторяют (прил. Г, п. Г.7.3–Г.7.5; прил. Д, п. Д.7.2–Д.7.3).</li><li>Система выдержала испытание, если падение давления за 5 мин не больше 0,01 МПа. Падение считают как разность давления в начале и в конце с точностью 0,01 МПа (п. Г.8, Д.8).</li><li>Скрытые трубопроводы испытывают до заделки в конструкции. Результат оформляют актом по прил. Ж.</li><li>После испытания давление воздуха снижают до атмосферного (п. Д.9).</li><li>Узлы и приборы на заготовке испытывают воздухом пузырьковым методом: узел погружают в ванну с водой, выдержал, если пузырьков нет (ТКП, п. 5.2.1.12).</li></ul></div><p class=\"e-note\">Источник: проекты СП «Контроль качества работ», первая редакция, с пометкой «не подлежит применению до утверждения». Сами СП введены в действие (2024), но утверждённый текст в материалах сайта отсутствует, значения сверяются с ним. В проекте СП 4.01.08 для водоснабжения сначала указано давление воздуха 0,15 МПа (п. Д.7.1), а повторное — 0,1 МПа (п. Д.7.3). В проекте СП 4.02.08 температура воздуха записана как «ниже 5 °С» (п. Г.5.1), вероятно опечатка: «не ниже 5 °С».</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-isp-manometr.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/ov-isp-manometr.pdf\" download>Документ PDF</a></div></article></div></details><script src=\"/static/q.js?v=1\"></script><section class=\"e-sec\"><h2>Как проверяют на объекте</h2><div class=\"e-two\"><div class=\"e-card\"><h3>Входной контроль</h3><ul><li>Проверяют документы на материалы: сертификат или декларация соответствия, документ о качестве изготовителя (п. 3.4).</li><li>Проверяют основание: влажность, чистоту, ровность по таблице допусков (п. 3.17, 3.18, табл. 2).</li><li>Проверяют условия: температуру и влажность воздуха (п. 3.14).</li></ul></div><div class=\"e-card\"><h3>Приёмка</h3><ul><li>Сравнивают результат с таблицей допусков для вида отделки из проекта.</li><li>Осматривают поверхность: без пузырей, трещин, пятен, пропусков и следов кисти.</li><li>Измерения и порядок приёмки задают СТБ 1472–1475 и СТБ 1483 (п. 3.9). Недочёты фиксируют списком и устраняют в оговорённый срок.</li></ul></div></div><p class=\"e-note\">Все числа выше изложены по тексту СП 1.03.01-2019 и перед внесением в договор сверяются с официальной редакцией документа специалистом.</p></section>"
}

pattern EstElecTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Электрика</div><h1>Электрические калькуляторы</h1><p class=\"e-lead\">Подбор сечения кабеля с учётом прочности, нагрева и потери напряжения, ток короткого замыкания, заземление, освещение помещений. Результат можно перенести в смету.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\" class=\"on\" aria-current=\"page\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Электрика\"><a href=\"#guide\" data-sub=\"guide\" class=\"art\">Как подобрать кабель</a><a href=\"#cable\" data-sub=\"cable\">Подбор кабеля</a><a href=\"#kz\" data-sub=\"kz\">Ток КЗ</a><a href=\"#ground\" data-sub=\"ground\">Заземление</a><a href=\"#light\" data-sub=\"light\">Освещение</a><a href=\"#apparaty\" data-sub=\"apparaty\">Автоматы и УЗО</a><a href=\"#ref\" data-sub=\"ref\">Справочник</a></div><div class=\"e-elec\" id=\"e-elec\"><section class=\"e-panel\" id=\"guide\" data-panel=\"guide\"><div class=\"e-sech\"><small>01</small><h2>Как подобрать кабель</h2></div><p class=\"e-lead2\">Физика нагрева, токи и способы прокладки, потеря напряжения, механическая защита и марки, типичные ошибки. Затем считайте свою линию на вкладке «Подбор кабеля».</p><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Физика без мистики: кабель — это управляемая тепловая машина</h3></div><p class=\"e-lead2\">Кабель греется током и остывает через изоляцию в окружающую среду. Всё, что называют «подбором сечения», это ответ на три вопроса: <b>сколько тепла выделится</b> (ток и сопротивление), <b>куда оно денется</b> (способ прокладки) и <b>сколько напряжения потеряется по дороге</b> (длина и сечение). Четвёртый вопрос механический: где кабель могут придавить, порвать и согнуть.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 780 284\" role=\"img\" aria-label=\"Гидравлическая аналогия: труба и жила кабеля\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"190\" y=\"20\" font-size=\"14\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"700\">ГИДРАВЛИКА</text><text x=\"570\" y=\"20\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"700\">ЭЛЕКТРИКА</text><rect x=\"30\" y=\"34\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><text x=\"190\" y=\"55\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">труба</text><line x1=\"360\" y1=\"50\" x2=\"410\" y2=\"50\" stroke=\"#7d8089\" stroke-width=\"2\"/><polygon points=\"410,50 401.9,53.9 401.9,46.1\" fill=\"#7d8089\"/><rect x=\"420\" y=\"34\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"1.5\"/><text x=\"580\" y=\"55\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">жила кабеля</text><rect x=\"30\" y=\"74\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><text x=\"190\" y=\"95\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">диаметр трубы</text><line x1=\"360\" y1=\"90\" x2=\"410\" y2=\"90\" stroke=\"#7d8089\" stroke-width=\"2\"/><polygon points=\"410,90 401.9,93.9 401.9,86.1\" fill=\"#7d8089\"/><rect x=\"420\" y=\"74\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"1.5\"/><text x=\"580\" y=\"95\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">сечение S, мм²</text><rect x=\"30\" y=\"114\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><text x=\"190\" y=\"135\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">расход воды, л/мин</text><line x1=\"360\" y1=\"130\" x2=\"410\" y2=\"130\" stroke=\"#7d8089\" stroke-width=\"2\"/><polygon points=\"410,130 401.9,133.9 401.9,126.1\" fill=\"#7d8089\"/><rect x=\"420\" y=\"114\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"1.5\"/><text x=\"580\" y=\"135\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">ток I, ампер</text><rect x=\"30\" y=\"154\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><text x=\"190\" y=\"175\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">напор, бар</text><line x1=\"360\" y1=\"170\" x2=\"410\" y2=\"170\" stroke=\"#7d8089\" stroke-width=\"2\"/><polygon points=\"410,170 401.9,173.9 401.9,166.1\" fill=\"#7d8089\"/><rect x=\"420\" y=\"154\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"1.5\"/><text x=\"580\" y=\"175\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">напряжение U, вольт</text><rect x=\"30\" y=\"194\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><text x=\"190\" y=\"215\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">потери напора по длине</text><line x1=\"360\" y1=\"210\" x2=\"410\" y2=\"210\" stroke=\"#7d8089\" stroke-width=\"2\"/><polygon points=\"410,210 401.9,213.9 401.9,206.1\" fill=\"#7d8089\"/><rect x=\"420\" y=\"194\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"1.5\"/><text x=\"580\" y=\"215\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">потеря напряжения ΔU</text><rect x=\"30\" y=\"234\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><text x=\"190\" y=\"255\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">трение → нагрев трубы</text><line x1=\"360\" y1=\"250\" x2=\"410\" y2=\"250\" stroke=\"#7d8089\" stroke-width=\"2\"/><polygon points=\"410,250 401.9,253.9 401.9,246.1\" fill=\"#7d8089\"/><rect x=\"420\" y=\"234\" width=\"320\" height=\"32\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"1.5\"/><text x=\"580\" y=\"255\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">I²·R → нагрев жилы</text></svg><figcaption>Гидравлическая аналогия — самый быстрый способ понять электрику: те же законы, только вместо воды заряд, вместо трубы жила.</figcaption></figure><div class=\"e-basis\"><b>Четыре формулы, которые держат всю тему</b><p>R = ρ·L / S — сопротивление жилы: медь ρ ≈ 0,0175, алюминий ≈ 0,028 Ом·мм²/м (у алюминия сопротивление в 1,6 раза выше, отсюда разные сечения). P = I²·R — тепло в жиле: удвоили ток, получили вчетверо тепла. ΔU (1 ф) = 2·I·ρ·L·cosφ / S и ΔU (3 ф) = √3·I·ρ·L·cosφ / S — потеря напряжения: растёт с длиной и током, падает с сечением. Значения ρ даны при +20 °С; у нагретой до +70 °С жилы сопротивление примерно на 20–25 % выше, поэтому в граничных случаях берите запас.</p></div><p class=\"e-lead2\"><b>Длительно допустимый ток (I доп)</b> это ток, при котором изоляция в данных условиях теплоотвода нагревается до своего предела: для ПВХ около +70 °С длительно (в таблицах ПУЭ используется +65 °С), для сшитого полиэтилена до +90 °С. Перегрев изоляции старит её в разы быстрее: по практическому правилу +8…10 °С сверх нормы вдвое сокращают срок службы. Поэтому один и тот же кабель держит разные токи: в земле охлаждение лучше, в трубе в стене хуже, а пучок кабелей в одной гофре греет сам себя и требует коэффициент 0,7–0,85.</p><p class=\"e-lead2\"><b>Запоминалка:</b> «Ток рождает тепло, тепло ищет выход, выход даёт прокладка». Из неё следует весь порядок подбора.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 140\" role=\"img\" aria-label=\"Пять шагов подбора кабеля: ток, сечение, автомат, потеря напряжения, механика и марка\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"8\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"20\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">1</text><text x=\"20\" y=\"62\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Ток нагрузки</text><text x=\"20\" y=\"84\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">I = P / (U·cosφ),</text><text x=\"20\" y=\"97\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">3 ф: / (√3·U·cosφ)</text><line x1=\"136\" y1=\"70\" x2=\"154\" y2=\"70\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"154,70 145.9,73.9 145.9,66.1\" fill=\"#9a9ca3\"/><rect x=\"156\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"168\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">2</text><text x=\"168\" y=\"62\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Сечение</text><text x=\"168\" y=\"78\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">по I доп</text><text x=\"168\" y=\"100\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">таблица по способу</text><text x=\"168\" y=\"113\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">прокладки + коэфф.</text><line x1=\"284\" y1=\"70\" x2=\"302\" y2=\"70\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"302,70 293.9,73.9 293.9,66.1\" fill=\"#9a9ca3\"/><rect x=\"304\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"316\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">3</text><text x=\"316\" y=\"62\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Автомат</text><text x=\"316\" y=\"84\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">I расч ≤ I авт ≤</text><text x=\"316\" y=\"97\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">I доп: автомат</text><text x=\"316\" y=\"110\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">бережёт кабель</text><line x1=\"432\" y1=\"70\" x2=\"450\" y2=\"70\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"450,70 441.9,73.9 441.9,66.1\" fill=\"#9a9ca3\"/><rect x=\"452\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"464\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">4</text><text x=\"464\" y=\"62\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Потеря</text><text x=\"464\" y=\"78\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">ΔU ≤ 5 %</text><text x=\"464\" y=\"100\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">длинные линии:</text><text x=\"464\" y=\"113\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">сечение растёт</text><line x1=\"580\" y1=\"70\" x2=\"598\" y2=\"70\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"598,70 589.9,73.9 589.9,66.1\" fill=\"#9a9ca3\"/><rect x=\"600\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"612\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">5</text><text x=\"612\" y=\"62\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Механика,</text><text x=\"612\" y=\"78\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">марка</text><text x=\"612\" y=\"100\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">мин. сечение, броня,</text><text x=\"612\" y=\"113\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">нг-LS / HF / FR</text></svg><figcaption>Пять шагов подбора. Пропуск любого шага — это либо переплата за медь, либо скрытый перегрев.</figcaption></figure></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Ток, сечение и способ прокладки: таблицы и коэффициенты</h3></div><p class=\"e-lead2\">Сначала ток нагрузки: для одной фазы I = P / (U·cosφ) (U = 230 В), для трёх I = P / (√3·U·cosφ) (U = 400 В). Для розеточных и бытовых линий cosφ ≈ 0,95–1, для двигателей и сварки 0,7–0,85: чем ниже cosφ, тем больше ток при той же мощности. Если на линии несколько приборов, суммируйте мощность с коэффициентом одновременности меньше единицы (чайник, плита и стиральная машина редко работают на полную мощность вместе), для одного мощного прибора он равен 1.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 740 392\" role=\"img\" aria-label=\"Длительно допустимый ток меди с ПВХ-изоляцией в зависимости от сечения и способа прокладки\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"64\" y1=\"352.0\" x2=\"664\" y2=\"352.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"356.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0</text><line x1=\"64\" y1=\"313.8421052631579\" x2=\"664\" y2=\"313.8421052631579\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"317.8421052631579\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">25</text><line x1=\"64\" y1=\"275.6842105263158\" x2=\"664\" y2=\"275.6842105263158\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"279.6842105263158\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">50</text><line x1=\"64\" y1=\"237.5263157894737\" x2=\"664\" y2=\"237.5263157894737\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"241.5263157894737\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">75</text><line x1=\"64\" y1=\"199.36842105263156\" x2=\"664\" y2=\"199.36842105263156\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"203.36842105263156\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">100</text><line x1=\"64\" y1=\"161.21052631578945\" x2=\"664\" y2=\"161.21052631578945\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"165.21052631578945\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">125</text><line x1=\"64\" y1=\"123.05263157894737\" x2=\"664\" y2=\"123.05263157894737\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"127.05263157894737\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">150</text><line x1=\"64\" y1=\"84.89473684210526\" x2=\"664\" y2=\"84.89473684210526\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"88.89473684210526\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">175</text><line x1=\"64\" y1=\"336.7368421052632\" x2=\"664\" y2=\"336.7368421052632\" stroke=\"#9a9ca3\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"672\" y=\"340.7368421052632\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">B10</text><line x1=\"64\" y1=\"327.57894736842104\" x2=\"664\" y2=\"327.57894736842104\" stroke=\"#9a9ca3\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"672\" y=\"331.57894736842104\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">C16</text><line x1=\"64\" y1=\"313.8421052631579\" x2=\"664\" y2=\"313.8421052631579\" stroke=\"#9a9ca3\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"672\" y=\"317.8421052631579\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">C25</text><line x1=\"64\" y1=\"303.1578947368421\" x2=\"664\" y2=\"303.1578947368421\" stroke=\"#9a9ca3\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"672\" y=\"307.1578947368421\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">C32</text><line x1=\"64\" y1=\"290.9473684210526\" x2=\"664\" y2=\"290.9473684210526\" stroke=\"#9a9ca3\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"672\" y=\"294.9473684210526\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">C40</text><line x1=\"64\" y1=\"255.8421052631579\" x2=\"664\" y2=\"255.8421052631579\" stroke=\"#9a9ca3\" stroke-width=\"1\" stroke-dasharray=\"2 3\"/><text x=\"672\" y=\"259.8421052631579\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">C63</text><text x=\"94.0\" y=\"370\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">1,5</text><text x=\"161.5\" y=\"370\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">2,5</text><text x=\"229.0\" y=\"370\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">4,0</text><text x=\"296.5\" y=\"370\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">6,0</text><text x=\"364.0\" y=\"370\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">10</text><text x=\"431.5\" y=\"370\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">16</text><text x=\"499.0\" y=\"370\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">25</text><text x=\"566.5\" y=\"370\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">35</text><text x=\"634.0\" y=\"370\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">50</text><text x=\"364.0\" y=\"392\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">сечение меди, мм²</text><text x=\"14\" y=\"18\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">длительно допустимый ток, А</text><polyline points=\"94.0,323.0 161.5,315.4 229.0,303.2 296.5,289.4 364.0,265.0 431.5,236.0 499.0,196.3 566.5,161.2 634.0,121.5\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polygon points=\"94.0,317.5 89.0,327.0 99.0,327.0\" fill=\"#7d8089\"/><polygon points=\"161.5,309.9 156.5,319.4 166.5,319.4\" fill=\"#7d8089\"/><polygon points=\"229.0,297.7 224.0,307.2 234.0,307.2\" fill=\"#7d8089\"/><polygon points=\"296.5,283.9 291.5,293.4 301.5,293.4\" fill=\"#7d8089\"/><polygon points=\"364.0,259.5 359.0,269.0 369.0,269.0\" fill=\"#7d8089\"/><polygon points=\"431.5,230.5 426.5,240.0 436.5,240.0\" fill=\"#7d8089\"/><polygon points=\"499.0,190.8 494.0,200.3 504.0,200.3\" fill=\"#7d8089\"/><polygon points=\"566.5,155.7 561.5,165.2 571.5,165.2\" fill=\"#7d8089\"/><polygon points=\"634.0,116.0 629.0,125.5 639.0,125.5\" fill=\"#7d8089\"/><polyline points=\"94.0,319.9 161.5,310.8 229.0,297.1 296.5,281.8 364.0,255.8 431.5,222.3 499.0,179.5 566.5,139.8 634.0,95.6\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"94.0\" cy=\"319.9\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"161.5\" cy=\"310.8\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"229.0\" cy=\"297.1\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"296.5\" cy=\"281.8\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"364.0\" cy=\"255.8\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"431.5\" cy=\"222.3\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"499.0\" cy=\"179.5\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"566.5\" cy=\"139.8\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"634.0\" cy=\"95.6\" r=\"4.5\" fill=\"#1d1f23\"/><polyline points=\"94.0,310.8 161.5,295.5 229.0,278.7 296.5,263.5 364.0,234.5 431.5,207.0 499.0,162.7 566.5,124.6 634.0,80.3\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><rect x=\"89.5\" y=\"306.3\" width=\"9\" height=\"9\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"157.0\" y=\"291.0\" width=\"9\" height=\"9\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"224.5\" y=\"274.2\" width=\"9\" height=\"9\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"292.0\" y=\"259.0\" width=\"9\" height=\"9\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"359.5\" y=\"230.0\" width=\"9\" height=\"9\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"427.0\" y=\"202.5\" width=\"9\" height=\"9\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"494.5\" y=\"158.2\" width=\"9\" height=\"9\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"562.0\" y=\"120.1\" width=\"9\" height=\"9\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"629.5\" y=\"75.8\" width=\"9\" height=\"9\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"70\" y1=\"38\" x2=\"94\" y2=\"38\" stroke=\"#7d8089\" stroke-width=\"3\"/><text x=\"100\" y=\"42\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">в трубе, гофре, в стене</text><line x1=\"270\" y1=\"38\" x2=\"294\" y2=\"38\" stroke=\"#1d1f23\" stroke-width=\"3\"/><text x=\"300\" y=\"42\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">открыто в воздухе, на лотке</text><line x1=\"470\" y1=\"38\" x2=\"494\" y2=\"38\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"500\" y=\"42\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">в земле (траншея)</text><line x1=\"161.5\" y1=\"181.05263157894737\" x2=\"161.5\" y2=\"287.5263157894737\" stroke=\"#4a4d55\" stroke-width=\"1.2\" stroke-dasharray=\"3 3\"/><text x=\"155.5\" y=\"168.8421052631579\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">2,5 мм²: воздух 27 А, стена 24 А, земля 37 А</text></svg><figcaption>Длительно допустимые токи меди с ПВХ-изоляцией по способу прокладки (справочные значения по таблицам ПУЭ и каталогам производителей, среда +25 °С). Серые пунктирные линии справа — номиналы автоматов: видно, какое сечение «держит» каждый номинал.</figcaption></figure><p class=\"e-note\">Значения в разных источниках отличаются на 5–10 %: ПУЭ, стандарт IEC 60364-5-52 и каталоги производителей по-разному учитывают число нагруженных жил (две в однофазной линии, три в трёхфазной), условия теплоотвода и температуру. Для трёхфазной линии токи примерно на 10–15 % ниже, чем для однофазной. Калькулятор на соседней вкладке считает по методам прокладки IEC и даёт чуть более осторожный результат, чем справочные значения графика.</p><h4 class=\"e-h4\">Поправочные коэффициенты</h4><p class=\"e-lead2\">Поправочные коэффициенты умножаются на табличный I доп (значения справочные, уточняйте по ПУЭ гл. 1.3 и паспорту кабеля):</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Условие</th><th>Коэффициент</th><th>Комментарий</th></tr></thead><tbody><tr><td>Температура среды +35 °С (воздух)</td><td>≈ 0,88</td><td>летний чердак, котельная, южный фасад</td></tr><tr><td>Температура среды +45 °С</td><td>≈ 0,75</td><td>парилки, техпомещения у тепла: отдельный расчёт</td></tr><tr><td>4–6 кабелей в одной трубе или пучке</td><td>0,68–0,82</td><td>взаимный нагрев: чем плотнее пучок, тем ниже ток</td></tr><tr><td>Прокладка в земле, сухой грунт</td><td>0,8–0,9</td><td>сухая песчаная почва отводит тепло хуже влажной</td></tr><tr><td>Прокладка в земле, влажный суглинок</td><td>1,0–1,05</td><td>паспортная тепловая сопротивляемость грунта</td></tr></tbody></table></div><figure class=\"e-fig\"><svg viewBox=\"0 0 700 206\" role=\"img\" aria-label=\"Золотое правило защиты кабеля автоматом: ток нагрузки, номинал автомата, допустимый ток кабеля\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"440\" y=\"20\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Золотое правило: I нагрузки ≤ I автомата ≤ I доп кабеля</text><line x1=\"240.0\" y1=\"34\" x2=\"240.0\" y2=\"170\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"240.0\" y=\"188\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><line x1=\"310.0\" y1=\"34\" x2=\"310.0\" y2=\"170\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"310.0\" y=\"188\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">5</text><line x1=\"380.0\" y1=\"34\" x2=\"380.0\" y2=\"170\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"380.0\" y=\"188\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">10</text><line x1=\"450.0\" y1=\"34\" x2=\"450.0\" y2=\"170\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"450.0\" y=\"188\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">15</text><line x1=\"520.0\" y1=\"34\" x2=\"520.0\" y2=\"170\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"520.0\" y=\"188\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><line x1=\"590.0\" y1=\"34\" x2=\"590.0\" y2=\"170\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"590.0\" y=\"188\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">25</text><line x1=\"660.0\" y1=\"34\" x2=\"660.0\" y2=\"170\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"660.0\" y=\"188\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">30</text><text x=\"230\" y=\"64\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Расчётный ток нагрузки</text><rect x=\"240\" y=\"42\" width=\"182.0\" height=\"30\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"430.0\" y=\"64\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">13 А</text><text x=\"230\" y=\"106\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Номинал автомата C16</text><rect x=\"240\" y=\"84\" width=\"224.0\" height=\"30\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"472.0\" y=\"106\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">16 А</text><text x=\"230\" y=\"148\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">I доп кабеля 2,5 мм² в стене</text><rect x=\"240\" y=\"126\" width=\"336.0\" height=\"30\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"584.0\" y=\"148\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">24 А</text></svg><figcaption>Цепочка защиты: автомат стоит между нагрузкой и кабелем и обязан сработать раньше, чем кабель перегреется. Поэтому номинал автомата выбирается ПО кабелю, а не по розетке.</figcaption></figure><div class=\"e-basis\"><b>Пример 1. Розеточная группа кухни: 3,5 кВт, 30 м, медь в гофре в стене</b><p>I = 3500 / (230·1) ≈ 15,2 А → автомат C16. I доп меди 2,5 мм² в стене ≈ 24 А ≥ 16 А: запас есть. Потеря: ΔU = 2·0,0175·30·15,2 / 2,5 ≈ 6,4 В ≈ 2,8 % &lt; 5 %: ОК. <b>Итог: ВВГнг(А)-LS 3×2,5 + C16.</b> Сечение 1,5 мм² прошло бы по току (около 18 А в стене), но розеточные линии по нормам делают не менее 2,5 мм²: механика и перспектива нагрузки.</p></div></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Потеря напряжения: когда сечение диктует длина, а не нагрев</h3></div><p class=\"e-lead2\">Напряжение это «напор», и часть его теряется на сопротивлении линии: чем длиннее и тоньше провод, тем меньше достанется потребителю. Лампы тускнеют, двигатели и насосы греются и теряют момент, импульсные блоки питания тянут больший ток, усугубляя просадку. Ориентир качества задаёт ГОСТ 32144-2013: нормально отклонение напряжения ±5 %, предельно ±10 %; поэтому в расчётах держат ΔU ≤ 5 % от источника до приёмника, оставляя запас на отклонение сети.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 740 366\" role=\"img\" aria-label=\"Потеря напряжения в однофазной линии 16 А в зависимости от длины и сечения\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"64\" y1=\"316.0\" x2=\"664\" y2=\"316.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"320.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0,0</text><line x1=\"64\" y1=\"274.8235294117647\" x2=\"664\" y2=\"274.8235294117647\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"278.8235294117647\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">2,5</text><line x1=\"64\" y1=\"233.64705882352942\" x2=\"664\" y2=\"233.64705882352942\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"237.64705882352942\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">5,0</text><line x1=\"64\" y1=\"192.47058823529414\" x2=\"664\" y2=\"192.47058823529414\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"196.47058823529414\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">7,5</text><line x1=\"64\" y1=\"151.29411764705884\" x2=\"664\" y2=\"151.29411764705884\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"155.29411764705884\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">10,0</text><line x1=\"64\" y1=\"110.11764705882354\" x2=\"664\" y2=\"110.11764705882354\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"114.11764705882354\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">12,5</text><line x1=\"64\" y1=\"68.94117647058826\" x2=\"664\" y2=\"68.94117647058826\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"72.94117647058826\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">15,0</text><text x=\"64.0\" y=\"334\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><text x=\"184.0\" y=\"334\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><text x=\"304.0\" y=\"334\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">40</text><text x=\"424.0\" y=\"334\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">60</text><text x=\"544.0\" y=\"334\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">80</text><text x=\"664.0\" y=\"334\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">100</text><text x=\"364.0\" y=\"356\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">длина линии L, м (1 фаза, 230 В, I = 16 А, cosφ = 1)</text><text x=\"14\" y=\"22\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">потеря напряжения ΔU, %</text><line x1=\"64\" y1=\"316\" x2=\"664\" y2=\"48.65132139812448\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"64\" y1=\"316\" x2=\"664\" y2=\"155.59079283887468\" stroke=\"#1d1f23\" stroke-width=\"3\"/><line x1=\"64\" y1=\"316\" x2=\"664\" y2=\"215.74424552429667\" stroke=\"#7d8089\" stroke-width=\"3\"/><line x1=\"64\" y1=\"316\" x2=\"664\" y2=\"249.16283034953113\" stroke=\"#9a9ca3\" stroke-width=\"3\"/><line x1=\"64\" y1=\"233.64705882352942\" x2=\"664\" y2=\"233.64705882352942\" stroke=\"#e3000f\" stroke-width=\"1.8\" stroke-dasharray=\"6 4\"/><text x=\"658\" y=\"226.64705882352942\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"end\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">предел 5 %</text><text x=\"214\" y=\"55.76470588235293\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">2,5 мм² при 16 А: предел уже на ~50 м</text><line x1=\"372.0357142857142\" y1=\"65.64705882352945\" x2=\"372.0357142857142\" y2=\"228.7058823529412\" stroke=\"#4a4d55\" stroke-width=\"1.2\" stroke-dasharray=\"3 3\"/><line x1=\"76\" y1=\"48\" x2=\"104\" y2=\"48\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"112\" y=\"52\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">S = 1,5 мм²</text><line x1=\"76\" y1=\"68\" x2=\"104\" y2=\"68\" stroke=\"#1d1f23\" stroke-width=\"3\"/><text x=\"112\" y=\"72\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">S = 2,5 мм²</text><line x1=\"76\" y1=\"88\" x2=\"104\" y2=\"88\" stroke=\"#7d8089\" stroke-width=\"3\"/><text x=\"112\" y=\"92\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">S = 4 мм²</text><line x1=\"76\" y1=\"108\" x2=\"104\" y2=\"108\" stroke=\"#9a9ca3\" stroke-width=\"3\"/><text x=\"112\" y=\"112\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">S = 6 мм²</text></svg><figcaption>Потеря напряжения в однофазной линии 16 А: уже на 50 м сечение 2,5 мм² выходит за предел 5 %. Для трёх фаз потеря в √3 раз меньше при том же токе фазы.</figcaption></figure><div class=\"e-basis\"><b>Пример 2. Гараж от дома: 7 кВт, 60 м, три фазы</b><p>I = 7000 / (√3·400·1) ≈ 10,1 А. По нагреву хватило бы 1,5 мм² (I доп в земле ≈ 27 А). Потеря: ΔU = √3·0,0175·60·10,1 / 1,5 ≈ 12,2 В, это 3,1 % от 400 В: в пределах нормы. Для линии в земле сечение берут с запасом на механику и будущую нагрузку, поэтому 2,5 мм²: на нём ΔU ≈ 1,8 %. <b>Итог: ВБШв 5×2,5 + автомат по расчёту.</b> Важно: для трёх фаз потеря считается от междуфазного напряжения 400 В.</p></div><div class=\"e-basis\"><b>Пример 2а. Скважинный насос: 3,5 кВт, 60 м, одна фаза</b><p>I = 3500 / 230 ≈ 15,2 А. Сечение 1,5 мм²: ΔU = 2·0,0175·60·15,2 / 1,5 ≈ 21 В ≈ 9,3 %. Сечение 2,5 мм²: ≈ 12,8 В ≈ 5,6 %. Сечение 4 мм²: ≈ 8 В ≈ 3,5 %. <b>Итог: 4 мм².</b> Вывод для запоминания: однофазные линии длиннее 40–50 м считают по потере, а не по нагреву. Для пускового тока насоса запас по сечению тем более нужен.</p></div><ul class=\"e-ul\"><li>Уличное освещение, скважинный насос, хозпостройка, видеонаблюдение на столбе: сначала считайте ΔU, потом всё остальное.</li><li>Низковольтные линии (12/24 В: ленты, ландшафт, СКУД) теряют те же вольты, но в процентах это десятки: сечения растут кратно, а линии делают короче и с локальным преобразователем.</li><li>Для двигателей важна не только потеря, но и пусковой ток 5–7 I ном: длинная тонкая линия «роняет» напряжение при пуске, и насос не стартует.</li><li>Алюминий дешевле, но его ρ в 1,6 раза выше: при равной потере сечение алюминия больше меди примерно на ступень (2,5 мм² Cu ≈ 4 мм² Al по току).</li></ul><div class=\"e-basis\"><b>Пример 3. Ввод в дом: 15 кВт, 25 м, три фазы</b><p>I = 15000 / (√3·400·0,95) ≈ 22,8 А → автомат C25. Медь 6 мм² в земле: I доп ≈ 58 А, двойной запас; ΔU = √3·0,0175·25·22,8 / 6 ≈ 2,9 В ≈ 0,7 % от 400 В: отлично. Прокладка в траншее бронёй ВБШв или в защитной трубе; PE-жила при сечении фазы до 16 мм² того же сечения. <b>Итог: ВБШв 5×6 (или 4×6 + PE) + C25</b> и УЗИП или автомат на вводе по проекту.</p></div></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Механика, среда и марки: где кабель живёт, там и правила</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 770 172\" role=\"img\" aria-label=\"Пять типовых сред прокладки кабеля\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"8\" y=\"10\" width=\"140\" height=\"150\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"78\" y=\"36\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">В стене и стяжке</text><text x=\"78\" y=\"62\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">гофра, труба, штроба</text><text x=\"78\" y=\"84\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">ВВГнг(А)-LS, NYM</text><text x=\"78\" y=\"106\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">медь: 1,5 свет /</text><text x=\"78\" y=\"128\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">2,5 розетки (мин.)</text><rect x=\"158\" y=\"10\" width=\"140\" height=\"150\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"228\" y=\"36\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">Открыто в комнате</text><text x=\"228\" y=\"62\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">кабель-канал, плинтус,</text><text x=\"228\" y=\"84\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">лоток (не по горючему)</text><text x=\"228\" y=\"106\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">ВВГнг(А)-LS</text><text x=\"228\" y=\"128\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">канал = мехзащита</text><rect x=\"308\" y=\"10\" width=\"140\" height=\"150\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"378\" y=\"36\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">В земле (траншея)</text><text x=\"378\" y=\"62\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">броня обязательна,</text><text x=\"378\" y=\"84\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">если нет трубы</text><text x=\"378\" y=\"106\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">ВБШв (ВБбШв)</text><text x=\"378\" y=\"128\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">песок 10 см + лента</text><rect x=\"458\" y=\"10\" width=\"140\" height=\"150\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"528\" y=\"36\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">Улица и фасад</text><text x=\"528\" y=\"62\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">УФ-стойкая оболочка</text><text x=\"528\" y=\"84\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">или труба/козырёк;</text><text x=\"528\" y=\"106\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">ввод воздухом — СИП</text><text x=\"528\" y=\"128\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">алюминий ≥16 мм²</text><rect x=\"608\" y=\"10\" width=\"140\" height=\"150\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"678\" y=\"36\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">Деревянный дом</text><text x=\"678\" y=\"62\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">скрыто — в металл.</text><text x=\"678\" y=\"84\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">трубе или коробе;</text><text x=\"678\" y=\"106\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"700\">открыто — по негорюч.</text><text x=\"678\" y=\"128\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\" font-weight=\"400\">основанию; нг-LS</text></svg><figcaption>Пять типовых сред прокладки: у каждой свои требования к защите, оболочке и минимальному сечению. Тепловой баланс: земля охлаждает лучше стены, пучок кабелей греет сам себя, поэтому таблицы токов всегда привязаны к способу прокладки.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Линия</th><th>Мин. сечение меди</th><th>Защита и марка</th><th>Норма-ориентир</th></tr></thead><tbody><tr><td>Групповое освещение</td><td>1,5 мм²</td><td>ВВГнг(А)-LS в трубе или штробе</td><td>ТКП 339, СН 4.04.01-2019</td></tr><tr><td>Розеточные группы</td><td>2,5 мм²</td><td>ВВГнг(А)-LS; УЗО 30 мА на группу</td><td>ТКП 339, СН 4.04.01-2019</td></tr><tr><td>Стационарные силовые линии (котлы, плиты)</td><td>2,5–6 мм² по расчёту</td><td>отдельная линия, свой автомат</td><td>СН 4.04.01-2019</td></tr><tr><td>Распределительные стояки и вводы</td><td>4–16 мм² по расчёту</td><td>лоток, труба, вводной щит</td><td>ТКП 339, ПУЭ гл. 1.3</td></tr><tr><td>Ввод по воздуху (от опоры)</td><td>алюминий СИП ≥ 16 мм²</td><td>СИП с крепежом и зажимами; провис и высоты по нормам</td><td>ПУЭ гл. 2.4</td></tr><tr><td>Траншея, земля</td><td>по расчёту, броня</td><td>ВБШв (ВБбШв); без брони только в трубе; подушка и лента</td><td>ПУЭ гл. 2.3</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Пожарные исполнения оболочек</b> (ГОСТ 31565-2012) выбираются не «по красоте», а по типу здания. <b>нг</b> не распространяет горение в пучке. <b>LS</b> даёт низкие дым и газовыделение (жильё, частные дома). <b>HF</b> без галогенов (общественные здания с массовым пребыванием людей, серверные): дым не содержит коррозионно-активных газов, опасных для людей и электроники. <b>FR</b> (FRLS, FRHF) огнестойкие, держат линию в огне 90–180 мин: пожарная сигнализация, дымоудаление, аварийное освещение. Экономия на «обычном» кабеле в таких системах прямое нарушение.</p><div class=\"e-basis\"><b>Медь или алюминий?</b><p>Внутренние сети жилых и общественных зданий выполняются медью; алюминий допустим в распределительных сетях и вводах при соответствующих сечениях (СИП, стояки). Прямой контакт меди с алюминием недопустим: гальваническая пара окисляется, переходное сопротивление растёт, соединение греется. Соединяйте только через клеммы, болтовые зажимы или медно-алюминиевые гильзы.</p></div></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Нюансы, которые отличают расчёт от «примерно»</h3></div><ul class=\"e-ul\"><li><b>Нулевая (N) и защитная (PE) жилы.</b> При сечении фазы до 16 мм² (медь) N и PE равны фазе; при 16–35 мм² не менее 16 мм²; свыше 35 мм² не менее половины сечения фазы. В трёхфазных сетях со светодиодными драйверами и инверторами нейтраль греется гармониками, и там N берут равной фазе и при больших сечениях.</li><li><b>УЗО 30 мА</b> ставят на розеточные группы, ванные, кухни и уличные линии. Автомат защищает кабель от перегрева, УЗО защищает человека от тока утечки: это разные приборы, и ставятся оба.</li><li><b>Контакты греются сильнее жил.</b> Большинство «электрических» пожаров это ослабленный зажим и скрутка «с изолентой». Протяжка с моментом по паспорту аппарата, опрессовка гильзами или болтовые зажимы; алюминий «течёт» под болтом, поэтому регламентная протяжка при ТО обязательна.</li><li><b>Характеристика автомата.</b> B для длинных линий и старого фонда (чувствительнее к КЗ), C универсальная для дома, D для двигателей и сварки с большими пусковыми токами. Селективность: вводной номинал на ступень выше групповых.</li><li><b>Запас и апгрейд.</b> Закладывайте +1 ступень сечения на линии, которые потом не переложить (стяжка, траншея, фасад): дешёвая медь сегодня против вскрытия завтра.</li></ul><div class=\"e-basis\"><b>Нормативная база Республики Беларусь (обязательный минимум)</b><p><b>ТКП 339-2022</b> «Электроустановки на напряжение до 750 В» (требования к устройству, заземление, защитные меры). <b>СН 4.04.01-2019</b> «Системы электрооборудования жилых и общественных зданий»: проектирование. <b>ПУЭ</b> (6-е издание) используются как справочная база, в частности главы 1.3 (длительно допустимые токи), 2.3–2.4 (кабельные линии, воздушные вводы), 7.1 (электропроводки зданий); применимость конкретного пункта уточняйте у проектировщика. <b>ГОСТ 31996-2012</b>: силовые кабели с пластмассовой изоляцией. <b>ГОСТ 31565-2012</b>: пожарные исполнения (нг, LS, HF, FR). <b>ГОСТ 32144-2013</b>: нормы качества электрической энергии (±5 % и ±10 %). <b>ТКП 181</b>: правила технической эксплуатации электроустановок потребителей (действующая редакция). Проект и отступления от него согласуются в установленном порядке.</p></div><h4 class=\"e-h4\">Мини-справка для памяти (медь, ПВХ-изоляция): ток, автомат, линия</h4><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Сечение, мм²</th><th>В трубе, стене, А</th><th>В земле, А</th><th>Типовой автомат</th><th>Линия</th></tr></thead><tbody><tr><td>1,5</td><td>≈ 19–21</td><td>≈ 27</td><td>B10</td><td>освещение</td></tr><tr><td>2,5</td><td>≈ 24–25</td><td>≈ 37</td><td>C16</td><td>розетки</td></tr><tr><td>4</td><td>≈ 32–34</td><td>≈ 48</td><td>C25</td><td>котёл, варочная (1 фаза)</td></tr><tr><td>6</td><td>≈ 41–44</td><td>≈ 58</td><td>C32</td><td>ввод, варочная (3 фазы)</td></tr><tr><td>10</td><td>≈ 56–60</td><td>≈ 77</td><td>C40–C50</td><td>ввод 10–15 кВт, 3 фазы</td></tr></tbody></table></div><p class=\"e-note\">Значения справочные: фактический ток берите из таблиц ПУЭ гл. 1.3 и паспорта кабеля с учётом коэффициентов среды и пучка.</p></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Типичные ошибки: 10 способов получить перегрев и переделку</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. Автомат «чтобы не выбивало»</h4><p class=\"x\">✗ C25 на кабель 1,5 мм²: изоляция плавится в стене, автомат молчит.</p><p class=\"v\">✓ I автомата ≤ I доп кабеля: C16 для 2,5, B10 для 1,5.</p></div><div class=\"e-err\"><h4>2. Сечение без способа прокладки</h4><p class=\"x\">✗ Табличный ток воздуха применён к пучку в гофре: теплоотвод ниже примерно на 30 %.</p><p class=\"v\">✓ Таблица по прокладке с коэффициентами пучка и температуры.</p></div><div class=\"e-err\"><h4>3. Длинная линия по нагреву</h4><p class=\"x\">✗ 60 м на 1,5 мм²: ΔU больше 5 %, тусклый свет, мучительный пуск насоса.</p><p class=\"v\">✓ Для L более 40–50 м сечение по ΔU ≤ 5 %, затем проверка по току.</p></div><div class=\"e-err\"><h4>4. Скрутка медь + алюминий</h4><p class=\"x\">✗ Гальваническая пара: окислы, рост сопротивления, нагрев узла.</p><p class=\"v\">✓ Клеммы, болтовые зажимы, медно-алюминиевые гильзы.</p></div><div class=\"e-err\"><h4>5. Кабель в земле без брони</h4><p class=\"x\">✗ Подъезд машины и осадка грунта передавливают изоляцию через год-два.</p><p class=\"v\">✓ ВБШв (ВБбШв) либо защитная труба; подушка 10 см песка, сигнальная лента.</p></div><div class=\"e-err\"><h4>6. Гофра по дереву в срубе</h4><p class=\"x\">✗ ПВХ горюч: скрытая проводка по горючему основанию без защиты.</p><p class=\"v\">✓ Металлическая труба или короб либо открытая прокладка по негорючему основанию.</p></div><div class=\"e-err\"><h4>7. Обычный ВВГ на фасаде</h4><p class=\"x\">✗ УФ старит оболочку: трещины, оголение жилы под дождём.</p><p class=\"v\">✓ УФ-стойкая оболочка или труба; ввод по воздуху СИП.</p></div><div class=\"e-err\"><h4>8. Тонкая нейтраль при нелинейной нагрузке</h4><p class=\"x\">✗ LED и инверторы греют N гармониками: перегрев четвёртой жилы.</p><p class=\"v\">✓ При нелинейной нагрузке N равна сечению фазы; расчёт с учётом гармоник.</p></div><div class=\"e-err\"><h4>9. Без УЗО на розетках и улице</h4><p class=\"x\">✗ Утечка на корпус или в мокрую зону бьёт током человека.</p><p class=\"v\">✓ УЗО 30 мА на групповые линии санузлов, кухни, улицы.</p></div><div class=\"e-err\"><h4>10. Экономия на контактах</h4><p class=\"x\">✗ Недотянутый зажим греется локально сильнее самой жилы.</p><p class=\"v\">✓ Момент по паспорту, опрессовка и гильзы, регламентная протяжка при ТО.</p></div></div><div class=\"e-basis\"><b>Цена ошибки в одном абзаце</b><p>Перегретое сечение не кричит: оно годами старит изоляцию и однажды даёт КЗ в скрытой трассе. Замена линии в стяжке или траншее это вскрытие отделки, земляные и отделочные работы, простой дома: в 5–10 раз дороже самой линии. Дешевле всего правильные сечения обходятся на бумаге: таблица нагрузок, способ прокладки, коэффициенты, ΔU и марка до покупки кабеля.</p></div></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Шпаргалка и чек-лист: что запомнить и что проверить</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Линия</th><th>Автомат</th><th>Медь, мм²</th><th>Примечание</th></tr></thead><tbody><tr><td>Освещение</td><td>B10</td><td>1,5</td><td>минимум по нормам; группы по комнатам</td></tr><tr><td>Розеточная группа</td><td>C16</td><td>2,5</td><td>УЗО 30 мА; не более 8–10 розеток на группу (практический ориентир)</td></tr><tr><td>Стиральная, посудомоечная машина</td><td>C16</td><td>2,5</td><td>отдельная линия от щита</td></tr><tr><td>Варочная панель, духовой шкаф</td><td>C25–C32</td><td>4–6</td><td>по паспорту плиты; возможно трёхфазное подключение</td></tr><tr><td>Электрокотёл, тепловой насос</td><td>C25–C40</td><td>4–10</td><td>по расчёту; резерв на пуски ТН</td></tr><tr><td>Ввод 10–15 кВт, три фазы</td><td>C40–C50</td><td>10–16</td><td>в земле броня; на вводе УЗИП по проекту</td></tr><tr><td>Ввод по воздуху от опоры</td><td>—</td><td>СИП 4×16 (Al)</td><td>высоты и провис по нормам</td></tr></tbody></table></div><h4 class=\"e-h4\">Пять тезисов для запоминания</h4><ul class=\"e-ul\"><li>Ток считает мощность, сечение способ прокладки, автомат сечение, длину потеря напряжения: каждый параметр отвечает за свой шаг.</li><li>Автомат защищает кабель: I нагрузки ≤ I автомата ≤ I доп кабеля при фактических коэффициентах.</li><li>Держите ΔU ≤ 5 %: длинные и низковольтные линии считаются по потере, а не по нагреву.</li><li>Среда диктует марку: броня в земле, УФ на фасаде, нг-LS, HF или FR по типу здания и назначению линии.</li><li>Пожары живут в контактах: протяжка с моментом, опрессовка, УЗО 30 мА и регламент ТО важнее «ещё одного мм²».</li></ul><div class=\"e-basis\"><b>Чек-лист самопроверки проекта или сметы</b><p>1) Таблица нагрузок и токов по линиям с cosφ. 2) Сечения с указанием способа прокладки и коэффициентов. 3) Номиналы и характеристики автоматов, УЗО и дифавтоматов. 4) Расчёт ΔU для линий длиннее 40 м. 5) Марки кабелей по ГОСТ 31565-2012 для каждого типа помещения. 6) Сечения N и PE. 7) Узлы прохода стен и перекрытий и механическая защита. Если хотя бы одного пункта нет, расчёт не полный.</p></div><p class=\"e-note\">Нормативные ссылки: ТКП 339-2022; СН 4.04.01-2019; ГОСТ 31996-2012; ГОСТ 31565-2012; ГОСТ 32144-2013; ПУЭ (6-е изд.), главы 1.3, 1.7, 2.3, 2.4, 7.1 как справочная база. Значения токов и потерь на диаграммах справочные для меди с ПВХ-изоляцией при +25 °С и не заменяют проектный расчёт. Для точного подбора используйте вкладку «Подбор кабеля».</p></div></section><section class=\"e-panel\" id=\"cable\" data-panel=\"cable\"><div class=\"e-sech\"><small>02</small><h2>Подбор сечения кабеля</h2></div><p class=\"e-lead2\">Выберите сеть, материал, изоляцию и способ прокладки, задайте мощность или ток, длину линии и cos φ. Калькулятор проверит сечение по механической прочности, нагреву током с учётом автомата и потере напряжения и покажет, что определило результат.</p><div class=\"e-calc\"><div class=\"e-form\"><fieldset class=\"e-seg\"><legend>Сеть</legend><label><input type=\"radio\" name=\"c-ph\" value=\"1\" checked><span>1 фаза</span></label><label><input type=\"radio\" name=\"c-ph\" value=\"3\"><span>3 фазы</span></label></fieldset><fieldset class=\"e-seg\"><legend>Материал жилы</legend><label><input type=\"radio\" name=\"c-mat\" value=\"cu\" checked><span>Медь</span></label><label><input type=\"radio\" name=\"c-mat\" value=\"al\"><span>Алюминий</span></label></fieldset><fieldset class=\"e-seg\"><legend>Изоляция</legend><label><input type=\"radio\" name=\"c-ins\" value=\"pvc\" checked><span>Изоляция ПВХ (до 70 °С)</span></label><label><input type=\"radio\" name=\"c-ins\" value=\"xlpe\"><span>Сшитый полиэтилен (до 90 °С)</span></label></fieldset><fieldset class=\"e-seg\"><legend>Исходные данные</legend><label><input type=\"radio\" name=\"c-mode\" value=\"p\" checked><span>Задана мощность</span></label><label><input type=\"radio\" name=\"c-mode\" value=\"i\"><span>Задан ток</span></label></fieldset><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"c-lay\">Способ прокладки</label><div class=\"e-in\"><select id=\"c-lay\"><option value=\"B1\" selected>В трубе или коробе, скрыто в стене (B1)</option><option value=\"C\">Кабелем открыто по стене (C)</option><option value=\"A1\">В трубе в утеплённой стене (A1)</option><option value=\"E\">На лотке в воздухе (E)</option></select></div></div><div class=\"e-f wide\"><label for=\"c-kind\">Назначение линии</label><div class=\"e-in\"><select id=\"c-kind\"><option value=\"sock\" selected>Розетки и бытовые приборы</option><option value=\"light\">Освещение</option><option value=\"power\">Силовая линия, питание щита</option></select></div></div><div class=\"e-f\"><label for=\"c-u\">Напряжение</label><div class=\"e-in\"><input id=\"c-u\" inputmode=\"decimal\" autocomplete=\"off\" value=\"230\"><span class=\"u\">В</span></div></div><div class=\"e-f\" id=\"c-wp\"><label for=\"c-p\">Мощность</label><div class=\"e-in\"><input id=\"c-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3,5\"><span class=\"u\">кВт</span></div></div><div class=\"e-f\" id=\"c-wi\" hidden><label for=\"c-i\">Ток</label><div class=\"e-in\"><input id=\"c-i\" inputmode=\"decimal\" autocomplete=\"off\" value=\"16\"><span class=\"u\">А</span></div></div><div class=\"e-f\"><label for=\"c-cos\">cos φ</label><div class=\"e-in\"><input id=\"c-cos\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,0\"></div></div><div class=\"e-f\"><label for=\"c-l\">Длина линии</label><div class=\"e-in\"><input id=\"c-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"c-k\">Одновременность</label><div class=\"e-in\"><input id=\"c-k\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,0\"></div></div><div class=\"e-f\"><label for=\"c-lim\">Допустимая потеря</label><div class=\"e-in\"><input id=\"c-lim\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">%</span></div></div><div class=\"e-f\"><label for=\"c-t\">Температура воздуха</label><div class=\"e-in\"><input id=\"c-t\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"c-n\">Цепей рядом в одном канале</label><div class=\"e-in\"><input id=\"c-n\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div></div><div class=\"e-formula\">Итог = наибольшее из трёх сечений: по механической прочности, по нагреву и по потере напряжения<br>Нагрев: I ≤ автомат ≤ Iдоп · k<sub>t</sub> · k<sub>гр</sub><br>1 фаза: I = P ÷ (U · cos φ), ΔU = 2 · I · L · (ρ ÷ S · cos φ + x · sin φ)<br>3 фазы: I = P ÷ (1,73 · U · cos φ), ΔU = 1,73 · I · L · (ρ ÷ S · cos φ + x · sin φ)<br>ρ при рабочей температуре жилы, x = 0,08 мОм/м</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Расчётный ток</span><b id=\"c-r-i\">—</b></div><div class=\"kv\"><span>По механической прочности</span><b id=\"c-r-mech\">—</b></div><div class=\"kv\"><span>По нагреву током и автомату</span><b id=\"c-r-cur\">—</b></div><div class=\"kv\"><span>По потере напряжения</span><b id=\"c-r-drop\">—</b></div><div class=\"kv\"><span>Итоговое сечение</span><b id=\"c-r-s\">—</b></div><div class=\"kv\"><span>Определяет</span><b id=\"c-r-by\">—</b></div><div class=\"kv\"><span>Автомат</span><b id=\"c-r-in\">—</b></div><div class=\"kv\"><span>Допустимый ток кабеля</span><b id=\"c-r-iz\">—</b></div><div class=\"kv\"><span>Потеря напряжения</span><b id=\"c-r-du\">—</b></div><div class=\"verdict\" id=\"c-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"kz\" data-panel=\"kz\"><div class=\"e-sech\"><small>03</small><h2>Ток короткого замыкания и срабатывание автомата</h2></div><p class=\"e-lead2\">Проверка, что при замыкании фазы на ноль автомат отключится быстро. Нужны длина и сечение линии и сопротивление питающей части.</p><div class=\"e-calc\"><div class=\"e-form\"><fieldset class=\"e-seg\"><legend>Материал жилы</legend><label><input type=\"radio\" name=\"k-mat\" value=\"cu\" checked><span>Медь</span></label><label><input type=\"radio\" name=\"k-mat\" value=\"al\"><span>Алюминий</span></label></fieldset><div class=\"e-row\"><div class=\"e-f\"><label for=\"k-u\">Напряжение фазы</label><div class=\"e-in\"><input id=\"k-u\" inputmode=\"decimal\" autocomplete=\"off\" value=\"230\"><span class=\"u\">В</span></div></div><div class=\"e-f\"><label for=\"k-s\">Сечение</label><div class=\"e-in\"><input id=\"k-s\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,5\"><span class=\"u\">мм²</span></div></div><div class=\"e-f\"><label for=\"k-l\">Длина</label><div class=\"e-in\"><input id=\"k-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"40\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"k-zs\">Сопротивление питания</label><div class=\"e-in\"><input id=\"k-zs\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,05\"><span class=\"u\">Ом</span></div></div><div class=\"e-f\"><label for=\"k-in\">Номинал автомата</label><div class=\"e-in\"><input id=\"k-in\" inputmode=\"decimal\" autocomplete=\"off\" value=\"16\"><span class=\"u\">А</span></div></div><div class=\"e-f\"><label for=\"k-type\">Тип расцепителя</label><div class=\"e-in\"><select id=\"k-type\"><option value=\"10:C\" selected>C (5–10 × Iном)</option><option value=\"5:B\">B (3–5 × Iном)</option><option value=\"20:D\">D (10–20 × Iном)</option></select></div></div></div><div class=\"e-formula\">Z петли = 2 · ρ · L ÷ S + Z питания<br>Iкз = U фазы ÷ Z петли<br>Порог мгновенного срабатывания берётся по верхней границе диапазона типа расцепителя</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Сопротивление петли</span><b id=\"k-r-z\">—</b></div><div class=\"kv\"><span>Ток КЗ</span><b id=\"k-r-ik\">—</b></div><div class=\"kv\"><span>Порог срабатывания</span><b id=\"k-r-th\">—</b></div><div class=\"kv\"><span>Запас</span><b id=\"k-r-m\">—</b></div><div class=\"verdict\" id=\"k-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"ground\" data-panel=\"ground\"><div class=\"e-sech\"><small>04</small><h2>Заземление: число стержней</h2></div><p class=\"e-lead2\">Подбор числа вертикальных заземлителей по сопротивлению грунта. Ориентировочный расчёт; на месте обязателен замер.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"g-rho\">Удельное сопротивление грунта</label><div class=\"e-in\"><input id=\"g-rho\" inputmode=\"decimal\" autocomplete=\"off\" value=\"100\"><span class=\"u\">Ом·м</span></div></div><div class=\"e-f\"><label for=\"g-l\">Длина стержня</label><div class=\"e-in\"><input id=\"g-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"g-d\">Диаметр</label><div class=\"e-in\"><input id=\"g-d\" inputmode=\"decimal\" autocomplete=\"off\" value=\"16\"><span class=\"u\">мм</span></div></div><div class=\"e-f\"><label for=\"g-t0\">Заглубление верха</label><div class=\"e-in\"><input id=\"g-t0\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,8\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"g-r\">Нужное сопротивление</label><div class=\"e-in\"><input id=\"g-r\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">Ом</span></div></div><div class=\"e-f\"><label for=\"g-eta\">Коэфф. использования</label><div class=\"e-in\"><input id=\"g-eta\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,7\"></div></div><div class=\"e-f\"><label for=\"g-a\">Шаг между стержнями</label><div class=\"e-in\"><input id=\"g-a\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м</span></div></div></div><div class=\"e-formula\">R стержня = ρ ÷ (2π·l) · (ln(2l ÷ d) + ½ · ln((4t + l) ÷ (4t − l)))<br>n = R стержня ÷ (R нужное · η), t — глубина середины стержня</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Один стержень</span><b id=\"g-r-1\">—</b></div><div class=\"kv\"><span>Нужно стержней</span><b id=\"g-r-n\">—</b></div><div class=\"kv\"><span>Итого</span><b id=\"g-r-tot\">—</b></div><div class=\"kv\"><span>Полоса связи</span><b id=\"g-r-strip\">—</b></div><div class=\"verdict\" id=\"g-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"light\" data-panel=\"light\"><div class=\"e-sech\"><small>05</small><h2>Освещение помещения</h2></div><p class=\"e-lead2\">Выберите тип помещения и светильник. Калькулятор возьмёт норму освещённости, найдёт нужное число светильников и покажет, как расставить их на плане.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"l-room\">Тип помещения</label><div class=\"e-in\"><select id=\"l-room\"><option value=\"150\">Жилая комната, спальня</option><option value=\"150\">Кухня, кухня-столовая</option><option value=\"200\">Детская</option><option value=\"300\">Кабинет</option><option value=\"75\">Гардеробная</option><option value=\"50\">Коридор, холл в квартире</option><option value=\"50\">Ванная, санузел</option><option value=\"30\">Кладовая</option><option value=\"20\">Лестница</option></select></div></div><div class=\"e-f\"><label for=\"l-e\">Норма</label><div class=\"e-in\"><input id=\"l-e\" inputmode=\"decimal\" autocomplete=\"off\" value=\"150\"><span class=\"u\">лк</span></div></div><div class=\"e-f\"><label for=\"l-a\">Длина</label><div class=\"e-in\"><input id=\"l-a\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5,0\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"l-b\">Ширина</label><div class=\"e-in\"><input id=\"l-b\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4,0\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"l-h\">Высота потолка</label><div class=\"e-in\"><input id=\"l-h\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,7\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"l-hp\">Высота плоскости</label><div class=\"e-in\"><input id=\"l-hp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,0\"><span class=\"u\">м</span></div></div><div class=\"e-f wide\"><label for=\"l-fix\">Светильник</label><div class=\"e-in\"><select id=\"l-fix\"><option value=\"12:1500\">Потолочный LED, 12 Вт, 1 500 лм</option><option value=\"18:2000\">Потолочный LED, 18 Вт, 2 000 лм</option><option value=\"36:3600\">Панель LED 600×600, 36 Вт, 3 600 лм</option><option value=\"5:450\">Точечный LED, 5 Вт, 450 лм</option><option value=\"24:2800\">Подвесной LED, 24 Вт, 2 800 лм</option></select></div></div><div class=\"e-f wide\"><label for=\"l-ref\">Отражение потолок / стены / пол</label><div class=\"e-in\"><select id=\"l-ref\"><option value=\"1\" selected>70 / 50 / 30 %</option><option value=\"0.85\">50 / 30 / 10 %</option><option value=\"0.75\">30 / 30 / 10 %</option></select></div></div><div class=\"e-f\"><label for=\"l-kz\">Коэфф. запаса</label><div class=\"e-in\"><input id=\"l-kz\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,3\"></div></div><div class=\"e-f\"><label for=\"l-z\">Неравномерность</label><div class=\"e-in\"><input id=\"l-z\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,1\"></div></div></div><div class=\"e-plan\"><b>План расстановки</b><svg id=\"l-svg\" viewBox=\"0 0 620 500\" role=\"img\" aria-label=\"План комнаты с расстановкой светильников\"></svg><p class=\"e-note\" id=\"l-plan-note\"></p></div><div class=\"e-rooms\"><b>Квартира целиком</b><p class=\"e-lead2\">Добавляйте помещения и получите список светильников для сметы и общую мощность освещения.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Помещение</th><th>Площадь, м²</th><th>Норма, лк</th><th>Светильников</th><th>Получится, лк</th><th>Мощность, Вт</th><th></th></tr></thead><tbody id=\"l-rooms\"></tbody></table></div><div class=\"e-actions\"><button class=\"e-btn\" id=\"l-add\" type=\"button\">Добавить это помещение</button><button class=\"e-btn ghost\" id=\"l-clear\" type=\"button\">Очистить список</button></div></div><div class=\"e-formula\">Индекс помещения i = A · B ÷ (h · (A + B))<br>N = E · S · Kз · Z ÷ (F · η)<br>E — норма, лк; S — площадь; Kз — запас; Z — неравномерность; F — поток светильника, лм; η — коэффициент использования</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Норма освещённости</span><b id=\"l-r-e\">—</b></div><div class=\"kv\"><span>Индекс помещения</span><b id=\"l-r-i\">—</b></div><div class=\"kv\"><span>Коэфф. использования</span><b id=\"l-r-eta\">—</b></div><div class=\"kv\"><span>Нужный поток</span><b id=\"l-r-f\">—</b></div><div class=\"kv\"><span>Светильников</span><b id=\"l-r-n\">—</b></div><div class=\"kv\"><span>Получится</span><b id=\"l-r-got\">—</b></div><div class=\"kv\"><span>Мощность</span><b id=\"l-r-w\">—</b></div><div class=\"verdict\" id=\"l-verdict\" role=\"status\"></div><button class=\"e-btn wide\" id=\"l-tocable\" type=\"button\">Передать мощность в «Подбор кабеля»</button></div></div></div></section><section class=\"e-panel\" id=\"apparaty\" data-panel=\"apparaty\"><div class=\"e-sech\"><small>06</small><h2>Автоматы, дифавтоматы и УЗО</h2></div><p class=\"e-lead2\">Сначала подбор: выберите помещение, потребителя, мощность и сечение кабеля, калькулятор подскажет автомат и УЗО. Ниже справочник по обозначениям на корпусе и по применению: автомат защищает кабель от перегрузки и короткого замыкания, УЗО защищает людей и имущество от тока утечки, дифавтомат объединяет и то, и другое.</p><div class=\"ap-box\" id=\"ap-podbor\"><div class=\"e-sech\"><small>А</small><h3>Подбор автомата и УЗО</h3></div><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-f\"><label for=\"ap-room\">Помещение</label><div class=\"e-in\"><select id=\"ap-room\"><option value=\"living\" selected>Жилая комната, спальня</option><option value=\"kitchen\">Кухня</option><option value=\"bath\">Ванная, душевая, санузел</option><option value=\"hall\">Коридор, прихожая</option><option value=\"kids\">Детская (постоянное пребывание детей)</option><option value=\"tech\">Гараж, подсобное, кладовая</option><option value=\"office\">Офис, кабинет, open space</option><option value=\"shop\">Магазин, торговый зал, склад</option><option value=\"common\">Помещения общего пользования: лестницы, холлы, коридоры</option></select></div></div><div class=\"e-f\"><label for=\"ap-load\">Потребитель</label><div class=\"e-in\"><select id=\"ap-load\"><option value=\"sock\" selected>Розеточная группа</option><option value=\"light\">Освещение</option><option value=\"wash\">Стиральная или посудомоечная машина</option><option value=\"cook\">Электроплита, духовой шкаф, варочная панель</option><option value=\"boiler\">Водонагреватель (бойлер)</option><option value=\"floor\">Тёплый пол, обогрев</option><option value=\"heater\">Конвектор, электрообогреватель</option><option value=\"ac\">Кондиционер с инвертором</option><option value=\"pump\">Насос, электродвигатель</option><option value=\"ev\">Зарядка электромобиля</option><option value=\"fire\">Противопожарная защита: противодымная вентиляция, насосы</option></select></div></div><fieldset class=\"e-seg\"><legend>Сеть</legend><label><input type=\"radio\" name=\"ap-ph\" value=\"1\" checked><span>1 фаза, 230 В</span></label><label><input type=\"radio\" name=\"ap-ph\" value=\"3\"><span>3 фазы, 400 В</span></label></fieldset><div class=\"e-f\"><label for=\"ap-p\">Мощность</label><div class=\"e-in\"><input id=\"ap-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,0\"><span class=\"u\">кВт</span></div></div><div class=\"e-f\"><label for=\"ap-s\">Сечение медного кабеля</label><div class=\"e-in\"><select id=\"ap-s\"><option value=\"1.5\" selected>1,5 мм²</option><option value=\"2.5\">2,5 мм²</option><option value=\"4\">4 мм²</option><option value=\"6\">6 мм²</option><option value=\"10\">10 мм²</option><option value=\"16\">16 мм²</option></select></div></div><div class=\"e-f\"><label for=\"ap-m\">Способ прокладки</label><div class=\"e-in\"><select id=\"ap-m\"><option value=\"1\" selected>В трубе или коробе на стене (B1)</option><option value=\"0\">В трубе в теплоизолированной стене (A1)</option><option value=\"2\">Открыто по стене (C)</option><option value=\"3\">На лотке (E)</option></select></div></div><p class=\"e-note\">Кабель с изоляцией из ПВХ, температура воздуха 30 °С, одна цепь. Допустимые токи по МЭК 60364-5-52. Если на жиле другая изоляция или цепей несколько рядом, возьмите сечение больше и сверьтесь в разделе «Подбор кабеля».</p></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Подбор защиты</span><div class=\"kv\"><span>Расчётный ток линии</span><b id=\"ap-ib\">—</b></div><div class=\"kv\"><span>Допустимый ток кабеля</span><b id=\"ap-iz\">—</b></div><div class=\"kv\"><span>Автомат</span><b id=\"ap-brk\">—</b></div><div class=\"kv\"><span>Полюса</span><b id=\"ap-pol\">—</b></div><div class=\"kv\"><span>УЗО или дифавтомат</span><b id=\"ap-rcd\">—</b></div><div class=\"kv\"><span>Тип и уставка</span><b id=\"ap-typ\">—</b></div><div class=\"verdict\" id=\"ap-verdict\" role=\"status\"></div><div class=\"ap-list\" id=\"ap-why\"></div></div></div></div></div><div class=\"e-sech ap-refh\"><small>—</small><h3>Справочник</h3></div><div class=\"e-step\"><div class=\"e-sech\"><small>А</small><h3>Что читать на корпусе</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Обозначение</th><th>Что значит</th><th>Как использовать</th></tr></thead><tbody><tr><td class=\"m\">C16</td><td>Буква — характеристика срабатывания (кривая) мгновенного расцепителя. Число — номинальный ток In, А.</td><td>Номинал не меньше расчётного тока линии и не больше допустимого тока кабеля. Букву выбирают по нагрузке, см. таблицу ниже.</td></tr><tr><td class=\"m\">6000, 6 кА</td><td>Номинальная предельная коммутационная способность Icn: наибольший ток короткого замыкания, который автомат отключает и остаётся исправным. Обычно в рамке на корпусе.</td><td>Должна быть выше расчётного максимального тока короткого замыкания в месте установки (СН 4.04.01, п. 10.4). Бывает 3000, 4500, 6000, 10 000 А.</td></tr><tr><td class=\"m\">Цифра 1, 2 или 3 под рамкой</td><td>Класс токоограничения: чем выше, тем меньше энергия, пропускаемая при коротком замыкании.</td><td>Класс 3 даёт наименьший нагрев кабеля при коротком замыкании. Без цифры — класс 1 (токоограничения нет).</td></tr><tr><td class=\"m\">1P, 1P+N, 2P, 3P, 3P+N, 4P</td><td>Число полюсов. P — защищённые полюса, +N — отключаемый нулевой полюс без расцепителя.</td><td>В двух- и трёхфазных групповых линиях освещения однополюсные автоматы запрещены (СН 4.04.01, п. 7.1.2). Аппараты управления отключают все фазные проводники (п. 8.1.4).</td></tr><tr><td class=\"m\">230/400 В ~ 50 Гц</td><td>Номинальное напряжение и частота.</td><td>Для сетей Беларуси 230 В одна фаза и 400 В три фазы.</td></tr><tr><td class=\"m\">IΔn 30 мА</td><td>Номинальный отключающий дифференциальный ток: уставка УЗО и дифавтомата.</td><td>Для людей 30 мА, для защиты от возгорания 300 мА. Отключение происходит между 0,5 и 1 IΔn (ТКП 339-2022, п. 8.7.15).</td></tr><tr><td class=\"m\">AC, A, F, B</td><td>Тип по форме тока утечки, на который реагирует УЗО или дифавтомат.</td><td>См. таблицу типов ниже.</td></tr><tr><td class=\"m\">S</td><td>Селективное УЗО с выдержкой времени отключения.</td><td>Ставят на вводе перед УЗО на 30 мА, чтобы при утечке на линии отключалась только она. Условие селективности: уставка и время вводного УЗО не менее чем втрое больше (ТКП 339-2022, табл. 4.4.47).</td></tr><tr><td class=\"m\">Im, I(m), 500 А</td><td>Номинальная включающая и отключающая способность УЗО: ток замыкания, который оно выдерживает, пока его не отключит автомат перед ним.</td><td>УЗО без защиты от сверхтока ставят только в паре с автоматом (ТКП 339-2022, п. 8.7.8). Номинал автомата не выше указанного изготовителем.</td></tr><tr><td class=\"m\">T, кнопка «Тест»</td><td>Проверка механизма УЗО искусственной утечкой.</td><td>Нажимают периодически по паспорту изготовителя. Аппарат должен отключиться. Если нет, его заменяют.</td></tr></tbody></table></div></div><div class=\"e-step\"><div class=\"e-sech\"><small>Б</small><h3>Характеристика автомата: B, C или D</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Характеристика</th><th>Срабатывание мгновенного расцепителя</th><th>Где применяют</th></tr></thead><tbody><tr><td class=\"m\">B</td><td>3–5 In</td><td>Освещение, длинные линии с малым током короткого замыкания, нагрузки без пусковых токов.</td></tr><tr><td class=\"m\">C</td><td>5–10 In</td><td>Розеточные группы и бытовые приборы, смешанная нагрузка. Обычный выбор для квартир.</td></tr><tr><td class=\"m\">D</td><td>10–20 In</td><td>Электродвигатели, насосы, компрессоры, трансформаторы, оборудование с большими пусковыми токами.</td></tr></tbody></table></div><p class=\"e-note\">Автомат не отключается при токе 1,13 In в течение часа и отключается в течение часа при токе 1,45 In (ГОСТ IEC 60898-1, для аппаратов до 63 А). Значения кратностей зависят от изготовителя: берите из паспорта.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>В</small><h3>Тип УЗО и дифавтомата</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Тип</th><th>На какие токи утечки реагирует</th><th>Для чего применяют</th></tr></thead><tbody><tr><td class=\"m\">AC</td><td>Синусоидальный переменный ток</td><td>Освещение, нагреватели, приборы без электроники. Для электронной техники не подходит.</td></tr><tr><td class=\"m\">A</td><td>Переменный и пульсирующий постоянный ток</td><td>Стиральные и посудомоечные машины, плиты с электроникой, регулируемые светильники, телевизоры, компьютеры. Обычный выбор для квартир (ТКП 339-2022, п. 8.7.10).</td></tr><tr><td class=\"m\">F</td><td>Как тип A, плюс токи смешанных частот</td><td>Однофазные приборы с частотным преобразователем: инверторные кондиционеры, насосы и стиральные машины с инвертором.</td></tr><tr><td class=\"m\">B</td><td>Как тип F, плюс гладкий постоянный ток</td><td>Трёхфазные частотные преобразователи, зарядные станции электромобилей, источники бесперебойного питания, если изготовитель оборудования требует тип B.</td></tr></tbody></table></div></div><div class=\"e-step\"><div class=\"e-sech\"><small>Г</small><h3>Дифавтомат или автомат с УЗО</h3></div><p>Дифавтомат ставят на отдельную линию: при утечке отключается только она, остальной дом остаётся с электричеством. Он занимает один-два модуля и стоит дороже пары «автомат и УЗО». Общее УЗО на несколько линий дешевле, но при утечке на любой из них отключаются все линии за ним. Номинальный ток такого УЗО не меньше номинала автомата, который его защищает. Для морозильника, котла и других линий, где отключение нежелательно, лучше отдельный дифавтомат.</p><p>Норма допускает один УЗО на несколько линий, если у каждой свой автомат (ТКП 339-2022, п. 8.7.11). Суммарный ток утечки сети и приборов не более трети номинального тока УЗО (п. 8.7.14).</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>Д</small><h3>Куда какие аппараты ставить</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Место в схеме</th><th>Какие аппараты ставят</th><th>Основание</th></tr></thead><tbody><tr><td>Ввод в здание: ВУ, ВРУ, ГРЩ</td><td>На вводе питающей линии: аппарат управления и аппарат защиты (автомат считается и тем и другим). На каждой отходящей линии: аппарат защиты. Аппараты управления на отходящих линиях ставят на каждую или один общий на несколько.</td><td>ТКП 339-2022, п. 8.3.3, 8.3.4; СН 4.04.01, п. 9.10</td></tr><tr><td>Распределительные линии жилого дома</td><td>Нагрузка одной линии от ВРУ, как правило, не более 250 А. Когда к линии присоединено несколько стояков питания квартир, а дом выше пяти этажей, на ответвлении к каждому стояку ставят отключающий аппарат.</td><td>СН 4.04.01, п. 9.11, 9.12</td></tr><tr><td>Общедомовое освещение и силовые потребители</td><td>Питание от ГРЩ или ВРУ. Освещение лестниц, коридоров, входов и домофоны питают прямо от ГРЩ (ВРУ) или щитка управления освещением в электрощитовой. Лифты, насосы, вентиляторы — отдельная силовая сеть. В общественных зданиях на каждую линию рабочего, аварийного и эвакуационного освещения свой аппарат защиты и управления.</td><td>СН 4.04.01, п. 9.12, 9.13</td></tr><tr><td>Системы противопожарной защиты</td><td>Для них обязательны аппараты с электромагнитным расцепителем (отсечкой), допускаются автоматы только с отсечкой. Аппараты на ГРЩ (ВРУ) окрашивают в красный цвет. УЗО на такие линии ставить запрещено.</td><td>СН 4.04.01, п. 9.5, 10.2, 16.3.2</td></tr><tr><td>Этажный щиток</td><td>Групповой щиток для квартир ставят на лестничной клетке, в холле или в коридоре этажа. Предохранители в квартирных щитках вне квартир не допускаются. Счётчики размещают в отдельном отсеке, защитно-коммутационную аппаратуру в этом отсеке не ставят. Перед счётчиком прямого включения ставят коммутационный аппарат с опломбированием, снимающий напряжение со всех фаз; в многоквартирных домах он вне квартиры.</td><td>ТКП 339-2022, п. 8.3.6, 8.6.9, 8.6.10; СН 4.04.01, п. 10.2, 15.2</td></tr><tr><td>После счётчика</td><td>Аппарат защиты не дальше 3 м по длине проводки от счётчика. Если после счётчика отходят несколько линий со своими аппаратами защиты, общий не нужен. Если эти аппараты стоят вне помещения счётчика, ставят общий отключающий аппарат.</td><td>СН 4.04.01, п. 15.3; ТКП 339-2022, п. 8.6.11</td></tr><tr><td>Квартирный щиток</td><td>Вводной автомат, затем групповые автоматы и дифавтоматы. На вводе в квартиру или дом предусматривают УЗО до 300 мА для защиты от возгорания. В жилых зданиях УЗО рекомендуется ставить в квартирных щитках, допускается в этажных. Одно УЗО до 30 мА может выполнять обе функции. Расчётная нагрузка до 12 кВт: однофазный ввод, больше: трёхфазный.</td><td>СН 4.04.01, п. 9.12, 16.3.5; ТКП 339-2022, п. 8.7.12, 8.7.16, 8.7.17</td></tr><tr><td>Групповые линии</td><td>Каждая линия имеет свой автомат. В двух- и трёхфазных групповых линиях однополюсные автоматы и предохранители запрещены. Для лампы мощностью 10 кВт и более нужен свой аппарат защиты. Нулевые N и PE разных линий не объединяют. УЗО для защиты людей ставят на отдельные линии, разрешается одно УЗО на несколько линий через отдельные автоматы.</td><td>СН 4.04.01, п. 7.1.2, 7.1.6, 16.3.6</td></tr></tbody></table></div></div><div class=\"e-step\"><div class=\"e-sech\"><small>Е</small><h3>Требования к УЗО: сейчас и по новым нормам</h3></div><p>Изменение № 2 к СН 4.04.01-2019 введено постановлением Министерства архитектуры и строительства от 17 сентября 2026 г. № 75 и вступает в силу через 60 календарных дней после официального опубликования. До этого действуют правила из средней колонки. Официальную дату вступления смотрите на сайте Национального фонда ТНПА.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Линия</th><th>Сейчас: СН 4.04.01 с Изм. № 1, ТКП 339-2022</th><th>По Изм. № 2 к СН 4.04.01</th></tr></thead><tbody><tr><td>Розеточные группы</td><td>УЗО обязательно (ТКП 339-2022, п. 8.7.4)</td><td>УЗО обязательно, до 30 мА при расчётном токе до 32 А</td></tr><tr><td>Светильники общего освещения</td><td>УЗО не требуется, кроме особо опасных помещений при низкой установке и ванных</td><td>УЗО требуется для светильников общего освещения, кроме аварийного освещения</td></tr><tr><td>Электроплита</td><td>Отдельная линия, розетка и автомат не менее 32 А, УЗО до 30 мА. При расчётном токе больше 32 А УЗО не более 100 мА и 100 мс</td><td>То же. Учитывают блокировки изготовителя, ограничивающие максимальную мощность плиты</td></tr><tr><td>Электроводонагреватели и приборы отопления</td><td>УЗО для электроводонагревателей в квартирах и коттеджах, для стиральных и посудомоечных машин, плит (ТКП 339-2022, п. 8.7.4)</td><td>УЗО для электроводонагревателей и приборов отопления</td></tr><tr><td>Тёплые полы и обогрев поверхностей</td><td>УЗО обязательно</td><td>УЗО обязательно</td></tr><tr><td>Ванные и душевые</td><td>УЗО на электроприёмники классов 01 и I</td><td>УЗО на электроприёмники класса I</td></tr><tr><td>Зарядка электромобилей</td><td>В списке нет</td><td>УЗО на линию, кроме случаев, когда зарядная станция сама оснащена УЗО по ГОСТ IEC 61851-1</td></tr><tr><td>Помещения с постоянным пребыванием детей и беременных женщин</td><td>Общее правило: до 30 мА</td><td>УЗО до 10 мА</td></tr><tr><td>УЗО как мера защиты</td><td>Дополняет защиту от сверхтока и не заменяет основные виды защиты</td><td>Прямой запрет использовать УЗО как единственную меру защиты от поражения током</td></tr></tbody></table></div></div><div class=\"e-step\"><div class=\"e-sech\"><small>Ж</small><h3>Что выбрать для линии</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Линия или нагрузка</th><th>Аппарат</th><th>Основание</th></tr></thead><tbody><tr><td>Розеточные группы</td><td>Дифавтомат или УЗО до 30 мА с автоматом C16 при кабеле 2,5 мм²</td><td>Норма: УЗО (СН 4.04.01, п. 16.3.3, 16.3.13). Номинал 16 А: практика, определяется кабелем</td></tr><tr><td>Общее освещение</td><td>Автомат B10 или C10. По Изм. № 2 добавляют УЗО до 30 мА или ставят дифавтомат</td><td>Норма: УЗО по Изм. № 2 (п. 16.3.3). B10: практика</td></tr><tr><td>Стиральная и посудомоечная машины</td><td>Дифавтомат C16, 30 мА, тип A</td><td>Норма: УЗО (ТКП 339-2022, п. 8.7.4). Тип A: практика по п. 8.7.10</td></tr><tr><td>Электроплита</td><td>Автомат не менее 32 А с УЗО</td><td>Норма: СН 4.04.01, п. 11.19, 16.3.13</td></tr><tr><td>Водонагреватель</td><td>Автомат по току нагрузки с УЗО до 30 мА</td><td>Норма: СН 4.04.01, п. 16.3.3, 16.3.13</td></tr><tr><td>Двигатели, насосы, компрессоры</td><td>Автомат C или D по пусковому току. При инверторном приводе УЗО тип F или B</td><td>Практика: по данным изготовителя</td></tr><tr><td>Зарядная станция электромобиля</td><td>По требованию изготовителя станции: УЗО тип A с контролем постоянной составляющей или тип B</td><td>Изм. № 2 к СН 4.04.01 (п. 16.3.3), ГОСТ IEC 61851-1. Тип УЗО: практика</td></tr></tbody></table></div></div><div class=\"e-basis\"><b>На чём основан справочник</b><p>Нормы Беларуси: ТКП 339-2022 (разд. 8, подразд. 4.4) и СН 4.04.01-2019 с изменениями № 1 и № 2. Изменение № 2 заменило в СН 4.04.01 ссылки на ТКП 339 ссылками на СН 4.04.05-2025, поэтому статус ТКП 339-2022 для внутренних сетей проверьте на сайте Нацфонда ТНПА. подробности по приёмке есть в карточках «Автоматические выключатели» и «УЗО» раздела «Качество работ». Система обозначений общая международная, по ГОСТ IEC 60898-1 (автоматы), ГОСТ IEC 61008-1 (УЗО), ГОСТ IEC 61009-1 (дифавтоматы). Текстов этих ГОСТ в материалах сайта нет, поэтому обозначения перед публикацией сверяет технический специалист. Конкретный аппарат всегда читают по его паспорту.</p></div></section><section class=\"e-panel\" id=\"ref\" data-panel=\"ref\"><div class=\"e-sech\"><small>07</small><h2>Справочник мощностей приборов</h2></div><p class=\"e-lead2\">Типичные диапазоны. Кнопка «В расчёт» переносит верхнее значение в калькулятор «Подбор кабеля». Точное значение смотрите на шильдике прибора.</p><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Прибор</th><th>Мощность, кВт</th><th></th></tr></thead><tbody><tr><td>Чайник</td><td class=\"m\">1,8–2,2</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.2\">В расчёт</button></td></tr><tr><td>Стиральная машина</td><td class=\"m\">2,0–2,5</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.5\">В расчёт</button></td></tr><tr><td>Посудомоечная машина</td><td class=\"m\">1,8–2,2</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.2\">В расчёт</button></td></tr><tr><td>Духовой шкаф</td><td class=\"m\">2,0–3,5</td><td><button class=\"e-link\" type=\"button\" data-kw=\"3.5\">В расчёт</button></td></tr><tr><td>Варочная панель</td><td class=\"m\">3,5–7,0</td><td><button class=\"e-link\" type=\"button\" data-kw=\"7.0\">В расчёт</button></td></tr><tr><td>Микроволновка</td><td class=\"m\">0,8–1,5</td><td><button class=\"e-link\" type=\"button\" data-kw=\"1.5\">В расчёт</button></td></tr><tr><td>Утюг</td><td class=\"m\">1,8–2,4</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.4\">В расчёт</button></td></tr><tr><td>Холодильник</td><td class=\"m\">0,15–0,4</td><td><button class=\"e-link\" type=\"button\" data-kw=\"0.4\">В расчёт</button></td></tr></tbody></table></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Калькуляторы дают ориентир для сметы и для разговора с электриком. Они не заменяют проект электроснабжения, который выполняет проектировщик по нормам ТКП 339 и серии IEC 60364. Допустимые токи, пороги срабатывания, нормы освещённости (гигиенический норматив, постановление Минздрава № 82 от 28.06.2012) и коэффициенты перед публикацией проверит технический специалист.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/elec.js?v=4\"></script><script src=\"/static/apparaty.js?v=3\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstWaterTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Водоснабжение</div><h1>Водоснабжение: расчёты</h1><p class=\"e-lead\">Диаметр водопровода, потери давления, нагрев воды, скважинный насос и гидроаккумулятор с инструкцией по настройке бака.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\" class=\"on\" aria-current=\"page\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Водоснабжение: расчёты\"><a href=\"#wdiam\" data-sub=\"wdiam\">Диаметр</a><a href=\"#wpress\" data-sub=\"wpress\">Потери давления</a><a href=\"#wheat\" data-sub=\"wheat\">Нагрев воды</a><a href=\"#pump\" data-sub=\"pump\">Скважинный насос</a><a href=\"#tank\" data-sub=\"tank\">Гидроаккумулятор</a><a href=\"#tanksetup\" data-sub=\"tanksetup\">Настройка бака</a></div><div class=\"e-elec\" id=\"e-inzh\" data-page=\"water\"><section class=\"e-panel\" id=\"wdiam\" data-panel=\"wdiam\"><div class=\"e-sech\"><small>01</small><h2>Диаметр водопровода</h2></div><p class=\"e-lead2\">Укажите, сколько приборов подключено к трубе. Калькулятор сложит их расходы, учтёт, что все краны одновременно не открывают, и подберёт трубу по допустимой скорости воды.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"wd-umyv\">Число: умывальник</label><div class=\"e-in\"><input id=\"wd-umyv\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"wd-mojka\">Число: кухонная мойка</label><div class=\"e-in\"><input id=\"wd-mojka\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"wd-dush\">Число: душ</label><div class=\"e-in\"><input id=\"wd-dush\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"wd-vanna\">Число: ванна</label><div class=\"e-in\"><input id=\"wd-vanna\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"></div></div><div class=\"e-f\"><label for=\"wd-wc\">Число: унитаз</label><div class=\"e-in\"><input id=\"wd-wc\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"wd-stir\">Число: стиральная машина</label><div class=\"e-in\"><input id=\"wd-stir\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"wd-posud\">Число: посудомоечная машина</label><div class=\"e-in\"><input id=\"wd-posud\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div></div><fieldset class=\"e-seg\"><legend>Материал труб</legend><label><input type=\"radio\" name=\"wd-s\" value=\"ppr\" checked><span>Полипропилен PP-R, PN20</span></label><label><input type=\"radio\" name=\"wd-s\" value=\"mp\"><span>Металлопластик</span></label></fieldset><div class=\"e-row\"><div class=\"e-f\"><label for=\"wd-vmax\">Допустимая скорость</label><div class=\"e-in\"><input id=\"wd-vmax\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,5\"><span class=\"u\">м/с</span></div></div></div><p class=\"e-note\">Расходы приборов типовые, холодная и горячая вода суммируются. Одновременность принята как 1 ÷ √(n − 1), не меньше 0,2. Уточните расходы по паспортам приборов.</p><div class=\"e-formula\">d = √(4 · Q ÷ (π · v))<br>Q — расход, м³/с; v — скорость воды; q = Σq₀ ÷ √(n − 1)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Расчётный расход</span><b id=\"wd-q\">—</b></div><div class=\"kv\"><span>Приборов</span><b id=\"wd-n\">—</b></div><div class=\"kv\"><span>Одновременность</span><b id=\"wd-k\">—</b></div><div class=\"kv\"><span>Диаметр по скорости</span><b id=\"wd-d\">—</b></div><div class=\"kv\"><span>Труба</span><b id=\"wd-pipe\">—</b></div><div class=\"kv\"><span>Скорость</span><b id=\"wd-v\">—</b></div><div class=\"kv\"><span>Потери</span><b id=\"wd-r\">—</b></div><div class=\"verdict\" id=\"wd-verdict\" role=\"status\"></div><button class=\"e-btn wide\" id=\"wd-to\" type=\"button\">Перенести в расчёт потерь давления</button></div></div></div></section><section class=\"e-panel\" id=\"wpress\" data-panel=\"wpress\"><div class=\"e-sech\"><small>02</small><h2>Потери давления в трубе</h2></div><p class=\"e-lead2\">Сколько давления потеряется по пути до прибора. Расчёт по формуле Дарси — Вейсбаха, местные сопротивления берутся добавкой к потерям по длине.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"wp-q\">Расход</label><div class=\"e-in\"><input id=\"wp-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,4\"><span class=\"u\">л/с</span></div></div><div class=\"e-f\"><label for=\"wp-d\">Внутренний диаметр</label><div class=\"e-in\"><input id=\"wp-d\" inputmode=\"decimal\" autocomplete=\"off\" value=\"16,6\"><span class=\"u\">мм</span></div></div><div class=\"e-f\"><label for=\"wp-mat\">Материал трубы</label><div class=\"e-in\"><select id=\"wp-mat\"><option value=\"plastic\" selected>Пластик</option><option value=\"copper\">Медь</option><option value=\"steel\">Сталь</option></select></div></div></div><fieldset class=\"e-seg\"><legend>Вода</legend><label><input type=\"radio\" name=\"wp-t\" value=\"cold\" checked><span>Холодная вода</span></label><label><input type=\"radio\" name=\"wp-t\" value=\"hot\"><span>Горячая вода 60 °С</span></label></fieldset><div class=\"e-row\"><div class=\"e-f\"><label for=\"wp-l\">Длина трубы</label><div class=\"e-in\"><input id=\"wp-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"wp-loc\">Местные сопротивления</label><div class=\"e-in\"><input id=\"wp-loc\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">% от потерь по длине</span></div></div><div class=\"e-f\"><label for=\"wp-p\">Давление на входе</label><div class=\"e-in\"><input id=\"wp-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3,0\"><span class=\"u\">бар</span></div></div><div class=\"e-f\"><label for=\"wp-h\">Подъём до прибора</label><div class=\"e-in\"><input id=\"wp-h\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">м</span></div></div></div><div class=\"e-formula\">ΔP = λ · (L ÷ d) · ρv² ÷ 2<br>λ — по формуле Свейми — Джейна, шероховатость по материалу</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Скорость</span><b id=\"wp-v\">—</b></div><div class=\"kv\"><span>Число Рейнольдса</span><b id=\"wp-re\">—</b></div><div class=\"kv\"><span>Потери на метр</span><b id=\"wp-r\">—</b></div><div class=\"kv\"><span>Потери всего</span><b id=\"wp-loss\">—</b></div><div class=\"kv\"><span>Давление у прибора</span><b id=\"wp-end\">—</b></div><div class=\"verdict\" id=\"wp-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"wheat\" data-panel=\"wheat\"><div class=\"e-sech\"><small>03</small><h2>Нагрев воды</h2></div><p class=\"e-lead2\">Сколько времени греется бойлер и какая мощность нужна проточному нагревателю. Ток помогает выбрать автомат в разделе «Электрика».</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"wh-v\">Объём бойлера</label><div class=\"e-in\"><input id=\"wh-v\" inputmode=\"decimal\" autocomplete=\"off\" value=\"80\"><span class=\"u\">л</span></div></div><div class=\"e-f\"><label for=\"wh-p\">Мощность бойлера</label><div class=\"e-in\"><input id=\"wh-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,0\"><span class=\"u\">кВт</span></div></div><div class=\"e-f\"><label for=\"wh-t1\">Температура на входе</label><div class=\"e-in\"><input id=\"wh-t1\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"wh-t2\">Нужная температура</label><div class=\"e-in\"><input id=\"wh-t2\" inputmode=\"decimal\" autocomplete=\"off\" value=\"55\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"wh-qm\">Расход проточного</label><div class=\"e-in\"><input id=\"wh-qm\" inputmode=\"decimal\" autocomplete=\"off\" value=\"6\"><span class=\"u\">л/мин</span></div></div></div><div class=\"e-formula\">E = V · (t₂ − t₁) · 4,19 ÷ 3600, кВт·ч<br>P = Q · (t₂ − t₁) · 4,19 ÷ 60, кВт (Q в л/мин)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Энергия на нагрев</span><b id=\"wh-e\">—</b></div><div class=\"kv\"><span>Время нагрева бойлера</span><b id=\"wh-t\">—</b></div><div class=\"kv\"><span>Мощность проточного</span><b id=\"wh-kw\">—</b></div><div class=\"kv\"><span>Ток, 1 фаза 230 В</span><b id=\"wh-a1\">—</b></div><div class=\"kv\"><span>Ток, 3 фазы 400 В</span><b id=\"wh-a3\">—</b></div><div class=\"verdict\" id=\"wh-verdict\" role=\"status\"></div><a class=\"e-btn wide\" href=\"{{ p }}/spravochniki/elektrika#apparaty\">Подобрать автомат и УЗО</a></div></div></div></section><section class=\"e-panel\" id=\"pump\" data-panel=\"pump\"><div class=\"e-sech\"><small>04</small><h2>Скважинный насос</h2></div><p class=\"e-lead2\">Какой напор и подачу искать в каталоге насосов. Расчёт учитывает глубину воды, длину трассы, потери в трубе и давление, которое должно быть в доме.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"pu-q\">Нужный расход (пик)</label><div class=\"e-in\"><input id=\"pu-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"40\"><span class=\"u\">л/мин</span></div></div><div class=\"e-f\"><label for=\"pu-deb\">Дебит скважины</label><div class=\"e-in\"><input id=\"pu-deb\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м³/ч</span></div></div><div class=\"e-f\"><label for=\"pu-hd\">Динамический уровень воды</label><div class=\"e-in\"><input id=\"pu-hd\" inputmode=\"decimal\" autocomplete=\"off\" value=\"25\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pu-l\">Горизонтальная трасса до дома</label><div class=\"e-in\"><input id=\"pu-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pu-d\">Внутренний диаметр трубы</label><div class=\"e-in\"><input id=\"pu-d\" inputmode=\"decimal\" autocomplete=\"off\" value=\"26\"><span class=\"u\">мм</span></div></div><div class=\"e-f\"><label for=\"pu-dz\">Высота самого верхнего крана над устьем</label><div class=\"e-in\"><input id=\"pu-dz\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"pu-poff\">Давление отключения реле</label><div class=\"e-in\"><input id=\"pu-poff\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3,0\"><span class=\"u\">бар</span></div></div><div class=\"e-f\"><label for=\"pu-loc\">Местные сопротивления</label><div class=\"e-in\"><input id=\"pu-loc\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">%</span></div></div><div class=\"e-f\"><label for=\"pu-res\">Запас напора</label><div class=\"e-in\"><input id=\"pu-res\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">%</span></div></div></div><p class=\"e-note\">Динамический уровень — расстояние от поверхности до воды, когда насос уже работает: его берут из паспорта скважины. Внутренний диаметр: труба ПНД 32 мм даёт примерно 26 мм, 40 мм даёт около 33 мм.</p><div class=\"e-formula\">H = Hдин + Δz + hтр + P ÷ (ρg), м<br>Pвал = ρ · g · Q · H ÷ η, η ≈ 0,45 для небольших скважинных насосов</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Нужный напор</span><b id=\"pu-h\">—</b></div><div class=\"kv\"><span>Подача</span><b id=\"pu-flow\">—</b></div><div class=\"kv\"><span>Потери в трубе</span><b id=\"pu-fr\">—</b></div><div class=\"kv\"><span>Глубина подвеса</span><b id=\"pu-depth\">—</b></div><div class=\"kv\"><span>Мощность на воде</span><b id=\"pu-ph\">—</b></div><div class=\"kv\"><span>Мотор насоса</span><b id=\"pu-pm\">—</b></div><div class=\"kv\"><span>Ток, ориентир</span><b id=\"pu-i\">—</b></div><div class=\"verdict\" id=\"pu-verdict\" role=\"status\"></div><button class=\"e-btn wide\" id=\"pu-to\" type=\"button\">Перенести в расчёт гидроаккумулятора</button></div></div></div></section><section class=\"e-panel\" id=\"tank\" data-panel=\"tank\"><div class=\"e-sech\"><small>05</small><h2>Гидроаккумулятор (мембранный бак)</h2></div><p class=\"e-lead2\">Объём бака, чтобы насос не включался слишком часто, и давление воздуха в нём. Это не расширительный бак отопления: он держит давление воды и сглаживает пуски насоса.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"hb-q\">Подача насоса</label><div class=\"e-in\"><input id=\"hb-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"40\"><span class=\"u\">л/мин</span></div></div><div class=\"e-f\"><label for=\"hb-z0\">Допустимо пусков в час, не более</label><div class=\"e-in\"><input id=\"hb-z0\" inputmode=\"decimal\" autocomplete=\"off\" value=\"15\"></div></div><div class=\"e-f\"><label for=\"hb-on\">Давление включения реле</label><div class=\"e-in\"><input id=\"hb-on\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,5\"><span class=\"u\">бар</span></div></div><div class=\"e-f\"><label for=\"hb-off\">Давление отключения реле</label><div class=\"e-in\"><input id=\"hb-off\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3,0\"><span class=\"u\">бар</span></div></div><div class=\"e-f\"><label for=\"hb-rate\">Рабочее давление бака</label><div class=\"e-in\"><input id=\"hb-rate\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">бар</span></div></div></div><div class=\"e-formula\">Vполезный = 15 · Q ÷ Z (худший случай: расход потребителя вдвое меньше подачи насоса)<br>V = Vполезный ÷ (P₀ · (1 ÷ Pвкл − 1 ÷ Pоткл)); давления абсолютные, P₀ = Pвкл − 0,2 бар</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Полезный объём воды</span><b id=\"hb-use\">—</b></div><div class=\"kv\"><span>Воздух в баке без воды</span><b id=\"hb-pre\">—</b></div><div class=\"kv\"><span>Расчётный объём бака</span><b id=\"hb-v\">—</b></div><div class=\"kv\"><span>Ближайший бак</span><b id=\"hb-tank\">—</b></div><div class=\"kv\"><span>Пусков в час с этим баком</span><b id=\"hb-z\">—</b></div><div class=\"verdict\" id=\"hb-verdict\" role=\"status\"></div><button class=\"e-btn wide\" id=\"hb-go\" type=\"button\">Как настроить бак</button></div></div></div></section><section class=\"e-panel\" id=\"tanksetup\" data-panel=\"tanksetup\"><div class=\"e-sech\"><small>06</small><h2>Настройка мембранного бака</h2></div><p class=\"e-lead2\">Порядок действий от проверки воздуха до настройки реле давления. Числа берутся из расчёта на предыдущей вкладке.</p><p class=\"e-note\" id=\"hb-ins\"></p><div class=\"e-step\"><div class=\"e-sech\"><small>01</small><h3>Отключите насос и слейте воду из бака</h3></div><p>Выключите автомат насоса. Откройте кран и слейте воду, пока давление в системе не станет нулевым. Воздух в баке проверяют только без воды: иначе манометр покажет давление воды, а не воздуха.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>02</small><h3>Измерьте давление воздуха</h3></div><p>Снимите колпачок с ниппеля на баке (как на автомобильном колесе) и замерьте давление автомобильным манометром. Манометр на гребёнке для этого не подходит, его шкала грубая.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>03</small><h3>Доведите воздух до нужного значения</h3></div><p>Давление воздуха ставят на 0,2 бар ниже давления включения реле: при включении на 1,5 бар в баке нужно 1,3 бар. Недостающее подкачайте автомобильным или ручным насосом, лишнее стравите через ниппель. После этого закрутите колпачок.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>04</small><h3>Заполните бак и проверьте реле</h3></div><p>Включите насос. Следите по манометру, при каком давлении насос отключится. Заводские значения реле часто 1,4 и 2,8 бар. Нужные значения (включение и отключение) вы получили в расчёте выше.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>05</small><h3>Настройте реле давления</h3></div><p>Отключите питание: крышка реле находится под напряжением. У распространённых реле типа РМ/5 большая гайка с пружиной задаёт давление включения: по часовой стрелке оно растёт вместе с давлением отключения. Малая гайка задаёт разницу между включением и отключением: по часовой стрелке отключение растёт, включение не меняется. Меняйте гайки на четверть-пол-оборота, включайте питание и проверяйте по манометру. Для вашей модели сверьтесь с инструкцией.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>06</small><h3>Проверьте режим работы</h3></div><p>Откройте кран: насос включится при заданном давлении. Закройте кран: насос отключится при заданном давлении и не должен включаться без разбора воды. Давление отключения должно быть ниже, чем рабочее давление бака, и меньше максимального напора насоса хотя бы на 0,5 бар.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>07</small><h3>Раз в полгода проверяйте воздух</h3></div><p>Падение давления воздуха проверяйте как в шаге 2, при пустом баке. Частые пуски насоса, рывки воды и скачки стрелки говорят о недостатке воздуха. Если из ниппеля течёт вода, мембрана порвана: бак нужно менять или менять мембрану.</p></div><div class=\"e-basis\"><b>Безопасность</b><p>Перед работой с реле и проводкой выключите автомат. Не пытайтесь разбирать бак, пока в нём есть давление. Давления и порядок настройки зависят от модели бака и реле, поэтому инструкция производителя главнее этой.</p></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Это ориентировочные расчёты для сметы и разговора с проектировщиком, а не проект. Формулы взяты из гидравлики и теплотехники, числа нормативов — из справочника «Качество работ». Окончательные значения проверяют по действующим СН и ТКП и по паспортам оборудования. Нормы монтажа ХВС и ГВС (уклоны, гильзы, расстояния, испытания) смотрите в «Качество работ».</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/inzh.js?v=9\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstSewerTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Канализация</div><h1>Канализация: расчёты</h1><p class=\"e-lead\">Диаметр отвода по приборам, уклон и перепад высот, подбор септика для коттеджа или дачи и статья о септиках, станциях биоочистки и полях фильтрации.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\" class=\"on\" aria-current=\"page\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Канализация: расчёты\"><a href=\"#sewart\" data-sub=\"sewart\" class=\"art\">Септики и СБО</a><a href=\"#sdiam\" data-sub=\"sdiam\">Диаметр</a><a href=\"#sslope\" data-sub=\"sslope\">Уклон</a><a href=\"#septic\" data-sub=\"septic\">Септик</a><a href=\"#sguide\" data-sub=\"sguide\">Сравнение</a><a href=\"#sref\" data-sub=\"sref\">Справка</a></div><div class=\"e-elec\" id=\"e-inzh\" data-page=\"sewer\"><section class=\"e-panel\" id=\"sewart\" data-panel=\"sewart\"><div class=\"e-sech\"><small>01</small><h2>Септики, станции биоочистки и поля фильтрации</h2></div><p class=\"e-lead2\">Какую схему локальной канализации выбрать под грунт и уровень воды, как посчитать объём и поле, где ставить и что принять у подрядчика. Цифры своего участка подставьте в калькулятор «Септик».</p><div class=\"e-kpis\"><div class=\"e-kpi\"><b>150–200 л</b><span>стока на человека в сутки: основа расчёта</span></div><div class=\"e-kpi\"><b>×3 суток</b><span>минимальное пребывание стока в септике</span></div><div class=\"e-kpi\"><b>30–60 %</b><span>очистка в самом септике: этого мало</span></div><div class=\"e-kpi\"><b>≥ 1 м</b><span>от дна фильтрации до грунтовых вод</span></div></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 108\" role=\"img\" aria-label=\"Шесть шагов проекта локальной канализации\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"6\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"18\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">1</text><text x=\"18\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Сток и грунт</text><text x=\"18\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">расход, грунт, УГВ</text><text x=\"127\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"132\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"144\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">2</text><text x=\"144\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Тип схемы</text><text x=\"144\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">септик или СБО</text><text x=\"253\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"258\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"270\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">3</text><text x=\"270\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Объём</text><text x=\"270\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">3 суток притока</text><text x=\"379\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"384\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"396\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">4</text><text x=\"396\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Доочистка</text><text x=\"396\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">поле или СБО</text><text x=\"505\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"510\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"522\" y=\"36\" font-size=\"20\" fill=\"#9a9ca3\" text-anchor=\"start\" font-weight=\"700\">5</text><text x=\"522\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Монтаж</text><text x=\"522\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">уклон, вентиляция</text><text x=\"631\" y=\"58\" font-size=\"18\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">›</text><rect x=\"636\" y=\"8\" width=\"116\" height=\"92\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"648\" y=\"36\" font-size=\"20\" fill=\"#ffd0d4\" text-anchor=\"start\" font-weight=\"700\">6</text><text x=\"648\" y=\"62\" font-size=\"14\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Сервис</text><text x=\"648\" y=\"82\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">ил, журнал</text></svg><figcaption>Шесть шагов: сток и грунт, тип схемы, объём, доочистка, монтаж, сервис. Ошибка на первом шаге, когда не известны грунт и уровень грунтовых вод, обесценивает все остальные.</figcaption></figure><div class=\"e-basis\"><b>Главный принцип</b><p>Схему выбирают грунт и уровень грунтовых вод, а не бюджет и не «мощность станции». Песок и низкая вода дают дешёвую почвенную доочистку. Глина или вода выше 1,5 м от дна фильтрации означают станцию биоочистки или поле в насыпи. Остальное детали исполнения.</p></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Две стадии: септик готовит сток, очищает аэробная стадия</h3></div><p class=\"e-lead2\">Локальная канализация это цепочка из двух стадий. Первая механическая и анаэробная: в септике взвесь оседает, жиры всплывают, а осадок медленно сбраживается. Вторая аэробная: доочистка в грунте (поле фильтрации, фильтрующий колодец) или в станции биоочистки с аэрацией. Сам по себе септик снимает лишь часть загрязнений, поэтому выпускать из него воду в канаву или на рельеф нельзя: нужна вторая стадия и законный путь отвода воды.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 780 262\" role=\"img\" aria-label=\"Четыре базовых решения: накопитель, септик, станция биоочистки, почвенная доочистка\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"100\" y=\"22\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Накопитель</text><text x=\"100\" y=\"40\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">стоки только хранятся</text><rect x=\"10\" y=\"62\" width=\"180\" height=\"190\" rx=\"0\" fill=\"#eceef0\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"10\" y1=\"62\" x2=\"190\" y2=\"62\" stroke=\"#4a4d55\" stroke-width=\"2\"/><text x=\"290\" y=\"22\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Септик, 2–3 камеры</text><text x=\"290\" y=\"40\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">осветление и сбраживание</text><rect x=\"200\" y=\"62\" width=\"180\" height=\"190\" rx=\"0\" fill=\"#eceef0\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"200\" y1=\"62\" x2=\"380\" y2=\"62\" stroke=\"#4a4d55\" stroke-width=\"2\"/><text x=\"480\" y=\"22\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Станция биоочистки</text><text x=\"480\" y=\"40\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">аэрация, активный ил</text><rect x=\"390\" y=\"62\" width=\"180\" height=\"190\" rx=\"0\" fill=\"#eceef0\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"390\" y1=\"62\" x2=\"570\" y2=\"62\" stroke=\"#4a4d55\" stroke-width=\"2\"/><text x=\"670\" y=\"22\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Почвенная доочистка</text><text x=\"670\" y=\"40\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">поле или фильтрующий колодец</text><rect x=\"580\" y=\"62\" width=\"180\" height=\"190\" rx=\"0\" fill=\"#eceef0\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"580\" y1=\"62\" x2=\"760\" y2=\"62\" stroke=\"#4a4d55\" stroke-width=\"2\"/><rect x=\"35\" y=\"78\" width=\"130\" height=\"150\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><rect x=\"37\" y=\"150\" width=\"126\" height=\"76\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"88\" y=\"62\" width=\"24\" height=\"16\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"100\" y1=\"54\" x2=\"100\" y2=\"78\" stroke=\"#e3000f\" stroke-width=\"2\"/><polygon points=\"100,78 96.1,69.9 103.9,69.9\" fill=\"#e3000f\"/><text x=\"122\" y=\"56\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">откачка</text><text x=\"100\" y=\"192\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">стоки</text><text x=\"100\" y=\"208\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">накапливаются</text><rect x=\"212\" y=\"78\" width=\"156\" height=\"150\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><rect x=\"214\" y=\"112\" width=\"152\" height=\"114\" rx=\"0\" fill=\"#d6d8dc\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"266\" y1=\"78\" x2=\"266\" y2=\"190\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><line x1=\"318\" y1=\"78\" x2=\"318\" y2=\"190\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><rect x=\"278\" y=\"62\" width=\"20\" height=\"16\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"196\" y1=\"105\" x2=\"212\" y2=\"105\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"212,105 203.9,108.9 203.9,101.1\" fill=\"#1d1f23\"/><line x1=\"368\" y1=\"190\" x2=\"390\" y2=\"190\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"390,190 381.9,193.9 381.9,186.1\" fill=\"#1d1f23\"/><text x=\"239\" y=\"150\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">осадок</text><text x=\"292\" y=\"150\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">вода</text><text x=\"343\" y=\"150\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">вода</text><text x=\"290\" y=\"218\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">в грунт: поле</text><rect x=\"402\" y=\"78\" width=\"156\" height=\"150\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><rect x=\"404\" y=\"112\" width=\"152\" height=\"114\" rx=\"0\" fill=\"#d6d8dc\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"480\" y1=\"78\" x2=\"480\" y2=\"175\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><rect x=\"414\" y=\"62\" width=\"30\" height=\"16\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"450\" y=\"74\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">компрессор</text><circle cx=\"426\" cy=\"190\" r=\"4\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><circle cx=\"442\" cy=\"170\" r=\"4\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><circle cx=\"458\" cy=\"188\" r=\"4\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><circle cx=\"430\" cy=\"156\" r=\"4\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><circle cx=\"452\" cy=\"148\" r=\"4\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><rect x=\"418\" y=\"205\" width=\"50\" height=\"6\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"442\" y=\"222\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">аэратор</text><text x=\"520\" y=\"150\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">осветлитель</text><line x1=\"558\" y1=\"190\" x2=\"580\" y2=\"190\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"580,190 571.9,193.9 571.9,186.1\" fill=\"#1d1f23\"/><text x=\"480\" y=\"244\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">отвод очищенной воды</text><rect x=\"594\" y=\"96\" width=\"152\" height=\"30\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"594\" y1=\"90\" x2=\"746\" y2=\"90\" stroke=\"#4a4d55\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/><text x=\"670\" y=\"84\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">геотекстиль</text><line x1=\"600\" y1=\"104\" x2=\"740\" y2=\"104\" stroke=\"#1d1f23\" stroke-width=\"4\"/><text x=\"670\" y=\"119\" font-size=\"10\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"400\">щебень 20–40 мм</text><rect x=\"594\" y=\"126\" width=\"152\" height=\"44\" rx=\"0\" fill=\"#d6d8dc\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"670\" y=\"152\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">песок</text><line x1=\"608\" y1=\"172\" x2=\"608\" y2=\"196\" stroke=\"#7d8089\" stroke-width=\"1.5\"/><polygon points=\"608,196 604.1,187.9 611.9,187.9\" fill=\"#7d8089\"/><line x1=\"629\" y1=\"172\" x2=\"629\" y2=\"196\" stroke=\"#7d8089\" stroke-width=\"1.5\"/><polygon points=\"629,196 625.1,187.9 632.9,187.9\" fill=\"#7d8089\"/><line x1=\"650\" y1=\"172\" x2=\"650\" y2=\"196\" stroke=\"#7d8089\" stroke-width=\"1.5\"/><polygon points=\"650,196 646.1,187.9 653.9,187.9\" fill=\"#7d8089\"/><line x1=\"671\" y1=\"172\" x2=\"671\" y2=\"196\" stroke=\"#7d8089\" stroke-width=\"1.5\"/><polygon points=\"671,196 667.1,187.9 674.9,187.9\" fill=\"#7d8089\"/><line x1=\"692\" y1=\"172\" x2=\"692\" y2=\"196\" stroke=\"#7d8089\" stroke-width=\"1.5\"/><polygon points=\"692,196 688.1,187.9 695.9,187.9\" fill=\"#7d8089\"/><line x1=\"713\" y1=\"172\" x2=\"713\" y2=\"196\" stroke=\"#7d8089\" stroke-width=\"1.5\"/><polygon points=\"713,196 709.1,187.9 716.9,187.9\" fill=\"#7d8089\"/><line x1=\"734\" y1=\"172\" x2=\"734\" y2=\"196\" stroke=\"#7d8089\" stroke-width=\"1.5\"/><polygon points=\"734,196 730.1,187.9 737.9,187.9\" fill=\"#7d8089\"/><text x=\"670\" y=\"222\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">впитывание</text><text x=\"670\" y=\"238\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">и очистка в грунте</text></svg><figcaption>Разрезы четырёх базовых решений. Накопитель ничего не очищает. Септик готовит сток: оседает взвесь и сбраживается осадок. Окончательную очистку даёт аэробная стадия: станция или грунт.</figcaption></figure><figure class=\"e-fig\"><svg viewBox=\"0 0 780 300\" role=\"img\" aria-label=\"Ориентировочное снижение органической нагрузки (БПК) по схемам\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"250.0\" y1=\"14\" x2=\"250.0\" y2=\"240\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"250.0\" y=\"258\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><line x1=\"338.0\" y1=\"14\" x2=\"338.0\" y2=\"240\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"338.0\" y=\"258\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><line x1=\"426.0\" y1=\"14\" x2=\"426.0\" y2=\"240\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"426.0\" y=\"258\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">40</text><line x1=\"514.0\" y1=\"14\" x2=\"514.0\" y2=\"240\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"514.0\" y=\"258\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">60</text><line x1=\"602.0\" y1=\"14\" x2=\"602.0\" y2=\"240\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"602.0\" y=\"258\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">80</text><line x1=\"690.0\" y1=\"14\" x2=\"690.0\" y2=\"240\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"690.0\" y=\"258\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">100</text><text x=\"238\" y=\"46\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Накопитель</text><rect x=\"250\" y=\"30\" width=\"5\" height=\"22\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"264\" y=\"46\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">очистки нет, только хранение</text><text x=\"238\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Септик без доочистки</text><rect x=\"382.0\" y=\"74\" width=\"132.0\" height=\"22\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"522.0\" y=\"90\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">30–60 %</text><text x=\"238\" y=\"134\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Септик + почвенная доочистка</text><rect x=\"624.0\" y=\"118\" width=\"44.0\" height=\"22\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"676.0\" y=\"134\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">85–95 %</text><text x=\"238\" y=\"178\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Станция биоочистки</text><rect x=\"646.0\" y=\"162\" width=\"35.2\" height=\"22\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"689.2\" y=\"178\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">90–98 %</text><text x=\"238\" y=\"222\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">СБО + биофильтр или мембрана</text><rect x=\"668.0\" y=\"206\" width=\"17.6\" height=\"22\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"693.6\" y=\"222\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">95–99 %</text><text x=\"470.0\" y=\"282\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">снижение БПК (органической нагрузки), %</text></svg><figcaption>Ориентиры по литературе и паспортам (для станции берут значение из паспорта): диапазоны зависят от нагрузки, температуры и обслуживания. Разрыв между «септик сам по себе» и схемами с аэробной стадией принципиальный. Фактическое качество очистки берут из паспорта изделия и протоколов испытаний.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Схема</th><th>Как работает</th><th>Когда подходит</th><th>Главные ограничения</th></tr></thead><tbody><tr><td>Накопительная ёмкость</td><td>Герметичный резервуар, стоки вывозит ассенизатор</td><td>Дача с редкими приездами, водоохранная зона, нет грунта и электричества</td><td>Рейсы идут постоянно: при постоянном проживании это десятки рейсов в год (график ниже)</td></tr><tr><td>Септик + поле или фильтрующий колодец</td><td>Камеры осветляют сток, грунт доочищает</td><td>Песок, супесь, глубокие грунтовые воды, свободный участок</td><td>Нужна площадь и разрывы, ил откачивают раз в 1–2 года, поле работает 10–15 лет</td></tr><tr><td>Станция биоочистки (СБО)</td><td>Аэротенк с компрессором и активным илом</td><td>Глина, высокая вода, малый участок, постоянное проживание</td><td>Электричество, сервис, чувствительна к химии и отключению света; воду надо куда-то отвести</td></tr><tr><td>СБО + биофильтр или мембрана</td><td>Дополнительная ступень очистки</td><td>Сброс в водоём, водозащитная зона, повторное использование воды</td><td>Дорогая и сложная в сервисе, нужна проверка протоколов испытаний</td></tr><tr><td>Неэлектрический биофильтр</td><td>Загрузка с биоплёнкой без компрессора</td><td>Нет стабильного питания, простой режим</td><td>Нужен чистый сток без залпов, периодическая замена загрузки</td></tr></tbody></table></div><div class=\"e-basis\"><b>Куда деть очищенную воду</b><p>Процент очистки не решает вопрос отвода воды. С 01.01.2027 физическим лицам запрещён сброс любых сточных вод за границу участка (Водный кодекс, Закон №148-З, п. 8 ст. 48): очищенная вода от станции должна уходить в поле фильтрации или дренаж в пределах участка по проекту. Детали и ссылки в разделе 4.</p></div><p class=\"e-lead2\">Тенденции последних лет: удаление азота и фосфора, повторное использование воды для полива, телеметрия и аварийная сигнализация в приложении. Для частного дома в первую очередь важнее простое: правильный грунт, объём по расчёту и обслуживание по журналу.</p></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Грунт и уровень воды решают, какая схема вообще возможна</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Грунт</th><th>Вода глубже 2,5 м</th><th>Вода 1,5–2,5 м</th><th>Вода выше 1,5 м</th></tr></thead><tbody><tr><td>Песок</td><td>септик + поле фильтрации</td><td>септик + поле с дренажом ниже</td><td>поле в насыпи или СБО</td></tr><tr><td>Супесь</td><td>септик + поле или колодец</td><td>поле с усиленной подушкой</td><td>СБО с отводом воды</td></tr><tr><td>Суглинок</td><td>септик + большое поле</td><td>поле в насыпи, дренаж</td><td>СБО, каскад или кассета</td></tr><tr><td>Глина</td><td>поле не работает: СБО или насыпь</td><td>СБО с отводом воды</td><td>СБО + кассета или вывоз</td></tr></tbody></table></div><figure class=\"e-fig\"><svg viewBox=\"0 0 780 330\" role=\"img\" aria-label=\"Ориентировочная нагрузка на поле фильтрации по типам грунта\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"120.0\" y1=\"16\" x2=\"120.0\" y2=\"224\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"120.0\" y=\"242\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><line x1=\"235.55555555555554\" y1=\"16\" x2=\"235.55555555555554\" y2=\"224\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"235.55555555555554\" y=\"242\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><line x1=\"351.1111111111111\" y1=\"16\" x2=\"351.1111111111111\" y2=\"224\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"351.1111111111111\" y=\"242\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">40</text><line x1=\"466.6666666666667\" y1=\"16\" x2=\"466.6666666666667\" y2=\"224\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"466.6666666666667\" y=\"242\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">60</text><line x1=\"582.2222222222222\" y1=\"16\" x2=\"582.2222222222222\" y2=\"224\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"582.2222222222222\" y=\"242\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">80</text><text x=\"108\" y=\"54\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Песок</text><rect x=\"293.33333333333337\" y=\"36\" width=\"288.88888888888886\" height=\"24\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"582.2\" y1=\"30\" x2=\"582.2\" y2=\"66\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"592.2222222222222\" y=\"54\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">30–80</text><text x=\"108\" y=\"104\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Супесь</text><rect x=\"235.55555555555554\" y=\"86\" width=\"115.55555555555556\" height=\"24\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"351.1\" y1=\"80\" x2=\"351.1\" y2=\"116\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"361.1111111111111\" y=\"104\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">20–40</text><text x=\"108\" y=\"154\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Суглинок</text><rect x=\"177.77777777777777\" y=\"136\" width=\"57.77777777777778\" height=\"24\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"235.6\" y1=\"130\" x2=\"235.6\" y2=\"166\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"245.55555555555554\" y=\"154\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">10–20</text><text x=\"108\" y=\"204\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Глина</text><rect x=\"120\" y=\"186\" width=\"4\" height=\"24\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"134\" y=\"204\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">почти не впитывает: поле не работает</text><text x=\"380.0\" y=\"266\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">нагрузка на 1 м² фильтрации, л/сут (ориентир)</text><rect x=\"460\" y=\"284\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"478\" y=\"295\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">значение в калькуляторе «Септик»</text></svg><figcaption>Нагрузка на 1 м² поля фильтрации, л/сут. Диапазон показывает разброс по справочникам и практике, красная метка — значение, которое взято в калькуляторе «Септик». Для проекта нагрузку принимают по испытанию грунта, при сомнении берут нижнюю границу.</figcaption></figure><p class=\"e-lead2\">Уровень воды берут не по соседскому колодцу, а замером на участке в самый высокий период, весной. Ориентир калькулятора: от дна траншеи фильтрации до воды не меньше 1 м. При глубине дна 1,2 м вода должна лежать глубже 2,2 м, поэтому в таблице граница стоит около 2,5 м.</p><p class=\"e-note\">Диапазон нагрузки зависит от фракции песка, температуры и возраста поля: новое поле принимает больше, чем зарастающее. Для проекта нагрузку подтверждают испытанием грунта в шурфе.</p></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Расчёт: объём септика, площадь поля и накопитель</h3></div><p class=\"e-lead2\">Суточный сток Q = число жильцов × расход на человека + добавка (баня, гости, полив). Для стока до 5 м³/сут объём септика V = 3 · Q: трое суток пребывания. До 1 м³/сут делают две камеры (75 % и 25 % объёма), больше этого три (50 %, 25 %, 25 %). Для станции мощность берут по паспорту: в нём указано число пользователей и суточный объём, а не объём ёмкости.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"Расчётный объём септика на 3 суток притока для 2, 4 и 6 жильцов\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"70\" y1=\"30\" x2=\"70\" y2=\"250\" stroke=\"#4a4d55\" stroke-width=\"1\"/><line x1=\"70\" y1=\"250\" x2=\"710\" y2=\"250\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"14\" y=\"22\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">объём септика, м³</text><line x1=\"66\" y1=\"250.0\" x2=\"710\" y2=\"250.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"254.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0</text><line x1=\"66\" y1=\"195.0\" x2=\"710\" y2=\"195.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"199.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">1</text><line x1=\"66\" y1=\"140.0\" x2=\"710\" y2=\"140.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"144.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">2</text><line x1=\"66\" y1=\"85.0\" x2=\"710\" y2=\"85.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"89.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">3</text><line x1=\"66\" y1=\"30.0\" x2=\"710\" y2=\"30.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"34.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">4</text><rect x=\"110\" y=\"200.5\" width=\"56\" height=\"49.5\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"138\" y=\"192.5\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">0,9</text><rect x=\"176\" y=\"184.0\" width=\"56\" height=\"66.0\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"204\" y=\"176.0\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">1,2</text><text x=\"171\" y=\"270\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">2 чел.</text><rect x=\"310\" y=\"151.0\" width=\"56\" height=\"99.0\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"338\" y=\"143.0\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">1,8</text><rect x=\"376\" y=\"118.0\" width=\"56\" height=\"132.0\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"404\" y=\"110.0\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">2,4</text><text x=\"371\" y=\"270\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">4 чел.</text><rect x=\"510\" y=\"101.5\" width=\"56\" height=\"148.5\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"538\" y=\"93.5\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">2,7</text><rect x=\"576\" y=\"52.0\" width=\"56\" height=\"198.0\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"604\" y=\"44.0\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">3,6</text><text x=\"571\" y=\"270\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">6 чел.</text><rect x=\"260\" y=\"12\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"278\" y=\"22\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">150 л/чел·сут</text><rect x=\"260\" y=\"32\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"278\" y=\"42\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">200 л/чел·сут</text></svg><figcaption>Объём септика V = 3 · Q: трое суток притока при 150 и 200 л на человека в сутки. Запас на гостей добавляется отдельно. Объём возьмите ближайший большой из типоряда ёмкостей.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Жильцов</th><th>Расход, л/чел·сут</th><th>Q, м³/сут</th><th>V = 3 · Q, м³</th><th>С запасом 20 %, м³</th><th>Ближайший типоразмер, м³</th><th>Камеры</th><th>Накопитель на 14 суток, м³</th></tr></thead><tbody><tr><td>2</td><td>150</td><td>0,30</td><td>0,9</td><td>1,1</td><td>1,5</td><td>две</td><td>4,2</td></tr><tr><td>2</td><td>200</td><td>0,40</td><td>1,2</td><td>1,4</td><td>1,5</td><td>две</td><td>5,6</td></tr><tr><td>4</td><td>150</td><td>0,60</td><td>1,8</td><td>2,2</td><td>2,5</td><td>две</td><td>8,4</td></tr><tr><td>4</td><td>200</td><td>0,80</td><td>2,4</td><td>2,9</td><td>3,0</td><td>две</td><td>11,2</td></tr><tr><td>6</td><td>150</td><td>0,90</td><td>2,7</td><td>3,2</td><td>4,0</td><td>две</td><td>12,6</td></tr><tr><td>6</td><td>200</td><td>1,20</td><td>3,6</td><td>4,3</td><td>5,0</td><td>три</td><td>16,8</td></tr></tbody></table></div><p class=\"e-note\">Запас 20 % на гостей это практика, а не норматив: если дом посещают редко, его можно не закладывать. Типоразмеры 1; 1,5; 2; 2,5; 3; 4; 5; 6; 8; 10 м³ как в калькуляторе «Септик»; у производителей ряд может отличаться.</p><h4 class=\"e-h4\">Площадь поля фильтрации</h4><p class=\"e-lead2\">Площадь подошвы поля = суточный сток ÷ нагрузка на грунт. Первая цифра в ячейке считается по значению калькулятора, вторая по нижней границе диапазона. Разница в два-три раза показывает, зачем проектировщик берёт испытание грунта.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Расход (200 л/чел·сут)</th><th>Песок, м²</th><th>Супесь, м²</th><th>Суглинок, м²</th></tr></thead><tbody><tr><td>2 чел., 400 л/сут</td><td>5 / 13</td><td>10 / 20</td><td>20 / 40</td></tr><tr><td>4 чел., 800 л/сут</td><td>10 / 27</td><td>20 / 40</td><td>40 / 80</td></tr><tr><td>6 чел., 1 200 л/сут</td><td>15 / 40</td><td>30 / 60</td><td>60 / 120</td></tr></tbody></table></div><p class=\"e-note\">Это площадь подошвы фильтрации, а не участка: с учётом траншей, расстояний между ними и разрывов надо отдельно проверить, что поле помещается на участок.</p><h4 class=\"e-h4\">Что с накопителем</h4><p class=\"e-lead2\">Накопитель решает вопрос только там, где стока мало. При постоянном проживании семьи он превращается в график вывоза: ёмкость на 4 м³ при расходе 0,8 м³ в сутки наполняется за пять дней.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 300\" role=\"img\" aria-label=\"Число рейсов ассенизатора в год при накопительной ёмкости\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"70\" y1=\"30\" x2=\"70\" y2=\"250\" stroke=\"#4a4d55\" stroke-width=\"1\"/><line x1=\"70\" y1=\"250\" x2=\"710\" y2=\"250\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"14\" y=\"22\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">рейсов ассенизатора в год</text><line x1=\"66\" y1=\"250.0\" x2=\"710\" y2=\"250.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"254.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0</text><line x1=\"66\" y1=\"195.0\" x2=\"710\" y2=\"195.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"199.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">30</text><line x1=\"66\" y1=\"140.0\" x2=\"710\" y2=\"140.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"144.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">60</text><line x1=\"66\" y1=\"85.0\" x2=\"710\" y2=\"85.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"89.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">90</text><line x1=\"66\" y1=\"30.0\" x2=\"710\" y2=\"30.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"34.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">120</text><rect x=\"110\" y=\"216.54166666666669\" width=\"56\" height=\"33.45833333333333\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"138\" y=\"208.54166666666669\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">18</text><rect x=\"176\" y=\"183.08333333333334\" width=\"56\" height=\"66.91666666666666\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"204\" y=\"175.08333333333334\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">36</text><text x=\"171\" y=\"270\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">2 чел.</text><rect x=\"310\" y=\"183.08333333333334\" width=\"56\" height=\"66.91666666666666\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"338\" y=\"175.08333333333334\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">36</text><rect x=\"376\" y=\"116.16666666666669\" width=\"56\" height=\"133.83333333333331\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"404\" y=\"108.16666666666669\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">73</text><text x=\"371\" y=\"270\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">4 чел.</text><rect x=\"510\" y=\"149.625\" width=\"56\" height=\"100.375\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"538\" y=\"141.625\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">55</text><rect x=\"576\" y=\"49.25\" width=\"56\" height=\"200.75\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"604\" y=\"41.25\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">110</text><text x=\"571\" y=\"270\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">6 чел.</text><rect x=\"260\" y=\"12\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"278\" y=\"22\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">100 л/чел·сут (дача)</text><rect x=\"260\" y=\"32\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"278\" y=\"42\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">200 л/чел·сут (дом)</text></svg><figcaption>Сколько раз в год нужно откачивать накопитель при машине на 4 м³. Для семьи из четырёх человек в доме с полным благоустройством это около 73 рейсов, то есть примерно раз в пять дней.</figcaption></figure></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Размещение на участке и санитарные разрывы</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 780 312\" role=\"img\" aria-label=\"План участка: размещение дома, септика, поля фильтрации, колодца и бани\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"8\" y=\"8\" width=\"764\" height=\"296\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><rect stroke-dasharray=\"9 6\" x=\"40\" y=\"30\" width=\"700\" height=\"200\" rx=\"0\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"2.5\"/><text x=\"52\" y=\"48\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"700\">граница участка</text><rect x=\"8\" y=\"262\" width=\"764\" height=\"42\" rx=\"0\" fill=\"#dcdde0\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"390\" y=\"288\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">улица</text><rect x=\"80\" y=\"70\" width=\"170\" height=\"84\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"3\"/><text x=\"165\" y=\"118\" font-size=\"16\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">ДОМ</text><rect x=\"560\" y=\"60\" width=\"90\" height=\"50\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><text x=\"605\" y=\"90\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">баня, сарай</text><circle cx=\"215\" cy=\"190\" r=\"17\" fill=\"#1d1f23\"/><text x=\"215\" y=\"194\" font-size=\"9\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"400\">септик</text><rect stroke-dasharray=\"7 5\" x=\"380\" y=\"150\" width=\"150\" height=\"54\" rx=\"0\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><text x=\"455\" y=\"182\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">поле фильтрации</text><circle cx=\"95\" cy=\"196\" r=\"17\" fill=\"#e3000f\"/><text x=\"95\" y=\"200\" font-size=\"9\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"400\">колодец</text><line x1=\"80\" y1=\"118\" x2=\"40\" y2=\"118\" stroke=\"#4a4d55\" stroke-width=\"1.5\"/><polygon points=\"40,118 48.1,114.1 48.1,121.9\" fill=\"#4a4d55\"/><text x=\"60\" y=\"108\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">≥ 3 м</text><line x1=\"650\" y1=\"85\" x2=\"740\" y2=\"85\" stroke=\"#4a4d55\" stroke-width=\"1.5\"/><polygon points=\"740,85 731.9,88.9 731.9,81.1\" fill=\"#4a4d55\"/><text x=\"695\" y=\"75\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">≥ 2 м</text><line x1=\"215\" y1=\"154\" x2=\"215\" y2=\"173\" stroke=\"#4a4d55\" stroke-width=\"1.5\"/><polygon points=\"215,173 211.1,164.9 218.9,164.9\" fill=\"#4a4d55\"/><text x=\"250\" y=\"170\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">≥ 5 м</text><line x1=\"250\" y1=\"140\" x2=\"380\" y2=\"160\" stroke=\"#4a4d55\" stroke-width=\"1.5\"/><polygon points=\"380,160 371.4,162.6 372.6,154.9\" fill=\"#4a4d55\"/><text x=\"318\" y=\"136\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">≥ 8 м</text><line x1=\"198\" y1=\"192\" x2=\"114\" y2=\"196\" stroke=\"#4a4d55\" stroke-width=\"1.5\"/><polygon points=\"114,196 121.9,191.7 122.3,199.5\" fill=\"#4a4d55\"/><text x=\"156\" y=\"214\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20–50 м</text><line x1=\"330\" y1=\"224\" x2=\"560\" y2=\"224\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><polygon points=\"560,224 551.9,227.9 551.9,220.1\" fill=\"#1d1f23\"/><text x=\"445\" y=\"246\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">поток подземных вод</text></svg><figcaption>Схема размещения. Расстояния до границы участка для дома и бани взяты из СН 3.01.03-2020 (с изменением №4), расстояния до септика и поля это ориентиры практики. Колодец стоит выше по потоку подземных вод, чем поле фильтрации. Все стоки остаются в пределах участка.</figcaption></figure><figure class=\"e-fig\"><img src=\"/static/img/septic-uchastok-raspolozhenie.jpg\" width=\"1536\" height=\"1024\" loading=\"lazy\" alt=\"Иллюстрация: размещение построек, септика, колодца, бассейна и водоёма на участке\"><figcaption>Иллюстрация размещения объектов на участке (на белорусском языке). Показывает ориентиры: расстояния, у которых нет нормативной ссылки в таблице ниже, это практика, а не требования. Подпись «СН 3.01.03-2020» на схеме относится к отступам построек от границы, а не к септикам, расстояния до которых определяют санитарные нормы и ТКП.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Что</th><th>Расстояние</th><th>Основание</th></tr></thead><tbody><tr><td>Жилой дом до границы участка</td><td>не менее 3 м</td><td><a href=\"https://etalonline.by/document/?regnum=w22136480p\" rel=\"noopener\">СН 3.01.03-2020</a> (постановление Минстройархитектуры №94 от 27.11.2020) с Изменением №4 (постановление №70 от 25.08.2026, официальный текст на момент проверки не найден), действует с 01.12.2026. Для нового строительства согласие соседа уменьшить отступ уже не позволяет; мерят от цоколя или стены, а не от свеса крыши</td></tr><tr><td>Баня, сарай, беседка (высотой до 3 м) до границы</td><td>не менее 2 м</td><td>СН 3.01.03-2020 (с 28.11.2023, раньше было 1 м, по публикациям); для построек выше 3 м проверяйте отдельно</td></tr><tr><td>Деревья до границы: высокие / средние / кусты</td><td>3 / 2 / 1 м</td><td>Правила благоустройства, по публикациям; сверьте с правилами своего населённого пункта</td></tr><tr><td>Между домами на соседних участках</td><td>6–15 м и больше</td><td>СН 2.02.05-2020 (пожарные разрывы), зависит от огнестойкости домов</td></tr><tr><td>Септик до дома</td><td>не менее 5 м</td><td>санитарные нормы, ориентир практики</td></tr><tr><td>Фильтрующий колодец, поле до дома</td><td>8–12 м</td><td>ориентир практики; растёт с объёмом стоков</td></tr><tr><td>Питьевой колодец от возможных источников загрязнения</td><td>50 м выше по потоку</td><td><a href=\"https://etalonline.by/document/?q_id=0&regnum=w210p0195\" rel=\"noopener\">СанНиП, постановление Минздрава №105 от 02.08.2010</a>, п. 6; в сложившейся застройке меньше по ТКП 45-4.01-30-2009 (п. 8)</td></tr><tr><td>Септик, поле: до границы, дороги, деревьев</td><td>1–4 / 5 / 3–4 м</td><td>ориентиры практики, проектом могут быть уточнены</td></tr></tbody></table></div><p class=\"e-note\">Расстояния от септика и поля до границы участка и дороги в найденных публикациях нормативом не подтверждены: это типовые значения практики. Их согласуют проектом и местными требованиями.</p><div class=\"e-basis\"><b>Что меняется с 2027 года</b><p>По новой редакции Водного кодекса (Закон от 01.06.2026 №148-З) с 01.01.2027 физические лица, кроме ИП, не вправе сбрасывать любые сточные воды за границу своего участка (п. 8 ст. 48), в том числе в кювет, овраг или на соседний участок. Приёмниками названы централизованная канализация и водонепроницаемые выгребы, а стоки перед сбросом должны проходить очистные сооружения (ст. 49). Для частного дома это значит: очищенная вода остаётся на участке (поле фильтрации, фильтрующий колодец по проекту), либо герметичный накопитель с вывозом, либо подключение к сети. Нормативные акты: <a href=\"https://pravo.by/document/?guid=12551&p0=H12600148\" rel=\"noopener\">Закон от 01.06.2026 №148-З «Об изменении Водного кодекса Республики Беларусь»</a>.</p></div><ul class=\"e-ul\"><li>Поле и септик ставят <b>ниже по потоку</b> грунтовых вод, чем колодец соседей и ваш.</li><li>Подъезд ассенизатора: шланг обычно 20–30 м, люк должен быть доступен в любую погоду.</li><li>Поле не размещают в низине с застоем воды и в зоне затопления.</li></ul></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Монтаж: десять правил, которые решают всё</h3></div><ul class=\"e-ul\"><li><b>Уклон</b> выпуска и трассы около 2 % (2 см на метр) для Ø110 и не меньше 3 % для Ø50: меньше заиливание, больше вода убегает, а твёрдое остаётся.</li><li><b>Труба</b> наружная оранжевая Ø110 без контруклонов; повороты отводами 45° и ревизии на изломах.</li><li><b>Основание.</b> Постель 20–30 см песка под ёмкостью, обсыпка послойно с проливом; при высокой воде и в плывуне плита-якорь или анкерные стропы против всплытия пустой ёмкости.</li><li><b>Вентиляция.</b> Фановая труба до кровли отводит газы септика и даёт воздух полю: без неё запах в доме и закисание поля.</li><li><b>Глубина и утепление.</b> Подводящую трубу прокладывают ниже глубины промерзания (около 1 м, точное значение даёт проект) или утепляют и греют; горловину и крышку СБО утепляют: на морозе без тепла аэрация теряет биомассу.</li><li><b>Поле:</b> траншеи по уровню, щебень 20–40 мм, перфорированная труба с верхней подачей, геотекстиль между песком и щебнем, вентиляционные стояки по концам распределителя.</li><li><b>Испытание.</b> Налив водой до засыпки и контроль уровня сутки; для СБО пуск по паспорту и набор биомассы 2–4 недели.</li><li><b>Доступ.</b> Люки над камерами и распределителем выше планировочной отметки, не под плиткой и не под газоном без ревизионного кольца.</li><li><b>Ливнёвка и дренаж</b> мимо септика: дождевая вода даёт гидроудар и вымывает ил в поле.</li><li><b>Исполнительная схема</b> с привязками трасс, поля и ёмкости: через пять лет без неё поле ищут лопатой.</li></ul><div class=\"e-basis\"><b>Из практики</b><p>Септик считают люди, поле считает грунт, а отказ считает уклон: три причины большинства неисправностей.</p></div></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Эксплуатация: что делать и чего нельзя сбрасывать</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Статья</th><th>Накопитель</th><th>Септик + поле</th><th>СБО</th></tr></thead><tbody><tr><td>Электричество</td><td>нет</td><td>нет</td><td>есть, компрессор работает постоянно</td></tr><tr><td>Что делают</td><td>откачка по мере заполнения</td><td>откачка ила по журналу, чистка фильтров</td><td>сервис по паспорту, проверка аэраторов и ила</td></tr><tr><td>Ресурс</td><td>корпус десятки лет</td><td>поле 10–15 лет и зависит от нагрузки</td><td>аэраторы и мембраны заменяют по паспорту</td></tr><tr><td>Риск запаха</td><td>низкий при герметичности</td><td>средний при ошибках вентиляции</td><td>низкий при исправной аэрации</td></tr></tbody></table></div><p class=\"e-note\">Периодичность откачки ила зависит от числа жильцов и объёма: ориентируйтесь на паспорт и на заполнение первой камеры осадком. Стоимость оборудования и обслуживания запрашивайте у поставщика с паспортом изделия: у производителей цены и сроки сильно различаются.</p><p class=\"e-lead2\"><b>Что нельзя сбрасывать в септик и СБО:</b> хлорные удары и «дезинфекцию вёдрами», антибиотики и агрессивную химию, нерастворимые наполнители (наполнитель туалета, средства гигиены), кулинарный жир литрами, ливнёвку и залповый сброс бассейна. Биомасса живая: её убивают быстрее, чем успевает приехать сервис.</p></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Типичные ошибки: двенадцать способов получить болото</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. «Септик и хватит»</h4><p class=\"x\">✗ Сырой по сути сток выходит в канаву: запах, штрафы, заражение почвы.</p><p class=\"v\">✓ После септика почвенная доочистка или станция, и законный путь отвода воды.</p></div><div class=\"e-err\"><h4>2. Объём «на глаз»</h4><p class=\"x\">✗ Мало суток пребывания: взвесь уходит в поле и цементирует щебень за 2–3 года.</p><p class=\"v\">✓ V = 3 · Q и запас на гостей; для станции по паспорту.</p></div><div class=\"e-err\"><h4>3. Поле на глине или при высокой воде</h4><p class=\"x\">✗ Стоки выходят на поверхность в первый сезон.</p><p class=\"v\">✓ Насыпь, дренаж или станция с отводом воды.</p></div><div class=\"e-err\"><h4>4. Нет фановой вентиляции</h4><p class=\"x\">✗ Запах в доме и закисание поля.</p><p class=\"v\">✓ Фановая труба до кровли и стояки на концах распределителя.</p></div><div class=\"e-err\"><h4>5. Уклон 0,5 % или 5 %</h4><p class=\"x\">✗ Заиливание трубы или смыв воды без твёрдого.</p><p class=\"v\">✓ Около 2 % по лазеру, без контруклонов.</p></div><div class=\"e-err\"><h4>6. Хлор и антибиотики в СБО</h4><p class=\"x\">✗ Биомасса гибнет, очистка падает незаметно.</p><p class=\"v\">✓ Бытовая химия без хлора; после антибиотиков досев биомассы.</p></div><div class=\"e-err\"><h4>7. Нет якоря при высокой воде</h4><p class=\"x\">✗ Пустая ёмкость всплывает весной.</p><p class=\"v\">✓ Плита-якорь или стропы, послойная обсыпка с проливом.</p></div><div class=\"e-err\"><h4>8. Ливнёвка и дренаж в септик</h4><p class=\"x\">✗ Гидроудар вымывает ил и биомассу в поле.</p><p class=\"v\">✓ Раздельные контуры.</p></div><div class=\"e-err\"><h4>9. Ил «раз в пять лет»</h4><p class=\"x\">✗ Рабочий объём занят осадком, очистка падает.</p><p class=\"v\">✓ Регламент по паспорту и журнал обслуживания.</p></div><div class=\"e-err\"><h4>10. СБО без сценария на отключение света</h4><p class=\"x\">✗ Нет питания неделю: биомасса погибает.</p><p class=\"v\">✓ Сигнализация, источник питания или неэлектрический биофильтр.</p></div><div class=\"e-err\"><h4>11. Поле выше колодца по потоку</h4><p class=\"x\">✗ Нитраты и хлориды приходят в воду через годы.</p><p class=\"v\">✓ Разрыв по проекту, поле ниже по потоку, гидрогеология до проектирования.</p></div><div class=\"e-err\"><h4>12. Люк под плиткой</h4><p class=\"x\">✗ Сервис превращается в раскопки.</p><p class=\"v\">✓ Ревизионные люки и кольца выше отметки.</p></div></div></div><div class=\"e-art\" id=\"art8\"><div class=\"e-sech\"><small>8</small><h3>Симптомы: что болит у владельцев</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Симптом</th><th>Вероятная причина</th><th>Что делать</th></tr></thead><tbody><tr><td>Запах в доме</td><td>Нет фановой вентиляции, сухой сифон, забитый стояк</td><td>Проверить фановую трубу, залить сифоны, прочистить ревизию</td></tr><tr><td>Вода в поле стоит на поверхности</td><td>Грунт не принимает, засорение щебня, высокая вода весной</td><td>Проверить площадь и грунт, дать полю отдых, при необходимости переделать</td></tr><tr><td>Септик переполнен, вода уходит медленно</td><td>Ил занял объём, забит фильтр или распределитель</td><td>Откачать ил, прочистить фильтры и трубы</td></tr><tr><td>Станция шумит или пахнет</td><td>Износ компрессора, забиты аэраторы, перегрузка</td><td>Сервис по паспорту, проверить подачу воздуха и ил</td></tr><tr><td>Очистка падает после химии или антибиотиков</td><td>Гибель биомассы</td><td>Прекратить химию, пересеять биомассу по паспорту</td></tr><tr><td>Замерзает подводящая труба</td><td>Малая глубина, нет утепления, нет стока зимой</td><td>Утеплить трассу, греющий кабель, проверить уклон</td></tr></tbody></table></div></div><div class=\"e-art\" id=\"art9\"><div class=\"e-sech\"><small>9</small><h3>Чек-лист приёмки и вопросы подрядчику</h3></div><ul class=\"e-ul\"><li><b>1. Геология и уровень воды:</b> кто и когда замерял? Без этого схема лотерея.</li><li><b>2. Расчёт объёма и площади поля:</b> по каким нормам, с каким запасом на гостей?</li><li><b>3. Санитарные разрывы</b> до дома, границы и водозабора показаны на плане?</li><li><b>4. Аварийные сценарии:</b> отключение света, залповый сброс, переполнение?</li><li><b>5. Сервис:</b> кто и как часто, во сколько обойдутся вывоз ила и замена аэраторов?</li><li><b>6. Исполнительная схема</b> трасс и поля с привязками входит в сдачу?</li></ul><div class=\"e-basis\"><b>Красные флаги</b><p>«Поставим станцию помощнее, грунт не важен»; поле без расчёта площади; нет фановой трубы в смете; ёмкость без якоря при воде на глубине 1 м; гарантия «от нас» без паспорта изделия; нет гидроиспытания до засыпки. Одного пункта достаточно, чтобы не подписывать акт.</p></div><h4 class=\"e-h4\">Пять тезисов</h4><ul class=\"e-ul\"><li>Схему диктуют грунт и уровень воды: песок и глубокая вода, септик с полем; глина и высокая вода, станция.</li><li>Септик без доочистки не очистное сооружение, а подготовка стока.</li><li>Три числа спасают от болота: расход на человека, трое суток и нагрузка грунта в л/(м²·сут).</li><li>Накопитель выгоден только при малом стоке: при постоянном проживании это график рейсов ассенизатора.</li><li>Отказы живут в мелочах: уклон, фановая труба, якорь, раздельная ливнёвка, люки и исполнительная схема.</li></ul><div class=\"e-basis\"><b>Нормативная база и оговорки</b><p><b>СН 4.01.03-2019</b> «Системы внутреннего водоснабжения и канализации зданий»; <a href=\"https://etalonline.by/document/?q_id=0&regnum=w210p0195\" rel=\"noopener\"><b>СанНиП №105 от 02.08.2010</b></a> (нецентрализованное водоснабжение); <a href=\"https://etalonline.by/document/?regnum=w22136480p\" rel=\"noopener\"><b>СН 3.01.03-2020</b></a> (отступы построек); <a href=\"https://pravo.by/document/?guid=12551&p0=H12600148\" rel=\"noopener\"><b>Закон №148-З</b></a> (Водный кодекс); <b>ТКП 45-4.01-30-2009</b> (по ссылке из СанНиП); EN 12566-1/-3 (заводские септики и станции, справочно); паспорта производителей. Расстояния, нагрузки на грунт и эффективность очистки на схемах ориентировочные и не заменяют проект и гидрогеологию.</p></div><p class=\"e-note\">Калькулятор «Септик» на этой странице считает объём, поле и подбирает тип схемы по тем же формулам.</p></div></section><section class=\"e-panel\" id=\"sdiam\" data-panel=\"sdiam\"><div class=\"e-sech\"><small>02</small><h2>Диаметр канализации</h2></div><p class=\"e-lead2\">Укажите приборы на отводе или стояке. Калькулятор определяет расход стоков и подбирает трубу по наполнению и скорости.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"sd-umyv\">Число: умывальник</label><div class=\"e-in\"><input id=\"sd-umyv\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"sd-dush\">Число: душ</label><div class=\"e-in\"><input id=\"sd-dush\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"sd-vanna\">Число: ванна</label><div class=\"e-in\"><input id=\"sd-vanna\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"></div></div><div class=\"e-f\"><label for=\"sd-mojka\">Число: кухонная мойка</label><div class=\"e-in\"><input id=\"sd-mojka\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"sd-posud\">Число: посудомоечная машина</label><div class=\"e-in\"><input id=\"sd-posud\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"sd-stir\">Число: стиральная машина</label><div class=\"e-in\"><input id=\"sd-stir\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"sd-wc\">Число: унитаз</label><div class=\"e-in\"><input id=\"sd-wc\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div></div><div class=\"e-f\"><label for=\"sd-trap\">Число: трап ø 50</label><div class=\"e-in\"><input id=\"sd-trap\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"></div></div></div><fieldset class=\"e-seg\"><legend>Нагрузка</legend><label><input type=\"radio\" name=\"sd-k\" value=\"0.5\" checked><span>Квартира, дом</span></label><label><input type=\"radio\" name=\"sd-k\" value=\"0.7\"><span>Офис, гостиница</span></label><label><input type=\"radio\" name=\"sd-k\" value=\"1.0\"><span>Общественные санузлы</span></label></fieldset><div class=\"e-row\"><div class=\"e-f\"><label for=\"sd-s\">Уклон</label><div class=\"e-in\"><input id=\"sd-s\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,0\"><span class=\"u\">%</span></div></div><div class=\"e-f\"><label for=\"sd-y\">Наполнение, не более</label><div class=\"e-in\"><input id=\"sd-y\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,5\"></div></div></div><p class=\"e-note\">Метод европейского стандарта EN 12056-2 (приведённые расходы приборов). Нормы Беларуси считают по СН 4.01.03, раздел 17: для проекта сверяйтесь с ним.</p><div class=\"e-formula\">Q = K · √(ΣDU), не меньше расхода самого большого прибора<br>Пропускная способность — по формуле Маннинга, n = 0,010</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Сумма расходов приборов</span><b id=\"sd-du\">—</b></div><div class=\"kv\"><span>Расчётный расход</span><b id=\"sd-q\">—</b></div><div class=\"kv\"><span>Труба</span><b id=\"sd-dn\">—</b></div><div class=\"kv\"><span>Наполнение</span><b id=\"sd-fill\">—</b></div><div class=\"kv\"><span>Скорость</span><b id=\"sd-v\">—</b></div><div class=\"verdict\" id=\"sd-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"sslope\" data-panel=\"sslope\"><div class=\"e-sech\"><small>03</small><h2>Уклон и перепад высот</h2></div><p class=\"e-lead2\">Сколько высоты нужно на горизонтальный участок и укладывается ли он в норму. Можно задать имеющийся перепад и проверить уклон.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"ss-dn\">Диаметр трубы</label><div class=\"e-in\"><select id=\"ss-dn\"><option value=\"50\">Ø 50 мм</option><option value=\"75\">Ø 75 мм</option><option value=\"110\" selected>Ø 110 мм</option><option value=\"160\">Ø 160 мм</option></select></div></div><div class=\"e-f\"><label for=\"ss-l\">Длина участка</label><div class=\"e-in\"><input id=\"ss-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ss-s\">Принятый уклон</label><div class=\"e-in\"><input id=\"ss-s\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,0\"><span class=\"u\">%</span></div></div><div class=\"e-f\"><label for=\"ss-a\">Имеющийся перепад (если задан)</label><div class=\"e-in\"><input id=\"ss-a\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">мм</span></div></div></div><div class=\"e-formula\">Перепад = длина × уклон<br>Уклон не менее 0,03 для Ø до 50 мм и 0,02 для больших; не более 0,15</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Наименьший уклон по норме</span><b id=\"ss-min\">—</b></div><div class=\"kv\"><span>Перепад при принятом уклоне</span><b id=\"ss-drop\">—</b></div><div class=\"kv\"><span>Уклон по имеющемуся перепаду</span><b id=\"ss-have\">—</b></div><div class=\"kv\"><span>Перепад при уклоне 15 %</span><b id=\"ss-max\">—</b></div><div class=\"verdict\" id=\"ss-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"septic\" data-panel=\"septic\"><div class=\"e-sech\"><small>04</small><h2>Септик для коттеджа или дачи</h2></div><p class=\"e-lead2\">Укажите, сколько людей живёт и какой участок. Калькулятор посчитает суточный сток, объём камер, размер поля фильтрации и подскажет тип очистки: накопитель, септик с фильтрацией или станцию биологической очистки.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"se-use\">Как используется дом</label><div class=\"e-in\"><select id=\"se-use\"><option value=\"200\" selected>Постоянно: ванна, стиральная и посудомоечная машины</option><option value=\"150\">Постоянно: душ, стиральная машина</option><option value=\"100\">Дача: душ, стиральная машина</option><option value=\"50\">Дача: только кухня и умывальник</option></select></div></div><div class=\"e-f\"><label for=\"se-p\">Число жильцов</label><div class=\"e-in\"><input id=\"se-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4\"></div></div><div class=\"e-f\"><label for=\"se-ex\">Дополнительно (баня, гости, полив)</label><div class=\"e-in\"><input id=\"se-ex\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">л/сут</span></div></div><div class=\"e-f\"><label for=\"se-soil\">Грунт на участке</label><div class=\"e-in\"><select id=\"se-soil\"><option value=\"sand\" selected>Песок</option><option value=\"supes\">Супесь</option><option value=\"sugl\">Суглинок</option><option value=\"clay\">Глина</option></select></div></div><div class=\"e-f\"><label for=\"se-gw\">Грунтовые воды на глубине</label><div class=\"e-in\"><input id=\"se-gw\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"se-sd\">Глубина дна фильтрации</label><div class=\"e-in\"><input id=\"se-sd\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,2\"><span class=\"u\">м</span></div></div></div><fieldset class=\"e-seg\"><legend>Питание на участке</legend><label><input type=\"radio\" name=\"se-el\" value=\"1\" checked><span>Есть электричество</span></label><label><input type=\"radio\" name=\"se-el\" value=\"0\"><span>Нет электричества</span></label></fieldset><fieldset class=\"e-seg\"><legend>Откачка</legend><label><input type=\"radio\" name=\"se-car\" value=\"1\" checked><span>Машина-ассенизатор подъедет</span></label><label><input type=\"radio\" name=\"se-car\" value=\"0\"><span>Подъезда нет</span></label></fieldset><p class=\"e-note\">Расход воды на человека — ориентир практики (150–200 л в сутки при полном благоустройстве, 50–100 л на даче). Нагрузка на 1 м² фильтрации принята: песок 80, супесь 40, суглинок 20 л в сутки, глина воду не принимает.</p><div class=\"e-formula\">Q = n · q + Qдоп, м³/сут<br>V = 3 · Q при Q до 5 м³/сут; камеры: до 1 м³/сут две (75 % и 25 %), больше три (50 %, 25 %, 25 %)<br>Fфильтр = Q ÷ нагрузка грунта; до воды от дна фильтрации не менее 1 м</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Суточный сток</span><b id=\"se-q\">—</b></div><div class=\"kv\"><span>Объём септика</span><b id=\"se-v\">—</b></div><div class=\"kv\"><span>Камеры</span><b id=\"se-ch\">—</b></div><div class=\"kv\"><span>Ближайший объём</span><b id=\"se-std\">—</b></div><div class=\"kv\"><span>Что выбрать</span><b id=\"se-type\">—</b></div><div class=\"kv\"><span>Поле фильтрации</span><b id=\"se-field\">—</b></div><div class=\"kv\"><span>Накопитель на 14 суток</span><b id=\"se-nak\">—</b></div><div class=\"verdict\" id=\"se-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"sguide\" data-panel=\"sguide\"><div class=\"e-sech\"><small>05</small><h2>Сравнение вариантов и расстояния</h2></div><p class=\"e-lead2\">Что выбрать, когда расчёт даёт несколько вариантов, и где ставить.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Тип</th><th>Когда подходит</th><th>Плюсы</th><th>Минусы</th></tr></thead><tbody><tr><td>Накопительная ёмкость</td><td>Малый сток, дача, глина или высокая вода</td><td>Дёшево, не зависит от грунта</td><td>Платная откачка каждые 1–4 недели, нужен подъезд</td></tr><tr><td>Септик с фильтрацией в грунт</td><td>Песок или супесь, вода глубже 2,5 м</td><td>Без электричества, редкая чистка ила</td><td>Нужен участок под поле, не для глины</td></tr><tr><td>Станция биологической очистки</td><td>Высокая вода, глина, малый участок, постоянное проживание</td><td>Чистая вода на выходе, компактная</td><td>Электричество, дороже, нужен сервис, не любит долгих простоев</td></tr></tbody></table></div><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Расстояние, как правило</th><th>м</th></tr></thead><tbody><tr><td>До жилого дома: септик / поля фильтрации</td><td class=\"m\">5 / 8–12</td></tr><tr><td>До питьевого колодца или скважины (зависит от грунта)</td><td class=\"m\">20–50</td></tr><tr><td>До границы участка</td><td class=\"m\">1–4</td></tr><tr><td>До дороги</td><td class=\"m\">5</td></tr><tr><td>До деревьев</td><td class=\"m\">3–4</td></tr></tbody></table></div><p class=\"e-note\">Это типовые значения из практики. В Беларуси размещение определяется санитарными нормами и ТКП, а также решением проектировщика и санитарной службы: проверьте перед закупкой. Для станции биологической очистки следуйте паспорту производителя.</p></section><section class=\"e-panel\" id=\"sref\" data-panel=\"sref\"><div class=\"e-sech\"><small>06</small><h2>Справка по нормам</h2></div><p class=\"e-lead2\">Основные числа, на которые опираются калькуляторы этого раздела.</p><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Что</th><th>Значение</th></tr></thead><tbody><tr><td>Скорость стоков, не менее</td><td class=\"m\">0,7 м/с</td></tr><tr><td>Разрыв струи при присоединении к сети, не менее</td><td class=\"m\">25 мм</td></tr><tr><td>Стояк над плоской кровлей / скатной / эксплуатируемой</td><td class=\"m\">0,3 / 0,5 / 3,0 м</td></tr><tr><td>Трап Ø 50: душевая на 1–2 душа</td><td class=\"m\">1 шт.</td></tr><tr><td>Трап Ø 100: душевая на 3–4 душа, туалет с тремя и более унитазами</td><td class=\"m\">1 шт.</td></tr><tr><td>Шаг креплений горизонтальной чугунной канализации, не более</td><td class=\"m\">2 м</td></tr></tbody></table></div><p class=\"e-note\">Источник: СН 4.01.03-2019, ТКП 45-1.03-85-2007. Полные карточки с пунктами — в «Качество работ».</p></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Это ориентировочные расчёты для сметы и разговора с проектировщиком, а не проект. Формулы взяты из гидравлики и теплотехники, числа нормативов — из справочника «Качество работ». Окончательные значения проверяют по действующим СН и ТКП и по паспортам оборудования.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/inzh.js?v=9\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstHeatTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Отопление</div><h1>Отопление: расчёты</h1><p class=\"e-lead\">Теплопотери помещения, радиаторы, диаметр труб, тёплый пол, расширительный бак, стоимость тепла и статья о современных системах отопления.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\" class=\"on\" aria-current=\"page\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Отопление: расчёты\"><a href=\"#pipesart\" data-sub=\"pipesart\" class=\"art\">Выбор труб</a><a href=\"#overview\" data-sub=\"overview\" class=\"art\">Современные системы</a><a href=\"#hloss\" data-sub=\"hloss\">Теплопотери</a><a href=\"#radiators\" data-sub=\"radiators\">Радиаторы</a><a href=\"#hpipes\" data-sub=\"hpipes\">Трубы</a><a href=\"#floor\" data-sub=\"floor\">Тёплый пол</a><a href=\"#expansion\" data-sub=\"expansion\">Расширительный бак</a><a href=\"#cost\" data-sub=\"cost\">Стоимость тепла</a><a href=\"#expand\" data-sub=\"expand\">Удлинение труб</a></div><div class=\"e-elec\" id=\"e-inzh\" data-page=\"heat\"><section class=\"e-panel\" id=\"pipesart\" data-panel=\"pipesart\"><div class=\"e-sech\"><small>01</small><h2>Трубы отопления: как выбрать и смонтировать</h2></div><p class=\"e-lead2\">Какую трубу брать под радиаторы, тёплый пол и котельную, как не сузить проход фитингами и сваркой и куда деваться удлинению. Цифры своего проекта считайте во вкладках «Трубы» и «Удлинение труб».</p><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Диаметр и расход: труба продаётся по наружному, а вода течёт по внутреннему</h3></div><p class=\"e-lead2\">Первая тайна начинается в магазине: на ценнике наружный диаметр и PN, а пропускную способность определяет внутренний диаметр. У PP-R 20 мм с PN10 стенка тонкая (внутренний диаметр около 16,2 мм), у PN20 толстая (около 13,2 мм): проходное сечение различается примерно на 35 % у «одинаковых» двадцатых труб. Поэтому диаметр считают по расходу и скорости, а не по надписи на бухте.</p><p class=\"e-lead2\">Расход даёт простая формула G = 860 · Q ÷ ΔT, л/ч (Q в кВт, ΔT в кельвинах). Чем меньше перепад температур между подачей и обраткой, тем больше нужно качать. Скорость держат в коридоре 0,3–0,7 м/с (практический ориентир для жилья): ниже шлам оседает и воздух собирается, выше растут шум, эрозия и сопротивление.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 740 290\" role=\"img\" aria-label=\"Расход теплоносителя на 10 кВт при разных перепадах температур и скорость в трубе Ø20×2,0\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"70\" y1=\"56\" x2=\"70\" y2=\"256\" stroke=\"#4a4d55\" stroke-width=\"1\"/><line x1=\"70\" y1=\"256\" x2=\"710\" y2=\"256\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"14\" y=\"44\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">расход на 10 кВт, м³/ч</text><line x1=\"66\" y1=\"256.0\" x2=\"710\" y2=\"256.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"260.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0,0</text><line x1=\"66\" y1=\"206.0\" x2=\"710\" y2=\"206.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"210.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0,5</text><line x1=\"66\" y1=\"156.0\" x2=\"710\" y2=\"156.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"160.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">1,0</text><line x1=\"66\" y1=\"106.0\" x2=\"710\" y2=\"106.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"110.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">1,5</text><line x1=\"66\" y1=\"56.0\" x2=\"710\" y2=\"56.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"62\" y=\"60.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">2,0</text><rect x=\"110\" y=\"213.0\" width=\"90\" height=\"43.0\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"155\" y=\"187.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">в Ø20×2,0: 0,6 м/с</text><text x=\"155\" y=\"205.0\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">0,43 м³/ч</text><text x=\"155\" y=\"276\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">ΔT = 20 K</text><rect x=\"260\" y=\"198.66666666666666\" width=\"90\" height=\"57.333333333333336\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"305\" y=\"172.66666666666666\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">в Ø20×2,0: 0,8 м/с</text><text x=\"305\" y=\"190.66666666666666\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">0,57 м³/ч</text><text x=\"305\" y=\"276\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">ΔT = 15 K</text><rect x=\"410\" y=\"170.0\" width=\"90\" height=\"86.0\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"455\" y=\"144.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">в Ø20×2,0: 1,2 м/с</text><text x=\"455\" y=\"162.0\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">0,86 м³/ч</text><text x=\"455\" y=\"276\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">ΔT = 10 K</text><rect x=\"560\" y=\"84.0\" width=\"90\" height=\"172.0\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"605\" y=\"58.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">в Ø20×2,0: 2,4 м/с</text><text x=\"605\" y=\"76.0\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">1,72 м³/ч</text><text x=\"605\" y=\"276\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">ΔT = 5 K</text></svg><figcaption>Расход на 10 кВт при разных перепадах температур и скорость в трубе Ø20×2,0 (внутренний диаметр 16 мм). Низкотемпературные системы (тепловой насос, ΔT 5 K) требуют вчетверо больший расход, чем котёл с ΔT 20 K: диаметры, коллекторы и насос считают по расходу.</figcaption></figure><h4 class=\"e-h4\">Какую мощность тянет труба</h4><p class=\"e-lead2\">Мощность, которую труба передаёт при скорости 0,5 м/с, при разных перепадах температур. Для своего случая посчитайте точнее во вкладке «Трубы».</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Труба, мм</th><th>Внутренний диаметр, мм</th><th>ΔT 20 K (70/50), кВт</th><th>ΔT 10 K (55/45), кВт</th><th>ΔT 5 K (35/30, ТН), кВт</th></tr></thead><tbody><tr><td>PEX, металлопластик 16×2,0</td><td>12,0</td><td>4,6</td><td>2,3</td><td>1,2</td></tr><tr><td>20×2,0</td><td>16,0</td><td>8,3</td><td>4,1</td><td>2,1</td></tr><tr><td>25×2,3</td><td>20,4</td><td>13,4</td><td>6,7</td><td>3,4</td></tr><tr><td>32×3,0</td><td>26,0</td><td>21,8</td><td>10,9</td><td>5,5</td></tr><tr><td>40×3,7</td><td>32,6</td><td>34,3</td><td>17,1</td><td>8,6</td></tr></tbody></table></div><p class=\"e-note\">Расчёт для воды около +60 °С, плотность 980 кг/м³, теплоёмкость 4,19 кДж/(кг·К). Внутренние диаметры типовые, у разных производителей они отличаются на 0,2–1 мм.</p><p class=\"e-lead2\">Вторая тайна: <b>тепловое удлинение</b>. Полимеры расширяются в 10–12 раз сильнее стали: участок 10 м из обычного PP-R при нагреве на 50 K удлиняется на 75 мм. Этим миллиметрам нужно куда-то деваться: отсюда компенсаторы, гильзы, подвижные опоры и запрет жёстко защемлять трубу по всей длине. Свой случай посчитайте во вкладке «Удлинение труб».</p><figure class=\"e-fig\"><svg viewBox=\"0 0 740 328\" role=\"img\" aria-label=\"Тепловое удлинение участка трубы 10 м при нагреве на 50 K\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"230.0\" y1=\"10\" x2=\"230.0\" y2=\"276\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"230.0\" y=\"294\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><line x1=\"333.52941176470586\" y1=\"10\" x2=\"333.52941176470586\" y2=\"276\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"333.52941176470586\" y=\"294\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><line x1=\"437.05882352941177\" y1=\"10\" x2=\"437.05882352941177\" y2=\"276\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"437.05882352941177\" y=\"294\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">40</text><line x1=\"540.5882352941177\" y1=\"10\" x2=\"540.5882352941177\" y2=\"276\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"540.5882352941177\" y=\"294\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">60</text><line x1=\"644.1176470588235\" y1=\"10\" x2=\"644.1176470588235\" y2=\"276\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"644.1176470588235\" y=\"294\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">80</text><text x=\"220\" y=\"34\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">PP-R без армирования</text><rect x=\"230\" y=\"14\" width=\"388.2352941176471\" height=\"28\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"626.2352941176471\" y=\"34\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">75 мм</text><text x=\"220\" y=\"72\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">PEX, PE-RT</text><rect x=\"230\" y=\"52\" width=\"362.3529411764706\" height=\"28\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"600.3529411764706\" y=\"72\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">70 мм</text><text x=\"220\" y=\"110\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">PP-R + стекловолокно</text><rect x=\"230\" y=\"90\" width=\"129.41176470588235\" height=\"28\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"367.4117647058823\" y=\"110\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">25 мм</text><text x=\"220\" y=\"148\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">PP-R + алюминиевая фольга</text><rect x=\"230\" y=\"128\" width=\"90.58823529411765\" height=\"28\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"328.5882352941177\" y=\"148\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">17,5 мм</text><text x=\"220\" y=\"186\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Металлопластик PEX-AL-PEX</text><rect x=\"230\" y=\"166\" width=\"67.29411764705883\" height=\"28\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"305.29411764705884\" y=\"186\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">13 мм</text><text x=\"220\" y=\"224\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Медь</text><rect x=\"230\" y=\"204\" width=\"44.0\" height=\"28\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"282.0\" y=\"224\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">8,5 мм</text><text x=\"220\" y=\"262\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Сталь</text><rect x=\"230\" y=\"242\" width=\"31.058823529411768\" height=\"28\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"269.05882352941177\" y=\"262\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">6 мм</text><text x=\"450\" y=\"316\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">удлинение участка 10 м при ΔT = 50 K, мм</text></svg><figcaption>Удлинение участка 10 м при ΔT = 50 K: ΔL = α · L · ΔT. Для PEX и PE-RT коэффициент у разных производителей от 0,14 до 0,2 мм/(м·К), на графике нижняя граница. 75 мм это «волна», напряжения в стыках и вырванные опоры, если нет компенсации.</figcaption></figure><div class=\"e-basis\"><b>Запоминалка</b><p>Диаметр по расходу, материал по среде, фитинг по проходу, компенсация по удлинению. Эти четыре пары закрывают большинство ошибок подбора труб отопления.</p></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 106\" role=\"img\" aria-label=\"Четыре правила подбора труб отопления\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"8\" y=\"10\" width=\"172\" height=\"84\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"22\" y=\"44\" font-size=\"18\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Диаметр</text><text x=\"22\" y=\"68\" font-size=\"12\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">по расходу и скорости</text><rect x=\"196\" y=\"10\" width=\"172\" height=\"84\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"210\" y=\"44\" font-size=\"18\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Материал</text><text x=\"210\" y=\"68\" font-size=\"12\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">по среде и режиму</text><rect x=\"384\" y=\"10\" width=\"172\" height=\"84\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"398\" y=\"44\" font-size=\"18\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Фитинг</text><text x=\"398\" y=\"68\" font-size=\"12\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">по проходу, а не по надписи</text><rect x=\"572\" y=\"10\" width=\"172\" height=\"84\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"586\" y=\"44\" font-size=\"18\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Компенсация</text><text x=\"586\" y=\"68\" font-size=\"12\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">по удлинению трубы</text></svg><figcaption>Четыре пары закрывают большинство ошибок подбора труб отопления.</figcaption></figure></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Какие трубы куда: восемь семейств и матрица применения</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Труба</th><th>Режимы (класс по ГОСТ 32415)</th><th>Соединение</th><th>Сильные стороны и ограничения</th><th>Куда</th></tr></thead><tbody><tr><td>PP-R PN16/20/25 (стекло, фольга)</td><td>класс 5: до 90 °С, аварийно до 100</td><td>сварка (муфта)</td><td>Дёшев, стык монолитный, неразъёмный; большое удлинение без армирования</td><td>Открытая разводка радиаторов, ГВС</td></tr><tr><td>PP-RCT (новое поколение)</td><td>класс 5, стенка тоньше</td><td>сварка</td><td>Примерно на 15–20 % больше проходное сечение при том же наружном диаметре (по данным производителей)</td><td>То же, современный выбор</td></tr><tr><td>PEX-a/b/c + EVOH</td><td>класс 5: рабочая около 80 °С</td><td>пресс, цанга</td><td>Цельная бухта в стяжку, ремонтопригоден; память формы у PEX-a</td><td>Тёплые полы, скрытая разводка</td></tr><tr><td>PE-RT / PE-RT II + EVOH</td><td>класс 4–5</td><td>пресс, цанга, сварка (II)</td><td>Дешевле PEX; PE-RT II подходит и для уличных сетей</td><td>Тёплые полы; PE-RT II наружные теплосети</td></tr><tr><td>Металлопластик PEX-AL-PEX</td><td>класс 5: до 95 °С</td><td>пресс (цанга только открыто)</td><td>Держит форму, удлинение 0,026 мм/(м·К); пресс дороже</td><td>Радиаторы, стояки, обвязка</td></tr><tr><td>Медь</td><td>до 110 °С и выше</td><td>пайка, пресс</td><td>Долговечна, держит перегрев ТТ-котла; дорога, не терпит алюминия в контуре</td><td>Котельные, премиум, обвязка ТТ-котла</td></tr><tr><td>Сталь (ВГП, бесшовная)</td><td>до 115 °С, PN16 и выше</td><td>сварка, резьба</td><td>Единственная для пара и пиков ТТ; корродирует при сливах</td><td>Обвязка ТТ-котла, ИТП, стояки</td></tr><tr><td>Нержавеющая гофрированная</td><td>до 110 °С</td><td>резьбовые фитинги</td><td>Гнётся в тесноте без фитингов; стойка к разморозке</td><td>Обвязка, ремонты, сложные узлы</td></tr></tbody></table></div><h4 class=\"e-h4\">Матрица применения</h4><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Система</th><th>Оптимальная труба</th><th>Главное правило</th></tr></thead><tbody><tr><td>Тёплый пол</td><td>PEX, PE-RT + EVOH, металлопластик</td><td>Цельная петля не длиннее 80–100 м без стыков в стяжке; опрессовка до заливки</td></tr><tr><td>Радиаторы скрыто (стяжка, штроба)</td><td>PEX пресс, металлопластик пресс</td><td>Только разъёмные пресс-стыки или цельная труба; PP-R в стяжку не рекомендуется</td></tr><tr><td>Радиаторы открыто</td><td>PP-R армированный, металлопластик, медь</td><td>Компенсация и опоры по таблице; фольга или стекловолокно для прямых участков</td></tr><tr><td>Котельная газовая</td><td>Медь, сталь, нержавейка</td><td>Металл до первого запорного органа; гибкие подводки только сертифицированные</td></tr><tr><td>Котельная твердотопливная</td><td>Сталь (первые 1–1,5 м), далее медь или сталь</td><td>Полимер только после смесительного узла: защита от аварийных 110 °С</td></tr><tr><td>Уличная сеть (дом–баня, контур ЗК)</td><td>Предизолированные гибкие (PE-RT II, PEX), сталь в изоляции</td><td>УФ и промерзание: обычный PP-R и PEX на улице не живут</td></tr><tr><td>ГВС и рециркуляция</td><td>PP-R PN20 класс 2, PEX, медь</td><td>Термостойкость и стойкость к хлору; компенсация стояков гильзами</td></tr></tbody></table></div><div class=\"e-basis\"><b>Современные тенденции</b><p>PP-RCT: тоньше стенка, больше проход при том же диаметре. Пресс-технология с контролем непрессованного соединения вытеснила пайку и сварку на скрытых трассах. EVOH-барьер стал нормой для любых отопительных контуров. Предизолированные гибкие трубы (PE-RT II) закрыли нишу уличных сетей и грунтовых контуров без сварки. Часть производителей предлагает расширенную гарантию при регистрации монтажа. Заводские узлы (коллекторные блоки, насосные группы) переносят качество с площадки на завод.</p></div></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>PN, классы эксплуатации и кислород: что на самом деле написано на бухте</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 740 346\" role=\"img\" aria-label=\"Допустимое рабочее давление труб в зависимости от температуры теплоносителя\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"64\" y=\"275.0\" width=\"600\" height=\"15.0\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"74\" y=\"284.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">рабочее давление системы отопления дома: 1–2,5 бар</text><line x1=\"64\" y1=\"300.0\" x2=\"664\" y2=\"300.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"304.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0</text><line x1=\"64\" y1=\"250.0\" x2=\"664\" y2=\"250.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"254.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">5</text><line x1=\"64\" y1=\"200.0\" x2=\"664\" y2=\"200.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"204.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">10</text><line x1=\"64\" y1=\"150.0\" x2=\"664\" y2=\"150.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"154.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">15</text><line x1=\"64\" y1=\"100.0\" x2=\"664\" y2=\"100.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"104.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">20</text><line x1=\"64\" y1=\"50.0\" x2=\"664\" y2=\"50.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"54.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">25</text><text x=\"101.5\" y=\"318\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><text x=\"251.5\" y=\"318\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">40</text><text x=\"401.5\" y=\"318\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">60</text><text x=\"476.5\" y=\"318\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">70</text><text x=\"551.5\" y=\"318\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">80</text><text x=\"626.5\" y=\"318\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">90</text><polyline points=\"101.5,50.0 251.5,135.0 401.5,190.0 476.5,207.0 551.5,223.0 626.5,236.0\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"101.5\" cy=\"50.0\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"251.5\" cy=\"135.0\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"401.5\" cy=\"190.0\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"476.5\" cy=\"207.0\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"551.5\" cy=\"223.0\" r=\"4.5\" fill=\"#1d1f23\"/><circle cx=\"626.5\" cy=\"236.0\" r=\"4.5\" fill=\"#1d1f23\"/><polyline points=\"101.5,140.0 251.5,194.0 401.5,224.0 476.5,234.0 551.5,243.0 626.5,251.0\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"101.5\" cy=\"140.0\" r=\"4.5\" fill=\"#7d8089\"/><circle cx=\"251.5\" cy=\"194.0\" r=\"4.5\" fill=\"#7d8089\"/><circle cx=\"401.5\" cy=\"224.0\" r=\"4.5\" fill=\"#7d8089\"/><circle cx=\"476.5\" cy=\"234.0\" r=\"4.5\" fill=\"#7d8089\"/><circle cx=\"551.5\" cy=\"243.0\" r=\"4.5\" fill=\"#7d8089\"/><circle cx=\"626.5\" cy=\"251.0\" r=\"4.5\" fill=\"#7d8089\"/><text x=\"364.0\" y=\"340\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">температура теплоносителя, °С</text><text x=\"14\" y=\"18\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">допустимое рабочее давление, бар</text><line x1=\"494\" y1=\"44\" x2=\"522\" y2=\"44\" stroke=\"#1d1f23\" stroke-width=\"3\"/><text x=\"530\" y=\"48\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">PP-R PN25</text><line x1=\"494\" y1=\"64\" x2=\"522\" y2=\"64\" stroke=\"#7d8089\" stroke-width=\"3\"/><text x=\"530\" y=\"68\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">PEX PN16</text><text x=\"364\" y=\"90.0\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">PN — это давление при +20 °С.</text><text x=\"364\" y=\"108.0\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">При +90 °С допустимое давление падает в 3–4 раза</text></svg><figcaption>Условные кривые допустимого рабочего давления: чем горячее вода, тем ниже допустимое давление. Для отопления смотрите класс эксплуатации и кривую «давление–температура» в паспорте конкретной трубы, а не цифру PN. Значения на графике иллюстративные.</figcaption></figure><p class=\"e-lead2\">PN это номинал при +20 °С. С ростом температуры допустимое давление падает в 3–4 раза, поэтому для отопления смотрят класс эксплуатации и кривые «давление–температура», а не цифру PN.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Класс по ГОСТ 32415-2013</th><th>Назначение</th><th>Расчётная / макс. температура</th><th>Что брать</th></tr></thead><tbody><tr><td>Класс 1</td><td>ГВС 60 °С</td><td>60 / 80 °С</td><td>не для отопления</td></tr><tr><td>Класс 2</td><td>ГВС 70 °С</td><td>70 / 80 °С</td><td>не для отопления</td></tr><tr><td>Класс 4</td><td>Тёплые полы, низкотемпературное отопление</td><td>40–60 / 70 °С</td><td>тёплые полы, конденсационные системы</td></tr><tr><td>Класс 5</td><td>Высокотемпературное отопление</td><td>60–80 / 90 °С</td><td>радиаторные системы, котельные</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Кислородная диффузия</b> третья тайна: молекулы O₂ проходят сквозь стенку полимера и коррозируют сталь и латунь (насосы, котёл, радиаторы). Предел по DIN 4726 не более 0,1 г/(м³·сут) при +40 °С: ему удовлетворяют только трубы с барьером EVOH или алюминиевым слоем. «Труба без EVOH в отоплении» это отложенная коррозия за 3–5 сезонов, причём ржавеет не труба, а самое дорогое в системе.</p></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Фитинги и сварка: что сужает проход</h3></div><p class=\"e-lead2\">Каждый элемент тракта добавляет сопротивление. Вопрос не «есть ли заужение», а «сколько метров трубы оно стоит»: перегретый стык PP-R и зауженный кран эквивалентны нескольким метрам DN15 каждый, а забитый грязевик десяткам.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 342\" role=\"img\" aria-label=\"Потеря проходного сечения типовыми фитингами и арматурой\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"270.0\" y1=\"8\" x2=\"270.0\" y2=\"290\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"270.0\" y=\"308\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><line x1=\"327.14285714285717\" y1=\"8\" x2=\"327.14285714285717\" y2=\"290\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"327.14285714285717\" y=\"308\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">10</text><line x1=\"384.2857142857143\" y1=\"8\" x2=\"384.2857142857143\" y2=\"290\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"384.2857142857143\" y=\"308\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><line x1=\"441.42857142857144\" y1=\"8\" x2=\"441.42857142857144\" y2=\"290\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"441.42857142857144\" y=\"308\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">30</text><line x1=\"498.57142857142856\" y1=\"8\" x2=\"498.57142857142856\" y2=\"290\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"498.57142857142856\" y=\"308\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">40</text><line x1=\"555.7142857142858\" y1=\"8\" x2=\"555.7142857142858\" y2=\"290\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"555.7142857142858\" y=\"308\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">50</text><line x1=\"612.8571428571429\" y1=\"8\" x2=\"612.8571428571429\" y2=\"290\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"612.8571428571429\" y=\"308\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">60</text><line x1=\"670.0\" y1=\"8\" x2=\"670.0\" y2=\"290\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"670.0\" y=\"308\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">70</text><text x=\"260\" y=\"33\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Пресс-фитинг PEX 16</text><rect x=\"384.2857142857143\" y=\"12\" width=\"57.142857142857146\" height=\"30\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"449.42857142857144\" y=\"33\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">−20…−30 %</text><text x=\"260\" y=\"73\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Цанговый (резьбовой) фитинг 16</text><rect x=\"441.42857142857144\" y=\"52\" width=\"57.142857142857146\" height=\"30\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"506.57142857142856\" y=\"73\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">−30…−40 %</text><text x=\"260\" y=\"113\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Приварной стык PP-R (норма)</text><rect x=\"327.14285714285717\" y=\"92\" width=\"85.71428571428572\" height=\"30\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"420.8571428571429\" y=\"113\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">−10…−25 %</text><text x=\"260\" y=\"153\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Перегретый стык PP-R (грат внутрь)</text><rect x=\"441.42857142857144\" y=\"132\" width=\"171.42857142857144\" height=\"30\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"620.8571428571429\" y=\"153\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">−30…−60 %</text><text x=\"260\" y=\"193\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Шаровой кран стандартный (зауженный)</text><rect x=\"498.57142857142856\" y=\"172\" width=\"114.28571428571429\" height=\"30\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"620.8571428571429\" y=\"193\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">−40…−60 %</text><text x=\"260\" y=\"233\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Шаровой кран полнопроходной</text><rect x=\"287.14285714285717\" y=\"212\" width=\"40.0\" height=\"30\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"335.14285714285717\" y=\"233\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">−3…−10 %</text><text x=\"260\" y=\"273\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Термостатический клапан радиатора</text><rect x=\"441.42857142857144\" y=\"252\" width=\"114.28571428571429\" height=\"30\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"563.7142857142858\" y=\"273\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">−30…−50 %</text><text x=\"470\" y=\"330\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">потеря проходного сечения элемента, % (типовые значения)</text></svg><figcaption>Потеря проходного сечения типовыми элементами. В эквивалентной длине для DN15 зауженный кран ≈ 3–6 м трубы, отвод 90° ≈ 0,5–1 м, загрязнённый грязевик ≈ 10–20 м и растёт каждый сезон.</figcaption></figure><figure class=\"e-fig\"><svg viewBox=\"0 0 760 260\" role=\"img\" aria-label=\"Три исхода сварки PP-R: норма, перегрев, недогрев\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"120\" y=\"24\" font-size=\"16\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Норма</text><circle cx=\"120\" cy=\"100\" r=\"58\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><circle cx=\"120\" cy=\"100\" r=\"42\" fill=\"#fff\" stroke=\"#9a9ca3\" stroke-width=\"7\"/><text x=\"120\" y=\"190\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">гладкий поясок снаружи,</text><text x=\"120\" y=\"208\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">проход почти не тронут:</text><text x=\"120\" y=\"226\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">потеря сечения 10–25 %</text><text x=\"380\" y=\"24\" font-size=\"16\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"700\">Перегрев</text><circle cx=\"380\" cy=\"100\" r=\"58\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><circle cx=\"380\" cy=\"100\" r=\"40\" fill=\"#ee4a56\" stroke=\"none\"/><circle cx=\"380\" cy=\"100\" r=\"22\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"2.5\"/><text x=\"380\" y=\"190\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"400\">грат внутрь трубы:</text><text x=\"380\" y=\"208\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"400\">сечение −30…−60 %, место</text><text x=\"380\" y=\"226\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"400\">накопления шлама и засора</text><text x=\"640\" y=\"24\" font-size=\"16\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"700\">Недогрев, проворот</text><circle cx=\"640\" cy=\"100\" r=\"58\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><circle cx=\"640\" cy=\"100\" r=\"38\" fill=\"#fff\" stroke=\"#4a4d55\" stroke-width=\"2.5\"/><line x1=\"669.1096888385212\" y1=\"75.57407083191151\" x2=\"682.8984888146628\" y2=\"64.0038938575538\" stroke=\"#4a4d55\" stroke-width=\"3\"/><line x1=\"652.9967654463754\" y1=\"135.70831958986452\" x2=\"659.1531280262375\" y2=\"152.62278676401087\" stroke=\"#4a4d55\" stroke-width=\"3\"/><line x1=\"604.2916804101354\" y1=\"87.0032345536246\" x2=\"587.3772132359891\" y2=\"80.84687197376255\" stroke=\"#4a4d55\" stroke-width=\"3\"/><text x=\"640\" y=\"190\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">несплавление и трещины:</text><text x=\"640\" y=\"208\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">течь по стыку</text><text x=\"640\" y=\"226\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">через 1–3 сезона</text></svg><figcaption>Три исхода сварки PP-R: норма, перегрев (грат внутрь: скрытое заужение и будущий засор), недогрев или проворот (течь через 1–3 сезона). Перегрев не виден снаружи, в этом и опасность.</figcaption></figure><h4 class=\"e-h4\">Режимы сварки PP-R</h4><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Диаметр PP-R</th><th>Нагрев, с</th><th>Соединение, с</th><th>Охлаждение, мин</th></tr></thead><tbody><tr><td>16 мм</td><td>5</td><td>4</td><td>2</td></tr><tr><td>20 мм</td><td>6</td><td>4</td><td>2</td></tr><tr><td>25 мм</td><td>7</td><td>4</td><td>2</td></tr><tr><td>32 мм</td><td>8</td><td>6</td><td>4</td></tr><tr><td>40 мм</td><td>12</td><td>6</td><td>4</td></tr></tbody></table></div><p class=\"e-note\">Значения типовые для паяльника с терморегулятором (около 260 ± 10 °С); точные режимы смотрите в паспорте производителя трубы и в таблицах DVS 2207. Для сварки на холоде ниже +5 °С время и температуру корректируют.</p><ul class=\"e-ul\"><li><b>Что стоит системы при сварке:</b> передержка и грат внутрь; проворот после стыка и трещина; сварка «на морозе» без поправки (непровар); армированная фольгой труба без зачистки слоя (расслоение и вздутие стыка); паяльник без терморегулятора. Трубы со стекловолокном внутри зачищать не нужно, это частая перестраховка, которая вредит.</li><li><b>Контроль непрессованного соединения.</b> Многие пресс-фитинги спроектированы так, что непрессованное соединение намеренно течёт при низком давлении испытания (значение указано в паспорте фитинга). Поэтому опрессовка до закрытия отделки обязательна: она сама находит непрессованные соединения.</li><li><b>Пресс-клещи.</b> Профиль (TH, H, U и другие) задаёт производитель фитинга, чужой профиль даёт непрожим. Клещи калибруют по регламенту, повторный обжим запрещён, фитинг меняют.</li><li><b>Цанговые (резьбовые) фитинги</b> металлопластика только открыто: уплотнитель «течёт» под циклами нагрева и требует протяжки через 1–2 сезона; в стяжке это мина замедленного действия.</li><li><b>Полнопроходные шаровые краны</b> на источнике, насосе, коллекторе; зауженные допустимы только как отсечка ветвей с низкой скоростью.</li><li><b>Термостатические клапаны с преднастройкой</b> дают балансировку без приборов: сопротивление задаётся оборотами; авторитет клапана держат не ниже 0,3–0,5.</li><li><b>Гальваника.</b> Медь и алюминий (радиаторы) напрямую не соединяют: через латунные или диэлектрические вставки. Сочетание меди и стали в одном контуре допустимо по паспорту оборудования и с ингибитором, для открытых систем нежелательно.</li></ul></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Монтаж: компенсация, опоры, скрытые трассы, опрессовка</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 780 282\" role=\"img\" aria-label=\"Схема компенсации теплового удлинения трубы\" xmlns=\"http://www.w3.org/2000/svg\"><polyline points=\"30,80 170,80 170,150 270,150 270,80 410,80\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"4\" stroke-linejoin=\"round\"/><rect x=\"24\" y=\"66\" width=\"12\" height=\"28\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"404\" y=\"66\" width=\"12\" height=\"28\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"90\" y=\"74\" width=\"26\" height=\"12\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"320\" y=\"74\" width=\"26\" height=\"12\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"30\" y=\"114\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">неподвижная опора</text><text x=\"30\" y=\"128\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">(у отвода, арматуры)</text><text x=\"220\" y=\"176\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">П-компенсатор: плечи</text><text x=\"220\" y=\"192\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">«съедают» удлинение</text><text x=\"150\" y=\"46\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">подвижные опоры (направляющие): трубе нужно скользить</text><text x=\"110\" y=\"60\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\"></text><polyline points=\"470,80 640,80 640,230\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"4\" stroke-linejoin=\"round\"/><rect x=\"464\" y=\"66\" width=\"12\" height=\"28\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"540\" y=\"74\" width=\"26\" height=\"12\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"560\" y=\"46\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">L-образный поворот</text><text x=\"560\" y=\"60\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">естественный компенсатор</text><rect x=\"626\" y=\"140\" width=\"28\" height=\"70\" rx=\"0\" fill=\"#d7d9de\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"631\" y=\"140\" width=\"18\" height=\"70\" rx=\"0\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"2.5\"/><line x1=\"640\" y1=\"120\" x2=\"640\" y2=\"232\" stroke=\"#e3000f\" stroke-width=\"4\"/><text x=\"668\" y=\"160\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">стояк в гильзе:</text><text x=\"668\" y=\"176\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">зазор 5–10 мм,</text><text x=\"668\" y=\"192\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">труба скользит</text><text x=\"380\" y=\"250\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"700\">Правило: неподвижные опоры у отводов и арматуры, между ними труба свободно ползёт;</text><text x=\"380\" y=\"268\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"700\">жёстко «закрепить по всей длине» значит сломать её.</text></svg><figcaption>Компенсация удлинения: неподвижные опоры у отводов и арматуры, между ними труба скользит; П-компенсатор и L-поворот съедают миллиметры; стояки идут в гильзах с зазором.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Наружный диаметр</th><th>Шаг опор по горизонтали (горячая линия), м</th><th>По вертикали, м</th></tr></thead><tbody><tr><td>16–20 мм</td><td>0,7–0,8</td><td>1,2–1,5</td></tr><tr><td>25 мм</td><td>0,9</td><td>1,5–1,8</td></tr><tr><td>32 мм</td><td>1,0–1,1</td><td>1,8–2,0</td></tr><tr><td>40 мм</td><td>1,2–1,3</td><td>2,0–2,2</td></tr><tr><td>50 мм</td><td>1,4–1,5</td><td>2,2–2,5</td></tr></tbody></table></div><p class=\"e-note\">Значения справочные: для холодных линий шаг увеличивают в 1,5–2 раза, точный шаг по паспорту трубы и СН 4.02.03-2019.</p><ul class=\"e-ul\"><li><b>Скрытый монтаж.</b> В стяжке и монолите только цельная труба или пресс-стыки. PP-R прокладывают в каналах и шахтах с зазором на удлинение, в гильзах или изоляционной скорлупе. Исполнительная схема с привязками часть сдачи: без неё следующий гвоздь найдёт трубу.</li><li><b>Стояки, изоляция.</b> Гильза на 5–10 мм больше трубы с негорючим эластичным зазором; трубы в неотапливаемых зонах и в полу в изоляции по расчёту по СН 4.02.03-2019 (энергосбережение, конденсат на обратке теплового насоса).</li><li><b>Опрессовка.</b> Водой давлением 1,5 рабочего, но не ниже значения из паспорта производителя, с выдержкой по СН 4.02.03-2019 и методике производителя (для PP-R ступенчато). Тёплый пол испытывают до заливки и держат давление во время заливки стяжки. Для тёплых полов обычно требуются 4–6 бар. Протокол и фото обязательные листы исполнительной документации.</li></ul><div class=\"e-basis\"><b>Что спросить у монтажника до начала работ</b><p>1) Где на схеме компенсаторы, гильзы и неподвижные опоры? 2) Какие фитинги на скрытых участках и почему? 3) Чем и когда опрессуют, кто подписывает акт? 4) Где диэлектрические вставки и грязевики? 5) Какой инструмент (паяльник с терморегулятором, пресс с калибровкой) и есть ли протокол его поверки? Пять ответов экономят переделку стоимостью в десятки метров отделки.</p></div></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Типичные ошибки: 12 способов закопать деньги в стяжку</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. «Все двадцатые»</h4><p class=\"x\">✗ PN10 и PN20 имеют разный внутренний диаметр: проход меньше на 35 %, скорость и шум выше.</p><p class=\"v\">✓ Сечение по расходу и внутреннему диаметру, а не по надписи на бухте.</p></div><div class=\"e-err\"><h4>2. PP-R без армирования на отопление</h4><p class=\"x\">✗ Волна, провис, напряжения в стыках и вырванные клипсы.</p><p class=\"v\">✓ Фольга или стекловолокно, PEX или металлопластик на горячих линиях.</p></div><div class=\"e-err\"><h4>3. Перегрев при сварке</h4><p class=\"x\">✗ Грат внутрь: проход меньше на 30–60 %, будущий засор; снаружи не видно.</p><p class=\"v\">✓ Нагрев по таблице, тренировка на обрезках, фотофиксация стыков.</p></div><div class=\"e-err\"><h4>4. Цанга в стяжке</h4><p class=\"x\">✗ Уплотнитель течёт под циклами: вскрытие плитки через 2–4 года.</p><p class=\"v\">✓ Скрыто только цельная труба или пресс; цанга только открыто.</p></div><div class=\"e-err\"><h4>5. Тёплый пол без EVOH</h4><p class=\"x\">✗ Кислород съедает насос и котёл за 3–5 сезонов.</p><p class=\"v\">✓ EVOH или алюминиевый слой (DIN 4726, не более 0,1 г/(м³·сут)).</p></div><div class=\"e-err\"><h4>6. Зауженный кран у котла</h4><p class=\"x\">✗ Кавитация, шум, дефицит расхода: котёл тактует.</p><p class=\"v\">✓ Полнопроходная арматура на источнике, насосе, коллекторе.</p></div><div class=\"e-err\"><h4>7. 10 м PP-R без компенсации</h4><p class=\"x\">✗ Трубу ведёт дугой, трещины стяжки, сорванные опоры.</p><p class=\"v\">✓ Компенсаторы, гильзы, подвижные опоры по таблице шага.</p></div><div class=\"e-err\"><h4>8. Диаметр «как у соседа» под тепловой насос</h4><p class=\"x\">✗ ΔT 5 K: расход в 4 раза больше, скорость выше 2 м/с, шум и эрозия.</p><p class=\"v\">✓ Гидравлический расчёт по расходу; коллекторы и насос по G.</p></div><div class=\"e-err\"><h4>9. Без грязевика или с забитым</h4><p class=\"x\">✗ Шлам в теплообменник и насос, сопротивление выше в 3–5 раз.</p><p class=\"v\">✓ Грязевик перед насосом и котлом, чистка при наладке и в ТО.</p></div><div class=\"e-err\"><h4>10. Медь и алюминий напрямую</h4><p class=\"x\">✗ Гальваническая пара съедает радиатор и соединения.</p><p class=\"v\">✓ Латунные или диэлектрические вставки; совместимость металлов по проекту.</p></div><div class=\"e-err\"><h4>11. Повторный обжим, чужой профиль</h4><p class=\"x\">✗ Скрытый непрожим: течь после первой зимы.</p><p class=\"v\">✓ Профиль по паспорту, калиброванные клещи; непрожим значит замена фитинга.</p></div><div class=\"e-err\"><h4>12. Без опрессовки до отделки</h4><p class=\"x\">✗ Подсказка непрессованного соединения не сработала, потому что испытаний не было.</p><p class=\"v\">✓ 1,5 рабочего с актом и фото; тёплый пол под давлением во время заливки.</p></div></div></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Что болит у владельцев: симптомы, причины, действия</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Симптом</th><th>Вероятная причина</th><th>Что делать</th></tr></thead><tbody><tr><td>Шум, свист, гул в трубах</td><td>Скорость выше 1 м/с (особенно при тепловом насосе), воздух в контуре, зауженный кран или клапан</td><td>Пересчёт диаметров по расходу, удаление воздуха, замена зауженных узлов, настройка балансировочных клапанов</td></tr><tr><td>Щелчки и потрескивание при нагреве</td><td>Труба трётся о жёсткие крепления и стены: нет свободы для удлинения</td><td>Подвижные опоры и гильзы, мягкие прокладки, проверка компенсаторов</td></tr><tr><td>Трубу ведёт дугой, провисает между опорами</td><td>Нет компенсации или слишком редкие опоры</td><td>Дополнительные опоры по таблице шага, П-компенсатор или L-поворот</td></tr><tr><td>Течь через 1–3 сезона на скрытом участке</td><td>Непрожим пресс-фитинга, цанга в стяжке, недогрев при сварке</td><td>Вскрытие и замена фитинга; в будущем только цельная труба или опрессованный пресс</td></tr><tr><td>Радиатор греется неравномерно, холодный низ</td><td>Шлам или воздух, зауженное место, закрытая преднастройка клапана</td><td>Промывка, воздухоотводчики, проверка полнопроходной арматуры, балансировка</td></tr><tr><td>Бурая вода, быстро ржавеют насос и радиаторы</td><td>Кислород через стенку труб без барьера EVOH, подпитка свежей водой</td><td>Заменить трубы без барьера, поставить воздухоотводчики и грязевик, свести подпитку к минимуму</td></tr><tr><td>Котёл часто включается и выключается (тактует)</td><td>Переразмеренный котёл, заужения у котла и насоса</td><td>Расчёт мощности, полнопроходная арматура, проверка гидравлики</td></tr></tbody></table></div><p class=\"e-note\">Диагностику лучше начинать с расчёта скорости по расходу: во вкладке «Трубы» можно проверить, что скорость в вашем диаметре не выходит за 0,3–0,7 м/с.</p></div><div class=\"e-art\" id=\"art8\"><div class=\"e-sech\"><small>8</small><h3>Шпаргалка и чек-лист приёмки</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Система</th><th>Труба</th><th>Фитинги и арматура</th><th>Главный риск, который закрывают</th></tr></thead><tbody><tr><td>Тёплый пол</td><td>PEX, PE-RT + EVOH Ø16</td><td>коллектор с расходомерами, пресс</td><td>стыки в стяжке, кислород, непрожим</td></tr><tr><td>Радиаторы скрыто</td><td>PEX пресс Ø16–20</td><td>пресс-фитинги того же бренда</td><td>скрытые соединения, удлинение</td></tr><tr><td>Радиаторы открыто</td><td>PP-RCT армированный, металлопластик</td><td>сварка по таблице, полнопроходные краны</td><td>грат при перегреве, «волна»</td></tr><tr><td>Котельная ТТ</td><td>сталь 1–1,5 м, далее медь или сталь</td><td>сварка, резьба, диэлектрики</td><td>аварийные 110 °С, гальваника</td></tr><tr><td>Котельная газ, тепловой насос</td><td>медь, нержавейка</td><td>пресс, пайка, полнопроходная арматура</td><td>заужение у насоса, вибрация</td></tr><tr><td>Улица</td><td>предизолированные PE-RT II</td><td>сварка или пресс по паспорту сети</td><td>УФ, промерзание, грунтовые нагрузки</td></tr></tbody></table></div><h4 class=\"e-h4\">Пять тезисов, которые остаются в голове</h4><ul class=\"e-ul\"><li>Трубу выбирают по системе (класс эксплуатации, среда, скрытость), диаметр по расходу и скорости 0,3–0,7 м/с.</li><li>PN читается только вместе с температурой: для отопления важны класс 4 или 5 по ГОСТ 32415-2013 и кривая «давление–температура».</li><li>Проход съедают не метры, а элементы: перегретый стык, зауженный кран, забитый грязевик стоят метров трубы каждый.</li><li>Полимер ползёт: 75 мм на 10 м при ΔT 50 K. Компенсаторы, гильзы и опоры не декор, а несущая логика системы.</li><li>Скрытое значит цельное или прессованное с опрессовкой и актом; всё остальное отложенный счёт с процентом.</li></ul><div class=\"e-basis\"><b>Нормативная база</b><p><b>СН 4.02.03-2019</b> «Отопление, вентиляция и кондиционирование воздуха»: проектирование, гидравлика, изоляция, испытания. <b>ГОСТ 32415-2013</b>: трубы и соединительные детали из термопластов, классы эксплуатации, требования, маркировка. <b>DIN 4726</b>: кислородопроницаемость (справочно, де-факто стандарт рынка). Режимы сварки и пресса и методики опрессовки по паспортам производителей; отступления от проекта согласуются в установленном порядке.</p></div><p class=\"e-note\">Значения на диаграммах типовые справочные и не заменяют проектный расчёт.</p></div></section><section class=\"e-panel\" id=\"overview\" data-panel=\"overview\"><div class=\"e-sech\"><small>02</small><h2>Современные системы отопления</h2></div><p class=\"e-lead2\">Практикум для заказчика: тенденции, материалы, схемы, монтаж и типичные ошибки. Расчёты из других вкладок подставляйте в свой проект.</p><div class=\"e-art\" id=\"art0\"><div class=\"e-sech\"><small>0</small><h3>С чего начинается отопление</h3></div><p class=\"e-lead2\">Отопление — крупнейшая статья энергопотребления дома и одна из самых дорогих инженерных систем. Ошибки в нём проявляются в первый мороз, а исправляются вскрытием стяжки и отделки.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 150\" role=\"img\" aria-label=\"Пять шагов: расчёт, источник, гидравлика, приборы, автоматика\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"8\" y=\"10\" width=\"126\" height=\"130\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"20\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">1</text><text x=\"20\" y=\"70\" font-size=\"14\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Расчёт</text><text x=\"20\" y=\"88\" font-size=\"14\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">теплопотерь</text><text x=\"20\" y=\"110\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">по комнатам</text><line x1=\"136\" y1=\"75\" x2=\"154\" y2=\"75\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"154,75 145.9,78.9 145.9,71.1\" fill=\"#9a9ca3\"/><rect x=\"156\" y=\"10\" width=\"126\" height=\"130\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"168\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">2</text><text x=\"168\" y=\"70\" font-size=\"14\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Источник тепла</text><text x=\"168\" y=\"90\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">котёл или тепловой</text><text x=\"168\" y=\"104\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">насос, резерв, ГВС</text><line x1=\"284\" y1=\"75\" x2=\"302\" y2=\"75\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"302,75 293.9,78.9 293.9,71.1\" fill=\"#9a9ca3\"/><rect x=\"304\" y=\"10\" width=\"126\" height=\"130\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"316\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">3</text><text x=\"316\" y=\"70\" font-size=\"14\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Гидравлика</text><text x=\"316\" y=\"90\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">схема, диаметры,</text><text x=\"316\" y=\"104\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">насос, баланс</text><line x1=\"432\" y1=\"75\" x2=\"450\" y2=\"75\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"450,75 441.9,78.9 441.9,71.1\" fill=\"#9a9ca3\"/><rect x=\"452\" y=\"10\" width=\"126\" height=\"130\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"464\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">4</text><text x=\"464\" y=\"70\" font-size=\"14\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Приборы</text><text x=\"464\" y=\"90\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">радиаторы и тёплые</text><text x=\"464\" y=\"104\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">полы</text><line x1=\"580\" y1=\"75\" x2=\"598\" y2=\"75\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"598,75 589.9,78.9 589.9,71.1\" fill=\"#9a9ca3\"/><rect x=\"600\" y=\"10\" width=\"126\" height=\"130\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"612\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">5</text><text x=\"612\" y=\"70\" font-size=\"14\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Автоматика</text><text x=\"612\" y=\"88\" font-size=\"14\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">и сдача</text><text x=\"612\" y=\"110\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">погодный режим,</text><text x=\"612\" y=\"124\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">акты, паспорт</text></svg><figcaption>Порядок, который экономит деньги: каждый шаг опирается на предыдущий.</figcaption></figure><p class=\"e-note\">Перестановка шагов — главный источник дорогих переделок: результат каждого шага нужен следующему.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 660 260\" role=\"img\" aria-label=\"Структура теплопотерь типового недостаточно утеплённого дома\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M130.0,20.0 A110,110 0 0 1 240.0,130.0 L196.0,130.0 A66,66 0 0 0 130.0,64.0 Z\" fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"2\"/><path d=\"M240.0,130.0 A110,110 0 0 1 150.6,238.1 L142.4,194.8 A66,66 0 0 0 196.0,130.0 Z\" fill=\"#1d1f23\" stroke=\"#ffffff\" stroke-width=\"2\"/><path d=\"M150.6,238.1 A110,110 0 0 1 33.6,183.0 L72.2,161.8 A66,66 0 0 0 142.4,194.8 Z\" fill=\"#4a4d55\" stroke=\"#ffffff\" stroke-width=\"2\"/><path d=\"M33.6,183.0 A110,110 0 0 1 41.0,65.3 L76.6,91.2 A66,66 0 0 0 72.2,161.8 Z\" fill=\"#7d8089\" stroke=\"#ffffff\" stroke-width=\"2\"/><path d=\"M41.0,65.3 A110,110 0 0 1 96.0,25.4 L109.6,67.2 A66,66 0 0 0 76.6,91.2 Z\" fill=\"#9a9ca3\" stroke=\"#ffffff\" stroke-width=\"2\"/><path d=\"M96.0,25.4 A110,110 0 0 1 130.0,20.0 L130.0,64.0 A66,66 0 0 0 109.6,67.2 Z\" fill=\"#c6c8cd\" stroke=\"#ffffff\" stroke-width=\"2\"/><text x=\"130\" y=\"132\" font-size=\"24\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">100 %</text><text x=\"130\" y=\"152\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">потерь</text><rect x=\"280\" y=\"41\" width=\"16\" height=\"16\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"306\" y=\"54\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Крыша, чердак</text><text x=\"640\" y=\"54\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">25 %</text><rect x=\"280\" y=\"75\" width=\"16\" height=\"16\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"306\" y=\"88\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Стены</text><text x=\"640\" y=\"88\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">22 %</text><rect x=\"280\" y=\"109\" width=\"16\" height=\"16\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"306\" y=\"122\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Окна</text><text x=\"640\" y=\"122\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">20 %</text><rect x=\"280\" y=\"143\" width=\"16\" height=\"16\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"306\" y=\"156\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Вентиляция и инфильтрация</text><text x=\"640\" y=\"156\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">18 %</text><rect x=\"280\" y=\"177\" width=\"16\" height=\"16\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"306\" y=\"190\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Пол и цоколь</text><text x=\"640\" y=\"190\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">10 %</text><rect x=\"280\" y=\"211\" width=\"16\" height=\"16\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"306\" y=\"224\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Мостики холода, двери</text><text x=\"640\" y=\"224\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">5 %</text></svg><figcaption>Куда уходит тепло типового недостаточно утеплённого дома. Структура у каждого дома своя, диаграмма показывает типовой порядок.</figcaption></figure><p class=\"e-lead2\">Киловатт, сэкономленный утеплением и герметичностью, дешевле киловатта, купленного у котла: начинать надо с оболочки, а не с выбора котла «по площади». Структура потерь у каждого дома своя, диаграмма показывает типовой порядок.</p><p class=\"e-lead2\">Ориентир 100 Вт/м² годится только для первичной прикидки. Для современного дома в Беларуси удельная мощность обычно 50–80 Вт/м², для старого фонда 120–150 Вт/м². Точное значение даёт расчёт по комнатам: возьмите вкладку «Теплопотери».</p><div class=\"e-basis\"><b>Главный принцип</b><p>Сначала расчёт теплопотерь и гидравлики, потом покупка оборудования. Мощность котла, диаметры труб, число секций радиатора и длина контуров тёплого пола — результаты расчёта, а не «1 кВт на 10 м²» и не «как у соседа».</p></div></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Мировые тенденции: куда движется отопление</h3></div><div class=\"e-kpis\"><div class=\"e-kpi\"><b>≈ 2,63 млн</b><span>тепловых насосов продано в Европе в 2025 году (EHPA, 16 стран)</span></div><div class=\"e-kpi\"><b>+ 11 %</b><span>рост продаж к 2024 году</span></div><div class=\"e-kpi\"><b>≈ 28 млн</b><span>тепловых насосов в эксплуатации в Европе</span></div><div class=\"e-kpi\"><b>до −20 %</b><span>потребления даёт погодозависимая автоматика (по данным производителей)</span></div></div><ul class=\"e-ul\"><li><b>Электрификация и декарбонизация.</b> Директива ЕС 2024/1275 (EPBD) с 2025 года запрещает субсидии на автономные котлы на ископаемом топливе, а новые здания с 2030 года должны быть с нулевыми выбросами. Для стран ЕС ориентир отказа от ископаемых котлов — 2040 год.</li><li><b>Тепловой насос стал мейнстримом.</b> По предварительным данным EHPA, в 2025 году в 16 странах Европы продано около 2,63 млн тепловых насосов (+11 % к 2024 году), а всего в эксплуатации около 28 млн.</li><li><b>Новые хладагенты.</b> Насосы на пропане (R290) дают подачу 70–75 °С без догрева, поэтому их ставят и в старые радиаторные системы.</li><li><b>Низкотемпературное отопление.</b> График среды снижается с 70/50 до 55/45 и 35/30 °С: тёплые полы и крупные радиаторы. Чем ниже температура теплоносителя, тем выше КПД конденсационных котлов и COP тепловых насосов, тем меньше потери в сетях.</li><li><b>Гибриды.</b> Связка «тепловой насос + котёл»: насос закрывает базовую нагрузку, котёл — пики в сильные морозы. Дешевле, чем насос с двойным запасом, и надёжнее одного источника.</li><li><b>Умное управление.</b> Погодозависимое регулирование и зонные термостаты по данным производителей дают −10…−20 % потребления без потери комфорта.</li><li><b>Монтаж становится заводским.</b> Пресс-фитинги, трубы с кислородным барьером EVOH, готовые насосные группы и смесительные узлы: всё меньше ручных операций, от которых зависит герметичность.</li></ul><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Источник тепла</th><th>КПД, примерно</th><th>Комментарий</th></tr></thead><tbody><tr><td>Котёл на дровах, угле</td><td>70–80 %</td><td>зависит от влажности топлива и режима</td></tr><tr><td>Пеллетный котёл</td><td>85–90 %</td><td>нужен склад топлива и автоподача</td></tr><tr><td>Газовый конвекционный котёл</td><td>около 90 %</td><td>дымоход, сертифицированное помещение</td></tr><tr><td>Электрокотёл</td><td>около 99 %</td><td>высокая цена кВт·ч по обычному тарифу</td></tr><tr><td>Газовый конденсационный котёл</td><td>до 105–108 %</td><td>считается по низшей теплоте сгорания, нужен режим 55/45 и ниже</td></tr><tr><td>Тепловой насос «воздух–вода»</td><td>SCOP 3–4,5 (300–450 %)</td><td>при −15…−20 °С COP заметно падает: ориентир 2–2,5</td></tr></tbody></table></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 280\" role=\"img\" aria-label=\"КПД источников тепла\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"238\" y=\"35\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Твёрдое топливо</text><rect x=\"250\" y=\"16\" width=\"72.0\" height=\"28\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"352.0\" y=\"35\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">80 %</text><text x=\"238\" y=\"75\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Пеллеты</text><rect x=\"250\" y=\"56\" width=\"78.3\" height=\"28\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"352.0\" y=\"75\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">87 %</text><text x=\"238\" y=\"115\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Газ, конвекционный котёл</text><rect x=\"250\" y=\"96\" width=\"82.8\" height=\"28\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"352.0\" y=\"115\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">92 %</text><text x=\"238\" y=\"155\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Электрокотёл</text><rect x=\"250\" y=\"136\" width=\"89.10000000000001\" height=\"28\" rx=\"0\" fill=\"#4a4d55\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"352.0\" y=\"155\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">99 %</text><text x=\"238\" y=\"195\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Газ, конденсационный котёл</text><rect x=\"250\" y=\"176\" width=\"97.2\" height=\"28\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"352.0\" y=\"195\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">108 %</text><text x=\"238\" y=\"235\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Тепловой насос (SCOP 3–4,5)</text><rect x=\"250\" y=\"216\" width=\"270.0\" height=\"28\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"520.0\" y=\"216\" width=\"135.0\" height=\"28\" rx=\"0\" fill=\"#f4a0a6\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"663.0\" y=\"235\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">300–450 %</text><line x1=\"340.0\" y1=\"6\" x2=\"340.0\" y2=\"258\" stroke=\"#4a4d55\" stroke-width=\"1.5\" stroke-dasharray=\"4 4\"/><text x=\"346.0\" y=\"270\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">100 %</text></svg><figcaption>Значение выше 100 % у конденсационного котла возможно за счёт теплоты конденсации пара (по низшей теплоте сгорания). У теплового насоса светлая часть показывает диапазон сезонного COP: 3–4,5 кВт·ч тепла на 1 кВт·ч электричества.</figcaption></figure><p class=\"e-note\">Значение выше 100 % для конденсационного котла возможно из-за скрытой теплоты конденсации пара. COP теплового насоса показывает, сколько кВт·ч тепла получено с 1 кВт·ч электричества. Реальный сезонный SCOP зависит от температурного графика и климата: возьмите его из паспорта и проверьте на своих данных.</p><div class=\"e-basis\"><b>А что в Беларуси</b><p>Магистральный газ остаётся основным источником в частном секторе, но растут тепловые насосы и электроотопление по льготному тарифу, а твёрдое топливо держит позицию резерва. Систему всё чаще считают по стоимости кВт·ч тепла за сезон. Тарифы для населения меняются: действующие значения с 1 марта 2026 года установлены постановлением Совета Министров № 93 от 25.02.2026. Подставьте свои цены во вкладку «Стоимость тепла».</p></div></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Три типа объектов: дом, квартира, административное здание</h3></div><p class=\"e-lead2\">У каждого объекта свои исходные данные: источник энергии, разрешённая мощность, режим эксплуатации и требования к автоматике. От этого зависят и схема, и материалы, и экономика.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Объект</th><th>Источник тепла</th><th>Разводка и приборы</th><th>Ключевой нюанс</th></tr></thead><tbody><tr><td>Загородный дом</td><td>газ конденсационный, тепловой насос, твёрдое топливо + электрокотёл в резерве</td><td>коллекторная или двухтрубная; радиаторы + тёплые полы + бойлер ГВС</td><td>резерв источника и энергонезависимость при отключениях</td></tr><tr><td>Квартира</td><td>центральное отопление (ИТП дома); электрокотёл редко, по мощности</td><td>горизонтальная поквартирная; биметалл или сталь</td><td>давление и гидроудары; запрет тёплого пола от ЦО; согласования</td></tr><tr><td>Административное здание</td><td>крышная или автономная котельная, ИТП теплосетей</td><td>фанкойлы, VRF, воздушное отопление, завесы; зонирование</td><td>диспетчеризация, графики снижения, учёт и энергосервис</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Загородный дом.</b> Источник, резерв, ГВС и автоматика — ваши. Типовой состав современной системы: котёл или тепловой насос, бойлер косвенного нагрева и два-три контура (радиаторы 55/45 или 70/50, тёплые полы 35/30, полотенцесушители) с раздельными насосами и балансировкой. Мощность — по расчёту теплопотерь плюс 10–15 % на прогрев, а не «×2 на всякий случай»: переразмеренный котёл тактует, теряет КПД и ресурс.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 780 340\" role=\"img\" aria-label=\"Типовая структура котельной частного дома\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"14\" y=\"120\" width=\"150\" height=\"80\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"89\" y=\"150\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Котёл</text><text x=\"89\" y=\"172\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">газовый конденсационный</text><text x=\"89\" y=\"188\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">или тепловой насос</text><rect x=\"180\" y=\"12\" width=\"260\" height=\"56\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"310\" y=\"36\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Группа безопасности</text><text x=\"310\" y=\"54\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">манометр, воздухоотводчик, клапан 3 бар</text><rect x=\"210\" y=\"234\" width=\"180\" height=\"56\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"300\" y=\"258\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Расширительный бак</text><text x=\"300\" y=\"276\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">около 10 % объёма системы</text><rect x=\"14\" y=\"276\" width=\"150\" height=\"50\" rx=\"0\" fill=\"#fff\" stroke=\"#7d8089\" stroke-width=\"2\"/><text x=\"89\" y=\"298\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Резерв: электрокотёл</text><text x=\"89\" y=\"314\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">автовключение при аварии</text><rect x=\"580\" y=\"40\" width=\"170\" height=\"50\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"665\" y=\"62\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Бойлер ГВС</text><text x=\"665\" y=\"80\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">косвенный, 150–300 л</text><rect x=\"580\" y=\"120\" width=\"170\" height=\"50\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"665\" y=\"142\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Радиаторы</text><text x=\"665\" y=\"160\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">контур 70/50 °С, термостаты</text><rect x=\"580\" y=\"200\" width=\"170\" height=\"50\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"665\" y=\"222\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Тёплые полы</text><text x=\"665\" y=\"240\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">смесительный узел, 35/30 °С</text><rect x=\"580\" y=\"280\" width=\"170\" height=\"46\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"665\" y=\"301\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Автоматика</text><text x=\"665\" y=\"317\" font-size=\"11\" fill=\"#fbd0d3\" text-anchor=\"middle\" font-weight=\"400\">погодный режим, зоны</text><rect x=\"500\" y=\"40\" width=\"14\" height=\"210\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><polyline points=\"164,160 500,160\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"89,120 89,40 180,40\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"2\" stroke-linejoin=\"round\"/><polyline points=\"164,185 190,185 190,262 210,262\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"2\" stroke-linejoin=\"round\"/><polyline points=\"390,262 470,262 470,235 500,235\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"2\" stroke-linejoin=\"round\"/><line x1=\"514\" y1=\"65\" x2=\"578\" y2=\"65\" stroke=\"#7d8089\" stroke-width=\"2\"/><polygon points=\"578,65 569.9,68.9 569.9,61.1\" fill=\"#7d8089\"/><line x1=\"514\" y1=\"145\" x2=\"578\" y2=\"145\" stroke=\"#7d8089\" stroke-width=\"2\"/><polygon points=\"578,145 569.9,148.9 569.9,141.1\" fill=\"#7d8089\"/><line x1=\"514\" y1=\"225\" x2=\"578\" y2=\"225\" stroke=\"#7d8089\" stroke-width=\"2\"/><polygon points=\"578,225 569.9,228.9 569.9,221.1\" fill=\"#7d8089\"/><line x1=\"89\" y1=\"276\" x2=\"89\" y2=\"202\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"89,202 92.9,210.1 85.1,210.1\" fill=\"#9a9ca3\"/><line x1=\"665\" y1=\"278\" x2=\"665\" y2=\"252\" stroke=\"#e3000f\" stroke-width=\"2\"/><polygon points=\"665,252 668.9,260.1 661.1,260.1\" fill=\"#e3000f\"/></svg><figcaption>Типовая структура котельной частного дома: источник, безопасность, ёмкость, раздельные контуры со своими насосами и автоматика, которая управляет приоритетами. Дымоход, вентиляция и газоснабжение — по проекту.</figcaption></figure><p class=\"e-lead2\"><b>Квартира.</b> Исходник — центральное отопление: рабочее давление до 10 бар и гидроудары до 15, однотрубные стояки, чужой теплоноситель. Что можно и нужно делать: заменить радиаторы на биметалл или стальные панельные с запасом по давлению, поставить термоголовки с датчиком и балансировочные клапаны, перейти на горизонтальную поквартирную разводку РЕХ или металлопластиком (в новостройках она уже штатная), учитывать тепло счётчиками. Что нельзя: водяной тёплый пол от системы ЦО, перенос приборов и изменение схемы стояков без согласования. Альтернатива тёплому полу в квартире — электрические маты под плитку.</p><p class=\"e-lead2\"><b>Административное здание.</b> Либо собственная (часто крышная) котельная, либо ИТП от теплосетей. Ключевое — автоматика и диспетчеризация: зонирование по фасадам и назначению помещений, ночные и выходные снижения температуры, погодный режим, учёт тепла и энергосервис. Комфорт летом и зимой дают двух- или четырёхтрубные фанкойлы либо VRF, входные группы закрываются тепловыми завесами. Окупаемость автоматики здесь обычно 1–2 отопительных сезона.</p></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Материалы: трубы, радиаторы, теплоноситель</h3></div><p class=\"e-lead2\">Труба подбирается под контур, а не «вообще»: у тёплого пола, радиаторов и обвязки котла разные температуры, давления и требования к монтажу.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Труба</th><th>Т раб., °С</th><th>Срок</th><th>Соединение</th><th>Где применять</th><th>Особенности</th></tr></thead><tbody><tr><td>PP-R (PN20/25, стекло/фольга)</td><td>до 70 (до 90 кратковременно)</td><td>до 50 лет</td><td>сварка (раструб)</td><td>Открытая разводка радиаторов, ХВС и ГВС</td><td>Дёшево, жёсткая; большое тепловое удлинение; для тёплого пола не применяют</td></tr><tr><td>PEX-a/b/c + EVOH</td><td>до 80 (кратковременно до 90)</td><td>до 50 лет</td><td>пресс или цанга</td><td>Тёплые полы, скрытая разводка, радиаторы</td><td>Кислородный барьер обязателен; целая бухта в стяжке; у PEX-a память формы</td></tr><tr><td>PE-RT + EVOH</td><td>до 70 (до 85 кратковременно)</td><td>до 50 лет</td><td>пресс или цанга</td><td>Тёплые полы</td><td>Дешевле PEX, мягче; не гнётся «в холодную» на малых радиусах</td></tr><tr><td>Металлопластик PEX-AL-PEX</td><td>до 95</td><td>35–50 лет</td><td>пресс; резьба — только открыто</td><td>Радиаторы, стояки, обвязка</td><td>Держит форму, малое удлинение; пресс-фитинг дороже</td></tr><tr><td>Гофрированная нержавейка</td><td>до 110</td><td>30 и более лет</td><td>резьбовые фитинги</td><td>Обвязка котла, сложные трассы</td><td>Гнётся без фитингов; дороже полимера</td></tr><tr><td>Сталь чёрная (ВГП)</td><td>до 105–115</td><td>25–30 лет</td><td>сварка или резьба</td><td>Обвязка твердотопливного котла</td><td>Только открыто; коррозия при сливе воды</td></tr><tr><td>Медь</td><td>до 110</td><td>50 и более лет</td><td>пайка или пресс</td><td>Котельные, премиум-разводка</td><td>Дорого; несовместима с алюминием в одном контуре</td></tr><tr><td>Нержавеющая сталь (пресс)</td><td>до 110</td><td>50 и более лет</td><td>пресс</td><td>Котельные, ИТП, административные здания</td><td>Максимальная надёжность и цена</td></tr></tbody></table></div><figure class=\"e-fig\"><svg viewBox=\"0 0 780 306\" role=\"img\" aria-label=\"Заявленный срок службы и предельная температура труб\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"228\" y=\"30\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">PP-R (армированный)</text><rect x=\"240\" y=\"12\" width=\"310.0\" height=\"24\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"558.0\" y=\"30\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">50 лет</text><text x=\"640\" y=\"30\" font-size=\"13\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">до 70 °С</text><text x=\"228\" y=\"66\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">PEX-a / PEX-b</text><rect x=\"240\" y=\"48\" width=\"310.0\" height=\"24\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"558.0\" y=\"66\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">50 лет</text><text x=\"640\" y=\"66\" font-size=\"13\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">до 90 °С</text><text x=\"228\" y=\"102\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">PE-RT</text><rect x=\"240\" y=\"84\" width=\"310.0\" height=\"24\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"558.0\" y=\"102\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">50 лет</text><text x=\"640\" y=\"102\" font-size=\"13\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">до 70 °С</text><text x=\"228\" y=\"138\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Металлопластик</text><rect x=\"240\" y=\"120\" width=\"217.0\" height=\"24\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"465.0\" y=\"138\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">35 лет</text><text x=\"640\" y=\"138\" font-size=\"13\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">до 95 °С</text><text x=\"228\" y=\"174\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Гофрированная нержавейка</text><rect x=\"240\" y=\"156\" width=\"186.0\" height=\"24\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"434.0\" y=\"174\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">30 лет</text><text x=\"640\" y=\"174\" font-size=\"13\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">до 110 °С</text><text x=\"228\" y=\"210\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Сталь чёрная (ВГП)</text><rect x=\"240\" y=\"192\" width=\"155.0\" height=\"24\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"403.0\" y=\"210\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">25 лет</text><text x=\"640\" y=\"210\" font-size=\"13\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">до 105–115 °С</text><text x=\"228\" y=\"246\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Медь</text><rect x=\"240\" y=\"228\" width=\"310.0\" height=\"24\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"558.0\" y=\"246\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">50+ лет</text><text x=\"640\" y=\"246\" font-size=\"13\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">до 110 °С</text><text x=\"228\" y=\"282\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Нержавеющая сталь (пресс)</text><rect x=\"240\" y=\"264\" width=\"310.0\" height=\"24\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"558.0\" y=\"282\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">50+ лет</text><text x=\"640\" y=\"282\" font-size=\"13\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">до 110 °С</text></svg><figcaption>Заявленный производителем срок службы (лет) при номинальных условиях и предельная рабочая температура. Реальный срок определяет монтаж.</figcaption></figure><p class=\"e-note\">Срок службы указывает производитель для номинальных условий. Реальный срок определяют монтаж, температурные удлинения, ультрафиолет при хранении, качество фитингов и инструмента.</p><ul class=\"e-ul\"><li><b>Кислородный барьер.</b> В контурах отопления допустима только труба с слоем EVOH или фольгой: диффузия кислорода без барьера разъедает сталь насосов, котла и радиаторов.</li><li><b>Тепловое удлинение.</b> Неармированный PP-R удлиняется примерно на 0,15 мм на метр на каждый градус: при нагреве на 60 К труба в 10 м удлинится на 90 мм. Армирование стекловолокном или алюминием снижает удлинение в 3–5 раз, но не отменяет его. Нужны компенсаторы, Г- и П-образные участки и подвижные опоры. Посчитайте во вкладке «Удлинение труб».</li><li><b>Один бренд — одна гарантия.</b> Труба, фитинги и пресс-инструмент должны быть совместимы по паспорту. Смешение систем разных производителей снимает гарантию и даёт протечки на 2–3-й сезон.</li></ul><h4 class=\"e-h4\">Радиаторы</h4><p class=\"e-lead2\">Тип прибора выбирается по давлению, теплоносителю и дизайну, мощность — по теплопотерям комнаты с поправкой на температурный график.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Тип</th><th>Теплоотдача при Δt = 70 К</th><th>Р раб., бар</th><th>Плюсы и минусы</th><th>Куда</th></tr></thead><tbody><tr><td>Биметаллический</td><td>160–190 Вт/секция</td><td>25–35</td><td>Стойкость к гидроударам и pH; выше цена</td><td>Квартиры с ЦО</td></tr><tr><td>Алюминиевый</td><td>170–200 Вт/секция</td><td>16</td><td>Лучшая отдача и цена; боится pH и меди в контуре</td><td>Дома с автономным отоплением</td></tr><tr><td>Стальной панельный</td><td>0,5–3 кВт/панель</td><td>8–10</td><td>Низкая инерция, ровный фронт; чувствителен к коррозии при сливе</td><td>Дома, новые квартиры с ИТП</td></tr><tr><td>Чугунный</td><td>140–160 Вт/секция</td><td>9–12</td><td>Инерционный и живучий; тяжёлый, медленный</td><td>Ретро, замена в старом фонде</td></tr><tr><td>Конвектор внутрипольный</td><td>0,3–2 кВт</td><td>10–16</td><td>Незаметен, закрывает панорамные окна; дороже и сложнее в уборке</td><td>Панорамное остекление</td></tr></tbody></table></div><figure class=\"e-fig\"><svg viewBox=\"0 0 720 340\" role=\"img\" aria-label=\"Рабочее и опрессовочное давление радиаторов\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"60\" y=\"232.0\" width=\"640\" height=\"24.0\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"60\" y1=\"256.0\" x2=\"700\" y2=\"256.0\" stroke=\"#e3000f\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/><line x1=\"60\" y1=\"232.0\" x2=\"700\" y2=\"232.0\" stroke=\"#e3000f\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/><line x1=\"56\" y1=\"304.0\" x2=\"60\" y2=\"304.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"52\" y=\"308.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0</text><line x1=\"56\" y1=\"256.0\" x2=\"60\" y2=\"256.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"52\" y=\"260.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">10</text><line x1=\"56\" y1=\"208.0\" x2=\"60\" y2=\"208.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"52\" y=\"212.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">20</text><line x1=\"56\" y1=\"160.0\" x2=\"60\" y2=\"160.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"52\" y=\"164.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">30</text><line x1=\"56\" y1=\"112.0\" x2=\"60\" y2=\"112.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"52\" y=\"116.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">40</text><line x1=\"56\" y1=\"64.0\" x2=\"60\" y2=\"64.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"52\" y=\"68.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">50</text><line x1=\"60\" y1=\"64\" x2=\"60\" y2=\"304\" stroke=\"#4a4d55\" stroke-width=\"1\"/><line x1=\"60\" y1=\"304\" x2=\"700\" y2=\"304\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"14\" y=\"56\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">бар</text><rect x=\"90\" y=\"260.8\" width=\"50\" height=\"43.199999999999996\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"115\" y=\"254.8\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">9</text><rect x=\"144\" y=\"232.0\" width=\"50\" height=\"72.0\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"169\" y=\"226.0\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">15</text><text x=\"142\" y=\"324\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">Чугунный</text><rect x=\"245\" y=\"256.0\" width=\"50\" height=\"48.0\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"270\" y=\"250.0\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">10</text><rect x=\"299\" y=\"241.6\" width=\"50\" height=\"62.4\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"324\" y=\"235.6\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">13</text><text x=\"297\" y=\"324\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">Стальной панельный</text><rect x=\"400\" y=\"227.2\" width=\"50\" height=\"76.8\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"425\" y=\"221.2\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">16</text><rect x=\"454\" y=\"188.8\" width=\"50\" height=\"115.19999999999999\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"479\" y=\"182.8\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">24</text><text x=\"452\" y=\"324\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">Алюминиевый</text><rect x=\"555\" y=\"160.0\" width=\"50\" height=\"144.0\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"580\" y=\"154.0\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">30</text><rect x=\"609\" y=\"88.0\" width=\"50\" height=\"216.0\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"634\" y=\"82.0\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">45</text><text x=\"607\" y=\"324\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">Биметаллический</text><rect x=\"72\" y=\"6\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"90\" y=\"17\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">рабочее давление</text><rect x=\"72\" y=\"24\" width=\"12\" height=\"12\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"90\" y=\"35\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">опрессовочное</text><line x1=\"72\" y1=\"48\" x2=\"84\" y2=\"48\" stroke=\"#e3000f\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/><text x=\"90\" y=\"52\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"400\">центральное отопление: 10–15 бар</text></svg><figcaption>Рабочее и опрессовочное давление радиаторов, бар. В центральном отоплении давление достигает 10–15 бар: чугун и стальные панели работают на пределе, биметалл имеет запас.</figcaption></figure><p class=\"e-lead2\">Теплоотдача растёт вместе с температурным напором как степень 1,3. Поэтому при переходе на низкотемпературный график число секций надо пересчитывать: при 55/45 радиатор отдаёт около 70 % того, что отдавал при 70/50 (то есть на 30 % меньше, а не на 20–25 %). Расчёт числа секций — вкладка «Радиаторы».</p><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>График, °С</th><th>Средняя температура воды</th><th>Доля номинальной отдачи радиатора</th><th>К графику 70/50</th></tr></thead><tbody><tr><td>90/70</td><td>80 °С</td><td>82 %</td><td>169 %</td></tr><tr><td>75/65</td><td>70 °С</td><td>65 %</td><td>134 %</td></tr><tr><td>70/50</td><td>60 °С</td><td>48 %</td><td>100 %</td></tr><tr><td>55/45</td><td>50 °С</td><td>33 %</td><td>69 %</td></tr><tr><td>45/35</td><td>40 °С</td><td>20 %</td><td>41 %</td></tr><tr><td>35/30</td><td>32,5 °С</td><td>11 %</td><td>22 %</td></tr></tbody></table></div><p class=\"e-note\">Расчёт по формуле Q = Qном · (Δt ÷ 70)^1,3 при температуре воздуха 20 °С. Показатель зависит от типа прибора, поэтому значения округлены.</p><p class=\"e-lead2\">В квартире главный риск — не температура, а давление: опрессовка и гидроудары в ЦО доходят до 10–15 бар. Чугун и стальные панели работают на пределе, биметалл имеет двойной запас. Термоголовка в однотрубной системе ставится только вместе с байпасом, иначе вы «закрываете» стояк соседей.</p><div class=\"e-basis\"><b>Теплоноситель: вода или гликоль</b><p>В доме постоянного проживания — подготовленная вода: у неё выше теплоёмкость и теплоотдача. Пропиленгликоль (до −25 °С) нужен только там, где возможны простои с разморозкой: он отнимает 15–20 % теплоёмкости, вязкий, требует совместимости с котлом и уплотнениями. Автомобильный антифриз в отоплении недопустим.</p></div></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Схемы разводки, тёплый пол и радиаторы</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 780 270\" role=\"img\" aria-label=\"Три базовые схемы разводки отопления\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"10\" y=\"20\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Гравитационная</text><rect x=\"14\" y=\"200\" width=\"58\" height=\"36\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"43\" y=\"223\" font-size=\"12\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"400\">котёл</text><polyline points=\"30,200 30,60 200,60 200,100\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><rect x=\"130\" y=\"36\" width=\"80\" height=\"24\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"170\" y=\"53\" font-size=\"10\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">открытый бак</text><rect x=\"170\" y=\"100\" width=\"60\" height=\"70\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"200\" y=\"140\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">радиатор</text><polyline points=\"200,170 200,218 72,218\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"3\" stroke-linejoin=\"round\"/><line x1=\"130\" y1=\"232\" x2=\"90\" y2=\"232\" stroke=\"#7d8089\" stroke-width=\"1.5\"/><polygon points=\"90,232 98.1,228.1 98.1,235.9\" fill=\"#7d8089\"/><text x=\"110\" y=\"250\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">уклон 3–5 мм на метр</text><text x=\"270\" y=\"20\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Двухтрубная с насосом</text><rect x=\"274\" y=\"200\" width=\"58\" height=\"36\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"303\" y=\"223\" font-size=\"12\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"400\">котёл</text><rect x=\"340\" y=\"205\" width=\"26\" height=\"26\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"353\" y=\"223\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">М</text><polyline points=\"290,200 290,60 500,60\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><text x=\"500\" y=\"50\" font-size=\"10\" fill=\"#e3000f\" text-anchor=\"end\" font-weight=\"400\">подача 70–75 °С</text><polyline points=\"380,60 380,100\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><rect x=\"355\" y=\"100\" width=\"50\" height=\"70\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"380\" y=\"140\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">рад.</text><polyline points=\"380,170 380,218\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"440,60 440,100\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><rect x=\"415\" y=\"100\" width=\"50\" height=\"70\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"440\" y=\"140\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">рад.</text><polyline points=\"440,170 440,218\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"500,218 332,218 332,200\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"3\" stroke-linejoin=\"round\"/><line x1=\"380\" y1=\"218\" x2=\"500\" y2=\"218\" stroke=\"#4a4d55\" stroke-width=\"3\"/><text x=\"500\" y=\"236\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">обратка 50–55 °С</text><text x=\"540\" y=\"20\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Коллекторная</text><rect x=\"540\" y=\"110\" width=\"58\" height=\"36\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"569\" y=\"133\" font-size=\"12\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"400\">котёл</text><rect x=\"630\" y=\"56\" width=\"40\" height=\"100\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"650\" y=\"110\" font-size=\"9\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">подача</text><rect x=\"630\" y=\"176\" width=\"40\" height=\"60\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"650\" y=\"210\" font-size=\"9\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">обратка</text><polyline points=\"598,120 630,120\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"598,136 614,136 614,206 630,206\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"670,76 700,76\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"2\" stroke-linejoin=\"round\"/><rect x=\"700\" y=\"64\" width=\"70\" height=\"24\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"735\" y=\"80\" font-size=\"10\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">радиаторы</text><polyline points=\"670,108 700,108\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"2\" stroke-linejoin=\"round\"/><rect x=\"700\" y=\"96\" width=\"70\" height=\"24\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"735\" y=\"112\" font-size=\"10\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">тёплый пол</text><polyline points=\"670,140 700,140\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"2\" stroke-linejoin=\"round\"/><rect x=\"700\" y=\"128\" width=\"70\" height=\"24\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"735\" y=\"144\" font-size=\"10\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">бойлер ГВС</text></svg><figcaption>Три базовые схемы: красный — подача, серый — обратка. Гравитационная работает без насоса, двухтрубная — тупиковая с насосом, в коллекторной каждый прибор получает отдельный контур.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Схема</th><th>Плюсы</th><th>Минусы</th><th>Когда выбирать</th></tr></thead><tbody><tr><td>Гравитационная (однотрубная, открытый бак)</td><td>Работает без электричества; простота</td><td>Трубы Ø40–50, большой уклон, медленная и плохая регулировка; открытый бак — кислород в системе</td><td>Энергонезависимый резерв с твердотопливным котлом</td></tr><tr><td>Двухтрубная с насосом (тупиковая)</td><td>Стабильная гидравлика, умеренная цена, ремонтопригодность</td><td>Нужна балансировка; часть стыков скрыта</td><td>Дома до 120–150 м², один-два этажа</td></tr><tr><td>Коллекторная (лучевая)</td><td>Целая труба к каждому прибору без стыков в стяжке; точная балансировка; отключение зон</td><td>Больше трубы и места под шкафы; дороже</td><td>Два-три этажа, 150 и более м², тёплые полы, премиум-отделка</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Тёплый пол и радиаторы не конкуренты, а партнёры.</b> Тёплый пол даёт комфортную температурную кривую и низкий график среды (идеал для конденсационного котла и теплового насоса), радиаторы закрывают пики нагрузки и быстро прогревают помещение после простоя.</p><h4 class=\"e-h4\">«Пирог» водяного тёплого пола, снизу вверх</h4><figure class=\"e-fig\"><svg viewBox=\"0 0 780 290\" role=\"img\" aria-label=\"Конструкция водяного тёплого пола\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"60\" y=\"20\" width=\"300\" height=\"28\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1\"/><rect x=\"60\" y=\"48\" width=\"300\" height=\"70\" rx=\"0\" fill=\"#e4e5e8\" stroke=\"#1d1f23\" stroke-width=\"1\"/><rect x=\"60\" y=\"118\" width=\"300\" height=\"56\" rx=\"0\" fill=\"#9a9ca3\" stroke=\"#1d1f23\" stroke-width=\"1\"/><rect x=\"60\" y=\"174\" width=\"300\" height=\"24\" rx=\"0\" fill=\"#7d8089\" stroke=\"#1d1f23\" stroke-width=\"1\"/><circle cx=\"82\" cy=\"85\" r=\"9\" fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"1.5\"/><circle cx=\"118\" cy=\"85\" r=\"9\" fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"1.5\"/><circle cx=\"154\" cy=\"85\" r=\"9\" fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"1.5\"/><circle cx=\"190\" cy=\"85\" r=\"9\" fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"1.5\"/><circle cx=\"226\" cy=\"85\" r=\"9\" fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"1.5\"/><circle cx=\"262\" cy=\"85\" r=\"9\" fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"1.5\"/><circle cx=\"298\" cy=\"85\" r=\"9\" fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"1.5\"/><circle cx=\"334\" cy=\"85\" r=\"9\" fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"1.5\"/><rect x=\"52\" y=\"20\" width=\"8\" height=\"178\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"360\" y=\"20\" width=\"8\" height=\"178\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"12\" y=\"14\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"400\">демпферная лента 8–10 мм</text><text x=\"380\" y=\"40\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Финишное покрытие</text><text x=\"380\" y=\"56\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">плитка, керамогранит, ламинат «для тёплых полов»</text><text x=\"380\" y=\"92\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Стяжка</text><text x=\"380\" y=\"108\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">не менее 45 мм над трубой, всего 65–80 мм</text><text x=\"380\" y=\"142\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Труба PEX или PE-RT Ø16</text><text x=\"380\" y=\"158\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">шаг 100–200 мм: у окон 100, в середине 150–200</text><text x=\"380\" y=\"192\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Утеплитель EPS или XPS</text><text x=\"380\" y=\"208\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">50–100 мм (на грунте 100 мм) + отражающая плёнка</text><text x=\"380\" y=\"238\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Основание</text><line x1=\"300\" y1=\"34\" x2=\"372\" y2=\"40\" stroke=\"#9a9ca3\" stroke-width=\"1\"/><line x1=\"300\" y1=\"70\" x2=\"372\" y2=\"90\" stroke=\"#9a9ca3\" stroke-width=\"1\"/><line x1=\"300\" y1=\"85\" x2=\"372\" y2=\"140\" stroke=\"#9a9ca3\" stroke-width=\"1\"/><line x1=\"300\" y1=\"150\" x2=\"372\" y2=\"190\" stroke=\"#9a9ca3\" stroke-width=\"1\"/><line x1=\"300\" y1=\"202\" x2=\"372\" y2=\"236\" stroke=\"#9a9ca3\" stroke-width=\"1\"/><text x=\"14\" y=\"276\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"700\">Опрессовка 1,5 рабочего давления (обычно 4–6 бар) — до и во время заливки стяжки.</text></svg><figcaption>Конструкция водяного тёплого пола: толщины типовые, точные значения определяет проект.</figcaption></figure><p class=\"e-note\">Толщины типовые, точные значения определяет проект. Опрессовка 1,5 рабочего давления (но не ниже значения из паспорта) — до заливки стяжки.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 700 390\" role=\"img\" aria-label=\"Вертикальный профиль температуры в комнате\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"60.0\" y1=\"36\" x2=\"60.0\" y2=\"336\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"60.0\" y=\"354\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">16</text><line x1=\"172.0\" y1=\"36\" x2=\"172.0\" y2=\"336\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"172.0\" y=\"354\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">18</text><line x1=\"284.0\" y1=\"36\" x2=\"284.0\" y2=\"336\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"284.0\" y=\"354\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><line x1=\"396.0\" y1=\"36\" x2=\"396.0\" y2=\"336\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"396.0\" y=\"354\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">22</text><line x1=\"508.0\" y1=\"36\" x2=\"508.0\" y2=\"336\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"508.0\" y=\"354\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">24</text><line x1=\"620.0\" y1=\"36\" x2=\"620.0\" y2=\"336\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"620.0\" y=\"354\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">26</text><line x1=\"60\" y1=\"336.0\" x2=\"620\" y2=\"336.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"52\" y=\"340.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0,0</text><line x1=\"60\" y1=\"276.0\" x2=\"620\" y2=\"276.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"52\" y=\"280.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0,5</text><line x1=\"60\" y1=\"216.0\" x2=\"620\" y2=\"216.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"52\" y=\"220.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">1,0</text><line x1=\"60\" y1=\"156.0\" x2=\"620\" y2=\"156.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"52\" y=\"160.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">1,5</text><line x1=\"60\" y1=\"96.0\" x2=\"620\" y2=\"96.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"52\" y=\"100.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">2,0</text><line x1=\"60\" y1=\"36.0\" x2=\"620\" y2=\"36.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"52\" y=\"40.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">2,5</text><polyline points=\"620.0,336.0 524.8,276.0 440.8,216.0 368.0,156.0 312.0,96.0 278.4,48.0\" fill=\"none\" stroke=\"#9a9ca3\" stroke-width=\"2\" stroke-dasharray=\"4 4\" stroke-linejoin=\"round\"/><polyline points=\"603.2,336.0 508.0,276.0 424.0,216.0 351.2,156.0 289.6,96.0 256.0,48.0\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"250.4,336.0 328.8,276.0 396.0,216.0 463.2,156.0 508.0,96.0 536.0,48.0\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"3\" stroke-linejoin=\"round\"/><text x=\"340.0\" y=\"376\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">температура воздуха, °С</text><text x=\"14\" y=\"22\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">высота, м</text><line x1=\"72\" y1=\"50\" x2=\"102\" y2=\"50\" stroke=\"#9a9ca3\" stroke-width=\"2\" stroke-dasharray=\"4 4\"/><text x=\"108\" y=\"54\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">идеальный профиль</text><line x1=\"72\" y1=\"70\" x2=\"102\" y2=\"70\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"108\" y=\"74\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">тёплый пол</text><line x1=\"72\" y1=\"90\" x2=\"102\" y2=\"90\" stroke=\"#1d1f23\" stroke-width=\"3\"/><text x=\"108\" y=\"94\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">радиаторы</text></svg><figcaption>Схематичный вертикальный профиль температуры: тёплый пол повторяет «идеальную» кривую «ноги в тепле, голова в прохладе», конвекция от радиаторов греет потолок. Кривые иллюстративные.</figcaption></figure><h4 class=\"e-h4\">Правила тёплого пола</h4><ul class=\"e-ul\"><li><b>Контур</b> — не более 80–100 м трубы Ø16 мм; петли одной комнаты близкой длины, иначе балансировка не спасёт.</li><li><b>Шаг укладки</b> 100–200 мм. Удельная мощность 60–100 Вт/м² (расчёт — вкладка «Тёплый пол»).</li><li><b>Температура поверхности пола</b> не выше 29 °С при постоянном пребывании людей и 33 °С при временном (СН 4.02.03, п. 6.2.5).</li><li><b>Коллектор</b> с расходомерами и сервоприводами; смесительный узел или прямой низкотемпературный контур теплового насоса.</li><li><b>Опрессовка</b> до заливки стяжки и под давлением во время заливки (по ТКП 45-1.03-85 в трубах тёплого пола при замоноличивании 0,3 МПа).</li><li><b>Пуск</b> не ранее чем через 20 суток после заливки: 25 °С три суток, затем +5 °С в сутки (ТКП 45-1.03-85).</li><li><b>Покрытие</b>: ковры и толстые подложки заметно снижают отдачу, по оценкам до 40 %.</li></ul><div class=\"e-basis\"><b>Частая ошибка схемы</b><p>Тёплый пол подключают напрямую к котлу с графиком 70/50 без смесительного узла. Итог: перегретая стяжка, «зебра» на покрытии, дискомфорт и потеря гарантии на трубу. Низкотемпературный контур питается только через смеситель, насосно-смесительную группу или прямой контур теплового насоса.</p></div><h4 class=\"e-h4\">Температурные режимы контуров</h4><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Контур</th><th>График, °С</th><th>Источник</th><th>Особенность</th></tr></thead><tbody><tr><td>Радиаторы, старый фонд и большие теплопотери</td><td>70/50</td><td>любой котёл</td><td>Конденсация и высокий COP теплового насоса теряются</td></tr><tr><td>Радиаторы современные, утеплённый дом</td><td>55/45</td><td>конденсационный котёл, тепловой насос</td><td>Теплоотдача прибора падает примерно на 30 % к 70/50: закладывается в подбор</td></tr><tr><td>Водяной тёплый пол</td><td>35/30</td><td>смесительный узел или прямой контур ТН</td><td>Комфортная кривая, высокая инерционность: нужен погодный режим</td></tr><tr><td>ГВС (бойлер косвенный)</td><td>50–55</td><td>котёл или тепловой насос</td><td>Периодический нагрев до 60–65 °С — антилегионеллёзный режим</td></tr></tbody></table></div></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Нюансы монтажа</h3></div><h4 class=\"e-h4\">Котельная и источник</h4><ul class=\"e-ul\"><li>Газовый котёл — только по проекту и с согласованием газоснабжающей организации; помещение, дымоход и вентиляция — по ТКП, СН и паспорту котла.</li><li>Твердотопливный котёл: стальной участок обвязки 1–1,5 м, защита от низкотемпературной коррозии (смесительный узел, обратка не ниже 55 °С), теплоаккумулятор.</li><li>Конденсационный котёл: дымоход с отводом конденсата и уклоном к котлу. Нужен ли нейтрализатор конденсата, смотрите в паспорте котла и местных требованиях.</li><li>Электрика: отдельная линия и УЗО на котёл и насосы, стабилизатор или ИБП для автоматики. Автомат и кабель подберите в разделе «Электрика → Автоматы и УЗО». Для теплового насоса и электрокотла ввод 380 В определяется расчётом.</li><li>Тепловой насос «воздух–вода»: фундамент и виброопоры наружного блока, подогрев или греющий кабель дренажа конденсата, буферная ёмкость по схеме производителя.</li></ul><h4 class=\"e-h4\">Гидравлика и арматура</h4><ul class=\"e-ul\"><li>Диаметры — по гидравлическому расчёту (скорость воды 0,3–0,7 м/с в жилье): слишком узко шумит, слишком широко не прогревается. Подбор — вкладка «Трубы».</li><li>Расширительный бак 8–12 % объёма системы, предварительное давление равно статическому плюс 0,2–0,3 бар, место — на обратке до насоса.</li><li>Группа безопасности у котла: манометр, воздухоотводчик, предохранительный клапан (обычно 3 бар), сброс направлен в воронку.</li><li>Циркуляционный насос — на обратке; перед насосом и теплообменником — грязевики; после котла на подаче — воздухоотводчик.</li><li>Воздухосборники в верхних точках, сливы в нижних; уклон горизонталей к сливу не менее 0,002, то есть 2 мм на метр (ТКП 45-1.03-85).</li><li>Балансировочный клапан на каждую ветвь и каждый радиатор; термоголовки с выносным датчиком в представительных комнатах.</li><li>Изоляция труб в неотапливаемых помещениях и в полу обязательна: потери без неё доходят до нескольких процентов сезонной энергии.</li></ul><div class=\"e-basis\"><b>Опрессовка и скрытые работы — точка невозврата</b><p>Систему испытывают давлением 1,5 рабочего (для полимерных труб — по методике производителя, обычно ступенчато) с выдержкой и протоколом; тёплый пол — до заливки стяжки и под давлением во время заливки. Всё, что уходит под стяжку и за отделку, фотографируется с привязкой размеров и актируется. Протечка, найденная после плитки, стоит в 10 раз дороже опрессовки.</p></div><div class=\"e-basis\"><b>Что должно остаться на руках после монтажа</b><p>Исполнительная схема с диаметрами и арматурой; паспорта оборудования и гарантии; акты скрытых работ и опрессовки; протокол пусконаладки с настройками (отопительные кривые, зоны, приоритеты); инструкция владельцу: что делать при отключении электричества, аварии, сезонном простое; регламент ТО.</p></div><div class=\"e-basis\"><b>Энергонезависимость и отключения</b><p>Дом с твердотопливным котлом проектируйте с энергонезависимым резервным контуром или теплоаккумулятором, а насосы и автоматику запитывайте через ИБП с аккумулятором достаточной ёмкости (по потребляемой мощности насосов и автоматики). Газовая и тепловая насосная системы от электричества зависимы целиком: инвертор или генератор с АВР дешевле размороженной системы. Автоматический возврат в работу после аварии питания проверяйте при пусконаладке, а не в первый мороз.</p></div></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Типичные ошибки: 12 способов получить дорогую переделку</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. Мощность «по площади»</h4><p class=\"x\">✗ Котёл выбран как 1 кВт на 10 м² без расчёта теплопотерь.</p><p class=\"v\">✓ Расчёт по комнатам: он даёт мощность, секции, диаметры и баланс.</p></div><div class=\"e-err\"><h4>2. Котёл «×2 на всякий случай»</h4><p class=\"x\">✗ Переразмеренный котёл тактует: КПД и ресурс падают, конденсат губит твердотопливный.</p><p class=\"v\">✓ Мощность — расчётные потери плюс 10–15 %; пики закрывает резерв или аккумулятор.</p></div><div class=\"e-err\"><h4>3. Разъёмные соединения и PP-R в стяжке</h4><p class=\"x\">✗ Стыки и удлинения под плиткой: протечка вскрывается вместе с полом.</p><p class=\"v\">✓ Скрыто — целые трубы PEX, PE-RT или металлопластик; соединения только в доступных лючках.</p></div><div class=\"e-err\"><h4>4. Контур тёплого пола 130 м</h4><p class=\"x\">✗ Дальний конец петли холодный, насос работает на пределе.</p><p class=\"v\">✓ Петли не более 80–100 м близкой длины, коллектор с расходомерами.</p></div><div class=\"e-err\"><h4>5. Без опрессовки до отделки</h4><p class=\"x\">✗ «Мы всегда так делаем» — потом вскрытие стяжки и иск к подрядчику.</p><p class=\"v\">✓ Опрессовка 1,5 Рраб с протоколом и фото до закрытия; тёплый пол — под давлением при заливке.</p></div><div class=\"e-err\"><h4>6. Расширительный бак «на глаз»</h4><p class=\"x\">✗ Малый объём или нулевая преднастройка: клапан течёт, давление скачет.</p><p class=\"v\">✓ 8–12 % объёма системы, преднастройка по статике, проверка при ТО.</p></div><div class=\"e-err\"><h4>7. Нет воздухосборников</h4><p class=\"x\">✗ Воздушные пробки в верхних точках: шум, холодные секции, коррозия.</p><p class=\"v\">✓ Автовоздухоотводчики на высоких точках и коллекторах, сливы внизу.</p></div><div class=\"e-err\"><h4>8. Без балансировки</h4><p class=\"x\">✗ Ближние радиаторы жарят, дальние мёрзнут, котёл не выходит на режим.</p><p class=\"v\">✓ Балансировочные клапаны по ветвям и приборам, настройка по расходу.</p></div><div class=\"e-err\"><h4>9. Термоголовка без байпаса в ЦО</h4><p class=\"x\">✗ В однотрубном стояке квартира «закрывает» соседей и разбалансирует систему.</p><p class=\"v\">✓ Байпас перед прибором в однотрубной схеме; в двухтрубной — балансировка.</p></div><div class=\"e-err\"><h4>10. Экраны и ниши для радиаторов</h4><p class=\"x\">✗ Декоративный короб снимает 20–30 % теплоотдачи, датчик врёт.</p><p class=\"v\">✓ Прибор открыт или с решёткой сверху; датчик термоголовки вне потока тепла.</p></div><div class=\"e-err\"><h4>11. Нет погодной автоматики</h4><p class=\"x\">✗ Котёл греет по датчику котла: перегрев, форточки, на 15–25 % выше счёт.</p><p class=\"v\">✓ Погодозависимая кривая и зонные термостаты, окупаемость 1–2 сезона.</p></div><div class=\"e-err\"><h4>12. Автомобильный антифриз</h4><p class=\"x\">✗ Соли и присадки разъедают алюминий и уплотнения, насос клинит.</p><p class=\"v\">✓ Только вода или специализированный пропиленгликоль, совместимый с котлом.</p></div></div><div class=\"e-basis\"><b>Цена ошибки</b><p>Переделка скрытых дефектов отопления обычно в несколько раз дороже исходного монтажа: вскрытие стяжки и отделки, замена контуров, повторная отделка, простой дома зимой. Поэтому приёмка строится вокруг документов: протоколы, акты, исполнительная схема.</p></div></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>Что смотреть в первую очередь: чек-лист заказчика</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 306\" role=\"img\" aria-label=\"Пирамида приоритетов при приёмке отопления\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"10\" y=\"10\" width=\"250\" height=\"40\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"135.0\" y=\"36\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">1</text><text x=\"280\" y=\"28\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Проект и расчёт теплопотерь</text><text x=\"280\" y=\"46\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">ошибки этого этапа не лечатся «по месту»</text><rect x=\"10\" y=\"58\" width=\"220\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"120.0\" y=\"84\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">2</text><text x=\"280\" y=\"76\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Источник тепла и резерв</text><text x=\"280\" y=\"94\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">мощность по расчёту, а не «×2 на всякий случай»</text><rect x=\"10\" y=\"106\" width=\"190\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"105.0\" y=\"132\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">3</text><text x=\"280\" y=\"124\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Гидравлика и материалы</text><text x=\"280\" y=\"142\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">схема, диаметры, трубы и фитинги одного бренда</text><rect x=\"10\" y=\"154\" width=\"160\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"90.0\" y=\"180\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">4</text><text x=\"280\" y=\"172\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Монтаж и опрессовка</text><text x=\"280\" y=\"190\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">акты скрытых работ до закрытия стяжкой и отделкой</text><rect x=\"10\" y=\"202\" width=\"130\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"75.0\" y=\"228\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">5</text><text x=\"280\" y=\"220\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Автоматика и зонирование</text><text x=\"280\" y=\"238\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">до −15 % потребления, комфорт по комнатам</text><rect x=\"10\" y=\"250\" width=\"100\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"60.0\" y=\"276\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">6</text><text x=\"280\" y=\"268\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Пусконаладка и сервис</text><text x=\"280\" y=\"286\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">балансировка, режимы, обучение, ТО раз в год</text></svg><figcaption>Нижние уровни определяют стоимость верхних: экономия на проекте «съедается» на котле, экономия на монтаже — на отделке.</figcaption></figure><h4 class=\"e-h4\">Вопросы подрядчику до подписания договора</h4><ul class=\"e-ul\"><li>Где расчёт теплопотерь по комнатам и гидравлический расчёт? Покажите исходники и допущения.</li><li>Какая мощность источника и какой резерв? Что происходит с домом при отключении электричества и газа?</li><li>Какие трубы и фитинги (бренд, кислородный барьер, гарантия)? Кто даёт гарантию на стык «труба + фитинг»?</li><li>Что входит в пусконаладку: отопительные кривые, зонирование, балансировка, обучение, протокол?</li><li>Какие документы я получу: исполнительную схему, акты скрытых работ и опрессовки, паспорта, гарантию?</li><li>Кто обслуживает систему после сдачи и каков регламент ТО (периодичность, стоимость, сроки реакции)?</li></ul><div class=\"e-basis\"><b>Красные флаги подрядчика</b><p>«Проект не нужен, сделаем по месту»; смета без спецификации оборудования и материалов; «все ставят такие трубы»; отсутствие пресс-инструмента и манометра на объекте; отказ от опрессовки «до отделки»; гарантия «на словах». Любого из пунктов достаточно, чтобы не подписывать договор.</p></div><h4 class=\"e-h4\">Пять тезисов, с которыми можно принимать решение</h4><ul class=\"e-ul\"><li>Сначала расчёт теплопотерь и гидравлики — потом оборудование. Всё остальное следствие.</li><li>Источник выбирается по стоимости кВт·ч тепла и надёжности, а не по привычке: сравните газ, тепловой насос, электроотопление и твёрдое топливо на своих тарифах во вкладке «Стоимость тепла».</li><li>Низкотемпературная система (тёплые полы и крупные радиаторы) — задел на тепловой насос и конденсацию: она переживёт смену источника без переделки разводки.</li><li>Качество монтажа проверяется документами: опрессовка, акты скрытых работ, исполнительная схема, протокол пусконаладки.</li><li>Автоматика окупается быстрее всего: погодный режим и зоны дают −10…−20 % потребления при том же комфорте.</li></ul><p class=\"e-note\">Источники: EHPA, European Heat Pump Market Report 2025/26 (предварительные данные); Директива (EU) 2024/1275 (EPBD); ТКП 45-1.03-85-2007; СН 4.02.03-2019; Постановление Совета Министров Республики Беларусь от 25.02.2026 № 93. Числа в таблицах и ориентиры по теплопотерям — типовые оценки для предварительных расчётов, окончательные значения берут из проекта, паспортов оборудования и действующих нормативов.</p></div></section><section class=\"e-panel\" id=\"hloss\" data-panel=\"hloss\"><div class=\"e-sech\"><small>03</small><h2>Теплопотери помещения</h2></div><p class=\"e-lead2\">Оценка тепловой мощности, которую нужно подать в помещение в расчётный мороз. Потери через стены, окна, потолок и пол плюс подогрев воздуха на вентиляцию.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"hl-s\">Площадь помещения</label><div class=\"e-in\"><input id=\"hl-s\" inputmode=\"decimal\" autocomplete=\"off\" value=\"18\"><span class=\"u\">м²</span></div></div><div class=\"e-f\"><label for=\"hl-h\">Высота потолка</label><div class=\"e-in\"><input id=\"hl-h\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,7\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"hl-ti\">Температура в помещении</label><div class=\"e-in\"><input id=\"hl-ti\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"hl-te\">Наружная температура</label><div class=\"e-in\"><input id=\"hl-te\" inputmode=\"decimal\" autocomplete=\"off\" value=\"−24\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"hl-aw\">Площадь наружных стен без окон</label><div class=\"e-in\"><input id=\"hl-aw\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">м²</span></div></div><div class=\"e-f wide\"><label for=\"hl-uw\">Стена</label><div class=\"e-in\"><select id=\"hl-uw\"><option value=\"1.1\" selected>Кирпич 510 мм без утепления</option><option value=\"0.6\">Кирпич 380 мм с утеплителем 50 мм</option><option value=\"0.3\">Газобетон или стена с утеплителем 150 мм</option><option value=\"0.2\">Утеплённая стена, энергоэффективный дом</option></select></div></div><div class=\"e-f\"><label for=\"hl-ag\">Площадь окон</label><div class=\"e-in\"><input id=\"hl-ag\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м²</span></div></div><div class=\"e-f wide\"><label for=\"hl-ug\">Окна</label><div class=\"e-in\"><select id=\"hl-ug\"><option value=\"2.6\" selected>Старые двойные рамы</option><option value=\"1.4\">Стеклопакет двухкамерный</option><option value=\"1.0\">Энергосберегающий трёхкамерный</option></select></div></div><div class=\"e-f wide\"><label for=\"hl-roof\">Потолок</label><div class=\"e-in\"><select id=\"hl-roof\"><option value=\"0\" selected>Над ним отапливаемое помещение</option><option value=\"0.3\">Утеплённая кровля или чердак</option><option value=\"1.0\">Неутеплённое перекрытие</option></select></div></div><div class=\"e-f wide\"><label for=\"hl-floor\">Пол</label><div class=\"e-in\"><select id=\"hl-floor\"><option value=\"0\" selected>Под ним отапливаемое помещение</option><option value=\"0.35\">По грунту, утеплён</option><option value=\"0.8\">По грунту, без утепления</option></select></div></div><div class=\"e-f\"><label for=\"hl-n\">Воздухообмен</label><div class=\"e-in\"><input id=\"hl-n\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,5\"><span class=\"u\">раз/ч</span></div></div><div class=\"e-f\"><label for=\"hl-add\">Добавка на углы и ориентацию</label><div class=\"e-in\"><input id=\"hl-add\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">%</span></div></div></div><p class=\"e-note\">Расчётная наружная температура для Минска ориентировочно −24 °С: уточните по ТКП 45-2.04-43. Воздухообмен 0,5 раз в час — наименьший по СН 4.02.03.</p><div class=\"e-formula\">Q = (Σ U · A + U · S) · (tв − tн) + 0,335 · n · V · (tв − tн)<br>U — коэффициент теплопередачи, Вт/(м²·К); 0,335 Вт·ч/(м³·К) — теплоёмкость воздуха</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Через ограждения</span><b id=\"hl-tr\">—</b></div><div class=\"kv\"><span>На подогрев воздуха</span><b id=\"hl-vent\">—</b></div><div class=\"kv\"><span>Всего с добавкой</span><b id=\"hl-total\">—</b></div><div class=\"kv\"><span>На 1 м² пола</span><b id=\"hl-m2\">—</b></div><div class=\"verdict\" id=\"hl-verdict\" role=\"status\"></div><button class=\"e-btn wide\" id=\"hl-to-r\" type=\"button\">Подобрать радиатор</button><button class=\"e-btn wide\" id=\"hl-to-p\" type=\"button\">Подобрать трубу</button><button class=\"e-btn wide\" id=\"hl-to-f\" type=\"button\">Проверить тёплый пол</button></div></div></div></section><section class=\"e-panel\" id=\"radiators\" data-panel=\"radiators\"><div class=\"e-sech\"><small>04</small><h2>Секции радиатора</h2></div><p class=\"e-lead2\">Сколько секций поставить при выбранном температурном графике. Мощность секции у разных моделей разная: берите из паспорта.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"hr-q\">Нужная мощность</label><div class=\"e-in\"><input id=\"hr-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1200\"><span class=\"u\">Вт</span></div></div><div class=\"e-f\"><label for=\"hr-tf\">Температура подачи</label><div class=\"e-in\"><input id=\"hr-tf\" inputmode=\"decimal\" autocomplete=\"off\" value=\"75\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"hr-tr\">Температура обратки</label><div class=\"e-in\"><input id=\"hr-tr\" inputmode=\"decimal\" autocomplete=\"off\" value=\"65\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"hr-ti\">Температура в помещении</label><div class=\"e-in\"><input id=\"hr-ti\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"hr-type\">Тип радиатора</label><div class=\"e-in\"><select id=\"hr-type\"><option value=\"185\" selected>Алюминиевый 500 мм</option><option value=\"170\">Биметаллический 500 мм</option><option value=\"150\">Чугунный 500 мм</option></select></div></div><div class=\"e-f\"><label for=\"hr-sec\">Мощность секции при Δt = 70 К</label><div class=\"e-in\"><input id=\"hr-sec\" inputmode=\"decimal\" autocomplete=\"off\" value=\"185\"><span class=\"u\">Вт</span></div></div><div class=\"e-f\"><label for=\"hr-exp\">Показатель радиатора n</label><div class=\"e-in\"><input id=\"hr-exp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,3\"></div></div></div><div class=\"e-formula\">Q = Qном · (Δt ÷ 70)ⁿ<br>Δt = (tподачи + tобратки) ÷ 2 − tпомещения</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Средний температурный напор</span><b id=\"hr-dt\">—</b></div><div class=\"kv\"><span>Доля от номинала</span><b id=\"hr-k\">—</b></div><div class=\"kv\"><span>Номинальная мощность</span><b id=\"hr-nom\">—</b></div><div class=\"kv\"><span>Секций</span><b id=\"hr-n\">—</b></div><div class=\"kv\"><span>Расход воды</span><b id=\"hr-g\">—</b></div><div class=\"kv\"><span>Кронштейнов (ТКП 45-1.03-85)</span><b id=\"hr-br\">—</b></div><div class=\"verdict\" id=\"hr-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"hpipes\" data-panel=\"hpipes\"><div class=\"e-sech\"><small>05</small><h2>Трубы отопления</h2></div><p class=\"e-lead2\">Диаметр трубы на участок по тепловой мощности и допустимой скорости воды. В жилье скорость берут 0,3–0,7 м/с, чтобы не шумело.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"hp-q\">Мощность участка</label><div class=\"e-in\"><input id=\"hp-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3000\"><span class=\"u\">Вт</span></div></div><div class=\"e-f\"><label for=\"hp-tf\">Температура подачи</label><div class=\"e-in\"><input id=\"hp-tf\" inputmode=\"decimal\" autocomplete=\"off\" value=\"75\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"hp-tr\">Температура обратки</label><div class=\"e-in\"><input id=\"hp-tr\" inputmode=\"decimal\" autocomplete=\"off\" value=\"65\"><span class=\"u\">°С</span></div></div><div class=\"e-f wide\"><label for=\"hp-s\">Труба</label><div class=\"e-in\"><select id=\"hp-s\"><option value=\"ppr\" selected>Полипропилен PP-R, PN20</option><option value=\"mp\">Металлопластик</option><option value=\"pex\">Сшитый полиэтилен PEX</option><option value=\"steel\">Стальная водогазопроводная</option></select></div></div><div class=\"e-f\"><label for=\"hp-vmax\">Допустимая скорость</label><div class=\"e-in\"><input id=\"hp-vmax\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,5\"><span class=\"u\">м/с</span></div></div></div><div class=\"e-formula\">G = Q ÷ (c · (tпод − tобр))<br>d = √(4 · G ÷ (ρ · π · v)); c = 4190 Дж/(кг·К)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Расход теплоносителя</span><b id=\"hp-g\">—</b></div><div class=\"kv\"><span>Диаметр по скорости</span><b id=\"hp-d\">—</b></div><div class=\"kv\"><span>Труба</span><b id=\"hp-pipe\">—</b></div><div class=\"kv\"><span>Скорость</span><b id=\"hp-v\">—</b></div><div class=\"kv\"><span>Потери на метр</span><b id=\"hp-r\">—</b></div><div class=\"verdict\" id=\"hp-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"floor\" data-panel=\"floor\"><div class=\"e-sech\"><small>06</small><h2>Тёплый пол</h2></div><p class=\"e-lead2\">Отдача водяного тёплого пола, длина трубы, число контуров и расход воды.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"hf-s\">Площадь обогрева</label><div class=\"e-in\"><input id=\"hf-s\" inputmode=\"decimal\" autocomplete=\"off\" value=\"15\"><span class=\"u\">м²</span></div></div><div class=\"e-f\"><label for=\"hf-step\">Шаг укладки</label><div class=\"e-in\"><select id=\"hf-step\"><option value=\"100\">100 мм</option><option value=\"150\" selected>150 мм</option><option value=\"200\">200 мм</option><option value=\"250\">250 мм</option><option value=\"300\">300 мм</option></select></div></div><div class=\"e-f\"><label for=\"hf-tf\">Температура поверхности пола</label><div class=\"e-in\"><input id=\"hf-tf\" inputmode=\"decimal\" autocomplete=\"off\" value=\"27\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"hf-ti\">Температура в помещении</label><div class=\"e-in\"><input id=\"hf-ti\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"hf-lead\">Подводящие линии (в одну сторону)</label><div class=\"e-in\"><input id=\"hf-lead\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"hf-lmax\">Длина одного контура, не более</label><div class=\"e-in\"><input id=\"hf-lmax\" inputmode=\"decimal\" autocomplete=\"off\" value=\"100\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"hf-dt\">Перепад температур воды</label><div class=\"e-in\"><input id=\"hf-dt\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">К</span></div></div><div class=\"e-f\"><label for=\"hf-need\">Потери помещения (если известны)</label><div class=\"e-in\"><input id=\"hf-need\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">Вт</span></div></div></div><div class=\"e-formula\">q = 8,92 · (tпола − tпомещения)^1,1, Вт/м² (упрощённая формула EN 1264)<br>Длина = S ÷ шаг × 1,05 + подводящие линии × 2</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Отдача пола</span><b id=\"hf-q\">—</b></div><div class=\"kv\"><span>Мощность пола</span><b id=\"hf-cap\">—</b></div><div class=\"kv\"><span>Длина трубы</span><b id=\"hf-len\">—</b></div><div class=\"kv\"><span>Контуров</span><b id=\"hf-loops\">—</b></div><div class=\"kv\"><span>Расход воды</span><b id=\"hf-g\">—</b></div><div class=\"verdict\" id=\"hf-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"expansion\" data-panel=\"expansion\"><div class=\"e-sech\"><small>07</small><h2>Расширительный бак</h2></div><p class=\"e-lead2\">Объём бака закрытой системы отопления. Вода при нагреве расширяется, бак принимает излишек.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"hx-vs\">Объём воды в системе</label><div class=\"e-in\"><input id=\"hx-vs\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">л</span></div></div><div class=\"e-f\"><label for=\"hx-kw\">или мощность котла</label><div class=\"e-in\"><input id=\"hx-kw\" inputmode=\"decimal\" autocomplete=\"off\" value=\"24\"><span class=\"u\">кВт</span></div></div><div class=\"e-f\"><label for=\"hx-t\">Наибольшая температура воды</label><div class=\"e-in\"><input id=\"hx-t\" inputmode=\"decimal\" autocomplete=\"off\" value=\"80\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"hx-p0\">Давление в баке и холодной системе</label><div class=\"e-in\"><input id=\"hx-p0\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,5\"><span class=\"u\">бар</span></div></div><div class=\"e-f\"><label for=\"hx-pm\">Давление открытия клапана</label><div class=\"e-in\"><input id=\"hx-pm\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3,0\"><span class=\"u\">бар</span></div></div></div><p class=\"e-note\">Если объём воды неизвестен, берётся 12 л на 1 кВт мощности котла — грубая оценка. Давления избыточные, по манометру.</p><div class=\"e-formula\">V = Vсист · e ÷ (1 − P₀ ÷ Pmax)<br>e — расширение воды от 10 °С до рабочей температуры; P₀, Pmax — абсолютные давления</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Объём воды</span><b id=\"hx-vso\">—</b></div><div class=\"kv\"><span>Расширение воды</span><b id=\"hx-e\">—</b></div><div class=\"kv\"><span>Нужный объём бака</span><b id=\"hx-v\">—</b></div><div class=\"kv\"><span>Ближайший бак</span><b id=\"hx-tank\">—</b></div><div class=\"verdict\" id=\"hx-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"cost\" data-panel=\"cost\"><div class=\"e-sech\"><small>08</small><h2>Стоимость тепла по видам топлива</h2></div><p class=\"e-lead2\">Сколько стоит киловатт-час тепла от разных источников и сколько выйдет за отопительный сезон. Подставьте свои цены и КПД. Для теплового насоса вводится сезонный COP в процентах, например 300 % означает 3 кВт·ч тепла на 1 кВт·ч электричества.</p><div class=\"e-row\"><div class=\"e-f\"><label for=\"hc-q\">Потребность в тепле за сезон</label><div class=\"e-in\"><input id=\"hc-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20000\"><span class=\"u\">кВт·ч</span></div></div></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Источник</th><th>КПД или COP</th><th>Цена</th><th>1 кВт·ч тепла, BYN</th><th>За сезон, BYN</th></tr></thead><tbody><tr><td>Тепловой насос «воздух–вода»</td><td><div class=\"e-in\"><input id=\"hc-e-hp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"300\"><span class=\"u\">%</span></div></td><td><div class=\"e-in\"><input id=\"hc-p-hp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,0487\"><span class=\"u\">BYN за кВт·ч электричества</span></div></td><td class=\"m\" id=\"hc-c-hp\">—</td><td class=\"m\" id=\"hc-s-hp\">—</td></tr><tr><td>Электрокотёл, льготный тариф</td><td><div class=\"e-in\"><input id=\"hc-e-ebp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"99\"><span class=\"u\">%</span></div></td><td><div class=\"e-in\"><input id=\"hc-p-ebp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,0487\"><span class=\"u\">BYN за кВт·ч электричества</span></div></td><td class=\"m\" id=\"hc-c-ebp\">—</td><td class=\"m\" id=\"hc-s-ebp\">—</td></tr><tr><td>Электрокотёл, обычный тариф</td><td><div class=\"e-in\"><input id=\"hc-e-eb\" inputmode=\"decimal\" autocomplete=\"off\" value=\"99\"><span class=\"u\">%</span></div></td><td><div class=\"e-in\"><input id=\"hc-p-eb\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,2581\"><span class=\"u\">BYN за кВт·ч электричества</span></div></td><td class=\"m\" id=\"hc-c-eb\">—</td><td class=\"m\" id=\"hc-s-eb\">—</td></tr><tr><td>Газ магистральный</td><td><div class=\"e-in\"><input id=\"hc-e-gas\" inputmode=\"decimal\" autocomplete=\"off\" value=\"95\"><span class=\"u\">%</span></div></td><td><div class=\"e-in\"><input id=\"hc-p-gas\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN за м³ (9,3 кВт·ч/м³)</span></div></td><td class=\"m\" id=\"hc-c-gas\">—</td><td class=\"m\" id=\"hc-s-gas\">—</td></tr><tr><td>Дрова</td><td><div class=\"e-in\"><input id=\"hc-e-wood\" inputmode=\"decimal\" autocomplete=\"off\" value=\"75\"><span class=\"u\">%</span></div></td><td><div class=\"e-in\"><input id=\"hc-p-wood\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN за тонна (4 000 кВт·ч/т)</span></div></td><td class=\"m\" id=\"hc-c-wood\">—</td><td class=\"m\" id=\"hc-s-wood\">—</td></tr><tr><td>Пеллеты</td><td><div class=\"e-in\"><input id=\"hc-e-pel\" inputmode=\"decimal\" autocomplete=\"off\" value=\"85\"><span class=\"u\">%</span></div></td><td><div class=\"e-in\"><input id=\"hc-p-pel\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN за тонна (4 800 кВт·ч/т)</span></div></td><td class=\"m\" id=\"hc-c-pel\">—</td><td class=\"m\" id=\"hc-s-pel\">—</td></tr><tr><td>Сжиженный газ</td><td><div class=\"e-in\"><input id=\"hc-e-lpg\" inputmode=\"decimal\" autocomplete=\"off\" value=\"92\"><span class=\"u\">%</span></div></td><td><div class=\"e-in\"><input id=\"hc-p-lpg\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">BYN за литр (6,9 кВт·ч/л)</span></div></td><td class=\"m\" id=\"hc-c-lpg\">—</td><td class=\"m\" id=\"hc-s-lpg\">—</td></tr></tbody></table></div><div class=\"e-bars\" id=\"hc-bars\" aria-label=\"Стоимость 1 кВт·ч тепла\"></div><div class=\"verdict\" id=\"hc-verdict\" role=\"status\"></div><p class=\"e-note\">Цены на электричество подставлены по справочным данным с 1 июня 2026 года (обычный 25,81 коп., льготный для электроотопления 4,87 коп. за кВт·ч, по постановлению Совета Министров № 93 от 25.02.2026): сверьте их со своим счётом. Цены на газ, дрова, пеллеты и сжиженный газ вводите сами, они зависят от поставщика. Льготный тариф даётся домам без центрального отопления и газа и при отдельном счётчике: проверьте условия для своего дома. Тепловой насос при расчёте на сезон берут по сезонному COP из паспорта: в сильные морозы он ниже.</p></section><section class=\"e-panel\" id=\"expand\" data-panel=\"expand\"><div class=\"e-sech\"><small>09</small><h2>Тепловое удлинение труб</h2></div><p class=\"e-lead2\">На сколько удлиняется труба при нагреве и какой запас нужен на компенсацию. Для полимерных труб это обязательная проверка: без неё трубы выгибаются, шумят и рвут крепления.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"ex-m\">Материал трубы</label><div class=\"e-in\"><select id=\"ex-m\"><option value=\"0.15\" selected>PP-R без армирования</option><option value=\"0.04\">PP-R, армированный стекловолокном</option><option value=\"0.03\">PP-R, армированный алюминием</option><option value=\"0.15\">PEX</option><option value=\"0.18\">PE-RT</option><option value=\"0.026\">Металлопластик</option><option value=\"0.012\">Сталь</option><option value=\"0.017\">Медь</option></select></div></div><div class=\"e-f\"><label for=\"ex-l\">Длина прямого участка</label><div class=\"e-in\"><input id=\"ex-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"ex-tw\">Температура теплоносителя</label><div class=\"e-in\"><input id=\"ex-tw\" inputmode=\"decimal\" autocomplete=\"off\" value=\"70\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"ex-tm\">Температура при монтаже</label><div class=\"e-in\"><input id=\"ex-tm\" inputmode=\"decimal\" autocomplete=\"off\" value=\"15\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"ex-d\">Наружный диаметр трубы</label><div class=\"e-in\"><input id=\"ex-d\" inputmode=\"decimal\" autocomplete=\"off\" value=\"25\"><span class=\"u\">мм</span></div></div></div><div class=\"e-formula\">ΔL = α · L · ΔT<br>α — коэффициент линейного расширения, мм/(м·К); плечо Г-образного участка L ≈ 30 · √(d · ΔL) (для полимерных труб, ориентир)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Перепад температур</span><b id=\"ex-dt\">—</b></div><div class=\"kv\"><span>Удлинение</span><b id=\"ex-dl\">—</b></div><div class=\"kv\"><span>Плечо компенсации, ориентир</span><b id=\"ex-arm\">—</b></div><div class=\"verdict\" id=\"ex-verdict\" role=\"status\"></div></div></div></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Это ориентировочные расчёты для сметы и разговора с проектировщиком, а не проект. Формулы взяты из гидравлики и теплотехники, числа нормативов — из справочника «Качество работ». Окончательные значения проверяют по действующим СН и ТКП и по паспортам оборудования. Температуры теплоносителя по помещениям, скорости воды по шуму, расстояния установки приборов и пуск тёплого пола — в «Качество работ».</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/inzh.js?v=9\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstVentTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Вентиляция</div><h1>Вентиляция: расчёты</h1><p class=\"e-lead\">Расход воздуха для помещения, диаметр воздуховодов, число решёток, мощность калорифера, проверка тяги шахты и статья о современных системах вентиляции.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\" class=\"on\" aria-current=\"page\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Вентиляция: расчёты\"><a href=\"#overview\" data-sub=\"overview\" class=\"art\">Современные системы</a><a href=\"#vair\" data-sub=\"vair\">Воздухообмен</a><a href=\"#duct\" data-sub=\"duct\">Воздуховоды</a><a href=\"#grille\" data-sub=\"grille\">Решётки</a><a href=\"#vheat\" data-sub=\"vheat\">Нагрев воздуха</a><a href=\"#draft\" data-sub=\"draft\">Тяга и опрокидывание</a></div><div class=\"e-elec\" id=\"e-inzh\" data-page=\"vent\"><section class=\"e-panel\" id=\"overview\" data-panel=\"overview\"><div class=\"e-sech\"><small>01</small><h2>Современные системы вентиляции</h2></div><p class=\"e-lead2\">Практикум для заказчика: тенденции, материалы, схемы, монтаж и типичные ошибки. Расчёты из других вкладок подставляйте в свой проект.</p><div class=\"e-art\" id=\"art0\"><div class=\"e-sech\"><small>0</small><h3>Почему вентиляция стала главной инженерной темой</h3></div><p class=\"e-lead2\">Современный дом герметичен: пластиковые окна, утеплённый контур, мембраны. Вместе со сквозняками из него ушла и естественная вентиляция: воздух перестал обновляться сам. Результат предсказуем: CO₂ выше 1400 ppm к утру, влажность выше 60 % и конденсат на окнах, запахи и летучие органические вещества от отделки и мебели. Вентиляция сегодня не «пара решёток», а рассчитанная система с балансом притока и вытяжки, рекуперацией тепла и управлением по датчикам.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 760 140\" role=\"img\" aria-label=\"Пять шагов: баланс, схема, оборудование, воздуховоды, наладка\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"8\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"20\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">1</text><text x=\"20\" y=\"70\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Баланс воздуха</text><text x=\"20\" y=\"92\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">притока и вытяжки</text><text x=\"20\" y=\"106\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">по комнатам</text><line x1=\"136\" y1=\"70\" x2=\"154\" y2=\"70\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"154,70 145.9,73.9 145.9,66.1\" fill=\"#9a9ca3\"/><rect x=\"156\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"168\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">2</text><text x=\"168\" y=\"70\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Схема и зоны</text><text x=\"168\" y=\"92\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">трассы, акустика,</text><text x=\"168\" y=\"106\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">место узла</text><line x1=\"284\" y1=\"70\" x2=\"302\" y2=\"70\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"302,70 293.9,73.9 293.9,66.1\" fill=\"#9a9ca3\"/><rect x=\"304\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"316\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">3</text><text x=\"316\" y=\"70\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Оборудование</text><text x=\"316\" y=\"92\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">рекуперация, SFP,</text><text x=\"316\" y=\"106\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">шум, фильтры</text><line x1=\"432\" y1=\"70\" x2=\"450\" y2=\"70\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"450,70 441.9,73.9 441.9,66.1\" fill=\"#9a9ca3\"/><rect x=\"452\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"464\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">4</text><text x=\"464\" y=\"70\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Воздуховоды</text><text x=\"464\" y=\"92\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">герметичные, в</text><text x=\"464\" y=\"106\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">изоляции</text><line x1=\"580\" y1=\"70\" x2=\"598\" y2=\"70\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"598,70 589.9,73.9 589.9,66.1\" fill=\"#9a9ca3\"/><rect x=\"600\" y=\"10\" width=\"126\" height=\"120\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"612\" y=\"40\" font-size=\"26\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">5</text><text x=\"612\" y=\"70\" font-size=\"13\" fill=\"#ffffff\" text-anchor=\"start\" font-weight=\"700\">Наладка и ТО</text><text x=\"612\" y=\"92\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">балансировка,</text><text x=\"612\" y=\"106\" font-size=\"11\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">режимы, фильтры</text></svg><figcaption>Порядок, который экономит деньги: ошибка на любом шаге превращает вентиляцию в дорогой шум.</figcaption></figure><p class=\"e-lead2\">Гигиенический ориентир: 800–1000 ppm CO₂ и относительная влажность 40–60 %. В исследовании Harvard COGfx (Allen и др., 2016) результаты когнитивных тестов при около 950 ppm были примерно на 15 % ниже, а при около 1400 ppm примерно на 50 % ниже, чем при около 550 ppm. Работа небольшая, а связь именно CO₂ с эффектом позже оспаривалась: в более поздних экспериментах при тех же уровнях чистого CO₂ эффект не подтверждался. Поэтому правильнее считать CO₂ индикатором достаточности воздухообмена вместе с запахами, влажностью и летучими веществами, а не единственной причиной.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 780 270\" role=\"img\" aria-label=\"Установившаяся концентрация CO₂ в зависимости от притока воздуха на человека\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"188\" y=\"48\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">5 м³/ч на человека</text><text x=\"188\" y=\"63\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">щели закрытой комнаты</text><rect x=\"200\" y=\"34\" width=\"450.77272727272725\" height=\"32\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"658.7727272727273\" y=\"55\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">4 220 ppm</text><text x=\"188\" y=\"92\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">10 м³/ч</text><text x=\"188\" y=\"107\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">форточка в щель</text><rect x=\"200\" y=\"78\" width=\"247.8181818181818\" height=\"32\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"455.8181818181818\" y=\"99\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">2 320 ppm</text><text x=\"188\" y=\"136\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">20 м³/ч</text><text x=\"188\" y=\"151\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">ниже нормы</text><rect x=\"200\" y=\"122\" width=\"146.3409090909091\" height=\"32\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"354.3409090909091\" y=\"143\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">1 370 ppm</text><text x=\"188\" y=\"180\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">30 м³/ч</text><text x=\"188\" y=\"195\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">норма на человека</text><rect x=\"200\" y=\"166\" width=\"112.51515151515153\" height=\"32\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"320.5151515151515\" y=\"187\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">1 050 ppm</text><text x=\"188\" y=\"224\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\">60 м³/ч</text><text x=\"188\" y=\"239\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">с запасом</text><rect x=\"200\" y=\"210\" width=\"78.68939393939394\" height=\"32\" rx=\"0\" fill=\"#7d8089\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"286.68939393939394\" y=\"231\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">740 ppm</text><line x1=\"306.8181818181818\" y1=\"20\" x2=\"306.8181818181818\" y2=\"246\" stroke=\"#4a4d55\" stroke-width=\"1.5\" stroke-dasharray=\"4 4\"/><text x=\"306.8181818181818\" y=\"14\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">1000</text><line x1=\"349.5454545454545\" y1=\"20\" x2=\"349.5454545454545\" y2=\"246\" stroke=\"#4a4d55\" stroke-width=\"1.5\" stroke-dasharray=\"4 4\"/><text x=\"349.5454545454545\" y=\"14\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">1400</text></svg><figcaption>Установившаяся концентрация CO₂ при одном человеке (выдох около 19 л/ч CO₂, наружный воздух 420 ppm). Это расчётный предел при постоянном расходе, а не измерение. Красный — выше 1400 ppm, чёрный — 1000–1400, серый — до 1000 ppm. Норма 30 м³/ч на человека как раз даёт около 1000 ppm.</figcaption></figure><p class=\"e-lead2\">Нормируется и расход: для жилых комнат 30 м³/ч на человека (или 3 м³/ч на 1 м² жилой площади, берут большее), кухня 60–90 м³/ч, санузлы по 25 м³/ч. Эти числа и есть исходные данные расчёта, а не паспортный расход вентилятора «на максимуме». Посчитать их можно во вкладке «Воздухообмен».</p><div class=\"e-basis\"><b>Главный принцип</b><p>Вентиляция считается как баланс притока и вытяжки по комнатам: подаём в «чистые» (спальни, гостиные), забираем из «мокрых» (кухня, санузлы, постирочные), переток идёт под дверями. Естественные шахты в герметичном доме без притока не работают: летом нет перепада температур, зимой без притока они опрокидываются (подробно во вкладке «Тяга и опрокидывание»). Поэтому сначала таблица расходов, потом оборудование.</p></div></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Мировые тенденции: вентиляция из «опции» стала стандартом</h3></div><div class=\"e-kpis\"><div class=\"e-kpi\"><b>90 %</b><span>времени человек проводит в помещениях</span></div><div class=\"e-kpi\"><b>800–1000 ppm</b><span>гигиенический ориентир по CO₂</span></div><div class=\"e-kpi\"><b>70–85 %</b><span>реальная рекуперация в работе (в паспорте до 90 %)</span></div><div class=\"e-kpi\"><b>30–50 %</b><span>экономия энергии вентиляторов и нагрева даёт управление по потребности</span></div></div><ul class=\"e-ul\"><li><b>Качество воздуха как измеряемый показатель.</b> После пандемии CO₂, PM2.5 и кратность воздухообмена вошли в нормы и корпоративные стандарты офисов. Датчики CO₂ и индикаторы качества воздуха стали штатной частью приточных установок и бризеров.</li><li><b>Вентиляция по потребности (DCV).</b> Расход следует за присутствием людей: датчики CO₂ и присутствия управляют заслонками и VAV-модулями. Экономия 30–50 % энергии вентиляторов и нагрева притока против постоянной подачи (по данным производителей и обзоров, зависит от загрузки помещения).</li><li><b>Энтальпийные рекуператоры.</b> Мембранные теплообменники возвращают не только тепло, но и влагу: зимой воздух не пересушивается, летом снижается нагрузка на кондиционирование, часто отпадает дренаж конденсата.</li><li><b>Энергоэффективность узлов.</b> EC-вентиляторы, удельная мощность SFP ниже 0,3–0,45 Вт/(м³/ч) как практический ориентир, аэродинамика корпуса. Регламент ЕС 1253/2014 (Ecodesign) с 2018 года требует для нежилых двунаправленных установок рекуперацию не ниже 73 % (для гликолевого контура 68 %) и ограничивает удельную мощность вентиляторов. Для жилых установок введён класс SEC по сезонной экономии энергии.</li><li><b>Интеграция с отоплением и умным домом.</b> Один контроллер для вентиляции, теплового насоса и увлажнения; сценарии «никого нет», «гости», ночной режим; статистика качества воздуха в приложении.</li><li><b>Фильтрация по ISO 16890.</b> Классы ePM10, ePM2.5, ePM1 подбираются под среду: для города ePM1, для аллергиков опционально ступень HEPA. Фильтр стал расходником с регламентом, а не «сеточкой на решётке».</li></ul><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Группа ISO 16890</th><th>Какие частицы задерживает</th><th>Где уместна</th></tr></thead><tbody><tr><td>ISO Coarse (грубая)</td><td>крупнее 10 мкм: пух, песок, насекомые</td><td>первая ступень, защита рекуператора</td></tr><tr><td>ePM10</td><td>от 0,3 до 10 мкм: пыль, пыльца</td><td>базовая очистка притока</td></tr><tr><td>ePM2.5</td><td>до 2,5 мкм: мелкая пыль, часть сажи</td><td>город, жильё</td></tr><tr><td>ePM1</td><td>до 1 мкм: дым, бактерии, мелкий аэрозоль</td><td>город с трафиком, аллергики</td></tr></tbody></table></div><p class=\"e-lead2\">Средний вывод: один рекуператор экономит больше любой «премиальной» отделки, но только если он работает в паспортной точке, а не «на максимуме». Ниже оценка тепла, которое уходит с вытяжным воздухом за сезон.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 740 260\" role=\"img\" aria-label=\"Потери тепла с вытяжным воздухом за отопительный сезон\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"70\" y1=\"20\" x2=\"70\" y2=\"220\" stroke=\"#4a4d55\" stroke-width=\"1\"/><line x1=\"70\" y1=\"220\" x2=\"710\" y2=\"220\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"14\" y=\"26\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">МВт·ч</text><line x1=\"66\" y1=\"220.0\" x2=\"70\" y2=\"220.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"62\" y=\"224.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0</text><line x1=\"66\" y1=\"180.0\" x2=\"70\" y2=\"180.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"62\" y=\"184.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">2</text><line x1=\"66\" y1=\"140.0\" x2=\"70\" y2=\"140.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"62\" y=\"144.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">4</text><line x1=\"66\" y1=\"100.0\" x2=\"70\" y2=\"100.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"62\" y=\"104.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">6</text><line x1=\"66\" y1=\"60.0\" x2=\"70\" y2=\"60.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"62\" y=\"64.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">8</text><line x1=\"66\" y1=\"20.0\" x2=\"70\" y2=\"20.0\" stroke=\"#4a4d55\" stroke-width=\"1\"/><text x=\"62\" y=\"24.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">10</text><rect x=\"110\" y=\"27.04000000000002\" width=\"90\" height=\"192.95999999999998\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"155\" y=\"19.04000000000002\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">9,6 МВт·ч</text><text x=\"155\" y=\"240\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">Без рекуперации</text><rect x=\"260\" y=\"162.112\" width=\"90\" height=\"57.88800000000001\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"305\" y=\"154.112\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">2,9 МВт·ч</text><text x=\"305\" y=\"240\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">Рекуперация 70 %</text><rect x=\"410\" y=\"191.05599999999998\" width=\"90\" height=\"28.944000000000006\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"455\" y=\"183.05599999999998\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">1,4 МВт·ч</text><text x=\"455\" y=\"240\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">Рекуперация 85 %</text><rect x=\"560\" y=\"204.5632\" width=\"90\" height=\"15.436799999999993\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"605\" y=\"196.5632\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">0,8 МВт·ч</text><text x=\"605\" y=\"240\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">Рекуперация 92 %</text></svg><figcaption>Дом 150 м², приток 300 м³/ч круглосуточно, около 4000 К·сут за сезон (Минск, +20 °С в доме). Без рекуперации на подогрев уходит около 9,6 МВт·ч тепла, рекуператор возвращает большую его часть. Оценка для типового дома, реальный результат зависит от режимов и КПД в рабочей точке.</figcaption></figure><div class=\"e-basis\"><b>А что в Беларуси</b><p>Массовая застройка дала герметичные окна при естественных вытяжных шахтах, и без притока такая схема не работает с момента заселения: духота, конденсат, плесень на откосах. Минимум это приточные клапаны и бризеры, разумный стандарт для коттеджа ПВУ с рекуперацией: при белорусских зимах она возвращает большую часть тепла, затраченного на нагрев притока. В административных зданиях норма приточные установки с DCV по CO₂ в переговорных и open-space.</p></div></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Типы систем и три типа объектов</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Система</th><th>Управление воздухообменом</th><th>Энергия</th><th>Стоимость</th><th>Где уместна</th></tr></thead><tbody><tr><td>Естественная (шахты, клапаны)</td><td>Погодозависимая, нестабильная: летом почти нет, зимой сквозняк</td><td>Не греет приток: все кВт·ч уходят на улицу</td><td>Минимальная</td><td>Старый фонд с негерметичными окнами; резерв</td></tr><tr><td>Приточная механическая (ПУ, бризеры)</td><td>Заданный расход по комнатам, нагрев притока</td><td>Нагрев притока электричеством или водой</td><td>Средняя</td><td>Квартиры, реконструкция, дома с естественной вытяжкой</td></tr><tr><td>Вытяжная механическая</td><td>Стабильный вытяжной расход</td><td>Приток инфильтрацией, неконтролируемый</td><td>Низкая или средняя</td><td>Санузлы, кухни, техпомещения; не для жилых зон</td></tr><tr><td>Приточно-вытяжная с рекуперацией (ПВУ)</td><td>Полный баланс, DCV по CO₂, зонирование</td><td>Рекуперация 75–90 % (по паспорту), EC-вентиляторы</td><td>Высокая</td><td>Коттеджи, новые квартиры, офисы: стандарт сегодня</td></tr></tbody></table></div><p class=\"e-lead2\"><b>Квартира.</b> Вытяжка уже есть: шахты кухни и санузлов. Дефицит всегда по притоку: герметичные окна дают инфильтрацию лишь при микропроветривании. Рабочие схемы: бризеры или компактные приточные установки с фильтром и нагревателем в каждой жилой комнате (30–60 м³/ч) либо квартирная приточная установка с разводкой по комнатам. Критично не ставить мощную вытяжку без компенсирующего притока: тяга шахт опрокидывается, в квартиру приходят запахи соседей, а при газовой колонке это ещё и вопрос безопасности.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 780 224\" role=\"img\" aria-label=\"Схема вентиляции квартиры: механический приток и естественная вытяжка\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"10\" y=\"70\" width=\"150\" height=\"64\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"85\" y=\"96\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Приток</text><text x=\"85\" y=\"114\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">бризер, клапан в окне</text><rect x=\"220\" y=\"70\" width=\"170\" height=\"64\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"305\" y=\"96\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Жилые комнаты</text><text x=\"305\" y=\"114\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">воздух идёт в «чистые» зоны</text><rect x=\"450\" y=\"70\" width=\"150\" height=\"64\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"525\" y=\"96\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Кухня, санузел</text><text x=\"525\" y=\"114\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">«мокрые» зоны</text><rect x=\"650\" y=\"30\" width=\"110\" height=\"144\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"705\" y=\"92\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Общая</text><text x=\"705\" y=\"110\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">вытяжная</text><text x=\"705\" y=\"128\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">шахта дома</text><line x1=\"160\" y1=\"102\" x2=\"218\" y2=\"102\" stroke=\"#7d8089\" stroke-width=\"2.5\"/><polygon points=\"218,102 209.9,105.9 209.9,98.1\" fill=\"#7d8089\"/><line x1=\"390\" y1=\"102\" x2=\"448\" y2=\"102\" stroke=\"#7d8089\" stroke-width=\"2.5\"/><polygon points=\"448,102 439.9,105.9 439.9,98.1\" fill=\"#7d8089\"/><line x1=\"600\" y1=\"102\" x2=\"648\" y2=\"102\" stroke=\"#7d8089\" stroke-width=\"2.5\"/><polygon points=\"648,102 639.9,105.9 639.9,98.1\" fill=\"#7d8089\"/><text x=\"305\" y=\"160\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">переток под дверями</text><line x1=\"250\" y1=\"140\" x2=\"360\" y2=\"140\" stroke=\"#9a9ca3\" stroke-width=\"1.5\" stroke-dasharray=\"4 4\"/><text x=\"10\" y=\"190\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Приток обязателен: герметичные окна</text><text x=\"10\" y=\"206\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">перекрывают естественную вентиляцию</text><text x=\"520\" y=\"190\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"700\">Мощная вытяжка без притока опрокидывает шахту:</text><text x=\"520\" y=\"206\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"700\">запахи соседей, а у газовой колонки — угар</text></svg><figcaption>Квартира: приток механический (бризер, клапан), вытяжка идёт по естественным шахтам дома, воздух переходит из комнат на кухню и в санузел.</figcaption></figure><p class=\"e-lead2\"><b>Загородный дом.</b> Стандарт: ПВУ с рекуперацией. Приток в спальни и гостиную, вытяжка из кухни, санузлов и постирочной. Баланс держат близким к нулевому, лёгкое разрежение (вытяжка на 5–10 % больше) допустимо только там, где нет открытых топок и приборов с естественной тягой; при камине, печи, атмосферном котле или колонке нужен баланс не ниже нулевого и отдельный воздух на горение. Кухонный зонт только отдельным каналом с жироуловителем: жировой аэрозоль убивает рекуператор. Производительность по таблице расходов плюс 10–15 %, ночной режим со снижением расхода на 20–30 %.</p><figure class=\"e-fig\"><svg viewBox=\"0 0 780 340\" role=\"img\" aria-label=\"Схема вентиляции коттеджа с ПВУ\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"10\" y=\"20\" width=\"170\" height=\"46\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"95\" y=\"40\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Забор воздуха</text><text x=\"95\" y=\"56\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">≥ 2 м от земли, вдали от выбросов</text><rect x=\"10\" y=\"150\" width=\"170\" height=\"46\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"95\" y=\"170\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Выброс</text><text x=\"95\" y=\"186\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">разнесён с забором на 1,5–2 м</text><rect x=\"250\" y=\"60\" width=\"180\" height=\"110\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"340\" y=\"100\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Приточно-вытяжная</text><text x=\"340\" y=\"118\" font-size=\"14\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">установка (ПВУ)</text><text x=\"340\" y=\"142\" font-size=\"10\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">рекуператор, EC-вентиляторы,</text><text x=\"340\" y=\"156\" font-size=\"10\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">фильтры, байпас, преднагрев</text><line x1=\"180\" y1=\"43\" x2=\"250\" y2=\"80\" stroke=\"#7d8089\" stroke-width=\"2.5\"/><polygon points=\"250,80 241.0,79.7 244.7,72.8\" fill=\"#7d8089\"/><line x1=\"250\" y1=\"150\" x2=\"180\" y2=\"175\" stroke=\"#7d8089\" stroke-width=\"2.5\"/><polygon points=\"180,175 186.3,168.6 188.9,176.0\" fill=\"#7d8089\"/><polyline points=\"430,90 500,90\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"500,34 500,134\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><line x1=\"500\" y1=\"34\" x2=\"548\" y2=\"34\" stroke=\"#e3000f\" stroke-width=\"2.5\"/><polygon points=\"548,34 539.9,37.9 539.9,30.1\" fill=\"#e3000f\"/><rect x=\"550\" y=\"14\" width=\"210\" height=\"40\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"655\" y=\"39\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Гостиная: приток</text><line x1=\"500\" y1=\"84\" x2=\"548\" y2=\"84\" stroke=\"#e3000f\" stroke-width=\"2.5\"/><polygon points=\"548,84 539.9,87.9 539.9,80.1\" fill=\"#e3000f\"/><rect x=\"550\" y=\"64\" width=\"210\" height=\"40\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"655\" y=\"89\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Спальня: приток</text><line x1=\"500\" y1=\"134\" x2=\"548\" y2=\"134\" stroke=\"#e3000f\" stroke-width=\"2.5\"/><polygon points=\"548,134 539.9,137.9 539.9,130.1\" fill=\"#e3000f\"/><rect x=\"550\" y=\"114\" width=\"210\" height=\"40\" rx=\"0\" fill=\"#fff\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"655\" y=\"139\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Детская: приток</text><polyline points=\"430,150 470,150 470,200 548,200\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"470,200 470,250 548,250\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-linejoin=\"round\"/><rect x=\"550\" y=\"180\" width=\"210\" height=\"40\" rx=\"0\" fill=\"#fff\" stroke=\"#7d8089\" stroke-width=\"2\"/><text x=\"655\" y=\"205\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Кухня, санузел: вытяжка</text><rect x=\"550\" y=\"230\" width=\"210\" height=\"40\" rx=\"0\" fill=\"#fff\" stroke=\"#7d8089\" stroke-width=\"2\"/><text x=\"655\" y=\"255\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Постирочная, гардероб</text><polyline points=\"548,305 200,305\" fill=\"none\" stroke=\"#9a9ca3\" stroke-width=\"2.5\" stroke-dasharray=\"6 4\" stroke-linejoin=\"round\"/><rect x=\"550\" y=\"285\" width=\"210\" height=\"40\" rx=\"0\" fill=\"#fff\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><text x=\"655\" y=\"303\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Зонт над плитой</text><text x=\"655\" y=\"318\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">отдельный канал с жироуловителем</text><line x1=\"200\" y1=\"305\" x2=\"182\" y2=\"305\" stroke=\"#9a9ca3\" stroke-width=\"2.5\"/><polygon points=\"182,305 190.1,301.1 190.1,308.9\" fill=\"#9a9ca3\"/><rect x=\"10\" y=\"285\" width=\"170\" height=\"40\" rx=\"0\" fill=\"#fff\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><text x=\"95\" y=\"303\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Наружу</text><text x=\"95\" y=\"318\" font-size=\"10\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">минуя рекуператор</text></svg><figcaption>Типовая схема коттеджа с ПВУ: забор и выброс разнесены, приток идёт в жилые комнаты, вытяжка — из мокрых зон. Кухонный зонт — отдельным каналом с жироуловителем, не через рекуператор.</figcaption></figure><p class=\"e-lead2\"><b>Административное здание.</b> Приточные и приточно-вытяжные установки с рекуперацией (пластинчатой, роторной или гликолевым контуром), DCV по CO₂ в переговорных и open-space, VAV-модули по зонам, диспетчеризация и учёт энергии. Отдельные контуры: кухни и санузлы (вытяжка с компенсацией), входные группы с тепловыми завесами, серверные с собственным охлаждением. Дымоудаление и подпор воздуха при пожаре самостоятельная нормируемая система, совмещать её с бытовой вентиляцией нельзя.</p></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Материалы и оборудование: воздуховоды, фильтры, параметры ПВУ</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Воздуховод</th><th>Применение</th><th>Плюсы</th><th>Минусы</th></tr></thead><tbody><tr><td>Оцинкованная сталь, круглый или прямоугольный</td><td>Магистрали в домах, офисах, венткамерах</td><td>Жёсткость, герметичность класса B–C, любая геометрия</td><td>Требует изоляции и аккуратного монтажа</td></tr><tr><td>Гибкий изолированный (флекс)</td><td>Короткие присоединения, вставки</td><td>Дёшев, гнётся</td><td>Высокое сопротивление; провис даёт шум и потери; не для магистралей</td></tr><tr><td>Полужёсткие гладкие трубы (PE, PP)</td><td>Коллекторные (лучевые) разводки до диффузоров</td><td>Гладкость, тихие, трасса без стыков</td><td>Только круглое сечение, радиусы поворотов</td></tr><tr><td>Пластик (ПВХ)</td><td>Кухонные вытяжки, санузлы, реконструкция</td><td>Дёшев, не корродирует</td><td>Температурные ограничения, статика, горючесть: не для магистралей ПВУ</td></tr><tr><td>Двустенные звукоизолированные</td><td>Участки у спален, переговорных</td><td>Снижают шум на 10–15 дБ (ориентир производителей) без отдельных глушителей</td><td>Дороже, больше диаметр</td></tr><tr><td>Текстильные (тканевые)</td><td>Холлы, залы, склады: распределение потока</td><td>Равномерная раздача, нет конденсата, быстрый монтаж</td><td>Эстетика на любителя, классы чистоты ограничены</td></tr></tbody></table></div><p class=\"e-lead2\">Скорость воздуха главный акустический параметр: звуковая мощность растёт примерно как 5–6-я степень скорости. Поэтому в жилье держат 2–3 м/с в ветках и до 4–5 м/с в магистралях, в офисах допускают выше. Ориентир по диаметрам при комфортных 2–3 м/с:</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Канал круглый</th><th>Прямоугольный равный по сопротивлению</th><th>Расход, м³/ч</th><th>Типовое применение</th></tr></thead><tbody><tr><td>Ø100 мм</td><td>150 × 60 мм</td><td>60–80</td><td>отвод к диффузору, бризер</td></tr><tr><td>Ø125 мм</td><td>170 × 80 мм</td><td>90–130</td><td>ветка комнаты, санузел</td></tr><tr><td>Ø160 мм</td><td>230 × 100 мм</td><td>140–220</td><td>ветка гостиной, кухонная вытяжка</td></tr><tr><td>Ø200 мм</td><td>370 × 100 мм</td><td>230–340</td><td>магистраль квартиры, этажа</td></tr><tr><td>Ø250 мм</td><td>370 × 150 мм</td><td>350–530</td><td>магистраль коттеджа 150–250 м²</td></tr><tr><td>Ø315 мм</td><td>440 × 200 мм</td><td>560–840</td><td>офис, венткамера, стояк</td></tr></tbody></table></div><p class=\"e-note\">Расходы пересчитаны по площади сечения. Прямоугольное сечение того же размера по ширине и высоте пропускает меньше круга: например, 120×60 мм примерно на 40 % меньше, чем Ø125 мм. Эквивалентный диаметр прямоугольного канала считается по формуле dₑ = 1,3 · (a·b)^0,625 ÷ (a + b)^0,25. Свой случай посчитайте во вкладке «Воздуховоды».</p><div class=\"e-basis\"><b>Выбор ПВУ: восемь параметров в паспорте</b><p>1) Расход в рабочей точке с запасом 10–15 % к расчёту. 2) Эффективность рекуперации не ниже 80 % (сухая, в рабочей точке, а не «до 95 %» из рекламы). 3) SFP не выше 0,3–0,45 Вт/(м³/ч). 4) Шум: дБ(А) корпуса и в канал в рабочей точке, а не «на минимуме». 5) Тип рекуператора: противоток, ротор или энтальпийный; наличие байпаса. 6) Зимний пакет: преднагрев или автоматическая разморозка, защита по конденсату. 7) Фильтры: класс и стоимость комплекта, доступ без инструмента. 8) Автоматика: CO₂ и влажность, сценарии, интеграция с умным домом.</p></div></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Расчёт, баланс и схема: как рождается рабочая система</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Помещение</th><th>Нормативный воздухообмен</th><th>Примечание</th></tr></thead><tbody><tr><td>Жилая комната, спальня</td><td>30 м³/ч на человека или 3 м³/ч на 1 м² (берут большее)</td><td>Приток; ночью расход не снижают ниже санитарного</td></tr><tr><td>Гостиная, open-space</td><td>30–60 м³/ч на человека</td><td>DCV по CO₂ держит 800–1000 ppm</td></tr><tr><td>Кухня</td><td>60 м³/ч (электроплита), 90 м³/ч и более (газ)</td><td>Вытяжка; зонт отдельным каналом с жироуловителем</td></tr><tr><td>Ванная, санузел</td><td>25 м³/ч каждый (50 для совмещённого)</td><td>Вытяжка; boost по влажности</td></tr><tr><td>Постирочная, гардероб</td><td>по расчёту, обычно 25–50 м³/ч</td><td>Вытяжка, разрежение зоны</td></tr><tr><td>Переговорная</td><td>около 60 м³/ч на человека при полной загрузке (ориентир)</td><td>DCV: датчик CO₂ и расписание</td></tr></tbody></table></div><p class=\"e-lead2\">Баланс строят от «чистых» зон к «мокрым»: приток в спальни и гостиную, переток через проёмы и переточные решётки, вытяжка из кухни, санузлов, постирочной. Вытяжку при отсутствии открытых топок принимают на 5–10 % больше притока: лёгкое разрежение не выпускает запахи в жилые комнаты. Если в доме есть камин, печь, атмосферный котёл или колонка, баланс делают нулевым, а воздух на горение подают отдельным каналом (см. вкладку «Тяга и опрокидывание»). Суммарный расход установки это максимум из притока и вытяжки плюс резерв на режимы boost.</p><ul class=\"e-ul\"><li><b>Трассы короче и прямее.</b> Каждый лишний поворот на 90° даёт примерно +10–20 Па и шум; используйте плавные отводы и диагональные врезки.</li><li><b>Коллекторная (лучевая) разводка</b> полужёсткой трубой тише и балансируется расходомерами; тройниковая сталь для магистралей и больших расходов.</li><li><b>Глушители</b> с обеих сторон установки (приток и вытяжка), участок у спален звукоизолированным каналом.</li><li><b>Холодные зоны.</b> Все проходы через чердак, улицу и неотапливаемые помещения в изоляции с пароизоляцией, точка росы по расчёту воздуховодов.</li><li><b>Решётки и диффузоры</b> ставят не «где красиво», а по струе: без обдува постели и рабочих мест, скорость в жилой зоне не более 2 м/с.</li></ul><div class=\"e-basis\"><b>Четыре «нельзя» при компоновке систем</b><p>1) Не подключать кухонный зонт к тракту ПВУ и к общему вытяжному каналу с санузлами: жир и запахи. 2) Не совмещать дымоудаление и подпор воздуха при пожаре с бытовой вентиляцией. 3) Не объединять вытяжку из гаража, сауны и котельной с газоходом в общий рециркуляционный контур. 4) Не размещать выброс центрального пылесоса и канализационных стояков рядом с забором притока и под окнами.</p></div></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Нюансы монтажа: герметичность, конденсат, акустика</h3></div><h4 class=\"e-h4\">Воздуховоды и трассы</h4><ul class=\"e-ul\"><li>Герметичность нормируемый параметр: стыки стальных каналов на герметик, класс не ниже B для магистралей ПВУ; утечки 10–15 % съедают и расход, и рекуперацию.</li><li>Уклоны вытяжных трасс к установке или конденсатосборнику; в холодных зонах изоляция по расчёту точки росы с пароизоляцией снаружи.</li><li>Крепления с виброразвязкой (резиновые профили), шаг по нормам производителя; контакт с конструкциями даёт структурный шум.</li><li>Гибкие вставки у установки гасят вибрацию; флекс не тянуть «с провисом» и не сжимать гармошкой.</li><li>Кухонный зонт отдельным каналом с жироуловителем и ревизией; в ПВУ жиру входа нет.</li></ul><h4 class=\"e-h4\">Установка, автоматика, сдача</h4><ul class=\"e-ul\"><li><b>Место.</b> В техническом помещении, котельной или на чердаке, но не над спальней: структурный шум идёт по конструкциям. Подвес на виброопорах, доступ к фильтру и ротору без разборки потолка.</li><li><b>Конденсат.</b> Сифон (гидрозатвор) с высотой водяного столба по перепаду давлений установки, уклон дренажа; зимой дренаж холодного контура с подогревом или в тёплой зоне.</li><li><b>Забор воздуха.</b> Не менее 2 м от земли, в стороне от кухонных выбросов, гаража и канализационных стояков; выброс разнесён с забором на 1,5–2 м и не под окна.</li><li><b>Пусконаладка.</b> Расходы по анемометру или балансировочным диафрагмам на каждом диффузоре с протоколом; проверка режимов: ночной, boost, разморозка, авария питания.</li><li><b>Автоматика.</b> Датчики CO₂ в представительных комнатах, влажность в мокрых зонах; сценарии и напоминания о фильтрах.</li></ul><div class=\"e-basis\"><b>Зима проверяет вентиляцию первой</b><p>Без преднагрева или циклов разморозки пластинчатый рекуператор обмерзает уже при −10…−15 °С: расход падает, установка уходит в аварийный останов. Без сифона конденсат течёт в потолок. Без изоляции вытяжных трасс на чердаке появляются конденсат и ржавые потёки. Эти три узла проверяйте в проекте до монтажа, а не в январе.</p></div><div class=\"e-basis\"><b>Что остаётся на руках после сдачи</b><p>Исполнительная схема трасс с диаметрами и расходами; протокол балансировки (расход по каждому диффузору и решётке); паспорт установки с рабочей точкой и замером шума; схема автоматики и сценарии; регламент ТО: фильтры (класс, периодичность, стоимость), ремни или ротор, сифон; инструкция владельцу: режимы, зима, авария.</p></div></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Типичные ошибки: 12 способов испортить воздух и бюджет</h3></div><div class=\"e-errs\"><div class=\"e-err\"><h4>1. «Окна сами проветрят»</h4><p class=\"x\">✗ Герметичные окна и естественные шахты: притока нет, духота и плесень на откосах.</p><p class=\"v\">✓ Приточные клапаны, бризеры или ПВУ с расчётом по комнатам.</p></div><div class=\"e-err\"><h4>2. Установка «с запасом ×2»</h4><p class=\"x\">✗ Шум, сквозняки, пересушенный воздух, переплата за энергию и корпус.</p><p class=\"v\">✓ Таблица расходов по нормам плюс 10–15 %; режим boost вместо постоянного форсажа.</p></div><div class=\"e-err\"><h4>3. Зонт кухни в тракт ПВУ</h4><p class=\"x\">✗ Жир на рекуператоре и каналах, падение КПД, пожарный риск.</p><p class=\"v\">✓ Отдельный канал с жироуловителем; для варочных панелей рециркуляционный зонт.</p></div><div class=\"e-err\"><h4>4. Флекс «как легло»</h4><p class=\"x\">✗ Пережимы и провис: сопротивление в 2–3 раза выше, свист, недорасход в дальних комнатах.</p><p class=\"v\">✓ Жёсткие магистрали, плавные отводы; гибким только короткие присоединения.</p></div><div class=\"e-err\"><h4>5. Без изоляции в холодных зонах</h4><p class=\"x\">✗ Конденсат на воздуховодах, ржавые потёки, мокрый потолок.</p><p class=\"v\">✓ Изоляция по расчёту точки росы и пароизоляция на всех холодных участках.</p></div><div class=\"e-err\"><h4>6. Нет сифона и уклона дренажа</h4><p class=\"x\">✗ Конденсат в установке и на полу; зимой лёд в дренаже.</p><p class=\"v\">✓ Гидрозатвор по перепаду давлений, уклон, подогрев холодного участка.</p></div><div class=\"e-err\"><h4>7. Установка над спальней</h4><p class=\"x\">✗ 35–45 дБ ночью: владелец выключает систему через месяц.</p><p class=\"v\">✓ Техническое помещение, виброопоры, глушители, не более 30 дБ(А) у решёток ночью.</p></div><div class=\"e-err\"><h4>8. Фильтр зашит в потолок</h4><p class=\"x\">✗ Заменить невозможно: систему бросают, теплообменник забивается.</p><p class=\"v\">✓ Люки у установки и фильтросекции; класс и стоимость фильтров до покупки.</p></div><div class=\"e-err\"><h4>9. Без автоматики CO₂</h4><p class=\"x\">✗ Постоянный расход: зимой пересушиваем и греем улицу, летом духота.</p><p class=\"v\">✓ DCV по CO₂ и влажности; сценарии «никого нет», ночной, boost.</p></div><div class=\"e-err\"><h4>10. Зимой без разморозки</h4><p class=\"x\">✗ Обмерзание рекуператора при −15 °С, аварийные остановы в мороз.</p><p class=\"v\">✓ Преднагрев или автоматическая разморозка, защита по конденсату: проверять в спецификации.</p></div><div class=\"e-err\"><h4>11. Мощная вытяжка без притока</h4><p class=\"x\">✗ Опрокидывание шахт: запахи соседей, угар при газовой колонке, дым из камина.</p><p class=\"v\">✓ Компенсировать приток; после монтажа проверять тягу во всех режимах (см. вкладку «Тяга и опрокидывание»).</p></div><div class=\"e-err\"><h4>12. Дешёвая ПВУ с низкой рекуперацией и высоким SFP</h4><p class=\"x\">✗ Тепло и электричество уходят годами, экономия съедается за 2 сезона.</p><p class=\"v\">✓ Ориентиры: рекуперация в рабочей точке не ниже 75–80 %, SFP не выше 0,3–0,45, EC-вентиляторы.</p></div></div><div class=\"e-basis\"><b>Цена ошибки</b><p>Вентиляция исправляется дороже, чем монтируется: вскрытие потолков, замена трасс, перекладка звукоизоляции, неделя простоя офиса. Дешевле всего ошибки ловятся на бумаге: таблица расходов, акустический расчёт, узлы конденсата до начала монтажа.</p></div></div><div class=\"e-art\" id=\"art7\"><div class=\"e-sech\"><small>7</small><h3>На что смотреть в первую очередь: чек-лист заказчика</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 306\" role=\"img\" aria-label=\"Пирамида приоритетов при приёмке вентиляции\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"10\" y=\"10\" width=\"250\" height=\"40\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"135.0\" y=\"36\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">1</text><text x=\"280\" y=\"28\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Баланс притока и вытяжки</text><text x=\"280\" y=\"46\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">расходы по комнатам по нормам, основа всего</text><rect x=\"10\" y=\"58\" width=\"220\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"120.0\" y=\"84\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">2</text><text x=\"280\" y=\"76\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Схема: зоны, трассы, акустика</text><text x=\"280\" y=\"94\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">узел не над спальней, трассы короче, повороты плавные</text><rect x=\"10\" y=\"106\" width=\"190\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"105.0\" y=\"132\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">3</text><text x=\"280\" y=\"124\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Оборудование</text><text x=\"280\" y=\"142\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">рекуперация ≥ 80 %, низкий SFP, шум в рабочей точке</text><rect x=\"10\" y=\"154\" width=\"160\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"90.0\" y=\"180\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">4</text><text x=\"280\" y=\"172\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Воздуховоды</text><text x=\"280\" y=\"190\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">жёсткие, герметичные, в изоляции холодных участков</text><rect x=\"10\" y=\"202\" width=\"130\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"75.0\" y=\"228\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">5</text><text x=\"280\" y=\"220\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Балансировка и автоматика</text><text x=\"280\" y=\"238\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">расход по анемометру, управление по CO₂ и влажности</text><rect x=\"10\" y=\"250\" width=\"100\" height=\"40\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"60.0\" y=\"276\" font-size=\"18\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">6</text><text x=\"280\" y=\"268\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Сервис и фильтры</text><text x=\"280\" y=\"286\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">люки доступа, регламент, напоминания о замене</text></svg><figcaption>Нижние уровни определяют стоимость верхних: баланс расходов определяет всё остальное, сервис замыкает цикл.</figcaption></figure><h4 class=\"e-h4\">Вопросы подрядчику до подписания договора</h4><ul class=\"e-ul\"><li>Где таблица баланса притока и вытяжки по комнатам и суммарный расход с запасом?</li><li>Какой шум у установки в рабочей точке и где она стоит? Сколько дБ(А) будет у решёток спален ночью?</li><li>Воздуховоды: тип, класс герметичности, изоляция холодных участков, показаны ли они на схеме?</li><li>Как балансируете: расходы по каждому диффузору анемометром, протокол в составе сдачи?</li><li>Фильтры: класс, где люки, стоимость комплекта и периодичность замены?</li><li>Зимний сценарий: разморозка, конденсат, отключение электричества, что делает система?</li><li>Есть ли в доме камин, печь или атмосферный котёл, и как учтено разрежение от вытяжки?</li></ul><div class=\"e-basis\"><b>Красные флаги подрядчика</b><p>«Поставим установку на 350 м³/ч, хватит всем»; расход «по площади»; флекс магистралями; установка над спальней без виброопор; отсутствие сифона в спецификации; нет протокола балансировки в составе сдачи; не спросили про камин и газовые приборы. Любого пункта достаточно, чтобы остановить договор.</p></div></div><div class=\"e-art\" id=\"art8\"><div class=\"e-sech\"><small>8</small><h3>Пять тезисов, с которыми можно принимать решение</h3></div><ul class=\"e-ul\"><li>Вентиляция начинается с таблицы расходов по комнатам: приток в чистые зоны, вытяжка из мокрых, переток под дверями.</li><li>В герметичном доме естественная схема не работает: ПВУ с рекуперацией 75–90 % стандарт; в доме 150 м² она возвращает порядка 7–9 МВт·ч тепла за сезон при круглосуточной работе на 300 м³/ч.</li><li>Энергия живёт в деталях: SFP и EC-вентиляторы, герметичные трассы, DCV по CO₂ дают заметную экономию на вентиляционной энергии.</li><li>Акустика и конденсат проектируются заранее: место узла, виброопоры, глушители, скорости 2–3 м/с в ветках, изоляция и сифон.</li><li>Система без протокола балансировки и регламента фильтров полуфабрикат: требуйте документы и люки доступа при приёмке.</li></ul><p class=\"e-note\">Источники и оговорки: Regulation (EU) No 1253/2014 (Ecodesign для вентиляционных установок); Allen J.G. и др., Environ. Health Perspect., 2016 (COGfx); EN 308 (методика измерения рекуперации); ISO 16890; нормы воздухообмена по СН 4.02.03-2019 (значения справочные, сверяйтесь с проектом). Расчёты тепла на диаграммах оценочные для типового дома.</p></div></section><section class=\"e-panel\" id=\"vair\" data-panel=\"vair\"><div class=\"e-sech\"><small>02</small><h2>Воздухообмен</h2></div><p class=\"e-lead2\">Сколько воздуха нужно подать или удалить. Считаются сразу несколько способов, в расчёт берётся наибольший.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"va-type\">Помещение</label><div class=\"e-in\"><select id=\"va-type\"><option value=\"room\" selected>Жилая комната (приток)</option><option value=\"kitchen_e\">Кухня с электроплитой (вытяжка)</option><option value=\"kitchen_g\">Кухня с газовой плитой (вытяжка)</option><option value=\"bath\">Ванная, душевая</option><option value=\"wc\">Туалет</option><option value=\"sanuzel\">Совмещённый санузел</option><option value=\"office\">Офис, кабинет</option><option value=\"hall\">Зал, где люди не более 3 ч</option><option value=\"shop\">Торговый зал, магазин</option><option value=\"own\">Своя кратность</option></select></div></div><div class=\"e-f\"><label for=\"va-s\">Площадь</label><div class=\"e-in\"><input id=\"va-s\" inputmode=\"decimal\" autocomplete=\"off\" value=\"18\"><span class=\"u\">м²</span></div></div><div class=\"e-f\"><label for=\"va-h\">Высота</label><div class=\"e-in\"><input id=\"va-h\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,7\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"va-p\">Людей в помещении</label><div class=\"e-in\"><input id=\"va-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2\"></div></div><div class=\"e-f\"><label for=\"va-m\">Кратность, если задана</label><div class=\"e-in\"><input id=\"va-m\" inputmode=\"decimal\" autocomplete=\"off\" value=\"\"><span class=\"u\">раз/ч</span></div></div></div><div class=\"e-formula\">L = max (n · l₁ ; S · 3 ; k · V), м³/ч<br>l₁ — норма на человека; k — кратность; V — объём помещения</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Определяет</span><b id=\"va-by\">—</b></div><div class=\"kv\"><span>По числу людей</span><b id=\"va-ppl\">—</b></div><div class=\"kv\"><span>По площади или норме</span><b id=\"va-area\">—</b></div><div class=\"kv\"><span>Кратность</span><b id=\"va-mult\">—</b></div><div class=\"kv\"><span>Расход воздуха</span><b id=\"va-q\">—</b></div><div class=\"verdict\" id=\"va-verdict\" role=\"status\"></div><button class=\"e-btn wide\" id=\"va-to-d\" type=\"button\">Передать расход в воздуховоды, решётки и нагрев</button></div></div></div></section><section class=\"e-panel\" id=\"duct\" data-panel=\"duct\"><div class=\"e-sech\"><small>03</small><h2>Воздуховоды</h2></div><p class=\"e-lead2\">Диаметр круглого воздуховода по скорости воздуха, потери давления в сети и равный по сопротивлению прямоугольный.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"vd-q\">Расход воздуха</label><div class=\"e-in\"><input id=\"vd-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"300\"><span class=\"u\">м³/ч</span></div></div><div class=\"e-f\"><label for=\"vd-net\">Сеть</label><div class=\"e-in\"><select id=\"vd-net\"><option value=\"home\" selected>Жилое здание</option><option value=\"office\">Офис, магазин</option></select></div></div><div class=\"e-f\"><label for=\"vd-vmax\">Допустимая скорость</label><div class=\"e-in\"><input id=\"vd-vmax\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4\"><span class=\"u\">м/с</span></div></div><div class=\"e-f\"><label for=\"vd-l\">Длина трассы</label><div class=\"e-in\"><input id=\"vd-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"vd-z\">Сумма коэфф. местных сопротивлений</label><div class=\"e-in\"><input id=\"vd-z\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4\"></div></div><div class=\"e-f\"><label for=\"vd-b\">Высота прямоугольного канала</label><div class=\"e-in\"><input id=\"vd-b\" inputmode=\"decimal\" autocomplete=\"off\" value=\"100\"><span class=\"u\">мм</span></div></div></div><div class=\"e-formula\">d = √(4 · L ÷ (3600 · π · v))<br>ΔP = λ · (l ÷ d) · ρv² ÷ 2 + Σζ · ρv² ÷ 2; ρ = 1,2 кг/м³</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Диаметр</span><b id=\"vd-d\">—</b></div><div class=\"kv\"><span>Скорость</span><b id=\"vd-v\">—</b></div><div class=\"kv\"><span>Потери на метр</span><b id=\"vd-r\">—</b></div><div class=\"kv\"><span>Потери сети</span><b id=\"vd-dp\">—</b></div><div class=\"kv\"><span>Равный прямоугольный</span><b id=\"vd-rect\">—</b></div><div class=\"verdict\" id=\"vd-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"grille\" data-panel=\"grille\"><div class=\"e-sech\"><small>04</small><h2>Решётки и диффузоры</h2></div><p class=\"e-lead2\">Сколько решёток нужно, чтобы воздух не свистел. Площадь считается по скорости в свободном сечении решётки.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"vg-q\">Расход воздуха</label><div class=\"e-in\"><input id=\"vg-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"300\"><span class=\"u\">м³/ч</span></div></div><div class=\"e-f\"><label for=\"vg-v\">Скорость в решётке</label><div class=\"e-in\"><input id=\"vg-v\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,5\"><span class=\"u\">м/с</span></div></div><div class=\"e-f\"><label for=\"vg-k\">Доля свободного сечения решётки</label><div class=\"e-in\"><input id=\"vg-k\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,7\"></div></div></div><div class=\"e-formula\">F = L ÷ (3600 · v); Fгабарит = F ÷ k</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Свободное сечение</span><b id=\"vg-area\">—</b></div><div class=\"kv\"><span>Габарит решёток</span><b id=\"vg-n\">—</b></div><div class=\"verdict\" id=\"vg-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"vheat\" data-panel=\"vheat\"><div class=\"e-sech\"><small>05</small><h2>Нагрев приточного воздуха</h2></div><p class=\"e-lead2\">Мощность калорифера для подогрева наружного воздуха с учётом рекуператора. Ток подскажет, какая нужна сеть.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"vh-q\">Расход воздуха</label><div class=\"e-in\"><input id=\"vh-q\" inputmode=\"decimal\" autocomplete=\"off\" value=\"300\"><span class=\"u\">м³/ч</span></div></div><div class=\"e-f\"><label for=\"vh-te\">Наружная температура</label><div class=\"e-in\"><input id=\"vh-te\" inputmode=\"decimal\" autocomplete=\"off\" value=\"−24\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"vh-ts\">Нужная температура притока</label><div class=\"e-in\"><input id=\"vh-ts\" inputmode=\"decimal\" autocomplete=\"off\" value=\"18\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"vh-ti\">Температура вытяжного воздуха</label><div class=\"e-in\"><input id=\"vh-ti\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"vh-eta\">КПД рекуператора</label><div class=\"e-in\"><input id=\"vh-eta\" inputmode=\"decimal\" autocomplete=\"off\" value=\"60\"><span class=\"u\">%</span></div></div></div><div class=\"e-formula\">P = 0,335 · L · (tприт − tпосле рекуператора), Вт<br>tпосле = tн + η · (tвыт − tн)</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>После рекуператора</span><b id=\"vh-t\">—</b></div><div class=\"kv\"><span>Мощность калорифера</span><b id=\"vh-p\">—</b></div><div class=\"kv\"><span>Ток, 1 фаза 230 В</span><b id=\"vh-a1\">—</b></div><div class=\"kv\"><span>Ток, 3 фазы 400 В</span><b id=\"vh-a3\">—</b></div><div class=\"verdict\" id=\"vh-verdict\" role=\"status\"></div><a class=\"e-btn wide\" href=\"{{ p }}/spravochniki/elektrika#apparaty\">Подобрать автомат и УЗО</a></div></div></div></section><section class=\"e-panel\" id=\"draft\" data-panel=\"draft\"><div class=\"e-sech\"><small>06</small><h2>Тяга и опрокидывание</h2></div><p class=\"e-lead2\">Хватит ли естественной тяги шахты и что с ней делает вытяжка без притока. Расчёт показывает, при каких условиях воздух из шахты пойдёт обратно в помещение.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f\"><label for=\"vt-h\">Высота шахты от решётки до устья</label><div class=\"e-in\"><input id=\"vt-h\" inputmode=\"decimal\" autocomplete=\"off\" value=\"9\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"vt-te\">Температура на улице</label><div class=\"e-in\"><input id=\"vt-te\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"vt-ti\">Температура в помещении</label><div class=\"e-in\"><input id=\"vt-ti\" inputmode=\"decimal\" autocomplete=\"off\" value=\"20\"><span class=\"u\">°С</span></div></div><div class=\"e-f\"><label for=\"vt-v\">Объём помещений, которые вентилирует шахта</label><div class=\"e-in\"><input id=\"vt-v\" inputmode=\"decimal\" autocomplete=\"off\" value=\"100\"><span class=\"u\">м³</span></div></div><div class=\"e-f wide\"><label for=\"vt-n\">Герметичность оболочки (n50)</label><div class=\"e-in\"><select id=\"vt-n\"><option value=\"6\" selected>Старый дом, щели, n50 = 6</option><option value=\"3\">Обычный, окна ПВХ, n50 = 3</option><option value=\"1.5\">Новый энергоэффективный, n50 = 1,5</option><option value=\"0.6\">Пассивный дом, n50 = 0,6</option></select></div></div><div class=\"e-f\"><label for=\"vt-qo\">Расход вытяжки (зонт, вентиляторы)</label><div class=\"e-in\"><input id=\"vt-qo\" inputmode=\"decimal\" autocomplete=\"off\" value=\"200\"><span class=\"u\">м³/ч</span></div></div><div class=\"e-f\"><label for=\"vt-qi\">Компенсирующий приток</label><div class=\"e-in\"><input id=\"vt-qi\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0\"><span class=\"u\">м³/ч</span></div></div></div><div class=\"e-formula\">Δpтяги = 3460 · h · (1/Tн − 1/Tв), Па<br>Δpразр. = 50 · (Qдисбаланс ÷ (n50 · V))^(1/0,65); остаток = Δpтяги − Δpразр.</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Естественная тяга шахты</span><b id=\"vt-st\">—</b></div><div class=\"kv\"><span>Разрежение в помещении</span><b id=\"vt-dp\">—</b></div><div class=\"kv\"><span>Остаётся для вытяжки через шахту</span><b id=\"vt-net\">—</b></div><div class=\"kv\"><span>Камин, печь, атмосферный котёл</span><b id=\"vt-ch\">—</b></div><div class=\"verdict\" id=\"vt-verdict\" role=\"status\"></div></div></div></div><div class=\"e-art\" id=\"artA\"><div class=\"e-sech\"><small>A</small><h3>Что такое опрокидывание тяги</h3></div><p class=\"e-lead2\">В нормально работающей естественной вентиляции воздух из помещения поднимается по шахте и уходит наружу. Опрокидывание (обратная тяга) это когда поток в шахте или дымоходе идёт в обратную сторону: в квартиру или дом возвращаются запахи, влага, дым и продукты горения. Шахтой движет разность плотностей тёплого воздуха внутри и холодного снаружи, и это очень слабая сила.</p><ul class=\"e-ul\"><li>Для шахты высотой 10 м при +20 °С в помещении естественная тяга составляет около 19 Па при −20 °С на улице, около 9 Па при 0 °С, около 4 Па при +10 °С и нулевая при +20 °С; при +25 °С она уже обратная.</li><li>Давление работающей вытяжки в тесном доме без притока легко доходит до 10–20 Па, а порыв ветра на фасаде даёт ещё несколько паскалей. Любая из этих сил в разы больше тяги шахты в межсезонье.</li><li>Именно поэтому шахта работает зимой и отказывает весной, осенью и в жару, особенно на верхних этажах, где она короткая.</li></ul><figure class=\"e-fig\"><svg viewBox=\"0 0 800 268\" role=\"img\" aria-label=\"Схема опрокидывания тяги вентиляционной шахты\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"10\" y=\"22\" font-size=\"15\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\">Тяга работает</text><rect x=\"300\" y=\"44\" width=\"44\" height=\"190\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"20\" y=\"110\" width=\"240\" height=\"124\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"322\" y=\"36\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">шахта</text><text x=\"140\" y=\"226\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">комната</text><rect x=\"260\" y=\"130\" width=\"40\" height=\"24\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"280\" y=\"146\" font-size=\"8\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">решётка</text><line x1=\"322\" y1=\"200\" x2=\"322\" y2=\"56\" stroke=\"#1d1f23\" stroke-width=\"3\"/><polygon points=\"322,56 325.9,64.1 318.1,64.1\" fill=\"#1d1f23\"/><line x1=\"255\" y1=\"142\" x2=\"262\" y2=\"142\" stroke=\"#1d1f23\" stroke-width=\"2\"/><polygon points=\"262,142 253.9,145.9 253.9,138.1\" fill=\"#1d1f23\"/><line x1=\"2\" y1=\"190\" x2=\"20\" y2=\"190\" stroke=\"#7d8089\" stroke-width=\"3\"/><polygon points=\"20,190 11.9,193.9 11.9,186.1\" fill=\"#7d8089\"/><polyline points=\"22,190 150,190 150,142 250,142\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-linejoin=\"round\"/><text x=\"120\" y=\"172\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">приток через клапан</text><text x=\"322\" y=\"252\" font-size=\"11\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">воздух уходит наружу</text><text x=\"410\" y=\"22\" font-size=\"15\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"700\">Опрокидывание тяги</text><rect x=\"700\" y=\"44\" width=\"44\" height=\"190\" rx=\"0\" fill=\"#c6c8cd\" stroke=\"none\" stroke-width=\"1.5\"/><rect x=\"420\" y=\"110\" width=\"240\" height=\"124\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"722\" y=\"36\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">шахта</text><text x=\"540\" y=\"226\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">комната</text><rect x=\"660\" y=\"130\" width=\"40\" height=\"24\" rx=\"0\" fill=\"#fff\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><text x=\"680\" y=\"146\" font-size=\"8\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"400\">решётка</text><line x1=\"722\" y1=\"56\" x2=\"722\" y2=\"200\" stroke=\"#e3000f\" stroke-width=\"3\"/><polygon points=\"722,200 718.1,191.9 725.9,191.9\" fill=\"#e3000f\"/><polyline points=\"722,200 722,220\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><line x1=\"658\" y1=\"142\" x2=\"626\" y2=\"142\" stroke=\"#e3000f\" stroke-width=\"3\"/><polygon points=\"626,142 634.1,138.1 634.1,145.9\" fill=\"#e3000f\"/><rect x=\"460\" y=\"118\" width=\"56\" height=\"28\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"488\" y=\"136\" font-size=\"10\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"400\">вытяжка</text><line x1=\"460\" y1=\"132\" x2=\"404\" y2=\"132\" stroke=\"#e3000f\" stroke-width=\"3\"/><polygon points=\"404,132 412.1,128.1 412.1,135.9\" fill=\"#e3000f\"/><text x=\"460\" y=\"172\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"700\">окна закрыты, притока нет</text><line x1=\"404\" y1=\"196\" x2=\"422\" y2=\"214\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"422\" y1=\"196\" x2=\"404\" y2=\"214\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"722\" y=\"252\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"middle\" font-weight=\"700\">воздух идёт вниз в квартиру</text></svg><figcaption>Слева нормальная работа: воздух приходит через клапан и уходит в шахту. Справа вытяжной вентилятор выкачивает воздух, а притока нет: разрежение превышает естественную тягу, и воздух из шахты, а с ним запахи и продукты горения, идёт в комнату.</figcaption></figure><figure class=\"e-fig\"><svg viewBox=\"0 0 700 386\" role=\"img\" aria-label=\"Естественная тяга вентиляционной шахты в зависимости от температуры на улице\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"64\" y=\"251.33333333333334\" width=\"600\" height=\"66.66666666666667\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"none\" stroke-width=\"1.5\"/><line x1=\"118.54545454545453\" y1=\"18\" x2=\"118.54545454545453\" y2=\"318\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"118.54545454545453\" y=\"336\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">−20</text><line x1=\"227.63636363636363\" y1=\"18\" x2=\"227.63636363636363\" y2=\"318\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"227.63636363636363\" y=\"336\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">−10</text><line x1=\"336.7272727272727\" y1=\"18\" x2=\"336.7272727272727\" y2=\"318\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"336.7272727272727\" y=\"336\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><line x1=\"445.8181818181818\" y1=\"18\" x2=\"445.8181818181818\" y2=\"318\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"445.8181818181818\" y=\"336\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">10</text><line x1=\"554.9090909090909\" y1=\"18\" x2=\"554.9090909090909\" y2=\"318\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"554.9090909090909\" y=\"336\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><line x1=\"664.0\" y1=\"18\" x2=\"664.0\" y2=\"318\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"664.0\" y=\"336\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">30</text><line x1=\"64\" y1=\"318.0\" x2=\"664\" y2=\"318.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"322.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">−10</text><line x1=\"64\" y1=\"284.6666666666667\" x2=\"664\" y2=\"284.6666666666667\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"288.6666666666667\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">−5</text><line x1=\"64\" y1=\"251.33333333333334\" x2=\"664\" y2=\"251.33333333333334\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"255.33333333333334\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0</text><line x1=\"64\" y1=\"218.0\" x2=\"664\" y2=\"218.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"222.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">5</text><line x1=\"64\" y1=\"184.66666666666669\" x2=\"664\" y2=\"184.66666666666669\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"188.66666666666669\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">10</text><line x1=\"64\" y1=\"151.33333333333334\" x2=\"664\" y2=\"151.33333333333334\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"155.33333333333334\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">15</text><line x1=\"64\" y1=\"118.0\" x2=\"664\" y2=\"118.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"122.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">20</text><line x1=\"64\" y1=\"84.66666666666667\" x2=\"664\" y2=\"84.66666666666667\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"88.66666666666667\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">25</text><line x1=\"64\" y1=\"51.333333333333336\" x2=\"664\" y2=\"51.333333333333336\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"55.333333333333336\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">30</text><line x1=\"64\" y1=\"18.0\" x2=\"664\" y2=\"18.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"56\" y=\"22.0\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">35</text><line x1=\"64\" y1=\"251.33333333333334\" x2=\"664\" y2=\"251.33333333333334\" stroke=\"#4a4d55\" stroke-width=\"1.5\"/><text x=\"72\" y=\"269.33333333333337\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"700\">обратная тяга: воздух идёт в комнату</text><line x1=\"64\" y1=\"224.66666666666669\" x2=\"664\" y2=\"224.66666666666669\" stroke=\"#e3000f\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/><text x=\"656\" y=\"218.66666666666669\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"end\" font-weight=\"400\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">4 Па: предел разрежения для открытой топки</text><polyline points=\"64.0,208.5 118.5,214.0 173.1,219.3 227.6,224.4 282.2,229.3 336.7,234.0 391.3,238.6 445.8,243.0 500.4,247.2 554.9,251.3 609.5,255.3 664.0,259.1\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/><polyline points=\"64.0,122.9 118.5,139.4 173.1,155.3 227.6,170.6 282.2,185.3 336.7,199.5 391.3,213.1 445.8,226.3 500.4,239.0 554.9,251.3 609.5,263.2 664.0,274.7\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"64.0,-5.5 118.5,27.5 173.1,59.3 227.6,89.9 282.2,119.3 336.7,147.6 391.3,175.0 445.8,201.3 500.4,226.8 554.9,251.3 609.5,275.1 664.0,298.1\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><text x=\"364.0\" y=\"358\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">температура наружного воздуха, °С (в помещении +20 °С)</text><text x=\"14\" y=\"22\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Па</text><line x1=\"464\" y1=\"32\" x2=\"494\" y2=\"32\" stroke=\"#7d8089\" stroke-width=\"3\"/><text x=\"502\" y=\"36\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">частный дом, шахта 3 м</text><line x1=\"464\" y1=\"52\" x2=\"494\" y2=\"52\" stroke=\"#1d1f23\" stroke-width=\"3\"/><text x=\"502\" y=\"56\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">3 этажа, шахта 9 м</text><line x1=\"464\" y1=\"72\" x2=\"494\" y2=\"72\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"502\" y=\"76\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">6 этажей, шахта 18 м</text></svg><figcaption>Давление естественной тяги по формуле Δp = 3460 · h · (1/Tн − 1/Tв). Зимой тяга максимальна, в межсезонье мала, в жару нулевая или обратная: именно тогда шахты опрокидываются первыми. Ветер добавляет к этому давлению несколько паскалей в любую сторону.</figcaption></figure><p class=\"e-lead2\">Формула для самостоятельной оценки: Δp = 3460 · h · (1/Tн − 1/Tв), Па, где h высота шахты в метрах, T в кельвинах. Посчитайте свой случай в калькуляторе выше, там же учитывается разрежение от вытяжки.</p><div class=\"e-basis\"><b>Главная мысль</b><p>Шахта и дымоход ничего не «тянут». Они только пропускают воздух, который есть куда впустить. Если воздуху в дом попасть некуда, он пойдёт туда, где проще всего: обратно по самой шахте.</p></div></div><div class=\"e-art\" id=\"artB\"><div class=\"e-sech\"><small>B</small><h3>Почему тяга опрокидывается: причины</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Причина</th><th>Как проявляется</th><th>Где чаще</th></tr></thead><tbody><tr><td>Нет притока: окна и двери герметичны, клапаны закрыты</td><td>Воздуху некуда приходить, вытяжка работает хуже, при вентиляторе воздух идёт вниз по шахте</td><td>Квартиры с ПВХ-окнами, новые дома</td></tr><tr><td>Мощная механическая вытяжка: кухонный зонт, бытовые вентиляторы, ПВУ без баланса</td><td>Разрежение 10–20 Па и выше, перебивает естественную тягу</td><td>Кухня, санузел, дома с ПВУ</td></tr><tr><td>Тепло на улице</td><td>Нет перепада температур: тяга нулевая или обратная</td><td>Лето, межсезонье, верхние этажи</td></tr><tr><td>Ветер: подпор на устье шахты, ветровая тень от соседнего здания, низкое устье</td><td>Порывами воздух вдавливает в шахту; устье ниже конька или рядом с парапетом</td><td>Частные дома, плоские кровли, верхний этаж</td></tr><tr><td>Общие шахты многоквартирного дома без обратных клапанов</td><td>Вентилятор одного жильца гонит воздух к соседям: запах кухни, сигаретный дым</td><td>Многоэтажки, соседи по стояку</td></tr><tr><td>Засор, перекрытие, самодельные «улучшения»</td><td>Мусор, строительные остатки, декоративные решётки, натяжной потолок, гипсокартонная зашивка, удлинители</td><td>Новостройки, после ремонта</td></tr><tr><td>Малое сечение, длинные горизонтальные участки, лишние повороты</td><td>Сопротивление больше тяги, воздух не идёт</td><td>Самостоятельные переделки</td></tr><tr><td>Конкуренция тяги: камин, печь, атмосферный котёл или колонка и вытяжка в одном объёме</td><td>Вытяжка выкачивает воздух из дымохода, дым и угарный газ идут в комнату</td><td>Загородные дома, газифицированные квартиры</td></tr><tr><td>Холодный канал и дымоход</td><td>Столб холодного воздуха мешает растопке; тепла в шахте нет</td><td>Растопка камина, утеплённый чердак</td></tr></tbody></table></div><p class=\"e-note\">Часто причин несколько сразу: например, зимним вечером работают вытяжка на кухне и вентилятор в ванной, окна закрыты, а на верхнем этаже шахта короткая.</p></div><div class=\"e-art\" id=\"artC\"><div class=\"e-sech\"><small>C</small><h3>Чем это опасно</h3></div><ul class=\"e-ul\"><li><b>Угарный газ (CO).</b> Главная опасность для газифицированных квартир и домов с камином, печью или газовым котлом с открытой камерой. Газ без цвета и запаха, симптомы начинаются с головной боли и сонливости, при высокой концентрации развивается тяжёлое отравление. При опрокидывании тяги дымоход перестаёт выводить продукты горения.</li><li><b>Запахи и дым.</b> Запах кухни и сигаретный дым от соседей, жир и сажа на отделке, дым из камина.</li><li><b>Влага и плесень.</b> Воздух остаётся в доме, влажность растёт выше 60 %, конденсат на окнах и откосах, грибок.</li><li><b>Духота и CO₂.</b> Утром в спальне больше 1400 ppm, плохой сон и самочувствие.</li><li><b>Нарушение работы газовых приборов.</b> Срабатывает автоматика безопасности, колонка гаснет, котёл уходит в аварию.</li></ul><div class=\"e-basis\"><b>Если сработал датчик CO или есть признаки отравления</b><p>Откройте окна, выйдите на воздух, отключите прибор и вызовите аварийную газовую службу и скорую помощь. Не включайте мощную вытяжку «чтобы проветрить» при работающей колонке без открытого окна.</p></div></div><div class=\"e-art\" id=\"artD\"><div class=\"e-sech\"><small>D</small><h3>Как проверить тягу</h3></div><ul class=\"e-ul\"><li><b>Тест бумагой.</b> Закройте окна и двери в комнате, поднесите к решётке вентканала узкую полоску тонкой бумаги или салфетки. Лист должен прижиматься к решётке. Если он отклоняется в комнату, тяга обратная.</li><li><b>Тест в разных режимах.</b> Повторите проверку при включённой кухонной вытяжке, при включённом вентиляторе в ванной, при работающей стиральной сушилке. Это самые частые режимы, в которых тяга исчезает.</li><li><b>Тест на приток.</b> Откройте окно или форточку. Если тяга появилась после этого, причина в нехватке притока, а не в самой шахте.</li><li><b>Тест в жаркий и ветреный день.</b> Одной проверки зимой мало: на верхнем этаже тяга может пропасть при +20 °С на улице.</li><li><b>Замер расхода.</b> Анемометр или балометр на решётке: кухня 60–90 м³/ч, санузел около 25 м³/ч. Заметно меньше значит засор или нехватку притока.</li><li><b>Для газовых приборов и дымоходов.</b> Проверку тяги в дымоходе при включённой вытяжке делает только газовая служба или специализированная организация. Самим «править» тягу газового прибора нельзя.</li><li><b>Для частного дома.</b> Дифференциальным манометром измеряют разность давлений между домом и улицей при включённой вытяжке. Для помещений с открытой топкой в зарубежной практике ориентиром служит разрежение не более 4 Па; допустимое значение зависит от типа топки, его уточняют по проекту и паспорту.</li></ul><h4 class=\"e-h4\">Заодно проверьте влажность</h4><p class=\"e-lead2\">Конденсат на окнах и откосах это почти всегда признак недостатка вентиляции. Окно мокнет, когда температура его поверхности ниже точки росы воздуха. Точка росы при +20 °С в помещении:</p><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Относительная влажность</th><th>Точка росы</th></tr></thead><tbody><tr><td>40 %</td><td>6,0 °С</td></tr><tr><td>50 %</td><td>9,3 °С</td></tr><tr><td>60 %</td><td>12,0 °С</td></tr><tr><td>70 %</td><td>14,4 °С</td></tr></tbody></table></div><p class=\"e-note\">Внутренняя поверхность холодного откоса зимой легко опускается до +8…+10 °С. Поэтому при влажности около 50–60 % конденсат на таких поверхностях неизбежен, а разумная цель 40–50 %.</p></div><div class=\"e-art\" id=\"artE\"><div class=\"e-sech\"><small>E</small><h3>Основные проблемы квартир: причины и что делать</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Проблема</th><th>Причина</th><th>Что делать</th></tr></thead><tbody><tr><td>Духота, CO₂ выше 1000–1400 ppm к утру</td><td>Нет притока при герметичных окнах</td><td>Приточные клапаны или бризер; микропроветривание; датчик CO₂</td></tr><tr><td>Конденсат на окнах и откосах, плесень</td><td>Влажность выше 55–60 %, холодные откосы, сушка белья, готовка без вытяжки</td><td>Приток и вытяжка в мокрых зонах, утепление откосов, влажность 40–55 %</td></tr><tr><td>Запахи соседей, дым, пыль из шахты</td><td>Опрокидывание общей шахты, вентилятор соседа без обратного клапана</td><td>Обратный клапан на своей решётке, чистка канала, приток в квартиру, рециркуляционная вытяжка вместо вывода в шахту</td></tr><tr><td>Нет тяги в жару и на верхнем этаже</td><td>Шахта короткая, нет перепада температур</td><td>Осевой вентилятор малой мощности с обратным клапаном в санузле, бризер, для кухни рециркуляция</td></tr><tr><td>Хлопают двери, сквозняки, свист</td><td>Приточный воздух ищет путь, зазоров под дверями нет</td><td>Зазор под дверью около 1,5–2 см или переточная решётка (для санузла порядка 100–150 см² свободного сечения)</td></tr><tr><td>Шахта забита</td><td>Мусор от стройки, перепланировка, гипсокартон, натяжной потолок</td><td>Прочистка управляющей организацией, ревизионные лючки, не зашивать решётки</td></tr><tr><td>Шум бризера или клапана</td><td>Высокая скорость в малом сечении, нет глушителя</td><td>Увеличить сечение, снизить расход, глушитель</td></tr><tr><td>Сухой воздух зимой, статика</td><td>Расход притока выше нормы без увлажнения</td><td>Снизить расход до нормы, увлажнитель, энтальпийный рекуператор</td></tr><tr><td>Запах из сифонов и канализации</td><td>Высохшие гидрозатворы, разрежение в стояке от вытяжки</td><td>Залить сифоны, поставить воздушный клапан на стояк, убрать избыточное разрежение</td></tr></tbody></table></div><h4 class=\"e-h4\">Что делать в квартире, по порядку</h4><ul class=\"e-ul\"><li><b>1. Обеспечьте приток.</b> Клапаны в окнах или стене, бризер, проветривание в режиме микрощели. Не заклеивайте решётки и не закрывайте клапаны «от шума».</li><li><b>2. Откройте путь воздуху внутри.</b> Зазоры под дверями или переточные решётки: воздух должен дойти от спален до кухни и санузла.</li><li><b>3. Кухонная вытяжка.</b> В многоквартирном доме мощный вентилятор, врезанный в общую шахту, подавляет тягу соседей и сам работает хуже. Безопаснее рециркуляционный режим с угольным фильтром либо вывод по проекту в отдельный канал. Если подключение к шахте допущено, нужен обратный клапан и согласование.</li><li><b>4. Вентиляторы в санузле.</b> Только с обратным клапаном, расход близко к норме (около 25 м³/ч на санузел), лучше с таймером или датчиком влажности.</li><li><b>5. Содержите шахту в порядке.</b> Раз в год перед отопительным сезоном проверяйте тягу и чистоту решёток, подавайте заявку на прочистку каналов, не зашивайте решётки и не удлиняйте каналы самодельными трубами.</li><li><b>6. Газ.</b> Колонка или плита и мощная вытяжка работают вместе только при открытой форточке. Поставьте датчик CO и датчик газа, не меняйте и не заглушайте вентканал на кухне без согласования.</li><li><b>7. Новостройка.</b> Прямо при приёмке проверьте тягу всех шахт и зафиксируйте результат в акте: мусор в каналах тогда обязан убирать застройщик.</li></ul></div><div class=\"e-art\" id=\"artF\"><div class=\"e-sech\"><small>F</small><h3>Основные проблемы загородных домов: причины и что делать</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Проблема</th><th>Причина</th><th>Что делать</th></tr></thead><tbody><tr><td>Дым из камина или печи в комнату</td><td>Разрежение от вытяжки или ПВУ без баланса, нет воздуха на горение, холодный дымоход</td><td>Отдельный воздух на горение по каналу, баланс ПВУ не ниже нулевого, блокировка кухонной вытяжки с камином, прогрев дымохода перед растопкой</td></tr><tr><td>ПВУ шумит, жильцы её отключают</td><td>Установка над спальней, высокие скорости, нет глушителей</td><td>Пересчёт скоростей до 2–3 м/с, глушители, виброопоры, не более 30 дБ(А) у решёток ночью</td></tr><tr><td>Обмерзание рекуператора, аварийный останов в мороз</td><td>Нет преднагрева или разморозки</td><td>Преднагреватель, байпас с логикой разморозки, проверка по спецификации</td></tr><tr><td>Конденсат на каналах и потолке</td><td>Нет изоляции в холодных зонах, нет сифона и уклона</td><td>Изоляция по расчёту точки росы, гидрозатвор, подогрев дренажа</td></tr><tr><td>Запах в доме: гараж, подполье, канализация, кухня</td><td>Забор рядом с выбросами, разрежение подсасывает воздух из подполья и гаража, высохшие сифоны</td><td>Разнести забор и выброс, герметизировать перекрытие над подпольем, держать баланс, заливать сифоны</td></tr><tr><td>Сухой воздух зимой (влажность ниже 30 %)</td><td>Избыточный расход ПВУ, рекуператор без возврата влаги</td><td>Расход по CO₂, энтальпийный рекуператор, увлажнение, ночной режим</td></tr><tr><td>Жир на рекуператоре, падение КПД</td><td>Кухонный зонт подключён к ПВУ</td><td>Отдельный канал с жироуловителем, рециркуляционный зонт</td></tr><tr><td>Неравные расходы по комнатам</td><td>Нет балансировки, флекс магистралями</td><td>Протокол расходов по каждому диффузору, дроссели или диафрагмы, жёсткие магистрали</td></tr><tr><td>Духота летом при работающей ПВУ</td><td>Нет байпаса, нет ночного охлаждения</td><td>Байпас рекуператора, ночное проветривание, при необходимости охлаждение притока</td></tr><tr><td>Фильтры не меняют, воздух грязный</td><td>Нет люков доступа, нет регламента</td><td>Люки у установки, регламент и напоминания, цена комплекта до покупки</td></tr></tbody></table></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 236\" role=\"img\" aria-label=\"Разрежение в помещении от вытяжки без притока при разной герметичности\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"238\" y=\"51\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Старый дом, n50 = 6</text><rect x=\"250\" y=\"30\" width=\"11.263981049600964\" height=\"32\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"269.26398104960094\" y=\"51\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">2,3 Па</text><text x=\"238\" y=\"97\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Обычный, окна ПВХ, n50 = 3</text><rect x=\"250\" y=\"76\" width=\"32.72012705455812\" height=\"32\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"290.72012705455813\" y=\"97\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">6,5 Па</text><text x=\"238\" y=\"143\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Новый энергоэффективный, n50 = 1,5</text><rect x=\"250\" y=\"122\" width=\"95.0469207780098\" height=\"32\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"353.0469207780098\" y=\"143\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">19,0 Па</text><text x=\"238\" y=\"189\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"400\">Пассивный дом, n50 = 0,6</text><rect x=\"250\" y=\"168\" width=\"389.18263090624794\" height=\"32\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"647.1826309062479\" y=\"189\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">77,8 Па</text><line x1=\"270.0\" y1=\"16\" x2=\"270.0\" y2=\"206\" stroke=\"#e3000f\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/><text x=\"276.0\" y=\"14\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"400\">4 Па</text></svg><figcaption>Разрежение при вытяжке 200 м³/ч без притока в объёме 250 м³ (≈ 100 м² при потолке 2,5 м): Δp = 50 · (Q ÷ (n50 · V))^(1/0,65). Чем герметичнее дом, тем сильнее разрежение. Расчёт без характеристики вентилятора: реальный вентилятор при таком давлении потеряет расход, но тяга шахты и дымохода будет подавлена в любом случае.</figcaption></figure><h4 class=\"e-h4\">Что делать в доме с камином, печью или атмосферным котлом</h4><ul class=\"e-ul\"><li><b>Воздух на горение.</b> Подавайте с улицы по отдельному каналу, камин выбирайте с закрытой топкой и герметичной дверцей. Газовый котёл лучше с закрытой камерой сгорания (коаксиальный дымоход): он не зависит от воздуха в доме.</li><li><b>Баланс ПВУ.</b> Приток не ниже вытяжки, а при работающем камине больше. Разрежение в помещении с топкой не должно превышать 4 Па (ориентир, уточняйте по паспорту топки).</li><li><b>Блокировки.</b> Кухонный зонт без компенсирующего притока при растопке не включайте: ставьте реле давления или блокировку с камином, а вытяжку оснащайте компенсирующим притоком.</li><li><b>Дымоход.</b> Устье выше конька (не ниже 0,5 м над ним), правильное сечение, утепление над кровлей, ревизии и чистка по графику. Размеры и высоту определяет проект и нормы.</li><li><b>Герметичность.</b> Чем герметичнее дом, тем важнее приток. Для пассивного дома мощную вытяжку без компенсирующего притока включать нельзя.</li><li><b>Проверка.</b> После монтажа замерьте разность давлений между домом и улицей при всех режимах (вытяжка, ПВУ, камин), протокол приложите к сдаче.</li></ul><div class=\"e-basis\"><b>Когда нужен специалист</b><p>Если вы чувствуете запах дыма или газа, срабатывает датчик CO, пламя колонки или котла отклоняется в комнату, камин дымит, на отделке следы сажи: прекращайте пользоваться прибором и вызывайте газовую службу или организацию, которая обслуживает дымоходы и вентканалы.</p></div></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Это ориентировочные расчёты для сметы и разговора с проектировщиком, а не проект. Формулы взяты из гидравлики и теплотехники, числа нормативов — из справочника «Качество работ». Окончательные значения проверяют по действующим СН и ТКП и по паспортам оборудования. Нормы на 1 человека и 1 м² даны по СН 4.02.03, приложение П; расходы вытяжки кухонь и санузлов и скорости в воздуховодах — практические ориентиры, не нормы сайта.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/inzh.js?v=9\"></script><script src=\"/static/export.js?v=2\"></script>"
}

pattern EstSolarTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=25\"><div class=\"e-head\"><div class=\"e-eyebrow\">Справочники · Солнечная генерация</div><h1>Солнечные системы: расчёт под ключ</h1><p class=\"e-lead\">Выработка для Беларуси по часам, кровля и забор, инвертор и батарея, спецификация и окупаемость на 25 лет.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.ref_nav_aria }}\"><a href=\"{{ p }}/spravochniki\">{{ t.ref_tab_hub }}</a><a href=\"{{ p }}/spravochniki/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/spravochniki/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/spravochniki/elektrika\">{{ t.est_tab_elec }}</a><a href=\"{{ p }}/spravochniki/vodosnabzhenie\">{{ t.est_tab_water }}</a><a href=\"{{ p }}/spravochniki/kanalizaciya\">{{ t.est_tab_sewer }}</a><a href=\"{{ p }}/spravochniki/otoplenie\">{{ t.est_tab_heat }}</a><a href=\"{{ p }}/spravochniki/ventilyaciya\">{{ t.est_tab_vent }}</a><a href=\"{{ p }}/spravochniki/solnechnaya-generaciya\" class=\"on\" aria-current=\"page\">{{ t.est_tab_solar }}</a><a href=\"{{ p }}/spravochniki/konditsionirovanie\">{{ t.est_tab_cond }}</a><a href=\"{{ p }}/spravochniki/umnyj-dom\">{{ t.est_tab_smart }}</a><a href=\"{{ p }}/spravochniki/prudy\">{{ t.est_tab_pond }}</a><a href=\"{{ p }}/spravochniki/basseyny\">{{ t.est_tab_pool }}</a><a href=\"{{ p }}/spravochniki/bani\">{{ t.est_tab_bath }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Солнечная генерация\"><a href=\"#sgart\" data-sub=\"sgart\" class=\"art\">Статья</a><a href=\"#sgcalc\" data-sub=\"sgcalc\">Расчёт</a><a href=\"#sgyear\" data-sub=\"sgyear\">Год</a><a href=\"#sgday\" data-sub=\"sgday\">Сутки</a><a href=\"#sgbom\" data-sub=\"sgbom\">Оборудование</a><a href=\"#sgpay\" data-sub=\"sgpay\">Окупаемость</a></div><div class=\"e-elec\" id=\"e-solar\"><section class=\"e-panel\" id=\"sgart\" data-panel=\"sgart\"><div class=\"e-sech\"><small>01</small><h2>Солнечные системы: как выбрать и посчитать</h2></div><p class=\"e-lead2\">Кровля, забор, инвертор, накопитель и деньги: что выбрать, где теряется выработка и как не ошибиться с мощностью.</p><div class=\"e-art\" id=\"art0\"><div class=\"e-sech\"><small>0</small><h3>Тарифы и условия в Беларуси</h3></div><p class=\"e-lead2\">Экономика солнечной станции в Беларуси держится на двух вещах: сколько стоит киловатт-час из сети и сколько платят за излишки. Цифры ниже заложены в калькулятор, их можно менять.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Случай</th><th>Одноставочный, BYN/кВт·ч</th><th>Двухзонный: минимум 22–17 / максимум 17–22</th><th>Трёхзонный: ночь 23–6 / пик 17–23 / остальное</th></tr></thead><tbody><tr><td>Жильё с электроплитой без газа</td><td>0,2581</td><td>0,1807 / 0,5162</td><td>0,1549 / 0,4646 / 0,1807</td></tr><tr><td>Все остальные случаи</td><td>0,3037</td><td>0,2126 / 0,6074</td><td>0,1822 / 0,5467 / 0,2126</td></tr></tbody></table></div><p class=\"e-note\">Тарифы для населения с 01.03.2026, постановление Совмина от 25.02.2026 № 93. Тарифы с отдельным счётчиком на отопление и ГВС и для пустующего жилья другие. В расчёте выходные дни приняты по минимальной ставке.</p><ul class=\"e-ul\"><li><b>Микрогенерация.</b> Закон о возобновляемых источниках энергии (№ 204-З) гарантирует подключение установок к сети. Для частного лица речь идёт о мощности около 15 кВт, выше только через юрлицо или ИП. Подключение, двунаправленный счётчик и договор выкупа оформляются через энергоснабжающую организацию.</li><li><b>Выкуп излишков</b> идёт по заметно более низкой цене, чем покупка: в расчёте 0,10 BYN/кВт·ч (параметр можно изменить). Поэтому самопотреблённый киловатт-час в 2–3 раза ценнее проданного, и станцию проектируют под своё потребление.</li><li><b>Что влияет на деньги сильнее всего:</b> тариф и его рост, доля самопотребления, цена оборудования и курс. Всё это задаётся в калькуляторе.</li></ul><figure class=\"e-fig\"><svg viewBox=\"0 0 760 134\" role=\"img\" aria-label=\"Шесть шагов проекта солнечной станции\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"6\" y=\"10\" width=\"112\" height=\"112\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"16\" y=\"38\" font-size=\"24\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">1</text><text x=\"16\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Потребление</text><text x=\"16\" y=\"78\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">и тариф</text><text x=\"16\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">профиль</text><text x=\"16\" y=\"111\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">по часам</text><line x1=\"119\" y1=\"66\" x2=\"129\" y2=\"66\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"129,66 120.9,69.9 120.9,62.1\" fill=\"#9a9ca3\"/><rect x=\"130\" y=\"10\" width=\"112\" height=\"112\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"140\" y=\"38\" font-size=\"24\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">2</text><text x=\"140\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Конструкция</text><text x=\"140\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">кровля, забор,</text><text x=\"140\" y=\"111\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">навес</text><line x1=\"243\" y1=\"66\" x2=\"253\" y2=\"66\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"253,66 244.9,69.9 244.9,62.1\" fill=\"#9a9ca3\"/><rect x=\"254\" y=\"10\" width=\"112\" height=\"112\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"264\" y=\"38\" font-size=\"24\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">3</text><text x=\"264\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Инвертор</text><text x=\"264\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">MPPT, DC/AC,</text><text x=\"264\" y=\"111\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">защиты</text><line x1=\"367\" y1=\"66\" x2=\"377\" y2=\"66\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"377,66 368.9,69.9 368.9,62.1\" fill=\"#9a9ca3\"/><rect x=\"378\" y=\"10\" width=\"112\" height=\"112\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"388\" y=\"38\" font-size=\"24\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">4</text><text x=\"388\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Накопитель</text><text x=\"388\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">под задачу,</text><text x=\"388\" y=\"111\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">не для вида</text><line x1=\"491\" y1=\"66\" x2=\"501\" y2=\"66\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"501,66 492.9,69.9 492.9,62.1\" fill=\"#9a9ca3\"/><rect x=\"502\" y=\"10\" width=\"112\" height=\"112\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"512\" y=\"38\" font-size=\"24\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">5</text><text x=\"512\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Сеть и учёт</text><text x=\"512\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">микрогенерация,</text><text x=\"512\" y=\"111\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">УЗИП</text><line x1=\"615\" y1=\"66\" x2=\"625\" y2=\"66\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"625,66 616.9,69.9 616.9,62.1\" fill=\"#9a9ca3\"/><rect x=\"626\" y=\"10\" width=\"112\" height=\"112\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"636\" y=\"38\" font-size=\"24\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">6</text><text x=\"636\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"start\" font-weight=\"700\">Деньги</text><text x=\"636\" y=\"98\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">NPV,</text><text x=\"636\" y=\"111\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"start\" font-weight=\"400\">а не «срок»</text></svg><figcaption>Начинают с потребления и тарифа, а не с площади крыши: каждый следующий шаг опирается на предыдущий.</figcaption></figure></div><div class=\"e-art\" id=\"art1\"><div class=\"e-sech\"><small>1</small><h3>Физика и суть: киловатт-пик, инсоляция, здравый смысл</h3></div><p class=\"e-lead2\">Станцию считают не по площади крыши, а в киловатт-пиках (кВтп): мощность модулей при 1000 Вт/м² и +25 °C. Годовая выработка E = P · H · PR, где H радиация на плоскость модулей, PR коэффициент качества системы: температура, кабель, инвертор, пыль, снег.</p><div class=\"e-kpis\"><div class=\"e-kpi\"><b>1 062</b><span>кВт·ч с 1 кВтп в год: кровля, юг 35°, Минск</span></div><div class=\"e-kpi\"><b>−0,3…−0,4 %/K</b><span>потеря мощности кремния при нагреве</span></div><div class=\"e-kpi\"><b>≈ 92 %</b><span>от кровли даёт забор bifacial за год</span></div><div class=\"e-kpi\"><b>×2–3</b><span>самопотреблённый кВт·ч дороже проданного в сеть</span></div></div><p class=\"e-lead2\">Радиация на горизонтальную поверхность в Минске около 1020 кВт·ч/м² в год (данные БГУ за 1984–2008), из них 45–50 % приходится на май–июль и около 5 % на ноябрь–январь. Поэтому зимой станция даёт мало, и это нужно знать до покупки.</p><ul class=\"e-ul\"><li><b>Температура.</b> Модуль без вентзазора летом нагревается до +65…+70 °C и теряет 8–12 % мощности. В расчёте плотная посадка к покрытию снижает годовую выработку примерно на 2–3 %, но заметнее всего в июне и июле.</li><li><b>Профиль генерации.</b> Солнце не совпадает с вечерним пиком потребления, поэтому вопрос «куда деть выработку» важнее вопроса «сколько выработается».</li><li><b>Главный принцип.</b> Станцию проектируют от потребления и тарифа, а не от площади крыши: сначала профиль нагрузки, тариф, частота аварий сети, и только потом ориентации и модули.</li></ul><h4 class=\"e-h4\">Как проверить тень: ShadeMap</h4><p class=\"e-lead2\">Перед расчётом посмотрите, где ложится тень на вашем участке. Удобно сервисом <a href=\"https://shademap.app\" target=\"_blank\" rel=\"noopener\">ShadeMap</a>: карта в реальном времени показывает тени от зданий, деревьев и рельефа на любую дату и час.</p><ul class=\"e-ul\"><li>Откройте <a href=\"https://shademap.app\" target=\"_blank\" rel=\"noopener\">shademap.app</a>, найдите свой адрес и приблизьте карту до уровня участка.</li><li>Кнопкой даты и времени внизу экрана выставьте <b>21 декабря</b>: солнце самое низкое, тени самые длинные. Если крыша или забор чисты в декабре с 10 до 14 часов, остальной год будет лучше.</li><li>Проверьте и 21 марта (или сентября), и 21 июня: весной и осенью тень от соседних построек и деревьев часто решает судьбу утренних и вечерних часов.</li><li>Передвигайте время в течение дня и смотрите, какие части крыши и периметра оказываются в тени и в какие часы.</li><li>В меню Layers включите «Hours in the sun»: карта покажет, сколько часов прямого солнца получает каждая точка за выбранный день, а «Annual sunlight» даёт оценку за год.</li><li>Если на карте нет тени от дерева или она постоянная, переключите «Above canopy / Below canopy» в Settings. Здания без данных о высоте сервис считает одноэтажными, поэтому высоту соседних построек проверьте на месте.</li><li>Перенесите результат в калькулятор: долю затенённых модулей учтите в поле «Затенение массивов», а сильно затенённый скат вынесите в отдельный массив с отдельным MPPT.</li></ul><p class=\"e-note\">ShadeMap даёт оценку: данные о высоте зданий и деревьев приближённые. Для проекта тень проверяют на месте приборами (инсолятор, аудит тени) и по фото в декабре.</p></div><div class=\"e-art\" id=\"art2\"><div class=\"e-sech\"><small>2</small><h3>Конструкции: кровля, забор, фасад, навес</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Конструкция</th><th>Годовая выработка, кВт·ч/кВтп (расчёт, Минск)</th><th>Стоимость и срок</th><th>Плюсы и минусы</th></tr></thead><tbody><tr><td>Кровля юг 30–35°, модули на системе</td><td>1 062</td><td>база; монтаж 1–2 дня на 10 кВт</td><td>Максимум года. Нужна здоровая кровля и правильные проходки</td></tr><tr><td>Кровля юг 15° (пологая)</td><td>974</td><td>база</td><td>Меньше парусность, но снег держится дольше и зимой хуже</td></tr><tr><td>Кровля юг 45°</td><td>1 075</td><td>база</td><td>Лучше зимой и в межсезонье, летом чуть ниже</td></tr><tr><td>Кровля юго-запад 35°</td><td>1 000</td><td>база</td><td>Потеря около 6 % к югу, зато сдвиг на вечер</td></tr><tr><td>Кровля восток или запад 15°</td><td>851</td><td>база</td><td>Потеря 20 %, плавная кривая дня; востоку и западу нужны отдельные MPPT</td></tr><tr><td>Навес, carport 10° на юг</td><td>941</td><td>конструкция + модули</td><td>Парковка и тень + генерация; слабая самоочистка при малых углах</td></tr><tr><td>Забор bifacial вертикально, на юг</td><td>977</td><td>стоимость забора + 30–60 %</td><td>Зимой ×1,7–1,8 к кровле, летом на треть ниже; нет снега на модулях; ветровая нагрузка</td></tr><tr><td>Забор bifacial вертикально, восток–запад</td><td>970</td><td>стоимость забора + 30–60 %</td><td>Год как кровля 35° на 91 %; утро и вечер; зимой примерно как кровля</td></tr><tr><td>Фасад вертикально на юг (моно)</td><td>809</td><td>в составе вентфасада</td><td>Архитектура, меньше летнего перегрева; низкая выработка</td></tr><tr><td>Солнечная черепица (BIPV)</td><td>примерно на 10–15 % ниже кровли</td><td>×2–3 к модулям</td><td>Эстетика и единый срок службы; нет вентзазора; плотность мощности 60–110 Вт/м² против 200–220 у модулей</td></tr></tbody></table></div><p class=\"e-note\">Расчёт по почасовой модели с снежным альбедо и потерями на отражение, точность около ±10 %. Забор: bifacial 580 Вт, коэффициент двусторонности 0,7. Данные для BIPV по материалам производителей.</p><h4 class=\"e-h4\">Кровля и забор дополняют друг друга</h4><figure class=\"e-fig\"><svg viewBox=\"0 0 760 396\" role=\"img\" aria-label=\"Выработка 1 кВтп по месяцам для разных конструкций, Минск\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"56\" y1=\"260.0\" x2=\"716\" y2=\"260.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"50\" y=\"264.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0</text><line x1=\"56\" y1=\"202.5\" x2=\"716\" y2=\"202.5\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"50\" y=\"206.5\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">40</text><line x1=\"56\" y1=\"145.0\" x2=\"716\" y2=\"145.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"50\" y=\"149.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">80</text><line x1=\"56\" y1=\"87.5\" x2=\"716\" y2=\"87.5\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"50\" y=\"91.5\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">120</text><line x1=\"56\" y1=\"30.0\" x2=\"716\" y2=\"30.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"50\" y=\"34.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">160</text><text x=\"16\" y=\"18\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">кВт·ч с 1 кВтп за месяц</text><text x=\"83.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">янв</text><text x=\"138.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">фев</text><text x=\"193.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">мар</text><text x=\"248.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">апр</text><text x=\"303.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">май</text><text x=\"358.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">июн</text><text x=\"413.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">июл</text><text x=\"468.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">авг</text><text x=\"523.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">сен</text><text x=\"578.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">окт</text><text x=\"633.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">ноя</text><text x=\"688.5\" y=\"278\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">дек</text><polyline points=\"83.5,223.0 138.5,194.0 193.5,122.0 248.5,89.1 303.5,56.7 358.5,58.3 413.5,56.6 468.5,70.6 523.5,113.2 578.5,162.9 633.5,214.4 688.5,232.8\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"83.5\" cy=\"223.0\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"138.5\" cy=\"194.0\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"193.5\" cy=\"122.0\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"248.5\" cy=\"89.1\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"303.5\" cy=\"56.7\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"358.5\" cy=\"58.3\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"413.5\" cy=\"56.6\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"468.5\" cy=\"70.6\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"523.5\" cy=\"113.2\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"578.5\" cy=\"162.9\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"633.5\" cy=\"214.4\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"688.5\" cy=\"232.8\" r=\"3.5\" fill=\"#1d1f23\" stroke=\"#fff\" stroke-width=\"1.2\"/><polyline points=\"83.5,193.0 138.5,161.5 193.5,105.6 248.5,119.1 303.5,109.2 358.5,114.1 413.5,110.3 468.5,112.9 523.5,125.0 578.5,152.2 633.5,199.5 688.5,212.8\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"83.5\" cy=\"193.0\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"138.5\" cy=\"161.5\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"193.5\" cy=\"105.6\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"248.5\" cy=\"119.1\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"303.5\" cy=\"109.2\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"358.5\" cy=\"114.1\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"413.5\" cy=\"110.3\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"468.5\" cy=\"112.9\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"523.5\" cy=\"125.0\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"578.5\" cy=\"152.2\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"633.5\" cy=\"199.5\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"688.5\" cy=\"212.8\" r=\"3.5\" fill=\"#e3000f\" stroke=\"#fff\" stroke-width=\"1.2\"/><polyline points=\"83.5,225.9 138.5,197.4 193.5,137.3 248.5,109.7 303.5,62.4 358.5,54.3 413.5,56.5 468.5,83.9 523.5,139.6 578.5,191.6 633.5,228.9 688.5,237.8\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-dasharray=\"6 4\" stroke-linejoin=\"round\"/><circle cx=\"83.5\" cy=\"225.9\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"138.5\" cy=\"197.4\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"193.5\" cy=\"137.3\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"248.5\" cy=\"109.7\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"303.5\" cy=\"62.4\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"358.5\" cy=\"54.3\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"413.5\" cy=\"56.5\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"468.5\" cy=\"83.9\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"523.5\" cy=\"139.6\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"578.5\" cy=\"191.6\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"633.5\" cy=\"228.9\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"688.5\" cy=\"237.8\" r=\"3.5\" fill=\"#7d8089\" stroke=\"#fff\" stroke-width=\"1.2\"/><polyline points=\"83.5,246.5 138.5,227.4 193.5,170.5 248.5,120.2 303.5,69.6 358.5,59.0 413.5,62.3 468.5,95.9 523.5,153.4 578.5,203.4 633.5,238.1 688.5,249.9\" fill=\"none\" stroke=\"#c6c8cd\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"83.5\" cy=\"246.5\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"138.5\" cy=\"227.4\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"193.5\" cy=\"170.5\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"248.5\" cy=\"120.2\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"303.5\" cy=\"69.6\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"358.5\" cy=\"59.0\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"413.5\" cy=\"62.3\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"468.5\" cy=\"95.9\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"523.5\" cy=\"153.4\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"578.5\" cy=\"203.4\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"633.5\" cy=\"238.1\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"688.5\" cy=\"249.9\" r=\"3.5\" fill=\"#c6c8cd\" stroke=\"#fff\" stroke-width=\"1.2\"/><line x1=\"56\" y1=\"302\" x2=\"82\" y2=\"302\" stroke=\"#1d1f23\" stroke-width=\"3\"/><text x=\"88\" y=\"306\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Кровля юг 35°: 1 062 за год</text><line x1=\"386\" y1=\"302\" x2=\"412\" y2=\"302\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"418\" y=\"306\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Забор bifacial, на юг: 977 за год</text><line x1=\"56\" y1=\"322\" x2=\"82\" y2=\"322\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-dasharray=\"6 4\"/><text x=\"88\" y=\"326\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Забор bifacial, восток–запад: 970 за год</text><line x1=\"386\" y1=\"322\" x2=\"412\" y2=\"322\" stroke=\"#c6c8cd\" stroke-width=\"3\"/><text x=\"418\" y=\"326\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Кровля на восток 15°: 851 за год</text><text x=\"56\" y=\"358\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Зимой вертикальный забор на юг даёт вдвое больше кровли, летом уступает почти на треть: кривые пересекаются дважды в год.</text></svg><figcaption>Расчёт по модели калькулятора: почасовая радиация Минска, снежное альбедо, потери на отражение и нагрев. Диапазон неопределённости ±10 %.</figcaption></figure><p class=\"e-lead2\">Кровля даёт количество, забор стабильность: кривые пересекаются дважды в год. Доля декабря и января в годовой выработке: кровля 35° около 4 %, забор на юг около 8 %, пологая кровля 15° меньше 3 %.</p><ul class=\"e-ul\"><li><b>Кровля.</b> Уклон и ориентация задают выработку, а вентзазор 80–120 мм и просвет под нижним рядом спасают лето и зиму. Старой шиферной или битумной кровле перед установкой нужен ремонт: модули живут 25–30 лет.</li><li><b>Забор.</b> Типовой участок 25 м длиной даёт 9–13 кВтп (зависит от высоты и модулей). Ограждение заменено и платит за себя, но сильнее страдает от теней деревьев и построек, нужны фундаменты и диагональные связи по ветровой нагрузке, земляная трасса и щит на периметре. В населённых пунктах возможны требования к виду ограждения: уточняйте в исполкоме.</li><li><b>Солнечная черепица.</b> Tesla Solar Roof, SunRoof, GAF Timberline, SunStyle, Autarq. Это покупка эстетики и замены кровли, а не инвестиция в максимум киловатт-часов: цена за ватт в 2–3 раза выше, монтаж только обученными бригадами, в Беларуси сервис и запчасти под вопросом. Имеет смысл, когда кровля всё равно подлежит замене.</li><li><b>Фасад и навес.</b> Фасад даёт мало, но снимает летний перегрев стены; навес закрывает машину и работает как кровля.</li></ul></div><div class=\"e-art\" id=\"art3\"><div class=\"e-sech\"><small>3</small><h3>Инверторы: схемы, характеристики и скрытые места</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Схема</th><th>Когда уместна</th><th>Что учесть</th></tr></thead><tbody><tr><td>Сетевой (string)</td><td>Сеть стабильная, цель счёт за свет</td><td>Самая дешёвая, КПД до 98,5 %. При отключении сети гаснет полностью (защита от острова), даже днём</td></tr><tr><td>Гибридный + АКБ</td><td>Основной выбор для дома: самопотребление, резерв, зонный тариф</td><td>Дороже на 30–60 %. Резервный порт часто 50–100 % номинала: котёл и насос в группу заранее</td></tr><tr><td>Микроинверторы</td><td>Тени, сложные крыши, рост по модулю</td><td>Нет высокого DC на крыше. Дороже за ватт, ремонт «альпинизмом»</td></tr><tr><td>Оптимизаторы мощности</td><td>Частичные тени при струнной цене</td><td>Привязка к фирменному инвертору; режим безопасного DC</td></tr><tr><td>AC-ретрофит батареи</td><td>К работающей сетевой станции добавить резерв</td><td>Чуть ниже КПД цепочки, переделок почти нет</td></tr><tr><td>Автономный (off-grid)</td><td>Дача, ферма, где сети нет или она плохая</td><td>Окупается быстрее остальных: сравнение не с тарифом, а со стоимостью линии</td></tr></tbody></table></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Параметр</th><th>Что смотреть</th><th>Ориентир 2025–2026</th></tr></thead><tbody><tr><td>КПД</td><td>европейский, а не пиковый</td><td>97–98,5 %; 1 % на 10 кВт ≈ 100 кВт·ч в год</td></tr><tr><td>MPPT</td><td>по одному на каждую ориентацию и уклон</td><td>2–4 для дома; ток входа 16–26 А под модули 550 Вт и выше</td></tr><tr><td>DC/AC</td><td>отношение мощности модулей к инвертору</td><td>1,2–1,4 (восток–запад до 1,6); при 1,0 теряется 3–6 % года</td></tr><tr><td>Максимальное DC напряжение</td><td>считать на морозе</td><td>Voc растёт на 10–15 % при −25 °C: строка, прошедшая летом, может пробить лимит в январе</td></tr><tr><td>Резервный выход (EPS)</td><td>время переключения и мощность</td><td>до 20 мс, 5–10 кВт для дома</td></tr><tr><td>Защиты</td><td>AFCI, УЗИП II на DC и AC, УЗО</td><td>в паспорте, а не «опция»</td></tr><tr><td>Мониторинг</td><td>постринговая аналитика, обновление по воздуху</td><td>приложение и экспорт данных владельцу</td></tr><tr><td>Гарантия и сервис</td><td>официальный сервис и склад в РБ</td><td>5–10 лет; важнее 0,2 % КПД</td></tr></tbody></table></div><p class=\"e-lead2\">Пример для строки. Модуль TOPCon 550 Вт: Voc 49,9 В. При −25 °C Voc около 56 В, поэтому в гибрид с лимитом 500 В помещается не больше 8 модулей в строке, а в 3-фазный 800 В до 13. Калькулятор считает это сам во вкладке «Оборудование».</p><ul class=\"e-ul\"><li><b>Клиппинг.</b> Инвертор «в размер» модулей срезает пики. При DC/AC 1,3 это норма, при 1,0 потеря 3–6 % года.</li><li><b>Смешанные ориентации на одном MPPT</b> теряют 10–25 %: юг и восток–запад разводят по трекерам, забор и крышу на разные входы.</li><li><b>Изоляция DC.</b> Бестрансформаторные инверторы контролируют изоляцию сети: влага в разъёмах MC4 даёт утренние ошибки и простои.</li><li><b>Сертификация.</b> Сетевые защиты и анти-остров должны соответствовать требованиям энергосистемы: «серый» инвертор без сертификата это проблема при приёмке микрогенерации.</li><li><b>Платные «бесплатности».</b> Логгер, расширенный мониторинг, продление гарантии часто отдельными строками после подписания.</li><li><b>Гарантия 5–10 лет</b> живёт только при официальной пусконаладке и регистрации: чек монтажа хранят вместе с проектом.</li><li><b>Шум и место.</b> Вентиляторы и реле слышны: техпомещение или улица (IP65), не спальня; зимой −10 °C для спальни тоже плохо.</li><li><b>Смена профиля.</b> Через пару лет электромобиль и тепловой насос: гибрид с портом АКБ «впрок» дешевле замены всего узла.</li></ul><p class=\"e-lead2\">Лучшие на рынке (мир): Huawei SUN2000, Fronius GEN24 Plus, SMA Sunny Tripower Smart Energy, SolarEdge, Enphase IQ8. Реально купить и обслужить в Беларуси: Huawei, Deye, Growatt, GoodWe, Solis, Sungrow; премиум (Fronius, SMA) под заказ.</p></div><div class=\"e-art\" id=\"art4\"><div class=\"e-sech\"><small>4</small><h3>Накопители: аккумуляторы и ионисторы</h3></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Технология</th><th>Циклы / глубина</th><th>Цена, €/кВт·ч (модуль)</th><th>Роль и вердикт для дома</th></tr></thead><tbody><tr><td>LFP (LiFePO₄)</td><td>6000–8000 (премиум до 10 000) / 90–100 %</td><td>250–380</td><td>Стандарт 2025–2026: безопасен, живёт 12–15 лет. Выбор по умолчанию</td></tr><tr><td>NMC</td><td>3000–4500 / 80 %</td><td>около 450</td><td>Компактно (Powerwall-класс), требователен к термозащите. Из дома уходит</td></tr><tr><td>Na-ion</td><td>4000–6000 / 90 %</td><td>около 400</td><td>Работает на морозе, без лития. Для холодных объектов, когда сравняется с LFP по цене</td></tr><tr><td>Lead-carbon</td><td>около 1200</td><td>около 220</td><td>Вытеснен подешевевшим LFP</td></tr><tr><td>AGM/GEL</td><td>300–700 / 50 %</td><td>130–180</td><td>Только дешёвый резерв редкого использования</td></tr><tr><td>LTO</td><td>15 000–20 000</td><td>около 1200</td><td>Заряд за минуты, −40 °C. Ниша: промышленные пики, не дом</td></tr><tr><td>Ионистор (суперконденсатор)</td><td>500 000+</td><td>3000–9000</td><td>Не хранилище, а буфер: пуск насоса, пики, рекуперация. В паре с АКБ продлевает ей жизнь</td></tr></tbody></table></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 318\" role=\"img\" aria-label=\"Карта технологий накопителей: цена за кВт·ч и ресурс в циклах (логарифмические оси)\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"70\" y1=\"280.0\" x2=\"720\" y2=\"280.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"64\" y=\"284.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">100</text><line x1=\"70\" y1=\"155.0\" x2=\"720\" y2=\"155.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"64\" y=\"159.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">1 000</text><line x1=\"70\" y1=\"30.0\" x2=\"720\" y2=\"30.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"64\" y=\"34.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">10 000</text><line x1=\"172.63157894736844\" y1=\"30\" x2=\"172.63157894736844\" y2=\"280\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"172.63157894736844\" y=\"298\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">1 000</text><line x1=\"343.6842105263158\" y1=\"30\" x2=\"343.6842105263158\" y2=\"280\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"343.6842105263158\" y=\"298\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">10 000</text><line x1=\"514.7368421052631\" y1=\"30\" x2=\"514.7368421052631\" y2=\"280\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"514.7368421052631\" y=\"298\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">100 000</text><line x1=\"685.7894736842105\" y1=\"30\" x2=\"685.7894736842105\" y2=\"280\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"685.7894736842105\" y=\"298\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">1 000 000</text><text x=\"70\" y=\"18\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">€ за 1 кВт·ч запаса (розница, модуль)</text><text x=\"720\" y=\"318\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">циклов до 80 % ёмкости</text><circle cx=\"121.1\" cy=\"256.2\" r=\"12\" fill=\"#c6c8cd\" fill-opacity=\"0.88\" stroke=\"#fff\" stroke-width=\"1.5\"/><text x=\"139.1\" y=\"260.2\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">AGM/GEL</text><circle cx=\"186.2\" cy=\"237.2\" r=\"12\" fill=\"#9a9ca3\" fill-opacity=\"0.88\" stroke=\"#fff\" stroke-width=\"1.5\"/><text x=\"204.2\" y=\"241.2\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">Lead-carbon</text><circle cx=\"265.7\" cy=\"198.3\" r=\"14\" fill=\"#7d8089\" fill-opacity=\"0.88\" stroke=\"#fff\" stroke-width=\"1.5\"/><text x=\"245.7\" y=\"194.3\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">NMC</text><circle cx=\"292.2\" cy=\"204.7\" r=\"14\" fill=\"#4a4d55\" fill-opacity=\"0.88\" stroke=\"#fff\" stroke-width=\"1.5\"/><text x=\"312.2\" y=\"192.7\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">Na-ion</text><circle cx=\"327.1\" cy=\"220.4\" r=\"20\" fill=\"#e3000f\" fill-opacity=\"0.88\" stroke=\"#fff\" stroke-width=\"1.5\"/><text x=\"353.1\" y=\"242.4\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">LiFePO₄</text><circle cx=\"383.1\" cy=\"145.1\" r=\"14\" fill=\"#1d1f23\" fill-opacity=\"0.88\" stroke=\"#fff\" stroke-width=\"1.5\"/><text x=\"403.1\" y=\"149.1\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">LTO</text><circle cx=\"664.4\" cy=\"57.7\" r=\"22\" fill=\"#1d1f23\" fill-opacity=\"0.88\" stroke=\"#fff\" stroke-width=\"1.5\"/><text x=\"636.4\" y=\"61.7\" font-size=\"12\" fill=\"#1d1f23\" text-anchor=\"end\" font-weight=\"700\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">Ионистор</text><rect x=\"254.24442514941597\" y=\"200.7425010840047\" width=\"0\" height=\"0\" rx=\"0\" fill=\"none\" stroke=\"none\" stroke-width=\"1.5\"/></svg><figcaption>Выгодная покупка для дома живёт в зоне LiFePO₄. Ионистор в противоположном углу: миллионы циклов, но цена за кВт·ч выше на 1–2 порядка, поэтому он буфер для пиков, а не хранилище. Цены ориентировочные.</figcaption></figure><p class=\"e-lead2\">Лучшие накопители: BYD Battery-Box, Pylontech US/Force, Tesla Powerwall 3, Huawei LUNA2000, Sungrow SBR, Enphase IQ Battery 5P, sonnenBatterie. В Беларуси доступны BYD, Pylontech, Dyness, Sungrow и LFP-шкафы совместимые с Deye. Ионисторные буферы нишевые, под проект.</p><h4 class=\"e-h4\">Скрытые места накопителей</h4><ul class=\"e-ul\"><li><b>Холод.</b> Паспортные циклы даны при +25 °C и 0,5C. При −15 °C доступная ёмкость LFP может падать на 30–50 %, а заряд на морозе запрещён: BMS должна греть или блокировать. Батарея живёт в отапливаемом помещении.</li><li><b>Календарь.</b> Старение идёт и без циклов: «10 лет гарантии» это годы, а не циклы.</li><li><b>Балансировка и терморавномерность</b> сборки решают больше, чем химия: дешёвые шкафы деградируют перекосом ячеек.</li><li><b>Совместимость.</b> Низковольтные (48 В) и высоковольтные батареи не взаимозаменяемы: не каждая батарея встанет на любой гибрид.</li><li><b>EMS.</b> Сценарии «заряд от избытка», «разряд в пик 17–22», «резерв 20–30 % на аварию» превращают железо в деньги: без них батарея просто дорогая.</li></ul><h4 class=\"e-h4\">Окупается ли батарея</h4><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Тариф (дом 10 кВтп, 9 МВт·ч, батарея 10 кВт·ч)</th><th>NPV без батареи, BYN</th><th>NPV с батареей, BYN</th><th>Вклад батареи, BYN</th><th>Окупаемость без → с</th></tr></thead><tbody><tr><td>Одноставочный</td><td>11 449</td><td>2 459</td><td>-8 990</td><td>8,3 → 11,3 лет</td></tr><tr><td>Двухзонный</td><td>6 925</td><td>1 023</td><td>-5 902</td><td>9,5 → 11,6 лет</td></tr><tr><td>Трёхзонный</td><td>6 761</td><td>294</td><td>-6 468</td><td>9,6 → 11,9 лет</td></tr></tbody></table></div><p class=\"e-lead2\">При ценах из калькулятора и тарифах 2026 года батарея снижает NPV и удлиняет окупаемость на 2–3 года даже при зонном тарифе: она нужна под <b>резерв</b>, а не под экономию. Батарея оправдана при отключениях сети 4+ часа в месяц, нагрузке I категории (котёл, сервер, насос, медицинское оборудование), заметной разнице пик/ночь при выработке, не уходящей в сеть, и при цене выкупа ниже трети тарифа. Арбитраж с ночным зарядом из сети даёт около 750 BYN в год на 10 кВт·ч (разница 0,5162 и 0,1807, 260 рабочих дней): батарея за 7–8 тыс. BYN отбивается за 10 лет и больше, ресурс не доходит до 6000 циклов.</p></div><div class=\"e-art\" id=\"art5\"><div class=\"e-sech\"><small>5</small><h3>Сборка в единую систему и правила Беларуси</h3></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 214\" role=\"img\" aria-label=\"Схема энергодома: кровля, забор, гибридный инвертор, батарея, сеть\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"10\" y=\"12\" width=\"150\" height=\"56\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"85.0\" y=\"34\" font-size=\"13\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Кровля</text><text x=\"85.0\" y=\"52\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">юг 30–35°, MPPT 1</text><rect x=\"10\" y=\"80\" width=\"150\" height=\"56\" rx=\"0\" fill=\"#e3000f\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"85.0\" y=\"102\" font-size=\"13\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Забор bifacial</text><text x=\"85.0\" y=\"120\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">вертикаль, MPPT 2</text><rect x=\"210\" y=\"40\" width=\"170\" height=\"70\" rx=\"0\" fill=\"#1d1f23\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"295.0\" y=\"62\" font-size=\"13\" fill=\"#fff\" text-anchor=\"middle\" font-weight=\"700\">Гибридный инвертор</text><text x=\"295.0\" y=\"80\" font-size=\"10.5\" fill=\"#dcdde0\" text-anchor=\"middle\" font-weight=\"400\">MPPT · EPS · мониторинг</text><line x1=\"162\" y1=\"40\" x2=\"208\" y2=\"66\" stroke=\"#9a9ca3\" stroke-width=\"2.5\"/><polygon points=\"208,66 199.0,65.4 202.9,58.6\" fill=\"#9a9ca3\"/><line x1=\"162\" y1=\"108\" x2=\"208\" y2=\"86\" stroke=\"#9a9ca3\" stroke-width=\"2.5\"/><polygon points=\"208,86 202.4,93.0 199.0,86.0\" fill=\"#9a9ca3\"/><rect x=\"440\" y=\"8\" width=\"150\" height=\"48\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"515.0\" y=\"30\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Дом</text><text x=\"515.0\" y=\"48\" font-size=\"10.5\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">дневная нагрузка</text><rect x=\"440\" y=\"66\" width=\"150\" height=\"48\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"515.0\" y=\"88\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Батарея LFP</text><text x=\"515.0\" y=\"106\" font-size=\"10.5\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">вечер и резерв</text><rect x=\"440\" y=\"124\" width=\"150\" height=\"48\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"515.0\" y=\"146\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Сеть</text><text x=\"515.0\" y=\"164\" font-size=\"10.5\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">учёт, излишки</text><rect x=\"440\" y=\"8\" width=\"150\" height=\"48\" rx=\"0\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><rect x=\"440\" y=\"66\" width=\"150\" height=\"48\" rx=\"0\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><rect x=\"440\" y=\"124\" width=\"150\" height=\"48\" rx=\"0\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"382\" y1=\"62\" x2=\"438\" y2=\"32\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><polygon points=\"438,32 432.7,39.3 429.0,32.4\" fill=\"#1d1f23\"/><line x1=\"382\" y1=\"76\" x2=\"438\" y2=\"90\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><polygon points=\"438,90 429.2,91.8 431.1,84.2\" fill=\"#1d1f23\"/><line x1=\"382\" y1=\"98\" x2=\"438\" y2=\"146\" stroke=\"#1d1f23\" stroke-width=\"2.5\"/><polygon points=\"438,146 429.3,143.7 434.4,137.8\" fill=\"#1d1f23\"/><rect x=\"640\" y=\"8\" width=\"112\" height=\"48\" rx=\"0\" fill=\"#f6f6f7\" stroke=\"none\" stroke-width=\"1.5\"/><text x=\"696.0\" y=\"30\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"middle\" font-weight=\"700\">Электромобиль</text><text x=\"696.0\" y=\"48\" font-size=\"10.5\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">дневные излишки</text><rect x=\"640\" y=\"8\" width=\"112\" height=\"48\" rx=\"0\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"592\" y1=\"32\" x2=\"638\" y2=\"32\" stroke=\"#9a9ca3\" stroke-width=\"2\"/><polygon points=\"638,32 629.9,35.9 629.9,28.1\" fill=\"#9a9ca3\"/><text x=\"10\" y=\"204\" font-size=\"12\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">Мощность массива подгоняют под дневное потребление, ёмкость батареи под вечернее, сеть остаётся страховкой.</text></svg><figcaption>Днём кровля и забор кормят дом, излишек заряжает батарею, вечером она отдаёт накопленное; при аварии сети инвертор уходит в резервный режим.</figcaption></figure><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Узел</th><th>Мировой топ 2025–2026</th><th>Реалии Беларуси</th></tr></thead><tbody><tr><td>Модули</td><td>LONGi Hi-MO X10, Jinko Tiger Neo 3.0, Trina Vertex N (TOPCon bifacial, 23–25 %)</td><td>Tier-1 в наличии у интеграторов; bifacial для заборов и снега</td></tr><tr><td>Инверторы</td><td>Huawei SUN2000, Fronius GEN24, SMA, SolarEdge, Enphase</td><td>Huawei, Deye, Growatt, GoodWe, Solis, Sungrow: склад и сервис; премиум под заказ</td></tr><tr><td>Батареи</td><td>BYD Battery-Box, Pylontech, Tesla Powerwall 3, Huawei LUNA2000</td><td>BYD, Pylontech, Dyness, LFP-шкафы под Deye</td></tr><tr><td>Солнечная кровля (BIPV)</td><td>Tesla Solar Roof, SunRoof, GAF Energy, SunStyle, Autarq</td><td>под заказ, единичные проекты</td></tr><tr><td>Солнечный забор</td><td>Next2Sun (EU, вертикальный bifacial)</td><td>самодельные монтажные системы; агросектор и домохозяйства</td></tr><tr><td>Ионисторы</td><td>Skeleton SkelCap, Maxwell</td><td>нишевые поставки под промышленные пики</td></tr></tbody></table></div><ul class=\"e-ul\"><li><b>Защиты обязательны.</b> УЗИП II класса на DC и AC, заземление и уравнивание потенциалов, автоматика с селективностью, видимый DC-выключатель для пожарных.</li><li><b>Кабель DC.</b> Только солнечный PV1-F с двойной изоляцией, разъёмы MC4 одного производителя, трассы вне стяжек и с защитой от УФ, строки подписаны, схема строк в исполнительной документации.</li><li><b>Нагрузки на конструкции.</b> Крепления и каркас забора считают на снег и ветер по нормам, а не «как у соседа».</li><li><b>Налоговые льготы</b> (земельный налог, зачёт в экологический налог) применяются по заявлению; условия проверьте в налоговой инспекции.</li></ul><div class=\"e-basis\"><b>Мнемоника «Четыре С»</b><p>Солнце (конструкции и ориентации), Схема (инвертор и MPPT), Скопление (накопитель), Сеть (защиты, учёт, микрогенерация). Рабочая поговорка: крыша даёт количество, забор стабильность, батарея время.</p></div></div><div class=\"e-art\" id=\"art6\"><div class=\"e-sech\"><small>6</small><h3>Расчёт: выработка, самопотребление, окупаемость</h3></div><p class=\"e-lead2\">Шесть типовых сценариев, посчитанных той же моделью, что и калькулятор: тариф 2026 года, рост тарифа 6 % в год, дисконт 8 %, выкуп 0,10 BYN/кВт·ч, замена инвертора на 13-й год, деградация модулей 0,4 % в год. Сумма затрат по ориентировочным розничным ценам (меняются в калькуляторе).</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Сценарий</th><th>кВтп</th><th>Выработка</th><th>Идёт на своё</th><th>Экономия, BYN/год</th><th>Затраты, BYN</th><th>Окупаемость</th><th>NPV 25 лет, BYN</th></tr></thead><tbody><tr><td>Дом 5 кВт, вечерний профиль, без батареи</td><td>5,0</td><td>5,1 МВт·ч</td><td>29 %</td><td>743</td><td>9 000</td><td>9,9 лет</td><td>3 285</td></tr><tr><td>Дом 5 кВт, днём дома, без батареи</td><td>5,0</td><td>5,1 МВт·ч</td><td>42 %</td><td>847</td><td>9 000</td><td>8,9 лет</td><td>5 139</td></tr><tr><td>Дом 10 кВт, днём дома, без батареи, двухзонный</td><td>9,9</td><td>10,2 МВт·ч</td><td>39 %</td><td>1 389</td><td>16 047</td><td>9,5 лет</td><td>6 925</td></tr><tr><td>Дом 10 кВт + батарея 10 кВт·ч, двухзонный</td><td>9,9</td><td>10,1 МВт·ч</td><td>55 %</td><td>1 806</td><td>26 730</td><td>11,6 лет</td><td>1 023</td></tr><tr><td>Кровля 6,6 + забор 5,8 кВтп + батарея 10 кВт·ч</td><td>12,4</td><td>12,2 МВт·ч</td><td>37 %</td><td>1 825</td><td>32 710</td><td>15,0 лет</td><td>-5 676</td></tr><tr><td>Хозяйство 30 кВт днём, без батареи (юрлицо)</td><td>29,7</td><td>30,1 МВт·ч</td><td>70 %</td><td>7 296</td><td>44 081</td><td>5,5 лет</td><td>81 036</td></tr></tbody></table></div><figure class=\"e-fig\"><svg viewBox=\"0 0 760 356\" role=\"img\" aria-label=\"Накопленный денежный поток за 25 лет для пяти сценариев\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"70\" y1=\"250.0\" x2=\"720\" y2=\"250.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"64\" y=\"254.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">-50 тыс.</text><line x1=\"70\" y1=\"195.0\" x2=\"720\" y2=\"195.0\" stroke=\"#1d1f23\" stroke-width=\"1.4\"/><text x=\"64\" y=\"199.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">0 тыс.</text><line x1=\"70\" y1=\"140.0\" x2=\"720\" y2=\"140.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"64\" y=\"144.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">50 тыс.</text><line x1=\"70\" y1=\"85.0\" x2=\"720\" y2=\"85.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"64\" y=\"89.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">100 тыс.</text><line x1=\"70\" y1=\"30.0\" x2=\"720\" y2=\"30.0\" stroke=\"#e4e5e8\" stroke-width=\"1\"/><text x=\"64\" y=\"34.0\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">150 тыс.</text><text x=\"70.0\" y=\"268\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">0</text><text x=\"200.0\" y=\"268\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">5</text><text x=\"330.0\" y=\"268\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">10</text><text x=\"460.0\" y=\"268\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">15</text><text x=\"590.0\" y=\"268\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">20</text><text x=\"720.0\" y=\"268\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"middle\" font-weight=\"400\">25</text><text x=\"70\" y=\"18\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"start\" font-weight=\"400\">накопленный поток, BYN</text><text x=\"720\" y=\"286\" font-size=\"11\" fill=\"#4a4d55\" text-anchor=\"end\" font-weight=\"400\">годы</text><polyline points=\"70.0,204.9 96.0,204.1 122.0,203.3 148.0,202.5 174.0,201.6 200.0,200.6 226.0,199.6 252.0,198.5 278.0,197.4 304.0,196.2 330.0,194.9 356.0,193.6 382.0,192.2 408.0,191.7 434.0,190.2 460.0,188.5 486.0,186.7 512.0,184.9 538.0,182.9 564.0,180.8 590.0,178.6 616.0,176.3 642.0,173.8 668.0,171.2 694.0,168.4 720.0,165.5\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"70.0,204.9 96.0,204.0 122.0,203.1 148.0,202.1 174.0,201.1 200.0,200.0 226.0,198.8 252.0,197.6 278.0,196.3 304.0,194.9 330.0,193.4 356.0,191.9 382.0,190.3 408.0,189.6 434.0,187.8 460.0,185.9 486.0,183.9 512.0,181.8 538.0,179.5 564.0,177.1 590.0,174.6 616.0,171.9 642.0,169.1 668.0,166.1 694.0,163.0 720.0,159.6\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polyline points=\"70.0,224.4 96.0,222.6 122.0,220.6 148.0,218.6 174.0,216.4 200.0,214.1 226.0,211.6 252.0,209.1 278.0,206.3 304.0,203.5 330.0,200.4 356.0,197.2 382.0,193.8 408.0,194.1 434.0,190.3 460.0,186.3 486.0,187.1 512.0,182.6 538.0,177.8 564.0,172.8 590.0,167.5 616.0,161.9 642.0,156.0 668.0,149.7 694.0,143.1 720.0,136.1\" fill=\"none\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-dasharray=\"6 4\" stroke-linejoin=\"round\"/><polyline points=\"70.0,231.0 96.0,229.2 122.0,227.2 148.0,225.2 174.0,223.0 200.0,220.7 226.0,218.3 252.0,215.7 278.0,213.0 304.0,210.1 330.0,207.1 356.0,203.9 382.0,200.5 408.0,202.7 434.0,198.9 460.0,194.9 486.0,195.7 512.0,191.3 538.0,186.5 564.0,181.5 590.0,176.2 616.0,170.6 642.0,164.6 668.0,158.3 694.0,151.7 720.0,144.7\" fill=\"none\" stroke=\"#9a9ca3\" stroke-width=\"3\" stroke-dasharray=\"2 3\" stroke-linejoin=\"round\"/><polyline points=\"70.0,243.5 96.0,235.7 122.0,227.5 148.0,218.8 174.0,209.6 200.0,199.9 226.0,189.7 252.0,178.8 278.0,167.4 304.0,155.3 330.0,142.6 356.0,129.1 382.0,114.8 408.0,106.3 434.0,90.4 460.0,73.6 486.0,55.9 512.0,37.1 538.0,30.0 564.0,30.0 590.0,30.0 616.0,30.0 642.0,30.0 668.0,30.0 694.0,30.0 720.0,30.0\" fill=\"none\" stroke=\"#e3000f\" stroke-width=\"3\" stroke-linejoin=\"round\"/><text x=\"716\" y=\"64\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"end\" font-weight=\"700\">30 кВт: +319 тыс. к 25-му году</text><line x1=\"70\" y1=\"304\" x2=\"94\" y2=\"304\" stroke=\"#4a4d55\" stroke-width=\"3\"/><text x=\"100\" y=\"308\" font-size=\"11.5\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Дом 5 кВт, вечерний: 9,9 лет</text><line x1=\"370\" y1=\"304\" x2=\"394\" y2=\"304\" stroke=\"#1d1f23\" stroke-width=\"3\"/><text x=\"400\" y=\"308\" font-size=\"11.5\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Дом 5 кВт, днём: 8,9 лет</text><line x1=\"70\" y1=\"322\" x2=\"94\" y2=\"322\" stroke=\"#7d8089\" stroke-width=\"3\" stroke-dasharray=\"6 4\"/><text x=\"100\" y=\"326\" font-size=\"11.5\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">10 кВт + батарея 10 кВт·ч: 11,6 лет</text><line x1=\"370\" y1=\"322\" x2=\"394\" y2=\"322\" stroke=\"#9a9ca3\" stroke-width=\"3\" stroke-dasharray=\"2 3\"/><text x=\"400\" y=\"326\" font-size=\"11.5\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Кровля + забор + батарея: 15,0 лет</text><line x1=\"70\" y1=\"340\" x2=\"94\" y2=\"340\" stroke=\"#e3000f\" stroke-width=\"3\"/><text x=\"100\" y=\"344\" font-size=\"11.5\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\">Хозяйство 30 кВт днём: 5,5 лет</text></svg><figcaption>Простая окупаемость в подписях. Замены инвертора (13-й год) и батареи учтены, тариф растёт на 6 % в год. Цены оборудования и тарифы задайте свои в калькуляторе.</figcaption></figure><figure class=\"e-fig\"><svg viewBox=\"0 0 760 262\" role=\"img\" aria-label=\"Типовые сутки лета и зимы для дома 10 кВтп с батареей 10 кВт·ч\" xmlns=\"http://www.w3.org/2000/svg\">