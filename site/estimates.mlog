// Страницы раздела «Расчёт смет». Файл создаётся скриптом tools/estimates/build.py, правьте текст там.

pattern EstHubTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=5\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет</div><h1>Расчёты, калькулятор и справочники в одном месте</h1><p class=\"e-lead\">Оцените стоимость работ, пересчитайте объёмы и подберите материалы: от отделки до инженерных сетей.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\" class=\"on\" aria-current=\"page\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/kalkulyator\">{{ t.est_tab_calc }}</a><a href=\"{{ p }}/raschet-smet/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\">{{ t.est_tab_elec }}</a></nav><section class=\"e-sec\"><h2>Выберите вид расчёта</h2><p class=\"e-lead2\">Каждый расчёт даёт работы, материалы и итог. Точную смету составим после осмотра объекта.</p><div class=\"e-cards\"><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Отделка помещений</h3><p>Стены, потолки, полы, откосы: площади, работы и материалы по каждому помещению.</p></div><a class=\"e-card hot\" href=\"{{ p }}/raschet-smet/elektrika\"><span class=\"e-tag ok\">Калькуляторы готовы</span><h3>Электрика</h3><p>Проводка, щиты, освещение, розетки: точки, длины кабеля, автоматы.</p></a><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Водоснабжение и канализация</h3><p>Трубы, фитинги, приборы, разводка по санузлам и стоякам.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Отопление</h3><p>Радиаторы, трубы, тёплые полы, узлы подключения.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Вентиляция и кондиционирование</h3><p>Воздуховоды, решётки, установки, трассы и подвесы.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Слаботочные сети</h3><p>Кабельные сети, видеонаблюдение, охранная и пожарная сигнализация.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Демонтаж и черновые работы</h3><p>Перегородки, стяжка, штукатурка, выравнивание.</p></div><div class=\"e-card\"><span class=\"e-tag\">Скоро</span><h3>Общая смета по объекту</h3><p>Собирает выбранные расчёты в одну смету с итогами по помещениям и разделам.</p></div></div></section><section class=\"e-sec\"><h2>Что ещё в разделе</h2><div class=\"e-mores\"><a class=\"e-more\" href=\"{{ p }}/raschet-smet/kalkulyator\"><small>01</small><h3>Калькулятор</h3><p>Плавающее окно поверх страницы: обычный, стройка, металл, бетон, формулы, плотность.</p><span class=\"e-cta\">Открыть калькулятор →</span></a><a class=\"e-more\" href=\"{{ p }}/raschet-smet/obyemy\"><small>02</small><h3>Объёмы работ</h3><p>По каким правилам считаются площади: что вычитается, что добавляется, какие коэффициенты.</p><span class=\"e-cta\">Читать справочник →</span></a><a class=\"e-more\" href=\"{{ p }}/raschet-smet/kachestvo\"><small>03</small><h3>Качество работ</h3><p>Как определяется класс отделки: простая, улучшенная или высококачественная, и что в него входит.</p><span class=\"e-cta\">Читать →</span></a><a class=\"e-more\" href=\"{{ p }}/raschet-smet/elektrika\"><small>04</small><h3>Электрика</h3><p>Подбор кабеля и автомата, потеря напряжения, ток короткого замыкания, заземление, освещение помещений.</p><span class=\"e-cta\">Открыть калькуляторы →</span></a></div></section>"
}

pattern EstVolTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=5\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет · Справочник</div><h1>Как определяются объёмы работ</h1><p class=\"e-lead\">Правила обмера для отделочных работ и полов: что вычитается, что добавляется и какие коэффициенты применяются. Правила изложены по сборникам норм НРР-2022 своими словами, все числа сохранены.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/kalkulyator\">{{ t.est_tab_calc }}</a><a href=\"{{ p }}/raschet-smet/obyemy\" class=\"on\" aria-current=\"page\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\">{{ t.est_tab_elec }}</a></nav><div class=\"e-ref\"><div class=\"sub\">Общие правила</div>
<details open><summary>Общие правила измерения</summary><div class=\"ans\"><p><span class=\"k\">Высота стены:</span> от чистого пола до потолка. У перегородки — до потолка или до верха самой перегородки.</p><p><span class=\"k\">Размер окна и двери:</span> «по наружному обводу коробки» значит: размер проёма вместе с коробкой, а не размер стекла или полотна. Если в проёме две коробки, берётся наружная.</p><p><span class=\"k\">Размеры помещения:</span> берутся между внутренними гранями стен или перегородок.</p><p><span class=\"k\">Деление по помещениям:</span> объём считается отдельно для каждого помещения в зависимости от вида отделки (простая, улучшенная, высококачественная). Если во всех помещениях квартиры, этажа или секции отделка одинаковая, можно считать их целиком.</p><p><span class=\"k\">Высота помещения:</span> нормы по облицовке, штукатурке, окраске и обоям рассчитаны на работу с инвентарных столиков, стремянок и приставных лестниц в помещениях высотой до 4 м. При окраске помещений выше 4 м к расходам применяются повышающие коэффициенты из раздела 3 технической части. Установка лепных изделий и остекление рассчитаны на высоту до 8 м.</p><p><span class=\"k\">Малые помещения:</span> штукатурные нормы рассчитаны на помещения с площадью пола более 5 м². В стекольных, обойных и облицовочных работах при площади пола менее 5 м² затраты труда по таблице 63-13 умножаются на 1,15.</p><div class=\"src\">Источник: Сборник 15, п. 1.2, 2.10, 2.25; Сборник 61, п. 1.4, 2.2; Сборник 63, п. 1.6; Сборник 55, п. 2.1; Сборник 56, п. 2.1</div></div></details>
<div class=\"sub\">Штукатурные работы</div>
<details><summary>Штукатурка внутренних стен</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> периметр помещения × высота стены.</p><p><span class=\"k\">Вычитаем:</span> окна и двери (по наружному обводу коробок) и площадь, занятую тянутыми наличниками.</p><p><span class=\"k\">Добавляем:</span> боковые стороны пилястр.</p><p><span class=\"k\">Откосы:</span> считаются отдельно, см. следующую карточку.</p><p><span class=\"k\">Ремонт штукатурки:</span> считается по площади фактически отремонтированных поверхностей. Для стен криволинейного очертания к затратам труда и работе машин применяется коэффициент 1,1.</p><div class=\"src\">Источник: Сборник 15, п. 2.11; Сборник 61, п. 2.1, 2.2, 2.10</div></div></details>
<details><summary>Откосы окон и дверей внутри здания</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> отдельно, по площади самих откосов. Площадь откосов не входит в площадь стен, её нужно добавить дополнительной строкой.</p><p><span class=\"k\">Уже учтено в норме:</span> боковые и верхние оконные заглушины и откосы ниш отопления входят в нормативы, отдельно их считать не нужно.</p><p><span class=\"k\">Считается отдельно:</span> нижние оконные заглушины, по их площади.</p><div class=\"src\">Источник: Сборник 15, п. 2.13, 2.14</div></div></details>
<details><summary>Штукатурка потолков</summary><div class=\"ans\"><p><span class=\"k\">Обычный потолок:</span> площадь между внутренними гранями стен или перегородок. Кессонный потолок с площадью по плану (горизонтальной проекции) до 12 м² считается так же.</p><p><span class=\"k\">Ребристые перекрытия и кессонные потолки больше 12 м²:</span> считаются по развёрнутой поверхности (по всем плоскостям рёбер и кессонов).</p><p><span class=\"k\">Как получить развёрнутую поверхность при ремонте:</span> площадь по плану умножается на коэффициент: 1,6 для ребристых перекрытий, 1,75 для кессонных потолков.</p><div class=\"src\">Источник: Сборник 15, п. 2.12; Сборник 61, п. 2.3</div></div></details>
<details><summary>Колонны, пилястры, лепные детали, мрамор</summary><div class=\"ans\"><p><span class=\"k\">Колонны и пилястры:</span> площадь развёрнутой поверхности, то есть всех видимых сторон. Это относится и к колоннам, примыкающим к стене, и к отдельно стоящим.</p><p><span class=\"k\">Лепные детали на оштукатуренной поверхности:</span> площадь под ними из площади штукатурки не вычитается.</p><p><span class=\"k\">Основание под искусственный мрамор:</span> в штукатурные работы не входит, оно считается как облицовка.</p><div class=\"src\">Источник: Сборник 15, п. 2.7, 2.9, 2.18; Сборник 61, п. 2.4, 2.5</div></div></details>
<details><summary>Карнизы, тяги, наличники, лестницы</summary><div class=\"ans\"><p><span class=\"k\">Штукатурка карнизов и тяг:</span> длина тяги × (вынос + высота). Внутри здания считается отдельно.</p><p><span class=\"k\">Внутренние тянутые наличники:</span> площадь, которую они занимают на стене (по проекции на стену).</p><p><span class=\"k\">Лестничные марши и площадки:</span> по площади горизонтальной проекции, отдельно для каждого этажа.</p><div class=\"src\">Источник: Сборник 15, п. 2.15–2.17; Сборник 61, п. 2.6, 2.7</div></div></details>
<details><summary>Штукатурка фасадов</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь стен за вычетом проёмов по наружному обводу коробок.</p><p><span class=\"k\">Улучшенная и высококачественная штукатурка:</span> карнизы, пояски, наличники, другие тянутые детали, а также примыкающие к зданию колонны и пилястры в площадь стен не входят и считаются отдельно. Тянутые детали считаются по площади, которую они занимают на фасаде (по проекции на стену). Если карниз имеет вынос больше своей высоты, он считается по площади горизонтальной проекции.</p><p><span class=\"k\">Откосы, отливы и боковые поверхности выступающих или заглублённых деталей:</span> считаются отдельно в двух группах: шириной до 200 мм и шириной более 200 мм.</p><div class=\"src\">Источник: Сборник 15, п. 2.5, 2.6, 2.8; Сборник 61, п. 2.8, 2.9</div></div></details>
<div class=\"sub\">Облицовочные работы</div>
<details><summary>Облицовка природным камнем</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> по площади облицованной поверхности. Размеры стен и колонн берутся с учётом изломов в плане по наружному обводу, то есть по сечению вместе с плитами.</p><p><span class=\"k\">Профилированные камни и детали:</span> площадь без учёта рельефа, по проекции большей стороны.</p><p><span class=\"k\">Выносная тяга (карниз, наличник):</span> если вынос больше высоты, берётся размер тяги по большей стороне.</p><p><span class=\"k\">Ступени и подоконные доски:</span> длина считается вместе с концами плит, заделанными в кладку или штукатурку. Для подоконных досок учитывается заделка в стену и в четверть коробки.</p><div class=\"src\">Источник: Сборник 15, п. 2.1, 2.2; Сборник 56, п. 2.2; Сборник 63, п. 2.4</div></div></details>
<details><summary>Облицовка плитами, мрамором и керамической плиткой</summary><div class=\"ans\"><p><span class=\"k\">Искусственные плиты:</span> по площади облицовки, без учёта рельефа.</p><p><span class=\"k\">Искусственный мрамор:</span> по развёрнутой поверхности облицовки.</p><p><span class=\"k\">Глазурованная керамическая плитка (ремонт):</span> по площади вертикальной проекции облицовываемой поверхности. Дверцы при облицовке ванн кирпичом из площади не вычитаются.</p><p><span class=\"k\">Облицовка откосов проёмов (деревянные стены):</span> по площади тех откосов, которые облицовываются.</p><div class=\"src\">Источник: Сборник 15, п. 2.3, 2.4; Сборник 63, п. 2.5, 2.6; Сборник 53, п. 2.9</div></div></details>
<div class=\"sub\">Малярные работы</div>
<details><summary>Окраска внутренних стен водными составами</summary><div class=\"ans\"><p>К водным составам этого правила относятся клеевые, казеиновые, известковые и силикатные краски. Водоэмульсионные, ПВА и акриловые краски считаются по правилу следующей карточки.</p><p><span class=\"k\">Как считаем:</span> площадь стен целиком, без вычета окон и дверей.</p><p><span class=\"k\">Не добавляем:</span> откосы окон и дверей и боковые поверхности ниш.</p><p><span class=\"k\">Добавляем:</span> площадь столбов и боковых сторон пилястр.</p><p><span class=\"k\">Исключение:</span> если проёмы занимают более 50 % площади отдельной стены, эта стена считается по фактически окрашиваемой поверхности: проёмы вычитаются, откосы окон и дверей и боковые поверхности ниш добавляются.</p><div class=\"src\">Источник: Сборник 15, п. 2.23 и таблица 4; Сборник 62, п. 2.3</div></div></details>
<details><summary>Окраска внутренних стен масляными, ПВА, акриловыми и водоэмульсионными составами</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> периметр × высота стены.</p><p><span class=\"k\">Вычитаем:</span> окна и двери (по наружному обводу коробок).</p><p><span class=\"k\">Добавляем:</span> столбы, пилястры, ниши, откосы окон и дверей.</p><div class=\"src\">Источник: Сборник 15, п. 2.24, 2.25; Сборник 62, п. 2.4</div></div></details>
<details><summary>Окраска потолков</summary><div class=\"ans\"><p><span class=\"k\">Обычный потолок:</span> площадь между внутренними гранями стен.</p><p><span class=\"k\">Ребристые перекрытия:</span> площадь по плану × 1,6.</p><p><span class=\"k\">Кессонные потолки:</span> площадь по плану × 1,75.</p><p><span class=\"k\">Потолки с лепниной:</span> площадь потолка × коэффициент по доле лепки. Доля лепки — это площадь изделий по плану в процентах от площади потолка:</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Доля лепки от площади потолка</th><th>до 2 %</th><th>2,1–10 %</th><th>10,1–40 %</th><th>40,1–70 %</th><th>более 70 %</th></tr></thead><tbody><tr><td>Коэффициент</td><td class=\"m\">1,0</td><td class=\"m\">1,1</td><td class=\"m\">1,5</td><td class=\"m\">2,1</td><td class=\"m\">2,8</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 15, п. 2.26, 2.27; Сборник 62, п. 2.5</div></div></details>
<details><summary>Окраска лепных изделий на стенах и фасадах</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь основания изделия × коэффициент по высоте рельефа и густоте рисунка.</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Высота рельефа</th><th>Редкий рисунок</th><th>Густой рисунок</th></tr></thead><tbody><tr><td>до 30 мм</td><td class=\"m\">1,5</td><td class=\"m\">3,0</td></tr><tr><td>более 30 мм</td><td class=\"m\">3,0</td><td class=\"m\">5,0</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 62, п. 2.11</div></div></details>
<details><summary>Окраска окон и дверей (заполнения проёмов)</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь проёма по наружному обводу коробки × коэффициент из таблицы. Коэффициент зависит от типа заполнения, материала стены и числа переплётов.</p><p>Колонки: «1» и «2» — число переплётов; «проолифленные» — часть площади, у которой детали поступили проолифленными.</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Заполнение</th><th>Стены</th><th>Состав</th><th>1 перепл.</th><th>2 перепл.</th><th>Пролиф. 1</th><th>Пролиф. 2</th></tr></thead><tbody><tr><td>Окно, раздельные переплёты, с подоконной доской</td><td>каменные</td><td>коробка, переплёт, подоконная доска</td><td class=\"m\">1,5</td><td class=\"m\">2,8</td><td class=\"m\">0,3</td><td class=\"m\">0,3</td></tr><tr><td>То же</td><td>деревянные</td><td>коробка, переплёт с наличниками с двух сторон, подоконная доска</td><td class=\"m\">2,2</td><td class=\"m\">3,5</td><td class=\"m\">0,6</td><td class=\"m\">0,6</td></tr><tr><td>Окно, раздельные, без подоконной доски</td><td>каменные</td><td>коробка, переплёт</td><td class=\"m\">1,2</td><td class=\"m\">2,5</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Окно, спаренные, с подоконной доской</td><td>каменные</td><td>коробка, переплёт, подоконная доска</td><td class=\"m\">-</td><td class=\"m\">2,5</td><td class=\"m\">-</td><td class=\"m\">0,3</td></tr><tr><td>Окно, спаренные, без подоконной доски</td><td>каменные</td><td>коробка, переплёт</td><td class=\"m\">-</td><td class=\"m\">2,2</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Фрамуги</td><td>перегородки</td><td>переплёт, наличники с двух сторон</td><td class=\"m\">1,6</td><td class=\"m\">-</td><td class=\"m\">0,7</td><td class=\"m\">-</td></tr><tr><td>Витрина деревянная</td><td>каменные</td><td>коробка, переплёт</td><td class=\"m\">1,75</td><td class=\"m\">3,5</td><td class=\"m\">0,45</td><td class=\"m\">0,9</td></tr><tr><td>Окно промзданий до 4 м², раздельные</td><td>каменные</td><td>коробка, переплёт, раскладки, монтажные подоконные доски</td><td class=\"m\">2,1</td><td class=\"m\">3,2</td><td class=\"m\">0,3</td><td class=\"m\">0,3</td></tr><tr><td>То же, более 4 м²</td><td>каменные</td><td>то же</td><td class=\"m\">1,7</td><td class=\"m\">2,6</td><td class=\"m\">0,2</td><td class=\"m\">0,2</td></tr><tr><td>Балконная дверь, раздельные полотна</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">2,1</td><td class=\"m\">3,5</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Балконная дверь, спаренные полотна</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">-</td><td class=\"m\">2,6</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Дверь глухая</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">2,4</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Дверь глухая</td><td>деревянные</td><td>коробка, полотна, наличники с двух сторон</td><td class=\"m\">2,7</td><td class=\"m\">-</td><td class=\"m\">0,3</td><td class=\"m\">-</td></tr><tr><td>Дверь глухая</td><td>перегородки</td><td>коробка, полотна, наличники с двух сторон</td><td class=\"m\">2,7</td><td class=\"m\">-</td><td class=\"m\">0,3</td><td class=\"m\">-</td></tr><tr><td>Дверь остеклённая</td><td>каменные</td><td>коробка, полотна</td><td class=\"m\">1,8</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Дверь остеклённая</td><td>перегородки</td><td>коробка, полотна, наличники с двух сторон</td><td class=\"m\">2,1</td><td class=\"m\">-</td><td class=\"m\">0,3</td><td class=\"m\">-</td></tr><tr><td>Шкафная дверь</td><td>перегородки</td><td>коробка, полотна, наличники с одной стороны</td><td class=\"m\">2,7</td><td class=\"m\">-</td><td class=\"m\">0,2</td><td class=\"m\">-</td></tr><tr><td>Открытый проём</td><td>перегородки</td><td>коробка, наличники с двух сторон</td><td class=\"m\">0,9</td><td class=\"m\">-</td><td class=\"m\">0,4</td><td class=\"m\">-</td></tr></tbody></table></div><ul><li>Фрамуги в наружных стенах считаются как окна соответствующего типа.</li><li>Для дверей в каменных стенах (глухих и остеклённых) коэффициенты даны без наличников. Если наличники есть с одной стороны проёма, коэффициент увеличивается на 0,2.</li><li>Для дверей в перегородках толщиной 140–160 мм с коробками на всю ширину перегородки коэффициент увеличивается на 0,2.</li><li>Окна и балконные двери с тройным остеклением: берутся данные для спаренных переплётов, результат умножается на 1,5.</li><li>В Сборнике 62 (ремонт) таблица почти такая же, но отличается в трёх местах. Деревянные окна с подоконной доской: проолифленные детали при двух переплётах 0,6 и 0,5. Дверь глухая в перегородке: наличники не указаны. Открытый проём: наличники с одной стороны.</li><li>Только рельефные наличники (Сборник 62): площадь по проекции × 1,15.</li><li>Окна со стороны фасада (Сборник 62): раздельные переплёты — коэффициент 0,35 к данным окна «без подоконной доски», спаренные — 0,2 к данным фрамуги. К данным дверей (балконных, а также глухих и остеклённых в каменных стенах) со стороны фасада применяется множитель 0,4.</li></ul><div class=\"src\">Источник: Сборник 15, п. 2.29, таблица 3</div></div></details>
<details><summary>Окраска отдельных элементов окон и дверей (нетиповые заполнения)</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь проёма (м²) × коэффициент элемента. Коэффициент зависит от размера проёма.</p><p class=\"k\">Окна (деревянные)</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Элемент</th><th>до 1,0 м²</th><th>до 2,25 м²</th><th>более 2,25 м²</th></tr></thead><tbody><tr><td>Одинарная коробка</td><td class=\"m\">0,6</td><td class=\"m\">0,45</td><td class=\"m\">0,3</td></tr><tr><td>Двухсторонняя коробка</td><td class=\"m\">1,4</td><td class=\"m\">1,0</td><td class=\"m\">0,8</td></tr><tr><td>Подоконная доска</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td><td class=\"m\">0,2</td></tr><tr><td>Переплёт в 1–2 стекла</td><td class=\"m\">1,0</td><td class=\"m\">0,8</td><td class=\"m\">0,6</td></tr><tr><td>Переплёт в 3–5 стёкол</td><td class=\"m\">1,5</td><td class=\"m\">1,1</td><td class=\"m\">0,8</td></tr><tr><td>Переплёт в 6–11 стёкол</td><td class=\"m\">1,6</td><td class=\"m\">1,2</td><td class=\"m\">0,8</td></tr><tr><td>Переплёт в 12 и более стёкол</td><td class=\"m\">1,8</td><td class=\"m\">1,3</td><td class=\"m\">0,9</td></tr></tbody></table></div><p class=\"k\">Двери (деревянные), площадь проёма</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Элемент</th><th>Однопольная до 1</th><th>до 1,5</th><th>более 1,5</th><th>Двупольная до 2,5</th><th>до 3,5</th><th>более 3,5</th></tr></thead><tbody><tr><td>Коробка шириной 160–200 мм</td><td class=\"m\">0,8</td><td class=\"m\">0,7</td><td class=\"m\">0,6</td><td class=\"m\">0,4</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td></tr><tr><td>Наличники к коробке с двух сторон</td><td class=\"m\">1,0</td><td class=\"m\">0,9</td><td class=\"m\">0,8</td><td class=\"m\">0,6</td><td class=\"m\">0,5</td><td class=\"m\">0,4</td></tr><tr><td>Полотно полусветлое, остекление до 0,5 м²</td><td class=\"m\">-</td><td class=\"m\">2,1</td><td class=\"m\">1,9</td><td class=\"m\">-</td><td class=\"m\">2,1</td><td class=\"m\">1,9</td></tr><tr><td>Полотно полусветлое, остекление до 1,0 м²</td><td class=\"m\">-</td><td class=\"m\">1,3</td><td class=\"m\">1,5</td><td class=\"m\">-</td><td class=\"m\">1,3</td><td class=\"m\">1,5</td></tr><tr><td>Полотно полусветлое, остекление более 1,0 м²</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">1,2</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">1,2</td></tr><tr><td>Полотно филенчатое</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,2</td><td class=\"m\">2,1</td></tr><tr><td>Полотно гладкое</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td><td class=\"m\">1,9</td></tr></tbody></table></div><p class=\"k\">Витрины (деревянные)</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Элемент</th><th>до 4 м²</th><th>до 10 м²</th><th>более 10 м²</th></tr></thead><tbody><tr><td>Коробка</td><td class=\"m\">0,4</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td></tr><tr><td>Переплёт в 1 стекло</td><td class=\"m\">0,4</td><td class=\"m\">0,3</td><td class=\"m\">0,3</td></tr><tr><td>Два переплёта в 1 стекло и 2 коробки</td><td class=\"m\">1,6</td><td class=\"m\">1,4</td><td class=\"m\">1,2</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 62, п. 2.6, таблицы 2-6.1, 2-6.2, 2-6.3</div></div></details>
<details><summary>Окраска полов и плинтусов</summary><div class=\"ans\"><p><span class=\"k\">Пол:</span> площадь пола без мест, занятых колоннами, печами, фундаментами и другими конструкциями, выступающими над полом.</p><p><span class=\"k\">Плинтус дощатого пола:</span> отдельно не считается, он уже входит в окраску пола.</p><p><span class=\"k\">Плинтус паркетного пола и пола из линолеума:</span> принимается как 10 % от площади пола. Расход определяется по нормам на улучшенную окраску дощатых полов.</p><div class=\"src\">Источник: Сборник 15, п. 1.20, 2.28; Сборник 62, п. 2.7</div></div></details>
<details><summary>Окраска фасадов</summary><div class=\"ans\"><p><span class=\"k\">Известковые, силикатные составы (в ремонте также цементные и казеиновые):</span> площадь стен с учётом изломов в плане, без вычета проёмов. Площади откосов, карнизов, тяг и других архитектурных деталей не учитываются.</p><p><span class=\"k\">Перхлорвиниловые, кремнийорганические, поливинилацетатные составы (в Сборнике 15 также акриловые):</span> площадь фактически окрашиваемой поверхности.</p><p><span class=\"k\">Фасадные работы по таблице 15-260:</span> площадь проёмов принята равной 30 % от площади фасада.</p><p><span class=\"k\">Водосточные трубы, пояски, сандрики, наружные подоконники:</span> по Сборнику 15: по площади фасада без вычета проёмов. По Сборнику 62 (ремонт): по площади фактически окрашиваемой поверхности.</p><p><span class=\"k\">Водосточные трубы диаметром 100–220 мм:</span> поверхность 100 м труб, включая ухваты, стыки и фальцы, принимается равной 3,5 м² на каждые 10 мм диаметра трубы. Воронка (с обеих сторон) считается как 1 м трубы того же диаметра.</p><div class=\"src\">Источник: Сборник 15, п. 2.21, 2.22, 2.32, 2.37; Сборник 62, п. 2.1, 2.2, 2.13</div></div></details>
<details><summary>Окраска древесины, вагонки, волнистых и рельефных поверхностей</summary><div class=\"ans\"><p><span class=\"k\">Вагонка:</span> площадь измеряется без огибания калёвок и отборок. Для учёта рельефа: по Сборнику 15 результат умножается на 1,1, по Сборнику 62 (ремонт) увеличивается на 20 %.</p><p><span class=\"k\">Бревенчатые стены:</span> обмер без огибания брёвен, результат увеличивается на 5 %, окна и двери вычитаются. Если есть обделки (карнизы, пилястры, откосы, наличники), проёмы не вычитаются и площадь обделок не прибавляется.</p><p><span class=\"k\">Волнистые асбоцементные листы и сталь:</span> площадь без учёта волны, результат × 1,2.</p><p><span class=\"k\">Рельефные стены (шагрень, шуба, линкруст и подобные):</span> объём работ увеличивается на 5 %.</p><p><span class=\"k\">Своды полуциркульные и эллиптические:</span> по развёрнутой поверхности.</p><p><span class=\"k\">Деревянные фермы:</span> площадь вертикальной проекции (с одной стороны), промежутки между элементами не вычитаются.</p><p><span class=\"k\">Металлическая кровля:</span> площадь кровли, без отдельного учёта фальцев, желобов, зонтов на дымовых трубах и покрытий слуховых окон.</p><div class=\"src\">Источник: Сборник 15, п. 2.30, 2.31, 2.33, 2.34; Сборник 62, п. 2.8–2.10, 2.12, 2.16</div></div></details>
<details><summary>Окраска решёток, сеток, мебели, труб и приборов</summary><div class=\"ans\"><p><span class=\"k\">Стальные решётки:</span> площадь вертикальной проекции с одной стороны, промежутки не вычитаются, затем коэффициент: простые решётки без рельефа с заполнением до 20 % (парапетные, пожарные лестницы, сетки с рамкой) — 0,5; средней сложности с заполнением до 30 % (лестничные, балконные) — 1; сложные с рельефом и заполнением более 30 % (жалюзийные, радиаторные, художественные) — 2,5.</p><p><span class=\"k\">Проволочная сетка:</span> площадь по контуру с обвязкой × 0,4. Обрамление из уголка считается отдельно.</p><p><span class=\"k\">Мебель:</span> шкафы, буфеты, гардеробы — по фактическому замеру. Табурет: площадь сиденья × 3,5. Скамья: × 2,75. Стул: × 4. Стол: площадь крышки × 2,5.</p><p><span class=\"k\">Раковины, мойки:</span> удвоенная площадь горизонтальной проекции.</p><p><span class=\"k\">Ванны:</span> утроенная площадь горизонтальной проекции.</p><p><span class=\"k\">Смывной бачок:</span> 0,7 м² (с учётом кронштейнов).</p><p><span class=\"k\">Радиаторы отопления:</span> площадь поверхности нагрева, со всех сторон. На один элемент (секцию): М-14А 0,254; М-14ОАО 0,299; М-90 0,2; МС-140 0,238; РД-90С 0,203; Стандарт-90 0,2 м². Панельный радиатор типа РСГ-1-1-3 — 0,73 м².</p><p><span class=\"k\">Большие металлические поверхности:</span> считаются площади более 5 м² в одном месте.</p><p>Окраска 1 погонного метра труб, м²:</p><div class=\"e-scroll\"><table class=\"tb\"><thead><tr><th>Диаметр, мм</th><th>15</th><th>20</th><th>25</th><th>32</th><th>40</th><th>50</th><th>63</th><th>75</th><th>100</th><th>125</th><th>150</th></tr></thead><tbody><tr><td>Стальные</td><td class=\"m\">0,11</td><td class=\"m\">0,13</td><td class=\"m\">0,16</td><td class=\"m\">0,18</td><td class=\"m\">0,21</td><td class=\"m\">0,26</td><td class=\"m\">0,31</td><td class=\"m\">0,36</td><td class=\"m\">0,46</td><td class=\"m\">-</td><td class=\"m\">-</td></tr><tr><td>Чугунные</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">-</td><td class=\"m\">0,28</td><td class=\"m\">-</td><td class=\"m\">0,37</td><td class=\"m\">0,48</td><td class=\"m\">0,59</td><td class=\"m\">0,72</td></tr></tbody></table></div><div class=\"src\">Источник: Сборник 15, п. 2.35, 2.36; Сборник 62, п. 2.14, 2.15, 2.17–2.19</div></div></details>
<div class=\"sub\">Обойные и стекольные работы</div>
<details><summary>Оклейка обоями, обивка дверей, снятие старых обоев</summary><div class=\"ans\"><p><span class=\"k\">Оклейка стен:</span> площадь оклеиваемой поверхности. Окна и двери вычитаются, их площадь берётся по наружному обводу коробок.</p><p><span class=\"k\">Обивка дверей:</span> площадь фактически обиваемой поверхности.</p><p><span class=\"k\">Снятие старых обоев и линкруста:</span> площадь очищенной от обоев поверхности.</p><div class=\"src\">Источник: Сборник 15, п. 2.46, 2.47; Сборник 63, п. 2.2, 2.3</div></div></details>
<details><summary>Остекление</summary><div class=\"ans\"><p><span class=\"k\">Деревянные переплёты и балконные двери (жилые и общественные здания):</span> площадь проёма по наружному обводу коробок.</p><p><span class=\"k\">Двери (кроме балконных) и витрины:</span> по размеру стёкол.</p><p><span class=\"k\">Деревянная перегородка:</span> по наружному обводу её обвязки.</p><p><span class=\"k\">Стеновые и фонарные переплёты промзданий:</span> стальные: по наружному обводу обвязки. Деревянные в коробке: по наружному обводу коробки. Деревянные без коробки: по наружному обводу обвязки.</p><p><span class=\"k\">Стеновые панели из профильного стекла:</span> по наружному обводу стальных рам (проёмов в панелях нет).</p><p><span class=\"k\">Окно из профильного стекла:</span> по наружному обводу металлического обрамления или деревянной обвязки.</p><p><span class=\"k\">Зенитный фонарь из профильного стекла:</span> по внутреннему обводу низа его стакана (по световому проёму).</p><p><span class=\"k\">Перегородки из профильного стекла или стеклянных блоков:</span> по наружному обводу коробок за вычетом площади проёмов.</p><p><span class=\"k\">Остекление при ремонте:</span> по площади остекления, то есть по размеру стёкол.</p><div class=\"src\">Источник: Сборник 15, п. 2.38–2.45; Сборник 63, п. 2.1</div></div></details>
<div class=\"sub\">Полы</div>
<details><summary>Покрытие пола и подготовка под него</summary><div class=\"ans\"><p><span class=\"k\">Покрытие:</span> площадь между внутренними гранями стен или перегородок с учётом толщины отделки.</p><p><span class=\"k\">Добавляем:</span> покрытие в подоконных нишах и дверных проёмах.</p><p><span class=\"k\">Вычитаем:</span> перегородки, колонны, печи, выступающие фундаменты и другие подобные конструкции. При ремонте чистые перегородки не вычитаются.</p><p><span class=\"k\">Подстилающий слой (подготовка):</span> объём считается без мест, занятых печами, колоннами, выступающими фундаментами и подобными конструкциями.</p><p><span class=\"k\">Плитки ПВХ типа Colorex:</span> из площади покрытия вычитается площадь горизонтальной проекции устанавливаемого плинтуса.</p><p><span class=\"k\">Лаги:</span> разборка и смена — по площади пола.</p><div class=\"src\">Источник: Сборник 11, п. 2.1, 2.2, 2.4; Сборник 57, п. 2.1–2.3</div></div></details>
<div class=\"sub\">Перегородки, потолки, стены (ремонт)</div>
<details><summary>Перегородки</summary><div class=\"ans\"><p><span class=\"k\">Как считаем:</span> площадь ремонтируемых перегородок за вычетом проёмов (по наружному обводу коробок). Высота — от чистого пола до потолка или до верха перегородки.</p><p><span class=\"k\">Смена отдельных участков:</span> по площади сменяемых участков.</p><p><span class=\"k\">Заделка проёмов:</span> по площади проёма.</p><div class=\"src\">Источник: Сборник 55, п. 2.1–2.3</div></div></details>
<details><summary>Перекрытия и подшивка потолков</summary><div class=\"ans\"><p><span class=\"k\">Ремонтируемые перекрытия:</span> площадь в пределах капитальных стен, без вычета мест, занятых печами и трубами.</p><p><span class=\"k\">Частичная смена перекрытий:</span> площадь между осями балок и капитальными стенами.</p><p><span class=\"k\">Подшивка потолков (разборка, устройство):</span> по площади подшивки.</p><p><span class=\"k\">Смена подборов перекрытий:</span> расстояние между осями балок × длина сменяемого участка.</p><div class=\"src\">Источник: Сборник 54, п. 2.1–2.3</div></div></details>
<details><summary>Стены (кирпичная кладка и деревянные)</summary><div class=\"ans\"><p><span class=\"k\">Кирпичная кладка:</span> объём за вычетом проёмов (по наружному обводу коробок). Архитектурные детали (пилястры, полуколонны, карнизы, парапеты, эркеры, лоджии) включаются в объём. Мелкие детали высотой до 25 см (сандрики, пояски) уже учтены и отдельно не добавляются.</p><p><span class=\"k\">Ниши и борозды:</span> гнёзда и борозды для балок и плит, а также ниши для отопительных приборов, вентиляционных и дымовых каналов из объёма не вычитаются. Ниши для встроенного оборудования в объём не включаются.</p><p><span class=\"k\">Периметр деревянных стен:</span> наружных — по наружным размерам здания, внутренних — по размерам между внутренними гранями стен.</p><p><span class=\"k\">Высота деревянных стен:</span> рубленых и каркасных — от нижней грани нижнего венца (обвязки) до верхней грани верхнего венца (обвязки). Из готовых щитов — от нижней грани цокольной обвязки до верха чердачной балки.</p><p><span class=\"k\">Площадь стен:</span> за вычетом проёмов, которые измеряются по наружным размерам коробок.</p><div class=\"src\">Источник: Сборник 53, п. 2.1–2.7</div></div></details>
<details><summary>Окна, двери, подоконные доски</summary><div class=\"ans\"><p><span class=\"k\">Окна и двери:</span> площадь проёма по наружному обводу коробок.</p><p><span class=\"k\">Подоконные доски:</span> площадь с учётом заделки в стену и в четверть коробки.</p><div class=\"src\">Источник: Сборник 56, п. 2.1, 2.2</div></div></details>
<div class=\"sub\">Лепные работы и леса</div>
<details><summary>Лепные работы</summary><div class=\"ans\"><p><span class=\"k\">Объём:</span> принимается по проекту и по перечню изделий в сборнике.</p><p><span class=\"k\">Высота выпуклых погонных деталей:</span> по огибу поперечного сечения.</p><p><span class=\"k\">Галтели и карнизы (нормативы Е15-109-6 … Е15-109-10):</span> длина устраиваемого карниза без декоративных стыковочных элементов (в том числе угловых), результат × 1,05.</p><p><span class=\"k\">Базы и капители на пилястры и полуколонны:</span> как на колонны, с коэффициентом 0,5.</p><p><span class=\"k\">Угловые базы (четверть окружности или четырёхугольник):</span> по таблицам баз на пилястрах с коэффициентом 0,5.</p><div class=\"src\">Источник: Сборник 15, п. 1.11, 2.19, 2.20; Сборник 64, п. 2.1, 2.2</div></div></details>
<details><summary>Леса и подмости</summary><div class=\"ans\"><p><span class=\"k\">Наружные леса:</span> по площади их вертикальной проекции на фасад.</p><p><span class=\"k\">Внутренние леса со сплошным настилом:</span> по площади горизонтальной проекции на основание (для штукатурки потолков и стен — по горизонтальной проекции потолков).</p><p><span class=\"k\">Внутренние леса только вдоль стен:</span> по площади вертикальной проекции на стены. Расчёт ведётся по нормам на устройство наружных лесов для отделочных работ (таблица 69-20, норма 2).</p><p><span class=\"k\">Фасады при штукатурке:</span> по вертикальной проекции стен без вычета проёмов.</p><div class=\"src\">Источник: Сборник 69, п. 2.1; Сборник 61, п. 2.11</div></div></details></div><p class=\"e-note\">Справочник носит информационный характер. Перед использованием в договорной смете числа проверяет технический специалист по действующим нормам.</p>"
}

pattern EstQualTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=5\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет · Справочник</div><h1>Как определяется качество работ</h1><p class=\"e-lead\">Качество отделки в сметных нормах определяется классом: простая, улучшенная или высококачественная. Класс задаёт, какие операции обязательны. Чем выше класс, тем больше слоёв и проходов, тем дороже и ровнее результат.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/kalkulyator\">{{ t.est_tab_calc }}</a><a href=\"{{ p }}/raschet-smet/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\" class=\"on\" aria-current=\"page\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\">{{ t.est_tab_elec }}</a></nav><section class=\"e-sec\"><h2>Три класса отделки</h2><div class=\"e-cards three\"><div class=\"e-card\"><span class=\"e-tag\">Простая</span><h3>9 операций из 19</h3><p>Очистка, расшивка трещин, подмазка и два слоя краски. Без сплошной шпатлёвки: неровности основания остаются заметными. Подходит для подсобных и технических помещений.</p></div><div class=\"e-card\"><span class=\"e-tag\">Улучшенная</span><h3>17 операций из 19</h3><p>К простой добавляются сплошная шпатлёвка, шлифовка, огрунтовка и флейцевание (разглаживание краски мягкой кистью). Поверхность ровная, следов кисти нет. Обычный выбор для квартир и офисов.</p></div><div class=\"e-card\"><span class=\"e-tag ok\">Высококачественная</span><h3>19 операций из 19</h3><p>Две сплошные шпатлёвки с двумя шлифовками. Максимально ровная и гладкая поверхность, нужна под глянец и боковой свет, а также в представительных помещениях.</p></div></div></section><section class=\"e-sec\"><h2>Что входит в каждый класс</h2><p class=\"e-lead2\">Пример: окраска водоэмульсионными составами по штукатурке. Перечень операций изложен по технической части сборника 15 норм НРР-2022 (таблица 7) своими словами; число операций сохранено.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Операция</th><th>Простая</th><th>Улучшенная</th><th>Высококачественная</th></tr></thead><tbody><tr><td>Очистка поверхности</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Сглаживание торцом дерева</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Расшивка трещин</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Проолифка</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Частичная подмазка с проолифкой подмазанных мест</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка подмазанных мест</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Первая сплошная шпатлёвка</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после первой шпатлёвки</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Вторая сплошная шпатлёвка</td><td class=\"m no\">нет</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после второй шпатлёвки</td><td class=\"m no\">нет</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td></tr><tr><td>Огрунтовка</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Флейцевание после грунтовки</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после грунтовки</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Первая окраска</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Флейцевание после первой окраски</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Шлифовка после первой окраски</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Вторая окраска</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Флейцевание или торцевание после второй окраски</td><td class=\"m no\">нет</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr><td>Вытягивание филёнок</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td><td class=\"m yes\">да</td></tr><tr class=\"tot\"><td>Итого операций</td><td class=\"m\">9</td><td class=\"m\">17</td><td class=\"m\">19</td></tr></tbody></table></div><p class=\"e-note\">Для масляных составов и других оснований (дерево, металл, сборные конструкции) набор операций отличается. Эти таблицы добавим после сверки.</p></section><section class=\"e-sec\"><h2>Карточки по видам работ</h2><p class=\"e-lead2\">Для каждого вида работ: допустимые отклонения, условия приёмки и схема. Числа взяты из белорусского СП 1.03.01-2019 «Отделочные работы», пункты указаны рядом. Каждую карточку можно скачать картинкой или документом с водяным знаком.</p><div class=\"e-sub q-chips\"><a href=\"#usloviya\">Условия производства отделки</a><a href=\"#shtukaturka-geometriya\">Штукатурка внутри здания: геометрия</a><a href=\"#shtukaturka-sloi\">Штукатурка: слои, армирование, сцепление</a><a href=\"#dekor-lepnina\">Декоративные покрытия и лепные изделия</a><a href=\"#oblitsovka-plitkoi\">Облицовка плиткой и камнем стен</a><a href=\"#listovye-potolki\">Листовые и панельные облицовки, подвесные потолки</a><a href=\"#okraska\">Окраска и малярные работы</a><a href=\"#oboi\">Оклейка обоями</a><a href=\"#steklo\">Стекольные работы</a><a href=\"#osnovanie-pola\">Основание под полы</a><a href=\"#styazhka\">Стяжка под покрытие</a><a href=\"#nalivnye-polimery\">Наливные и монолитные полы</a><a href=\"#parket-laminat\">Паркет, доска и ламинат</a><a href=\"#linoleum\">Линолеум и рулонные покрытия</a><a href=\"#plitka-pola\">Плиточные полы</a></div></section><div class=\"q-list\"><article class=\"q-card\" id=\"usloviya\"><header><h3>Условия производства отделки</h3><p>Что должно быть выполнено до начала работ и пока идут работы. Общие для штукатурки, окраски, плитки и обоев.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 3.3–3.19, 7.11</div></header><div class=\"q-facts\"><div><b>+10 °C</b><span>и выше: воздух и основание внутри здания</span></div><div><b>≤ 60 %</b><span>влажность воздуха внутри, без сквозняков</span></div><div><b>8 % / 12 %</b><span>предельная влажность основания: бетон, камень, штукатурка / дерево</span></div><div><b>2 + 12 сут</b><span>держать +10 °C до начала и после окончания работ</span></div></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Внутри здания: температура воздуха и основания не ниже +10 °C, влажность воздуха не более 60 %, сквозняков нет (п. 3.14).</li><li>Температуру не ниже +10 °C держат круглосуточно: не менее 2 суток до начала, во время работ и не менее 12 суток после. Для обоев: до сдачи объекта (п. 3.14).</li><li>Снаружи: температура воздуха и основания не ниже +5 °C (п. 3.12).</li><li>Влажность основания под штукатурку, окраску, облицовку и обои: бетон, камень, оштукатуренные и прошпатлёванные поверхности не более 8 %, дерево не более 12 % (п. 3.17).</li><li>Сушить помещение можно калориферами. Открытые жаровни и печи-времянки запрещены (п. 3.15).</li><li>Нельзя красить и клеить обои по основанию с высолами, жировыми и битумными пятнами, наплывами раствора, ржавчиной и побелкой (п. 3.18).</li><li>Перед каждым слоем покрытия поверхность обеспыливают (п. 3.19).</li><li>Материалы поступают с документом о качестве изготовителя, сертификатом или декларацией соответствия (п. 3.4). Работы ведут по проекту производства работ и технологическим картам (п. 3.3).</li><li>Фасады не красят по наледи, в дождь и по сырой стене, при ветре сильнее 10 м/с (п. 7.11).</li></ul></div><p class=\"e-note\">Порядок и методы контроля задают СТБ 1472–1475 и СТБ 1483 (п. 3.9).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/usloviya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/usloviya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"shtukaturka-geometriya\"><header><h3>Штукатурка внутри здания: геометрия</h3><p>Допустимые отклонения оштукатуренных поверхностей для трёх видов штукатурки. Вид указывает проект (п. 4.2).</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 2, п. 4.2</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Простое</th><th class=\"n\">Улучшенное</th><th class=\"n\">Высококачественное</th></tr></thead><tbody><tr><td>Вертикальность на всю высоту помещения</td><td class=\"n m\">15</td><td class=\"n m\">10</td><td class=\"n m\">5</td></tr><tr><td>Вертикальность на 1 м высоты</td><td class=\"n m\">3</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>Горизонтальность на 1 м</td><td class=\"n m\">3</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>Неровности на участке 4 м²: число, не более (шт.)</td><td class=\"n m\">3</td><td class=\"n m\">2</td><td class=\"n m\">2</td></tr><tr><td>Неровности: глубина (высота), не более</td><td class=\"n m\">5</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>Откосы, пилястры, столбы, лузги: вертикальность на высоту</td><td class=\"n m\">10</td><td class=\"n m\">5</td><td class=\"n m\">3</td></tr><tr><td>Откосы, пилястры, столбы, лузги: на 1 м</td><td class=\"n m\">4</td><td class=\"n m\">2</td><td class=\"n m\">1</td></tr><tr><td>Криволинейные поверхности: отклонение от радиуса</td><td class=\"n m\">10</td><td class=\"n m\">7</td><td class=\"n m\">5</td></tr><tr><td>Откосы: отклонение ширины</td><td class=\"n m\">5</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr><tr><td>Тяги: прямолинейность между углами</td><td class=\"n m\">6</td><td class=\"n m\">3</td><td class=\"n m\">2</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 266\" role=\"img\" aria-label=\"Допуски по классам\" class=\"e-svg\"><rect x=\"190\" y=\"12\" width=\"12\" height=\"12\" fill=\"#c6c8cd\"/><text x=\"208\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Простое</text><rect x=\"281\" y=\"12\" width=\"12\" height=\"12\" fill=\"#6a6d75\"/><text x=\"299\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Улучшенное</text><rect x=\"393\" y=\"12\" width=\"12\" height=\"12\" fill=\"#1d1f23\"/><text x=\"411\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Высококачественное</text><text x=\"0\" y=\"58\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">На всю высоту</text><rect x=\"190\" y=\"34\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"44\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">15 мм</text><rect x=\"190\" y=\"49\" width=\"253.3\" height=\"11\" fill=\"#6a6d75\"/><text x=\"451.33333333333337\" y=\"59\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><rect x=\"190\" y=\"64\" width=\"126.7\" height=\"11\" fill=\"#1d1f23\"/><text x=\"324.6666666666667\" y=\"74\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"116\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">На 1 м высоты</text><rect x=\"190\" y=\"92\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"102\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"107\" width=\"253.3\" height=\"11\" fill=\"#6a6d75\"/><text x=\"451.33333333333337\" y=\"117\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><rect x=\"190\" y=\"122\" width=\"126.7\" height=\"11\" fill=\"#1d1f23\"/><text x=\"324.6666666666667\" y=\"132\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><text x=\"0\" y=\"174\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Глубина неровностей</text><rect x=\"190\" y=\"150\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"160\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><rect x=\"190\" y=\"165\" width=\"228.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"426.0\" y=\"175\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"180\" width=\"152.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"350.0\" y=\"190\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"232\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Откосы, столбы: на высоту</text><rect x=\"190\" y=\"208\" width=\"380.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"578.0\" y=\"218\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><rect x=\"190\" y=\"223\" width=\"190.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"388.0\" y=\"233\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><rect x=\"190\" y=\"238\" width=\"114.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"312.0\" y=\"248\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text></svg></div><div class=\"q-viz\"><svg viewBox=\"0 0 620 214\" role=\"img\" aria-label=\"Схема проверки ровности рейкой\" class=\"e-svg\"><g transform=\"translate(0,-68)\"><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170 L600 225 L20 225 Z\" fill=\"#f6f6f7\" opacity=\"0.7\"/><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\"/><rect x=\"50\" y=\"118\" width=\"520\" height=\"10\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"470\" y1=\"128\" x2=\"470\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"458\" y1=\"128\" x2=\"482\" y2=\"128\" stroke=\"#e3000f\" stroke-width=\"2\"/><line x1=\"458\" y1=\"170\" x2=\"482\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"494\" y=\"145\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">размер</text><text x=\"494\" y=\"163\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">неровности</text><text x=\"50\" y=\"108\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">рейка 2 м</text><text x=\"300\" y=\"196\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"middle\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">выпуклость</text><text x=\"24\" y=\"246\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">поверхность</text><text x=\"20\" y=\"272\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"500\" font-family=\"Onest, Arial, sans-serif\">Допуск глубины неровности: 5 мм (простое), 3 мм (улучшенное), 2 мм (высококачественное)</text></g></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Поверхность гладкая и однородная, без пузырей, включений и трещин. Допускаются только усадочные трещины шириной не более 0,2 мм (п. 4.8).</li><li>Отклонения не выходят за пределы строки таблицы для вида штукатурки из проекта (табл. 2).</li><li>Малярные и обойные работы начинают по основанию, соответствующему табл. 2 (п. 7.1, 8.1).</li></ul></div><p class=\"e-note\">Метод измерений (рейка, отвес, уровень) задают СТБ 1472–1475. Схема проверки ровности показана ниже.</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-geometriya.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-geometriya.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"shtukaturka-sloi\"><header><h3>Штукатурка: слои, армирование, сцепление</h3><p>Сколько слоёв и какой толщины, когда нужна сетка и какую прочность сцепления проверяют.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 1, п. 4.5–4.15</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Однослойное покрытие из гипсовых смесей, не более</td><td class=\"n m\">15</td></tr><tr><td>Однослойное покрытие из других смесей, не более</td><td class=\"n m\">20</td></tr><tr><td>Первый слой (обрызг) по камню и бетону</td><td class=\"n m\">5</td></tr><tr><td>Первый слой (обрызг) по дереву с дранкой</td><td class=\"n m\">9</td></tr><tr><td>Второй слой (грунт): известковый и известково-гипсовый</td><td class=\"n m\">7</td></tr><tr><td>Второй слой (грунт): цементный</td><td class=\"n m\">5</td></tr><tr><td>Третий слой: накрывочный</td><td class=\"n m\">2</td></tr><tr><td>Третий слой: декоративный накрывочный</td><td class=\"n m\">7</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 320\" role=\"img\" aria-label=\"Слои штукатурки\" class=\"e-svg\"><text x=\"0\" y=\"16\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Слои штукатурки по камню и бетону (масштаб 10:1)</text><rect x=\"10\" y=\"36\" width=\"150\" height=\"230\" fill=\"#f6f6f7\" stroke=\"#1d1f23\" stroke-width=\"2\"/><line x1=\"10\" y1=\"60\" x2=\"34\" y2=\"36\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"60\" x2=\"104\" y2=\"36\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"84\" x2=\"34\" y2=\"60\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"84\" x2=\"104\" y2=\"60\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"108\" x2=\"34\" y2=\"84\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"108\" x2=\"104\" y2=\"84\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"132\" x2=\"34\" y2=\"108\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"132\" x2=\"104\" y2=\"108\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"156\" x2=\"34\" y2=\"132\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"156\" x2=\"104\" y2=\"132\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"180\" x2=\"34\" y2=\"156\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"180\" x2=\"104\" y2=\"156\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"204\" x2=\"34\" y2=\"180\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"204\" x2=\"104\" y2=\"180\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"228\" x2=\"34\" y2=\"204\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"228\" x2=\"104\" y2=\"204\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"252\" x2=\"34\" y2=\"228\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"252\" x2=\"104\" y2=\"228\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"10\" y1=\"276\" x2=\"34\" y2=\"252\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><line x1=\"80\" y1=\"276\" x2=\"104\" y2=\"252\" stroke=\"#c6c8cd\" stroke-width=\"1\"/><text x=\"18\" y=\"286\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">основание</text><rect x=\"160\" y=\"36\" width=\"50\" height=\"230\" fill=\"#c6c8cd\"/><rect x=\"330\" y=\"46\" width=\"16\" height=\"16\" fill=\"#c6c8cd\"/><text x=\"356\" y=\"59\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">Обрызг</text><text x=\"356\" y=\"79\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">5 мм (по дереву с дранкой 9 мм)</text><rect x=\"210\" y=\"36\" width=\"70\" height=\"230\" fill=\"#6a6d75\"/><rect x=\"330\" y=\"108\" width=\"16\" height=\"16\" fill=\"#6a6d75\"/><text x=\"356\" y=\"121\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">Грунт</text><text x=\"356\" y=\"141\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">7 мм известковый, 5 мм цементный</text><rect x=\"280\" y=\"36\" width=\"20\" height=\"230\" fill=\"#e3000f\"/><rect x=\"330\" y=\"170\" width=\"16\" height=\"16\" fill=\"#e3000f\"/><text x=\"356\" y=\"183\" font-size=\"14\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">Накрывка</text><text x=\"356\" y=\"203\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">2 мм (декоративная 7 мм)</text><line x1=\"160\" y1=\"280\" x2=\"300\" y2=\"280\" stroke=\"#1d1f23\" stroke-width=\"2\"/><text x=\"330\" y=\"252\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">Три слоя вместе: 14 мм</text><text x=\"330\" y=\"272\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Однослойно: до 15 мм (гипс), до 20 мм (прочие)</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Прочность сцепления с основанием: внутри здания не менее 0,2 МПа, снаружи не менее 0,4 МПа, если проект не задаёт иное (п. 4.5).</li><li>Слой до 10 мм можно не армировать. От 10 до 15 мм: стеклянная штукатурная сетка. От 15 до 20 мм: стальная сетка. Больше 20 мм нельзя, кроме лёгких и теплоизоляционных штукатурок (п. 4.13).</li><li>Сетка лежит внутри слоя, не касается основания и не выходит на поверхность (п. 4.14).</li><li>Конструктивное армирование ставят в углах проёмов, под окнами, на выступающих углах, в стыках разных материалов (п. 4.15).</li><li>Нельзя нагревать штукатурку при высыхании выше +23 °C и сквозняком проветривать. При +23 °C и выше основание увлажняют (п. 4.6, 4.7).</li><li>Гипсовое основание штукатурят только гипсовыми смесями по огрунтованной поверхности (п. 4.17).</li></ul></div><p class=\"e-note\">Ячеистый бетон: трещины шире 0,2 мм, раковины глубиной 12 мм и больше и «зуб» выше 1,5 мм в основании недопустимы, первый слой не тоньше 10 мм, водоудерживающая способность смеси не менее 95 % (п. 4.10–4.12).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-sloi.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/shtukaturka-sloi.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"dekor-lepnina\"><header><h3>Декоративные покрытия и лепные изделия</h3><p>Гладкие декоративные покрытия выполняют по требованиям к штукатурке. Для лепных изделий есть свои допуски.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 4.18, 4.19, 5.1–5.4</div></header><div class=\"q-facts\"><div><b>1 мм</b><span>на 1 м длины: отклонение лепной детали от вертикали и горизонтали</span></div><div><b>10 мм</b><span>наибольшее смещение осей крупных деталей</span></div></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Декоративное покрытие сплошное, без пропусков, с прочным сцеплением с основанием (п. 5.2).</li><li>Толщину и число слоёв задают проект, технические документы и рекомендации изготовителя смеси (п. 5.3, 5.4).</li><li>Лепные изделия: стыки без перепадов, швы незаметны, нет раковин, изломов, трещин и наплывов, рельеф чёткий (п. 4.19).</li><li>Лепные изделия ставят после схватывания и высыхания штукатурки, крепят к арматуре, защищённой от коррозии (п. 4.18).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/dekor-lepnina.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/dekor-lepnina.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"oblitsovka-plitkoi\"><header><h3>Облицовка плиткой и камнем стен</h3><p>Допуски облицовки по виду поверхности и условия приёмки. Облицовку выполняют до устройства покрытия пола.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 3, п. 6.1–6.9</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Зеркальная, лощёная</th><th class=\"n\">Шлифованная и др.</th><th class=\"n\">Керамика</th></tr></thead><tbody><tr><td>Вертикальность на 1 м</td><td class=\"n m\">2</td><td class=\"n m\">3</td><td class=\"n m\">1,5</td></tr><tr><td>Вертикальность на этаж</td><td class=\"n m\">4</td><td class=\"n m\">8</td><td class=\"n m\">4</td></tr><tr><td>Положение швов от вертикали и горизонтали на 1 м</td><td class=\"n m\">1,5</td><td class=\"n m\">3</td><td class=\"n m\">1,5</td></tr><tr><td>Перепады на стыках</td><td class=\"n m\">1</td><td class=\"n m\">1</td><td class=\"n m\">1</td></tr><tr><td>Ровность на 1 м</td><td class=\"n m\">2</td><td class=\"n m\">4</td><td class=\"n m\">2</td></tr><tr><td>Ширина шва (плюс-минус)</td><td class=\"n m\">0,5</td><td class=\"n m\">1</td><td class=\"n m\">0,5</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 266\" role=\"img\" aria-label=\"Допуски облицовки\" class=\"e-svg\"><rect x=\"190\" y=\"12\" width=\"12\" height=\"12\" fill=\"#c6c8cd\"/><text x=\"208\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Зеркальная</text><rect x=\"302\" y=\"12\" width=\"12\" height=\"12\" fill=\"#6a6d75\"/><text x=\"320\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Шлифованная</text><rect x=\"421\" y=\"12\" width=\"12\" height=\"12\" fill=\"#1d1f23\"/><text x=\"439\" y=\"23\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Керамика</text><text x=\"0\" y=\"58\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Вертикальность на 1 м</text><rect x=\"190\" y=\"34\" width=\"253.3\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"451.33333333333337\" y=\"44\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><rect x=\"190\" y=\"49\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"59\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"64\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"74\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"116\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Положение швов на 1 м</text><rect x=\"190\" y=\"92\" width=\"190.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"388.0\" y=\"102\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><rect x=\"190\" y=\"107\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"117\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><rect x=\"190\" y=\"122\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"132\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"174\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Ровность на 1 м</text><rect x=\"190\" y=\"150\" width=\"190.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"388.0\" y=\"160\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><rect x=\"190\" y=\"165\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"175\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><rect x=\"190\" y=\"180\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"190\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"232\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Ширина шва, ±</text><rect x=\"190\" y=\"208\" width=\"190.0\" height=\"11\" fill=\"#c6c8cd\"/><text x=\"388.0\" y=\"218\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text><rect x=\"190\" y=\"223\" width=\"380.0\" height=\"11\" fill=\"#6a6d75\"/><text x=\"578.0\" y=\"233\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><rect x=\"190\" y=\"238\" width=\"190.0\" height=\"11\" fill=\"#1d1f23\"/><text x=\"388.0\" y=\"248\" font-size=\"11\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Прочность сцепления облицовки с основанием не менее 0,4 МПа (п. 6.2).</li><li>Клеевой слой на растворе 7–15 мм. Полимерминеральный клей: 2–3 мм для плитки до 100×100 мм, 3–4 мм для плитки свыше 100×100 до 300×300 мм; клей наносят ровно, без потёков (п. 6.3).</li><li>Поверхность ровная, без провесов в стыках, вибрации и отслоений (п. 6.7).</li><li>Плиты толще 10 мм крепят на растворе с дополнительными креплениями или на относе с вентилируемым зазором. Природный камень на растворе не толще 10 мм (п. 6.9).</li><li>Другие допуски табл. 3: гранит и искусственный камень, мрамор: ширина шва ±1,0; «скала»: вертикальность 3,0 на 1 м, швы 3,0, перепады 2,0, шов ±2,0.</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/oblitsovka-plitkoi.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/oblitsovka-plitkoi.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"listovye-potolki\"><header><h3>Листовые и панельные облицовки, подвесные потолки</h3><p>Гипсокартон, панели, рейки, подвесные потолки: допуски каркаса и поверхности.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 4, п. 6.6–6.8, 7.6</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Перепад между плитами, панелями, рейками, листами</td><td class=\"n m\">2</td></tr><tr><td>Вертикаль и горизонталь каркаса и облицовки на 1 м</td><td class=\"n m\">1,5</td></tr><tr><td>Вертикаль и горизонталь на всю длину</td><td class=\"n m\">7</td></tr><tr><td>Ровность (прямолинейность)</td><td class=\"n m\">1,5</td></tr><tr><td>Вертикальность стыков на 1 м</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Перепад между листами</text><rect x=\"220\" y=\"6\" width=\"97.1\" height=\"22\" fill=\"#1d1f23\"/><text x=\"325.1428571428571\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">На 1 м</text><rect x=\"220\" y=\"40\" width=\"72.9\" height=\"22\" fill=\"#1d1f23\"/><text x=\"300.8571428571429\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Ровность</text><rect x=\"220\" y=\"74\" width=\"72.9\" height=\"22\" fill=\"#1d1f23\"/><text x=\"300.8571428571429\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Стыки на 1 м</text><rect x=\"220\" y=\"108\" width=\"48.6\" height=\"22\" fill=\"#1d1f23\"/><text x=\"276.57142857142856\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">На всю длину</text><rect x=\"220\" y=\"142\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">7 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Шаг горизонтальных направляющих каркаса не более 450 мм (п. 6.6).</li><li>Металлический каркас защищён от коррозии, деревянный обработан антисептиком и огнезащитой (п. 6.8).</li><li>Швы гипсокартона проклеены, зашпатлёваны и зашлифованы заподлицо (п. 7.6).</li><li>Конструкции на относе и подвесные потолки выполняют по проектной конструкции (п. 6.6).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/listovye-potolki.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/listovye-potolki.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"okraska\"><header><h3>Окраска и малярные работы</h3><p>Основание готовят по допускам штукатурки. Вид покрытия (простое, улучшенное, высококачественное) указывает проект.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, табл. 5, п. 7.1–7.12 · Сборник 15 НРР-2022, табл. 7</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр <span class=\"u\">(мм)</span></th><th class=\"n\">Простое</th><th class=\"n\">Улучшенное</th><th class=\"n\">Высококачественное</th></tr></thead><tbody><tr><td>Искривление линий в местах сопряжения цветов на 1 м</td><td class=\"n m\">5</td><td class=\"n m\">2</td><td class=\"n m\">не допускается</td></tr><tr><td>Отклонение ширины бордюров, фризов, филёнок при разных колерах на 1 м</td><td class=\"n m\">1</td><td class=\"n m\">1</td><td class=\"n m\">1</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 152\" role=\"img\" aria-label=\"Число операций по классам\" class=\"e-svg\"><text x=\"0\" y=\"16\" font-size=\"12\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Число операций из 19 (водоэмульсионная окраска по штукатурке)</text><text x=\"0\" y=\"52\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Простое</text><rect x=\"190\" y=\"34\" width=\"171\" height=\"26\" fill=\"#c6c8cd\"/><text x=\"368.52631578947364\" y=\"53\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">9 из 19</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Улучшенное</text><rect x=\"190\" y=\"72\" width=\"322\" height=\"26\" fill=\"#6a6d75\"/><text x=\"520.1052631578948\" y=\"91\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">17 из 19</text><text x=\"0\" y=\"128\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Высококачественное</text><rect x=\"190\" y=\"110\" width=\"360\" height=\"26\" fill=\"#1d1f23\"/><text x=\"558.0\" y=\"129\" font-size=\"13\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">19 из 19</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Основание соответствует табл. 2 для вида покрытия (п. 7.1).</li><li>Деревянные поверхности строганые, без ворса и заусенцев, при необходимости зашлифованы (п. 7.4).</li><li>Трещины расшивают, грунтуют и заделывают шпатлёвкой на глубину не менее 2 мм (п. 7.6).</li><li>Грунтуют после шлифования каждого слоя шпатлёвки и перед первым слоем краски. Шлифуют после каждого слоя шпатлёвки (п. 7.7, 7.8).</li><li>Число слоёв шпатлёвки зависит от вида покрытия: больше слоёв у высококачественного (п. 7.8).</li><li>Фасады: см. условия производства (наледь, дождь, ветер сильнее 10 м/с).</li></ul></div><p class=\"e-note\">Состав операций: простое 9, улучшенное 17, высококачественное 19 из 19 (водоэмульсионная окраска по штукатурке).</p><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/okraska.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/okraska.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"oboi\"><header><h3>Оклейка обоями</h3><p>Допуски стыков и условия оклейки.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 8.1–8.5</div></header><div class=\"q-facts\"><div><b>2 мм</b><span>наибольшее отклонение стыков от вертикали на всю высоту помещения</span></div><div><b>4 мм</b><span>наибольший нахлёст полотен</span></div><div><b>0,5 мм</b><span>наибольший зазор при стыковке встык</span></div><div><b>≤ 23 °C</b><span>температура воздуха, пока обои сохнут</span></div></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Основание соответствует табл. 2 и требованиям п. 7.6 (п. 8.1).</li><li>До оклейки закончены скрытая электро- и слаботочная проводка (кроме розеток и выключателей), сантехника, окраска потолков и основные малярные работы (п. 8.2).</li><li>Полотна одного цвета и оттенка, кромки нахлёстов обращены к световым проёмам (п. 8.3).</li><li>Нет пузырей, пятен, пропусков, отслоений. Плинтусы, наличники, розетки и выключатели не заклеены (п. 8.3).</li><li>Пока обои сохнут, их защищают от сквозняков и прямого солнца, влажность поддерживают стабильной (п. 8.4).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/oboi.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/oboi.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"steklo\"><header><h3>Стекольные работы</h3><p>Листовое стекло, стеклопакеты и стеклоблоки.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 9.1–9.3</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Стеклоблоки: отклонение положения швов, не более</td><td class=\"n m\">3</td></tr><tr><td>Стеклоблоки: отклонение от вертикали на 1 м</td><td class=\"n m\">2</td></tr><tr><td>Стеклоблоки: отклонение от вертикали на всю высоту</td><td class=\"n m\">10</td></tr><tr><td>Стеклоблоки: видимая толщина шва на растворе</td><td class=\"n m\">8–10</td></tr><tr><td>Стеклоблоки: видимая толщина шва на клее, не более</td><td class=\"n m\">3</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Положение швов</text><rect x=\"220\" y=\"6\" width=\"102.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"330.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">3 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Вертикаль на 1 м</text><rect x=\"220\" y=\"40\" width=\"68.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"296.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Вертикаль на всю высоту</text><rect x=\"220\" y=\"74\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Стекло не дребезжит, замазка без трещин, штапики прилегают плотно (п. 9.1.2).</li><li>Нельзя ставить стекла со сколами более 10 мм и грязные, нельзя делать стыки стёкол в жилых и общественных зданиях (п. 9.1.3).</li><li>Стеклопакеты на площадке не дорабатывают. Трещины, сколы, отслоения клеевых швов и повреждённые рамки недопустимы (п. 9.3.1, 9.3.2).</li><li>Стеклопакет ставят на опорные и фиксирующие колодки, зазоры заполняют нетвердеющим герметиком (п. 9.3.3).</li><li>Стеклоблоки: два стержня диаметром 4–6 мм в швах на растворе или две стальные полосы 2×30–40 мм на клее. Крепление к стенам через каждые 3 ряда (блок 60 мм) или 5 рядов (блок 98 мм) (п. 9.2.2, 9.2.3).</li><li>Трещины, выколы, пробоины и загрязнения стеклоблоков недопустимы (п. 9.2.4).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/steklo.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/steklo.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"osnovanie-pola\"><header><h3>Основание под полы</h3><p>Грунт, подсыпка из песка и щебня и бетонный подстилающий слой.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.1–10.4</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Грунт: отклонение от ровности, не более</td><td class=\"n m\">20</td></tr><tr><td>Песок, щебень, гравий: ровность поверхности, не более</td><td class=\"n m\">15</td></tr><tr><td>Бетонный слой под бесшовные покрытия: ровность, не более</td><td class=\"n m\">4</td></tr><tr><td>Бетонный слой под оклеечную гидроизоляцию и мастики: ровность, не более</td><td class=\"n m\">5</td></tr><tr><td>Бетонный слой под прочие покрытия: ровность, не более</td><td class=\"n m\">10</td></tr><tr><td>Бетонный слой: толщина, не менее (жилые и общественные здания)</td><td class=\"n m\">80</td></tr><tr><td>Подсыпка: толщина, не менее (песок / щебень, гравий, шлак)</td><td class=\"n m\">60 / 80</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Грунт</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">20 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Песок, щебень</text><rect x=\"220\" y=\"40\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">15 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Бетон: прочие</text><rect x=\"220\" y=\"74\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">10 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Бетон: гидроизоляция</text><rect x=\"220\" y=\"108\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Бетон: бесшовные</text><rect x=\"220\" y=\"142\" width=\"68.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"296.0\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Класс бетона подстилающего слоя не ниже C8/10, толщина не меньше 80 мм в жилых и общественных зданиях и 100 мм в производственных (п. 10.3.1, 10.3.2).</li><li>Пылевидных и глинистых примесей в подсыпке не более 3 % по массе (п. 10.4.1).</li><li>Растительный грунт, ил, торф и насыпь с мусором под полы не годятся. Мёрзлый грунт в подсыпке недопустим (п. 10.2.3, 10.1.3).</li><li>Уклон и горизонтальность: 0,2 % от размера помещения, а для помещений 25 м и больше не более 50 мм (п. 10.1.8).</li><li>Толщина слоёв по проекту, превышение не более чем на 10 % (п. 10.1.9).</li><li>Полы устраивают после монтажа и испытаний инженерных систем, штукатурки, облицовки и окраски стен и потолков (п. 10.1.1, 3.21).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/osnovanie-pola.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/osnovanie-pola.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"styazhka\"><header><h3>Стяжка под покрытие</h3><p>Допуск на ровность зависит от того, какое покрытие будет сверху.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.5, 10.9.2, 10.1.6, 10.1.7</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Под линолеум, рулонные синтетические, паркет, ламинат, ПВХ-плитку, ПВА-покрытия</td><td class=\"n m\">2</td></tr><tr><td>Под керамическую плитку, бесшовные покрытия, «тёплые полы», плиты других видов</td><td class=\"n m\">4</td></tr><tr><td>Под прочие покрытия</td><td class=\"n m\">6</td></tr><tr><td>Толщина по бетонному основанию и плитам перекрытия, не менее</td><td class=\"n m\">20</td></tr><tr><td>Толщина по тепло- или звукоизоляции, не менее</td><td class=\"n m\">40</td></tr><tr><td>Зазор у стен, заполняется звукоизоляцией</td><td class=\"n m\">10–25</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Под линолеум, паркет, ламинат</text><rect x=\"220\" y=\"6\" width=\"113.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"341.3333333333333\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Под плитку, наливные, «тёплые полы»</text><rect x=\"220\" y=\"40\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Под прочие покрытия</text><rect x=\"220\" y=\"74\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">6 мм</text></svg></div><div class=\"q-viz\"><svg viewBox=\"0 0 620 214\" role=\"img\" aria-label=\"Схема проверки ровности рейкой\" class=\"e-svg\"><g transform=\"translate(0,-68)\"><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170 L600 225 L20 225 Z\" fill=\"#f6f6f7\" opacity=\"0.7\"/><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\"/><rect x=\"50\" y=\"118\" width=\"520\" height=\"10\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"470\" y1=\"128\" x2=\"470\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"458\" y1=\"128\" x2=\"482\" y2=\"128\" stroke=\"#e3000f\" stroke-width=\"2\"/><line x1=\"458\" y1=\"170\" x2=\"482\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"494\" y=\"145\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">размер</text><text x=\"494\" y=\"163\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">неровности</text><text x=\"50\" y=\"108\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">рейка 2 м</text><text x=\"300\" y=\"196\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"middle\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">выпуклость</text><text x=\"24\" y=\"246\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">поверхность</text><text x=\"20\" y=\"272\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"500\" font-family=\"Onest, Arial, sans-serif\">Допуск просвета под рейкой зависит от покрытия: 2, 4 или 6 мм</text></g></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Бетон стяжки не ниже B7,5, раствор не ниже M100 (п. 10.5.1).</li><li>Цементные слои выдерживают под постоянно влажным материалом не менее 7 суток (п. 10.1.6).</li><li>Ходить по раствору под штучные материалы можно после набора прочности 2,5 МПа, по монолитному покрытию после 5,0 МПа (п. 10.1.7).</li><li>Влажность основания под покрытия из древесины: не более 4 % для панелей перекрытий, 5 % для цементных и полимерцементных стяжек (п. 10.9.2).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/styazhka.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/styazhka.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"nalivnye-polimery\"><header><h3>Наливные и монолитные полы</h3><p>Бесшовные полимерные, самонивелирующиеся и монолитные покрытия.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.8, 10.12</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ровность: ПВА-покрытия</td><td class=\"n m\">2</td></tr><tr><td>Ровность: полиминеральные покрытия</td><td class=\"n m\">4</td></tr><tr><td>Ровность: асфальтобетон</td><td class=\"n m\">6</td></tr><tr><td>Ровность: цементно-бетонное монолитное покрытие</td><td class=\"n m\">4</td></tr><tr><td>Толщина наливного слоя, не менее</td><td class=\"n m\">3</td></tr><tr><td>Грунтовка, не тоньше</td><td class=\"n m\">0,1</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">ПВА-покрытия</text><rect x=\"220\" y=\"6\" width=\"113.3\" height=\"22\" fill=\"#1d1f23\"/><text x=\"341.3333333333333\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Полиминеральные</text><rect x=\"220\" y=\"40\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Цементно-бетонные</text><rect x=\"220\" y=\"74\" width=\"226.7\" height=\"22\" fill=\"#1d1f23\"/><text x=\"454.66666666666663\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">4 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Асфальтобетон</text><rect x=\"220\" y=\"108\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">6 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность основания 4–6 %. Укладка при температуре основания 5–25 °C и относительной влажности воздуха около 60 % (п. 10.12.4, 10.12.5).</li><li>Защищать слой от жары, прямого солнца и сквозняков (п. 10.12.7).</li><li>Покрытие сцеплено со всем основанием, без трещин, бугорков и наплывов (п. 10.12.9).</li><li>Монолитные покрытия: бетон не ниже C12/15, раствор не ниже M200, воду на месте укладки не добавляют (п. 10.8.2, 10.8.3).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/nalivnye-polimery.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/nalivnye-polimery.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"parket-laminat\"><header><h3>Паркет, доска и ламинат</h3><p>Влажность материалов, лаги, зазоры и допуски.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.9</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ровность покрытия, не более</td><td class=\"n m\">2</td></tr><tr><td>Зазор между досками, не более</td><td class=\"n m\">1</td></tr><tr><td>Зазор у паркетных досок, щитов и ДВП, не более</td><td class=\"n m\">0,5</td></tr><tr><td>Зазор у штучного паркета, не более</td><td class=\"n m\">0,3</td></tr><tr><td>Клеевой слой, не толще</td><td class=\"n m\">1</td></tr><tr><td>Зазор плинтуса до покрытия или стены, не более</td><td class=\"n m\">1</td></tr><tr><td>Зазор ламината у стен</td><td class=\"n m\">8–10</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 146\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Ровность</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Зазор между досками</text><rect x=\"220\" y=\"40\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Паркетные доски, щиты</text><rect x=\"220\" y=\"74\" width=\"85.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"313.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Штучный паркет</text><rect x=\"220\" y=\"108\" width=\"51.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"279.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность материалов: лаги и прокладки не более 18 %, доски покрытия 12 ± 3 %, штучный паркет, паркетные щиты и ДВП 10 %, ДСП 12 % (п. 10.9.1).</li><li>Шаг лаг 0,4–0,5 м на плитах и балках. Зазор между лагами и стенами 20–30 мм, стыки лаг вразбежку не менее 0,5 м (п. 10.9.6, 10.9.8).</li><li>Паркетная планка приклеена не менее чем на 80 % площади, ДВП не менее чем на 40 % (п. 10.9.14).</li><li>Уступы между элементами недопустимы (п. 10.9.16).</li><li>Ламинат лежит без сцепления с основанием на подложке. Компенсационные швы нужны, если длина или ширина больше 8 м (п. 10.9.19–10.9.21).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/parket-laminat.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/parket-laminat.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"linoleum\"><header><h3>Линолеум и рулонные покрытия</h3><p>Основание, клей, швы и допуски.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.10</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ровность основания, не более</td><td class=\"n m\">2</td></tr><tr><td>Зазор у стен, не более</td><td class=\"n m\">5</td></tr><tr><td>Уступы и зазоры в стыках, не более</td><td class=\"n m\">0,3</td></tr><tr><td>Наплыв сварного шва по высоте, не более</td><td class=\"n m\">0,5</td></tr><tr><td>Клеевой слой, не толще</td><td class=\"n m\">0,8</td></tr><tr><td>Грунт, не тоньше</td><td class=\"n m\">0,3</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 180\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Зазор у стен</text><rect x=\"220\" y=\"6\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">5 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Ровность основания</text><rect x=\"220\" y=\"40\" width=\"136.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"364.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Клей</text><rect x=\"220\" y=\"74\" width=\"54.4\" height=\"22\" fill=\"#1d1f23\"/><text x=\"282.4\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,8 мм</text><text x=\"0\" y=\"124\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Наплыв шва</text><rect x=\"220\" y=\"108\" width=\"34.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"262.0\" y=\"124\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,5 мм</text><text x=\"0\" y=\"158\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Уступы, зазоры</text><rect x=\"220\" y=\"142\" width=\"20.4\" height=\"22\" fill=\"#1d1f23\"/><text x=\"248.4\" y=\"158\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">0,3 мм</text></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность основания не более 4–5 % (п. 10.10.1).</li><li>Рулоны выдерживают при температуре не ниже 15 °C, пока не исчезнет волнистость (п. 10.10.3).</li><li>Поперечных швов в зонах интенсивного движения нет. Продольных швов не больше двух на кухнях и в жилых комнатах, трёх в общественных зданиях (п. 10.10.11, 10.10.12).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/linoleum.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/linoleum.pdf\" download>Документ PDF</a></div></article><article class=\"q-card\" id=\"plitka-pola\"><header><h3>Плиточные полы</h3><p>Прослойка, швы, ровность.</p><div class=\"q-src\">Источник: СП 1.03.01-2019, п. 10.11</div></header><div class=\"e-scroll\"><table class=\"e-tbl q-tbl\"><thead><tr><th>Параметр</th><th class=\"n\">Значение, мм</th></tr></thead><tbody><tr><td>Ширина и прямолинейность швов (плюс-минус)</td><td class=\"n m\">1,5</td></tr><tr><td>Ровность покрытия, не более</td><td class=\"n m\">2</td></tr><tr><td>Уступ между плитками, не более</td><td class=\"n m\">1</td></tr><tr><td>Раствор прослойки, толщина</td><td class=\"n m\">10–15</td></tr></tbody></table></div><div class=\"q-viz\"><svg viewBox=\"0 0 640 112\" role=\"img\" aria-label=\"Допуски\" class=\"e-svg\"><text x=\"0\" y=\"22\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Швы, ±</text><rect x=\"220\" y=\"6\" width=\"255.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"483.0\" y=\"22\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1,5 мм</text><text x=\"0\" y=\"56\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Ровность</text><rect x=\"220\" y=\"40\" width=\"340.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"568.0\" y=\"56\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">2 мм</text><text x=\"0\" y=\"90\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">Уступ между плитками</text><rect x=\"220\" y=\"74\" width=\"170.0\" height=\"22\" fill=\"#1d1f23\"/><text x=\"398.0\" y=\"90\" font-size=\"12\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"500\" font-family=\"IBM Plex Mono, monospace\">1 мм</text></svg></div><div class=\"q-viz\"><svg viewBox=\"0 0 620 214\" role=\"img\" aria-label=\"Схема проверки ровности рейкой\" class=\"e-svg\"><g transform=\"translate(0,-68)\"><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170 L600 225 L20 225 Z\" fill=\"#f6f6f7\" opacity=\"0.7\"/><path d=\"M20 170 L220 170 C260 170 265 128 300 128 C335 128 340 170 380 170 L600 170\" fill=\"none\" stroke=\"#1d1f23\" stroke-width=\"4\"/><rect x=\"50\" y=\"118\" width=\"520\" height=\"10\" fill=\"#c6c8cd\" stroke=\"#1d1f23\" stroke-width=\"1.5\"/><line x1=\"470\" y1=\"128\" x2=\"470\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"3\"/><line x1=\"458\" y1=\"128\" x2=\"482\" y2=\"128\" stroke=\"#e3000f\" stroke-width=\"2\"/><line x1=\"458\" y1=\"170\" x2=\"482\" y2=\"170\" stroke=\"#e3000f\" stroke-width=\"2\"/><text x=\"494\" y=\"145\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">размер</text><text x=\"494\" y=\"163\" font-size=\"14\" fill=\"#e3000f\" text-anchor=\"start\" font-weight=\"600\" font-family=\"Onest, Arial, sans-serif\">неровности</text><text x=\"50\" y=\"108\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">рейка 2 м</text><text x=\"300\" y=\"196\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"middle\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">выпуклость</text><text x=\"24\" y=\"246\" font-size=\"13\" fill=\"#6a6d75\" text-anchor=\"start\" font-weight=\"400\" font-family=\"Onest, Arial, sans-serif\">поверхность</text><text x=\"20\" y=\"272\" font-size=\"13\" fill=\"#1d1f23\" text-anchor=\"start\" font-weight=\"500\" font-family=\"Onest, Arial, sans-serif\">Ровность плиточного покрытия: не более 2 мм</text></g></svg></div><div class=\"q-acc\"><h4>Условия приёмки и требования</h4><ul><li>Влажность основания не более 4 % для панелей перекрытий и 5 % для стяжек (п. 10.11.3).</li><li>Плитка приклеена всей поверхностью (п. 10.11.8).</li><li>Излишки раствора и клея из швов удаляют на глубину не менее половины толщины плитки (п. 10.11.5).</li><li>Прослойка из клея и мастик: по технической документации и инструкции изготовителя (п. 10.11.2).</li></ul></div><div class=\"q-dl\"><span>Скачать карточку:</span><a class=\"e-btn ghost sm\" href=\"/static/cards/plitka-pola.png\" download>Картинка PNG</a><a class=\"e-btn ghost sm\" href=\"/static/cards/plitka-pola.pdf\" download>Документ PDF</a></div></article></div><section class=\"e-sec\"><h2>Как проверяют на объекте</h2><div class=\"e-two\"><div class=\"e-card\"><h3>Входной контроль</h3><ul><li>Проверяют документы на материалы: сертификат или декларация соответствия, документ о качестве изготовителя (п. 3.4).</li><li>Проверяют основание: влажность, чистоту, ровность по таблице допусков (п. 3.17, 3.18, табл. 2).</li><li>Проверяют условия: температуру и влажность воздуха (п. 3.14).</li></ul></div><div class=\"e-card\"><h3>Приёмка</h3><ul><li>Сравнивают результат с таблицей допусков для вида отделки из проекта.</li><li>Осматривают поверхность: без пузырей, трещин, пятен, пропусков и следов кисти.</li><li>Измерения и порядок приёмки задают СТБ 1472–1475 и СТБ 1483 (п. 3.9). Недочёты фиксируют списком и устраняют в оговорённый срок.</li></ul></div></div><p class=\"e-note\">Все числа выше изложены по тексту СП 1.03.01-2019 и перед внесением в договор сверяются с официальной редакцией документа специалистом.</p></section>"
}

pattern EstElecTpl(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=5\"><div class=\"e-head\"><div class=\"e-eyebrow\">Расчёт смет · Электрика</div><h1>Электрические калькуляторы</h1><p class=\"e-lead\">Подбор кабеля и автомата, потеря напряжения, ток короткого замыкания, заземление, освещение помещений. Результат можно перенести в смету.</p></div>{{#if not_ru}}<p class=\"e-ruonly\">{{ t.est_ru_only }}</p>{{/if}}<nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/kalkulyator\">{{ t.est_tab_calc }}</a><a href=\"{{ p }}/raschet-smet/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\" class=\"on\" aria-current=\"page\">{{ t.est_tab_elec }}</a></nav><div class=\"e-sub\" role=\"tablist\" aria-label=\"Электрика\"><a href=\"#cable\" data-sub=\"cable\">Кабель и автомат</a><a href=\"#drop\" data-sub=\"drop\">Потеря напряжения</a><a href=\"#kz\" data-sub=\"kz\">Ток КЗ</a><a href=\"#ground\" data-sub=\"ground\">Заземление</a><a href=\"#light\" data-sub=\"light\">Освещение</a><a href=\"#ref\" data-sub=\"ref\">Справочник</a><a href=\"#guide\" data-sub=\"guide\">Как подобрать кабель</a></div><div class=\"e-elec\" id=\"e-elec\"><section class=\"e-panel\" id=\"cable\" data-panel=\"cable\"><div class=\"e-sech\"><small>01</small><h2>Ток, сечение кабеля и автомат</h2></div><p class=\"e-lead2\">Введите мощность и длину линии. Калькулятор найдёт ток, предложит автомат и сечение жилы и проверит потерю напряжения.</p><div class=\"e-calc\"><div class=\"e-form\"><fieldset class=\"e-seg\"><legend>Сеть</legend><label><input type=\"radio\" name=\"c-ph\" value=\"1\" checked><span>1 фаза</span></label><label><input type=\"radio\" name=\"c-ph\" value=\"3\"><span>3 фазы</span></label></fieldset><fieldset class=\"e-seg\"><legend>Материал жилы</legend><label><input type=\"radio\" name=\"c-mat\" value=\"cu\" checked><span>Медь</span></label><label><input type=\"radio\" name=\"c-mat\" value=\"al\"><span>Алюминий</span></label></fieldset><fieldset class=\"e-seg\"><legend>Прокладка</legend><label><input type=\"radio\" name=\"c-lay\" value=\"wall\" checked><span>По стене, скрытая</span></label><label><input type=\"radio\" name=\"c-lay\" value=\"pipe\"><span>В трубе, пучком</span></label></fieldset><div class=\"e-row\"><div class=\"e-f\"><label for=\"c-p\">Мощность</label><div class=\"e-in\"><input id=\"c-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3,5\"><span class=\"u\">кВт</span></div></div><div class=\"e-f\"><label for=\"c-u\">Напряжение</label><div class=\"e-in\"><input id=\"c-u\" inputmode=\"decimal\" autocomplete=\"off\" value=\"230\"><span class=\"u\">В</span></div></div><div class=\"e-f\"><label for=\"c-cos\">cos φ</label><div class=\"e-in\"><input id=\"c-cos\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,0\"></div></div><div class=\"e-f\"><label for=\"c-l\">Длина линии</label><div class=\"e-in\"><input id=\"c-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"30\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"c-k\">Одновременность</label><div class=\"e-in\"><input id=\"c-k\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,0\"></div></div><div class=\"e-f\"><label for=\"c-lim\">Допуск по потере</label><div class=\"e-in\"><input id=\"c-lim\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5\"><span class=\"u\">%</span></div></div><div class=\"e-f wide\"><label for=\"c-kind\">Линия</label><div class=\"e-in\"><select id=\"c-kind\"><option value=\"sock\" selected>Розетки и приборы (от 2,5 мм²)</option><option value=\"light\">Освещение (от 1,5 мм²)</option></select></div></div></div><div class=\"e-formula\">Ток нагрузки ≤ автомат ≤ допустимый ток кабеля<br>1 фаза: I = P ÷ (U · cos φ), потеря ΔU = 2 · I · L · ρ ÷ S<br>3 фазы: I = P ÷ (1,73 · U · cos φ), потеря ΔU = 1,73 · I · L · ρ · cos φ ÷ S</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Ток нагрузки</span><b id=\"c-r-i\">—</b></div><div class=\"kv\"><span>Автомат</span><b id=\"c-r-in\">—</b></div><div class=\"kv\"><span>Кабель</span><b id=\"c-r-s\">—</b></div><div class=\"kv\"><span>Допустимый ток кабеля</span><b id=\"c-r-iz\">—</b></div><div class=\"kv\"><span>Потеря напряжения</span><b id=\"c-r-du\">—</b></div><div class=\"verdict\" id=\"c-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"drop\" data-panel=\"drop\"><div class=\"e-sech\"><small>02</small><h2>Потеря напряжения на линии</h2></div><p class=\"e-lead2\">Показывает потерю напряжения для разных сечений и подсказывает наименьшее подходящее по току и по потере.</p><div class=\"e-calc\"><div class=\"e-form\"><fieldset class=\"e-seg\"><legend>Сеть</legend><label><input type=\"radio\" name=\"d-ph\" value=\"1\"><span>1 фаза</span></label><label><input type=\"radio\" name=\"d-ph\" value=\"3\" checked><span>3 фазы</span></label></fieldset><fieldset class=\"e-seg\"><legend>Материал жилы</legend><label><input type=\"radio\" name=\"d-mat\" value=\"cu\" checked><span>Медь</span></label><label><input type=\"radio\" name=\"d-mat\" value=\"al\"><span>Алюминий</span></label></fieldset><div class=\"e-row\"><div class=\"e-f\"><label for=\"d-p\">Мощность</label><div class=\"e-in\"><input id=\"d-p\" inputmode=\"decimal\" autocomplete=\"off\" value=\"12\"><span class=\"u\">кВт</span></div></div><div class=\"e-f\"><label for=\"d-u\">Напряжение</label><div class=\"e-in\"><input id=\"d-u\" inputmode=\"decimal\" autocomplete=\"off\" value=\"400\"><span class=\"u\">В</span></div></div><div class=\"e-f\"><label for=\"d-cos\">cos φ</label><div class=\"e-in\"><input id=\"d-cos\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,9\"></div></div><div class=\"e-f\"><label for=\"d-l\">Длина</label><div class=\"e-in\"><input id=\"d-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"60\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"d-lim\">Допуск</label><div class=\"e-in\"><input id=\"d-lim\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4\"><span class=\"u\">%</span></div></div></div><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Сечение, мм²</th><th>Доп. ток, А</th><th>Потеря, %</th><th>Вывод</th></tr></thead><tbody id=\"d-rows\"></tbody></table></div><div class=\"e-formula\">1 фаза: ΔU = 2 · I · L · ρ ÷ S<br>3 фазы: ΔU = 1,73 · I · L · ρ · cos φ ÷ S<br>Реактивным сопротивлением в домашней сети пренебрегаем</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Ток</span><b id=\"d-r-i\">—</b></div><div class=\"kv\"><span>Минимум по потере</span><b id=\"d-r-min\">—</b></div><div class=\"kv\"><span>Рекомендуем</span><b id=\"d-r-rec\">—</b></div><div class=\"kv\"><span>Потеря при рекомендуемом</span><b id=\"d-r-du\">—</b></div><div class=\"verdict\" id=\"d-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"kz\" data-panel=\"kz\"><div class=\"e-sech\"><small>03</small><h2>Ток короткого замыкания и срабатывание автомата</h2></div><p class=\"e-lead2\">Проверка, что при замыкании фазы на ноль автомат отключится быстро. Нужны длина и сечение линии и сопротивление питающей части.</p><div class=\"e-calc\"><div class=\"e-form\"><fieldset class=\"e-seg\"><legend>Материал жилы</legend><label><input type=\"radio\" name=\"k-mat\" value=\"cu\" checked><span>Медь</span></label><label><input type=\"radio\" name=\"k-mat\" value=\"al\"><span>Алюминий</span></label></fieldset><div class=\"e-row\"><div class=\"e-f\"><label for=\"k-u\">Напряжение фазы</label><div class=\"e-in\"><input id=\"k-u\" inputmode=\"decimal\" autocomplete=\"off\" value=\"230\"><span class=\"u\">В</span></div></div><div class=\"e-f\"><label for=\"k-s\">Сечение</label><div class=\"e-in\"><input id=\"k-s\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,5\"><span class=\"u\">мм²</span></div></div><div class=\"e-f\"><label for=\"k-l\">Длина</label><div class=\"e-in\"><input id=\"k-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"40\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"k-zs\">Сопротивление питания</label><div class=\"e-in\"><input id=\"k-zs\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,05\"><span class=\"u\">Ом</span></div></div><div class=\"e-f\"><label for=\"k-in\">Номинал автомата</label><div class=\"e-in\"><input id=\"k-in\" inputmode=\"decimal\" autocomplete=\"off\" value=\"16\"><span class=\"u\">А</span></div></div><div class=\"e-f\"><label for=\"k-type\">Тип расцепителя</label><div class=\"e-in\"><select id=\"k-type\"><option value=\"10:C\" selected>C (5–10 × Iном)</option><option value=\"5:B\">B (3–5 × Iном)</option><option value=\"20:D\">D (10–20 × Iном)</option></select></div></div></div><div class=\"e-formula\">Z петли = 2 · ρ · L ÷ S + Z питания<br>Iкз = U фазы ÷ Z петли<br>Порог мгновенного срабатывания берётся по верхней границе диапазона типа расцепителя</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Сопротивление петли</span><b id=\"k-r-z\">—</b></div><div class=\"kv\"><span>Ток КЗ</span><b id=\"k-r-ik\">—</b></div><div class=\"kv\"><span>Порог срабатывания</span><b id=\"k-r-th\">—</b></div><div class=\"kv\"><span>Запас</span><b id=\"k-r-m\">—</b></div><div class=\"verdict\" id=\"k-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"ground\" data-panel=\"ground\"><div class=\"e-sech\"><small>04</small><h2>Заземление: число стержней</h2></div><p class=\"e-lead2\">Подбор числа вертикальных заземлителей по сопротивлению грунта. Ориентировочный расчёт; на месте обязателен замер.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"g-rho\">Удельное сопротивление грунта</label><div class=\"e-in\"><input id=\"g-rho\" inputmode=\"decimal\" autocomplete=\"off\" value=\"100\"><span class=\"u\">Ом·м</span></div></div><div class=\"e-f\"><label for=\"g-l\">Длина стержня</label><div class=\"e-in\"><input id=\"g-l\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"g-d\">Диаметр</label><div class=\"e-in\"><input id=\"g-d\" inputmode=\"decimal\" autocomplete=\"off\" value=\"16\"><span class=\"u\">мм</span></div></div><div class=\"e-f\"><label for=\"g-t0\">Заглубление верха</label><div class=\"e-in\"><input id=\"g-t0\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,8\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"g-r\">Нужное сопротивление</label><div class=\"e-in\"><input id=\"g-r\" inputmode=\"decimal\" autocomplete=\"off\" value=\"10\"><span class=\"u\">Ом</span></div></div><div class=\"e-f\"><label for=\"g-eta\">Коэфф. использования</label><div class=\"e-in\"><input id=\"g-eta\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,7\"></div></div><div class=\"e-f\"><label for=\"g-a\">Шаг между стержнями</label><div class=\"e-in\"><input id=\"g-a\" inputmode=\"decimal\" autocomplete=\"off\" value=\"3\"><span class=\"u\">м</span></div></div></div><div class=\"e-formula\">R стержня = ρ ÷ (2π·l) · (ln(2l ÷ d) + ½ · ln((4t + l) ÷ (4t − l)))<br>n = R стержня ÷ (R нужное · η), t — глубина середины стержня</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Один стержень</span><b id=\"g-r-1\">—</b></div><div class=\"kv\"><span>Нужно стержней</span><b id=\"g-r-n\">—</b></div><div class=\"kv\"><span>Итого</span><b id=\"g-r-tot\">—</b></div><div class=\"kv\"><span>Полоса связи</span><b id=\"g-r-strip\">—</b></div><div class=\"verdict\" id=\"g-verdict\" role=\"status\"></div></div></div></div></section><section class=\"e-panel\" id=\"light\" data-panel=\"light\"><div class=\"e-sech\"><small>05</small><h2>Освещение помещения</h2></div><p class=\"e-lead2\">Выберите тип помещения и светильник. Калькулятор возьмёт норму освещённости, найдёт нужное число светильников и покажет, как расставить их на плане.</p><div class=\"e-calc\"><div class=\"e-form\"><div class=\"e-row\"><div class=\"e-f wide\"><label for=\"l-room\">Тип помещения</label><div class=\"e-in\"><select id=\"l-room\"><option value=\"150\">Жилая комната, спальня</option><option value=\"150\">Кухня, кухня-столовая</option><option value=\"200\">Детская</option><option value=\"300\">Кабинет</option><option value=\"75\">Гардеробная</option><option value=\"50\">Коридор, холл в квартире</option><option value=\"50\">Ванная, санузел</option><option value=\"30\">Кладовая</option><option value=\"20\">Лестница</option></select></div></div><div class=\"e-f\"><label for=\"l-e\">Норма</label><div class=\"e-in\"><input id=\"l-e\" inputmode=\"decimal\" autocomplete=\"off\" value=\"150\"><span class=\"u\">лк</span></div></div><div class=\"e-f\"><label for=\"l-a\">Длина</label><div class=\"e-in\"><input id=\"l-a\" inputmode=\"decimal\" autocomplete=\"off\" value=\"5,0\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"l-b\">Ширина</label><div class=\"e-in\"><input id=\"l-b\" inputmode=\"decimal\" autocomplete=\"off\" value=\"4,0\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"l-h\">Высота потолка</label><div class=\"e-in\"><input id=\"l-h\" inputmode=\"decimal\" autocomplete=\"off\" value=\"2,7\"><span class=\"u\">м</span></div></div><div class=\"e-f\"><label for=\"l-hp\">Высота плоскости</label><div class=\"e-in\"><input id=\"l-hp\" inputmode=\"decimal\" autocomplete=\"off\" value=\"0,0\"><span class=\"u\">м</span></div></div><div class=\"e-f wide\"><label for=\"l-fix\">Светильник</label><div class=\"e-in\"><select id=\"l-fix\"><option value=\"12:1500\">Потолочный LED, 12 Вт, 1 500 лм</option><option value=\"18:2000\">Потолочный LED, 18 Вт, 2 000 лм</option><option value=\"36:3600\">Панель LED 600×600, 36 Вт, 3 600 лм</option><option value=\"5:450\">Точечный LED, 5 Вт, 450 лм</option><option value=\"24:2800\">Подвесной LED, 24 Вт, 2 800 лм</option></select></div></div><div class=\"e-f wide\"><label for=\"l-ref\">Отражение потолок / стены / пол</label><div class=\"e-in\"><select id=\"l-ref\"><option value=\"1\" selected>70 / 50 / 30 %</option><option value=\"0.85\">50 / 30 / 10 %</option><option value=\"0.75\">30 / 30 / 10 %</option></select></div></div><div class=\"e-f\"><label for=\"l-kz\">Коэфф. запаса</label><div class=\"e-in\"><input id=\"l-kz\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,3\"></div></div><div class=\"e-f\"><label for=\"l-z\">Неравномерность</label><div class=\"e-in\"><input id=\"l-z\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1,1\"></div></div></div><div class=\"e-plan\"><b>План расстановки</b><svg id=\"l-svg\" viewBox=\"0 0 620 500\" role=\"img\" aria-label=\"План комнаты с расстановкой светильников\"></svg><p class=\"e-note\" id=\"l-plan-note\"></p></div><div class=\"e-rooms\"><b>Квартира целиком</b><p class=\"e-lead2\">Добавляйте помещения и получите список светильников для сметы и общую мощность освещения.</p><div class=\"e-scroll\"><table class=\"e-tbl\"><thead><tr><th>Помещение</th><th>Площадь, м²</th><th>Норма, лк</th><th>Светильников</th><th>Получится, лк</th><th>Мощность, Вт</th><th></th></tr></thead><tbody id=\"l-rooms\"></tbody></table></div><div class=\"e-actions\"><button class=\"e-btn\" id=\"l-add\" type=\"button\">Добавить это помещение</button><button class=\"e-btn ghost\" id=\"l-clear\" type=\"button\">Очистить список</button></div></div><div class=\"e-formula\">Индекс помещения i = A · B ÷ (h · (A + B))<br>N = E · S · Kз · Z ÷ (F · η)<br>E — норма, лк; S — площадь; Kз — запас; Z — неравномерность; F — поток светильника, лм; η — коэффициент использования</div></div><div class=\"e-res\"><div class=\"e-out\"><span class=\"ot\">Результат</span><div class=\"kv\"><span>Норма освещённости</span><b id=\"l-r-e\">—</b></div><div class=\"kv\"><span>Индекс помещения</span><b id=\"l-r-i\">—</b></div><div class=\"kv\"><span>Коэфф. использования</span><b id=\"l-r-eta\">—</b></div><div class=\"kv\"><span>Нужный поток</span><b id=\"l-r-f\">—</b></div><div class=\"kv\"><span>Светильников</span><b id=\"l-r-n\">—</b></div><div class=\"kv\"><span>Получится</span><b id=\"l-r-got\">—</b></div><div class=\"kv\"><span>Мощность</span><b id=\"l-r-w\">—</b></div><div class=\"verdict\" id=\"l-verdict\" role=\"status\"></div><button class=\"e-btn wide\" id=\"l-tocable\" type=\"button\">Передать мощность в «Кабель и автомат»</button></div></div></div></section><section class=\"e-panel\" id=\"ref\" data-panel=\"ref\"><div class=\"e-sech\"><small>06</small><h2>Справочник мощностей приборов</h2></div><p class=\"e-lead2\">Типичные диапазоны. Кнопка «В расчёт» переносит верхнее значение в калькулятор «Кабель и автомат». Точное значение смотрите на шильдике прибора.</p><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Прибор</th><th>Мощность, кВт</th><th></th></tr></thead><tbody><tr><td>Чайник</td><td class=\"m\">1,8–2,2</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.2\">В расчёт</button></td></tr><tr><td>Стиральная машина</td><td class=\"m\">2,0–2,5</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.5\">В расчёт</button></td></tr><tr><td>Посудомоечная машина</td><td class=\"m\">1,8–2,2</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.2\">В расчёт</button></td></tr><tr><td>Духовой шкаф</td><td class=\"m\">2,0–3,5</td><td><button class=\"e-link\" type=\"button\" data-kw=\"3.5\">В расчёт</button></td></tr><tr><td>Варочная панель</td><td class=\"m\">3,5–7,0</td><td><button class=\"e-link\" type=\"button\" data-kw=\"7.0\">В расчёт</button></td></tr><tr><td>Микроволновка</td><td class=\"m\">0,8–1,5</td><td><button class=\"e-link\" type=\"button\" data-kw=\"1.5\">В расчёт</button></td></tr><tr><td>Утюг</td><td class=\"m\">1,8–2,4</td><td><button class=\"e-link\" type=\"button\" data-kw=\"2.4\">В расчёт</button></td></tr><tr><td>Холодильник</td><td class=\"m\">0,15–0,4</td><td><button class=\"e-link\" type=\"button\" data-kw=\"0.4\">В расчёт</button></td></tr></tbody></table></div></section><section class=\"e-panel\" id=\"guide\" data-panel=\"guide\"><div class=\"e-sech\"><small>07</small><h2>Как подобрать кабель</h2></div><p class=\"e-lead2\">Шесть шагов от мощности приборов до марки кабеля. Все числа показаны на одном примере.</p><div class=\"e-step\"><div class=\"e-sech\"><small>01</small><h3>Узнайте ток нагрузки</h3></div><p>Сложите мощность приборов на линии. Чем она больше, тем толще кабель. Мощность переводят в ток по формуле. Для обычных нагревательных приборов коэффициент мощности принимают равным 1.</p><div class=\"e-formula\">Однофазная сеть 230 В:&nbsp; I = P ÷ (U × cosφ)<br>Трёхфазная сеть 400 В:&nbsp; I = P ÷ (1,73 × U × cosφ)<br>Пример: 3 500 Вт ÷ 230 В = 15,2 А</div></div><div class=\"e-step\"><div class=\"e-sech\"><small>02</small><h3>Учтите, что приборы работают не одновременно</h3></div><p>Чайник, плита и стиральная машина редко включены вместе на полную мощность. Для расчёта линии на несколько приборов берут коэффициент одновременности меньше единицы. Для одного мощного прибора он равен 1.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>03</small><h3>Выберите автомат</h3></div><p>Автомат защищает кабель от перегрева. Его номинальный ток должен быть не меньше тока нагрузки и не больше допустимого тока кабеля. В нашем примере ток 15,2 А, значит подходит автомат на 16 А.</p><div class=\"e-formula\">Ток нагрузки ≤ ток автомата ≤ допустимый ток кабеля<br>15,2 А ≤ 16 А ≤ 27 А</div></div><div class=\"e-step\"><div class=\"e-sech\"><small>04</small><h3>Подберите сечение по допустимому току</h3></div><p>Допустимый ток зависит от материала жилы, способа прокладки, температуры и числа кабелей в одном пучке. В пучке и в тёплом помещении допустимый ток снижают. Если сомневаетесь, берите ближайшее большее сечение.</p><div class=\"e-scroll narrow\"><table class=\"e-tbl\"><thead><tr><th>Сечение жилы, мм²</th><th>Допустимый ток, А</th><th>Автомат, А</th><th>Обычно для</th></tr></thead><tbody><tr><td class=\"m\">1,5</td><td class=\"m\">19</td><td class=\"m\">10</td><td>освещение</td></tr><tr><td class=\"m\">2,5</td><td class=\"m\">27</td><td class=\"m\">16</td><td>розетки</td></tr><tr><td class=\"m\">4</td><td class=\"m\">36</td><td class=\"m\">25</td><td>мощные приборы</td></tr><tr><td class=\"m\">6</td><td class=\"m\">46</td><td class=\"m\">32</td><td>плита, духовой шкаф</td></tr><tr><td class=\"m\">10</td><td class=\"m\">63</td><td class=\"m\">50</td><td>ввод в квартиру, щиты</td></tr></tbody></table></div><p class=\"e-note\">Медная жила, изоляция ПВХ, один кабель, открытая или скрытая прокладка по стене. Значения образца: точные берутся из норм и документации производителя кабеля.</p></div><div class=\"e-step\"><div class=\"e-sech\"><small>05</small><h3>Проверьте падение напряжения</h3></div><p>На длинной линии часть напряжения теряется в самом кабеле. Нужно, чтобы потери были небольшими: в расчётах обычно держат их в пределах 3–5 %, а точный предел задают нормы. Если потери больше, берут сечение крупнее.</p><div class=\"e-formula\">Потеря, В = 2 × I × L × ρ ÷ S&nbsp;&nbsp;(ρ меди 0,0175; алюминия 0,028)<br>Пример: 2 × 15,2 × 30 м × 0,0175 ÷ 2,5 мм² = 6,4 В = 2,8 % от 230 В</div></div><div class=\"e-step\"><div class=\"e-sech\"><small>06</small><h3>Подберите марку кабеля</h3></div><p>Для жилых и общественных зданий чаще используют кабели, которые не поддерживают горение и мало дымят при пожаре. Такие обозначают индексом нг(А)-LS, например ВВГнг(А)-LS. Для скрытой проводки в земле и на улице марку выбирают отдельно.</p></div><div class=\"e-basis\"><b>На чём основаны правила</b><p>Выбор сечения кабеля, защита и допустимые потери напряжения описаны в белорусских технических нормах для электроустановок (серия ТКП 339) и в международной серии IEC 60364, допустимые токи конкретной марки задаёт ГОСТ 31996 на силовые кабели и документация завода. Справочник даёт общий порядок и ориентиры. Проект электроснабжения выполняет проектировщик, а числа в таблице перед публикацией проверит технический специалист.</p></div></section></div><div class=\"e-basis\"><b>Важно знать</b><p>Калькуляторы дают ориентир для сметы и для разговора с электриком. Они не заменяют проект электроснабжения, который выполняет проектировщик по нормам ТКП 339 и серии IEC 60364. Допустимые токи, пороги срабатывания, нормы освещённости (гигиенический норматив, постановление Минздрава № 82 от 28.06.2012) и коэффициенты перед публикацией проверит технический специалист.</p></div><noscript><p class=\"e-note\">Для расчётов нужен JavaScript.</p></noscript><script src=\"/static/elec.js?v=1\"></script>"
}

pattern EstCalcTabs(_x: String) -> String {
  return "<link rel=\"stylesheet\" href=\"/static/est.css?v=5\"><nav class=\"e-tabs\" aria-label=\"{{ t.est_nav_aria }}\"><a href=\"{{ p }}/raschet-smet\">{{ t.est_tab_hub }}</a><a href=\"{{ p }}/raschet-smet/kalkulyator\" class=\"on\" aria-current=\"page\">{{ t.est_tab_calc }}</a><a href=\"{{ p }}/raschet-smet/obyemy\">{{ t.est_tab_vol }}</a><a href=\"{{ p }}/raschet-smet/kachestvo\">{{ t.est_tab_qual }}</a><a href=\"{{ p }}/raschet-smet/elektrika\">{{ t.est_tab_elec }}</a></nav>"
}

