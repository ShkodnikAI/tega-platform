  return "<section class=\"hero\"><div class=\"wrap\">
<div class=\"text\">
<p class=\"slogan\">{{ t.slogan }}</p>
<h1>{{ t.h1 }}</h1>
<p class=\"lead\">{{ t.lead }}</p>
