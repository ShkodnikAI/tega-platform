pattern Shell(lang: String, slug: String, title: String, inner: Bool, body: String) -> Html {
  return template_render(HeadTpl("") + body + FootTpl(""), {
    t: Dict(lang), lang: lang, title: title, inner: inner, p: Prefix(lang), logo: LogoFor(lang),
    home: Href(lang, "/"), self: Href(lang, slug),
    h_ru: Href("ru", slug), h_be: Href("be", slug), h_en: Href("en", slug),
    is_ru: lang == "ru", is_be: lang == "be", is_en: lang == "en"
  })
}

pattern HomePage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/", d.title_home, false, HomeTpl(""))
}

pattern ServicesPage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/uslugi", d.nav_services, true, ServicesTpl(""))
}

pattern PortfolioPage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/portfolio", d.nav_objects, true, PortfolioTpl(""))
}

pattern AboutPage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/o-kompanii", d.nav_about, true, AboutTpl(""))
}

pattern ContactsPage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/kontakty", d.nav_contacts, true, ContactsTpl(""))
}

server {
  port: 8080
  middleware: [security_headers, rate_limit]

  route "/" method=GET { return HomePage("ru") }
  route "/uslugi" method=GET { return ServicesPage("ru") }
  route "/portfolio" method=GET { return PortfolioPage("ru") }
  route "/o-kompanii" method=GET { return AboutPage("ru") }
  route "/kontakty" method=GET { return ContactsPage("ru") }
  route "/be/" method=GET { return HomePage("be") }
  route "/be" method=GET { return HomePage("be") }
  route "/be/uslugi" method=GET { return ServicesPage("be") }
  route "/be/portfolio" method=GET { return PortfolioPage("be") }
  route "/be/o-kompanii" method=GET { return AboutPage("be") }
  route "/be/kontakty" method=GET { return ContactsPage("be") }
  route "/en/" method=GET { return HomePage("en") }
  route "/en" method=GET { return HomePage("en") }
  route "/en/uslugi" method=GET { return ServicesPage("en") }
  route "/en/portfolio" method=GET { return PortfolioPage("en") }
  route "/en/o-kompanii" method=GET { return AboutPage("en") }
  route "/en/kontakty" method=GET { return ContactsPage("en") }
  route "/health" method=GET { respond("ok") }
  route "/robots.txt" method=GET { respond("User-agent: *\nAllow: /\nSitemap: https://tega.plus/sitemap.xml\n") }
}
