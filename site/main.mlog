}

pattern ServicesTpl(_x: String) -> String {
  return "<h1>{{ t.nav_services }}</h1>
<p>{{ t.services_text }}</p>"
}

pattern PortfolioTpl(_x: String) -> String {
  return "<h1>{{ t.nav_objects }}</h1>
<p>{{ t.portfolio_text }}</p>
<link rel=\"stylesheet\" href=\"/static/vendor/leaflet/leaflet.css\">
<div class=\"filters\">
<input id=\"obj-q\" type=\"search\" placeholder=\"{{ t.search_ph }}\" aria-label=\"{{ t.search_aria }}\">
<select id=\"obj-type\" aria-label=\"{{ t.type_aria }}\"><option value=\"\">{{ t.all_types }}</option></select>
</div>
<div id=\"obj-count\" class=\"muted\" aria-live=\"polite\"></div>
<div id=\"obj-grid\" class=\"pgrid\"></div>
<dialog id=\"obj-dialog\" class=\"pdialog\"><button type=\"button\" class=\"pclose\" aria-label=\"{{ t.close }}\">&times;</button><div id=\"obj-dialog-body\"></div></dialog>
<div class=\"mapwrap\">
<div id=\"map\" role=\"application\" aria-label=\"{{ t.map_aria }}\"></div>
<div class=\"side\">
<ul id=\"obj-list\"></ul>
<div id=\"obj-card\" class=\"card\" hidden></div>
</div>
</div>
<noscript><p>{{ t.no_js }}</p></noscript>
<script src=\"/static/vendor/leaflet/leaflet.js\"></script>
<script src=\"/static/portfolio.js?v=4\"></script>"
}

pattern CalcTpl(_x: String) -> String {
  return "<h1>{{ t.calc_h1 }}</h1>
<p class=\"lead\">{{ t.calc_lead }}</p>
<p><button class=\"btn\" id=\"openBtn\" type=\"button\">{{ t.calc_open }}</button></p>
<p>{{ t.calc_hint }}</p>
<p class=\"muted\">{{ t.calc_note }}</p>
<link rel=\"stylesheet\" href=\"/static/calc.css?v=4\">
<div id=\"tc-root\">
<section class=\"win pinned\" id=\"win\" aria-label=\"Калькулятор\" hidden>
  <div class=\"bar\" id=\"bar\">
    <span class=\"mark\">ТЭГА<span> +</span></span>
    <b>Калькулятор</b>
    <button class=\"tb\" id=\"themeBtn\" type=\"button\" aria-pressed=\"false\" aria-label=\"Белый фон\" title=\"Белый или тёмный фон\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"5.6\"/><path d=\"M8 2.4a5.6 5.6 0 0 1 0 11.2z\" fill=\"currentColor\"/></svg></button>
    <button class=\"tb on\" id=\"pinBtn\" type=\"button\" aria-pressed=\"true\" aria-label=\"Закрепить поверх страницы\" title=\"Закрепить поверх страницы\">
      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" aria-hidden=\"true\"><path d=\"M10 1.8l4.2 4.2-2 .6-2.6 2.6.2 3.2-1 1L5.6 9.6 2.2 13l-.4-.4 3.4-3.4L2.2 6.2l1-1 3.2.2L9 2.8z\"/></svg>
    </button>
    <button class=\"tb\" id=\"minBtn\" type=\"button\" aria-label=\"Свернуть\" title=\"Свернуть\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M3 8h10\"/></svg></button>
    <button class=\"tb\" id=\"closeBtn\" type=\"button\" aria-label=\"Закрыть\" title=\"Закрыть\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M3.5 3.5l9 9M12.5 3.5l-9 9\"/></svg></button>
  </div>
  <div class=\"wtabs\" role=\"tablist\">
    <button class=\"wtab\" id=\"tabCalc\" role=\"tab\" aria-selected=\"true\" type=\"button\">Обычный</button>
    <button class=\"wtab\" id=\"tabBuild\" role=\"tab\" aria-selected=\"false\" type=\"button\">Стройка</button>
    <button class=\"wtab\" id=\"tabMetal\" role=\"tab\" aria-selected=\"false\" type=\"button\">Металл</button>
    <button class=\"wtab\" id=\"tabConc\" role=\"tab\" aria-selected=\"false\" type=\"button\">Бетон</button>
    <button class=\"wtab\" id=\"tabForm\" role=\"tab\" aria-selected=\"false\" type=\"button\">Формулы</button>
    <button class=\"wtab\" id=\"tabDens\" role=\"tab\" aria-selected=\"false\" type=\"button\">Плотность</button>
  </div>

  <div class=\"wbody\" id=\"wbody\">
  <div id=\"paneCalc\">
    <div class=\"disp\"><div class=\"tape\" id=\"tape\"></div><div class=\"hist\" id=\"hist\"></div><div class=\"val\" id=\"val\">0</div><div class=\"dim\" aria-hidden=\"true\"><i></i><em id=\"dimLbl\">результат</em><i></i></div></div>
    <div class=\"pad\" id=\"pad\"></div>
  </div>

  <div id=\"paneBuild\" hidden>
    <div class=\"tools\">
      <div class=\"chips\" id=\"chips\"></div>
      <div id=\"fields\" style=\"display:flex;flex-direction:column;gap:12px\"></div>
      <div class=\"res\" id=\"res\"></div>
    </div>
    <button class=\"ins\" id=\"insBtn\" type=\"button\">Вставить в калькулятор &nbsp;→</button>
  </div>

  <div id=\"paneMetal\" hidden>
    <div class=\"tools\">
      <div class=\"fld\"><label for=\"mType\">Профиль</label><select id=\"mType\"></select></div>
      <div id=\"mFields\" style=\"display:flex;flex-direction:column;gap:12px\"></div>
      <div class=\"res\" id=\"mRes\"></div>
      <p class=\"note\" id=\"mNote\"></p>
    </div>
  </div>

  <div id=\"paneConc\" hidden>
    <div class=\"tools\">
      <div id=\"cFields\" style=\"display:flex;flex-direction:column;gap:12px\"></div>
      <p class=\"formula\" id=\"cInfo\"></p>
      <div class=\"res\" id=\"cRes\"></div>
      <p class=\"note\">Расчётный начальный состав на 1 м³: цемент ПЦ 400, щебень гранитный 20–40 мм, осадка конуса 2–4 см, заполнители сухие. Проверяется пробным замесом. Насыпная плотность: песок 1600 кг/м³, щебень 1400 кг/м³. Нажмите на значение, чтобы перенести его в калькулятор.</p>
    </div>
  </div>

  <div id=\"paneForm\" hidden>
    <div class=\"tools\">
      <div class=\"fld\"><label for=\"fType\">Фигура</label><select id=\"fType\"></select></div>
      <div id=\"fFields\" style=\"display:flex;flex-direction:column;gap:12px\"></div>
      <p class=\"formula\" id=\"fFormula\"></p>
      <div class=\"res\" id=\"fRes\"></div>
      <p class=\"note\">Все величины вводятся в одних единицах: результат получится в тех же единицах (в квадрате или в кубе). Нажмите на значение, чтобы перенести его в калькулятор.</p>
    </div>
  </div>

  <div id=\"paneDens\" hidden>
    <div class=\"tools\">
      <div class=\"fld\"><label for=\"dMat\">Материал</label><select id=\"dMat\"></select></div>
      <p class=\"formula\" id=\"dInfo\"></p>
      <div class=\"two\">
        <div class=\"fld\"><label for=\"dRho\">Плотность, кг/м³</label><input id=\"dRho\" inputmode=\"decimal\" autocomplete=\"off\"></div>
        <div class=\"fld\"><label for=\"dVol\">Объём, м³</label><input id=\"dVol\" inputmode=\"decimal\" autocomplete=\"off\" value=\"1\"></div>
      </div>
      <div class=\"fld\"><label for=\"dMass\">Масса, кг</label><input id=\"dMass\" inputmode=\"decimal\" autocomplete=\"off\"></div>
      <div class=\"res\" id=\"dRes\"></div>
      <div class=\"dlist\" id=\"dList\" role=\"list\" aria-label=\"Справочник плотностей\"></div>
      <p class=\"note\">Типовые справочные значения. Для расчёта поставки берите плотность из паспорта материала. Объём и масса пересчитываются друг из друга. Нажмите на строку списка, чтобы выбрать материал, или на результат, чтобы перенести его в калькулятор.</p>
    </div>
  </div>
  </div>
  <div class=\"foot\"><span class=\"dot\"></span><span id=\"footTxt\">Закреплён поверх страницы</span></div>
  <div class=\"rz\" id=\"rz\" title=\"Потяните за угол, чтобы изменить размер. Двойной щелчок возвращает исходный\" aria-label=\"Изменить размер окна\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" aria-hidden=\"true\"><path d=\"M13 5L5 13M13 9L9 13\"/></svg></div>
</section>

<div class=\"pill\" id=\"pill\" hidden>
  <span class=\"mark\">ТЭГА<span> +</span></span><span class=\"pv\" id=\"pillVal\">0</span>
  <button class=\"tb on\" id=\"pillPin\" type=\"button\" aria-label=\"Открепить\" title=\"Закрепление\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" aria-hidden=\"true\"><path d=\"M10 1.8l4.2 4.2-2 .6-2.6 2.6.2 3.2-1 1L5.6 9.6 2.2 13l-.4-.4 3.4-3.4L2.2 6.2l1-1 3.2.2L9 2.8z\"/></svg></button>
  <button class=\"tb\" id=\"expBtn\" type=\"button\" aria-label=\"Развернуть\" title=\"Развернуть\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"10\" height=\"10\"/></svg></button>
</div>
</div>
<script src=\"/static/calc.js?v=3\"></script>"
}

pattern AboutTpl(_x: String) -> String {
  return "<h1>{{ t.nav_about }}</h1>
<p>{{ t.about_text }}</p>
<p>{{ t.about_dir }}</p>"
}

pattern ContactsTpl(_x: String) -> String {
  return "<h1>{{ t.nav_contacts }}</h1>
<dl class=\"req\">
<dt>{{ t.lbl_addr }}</dt><dd>{{ t.address }}</dd>
<dt>{{ t.lbl_phone }}</dt><dd>+375 17 347-11-09</dd>
<dt>{{ t.lbl_fax }}</dt><dd>+375 17 347-11-06</dd>
<dt>E-mail</dt><dd>tegabymi@gmail.com</dd>
</dl>
<h2>{{ t.req_title }}</h2>
<dl class=\"req\">
<dt>{{ t.lbl_org }}</dt><dd>{{ t.org }}</dd>
<dt>{{ t.lbl_unp }}</dt><dd>190729589</dd>
<dt>{{ t.lbl_okpo }}</dt><dd>376949605000</dd>
<dt>{{ t.lbl_acc }}</dt><dd>BY65 UNBS 3012 0037 0500 4000 0933</dd>
<dt>{{ t.lbl_bank }}</dt><dd>{{ t.bank }}</dd>
<dt>{{ t.lbl_dir }}</dt><dd>{{ t.director }}</dd>
</dl>"
}

pattern Shell(lang: String, slug: String, page: String, title: String, inner: Bool, body: String) -> Html {
  return template_render(HeadTpl("") + body + FootTpl(""), {
    t: Dict(lang), lang: lang, title: title, page: page, inner: inner, p: Prefix(lang), logo: LogoFor(lang),
    home: Href(lang, "/"), self: Href(lang, slug),
    h_ru: Href("ru", slug), h_be: Href("be", slug), h_en: Href("en", slug),
    is_ru: lang == "ru", is_be: lang == "be", is_en: lang == "en"
  })
}

pattern HomePage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/", "home", d.title_home, false, HomeTpl(""))
}

pattern ServicesPage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/uslugi", "services", d.nav_services, true, ServicesTpl(""))
}

pattern PortfolioPage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/portfolio", "portfolio", d.nav_objects, true, PortfolioTpl(""))
}

pattern CalcPage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/raschet-smet", "calc", d.nav_calc, true, CalcTpl(""))
}

pattern AboutPage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/o-kompanii", "about", d.nav_about, true, AboutTpl(""))
}

pattern ContactsPage(lang: String) -> Html {
  let d = Dict(lang)
  return Shell(lang, "/kontakty", "contacts", d.nav_contacts, true, ContactsTpl(""))
}

server {
  port: 8080
  middleware: [security_headers, rate_limit]

  route "/" method=GET { return HomePage("ru") }
  route "/uslugi" method=GET { return ServicesPage("ru") }
  route "/portfolio" method=GET { return PortfolioPage("ru") }
  route "/raschet-smet" method=GET { return CalcPage("ru") }
  route "/be/raschet-smet" method=GET { return CalcPage("be") }
  route "/en/raschet-smet" method=GET { return CalcPage("en") }
  route "/o-kompanii" method=GET { return AboutPage("ru") }
  route "/kontakty" method=GET { return ContactsPage("ru") }
  route "/be/" method=GET { return HomePage("be") }
  route "/be" method=GET { return HomePage("be") }
  route "/be/uslugi" method=GET { return ServicesPage("be") }
  route "/be/portfolio" method=GET { return PortfolioPage("be") }
  route "/be/o-kompanii" method=GET { return AboutPage("be") }
  route "/be/kontakty" method=GET { return ContactsPage("be") }
  route "/en/" method=GET { return HomePage("en") }
  route "/en" method=GET { return HomePage("en") }
  route "/en/uslugi" method=GET { return ServicesPage("en") }
  route "/en/portfolio" method=GET { return PortfolioPage("en") }
  route "/en/o-kompanii" method=GET { return AboutPage("en") }
  route "/en/kontakty" method=GET { return ContactsPage("en") }
  route "/health" method=GET { respond("ok") }
  route "/robots.txt" method=GET { respond("User-agent: *\nAllow: /\nSitemap: https://tega.plus/sitemap.xml\n") }
}
