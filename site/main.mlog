pattern Dict(lang: String) -> Map {
  if lang == "be" { return DictBe("") }
  if lang == "en" { return DictEn("") }
  return DictRu("")
}

pattern Prefix(lang: String) -> String {
  if lang == "be" { return "/be" }
  if lang == "en" { return "/en" }
  return ""
}

pattern Href(lang: String, slug: String) -> String {
  if slug == "/" {
    if lang == "ru" { return "/" }
    return "/" + lang + "/"
  }
  return Prefix(lang) + slug
}

pattern LogoFor(lang: String) -> String {
  if lang == "be" { return "/static/logo-be.png" }
  if lang == "en" { return "/static/logo-en.png" }
  return "/static/logo-ru.png"
}

pattern HeadTpl(_x: String) -> String {
  return "<!doctype html>
<html lang=\"{{ lang }}\">
<head>
<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>{{ title }} — {{ t.brand }}</title>
<meta name=\"description\" content=\"{{ t.desc }}\">
<link rel=\"canonical\" href=\"https://tega.plus{{ self }}\">
<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tega.plus{{ h_ru }}\">
<link rel=\"alternate\" hreflang=\"be\" href=\"https://tega.plus{{ h_be }}\">
<link rel=\"alternate\" hreflang=\"en\" href=\"https://tega.plus{{ h_en }}\">
<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tega.plus{{ h_ru }}\">
<meta property=\"og:type\" content=\"website\">
<meta property=\"og:title\" content=\"{{ title }} — {{ t.brand }}\">
<meta property=\"og:description\" content=\"{{ t.desc }}\">
<meta property=\"og:url\" content=\"https://tega.plus{{ self }}\">
<link rel=\"icon\" type=\"image/png\" href=\"/static/favicon.png\">
<link rel=\"apple-touch-icon\" href=\"/static/apple-touch-icon.png\">
<link rel=\"stylesheet\" href=\"/static/site.css?v=11\">
</head>
<body class=\"pg-{{ page }}\">
<div class=\"wip\" role=\"status\">{{ t.wip }}</div>
<header class=\"top\"><div class=\"wrap\">
<a class=\"brand\" href=\"{{ home }}\" aria-label=\"{{ t.brand }}\"><img src=\"{{ logo }}\" width=\"318\" height=\"96\" alt=\"{{ t.brand }} — {{ t.slogan }}\"></a>
<nav aria-label=\"{{ t.nav_aria }}\">
<a href=\"{{ p }}/uslugi\">{{ t.nav_services }}</a>
<a href=\"{{ p }}/portfolio\">{{ t.nav_objects }}</a>
<a href=\"{{ p }}/raschet-smet\">{{ t.nav_calc }}</a>
<a href=\"{{ p }}/o-kompanii\">{{ t.nav_about }}</a>
<a href=\"{{ p }}/kontakty\">{{ t.nav_contacts }}</a>
</nav>
<div class=\"right\">
<div class=\"lang\" role=\"group\" aria-label=\"{{ t.lang_aria }}\">
<a href=\"{{ h_ru }}\" lang=\"ru\" hreflang=\"ru\" {{#if is_ru}}aria-current=\"true\"{{/if}}>RU</a>
<a href=\"{{ h_be }}\" lang=\"be\" hreflang=\"be\" {{#if is_be}}aria-current=\"true\"{{/if}}>BY</a>
<a href=\"{{ h_en }}\" lang=\"en\" hreflang=\"en\" {{#if is_en}}aria-current=\"true\"{{/if}}>EN</a>
</div>
<a class=\"tel\" href=\"tel:+375173471109\">+375 17 347-11-09</a>
</div>
</div></header>
<main{{#if inner}} class=\"page\"{{/if}}>
"
}

pattern FootTpl(_x: String) -> String {
  return "
</main>
<footer><div class=\"wrap\">
<div>{{ t.legal }}</div>
<div>{{ t.slogan }}</div>
</div></footer>
</body>
</html>"
}

