<defs><pattern id=\"mg\" width=\"40\" height=\"40\" patternUnits=\"userSpaceOnUse\"><path d=\"M40 0H0V40\" fill=\"none\" stroke=\"#3a3d44\" stroke-width=\"1\"/></pattern></defs>
<rect width=\"640\" height=\"400\" fill=\"url(#mg)\"/>
<path d=\"M0 290 C140 240 230 330 360 250 S560 200 640 230\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"10\"/>
<path d=\"M150 0 C170 120 120 220 210 400\" fill=\"none\" stroke=\"#4a4d55\" stroke-width=\"6\"/>
<g fill=\"#e3000f\" stroke=\"#ffffff\" stroke-width=\"2\"><circle cx=\"210\" cy=\"150\" r=\"9\"/><circle cx=\"330\" cy=\"245\" r=\"9\"/><circle cx=\"440\" cy=\"120\" r=\"9\"/><circle cx=\"520\" cy=\"215\" r=\"9\"/><circle cx=\"270\" cy=\"330\" r=\"9\"/></g>
</svg>
</div>
</div></section>
<section class=\"help\"><div class=\"wrap\">
