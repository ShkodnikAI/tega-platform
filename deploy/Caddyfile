# Reverse proxy in front of the Metalogos server (TLS, static, gzip, timeouts, access log).
# Set DOMAIN and TG_WEBHOOK_SECRET in the environment. Static files are mounted at /srv/static
# from tega-platform/static and tega-content/brand.
{$DOMAIN} {
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log
	}
	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=86400"
	}
	# Telegram webhook: only requests carrying the secret header reach the app
	@tg path /telegram/webhook
	handle @tg {
		@ok header X-Telegram-Bot-Api-Secret-Token {$TG_WEBHOOK_SECRET}
		reverse_proxy @ok 127.0.0.1:8080
		respond 403
	}
	reverse_proxy 127.0.0.1:8080 {
		transport http {
			response_header_timeout 30s
		}
	}
}
