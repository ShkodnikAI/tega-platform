# Reverse proxy in front of the Metalogos server (TLS, static, gzip, timeouts, access log).
# Set DOMAIN and TG_WEBHOOK_SECRET in the environment. Static files are mounted at /srv/static
# from tega-platform/static and tega-content/brand.
{$DOMAIN} {
	encode zstd gzip
	# Справочники переехали из /raschet-smet в /spravochniki (все языки)
	@oldref path_regexp oldref ^(/(?:be|en))?/raschet-smet/(obyemy|kachestvo|elektrika)/?$
	redir @oldref {re.oldref.1}/spravochniki/{re.oldref.2} permanent
	# Формы отчётов переехали из /spravochniki в /raschet-smet
	@oldforms path_regexp oldforms ^(/(?:be|en))?/spravochniki/formy/?$
	redir @oldforms {re.oldforms.1}/raschet-smet/formy permanent
	# Статья о цене работ переехала из /spravochniki в /raschet-smet
	@oldprice path_regexp oldprice ^(/(?:be|en))?/spravochniki/cenoobrazovanie/?$
	redir @oldprice {re.oldprice.1}/raschet-smet/cenoobrazovanie permanent
	log {
		output file /var/log/caddy/access.log
	}
	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=86400"
	}
	# Telegram webhook: only requests carrying the secret header reach the app
	@tg_ok {
		path /telegram/webhook
		header X-Telegram-Bot-Api-Secret-Token {$TG_WEBHOOK_SECRET}
	}
	handle @tg_ok {
		reverse_proxy 127.0.0.1:8080
	}
	@tg_bad path /telegram/webhook
	handle @tg_bad {
		respond 403
	}
	reverse_proxy 127.0.0.1:8080 {
		transport http {
			response_header_timeout 30s
		}
	}
}
