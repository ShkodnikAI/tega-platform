# Inside the Render container: Render terminates TLS and forwards to $PORT.
{
	auto_https off
	admin off
	servers {
		# Render's load balancer is in a private range; keep the real client IP from its X-Forwarded-For
		trusted_proxies static private_ranges
	}
}
:{$PORT} {
	encode zstd gzip
	# www -> apex (canonical host)
	@www host www.tega.plus
	redir @www https://tega.plus{uri} permanent
	# Справочники переехали из /raschet-smet в /spravochniki (все языки)
	@oldref path_regexp oldref ^(/(?:be|en))?/raschet-smet/(obyemy|kachestvo|elektrika|formy)/?$
	redir @oldref {re.oldref.1}/spravochniki/{re.oldref.2} permanent
	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=86400"
		@code path *.css *.js
		header @code Cache-Control "public, max-age=300, must-revalidate"
	}
	# Crawler files are static (correct content types, no app round-trip)
	@seo path /robots.txt /sitemap.xml
	handle @seo {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=3600"
	}
	# Compressed portfolio media live on the persistent disk (originals stay on the owner's local server)
	handle_path /media/* {
		root * /data/media
		file_server
		header Cache-Control "public, max-age=604800"
	}
	# Telegram webhook: only requests carrying the secret header reach the app
	@tg_ok {
		path /telegram/webhook
		header X-Telegram-Bot-Api-Secret-Token {$TG_WEBHOOK_SECRET}
	}
	handle @tg_ok {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}
	@tg_bad path /telegram/webhook
	handle @tg_bad {
		respond 403
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}
